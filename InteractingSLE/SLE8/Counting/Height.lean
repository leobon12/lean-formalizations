import InteractingSLE.SLE8.TimeGrid
import InteractingSLE.SLE8.Counting.TrialBM
import QuantumZipper.Proofs.Loewner.Algebra
import QuantumZipper.Proofs.RS.TraceGrid
import Mathlib.Analysis.SpecialFunctions.Arsinh

/-!
# The height parameter (3.1) and the statements of Lemmas 3.1 and 3.2 of the SLE₈ note

SLE₈ note `source/sle8-continuity.pdf`, §3.1–3.2, pp. 4–6 (transcription
`source/sle8/sle8-continuity.md`, anchors `lem-3.1`, `lem-3.2`).

For a continuous driver `V` and `y > 0`, the reverse flow (2.5) from `iy` has height `Y_s = rfY V y s`,
real part `X_s = rfX V y s` and derivative `Φ_s = rfPhi V y s`. The note's height parameter (3.1) is
`u = log Y_s`; `Y` is continuous and strictly increasing, so `s = heightClock V y u` (the first time the
height reaches `e^u`) inverts it, and `J_u = arsinh(X_s / Y_s)` is `heightJ V y u`; `τ_T = log Y_T` is
`heightTau V y T`.

## Statements (hypotheses of `prop41_of_lemmas`)

* `Lemma31Statement`: Lemma 3.1 (critical change of measure), for the reverse flow driven by `√8 β`,
  `β` a Brownian motion defined for all nonnegative times (as in the note's §3.1).
* `Lemma32Statement`: Lemma 3.2 (two-point derivative estimate), exactly as printed.

## Main results

* `heightClock_log`, `heightJ_log`: `s = heightClock(log Y_s)` and `J_{log Y_s} = arsinh(X_s / Y_s)`;
* `continuous_heightJ_stopped`: `u ↦ J_{min(u, τ_T)}` is continuous.
-/

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Complex
open scoped Topology ENNReal NNReal

namespace InteractingSLE.SLE8

open QuantumZipper

/-! ## The reverse flow from `iy` and its height parameter -/

/-- The height `Y_s(iy) = Im Z_s(iy)` of the reverse flow (2.5) driven by `V` from `iy`. -/
def rfY (V : ℝ → ℝ) (y s : ℝ) : ℝ := (revMap V s ((y : ℂ) * I)).im

/-- The real part `X_s(iy) = Re Z_s(iy)` of the reverse flow (2.5) driven by `V` from `iy`. -/
def rfX (V : ℝ → ℝ) (y s : ℝ) : ℝ := (revMap V s ((y : ℂ) * I)).re

/-- The derivative `Φ_s(iy) = |h_s'(iy)|` of the reverse flow (2.5)–(2.6) driven by `V`. -/
def rfPhi (V : ℝ → ℝ) (y s : ℝ) : ℝ := ‖deriv (revFlow V s) ((y : ℂ) * I)‖

/-- The inverse of the height parameter `u = log Y_s` of (3.1): the first time `s ≥ 0` at which the
height `Y_s(iy)` reaches `e^u`. -/
def heightClock (V : ℝ → ℝ) (y u : ℝ) : ℝ := sInf {s | 0 ≤ s ∧ Real.exp u ≤ rfY V y s}

/-- The height-parameter process `J_u = arsinh(X_s / Y_s)`, `u = log Y_s`, of (3.1). -/
def heightJ (V : ℝ → ℝ) (y u : ℝ) : ℝ :=
  Real.arsinh (rfX V y (heightClock V y u) / rfY V y (heightClock V y u))

/-- `τ_T = log Y_T` of (3.1). -/
def heightTau (V : ℝ → ℝ) (y T : ℝ) : ℝ := Real.log (rfY V y T)

/-- The σ-algebra generated by `τ_T`, `Φ_T` and the height-parameter process stopped at `τ_T`; it is
contained in the note's `𝓕_{τ_T}` (the stopped process of a continuous adapted process is
`𝓕_τ`-measurable). -/
abbrev heightStoppedSigma {Ω : Type*} (V : Ω → ℝ → ℝ) (y T : ℝ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (heightTau (V ω) y T, rfPhi (V ω) y T,
    fun u : ℝ => heightJ (V ω) y (min u (heightTau (V ω) y T)))) inferInstance

/-! ## Statements of Lemmas 3.1 and 3.2 -/

/-- **Lemma 3.1** of the SLE₈ note (critical change of measure, p. 4), in the form used by
Proposition 4.1. Let `β` be a Brownian motion defined for all nonnegative times (every path continuous,
`β_0 = 0`), and consider the reverse flow (2.5) driven by `V = √8 β` (`drive 8 β ω`) from `iy`, with
`u₀ = log y`, `U = log √5` and the height-parameter objects `J`, `Φ_T`, `τ_T` of (3.1). There is a
universal constant `C_occ` such that for all `T ∈ [0, 1]` and `y ∈ (0, 1]`:

* there is a probability measure `ℚ` under which `(J_{u₀+v})_{0 ≤ v ≤ U - u₀}` is a Brownian motion of
  variance rate `4` started at `0`; here only its consequence up to `τ_T ≤ U` is required: `ℚ`-a.s.
  `J_{u₀+v} = 2β'_v` for `0 ≤ v ≤ τ_T - u₀`, for a `ℚ`-Brownian motion `β'`; and
  `ℙ(E) ≤ y² a⁻² ℚ(E)` (3.2) for every `a ∈ (0, 1)` and every event `E ⊆ {y Φ_T ≥ a}` measurable with
  respect to `τ_T`, `Φ_T` and the height-parameter process stopped at `τ_T` (a sub-σ-algebra of the
  note's `𝓕_{τ_T}`);
* on `{y Φ_T ≥ a}`: `τ_T ≥ log a` and `∫_{u₀}^{τ_T} 1{|J_u| ≤ 1} du ≤ C_occ (1 + log(1/a))` (3.3).

The note's statement also asserts that `τ_T` is a bounded stopping time of the augmented filtration;
that and the `𝓕_{τ_T}` form of (3.2) imply the version here. -/
def Lemma31Statement {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) : Prop :=
  ∃ Cocc : ℝ, ∀ β : ℝ≥0 → Ω → ℝ, IsBrownianReal β P → (∀ ω, Continuous fun t => β t ω) →
    (∀ t, Measurable (β t)) → (∀ ω, β 0 ω = 0) →
    ∀ T ∈ Icc (0 : ℝ) 1, ∀ y ∈ Ioc (0 : ℝ) 1,
      (∃ Q : Measure Ω, IsProbabilityMeasure Q ∧
        (∃ β' : ℝ≥0 → Ω → ℝ, IsBrownianReal β' Q ∧
          ∀ᵐ ω ∂Q, ∀ v : ℝ≥0, (v : ℝ) ≤ heightTau (drive 8 β ω) y T - Real.log y →
            heightJ (drive 8 β ω) y (Real.log y + v) = 2 * β' v ω) ∧
        ∀ a ∈ Ioo (0 : ℝ) 1, ∀ E : Set Ω,
          MeasurableSet[heightStoppedSigma (fun ω => drive 8 β ω) y T] E →
          E ⊆ {ω | a ≤ y * rfPhi (drive 8 β ω) y T} →
          P E ≤ ENNReal.ofReal (y ^ 2 / a ^ 2) * Q E) ∧
      ∀ a ∈ Ioo (0 : ℝ) 1, ∀ ω, a ≤ y * rfPhi (drive 8 β ω) y T →
        Real.log a ≤ heightTau (drive 8 β ω) y T ∧
        volume {u | u ∈ Icc (Real.log y) (heightTau (drive 8 β ω) y T) ∧
            |heightJ (drive 8 β ω) y u| ≤ 1} ≤ ENNReal.ofReal (Cocc * (1 + Real.log (1 / a)))

/-- **Lemma 3.2** of the SLE₈ note (two-point derivative estimate, p. 6), as stated: for every
`M ∈ ℕ` and `c₀ > 0` there is a deterministic `C_{M,c₀} < ∞` such that, for every deterministic
`t ∈ [0, 1]`, `a ∈ (0, 1)`, `y ∈ (0, 1]`, `v ∈ (0, y/2]` and `m ∈ ℤ` with `|m| v ≤ 1`,
`ℙ[Ω_M ∩ {y|F_t'(iy)| ≥ a, v|F_t'((m + i)v)| ≥ c₀ a}] ≤ C a^{-26/9} y² (v/y)^{16/9} (1 + m²)^{1/3}`
(3.11). Here `W = √8 B` for a Brownian motion `B` (every path continuous, measurable coordinates,
`B_0 = 0`), `F_t = fwdMapInv W t` and `Ω_M = DriverBound M W` (2.11). -/
def Lemma32Statement {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) : Prop :=
  ∀ B : ℝ≥0 → Ω → ℝ, IsBrownianReal B P → (∀ ω, Continuous fun t => B t ω) →
    (∀ t, Measurable (B t)) → (∀ ω, B 0 ω = 0) →
    ∀ M : ℕ, ∀ c₀ : ℝ, 0 < c₀ → ∃ C : ℝ,
      ∀ t ∈ Icc (0 : ℝ) 1, ∀ a ∈ Ioo (0 : ℝ) 1, ∀ y ∈ Ioc (0 : ℝ) 1, ∀ v ∈ Ioc (0 : ℝ) (y / 2),
        ∀ m : ℤ, |(m : ℝ)| * v ≤ 1 →
          P {ω | DriverBound M (drive 8 B ω) ∧
              a ≤ y * ‖deriv (fwdMapInv (drive 8 B ω) t) ((y : ℂ) * I)‖ ∧
              c₀ * a ≤ v * ‖deriv (fwdMapInv (drive 8 B ω) t) (((m : ℂ) + I) * (v : ℂ))‖} ≤
            ENNReal.ofReal (C * a ^ (-(26 / 9 : ℝ)) * y ^ 2 * (v / y) ^ (16 / 9 : ℝ) *
              (1 + (m : ℝ) ^ 2) ^ (1 / 3 : ℝ))

/-! ## Basic properties of the height parameter -/

variable {V : ℝ → ℝ} {y : ℝ}

theorem mul_I_mem_H {y : ℝ} (hy : 0 < y) : (y : ℂ) * I ∈ H := by
  show 0 < ((y : ℂ) * I).im; simpa using hy

theorem rfY_pos (hV : Continuous V) (hy : 0 < y) {s : ℝ} (hs : 0 ≤ s) : 0 < rfY V y s :=
  TwoPoint.im_revMap_pos hV (mul_I_mem_H hy) hs

theorem rfY_zero (hV : Continuous V) (hy : 0 < y) : rfY V y 0 = y := by
  unfold rfY; rw [revMap_zero hV (mul_I_mem_H hy)]; simp

theorem strictMonoOn_rfY (hV : Continuous V) (hy : 0 < y) : StrictMonoOn (rfY V y) (Ici 0) :=
  LoewnerAlgebra.strictMonoOn_im_revMap V hV _ (by simpa using hy)

theorem continuousOn_rfY (hV : Continuous V) (hy : 0 < y) : ContinuousOn (rfY V y) (Ici 0) :=
  Complex.continuous_im.comp_continuousOn
    (ReverseFlow.continuousOn_revMap_time V hV _ (by simpa using hy))

theorem continuousOn_rfX (hV : Continuous V) (hy : 0 < y) : ContinuousOn (rfX V y) (Ici 0) :=
  Complex.continuous_re.comp_continuousOn
    (ReverseFlow.continuousOn_revMap_time V hV _ (by simpa using hy))

/-- `heightClock (log Y_s) = s`. -/
theorem heightClock_log (hV : Continuous V) (hy : 0 < y) {s : ℝ} (hs : 0 ≤ s) :
    heightClock V y (Real.log (rfY V y s)) = s := by
  unfold heightClock
  rw [Real.exp_log (rfY_pos hV hy hs)]
  have : {s' | 0 ≤ s' ∧ rfY V y s ≤ rfY V y s'} = Ici s := by
    ext s'
    simp only [mem_ofPred_eq, mem_Ici]
    constructor
    · rintro ⟨h0, h⟩; exact ((strictMonoOn_rfY hV hy).le_iff_le hs h0).1 h
    · intro h; exact ⟨hs.trans h, ((strictMonoOn_rfY hV hy).le_iff_le hs (hs.trans h)).2 h⟩
  rw [this, csInf_Ici]

/-- `J_{log Y_s} = arsinh(X_s / Y_s)`. -/
theorem heightJ_log (hV : Continuous V) (hy : 0 < y) {s : ℝ} (hs : 0 ≤ s) :
    heightJ V y (Real.log (rfY V y s)) = Real.arsinh (rfX V y s / rfY V y s) := by
  unfold heightJ; rw [heightClock_log hV hy hs]

theorem heightClock_stopped_mem (hV : Continuous V) (hy : 0 < y) {T : ℝ} (hT : 0 ≤ T) (u : ℝ) :
    heightClock V y (min u (heightTau V y T)) ∈ Icc 0 T := by
  unfold heightClock
  have hT_mem : T ∈ {s | 0 ≤ s ∧ Real.exp (min u (heightTau V y T)) ≤ rfY V y s} := by
    refine ⟨hT, ?_⟩
    calc Real.exp (min u (heightTau V y T)) ≤ Real.exp (heightTau V y T) :=
          Real.exp_le_exp.2 (min_le_right _ _)
      _ = rfY V y T := Real.exp_log (rfY_pos hV hy hT)
  exact ⟨le_csInf ⟨T, hT_mem⟩ fun s hs => hs.1, csInf_le ⟨0, fun s hs => hs.1⟩ hT_mem⟩

theorem monotone_heightClock_stopped (hV : Continuous V) (hy : 0 < y) {T : ℝ} (hT : 0 ≤ T) :
    Monotone fun u => heightClock V y (min u (heightTau V y T)) := by
  intro u u' huu'
  unfold heightClock
  have hT_mem : T ∈ {s | 0 ≤ s ∧ Real.exp (min u' (heightTau V y T)) ≤ rfY V y s} := by
    refine ⟨hT, ?_⟩
    calc Real.exp (min u' (heightTau V y T)) ≤ Real.exp (heightTau V y T) :=
          Real.exp_le_exp.2 (min_le_right _ _)
      _ = rfY V y T := Real.exp_log (rfY_pos hV hy hT)
  refine csInf_le_csInf ⟨0, fun s hs => hs.1⟩ ⟨T, hT_mem⟩ fun s hs => ⟨hs.1, ?_⟩
  exact (Real.exp_le_exp.2 (min_le_min_right _ huu')).trans hs.2

/-- The stopped inverse clock `u ↦ heightClock(min(u, τ_T))` is continuous. -/
theorem continuous_heightClock_stopped (hV : Continuous V) (hy : 0 < y) {T : ℝ} (hT : 0 ≤ T) :
    Continuous fun u => heightClock V y (min u (heightTau V y T)) := by
  set g : ℝ → Icc (0 : ℝ) T := fun u =>
    ⟨heightClock V y (min u (heightTau V y T)), heightClock_stopped_mem hV hy hT u⟩ with hgdef
  have hmono : Monotone g := fun u u' h => monotone_heightClock_stopped hV hy hT h
  have hsurj : Function.Surjective g := by
    rintro ⟨s, hs⟩
    refine ⟨Real.log (rfY V y s), Subtype.ext ?_⟩
    have hle : Real.log (rfY V y s) ≤ heightTau V y T :=
      Real.log_le_log (rfY_pos hV hy hs.1)
        (((strictMonoOn_rfY hV hy).le_iff_le hs.1 hT).2 hs.2)
    simp only [hgdef, min_eq_left hle]
    exact heightClock_log hV hy hs.1
  exact continuous_subtype_val.comp (hmono.continuous_of_surjective hsurj)

/-- **Continuity of the stopped height-parameter process** `u ↦ J_{min(u, τ_T)}`. -/
theorem continuous_heightJ_stopped (hV : Continuous V) (hy : 0 < y) {T : ℝ} (hT : 0 ≤ T) :
    Continuous fun u => heightJ V y (min u (heightTau V y T)) := by
  have hg := continuous_heightClock_stopped hV hy hT
  have hmem := heightClock_stopped_mem hV hy hT (V := V)
  have hX : Continuous fun u => rfX V y (heightClock V y (min u (heightTau V y T))) :=
    ((continuousOn_rfX hV hy).mono Icc_subset_Ici_self).comp_continuous hg hmem
  have hY : Continuous fun u => rfY V y (heightClock V y (min u (heightTau V y T))) :=
    ((continuousOn_rfY hV hy).mono Icc_subset_Ici_self).comp_continuous hg hmem
  exact Real.continuous_arsinh.comp
    (hX.div hY fun u => (rfY_pos hV hy (hmem u).1).ne')

end InteractingSLE.SLE8
