/-!
# Random test functions and the field transported by a random chart

Packet PROVE-PUSHFWD. A random distribution `g : α → 𝒟'(U)` (cylinder σ-algebra) paired with a **random test
function** `T : α → 𝓓(U)` is measurable as soon as each value `a ↦ T a z` is
(`measurable_apply_of_forall_measurable`). This is the measurability statement needed for a field tested against
the transport of a fixed test function by a random conformal map. Consequences:

* `Chart.measurable_chartTransport_random`: for a random conformal chart `c : α → Chart` whose maps are measurable
  (pointwise in `fwd`, jointly in `inv` and in the lift), `a ↦ chartTransport (c a) σ a k (h a)` is a random
  distribution;
* `Chart.measurable_chartTransport_uncurry`: the joint version on `α × 𝒟'(ℍ)` (for kernels).

## Route (own elementary argument; standard facts)

1. **Derivatives.** If every `T a` is smooth and every `a ↦ T a z` is measurable, every `a ↦ Dⁱ(T a)(z)` is
   measurable: `fderiv` is a limit of difference quotients (`HasFDerivAt.lim`) evaluated on the basis `1, i` of `ℂ`
   (`measurable_fderiv_apply`), and `Dⁱ⁺¹ = curry ∘ D(Dⁱ)` (`measurable_iteratedFDeriv_apply`).
2. **Borel measurability into `𝓓_K`.** The topology of `𝓓_K` is induced by `f ↦ (Dⁱf|_K)ᵢ ∈ ∏ᵢ C(K, Mᵢ)`
   (LQGMetric's `derivOnK`, `induced_eq_of_dist_eq`), so `𝓓_K` is metrizable and its Borel σ-algebra is the pullback
   of the product of the Borel σ-algebras of the `C(K, Mᵢ)`, which are generated by the evaluations (Mathlib
   `ContinuousMap.measurable_iff_eval`).
3. **Pairing on `𝓓_K`.** `(f, g) ↦ g(f)` is continuous in `f` and measurable in `g`, so it is jointly measurable
   (Mathlib `measurable_uncurry_of_continuous_of_measurable`; `𝓓_K` is second countable by LQGMetric).
4. **Cutoffs.** With `χₙ = 1` on the compact exhaustion `Kₙ` of `U`, `χₙ T a ∈ 𝓓_{supp χₙ}` is eventually
   `T a`, so `g a (T a)` is a pointwise limit of measurable functions.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology TopologicalSpace
open scoped Distributions
open QuantumZipper (H isOpen_H)
open LQGMetric (TestOn DistOn)

namespace InteractingSLE

namespace RandomTest

/-! ### Step 1: measurability of the derivatives -/

section Deriv

variable {α : Type*} [MeasurableSpace α] {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

omit [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] in
/-- A real-linear map on `ℂ` is determined by its values at `1` and `i`. -/
theorem clm_eq_re_im (L : ℂ →L[ℝ] E) :
    L = Complex.reCLM.smulRight (L 1) + Complex.imCLM.smulRight (L Complex.I) := by
  ext v
  have hv : v = (v.re : ℂ) * 1 + (v.im : ℂ) * Complex.I := by simp [Complex.re_add_im]
  simp only [add_apply, ContinuousLinearMap.smulRight_apply,
    Complex.reCLM_apply, Complex.imCLM_apply]
  conv_lhs => rw [hv]
  rw [map_add, show (v.re : ℂ) * 1 = (v.re : ℝ) • (1 : ℂ) by simp,
    show (v.im : ℂ) * Complex.I = (v.im : ℝ) • Complex.I by simp [Complex.real_smul], map_smul, map_smul]

theorem measurable_clm_of_apply {L : α → ℂ →L[ℝ] E} (h1 : Measurable fun a => L a 1)
    (hI : Measurable fun a => L a Complex.I) : Measurable L := by
  have hc : Continuous fun p : E × E =>
      Complex.reCLM.smulRight p.1 + Complex.imCLM.smulRight p.2 :=
    ((ContinuousLinearMap.smulRightL ℝ ℂ E Complex.reCLM).continuous.comp continuous_fst).add
      ((ContinuousLinearMap.smulRightL ℝ ℂ E Complex.imCLM).continuous.comp continuous_snd)
  have : L = (fun p : E × E => Complex.reCLM.smulRight p.1 + Complex.imCLM.smulRight p.2) ∘
      fun a => (L a 1, L a Complex.I) := by
    funext a
    exact clm_eq_re_im (L a)
  rw [this]
  exact hc.measurable.comp (h1.prodMk hI)

/-- **Derivatives of a pointwise measurable family of differentiable maps are pointwise measurable.** -/
theorem measurable_fderiv_apply {f : α → ℂ → E} (hd : ∀ a, Differentiable ℝ (f a))
    (hm : ∀ z, Measurable fun a => f a z) (z : ℂ) : Measurable fun a => fderiv ℝ (f a) z := by
  have hv : ∀ v : ℂ, Measurable fun a => fderiv ℝ (f a) z v := by
    intro v
    refine measurable_of_tendsto_metrizable (f := fun (n : ℕ) a =>
      ((n : ℝ) + 1) • (f a (z + ((n : ℝ) + 1)⁻¹ • v) - f a z)) (fun n => ?_) ?_
    · exact ((hm _).sub (hm _)).const_smul _
    · rw [tendsto_pi_nhds]
      intro a
      refine ((hd a) z).hasFDerivAt.lim v ?_
      refine tendsto_norm_atTop_atTop.comp ?_
      exact tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop
  exact measurable_clm_of_apply (hv 1) (hv Complex.I)

end Deriv

/-- The Borel σ-algebra on the finite-dimensional spaces `Mᵢ = ℂ [×i]→L[ℝ] ℝ` of `i`-th derivatives. -/
scoped instance measurableSpace_cmm (i : ℕ) : MeasurableSpace (ℂ [×i]→L[ℝ] ℝ) := borel _

scoped instance borelSpace_cmm (i : ℕ) : BorelSpace (ℂ [×i]→L[ℝ] ℝ) := ⟨rfl⟩

section IterDeriv

variable {α : Type*} [MeasurableSpace α]

/-- **Iterated derivatives of a pointwise measurable family of smooth functions are pointwise measurable.** -/
theorem measurable_iteratedFDeriv_apply {f : α → ℂ → ℝ}
    (hs : ∀ a, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (f a)) (hm : ∀ z, Measurable fun a => f a z) :
    ∀ (i : ℕ) (z : ℂ), Measurable fun a => iteratedFDeriv ℝ i (f a) z := by
  intro i
  induction i with
  | zero =>
    intro z
    simp_rw [iteratedFDeriv_zero_eq_comp, Function.comp_apply]
    exact (continuousMultilinearCurryFin0 ℝ ℂ ℝ).symm.continuous.measurable.comp (hm z)
  | succ i ih =>
    intro z
    simp_rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply]
    refine (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (i + 1) => ℂ) ℝ).symm.continuous.measurable.comp
      (measurable_fderiv_apply (f := fun a => iteratedFDeriv ℝ i (f a)) (fun a => ?_) ih z)
    exact (hs a).differentiable_iteratedFDeriv (by exact_mod_cast ENat.natCast_lt_top i)

end IterDeriv

/-! ### Step 2: the space `𝓓_K` -/

section TestK

variable (K : Compacts ℂ)

/-- All derivatives restricted to `K`: the map inducing the topology of `𝓓_K`. -/
def derivsOnK (f : 𝓓^{⊤}_{K}(ℂ, ℝ)) : (i : ℕ) → C((K : Set ℂ), ℂ [×i]→L[ℝ] ℝ) :=
  fun i => LQGMetric.derivOnK K i f

theorem isInducing_derivsOnK : Topology.IsInducing (derivsOnK K) := by
  constructor
  change (⨅ (i : ℕ), TopologicalSpace.induced
    (ContDiffMapSupportedIn.structureMapLM ℝ ⊤ i) inferInstance) = _
  simp_rw [fun i => LQGMetric.induced_eq_of_dist_eq _ (LQGMetric.derivOnK K i)
    (LQGMetric.dist_derivOnK K i)]
  rw [Pi.topologicalSpace, induced_iInf]
  simp_rw [induced_compose]
  rfl

theorem injective_derivsOnK : Function.Injective (derivsOnK K) := by
  intro f g hfg
  ext z
  by_cases hz : z ∈ (K : Set ℂ)
  · have h0 := congrArg (fun F : C((K : Set ℂ), ℂ [×0]→L[ℝ] ℝ) => F ⟨z, hz⟩) (congrFun hfg 0)
    simp only [derivsOnK, LQGMetric.derivOnK, ContinuousMap.coe_mk] at h0
    have := congrArg (fun L : ℂ [×0]→L[ℝ] ℝ => L 0) h0
    simpa only [iteratedFDeriv_zero_apply] using this
  · rw [f.zero_on_compl hz, g.zero_on_compl hz]

instance locallyCompactSpace_compacts : LocallyCompactSpace (K : Set ℂ) :=
  K.isCompact.isClosed.isClosedEmbedding_subtypeVal.locallyCompactSpace

instance metrizableSpace_testK : MetrizableSpace 𝓓^{⊤}_{K}(ℂ, ℝ) :=
  (Topology.IsEmbedding.mk (isInducing_derivsOnK K) (injective_derivsOnK K)).metrizableSpace

/-- The Borel σ-algebra on `𝓓_K`. -/
scoped instance measurableSpace_testK : MeasurableSpace 𝓓^{⊤}_{K}(ℂ, ℝ) := borel _

scoped instance borelSpace_testK : BorelSpace 𝓓^{⊤}_{K}(ℂ, ℝ) := ⟨rfl⟩

variable {α : Type*} [MeasurableSpace α]

/-- **A pointwise measurable random element of `𝓓_K` is Borel measurable.** -/
theorem measurable_testK {T : α → 𝓓^{⊤}_{K}(ℂ, ℝ)} (hm : ∀ z, Measurable fun a => T a z) :
    Measurable T := by
  have hb : (measurableSpace_testK K) = MeasurableSpace.comap (derivsOnK K) MeasurableSpace.pi := by
    change borel _ = _
    rw [(isInducing_derivsOnK K).eq_induced, borel_comap, ← BorelSpace.measurable_eq]
  rw [measurable_iff_comap_le, hb, MeasurableSpace.comap_comp, ← measurable_iff_comap_le]
  refine measurable_pi_iff.2 fun i => ContinuousMap.measurable_iff_eval.2 fun y => ?_
  exact measurable_iteratedFDeriv_apply (fun a => (T a).contDiff) hm i y

/-- **Pairing a distribution with an element of `𝓓_K` is jointly measurable** (Carathéodory). -/
theorem measurable_pair_testK {U : Opens ℂ} (hKU : (K : Set ℂ) ⊆ U) :
    Measurable fun p : 𝓓^{⊤}_{K}(ℂ, ℝ) × DistOn U =>
      p.2 (TestFunction.ofSupportedInCLM ℝ hKU p.1) := by
  have h := measurable_uncurry_of_continuous_of_measurable
    (u := fun (f : 𝓓^{⊤}_{K}(ℂ, ℝ)) (g : DistOn U) => g (TestFunction.ofSupportedInCLM ℝ hKU f))
    (fun g => g.continuous.comp (TestFunction.ofSupportedInCLM ℝ hKU).continuous)
    (fun f => LQGMetric.measurable_distOn_apply _)
  exact h

end TestK

/-! ### Step 3: cutting off along a compact exhaustion -/

section Main

variable {α : Type*} [MeasurableSpace α]

/-- `χ · T a`, an element of `𝓓_L` for `L = supp χ`. -/
def cutTest {χ : ℂ → ℝ} (hχ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) χ) (hχc : HasCompactSupport χ)
    {U : Opens ℂ} (T : α → TestOn U) (a : α) : 𝓓^{⊤}_{⟨tsupport χ, hχc⟩}(ℂ, ℝ) :=
  LQGMetric.testFamK ⟨tsupport χ, hχc⟩ (fun a z => χ z * T a z) (fun a => hχ.mul (T a).contDiff)
    (fun _ z hz => by rw [image_eq_zero_of_notMem_tsupport hz, zero_mul]) a

/-- **A random distribution paired with a pointwise measurable random test function is measurable.** -/
theorem measurable_apply_of_forall_measurable {U : Opens ℂ} {g : α → DistOn U} (hg : Measurable g)
    {T : α → TestOn U} (hT : ∀ z, Measurable fun a => T a z) : Measurable fun a => g a (T a) := by
  have hcut : ∀ n : ℕ, ∃ χ : ℂ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) χ ∧ HasCompactSupport χ ∧
      tsupport χ ⊆ U ∧ EqOn χ 1 (LQGMetric.exhaustK U n) := fun n =>
    GFF.exists_cutoff (LQGMetric.exhaustK U n).isCompact U.isOpen (LQGMetric.exhaustK_subset U n)
  choose χ hχ hχc hχU hχ1 using hcut
  set F : ℕ → α → ℝ := fun n a =>
    g a (TestFunction.ofSupportedInCLM ℝ (K := ⟨tsupport (χ n), hχc n⟩) (hχU n) (cutTest (hχ n) (hχc n) T a))
    with hF
  refine measurable_of_tendsto_metrizable (f := F) (fun n => ?_) ?_
  · have hm : Measurable (cutTest (hχ n) (hχc n) T) :=
      measurable_testK _ fun z => by
        change Measurable fun a => χ n z * T a z
        exact (hT z).const_mul (χ n z)
    exact (measurable_pair_testK ⟨tsupport (χ n), hχc n⟩ (hχU n)).comp (hm.prodMk hg)
  · rw [tendsto_pi_nhds]
    intro a
    obtain ⟨N, hN⟩ := LQGMetric.exists_exhaustK_superset U (T a).hasCompactSupport.isCompact
      (T a).tsupport_subset
    refine tendsto_atTop_of_eventually_const (i₀ := N) fun n hn => ?_
    simp only [hF]
    congr 1
    ext z
    change χ n z * T a z = T a z
    by_cases hz : z ∈ tsupport (T a)
    · rw [hχ1 n (LQGMetric.exhaustK_mono U hn (hN hz)), Pi.one_apply, one_mul]
    · rw [image_eq_zero_of_notMem_tsupport hz, mul_zero]

end Main

end RandomTest

/-! ### The field transported by a random chart -/

namespace Chart

section RandomChart

variable {Ω : Type*} [MeasurableSpace Ω] {c : Ω → Chart} (hc : ∀ ω, (c ω).IsConformal)
include hc

/-- Pointwise measurable forward maps and jointly measurable inverse maps make the domain events measurable. -/
theorem measurableSet_mem_dom_of_fwd_inv (hfwd : ∀ z, Measurable fun ω => (c ω).1 z)
    (hinv : Measurable fun p : Ω × ℂ => (c p.1).2.1 p.2) (z : ℂ) :
    MeasurableSet {ω | z ∈ (c ω).dom} := by
  have he : {ω | z ∈ (c ω).dom} = {ω | (c ω).1 z ∈ H} ∩ {ω | (c ω).2.1 ((c ω).1 z) = z} := by
    ext ω
    exact (hc ω).mem_dom_iff
  rw [he]
  exact (isOpen_H.measurableSet.preimage (hfwd z)).inter
    ((hinv.comp (measurable_id.prodMk (hfwd z))) (measurableSet_singleton z))

/-- The transported test function of a random chart is pointwise measurable, as soon as the domain events are
measurable and the forward maps are measurable on them. -/
theorem measurable_pushTest_apply (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (φ : TestOn upperHalfPlaneOpens) (z : ℂ) :
    Measurable fun ω => pushTest (hc ω) φ z := by
  classical
  obtain ⟨F, hF⟩ : ∃ F : ℂ → Ω → ℂ, F = fun y => {ω | y ∈ (c ω).dom}.indicator fun ω => (c ω).1 y :=
    ⟨_, rfl⟩
  have hFm : ∀ y, Measurable (F y) := fun y => by rw [hF]; exact hfwd y
  have hFv : ∀ y ω, y ∈ (c ω).dom → F y ω = (c ω).1 y := fun y ω hy => by
    rw [hF]; exact indicator_of_mem (show ω ∈ {ω | y ∈ (c ω).dom} from hy) _
  set A := {ω | z ∈ (c ω).dom} with hAdef
  have key : (fun ω => pushTest (hc ω) φ z) =
      fun ω => if ω ∈ A then ‖deriv (c ω).1 z‖ ^ 2 * φ (F z ω) else 0 := by
    funext ω
    split_ifs with h
    · rw [pushTest_apply_of_mem (hc ω) φ h, hFv z ω h]
    · exact pushTest_apply_of_notMem (hc ω) φ h
  rw [key]
  have hφc : Continuous fun w : ℂ => φ w := φ.continuous
  refine measurable_of_tendsto_metrizable (f := fun (n : ℕ) ω => if ω ∈ A then
      ‖((n : ℂ) + 1) • (F (z + ((n : ℂ) + 1)⁻¹ • (1 : ℂ)) ω - F z ω)‖ ^ 2 * φ (F z ω) else 0)
    (fun n => ?_) ?_
  · refine Measurable.ite (hdom z) ?_ measurable_const
    exact ((((hFm _).sub (hFm z)).const_smul ((n : ℂ) + 1)).norm.pow_const 2).mul
      (hφc.measurable.comp (hFm z))
  · rw [tendsto_pi_nhds]
    intro ω
    by_cases hω : ω ∈ A
    · simp only [hω, ↓reduceIte]
      have hdiff : DifferentiableAt ℂ (c ω).1 z :=
        ((hc ω).differentiableOn_fwd z hω).differentiableAt ((c ω).dom.isOpen.mem_nhds hω)
      have hlim := hdiff.hasFDerivAt.lim (1 : ℂ) (c := fun n : ℕ => (n : ℂ) + 1) (l := atTop) (by
        refine tendsto_atTop_mono (fun n => ?_) (tendsto_atTop_add_const_right _ 1
          tendsto_natCast_atTop_atTop)
        rw [show ((n : ℂ) + 1) = ((n + 1 : ℝ) : ℂ) by push_cast; ring, Complex.norm_real,
          Real.norm_eq_abs]
        exact le_abs_self _)
      have hd : fderiv ℂ (c ω).1 z 1 = deriv (c ω).1 z := rfl
      rw [hd] at hlim
      -- the masked values agree with the true ones for large `n`
      have hsmall : Tendsto (fun n : ℕ => z + ((n : ℂ) + 1)⁻¹ • (1 : ℂ)) atTop (𝓝 z) := by
        have h0 : Tendsto (fun n : ℕ => ((n : ℂ) + 1)⁻¹) atTop (𝓝 0) := by
          have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℂ)
          simpa only [one_div] using this
        simpa using tendsto_const_nhds.add (h0.smul_const (1 : ℂ))
      have hev : ∀ᶠ n : ℕ in atTop, z + ((n : ℂ) + 1)⁻¹ • (1 : ℂ) ∈ (c ω).dom :=
        hsmall.eventually ((c ω).dom.isOpen.mem_nhds hω)
      rw [hFv z ω hω]
      refine (((continuous_norm.tendsto _).comp hlim).pow 2).mul_const _ |>.congr' ?_
      filter_upwards [hev] with n hn
      simp only [Function.comp_apply, hFv _ ω hn]
    · simp only [hω, ↓reduceIte]
      exact tendsto_const_nhds

/-- **The field transported by a random chart is a random distribution.** Hypotheses: the domain events
`{z ∈ U_ω}` are measurable, the forward maps are measurable on them, the lift in the coordinate of `ℍ`,
`(ω, w) ↦ lift_ω(inv_ω w)`, is jointly measurable, and it is locally integrable on `ℍ` for every `ω`. Then
`ω ↦ σ (h ω) ∘ inv_ω + a + k (lift_ω ∘ inv_ω)` is measurable. -/
theorem measurable_chartTransport_random
    (hℓ : ∀ ω, LocallyIntegrableOn (fun w => (c ω).2.2 ((c ω).2.1 w)) H)
    (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (hlift : Measurable fun p : Ω × ℂ => (c p.1).2.2 ((c p.1).2.1 p.2))
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : Measurable h) (σ a k : ℝ) :
    Measurable fun ω => chartTransport (hc ω) σ a k (h ω) := by
  refine LQGMetric.measurable_distOn_iff.2 fun φ => ?_
  simp_rw [chartTransport_apply (hc _) (hℓ _)]
  refine ((RandomTest.measurable_apply_of_forall_measurable hh
    (measurable_pushTest_apply hc hdom hfwd φ)).const_mul σ |>.add_const _).add
      (Measurable.const_mul ?_ k)
  have hj : Measurable fun p : Ω × ℂ => (c p.1).2.2 ((c p.1).2.1 p.2) * φ p.2 :=
    hlift.mul (φ.continuous.measurable.comp measurable_snd)
  exact (hj.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

/-- **Joint measurability** in the chart parameter and the field: `(ω, h) ↦ chartTransport (c ω) σ a k h`. -/
theorem measurable_chartTransport_uncurry
    (hℓ : ∀ ω, LocallyIntegrableOn (fun w => (c ω).2.2 ((c ω).2.1 w)) H)
    (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (hlift : Measurable fun p : Ω × ℂ => (c p.1).2.2 ((c p.1).2.1 p.2)) (σ a k : ℝ) :
    Measurable fun p : Ω × DistOn upperHalfPlaneOpens => chartTransport (hc p.1) σ a k p.2 := by
  have hm : Measurable fun q : (Ω × DistOn upperHalfPlaneOpens) × ℂ => (q.1.1, q.2) :=
    (measurable_fst.comp measurable_fst).prodMk measurable_snd
  exact measurable_chartTransport_random (c := fun p : Ω × DistOn upperHalfPlaneOpens => c p.1)
    (fun p => hc p.1) (fun p => hℓ p.1) (fun z => (hdom z).preimage measurable_fst)
    (fun z => (hfwd z).comp measurable_fst) (hlift.comp hm) measurable_snd σ a k

/-- **The field transported by a random chart is a random distribution (pointwise hypotheses).** If the domain
events `{z ∈ U_ω}` are measurable, the forward maps and the lifts are measurable on them, and each lift is
continuous on its chart domain, then `ω ↦ σ (h ω) ∘ inv_ω + a + k (lift_ω ∘ inv_ω)` is measurable. (The lift term is
`∫ lift_ω · pushTest_ω φ`, a Carathéodory integrand: continuous in the point, measurable in `ω`.) -/
theorem measurable_chartTransport_random'
    (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (hliftm : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).2.2 z))
    (hliftc : ∀ ω, ContinuousOn (c ω).2.2 (c ω).dom)
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : Measurable h) (σ a k : ℝ) :
    Measurable fun ω => chartTransport (hc ω) σ a k (h ω) := by
  refine LQGMetric.measurable_distOn_iff.2 fun φ => ?_
  simp_rw [chartTransport_apply' (hc _), liftDist_eq_integral_pushTest (hc _) (hliftc _)]
  refine ((RandomTest.measurable_apply_of_forall_measurable hh
    (measurable_pushTest_apply hc hdom hfwd φ)).const_mul σ |>.add_const _).add
      (Measurable.const_mul ?_ k)
  -- the integrand, as a function of `(z, ω)`
  have hu : Measurable (Function.uncurry fun (z : ℂ) (ω : Ω) => (c ω).2.2 z * pushTest (hc ω) φ z) := by
    refine measurable_uncurry_of_continuous_of_measurable
      (fun ω => continuous_lift_mul_pushTest (hc ω) (hliftc ω) φ) fun z => ?_
    have he : (fun ω => (c ω).2.2 z * pushTest (hc ω) φ z) = fun ω =>
        ({ω | z ∈ (c ω).dom}.indicator (fun ω => (c ω).2.2 z) ω) * pushTest (hc ω) φ z := by
      funext ω
      by_cases hz : z ∈ (c ω).dom
      · rw [indicator_of_mem (show ω ∈ {ω | z ∈ (c ω).dom} from hz)]
      · rw [indicator_of_notMem (show ω ∉ {ω | z ∈ (c ω).dom} from hz),
          pushTest_apply_of_notMem (hc ω) φ hz, zero_mul, mul_zero]
    rw [he]
    exact (hliftm z).mul (measurable_pushTest_apply hc hdom hfwd φ z)
  exact (hu.stronglyMeasurable.integral_prod_left (μ := volume)).measurable

/-- Recentring by a measurable real shift keeps the pointwise hypotheses: the domain and the lift are unchanged,
the forward map is shifted. -/
theorem measurable_chartTransport_recenter_random' {r : Ω → ℝ} (hr : Measurable r)
    (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (hliftm : ∀ z, Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).2.2 z))
    (hliftc : ∀ ω, ContinuousOn (c ω).2.2 (c ω).dom)
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : Measurable h) (σ a k : ℝ) :
    Measurable fun ω => chartTransport ((hc ω).recenter (r ω)) σ a k (h ω) := by
  have hd : ∀ ω, ((c ω).recenter (r ω)).dom = (c ω).dom := fun ω => dom_recenter (c ω) (r ω)
  refine measurable_chartTransport_random' (fun ω => (hc ω).recenter (r ω)) (fun z => ?_) (fun z => ?_)
    (fun z => ?_) (fun ω => ?_) hh σ a k
  · simp_rw [hd]; exact hdom z
  · simp_rw [hd]
    have he : ({ω | z ∈ (c ω).dom}.indicator fun ω => ((c ω).recenter (r ω)).1 z) =
        fun ω => {ω | z ∈ (c ω).dom}.indicator (fun ω => (c ω).1 z) ω -
          ({ω | z ∈ (c ω).dom}.indicator fun ω => ((r ω : ℝ) : ℂ)) ω := by
      funext ω
      by_cases hz : ω ∈ {ω | z ∈ (c ω).dom}
      · simp only [indicator_of_mem hz]; rfl
      · simp only [indicator_of_notMem hz, sub_zero]
    rw [he]
    exact (hfwd z).sub ((Complex.measurable_ofReal.comp hr).indicator (hdom z))
  · simp_rw [hd]; exact hliftm z
  · rw [hd]; exact hliftc ω

omit hc in
/-- The masked forward maps are measurable when the forward maps are pointwise measurable. -/
theorem measurable_indicator_fwd (hdom : ∀ z, MeasurableSet {ω | z ∈ (c ω).dom})
    (hfwd : ∀ z, Measurable fun ω => (c ω).1 z) (z : ℂ) :
    Measurable ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z) :=
  (hfwd z).indicator (hdom z)

