import InteractingSLE.GFF.LocalSets.Prop39

/-!
# Proposition 3.9, second clause: conditional independence of the field on `C`

Specification §3.2, Proposition 3.9 (p. 71; transcription `source/spec/p049-096.md#prop-3.9`):
"In particular, `h|_C` is independent of the pair `(h|_{D∖C}, A₂)` given `𝒜₁`." Packet PROVE-LS-C.

Here `h|_{D∖C}` is recorded by the σ-algebra `offSigma C h` of the pairings `(h, ψ)` with
`supp ψ ⊆ ℍ ∖ C` (through the relative closure), and the independence is stated through
conditional characteristic functions: for every test function `φ`, on `{supp φ ⊆ C}`,
`E[e^{i(h, φ)} | 𝒜₁ ∨ σ(A₂) ∨ offSigma C h] = E[e^{i(h, φ)} | 𝒜₁] = e^{i(𝒞_{A₁}, φ)} e^{−σ²_C(φ)/2}`
(`IsLocalSetMean.condExp_exp_eq_on_of_union`). By linearity in `φ` this fixes the joint
conditional characteristic functions of the field on `C`.

## Proof (own route on `ℍ`, ruling R34)

The specification decomposes the conditional GFF on `D ∖ A₁` over its components and applies
Lemma 3.6 (ii) in the conditional domain. Here the cover argument of Proposition 3.7
(`exists_condExp_germSigmaK`) is run for the random set `S = (ℍ ∖ C) ∪ A₁ ∪ A₂` (a.s. `ℍ ∖ C`) with the
marking `σ(A₁, A₂)` and the joint avoidance σ-algebras of `(A₁, A₂)` (`isCoverMarking_of_subset`:
`A₁, A₂ ⊆ S` gives the trace condition, and the independence is that of Proposition 3.7). It gives
the conditional law `M + GFF_C` given `𝒦 = 𝒮 ∨ σ(A₁, A₂) ∨ 𝒜₁ ∨ offSigma C h` (`𝒮` the germ
σ-algebra of `S`), and the tower argument identifies `M = 𝒞_{A₁}` on `{supp φ ⊆ C}`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

universe u

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace Metric
open scoped ENNReal

namespace InteractingSLE
namespace LocalSets

open QuantumZipper LQGMetric

/-! ### The field off `C` -/

/-- The σ-algebra of the field off the random open set `C`: generated by the pairings `(h, ψ)` on
the events `{supp ψ ⊆ ℍ ∖ C}` (`ℍ ∖ C` through its relative closure). -/
@[instance_reducible]
def offSigma {Ω : Type*} (C : Ω → Set ℂ) (h : Ω → DistOn upperHalfPlaneOpens) :
    MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {E | ∃ (ψ : TestOn upperHalfPlaneOpens) (B : Set ℝ),
    MeasurableSet B ∧ E = {ω | tsupport ψ ⊆ relClosureH (H \ C ω)} ∩ (fun ω => h ω ψ) ⁻¹' B}

/-- `{S | K ⊆ relClosureH S}` is hitting-measurable for compact `K ⊆ ℍ`. -/
theorem measurableSet_subset_relClosureH {K : Set ℂ} (hK : IsCompact K) (hKH : K ⊆ H) :
    MeasurableSet[hittingSigma] {S : Set ℂ | K ⊆ relClosureH S} := by
  have e : {S : Set ℂ | K ⊆ relClosureH S} =
      ⋂ n : ℕ, {S : Set ℂ | K ⊆ thickening (1 / ((n : ℝ) + 1)) (S ∩ H)} := by
    ext S
    simp only [mem_ofPred_eq, mem_iInter]
    constructor
    · intro hS n z hz
      exact closure_subset_thickening (by positivity) _ (hS hz).2
    · intro hS z hz
      refine ⟨hKH hz, Metric.mem_closure_iff.2 fun ε hε => ?_⟩
      obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
      obtain ⟨b, hb, hzb⟩ := mem_thickening_iff.1 (hS n hz)
      exact ⟨b, hb, hzb.trans hn⟩
  rw [e]
  exact MeasurableSet.iInter fun n => measurableSet_subset_thickening hK (by positivity)

theorem offSigma_le {Ω : Type*} [mΩ : MeasurableSpace Ω] {A₁ C : Ω → Set ℂ}
    (hA₁ : Measurable[mΩ, hittingSigma] A₁)
    (hCm : Measurable[MeasurableSpace.comap A₁ hittingSigma, hittingSigma] fun ω => H \ C ω)
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h) : offSigma C h ≤ mΩ := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨ψ, B, hB, rfl⟩
  exact hA₁.comap_le _ (hCm (measurableSet_subset_relClosureH ψ.hasCompactSupport
    ψ.tsupport_subset)) |>.inter ((measurable_distOn_apply ψ).comp hhm hB)

/-! ### The cover marking of a random set containing `A₁` and `A₂` -/

section Marking

variable {Ω : Type u} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {A₁ A₂ : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}

/-- The marking `σ(A₁, A₂)` with the joint avoidance σ-algebras, for any `σ(A₁, A₂)`-measurable
random set `S ⊇ A₁ ∪ A₂`. -/
theorem isCoverMarking_of_subset (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hl₁ : IsAvoidanceLocal A₁ h P) (hl₂ : IsAvoidanceLocal A₂ h P)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    {S : Ω → Set ℂ}
    (hSm : Measurable[MeasurableSpace.comap A₁ hittingSigma ⊔
      MeasurableSpace.comap A₂ hittingSigma, hittingSigma] S)
    (hS₁ : ∀ ω, A₁ ω ⊆ S ω) (hS₂ : ∀ ω, A₂ ω ⊆ S ω) :
    IsCoverMarking S h P
      (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma)
      (avoidSigma₂ A₁ A₂) where
  le := sup_le hA₁.comap_le hA₂.comap_le
  le_avoid := avoidSigma₂_le hA₁ hA₂
  comap_le := hSm.comap_le
  trace := by
    intro j T B hB
    by_cases hT : T ⊆ coverIdx j
    · have hatom : MeasurableSet[MeasurableSpace.comap A₁ hittingSigma ⊔
          MeasurableSpace.comap A₂ hittingSigma] (coverAtom j S T) :=
        hSm (measurableSet_removedIdx_eq j T)
      have hsub : coverAtom j S T ⊆
          {ω | Disjoint (A₁ ω) (coverThick j T)} ∩ {ω | Disjoint (A₂ ω) (coverThick j T)} := by
        intro ω hω
        have := coverAtom_subset_avoid j S T hω
        simp only [mem_ofPred_eq] at this
        exact ⟨this.mono_left (hS₁ ω), this.mono_left (hS₂ ω)⟩
      have e : B ∩ coverAtom j S T = (B ∩ coverAtom j S T) ∩
          ({ω | Disjoint (A₁ ω) (coverThick j T)} ∩ {ω | Disjoint (A₂ ω) (coverThick j T)}) :=
        (inter_eq_left.2 (inter_subset_right.trans hsub)).symm
      rw [e]
      exact measurableSet_avoidSigma₂_inter_sup (isOpen_coverThick j T)
        (inter_subset_left.trans (coverOpen_subset_coverThick j T)) (coverThick_subset_H hT)
        (hB.inter hatom)
    · rw [coverAtom_eq_empty hT, inter_empty]
      exact @MeasurableSet.empty _ (avoidSigma₂ A₁ A₂ (markovOpen T))
  indep T := indep_markov_avoidSigma₂ hh hA₁ hA₂ hl₁ hl₂ hci (measurable_coverMarkov.{u} T)
    (isMarkovDecomposition_coverMarkov hh T)

end Marking

/-! ### The conditional law of the field on `C` -/

section Main

variable {Ω : Type u} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {A₁ A₂ : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}

omit [IsProbabilityMeasure P] in
/-- Pull-out of a bounded phase `e^{iW}`, `W` `m`-measurable. -/
lemma condExp_exp_mul_of_measurable [IsFiniteMeasure P] {m : MeasurableSpace Ω} {W : Ω → ℝ}
    (hW : Measurable[m] W) {F : Ω → ℂ} (hF : Integrable F P) (hm : m ≤ mΩ) :
    P[fun ω => Complex.exp (Complex.I * (W ω : ℂ)) * F ω | m] =ᵐ[P]
      fun ω => Complex.exp (Complex.I * (W ω : ℂ)) * P[F | m] ω := by
  have hEm : StronglyMeasurable[m] fun ω => Complex.exp (Complex.I * (W ω : ℂ)) :=
    (@GFF.measurable_exp_I_mul Ω m _ hW).stronglyMeasurable
  have hEb : ∀ ω, ‖Complex.exp (Complex.I * (W ω : ℂ))‖ ≤ 1 := fun ω =>
    (Complex.norm_exp_I_mul_ofReal _).le
  have hEF : Integrable (fun ω => Complex.exp (Complex.I * (W ω : ℂ)) * F ω) P :=
    hF.bdd_mul (hEm.mono hm).aestronglyMeasurable (Eventually.of_forall hEb)
  have hpull := condExp_bilin_of_stronglyMeasurable_left (ContinuousLinearMap.mul ℝ ℂ) hEm
    (by simpa [ContinuousLinearMap.mul_apply'] using hEF) hF
  simpa [ContinuousLinearMap.mul_apply'] using hpull

/-- The conditioning σ-algebra of the cover argument for `S = (ℍ ∖ C) ∪ A₁ ∪ A₂`. -/
@[instance_reducible]
def offCoverSigma (A₁ A₂ C : Ω → Set ℂ) (h : Ω → DistOn upperHalfPlaneOpens) :
    MeasurableSpace Ω :=
  germSigma (fun ω => (H \ C ω) ∪ A₁ ω ∪ A₂ ω) h ⊔
    (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma) ⊔
      germSigma A₁ h ⊔ offSigma C h

/-- **Proposition 3.9, second clause** ("`h|_C` is independent of the pair `(h|_{D∖C}, A₂)` given
`𝒜₁`"). In the setting of `IsLocalSetMean.ae_eq_on_of_union`, for every test function `φ`, almost
surely on `{supp φ ⊆ C}`, the conditional characteristic function of `(h, φ)` given
`𝒜₁ ∨ σ(A₂) ∨ σ(h|_{ℍ∖C})` is the one given `𝒜₁`, namely `e^{i(𝒞_{A₁}, φ)} e^{−σ²_C(φ)/2}`. -/
theorem IsLocalSetMean.condExp_exp_eq_on_of_union
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) {C : Ω → Set ℂ}
    (hCm : Measurable[MeasurableSpace.comap A₁ hittingSigma, hittingSigma] fun ω => H \ C ω)
    (hC : ∀ᵐ ω ∂P, C ω ⊆ H \ A₁ ω ∧ ∀ z ∈ C ω, connectedComponentIn (H \ A₁ ω) z ⊆ C ω)
    (hCA₂ : ∀ᵐ ω ∂P, Disjoint (C ω) (A₂ ω))
    {g₁ : Ω → DistOn upperHalfPlaneOpens} (hg₁ : IsLocalSetMean A₁ h P g₁)
    (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂P, tsupport φ ⊆ C ω →
      P[fun ω => Complex.exp (Complex.I * (h ω φ : ℂ)) |
          germSigma A₁ h ⊔ (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)] ω =
        P[fun ω => Complex.exp (Complex.I * (h ω φ : ℂ)) | germSigma A₁ h] ω ∧
      P[fun ω => Complex.exp (Complex.I * (h ω φ : ℂ)) | germSigma A₁ h] ω =
        Complex.exp (Complex.I * (g₁ ω φ : ℂ)) *
          ((Real.exp (-(1 / 2) * zeroGFFTestCov (C ω) φ φ) : ℝ) : ℂ) := by
  classical
  have hhm := hh.measurable
  set S : Ω → Set ℂ := fun ω => (H \ C ω) ∪ A₁ ω ∪ A₂ ω with hSdef
  have hS₁ : ∀ ω, A₁ ω ⊆ S ω := fun ω z hz => Or.inl (Or.inr hz)
  have hS₂ : ∀ ω, A₂ ω ⊆ S ω := fun ω z hz => Or.inr hz
  have hSm : Measurable[MeasurableSpace.comap A₁ hittingSigma ⊔
      MeasurableSpace.comap A₂ hittingSigma, hittingSigma] S :=
    @measurable_union_hitting Ω (MeasurableSpace.comap A₁ hittingSigma ⊔
      MeasurableSpace.comap A₂ hittingSigma) _ _
      (@measurable_union_hitting Ω (MeasurableSpace.comap A₁ hittingSigma ⊔
        MeasurableSpace.comap A₂ hittingSigma) _ _ (hCm.mono le_sup_left le_rfl)
        ((comap_measurable A₁).mono le_sup_left le_rfl))
      ((comap_measurable A₂).mono le_sup_right le_rfl)
  have hℳle : MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma ≤ mΩ :=
    sup_le hA₁.comap_le hA₂.comap_le
  have hSm' : Measurable[mΩ, hittingSigma] S := hSm.mono hℳle le_rfl
  have hl₁ := (IsLocalSet.isMarkedAvoidanceLocal hhm hA₁ h₁).isAvoidanceLocal hA₁ hhm
  have hl₂ := (IsLocalSet.isMarkedAvoidanceLocal hhm hA₂ h₂).isAvoidanceLocal hA₂ hhm
  have hmk := isCoverMarking_of_subset hh hA₁ hA₂ hl₁ hl₂ hci hSm hS₁ hS₂
  -- the structural facts, almost surely
  have hgood : ∀ᵐ ω ∂P, IsOpen (H \ A₁ ω) ∧ IsOpen (C ω) ∧ C ω ⊆ H \ A₁ ω ∧
      IsOpen ((H \ A₁ ω) \ C ω) ∧ S ω = H \ C ω ∧ relClosureH (A₁ ω) = A₁ ω := by
    filter_upwards [h₁.2.1, h₂.2.1, hC, hCA₂] with ω ⟨hs₁, ho₁⟩ ⟨hs₂, _⟩ ⟨hCs, hCc⟩ hd
    refine ⟨ho₁, isOpen_of_forall_connectedComponentIn_subset ho₁ hCs hCc, hCs,
      isOpen_diff_of_forall_connectedComponentIn_subset ho₁ hCc, ?_, relClosureH_eq hs₁ ho₁⟩
    refine subset_antisymm ?_ (fun z hz => Or.inl (Or.inl hz))
    rintro z ((hz | hz) | hz)
    · exact hz
    · exact ⟨hs₁ hz, fun hzC => (hCs hzC).2 hz⟩
    · exact ⟨hs₂ hz, fun hzC => Set.disjoint_left.1 hd hzC hz⟩
  have hSc : ∀ᵐ ω ∂P, S ω ⊆ H ∧ IsOpen (H \ S ω) := by
    filter_upwards [hgood] with ω ⟨_, hCo, hCs, _, hS, _⟩
    rw [hS, sdiff_sdiff_cancel_left (hCs.trans sdiff_subset)]
    exact ⟨sdiff_subset, hCo⟩
  -- the conditioning σ-algebra of the cover argument
  have h𝒦S : germSigma S h ≤ offCoverSigma A₁ A₂ C h :=
    le_sup_left.trans (le_sup_left.trans le_sup_left)
  have h𝒦ℳ : MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma ≤
      offCoverSigma A₁ A₂ C h := le_sup_right.trans (le_sup_left.trans le_sup_left)
  have h𝒦A₁ : germSigma A₁ h ≤ offCoverSigma A₁ A₂ C h := le_sup_right.trans le_sup_left
  have h𝒦off : offSigma C h ≤ offCoverSigma A₁ A₂ C h := le_sup_right
  have h𝒦le : offCoverSigma A₁ A₂ C h ≤ mΩ :=
    sup_le (sup_le (sup_le (germSigma_le hSm' hhm) hℳle) (germSigma_le hA₁ hhm))
      (offSigma_le hA₁ hCm hhm)
  have h𝒦tr : ∀ j, offCoverSigma A₁ A₂ C h ≤ aeSigma (coverSigmaM
      (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma) j S h) P := by
    intro j
    have hℳ : MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma ≤
        aeSigma (coverSigmaM (MeasurableSpace.comap A₁ hittingSigma ⊔
          MeasurableSpace.comap A₂ hittingSigma) j S h) P := le_sup_left.trans (le_aeSigma _ P)
    refine sup_le (sup_le (sup_le (fun G hG => germSigmaAt_le_aeSigmaM hh hmk.comap_le j G
      (measurableSet_germSigmaAt_coverRad hG j)) hℳ)
      (germSigma_le_aeSigma_of_subset hh hmk.comap_le le_sup_left hS₁ j)) ?_
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨ψ, B, hB, rfl⟩
    have hE₁ : MeasurableSet[MeasurableSpace.comap A₁ hittingSigma ⊔
        MeasurableSpace.comap A₂ hittingSigma] {ω | tsupport ψ ⊆ relClosureH (H \ C ω)} :=
      (le_sup_left : MeasurableSpace.comap A₁ hittingSigma ≤ _) _
        (hCm (measurableSet_subset_relClosureH ψ.hasCompactSupport ψ.tsupport_subset))
    have hX : MeasurableSet[germSigmaAt S h (coverRad j)]
        ({ω | tsupport ψ ⊆ germNbhd (coverRad j) (S ω)} ∩ (fun ω => h ω ψ) ⁻¹' B) :=
      (le_sup_right : MeasurableSpace.generateFrom {E | ∃ (φ : TestOn upperHalfPlaneOpens)
        (B : Set ℝ), MeasurableSet B ∧ E = {ω | tsupport φ ⊆ germNbhd (coverRad j) (S ω)} ∩
          (fun ω => h ω φ) ⁻¹' B} ≤ germSigmaAt S h (coverRad j)) _
        (MeasurableSpace.measurableSet_generateFrom ⟨ψ, B, hB, rfl⟩)
    have hsub : {ω | tsupport ψ ⊆ relClosureH (H \ C ω)} ⊆
        {ω | tsupport ψ ⊆ germNbhd (coverRad j) (S ω)} := by
      intro ω hω z hz
      have hz' := hω hz
      refine ⟨hz'.1, Or.inl (thickening_subset_of_subset _ subset_union_left
        (closure_subset_thickening (coverRad_pos j) _ (closure_mono ?_ hz'.2)))⟩
      exact inter_subset_inter_left _ (fun w hw => Or.inl (Or.inl hw))
    have e : {ω | tsupport ψ ⊆ relClosureH (H \ C ω)} ∩ (fun ω => h ω ψ) ⁻¹' B =
        {ω | tsupport ψ ⊆ relClosureH (H \ C ω)} ∩
          ({ω | tsupport ψ ⊆ germNbhd (coverRad j) (S ω)} ∩ (fun ω => h ω ψ) ⁻¹' B) := by
      ext ω
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, hsub h1, h2⟩
      · rintro ⟨h1, -, h2⟩; exact ⟨h1, h2⟩
    rw [e]
    exact (hℳ _ hE₁).inter (germSigmaAt_le_aeSigmaM hh hmk.comap_le j _ hX)
  -- the cover law at `φ` and at its multiples `φ/(n+1)`
  obtain ⟨M, hMm, -, hMc, hMe⟩ := exists_condExp_germSigmaK hh hSm' hmk hSc h𝒦S h𝒦le h𝒦tr φ
  set c : ℕ → ℝ := fun n => ((n : ℝ) + 1)⁻¹ with hcdef
  choose Mn hMnm hMnlim hMnc hMne using fun n : ℕ =>
    exists_condExp_germSigmaK hh hSm' hmk hSc h𝒦S h𝒦le h𝒦tr (c n • φ)
  -- the event `{supp φ ⊆ C}`
  set G : Set Ω := {ω | Disjoint (tsupport φ) (relClosureH (H \ C ω))} with hGdef
  have hGc : MeasurableSet[MeasurableSpace.comap A₁ hittingSigma] G :=
    hCm (measurableSet_disjoint_relClosureH φ.hasCompactSupport φ.tsupport_subset)
  have hGA₁ : MeasurableSet[germSigma A₁ h] G := comap_le_germSigma A₁ h _ hGc
  have hGsub : ∀ᵐ ω ∂P, (ω ∈ G ↔ tsupport φ ⊆ C ω) := by
    filter_upwards [hgood] with ω ⟨_, hCo, hCs, _, _, _⟩
    have hrc : relClosureH (H \ C ω) = H \ C ω := by
      refine relClosureH_eq sdiff_subset ?_
      rw [sdiff_sdiff_cancel_left (hCs.trans sdiff_subset)]; exact hCo
    simp only [hGdef, mem_ofPred_eq, hrc]
    constructor
    · intro hdis z hz
      by_contra hzC
      exact Set.disjoint_left.1 hdis hz ⟨φ.tsupport_subset hz, hzC⟩
    · intro hsub
      exact Set.disjoint_left.2 fun z hz hz' => hz'.2 (hsub hz)
  -- the variances on `G`
  have hvar : ∀ a : ℝ, ∀ᵐ ω ∂P, ω ∈ G →
      zeroGFFTestCov (H \ A₁ ω) ⇑(a • φ) ⇑(a • φ) =
        zeroGFFTestCov (H \ relClosureH (S ω)) ⇑(a • φ) ⇑(a • φ) ∧
      zeroGFFTestCov (H \ A₁ ω) ⇑(a • φ) ⇑(a • φ) = zeroGFFTestCov (C ω) ⇑(a • φ) ⇑(a • φ) := by
    intro a
    filter_upwards [hgood, hGsub] with ω ⟨ho₁, hCo, hCs, hd₁, hS, _⟩ hG hωG
    have hsupp : tsupport ⇑(a • φ) ⊆ C ω :=
      (tsupport_smul_subset_right (fun _ => a) φ).trans (hG.1 hωG)
    have e1 := zeroGFFTestCov_eq_of_isClopen ho₁ sdiff_subset hCo hCs hd₁ (a • φ) hsupp
    have hHS : H \ S ω = C ω := by rw [hS, sdiff_sdiff_cancel_left (hCs.trans sdiff_subset)]
    have hrcS : relClosureH (S ω) = S ω :=
      relClosureH_eq (by rw [hS]; exact sdiff_subset) (by rw [hHS]; exact hCo)
    refine ⟨?_, e1⟩
    rw [hrcS, hHS]; exact e1
  -- the two laws in subtracted form
  have hlaw₁ : ∀ ψ : TestOn upperHalfPlaneOpens,
      P[fun ω => Complex.exp (Complex.I * ((h ω ψ - g₁ ω ψ : ℝ) : ℂ)) | germSigma A₁ h] =ᵐ[P]
        fun ω => ((Real.exp (-(1 / 2) * zeroGFFTestCov (H \ A₁ ω) ψ ψ) : ℝ) : ℂ) := fun ψ => by
    have := hg₁.2.2 ψ
    simpa only [sub_apply] using this
  have hlaw₂ : ∀ n, P[fun ω => Complex.exp (Complex.I * ((h ω (c n • φ) - Mn n ω : ℝ) : ℂ)) |
      offCoverSigma A₁ A₂ C h] =ᵐ[P] fun ω => ((Real.exp (-(1 / 2) *
        zeroGFFTestCov (H \ relClosureH (S ω)) ⇑(c n • φ) ⇑(c n • φ)) : ℝ) : ℂ) := by
    intro n
    have hF : Integrable (fun ω => Complex.exp (Complex.I * (h ω (c n • φ) : ℂ))) P :=
      GFF.integrable_exp_I_mul ((measurable_distOn_apply _).comp hhm)
    have hpull := condExp_exp_mul_of_measurable (m := offCoverSigma A₁ A₂ C h)
      (W := fun ω => -Mn n ω) ((hMnm n).neg.mono h𝒦S le_rfl) hF h𝒦le
    have e : (fun ω => Complex.exp (Complex.I * ((h ω (c n • φ) - Mn n ω : ℝ) : ℂ))) =
        fun ω => Complex.exp (Complex.I * ((-Mn n ω : ℝ) : ℂ)) *
          Complex.exp (Complex.I * (h ω (c n • φ) : ℂ)) := by
      funext ω; rw [← Complex.exp_add]; congr 1; push_cast; ring
    rw [e]
    filter_upwards [hpull, hMne n] with ω h1 h2
    rw [h1, ← h2, ← mul_assoc, ← Complex.exp_add]
    have : Complex.I * ((-Mn n ω : ℝ) : ℂ) + Complex.I * (Mn n ω : ℂ) = 0 := by push_cast; ring
    rw [this, Complex.exp_zero, one_mul]
  -- the tower argument at each multiple
  have hcos : ∀ n, ∀ᵐ ω ∂P, ω ∈ G → Real.cos (Mn n ω - g₁ ω (c n • φ)) = 1 := fun n => by
    have hX : Measurable fun ω => h ω (c n • φ) := (measurable_distOn_apply _).comp hhm
    have hM₁ : Measurable[germSigma A₁ h] fun ω => g₁ ω (c n • φ) :=
      (measurable_distOn_apply _).comp hg₁.1
    exact ae_cos_eq_one_of_condCharFun (P := P) h𝒦A₁ h𝒦le hX hM₁ ((hMnm n).mono h𝒦S le_rfl)
      (hlaw₁ _) (hlaw₂ n) hGA₁ (by filter_upwards [hvar (c n)] with ω hω hωG using (hω hωG).1)
  have hMn : ∀ n, Mn n =ᵐ[P] fun ω => c n * M ω := by
    intro n
    have e : (fun ω => h ω (c n • φ)) = c n • fun ω => h ω φ := by
      funext ω; rw [map_smul]; rfl
    have h1 := hMnc n
    rw [e] at h1
    filter_upwards [h1, condExp_smul (μ := P) (c n) (fun ω => h ω φ) (offCoverSigma A₁ A₂ C h),
      hMc] with ω h1 h2 h3
    rw [h1, h2, Pi.smul_apply, smul_eq_mul, ← h3]
  have hMg : ∀ᵐ ω ∂P, ω ∈ G → M ω = g₁ ω φ := by
    filter_upwards [ae_all_iff.2 hcos, ae_all_iff.2 hMn] with ω h1 h2 hωG
    have : ∀ n : ℕ, Real.cos (((n : ℝ) + 1)⁻¹ * (M ω - g₁ ω φ)) = 1 := fun n => by
      have := h1 n hωG
      rwa [h2 n, map_smul, smul_eq_mul, ← mul_sub] at this
    have := eq_zero_of_forall_cos_eq_one this
    linarith
  -- the common value `Z = e^{i(𝒞_{A₁}, φ)} e^{−σ²/2}`
  set F : Ω → ℂ := fun ω => Complex.exp (Complex.I * (h ω φ : ℂ)) with hFdef
  have hFi : Integrable F P := GFF.integrable_exp_I_mul ((measurable_distOn_apply φ).comp hhm)
  set Z : Ω → ℂ := fun ω => Complex.exp (Complex.I * (g₁ ω φ : ℂ)) *
    ((Real.exp (-(1 / 2) * zeroGFFTestCov (H \ relClosureH (A₁ ω)) φ φ) : ℝ) : ℂ) with hZdef
  have hg₁φ : Measurable[germSigma A₁ h] fun ω => g₁ ω φ := (measurable_distOn_apply φ).comp hg₁.1
  have hZm : StronglyMeasurable[germSigma A₁ h] Z := by
    have hv : Measurable[germSigma A₁ h] fun ω =>
        zeroGFFTestCov (H \ relClosureH (A₁ ω)) φ φ :=
      (measurable_comap_zeroGFFTestCov_compl A₁ φ φ).mono (comap_le_germSigma A₁ h) le_rfl
    exact ((@GFF.measurable_exp_I_mul Ω (germSigma A₁ h) _ hg₁φ).mul
      (Complex.measurable_ofReal.comp (Real.measurable_exp.comp
        (measurable_const.mul hv)))).stronglyMeasurable
  have hZb : ∀ ω, ‖Z ω‖ ≤ 1 := fun ω => by
    rw [hZdef, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    refine Real.exp_le_one_iff.2 ?_
    have := zeroGFFTestCov_self_nonneg (isOpen_H_diff_relClosureH (A₁ ω)) sdiff_subset φ
    nlinarith
  have hA₁le := germSigma_le hA₁ hhm
  -- (a) the `𝒜₁`-law
  have hlawA : P[F | germSigma A₁ h] =ᵐ[P] Z := by
    have hF' : Integrable (fun ω => Complex.exp (Complex.I * ((h ω φ - g₁ ω φ : ℝ) : ℂ))) P :=
      GFF.integrable_exp_I_mul (((measurable_distOn_apply φ).comp hhm).sub
        (hg₁φ.mono hA₁le le_rfl))
    have hpull := condExp_exp_mul_of_measurable (W := fun ω => g₁ ω φ) hg₁φ hF' hA₁le
    have e : F = fun ω => Complex.exp (Complex.I * (g₁ ω φ : ℂ)) *
        Complex.exp (Complex.I * ((h ω φ - g₁ ω φ : ℝ) : ℂ)) := by
      funext ω; rw [hFdef, ← Complex.exp_add]; push_cast; ring_nf
    rw [e]
    have hrc₁ : ∀ᵐ ω ∂P, zeroGFFTestCov (H \ relClosureH (A₁ ω)) φ φ =
        zeroGFFTestCov (H \ A₁ ω) φ φ := by
      filter_upwards [h₁.2.1] with ω ⟨hs, ho⟩
      rw [relClosureH_eq hs ho]
    filter_upwards [hpull, hlaw₁ φ, hrc₁] with ω h1 h2 h3
    rw [h1, h2, hZdef]
    simp only
    rw [h3]
  -- (b) the cover law on `G`
  have hlawK : ∀ᵐ ω ∂P, ω ∈ G → P[F | offCoverSigma A₁ A₂ C h] ω = Z ω := by
    filter_upwards [hMe, hMg, hvar 1, hgood] with ω h1 h2 h3 h4 hωG
    rw [← h1, h2 hωG, hZdef]
    simp only
    have := (h3 hωG).1
    simp only [one_smul] at this
    rw [← this, h4.2.2.2.2.2]
  -- (c) the tower step to `𝒜₁ ∨ σ(A₂) ∨ σ(h|_{ℍ∖C})`
  have h𝒦'𝒦 : germSigma A₁ h ⊔ (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h) ≤
      offCoverSigma A₁ A₂ C h :=
    sup_le h𝒦A₁ (sup_le ((le_sup_right : MeasurableSpace.comap A₂ hittingSigma ≤
      MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma).trans h𝒦ℳ)
      h𝒦off)
  have hGK' : MeasurableSet[germSigma A₁ h ⊔
      (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)] G :=
    (le_sup_left : germSigma A₁ h ≤ germSigma A₁ h ⊔
      (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)) _ hGA₁
  have hGK : MeasurableSet[offCoverSigma A₁ A₂ C h] G := h𝒦A₁ _ hGA₁
  have hZK' : StronglyMeasurable[germSigma A₁ h ⊔
      (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)] (G.indicator Z) :=
    (hZm.indicator hGA₁).mono le_sup_left
  have hZi : Integrable (G.indicator Z) P :=
    (Integrable.of_bound (hZm.mono hA₁le).aestronglyMeasurable 1
      (Eventually.of_forall hZb)).indicator (hA₁le _ hGA₁)
  have e1 := condExp_indicator (μ := P) (m := germSigma A₁ h ⊔
    (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)) hFi hGK'
  have e2 := condExp_indicator (μ := P) (m := offCoverSigma A₁ A₂ C h) hFi hGK
  have e3 : G.indicator (P[F | offCoverSigma A₁ A₂ C h]) =ᵐ[P] G.indicator Z := by
    filter_upwards [hlawK] with ω hω
    by_cases hωG : ω ∈ G
    · rw [indicator_of_mem hωG, indicator_of_mem hωG, hω hωG]
    · rw [indicator_of_notMem hωG, indicator_of_notMem hωG]
  have e4 := condExp_condExp_of_le (μ := P) (f := G.indicator F) h𝒦'𝒦 h𝒦le
  have e5 : P[G.indicator Z | germSigma A₁ h ⊔
      (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)] = G.indicator Z :=
    condExp_of_stronglyMeasurable (h𝒦'𝒦.trans h𝒦le) hZK' hZi
  have hC1 : G.indicator (P[F | germSigma A₁ h ⊔
      (MeasurableSpace.comap A₂ hittingSigma ⊔ offSigma C h)]) =ᵐ[P] G.indicator Z :=
    e1.symm.trans (e4.symm.trans ((condExp_congr_ae (e2.trans e3)).trans
      (Eventually.of_forall fun ω => congrFun e5 ω)))
  filter_upwards [hC1, hlawA, hGsub, hgood] with ω h1 h2 h3 h4 hsupp
  have hωG : ω ∈ G := h3.2 hsupp
  rw [indicator_of_mem hωG, indicator_of_mem hωG] at h1
  refine ⟨h1.trans h2.symm, ?_⟩
  rw [h2, hZdef]
  simp only
  rw [h4.2.2.2.2.2, zeroGFFTestCov_eq_of_isClopen h4.1 sdiff_subset h4.2.1 h4.2.2.1 h4.2.2.2.1 φ
    hsupp]

