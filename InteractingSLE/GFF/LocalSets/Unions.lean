import InteractingSLE.GFF.LocalSets.MarkedAvoidance
import LQGMetric.Prob.CondIndepUnion

/-!
# Conditionally independent unions of local sets: the marked avoidance step of Proposition 3.7

Source: specification Proposition 3.7 (p. 57, `source/spec/p049-096.md#prop-3.7`) and the first
paragraph of its proof (`#prop-3.7-proof`, L178): with `X = P_U h`, `Y = h − P_U h`,
`E_i = {A_i ∩ U = ∅}` and `R_i` recording `(1_{E_i}, A_i)` on `E_i`, Lemma 3.6 (ii) for each `A_i`,
the conditional independence of `A₁, A₂` given `h`, and the independence of `X` and `Y` show that
`X` keeps its law given `(Y, R₁, R₂)`: "this proves locality of `A₁ ∪ A₂` and the avoidance criterion
with both set labels retained".

The conditionally independent union `A₁ ∪̃ A₂` is represented on one probability space carrying
`h, A₁, A₂` with `A₁` and `A₂` conditionally independent given `h` (`CondIndepEv (σ(h)) (σ(A₁))
(σ(A₂))`), each `(A_i, h)` being the given local coupling.

## Main results

* `condIndepEv_markedSigma_sup` : the avoidance criterion with both labels retained,
  `(R₁, R₂) ⟂ X | Y`;
* `IsMarkedAvoidanceLocal.union`, `IsLocalSet.isMarkedAvoidanceLocal_union`,
  `IsLocalSet.isAvoidanceLocal_union` : the union satisfies Lemma 3.6 (ii) and (i).

Locality of the union (Lemma 3.6 (iv)) then follows from Lemma 3.6 (i) ⇒ (iii), which is not proved
here.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set TopologicalSpace

namespace InteractingSLE
namespace LocalSets

open QuantumZipper LQGMetric

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

omit mΩ in
/-- The marked σ-algebra is generated by functions of the set. -/
theorem markedSigma_le_comap (A : Ω → Set ℂ) {U : Set ℂ} (hU : IsOpen U) (hUH : U ⊆ H) :
    markedSigma A U ≤ MeasurableSpace.comap A hittingSigma := by
  refine sup_le (MeasurableSpace.generateFrom_le ?_) ?_
  · rintro _ rfl
    exact ⟨_, measurableSet_avoid hU hUH, rfl⟩
  · rw [show (fun ω => markedSet U (A ω)) = markedSet U ∘ A from rfl,
      ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_markedSet hU hUH).comap_le

omit mΩ in
/-- The marked σ-algebra of a union is contained in the join of the marked σ-algebras. -/
theorem markedSigma_union_le (A₁ A₂ : Ω → Set ℂ) (U : Set ℂ) :
    markedSigma (fun ω => A₁ ω ∪ A₂ ω) U ≤ markedSigma A₁ U ⊔ markedSigma A₂ U := by
  have hE₁ := measurableSet_avoid_markedSigma A₁ U
  have hE₂ := measurableSet_avoid_markedSigma A₂ U
  have hE : MeasurableSet[markedSigma A₁ U ⊔ markedSigma A₂ U]
      {ω | Disjoint (A₁ ω ∪ A₂ ω) U} := by
    have e : {ω | Disjoint (A₁ ω ∪ A₂ ω) U} = {ω | Disjoint (A₁ ω) U} ∩ {ω | Disjoint (A₂ ω) U} := by
      ext ω; simp [disjoint_union_left]
    rw [e]
    exact ((le_sup_left : markedSigma A₁ U ≤ _) _ hE₁).inter ((le_sup_right : markedSigma A₂ U ≤ _) _ hE₂)
  refine sup_le (MeasurableSpace.generateFrom_le ?_) ?_
  · rintro _ rfl
    exact hE
  · refine Measurable.comap_le ?_
    refine @measurable_generateFrom Ω (Set ℂ) (markedSigma A₁ U ⊔ markedSigma A₂ U) _ _ ?_
    rintro _ ⟨V, hV, hVH, rfl⟩
    have h₁ : MeasurableSet[markedSigma A₁ U ⊔ markedSigma A₂ U]
        {ω | (markedSet U (A₁ ω) ∩ V).Nonempty} :=
      (le_sup_left : markedSigma A₁ U ≤ _) _ ((le_sup_right : _ ≤ markedSigma A₁ U) _
        ⟨_, measurableSet_hitting hV hVH, rfl⟩)
    have h₂ : MeasurableSet[markedSigma A₁ U ⊔ markedSigma A₂ U]
        {ω | (markedSet U (A₂ ω) ∩ V).Nonempty} :=
      (le_sup_right : markedSigma A₂ U ≤ _) _ ((le_sup_right : _ ≤ markedSigma A₂ U) _
        ⟨_, measurableSet_hitting hV hVH, rfl⟩)
    have e : (fun ω => markedSet U (A₁ ω ∪ A₂ ω)) ⁻¹' {S | (S ∩ V).Nonempty} =
        {ω | Disjoint (A₁ ω ∪ A₂ ω) U} ∩
          ({ω | (markedSet U (A₁ ω) ∩ V).Nonempty} ∪ {ω | (markedSet U (A₂ ω) ∩ V).Nonempty}) := by
      ext ω
      simp only [mem_preimage, mem_ofPred_eq, mem_inter_iff, mem_union,
        markedSet_inter_nonempty_iff, disjoint_union_left, union_inter_distrib_right,
        union_nonempty]
      tauto
    rw [e]
    exact hE.inter (h₁.union h₂)

/-- **Proposition 3.7, marked avoidance.** If `A₁, A₂` satisfy Lemma 3.6 (ii) and are conditionally
independent given `h`, then for every open `U ⊆ ℍ` and every Borel version `G` of the projection
onto `H(U)`, the pair of records `(R₁, R₂)` is conditionally independent of `G h` given `h − G h`. -/
theorem condIndepEv_markedSigma_sup [IsProbabilityMeasure P] {A₁ A₂ : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsMarkedAvoidanceLocal A₁ h P) (h₂ : IsMarkedAvoidanceLocal A₂ h P)
    (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens)
    (hUH : (U : Set ℂ) ⊆ H) (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    CondIndepEv (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
      (markedSigma A₁ U ⊔ markedSigma A₂ U)
      (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance) P := by
  have hYle := ((measurable_markovCompl hG).comp hhm).comap_le
  have hXle := (hG.comp hhm).comap_le
  have hR₁ := markedSigma_le hA₁ U.isOpen hUH
  have hR₂ := markedSigma_le hA₂ U.isOpen hUH
  have hBC : CondIndepEv (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance ⊔
      MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
      (markedSigma A₁ U) (markedSigma A₂ U) P := by
    rw [← comap_eq_sup_markov h hG]
    exact hci.mono (markedSigma_le_comap A₁ U.isOpen hUH) (markedSigma_le_comap A₂ U.isOpen hUH)
  exact (condIndepEv_sup_of_condIndepEv hYle hXle hR₁ hR₂ (h₁ U G hUH hG hd).symm
    (h₂ U G hUH hG hd).symm hBC).symm

/-- The conditionally independent union satisfies Lemma 3.6 (ii). -/
theorem IsMarkedAvoidanceLocal.union [IsProbabilityMeasure P] {A₁ A₂ : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsMarkedAvoidanceLocal A₁ h P) (h₂ : IsMarkedAvoidanceLocal A₂ h P) :
    IsMarkedAvoidanceLocal (fun ω => A₁ ω ∪ A₂ ω) h P := fun U G hUH hG hd =>
  (condIndepEv_markedSigma_sup hhm hA₁ hA₂ hci h₁ h₂ U G hUH hG hd).mono
    (markedSigma_union_le A₁ A₂ U) le_rfl

omit mΩ in
/-- The union of two hitting-measurable random sets is hitting-measurable. -/
theorem measurable_union_hitting [MeasurableSpace Ω] {A₁ A₂ : Ω → Set ℂ}
    (hA₁ : Measurable[_, hittingSigma] A₁) (hA₂ : Measurable[_, hittingSigma] A₂) :
    Measurable[_, hittingSigma] fun ω => A₁ ω ∪ A₂ ω := by
  refine @measurable_generateFrom Ω (Set ℂ) _ _ _ ?_
  rintro _ ⟨V, hV, hVH, rfl⟩
  have e : (fun ω => A₁ ω ∪ A₂ ω) ⁻¹' {S | (S ∩ V).Nonempty} =
      A₁ ⁻¹' {S | (S ∩ V).Nonempty} ∪ A₂ ⁻¹' {S | (S ∩ V).Nonempty} := by
    ext ω; simp [union_inter_distrib_right, union_nonempty]
  rw [e]
  exact (hA₁ (measurableSet_hitting hV hVH)).union (hA₂ (measurableSet_hitting hV hVH))

/-- **Proposition 3.7, first step.** The conditionally independent union of two local sets of a
field satisfies Lemma 3.6 (ii). -/
theorem IsLocalSet.isMarkedAvoidanceLocal_union [IsProbabilityMeasure P] {A₁ A₂ : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    IsMarkedAvoidanceLocal (fun ω => A₁ ω ∪ A₂ ω) h P :=
  IsMarkedAvoidanceLocal.union hhm hA₁ hA₂ hci (IsLocalSet.isMarkedAvoidanceLocal hhm hA₁ h₁)
    (IsLocalSet.isMarkedAvoidanceLocal hhm hA₂ h₂)

/-- **Proposition 3.7, first step.** The conditionally independent union of two local sets of a
field satisfies Lemma 3.6 (i). -/
theorem IsLocalSet.isAvoidanceLocal_union [IsProbabilityMeasure P] {A₁ A₂ : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    IsAvoidanceLocal (fun ω => A₁ ω ∪ A₂ ω) h P :=
  (IsLocalSet.isMarkedAvoidanceLocal_union hhm hA₁ hA₂ hci h₁ h₂).isAvoidanceLocal
    (measurable_union_hitting hA₁ hA₂) hhm

/-! ### Statement (i) does not depend on the version of the projection -/

/-- Lemma 3.6 (i) holds for every Borel version of the projection onto `H(U)` as soon as it holds for
one (versions agree almost surely, `ae_eq_of_isMarkovDecomposition`). -/
theorem isAvoidanceLocal_iff_exists {A : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}
    [IsProbabilityMeasure P] (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) :
    IsAvoidanceLocal A h P ↔ ∀ U : Opens ℂ, (U : Set ℂ) ⊆ H →
      ∃ G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens, Measurable G ∧
        GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P ∧
        ∃ g : DistOn upperHalfPlaneOpens → ℝ, Measurable g ∧
          P⟦{ω | Disjoint (A ω) U} | MeasurableSpace.comap h inferInstance⟧ =ᵐ[P]
            fun ω => g (markovCompl G (h ω)) := by
  constructor
  · intro hi U hUH
    obtain ⟨G, hG, hMD⟩ := exists_markovMap U hUH
    exact ⟨G, hG, hMD hh, hi U G hUH hG (hMD hh)⟩
  · intro hex U G' hUH hG' hd'
    obtain ⟨G, hG, hd, g, hg, heq⟩ := hex U hUH
    refine ⟨g, hg, heq.trans ?_⟩
    filter_upwards [ae_eq_of_isMarkovDecomposition hUH hd hd'] with ω hω
    simp only [markovCompl] at hω ⊢
    rw [hω]

/-! ### The remaining implication, as a named conditional helper -/

section Conditional

universe u

variable {Ω₀ : Type u} [MeasurableSpace Ω₀] {P₀ : Measure Ω₀} [IsProbabilityMeasure P₀]

/-- **Lemma 3.6, conditional on (i) ⇒ (iii).** Conditional helper, not Lemma 3.6 itself: the
implications (ii) ⇒ (i), (iii) ⇒ (iv) and (iv) ⇒ (ii) are proved; the hypothesis `h13` is the one
remaining implication (i) ⇒ (iii) (specification pp. 52–54). -/
theorem tfae_of_isAvoidanceLocal_imp_isGermConditionalLaw {A : Ω₀ → Set ℂ}
    {h : Ω₀ → DistOn upperHalfPlaneOpens} (hhm : Measurable h) (hAm : Measurable[_, hittingSigma] A)
    (hAc : ∀ᵐ ω ∂P₀, A ω ⊆ H ∧ IsOpen (H \ A ω))
    (h13 : IsAvoidanceLocal A h P₀ → IsGermConditionalLaw A h P₀) :
    [IsAvoidanceLocal A h P₀, IsMarkedAvoidanceLocal A h P₀, IsGermConditionalLaw A h P₀,
      IsLocalSet A h P₀].TFAE := by
  tfae_have 1 → 3 := h13
  tfae_have 3 → 4 := IsGermConditionalLaw.isLocalSet hAm hhm hAc
  tfae_have 4 → 2 := IsLocalSet.isMarkedAvoidanceLocal hhm hAm
  tfae_have 2 → 1 := IsMarkedAvoidanceLocal.isAvoidanceLocal hAm hhm
  tfae_finish

end Conditional

