import InteractingSLE.GFF.LocalSets.MarkedAvoidance
import InteractingSLE.GFF.LocalSets.MarkovNesting

/-!
# Avoidance events are independent of the projection onto `H(W)` (Lemma 3.6 (i))

Specification §3.2, proof of Lemma 3.6, (i) ⇒ (iii), p. 53 ("finite conditioning argument"): if
`A` satisfies (i), then for every open `W ⊆ ℍ` the projection `X = G_W h` of `h` onto `H(W)` is
independent of the complementary projection `Y = h − G_W h` together with all avoidance events
`{A ∩ V = ∅}` of open `V ⊇ W` (`indep_markov_avoidSigma`). For one such event:
`E[1_{A∩V=∅} e^{iX(Φ)} e^{iY(Ψ)}] = E[e^{iX(Φ)} e^{iY(Ψ)} P(A ∩ V = ∅ | h)]`, the conditional
probability is a function of the projection onto `H^⊥(V)` by (i), hence of `Y` (nesting,
`exists_measurable_markovCompl_comp`), and `X ⟂ Y` (Proposition 3.1). The events form a π-system
and the identity passes to the generated σ-algebra (`avoidSigma`). On `{A ∩ V₀ = ∅}`, `V₀ ⊇ W`,
every event of `σ(A)` belongs to `avoidSigma A W` (`measurableSet_avoidSigma_inter`): this replaces
the source's inclusion–exclusion over finite patterns of covers.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped RealInnerProductSpace ENNReal

namespace InteractingSLE
namespace LocalSets

open QuantumZipper QuantumZipper.K3 QuantumZipper.Thm11Asm LQGMetric LQGMetric.MarkovZB

section AvoidSigma

variable {Ω : Type*}

/-- The avoidance events `{A ∩ V = ∅}` of the open sets `W ⊆ V ⊆ ℍ`. -/
def avoidSets (A : Ω → Set ℂ) (W : Set ℂ) : Set (Set Ω) :=
  {E | ∃ V : Set ℂ, IsOpen V ∧ W ⊆ V ∧ V ⊆ H ∧ E = {ω | Disjoint (A ω) V}}

/-- The σ-algebra generated by the avoidance events of the open sets containing `W`. -/
@[instance_reducible]
def avoidSigma (A : Ω → Set ℂ) (W : Set ℂ) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom (avoidSets A W)

theorem isPiSystem_avoidSets (A : Ω → Set ℂ) (W : Set ℂ) : IsPiSystem (avoidSets A W) := by
  rintro _ ⟨V, hV, hWV, hVH, rfl⟩ _ ⟨V', hV', hWV', hVH', rfl⟩ -
  refine ⟨V ∪ V', hV.union hV', hWV.trans subset_union_left, union_subset hVH hVH', ?_⟩
  ext ω
  simp [disjoint_union_right]

theorem measurableSet_avoidSigma {A : Ω → Set ℂ} {W V : Set ℂ} (hV : IsOpen V) (hWV : W ⊆ V)
    (hVH : V ⊆ H) : MeasurableSet[avoidSigma A W] {ω | Disjoint (A ω) V} :=
  MeasurableSpace.measurableSet_generateFrom ⟨V, hV, hWV, hVH, rfl⟩

theorem avoidSigma_le [mΩ : MeasurableSpace Ω] {A : Ω → Set ℂ}
    (hA : Measurable[mΩ, hittingSigma] A) (W : Set ℂ) : avoidSigma A W ≤ mΩ := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨V, hV, -, hVH, rfl⟩
  exact hA (measurableSet_avoid hV hVH)

/-- **Trace of `σ(A)` on an avoidance event.** On `{A ∩ V₀ = ∅}` with `W ⊆ V₀`, every event of
`σ(A)` is an event of the avoidance σ-algebra of `W`. -/
theorem measurableSet_avoidSigma_inter {A : Ω → Set ℂ} {W V₀ : Set ℂ} (hV₀ : IsOpen V₀)
    (hWV₀ : W ⊆ V₀) (hV₀H : V₀ ⊆ H) {B : Set (Set ℂ)} (hB : MeasurableSet[hittingSigma] B) :
    MeasurableSet[avoidSigma A W] (A ⁻¹' B ∩ {ω | Disjoint (A ω) V₀}) := by
  induction B, hB using MeasurableSpace.generateFrom_induction with
  | hC B hB =>
    obtain ⟨U, hU, hUH, rfl⟩ := hB
    have e : A ⁻¹' {S | (S ∩ U).Nonempty} ∩ {ω | Disjoint (A ω) V₀} =
        {ω | Disjoint (A ω) V₀} \ {ω | Disjoint (A ω) (V₀ ∪ U)} := by
      ext ω
      simp only [mem_inter_iff, mem_preimage, mem_ofPred_eq, Set.mem_sdiff, disjoint_union_right,
        not_and, ← not_disjoint_iff_nonempty_inter]
      tauto
    rw [e]
    exact (measurableSet_avoidSigma hV₀ hWV₀ hV₀H).diff
      (measurableSet_avoidSigma (hV₀.union hU) (hWV₀.trans subset_union_left)
        (union_subset hV₀H hUH))
  | empty => simp
  | compl B _ hB' =>
    have e : A ⁻¹' Bᶜ ∩ {ω | Disjoint (A ω) V₀} =
        {ω | Disjoint (A ω) V₀} \ (A ⁻¹' B ∩ {ω | Disjoint (A ω) V₀}) := by
      ext ω; simp only [mem_inter_iff, mem_preimage, mem_compl_iff, Set.mem_sdiff]; tauto
    rw [e]
    exact (measurableSet_avoidSigma hV₀ hWV₀ hV₀H).diff hB'
  | iUnion f _ hf =>
    rw [preimage_iUnion, iUnion_inter]
    exact MeasurableSet.iUnion hf

end AvoidSigma
section Key

variable {Ω : Type*} {m : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P]

/-- `∫_E W = ∫ P[E | m] W` for a bounded `m`-measurable complex `W`. -/
theorem setIntegral_eq_integral_condExp_mul (hm : m ≤ mΩ) {E : Set Ω}
    (hE : MeasurableSet E) {W : Ω → ℂ} (hW : StronglyMeasurable[m] W) {C : ℝ}
    (hWb : ∀ ω, ‖W ω‖ ≤ C) :
    ∫ ω in E, W ω ∂P = ∫ ω, (((P⟦E|m⟧) ω : ℝ) : ℂ) * W ω ∂P := by
  set B : ℂ →L[ℝ] ℝ →L[ℝ] ℂ := (ContinuousLinearMap.lsmul ℝ ℝ).flip
  have hB : ∀ (w : ℂ) (r : ℝ), B w r = (r : ℂ) * w := fun w r => by
    simp [B, Complex.real_smul]
  have hind : Integrable (E.indicator fun _ => (1 : ℝ)) P :=
    (integrable_const (1 : ℝ)).indicator hE
  have hint : Integrable (fun ω => B (W ω) (E.indicator (fun _ => (1 : ℝ)) ω)) P := by
    simp only [hB]
    refine (hind.ofReal (𝕜 := ℂ)).bdd_mul (c := C) (hW.mono hm).aestronglyMeasurable ?_ |>.congr
      (Eventually.of_forall fun ω => mul_comm _ _)
    exact Eventually.of_forall hWb
  have hpull := condExp_bilin_of_stronglyMeasurable_left B hW hint hind
  have e1 : ∫ ω in E, W ω ∂P = ∫ ω, B (W ω) (E.indicator (fun _ => (1 : ℝ)) ω) ∂P := by
    rw [← integral_indicator hE]
    refine integral_congr_ae (Eventually.of_forall fun ω => ?_)
    by_cases hω : ω ∈ E <;> simp [hB, hω]
  rw [e1, ← integral_condExp hm (f := fun ω => B (W ω) (E.indicator (fun _ => (1 : ℝ)) ω))]
  refine integral_congr_ae ?_
  filter_upwards [hpull] with ω hω
  rw [hω, hB]

end Key
section KeyIndep

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- **The basic identity behind (i) ⇒ (iii).** If `A` satisfies Lemma 3.6 (i), `W ⊆ V ⊆ ℍ` are
open and `h = X + Y` is the Markov decomposition on `W`, then
`E[1_{A ∩ V = ∅} e^{iX(Φ)} e^{iY(Ψ)}] = E[e^{iX(Φ)}] E[1_{A ∩ V = ∅} e^{iY(Ψ)}]`: the conditional
probability of the avoidance event given `h` is a function of the projection onto `H^⊥(V)`, hence
(nesting) of `Y`, which is independent of `X`. -/
theorem setIntegral_exp_markov_avoid {A : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) (hA : Measurable[mΩ, hittingSigma] A)
    (hloc : IsAvoidanceLocal A h P) {W : Opens ℂ}
    {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P)
    {V : Set ℂ} (hV : IsOpen V) (hWV : (W : Set ℂ) ⊆ V) (hVH : V ⊆ H)
    (Φ Ψ : TestOn upperHalfPlaneOpens) :
    ∫ ω in {ω | Disjoint (A ω) V}, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      (∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P) *
        ∫ ω in {ω | Disjoint (A ω) V}, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
  have hhm := hh.measurable
  set V' : Opens ℂ := ⟨V, hV⟩
  have hV'H : (V' : Set ℂ) ⊆ H := hVH
  have hWV' : W ≤ V' := hWV
  have hV'le : V' ≤ upperHalfPlaneOpens := hVH
  obtain ⟨GV, hGV, hGVd⟩ := exists_markovMap V' hV'H
  have hdV := hGVd hh
  obtain ⟨g, hg, hge⟩ := hloc V' GV hV'H hGV hdV
  obtain ⟨Ψ', hΨ', hΨe⟩ := exists_measurable_markovCompl_comp hWV' hV'le hhm hd hdV
  set E : Set Ω := {ω | Disjoint (A ω) V}
  have hE : MeasurableSet E := hA (measurableSet_avoid hV hVH)
  have hm : MeasurableSpace.comap h inferInstance ≤ mΩ := hhm.comap_le
  have hge' : (P⟦E|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
      fun ω => g (markovCompl GV (h ω)) := hge
  have hce : (P⟦E|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
      fun ω => g (Ψ' (markovCompl G (h ω))) := by
    filter_upwards [hge', hΨe] with ω h1 h2
    rw [h1, h2]
  set k : DistOn upperHalfPlaneOpens → ℂ := fun T => ((g (Ψ' T) : ℝ) : ℂ)
  have hk : Measurable k := Complex.measurable_ofReal.comp (hg.comp hΨ')
  have hXm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => G (h ω) := hG.comp (comap_measurable h)
  have hYm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => markovCompl G (h ω) :=
    (measurable_markovCompl hG).comp (comap_measurable h)
  have hexp : ∀ (Z : Ω → DistOn upperHalfPlaneOpens) (χ : TestOn upperHalfPlaneOpens),
      Measurable[MeasurableSpace.comap h inferInstance] Z →
        StronglyMeasurable[MeasurableSpace.comap h inferInstance] fun ω => Complex.exp (Complex.I * (Z ω χ : ℂ)) :=
    fun Z χ hZ => (@GFF.measurable_exp_I_mul Ω (MeasurableSpace.comap h inferInstance) _
      ((measurable_distOn_apply χ).comp hZ)).stronglyMeasurable
  have hnorm : ∀ x : ℝ, ‖Complex.exp (Complex.I * (x : ℂ))‖ ≤ 1 := fun x =>
    (Complex.norm_exp_I_mul_ofReal x).le
  -- both sides through the conditional probability
  have hL := setIntegral_eq_integral_condExp_mul (P := P) hm hE
    (W := fun ω => Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)))
    ((hexp _ Φ hXm).mul (hexp _ Ψ hYm)) (C := 1) fun ω => by
      rw [norm_mul]
      exact (mul_le_mul (hnorm _) (hnorm _) (norm_nonneg _) zero_le_one).trans (by norm_num)
  have hR := setIntegral_eq_integral_condExp_mul (P := P) hm hE (hexp _ Ψ hYm) (C := 1)
    fun ω => hnorm _
  rw [hL, hR]
  have e1 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) * (Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P =
      ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        (k (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k, hω]; ring
  have e2 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      ∫ ω, k (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k, hω]
  rw [e1, e2]
  have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
      Complex.exp (Complex.I * (T Φ : ℂ)))
    (g := fun T : DistOn upperHalfPlaneOpens => k T * Complex.exp (Complex.I * (T Ψ : ℂ)))
    (hG.comp hhm).aemeasurable ((measurable_markovCompl hG).comp hhm).aemeasurable
    (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
    (hk.mul (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ))).aestronglyMeasurable
  simpa [markovCompl] using this

/-- **Independence of the projection onto `H(W)` from the complementary projection and the
avoidance events of the open sets containing `W`**, for a set `A` satisfying Lemma 3.6 (i). -/
theorem indep_markov_avoidSigma {A : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) (hA : Measurable[mΩ, hittingSigma] A)
    (hloc : IsAvoidanceLocal A h P) {W : Opens ℂ}
    {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    Indep (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance)
      (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance ⊔ avoidSigma A W) P := by
  have hhm := hh.measurable
  have hXm : Measurable fun ω => G (h ω) := hG.comp hhm
  have hYm : Measurable fun ω => markovCompl G (h ω) := (measurable_markovCompl hG).comp hhm
  have hle := avoidSigma_le hA (W : Set ℂ)
  refine indep_comap_sup_of_setIntegral_exp hXm hYm hle fun Φ Ψ m hm => ?_
  have hXΦ : Measurable fun ω => G (h ω) Φ := (measurable_distOn_apply Φ).comp hXm
  have hYΨ : Measurable fun ω => markovCompl G (h ω) Ψ := (measurable_distOn_apply Ψ).comp hYm
  have hF := integrable_exp_mul_exp (P := P) hXΦ hYΨ
  have hg := GFF.integrable_exp_I_mul (P := P) hYΨ
  set c := ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P
  have huniv : ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
        Complex.exp (Complex.I * (T Φ : ℂ)))
      (g := fun T : DistOn upperHalfPlaneOpens => Complex.exp (Complex.I * (T Ψ : ℂ)))
      hXm.aemeasurable hYm.aemeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ)).aestronglyMeasurable
    simpa [markovCompl] using this
  refine MeasurableSpace.induction_on_inter (m := avoidSigma A W)
    (C := fun s _ => ∫ ω in s, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω in s, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P)
    rfl (isPiSystem_avoidSets A W) (by simp) ?_ ?_ ?_ m hm
  · rintro _ ⟨V, hV, hWV, hVH, rfl⟩
    exact setIntegral_exp_markov_avoid hh hA hloc hG hd hV hWV hVH Φ Ψ
  · intro t ht hC
    rw [setIntegral_compl (hle t ht) hF, setIntegral_compl (hle t ht) hg, huniv, hC, mul_sub]
  · intro f hdisj hfm hC
    have hfm' : ∀ i, MeasurableSet (f i) := fun i => hle _ (hfm i)
    have h1 := hasSum_integral_iUnion hfm' hdisj hF.integrableOn
    have h2 := (hasSum_integral_iUnion hfm' hdisj hg.integrableOn).mul_left c
    simp_rw [hC] at h1
    exact h1.unique h2

end KeyIndep

end LocalSets
