import InteractingSLE.GFF.LocalSets.GermVersion

/-!
# Proposition 3.7: the conditionally independent union of local sets

Specification §3.2, Proposition 3.7 (p. 57; transcription `source/spec/p049-096.md#prop-3.7`), the
restatement of [SS13, Lemma 3.10]. Let `A₁`, `A₂` be local sets of a zero-boundary GFF `h` on `ℍ`,
conditionally independent given `h`, and `A = A₁ ∪ A₂`.

* `IsLocalSet.isLocalSet_union` : `A` is a local set (Lemma 3.6, (i) ⇒ (iv), applied to the
  avoidance criterion for the union proved by PROVE-LS-B, `IsLocalSet.isAvoidanceLocal_union`);
* `IsLocalSet.exists_condLaw_union` : **the marked-union law** — given `𝒜 ∨ σ(A₁, A₂)`, the
  conditional law of `h` is `h₁ + h₂` with `h₁` the `𝒜`-measurable mean (harmonic on `ℍ ∖ A`) and
  `h₂` a zero-boundary GFF on `ℍ ∖ A`.

Proof of the marked-union law: the cover argument of Lemma 3.6 (`CoverLaw`, `GermLaw`) is run with
the set information `ℳ = σ(A₁, A₂)` instead of `σ(A)` (`IsCoverMarking`). Its two inputs are
* the trace of `σ(A₁, A₂)` on a joint avoidance event (`measurableSet_avoidSigma₂_inter_sup`): on
  each atom of the covers of `A` both sets avoid `W_T`, so the pair is recorded by the joint
  avoidance events `{A₁ ∩ V₁ = ∅} ∩ {A₂ ∩ V₂ = ∅}`, `V_i ⊇ W_T` ("On `{C_n = C}` both sets avoid `U`,
  so `R₁, R₂` record the full pair", p. 58);
* the independence of the projection onto `H(W)` from `σ(h − G_W h)` and these events
  (`indep_markov_avoidSigma₂`): by conditional independence,
  `P(A₁ ∩ V₁ = ∅, A₂ ∩ V₂ = ∅ | h) = P(A₁ ∩ V₁ = ∅ | h) P(A₂ ∩ V₂ = ∅ | h)`, a function of
  `h − G_W h` by (i) for each `Aᵢ` and nesting ("the conditional law of `(R₁, R₂)` given `h` is the
  product of those two kernels. It also depends only on `Y`", p. 57).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

universe u

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace Metric
open scoped RealInnerProductSpace ENNReal

namespace InteractingSLE
namespace LocalSets

open QuantumZipper QuantumZipper.K3 QuantumZipper.Thm11Asm LQGMetric LQGMetric.MarkovZB

section Avoid2

variable {Ω : Type*}

/-- The joint avoidance events `{A₁ ∩ V₁ = ∅} ∩ {A₂ ∩ V₂ = ∅}` of open `W ⊆ Vᵢ ⊆ ℍ`. -/
def avoidSets₂ (A₁ A₂ : Ω → Set ℂ) (W : Set ℂ) : Set (Set Ω) :=
  {E | ∃ V₁ V₂ : Set ℂ, IsOpen V₁ ∧ IsOpen V₂ ∧ W ⊆ V₁ ∧ W ⊆ V₂ ∧ V₁ ⊆ H ∧ V₂ ⊆ H ∧
    E = {ω | Disjoint (A₁ ω) V₁} ∩ {ω | Disjoint (A₂ ω) V₂}}

/-- The σ-algebra generated by the joint avoidance events. -/
@[instance_reducible]
def avoidSigma₂ (A₁ A₂ : Ω → Set ℂ) (W : Set ℂ) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom (avoidSets₂ A₁ A₂ W)

theorem isPiSystem_avoidSets₂ (A₁ A₂ : Ω → Set ℂ) (W : Set ℂ) :
    IsPiSystem (avoidSets₂ A₁ A₂ W) := by
  rintro _ ⟨V₁, V₂, hV₁, hV₂, hW₁, hW₂, hH₁, hH₂, rfl⟩ _
    ⟨V₁', V₂', hV₁', hV₂', hW₁', hW₂', hH₁', hH₂', rfl⟩ -
  refine ⟨V₁ ∪ V₁', V₂ ∪ V₂', hV₁.union hV₁', hV₂.union hV₂', hW₁.trans subset_union_left,
    hW₂.trans subset_union_left, union_subset hH₁ hH₁', union_subset hH₂ hH₂', ?_⟩
  ext ω
  simp only [mem_inter_iff, mem_ofPred_eq, disjoint_union_right]
  tauto

theorem measurableSet_avoidSigma₂ {A₁ A₂ : Ω → Set ℂ} {W V₁ V₂ : Set ℂ} (hV₁ : IsOpen V₁)
    (hV₂ : IsOpen V₂) (hW₁ : W ⊆ V₁) (hW₂ : W ⊆ V₂) (hH₁ : V₁ ⊆ H) (hH₂ : V₂ ⊆ H) :
    MeasurableSet[avoidSigma₂ A₁ A₂ W] ({ω | Disjoint (A₁ ω) V₁} ∩ {ω | Disjoint (A₂ ω) V₂}) :=
  MeasurableSpace.measurableSet_generateFrom ⟨V₁, V₂, hV₁, hV₂, hW₁, hW₂, hH₁, hH₂, rfl⟩

theorem avoidSigma₂_le [mΩ : MeasurableSpace Ω] {A₁ A₂ : Ω → Set ℂ}
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂) (W : Set ℂ) :
    avoidSigma₂ A₁ A₂ W ≤ mΩ := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨V₁, V₂, hV₁, hV₂, -, -, hH₁, hH₂, rfl⟩
  exact (hA₁ (measurableSet_avoid hV₁ hH₁)).inter (hA₂ (measurableSet_avoid hV₂ hH₂))

lemma avoidSigma₂_comm (A₁ A₂ : Ω → Set ℂ) (W : Set ℂ) :
    avoidSigma₂ A₁ A₂ W = avoidSigma₂ A₂ A₁ W := by
  have : ∀ B₁ B₂ : Ω → Set ℂ, avoidSets₂ B₁ B₂ W ⊆ avoidSets₂ B₂ B₁ W := by
    rintro B₁ B₂ _ ⟨V₁, V₂, hV₁, hV₂, hW₁, hW₂, hH₁, hH₂, rfl⟩
    exact ⟨V₂, V₁, hV₂, hV₁, hW₂, hW₁, hH₂, hH₁, inter_comm _ _⟩
  exact le_antisymm (MeasurableSpace.generateFrom_mono (this A₁ A₂))
    (MeasurableSpace.generateFrom_mono (this A₂ A₁))

/-- **Trace of `σ(A₁)`** on a joint avoidance event `{A₁ ∩ V₀ = ∅} ∩ {A₂ ∩ V₀ = ∅}`, `W ⊆ V₀`. -/
theorem measurableSet_avoidSigma₂_inter {A₁ A₂ : Ω → Set ℂ} {W V₀ : Set ℂ} (hV₀ : IsOpen V₀)
    (hWV₀ : W ⊆ V₀) (hV₀H : V₀ ⊆ H) {B : Set (Set ℂ)} (hB : MeasurableSet[hittingSigma] B) :
    MeasurableSet[avoidSigma₂ A₁ A₂ W]
      (A₁ ⁻¹' B ∩ ({ω | Disjoint (A₁ ω) V₀} ∩ {ω | Disjoint (A₂ ω) V₀})) := by
  set E₀ := {ω | Disjoint (A₁ ω) V₀} ∩ {ω | Disjoint (A₂ ω) V₀}
  have hE₀ : MeasurableSet[avoidSigma₂ A₁ A₂ W] E₀ :=
    measurableSet_avoidSigma₂ hV₀ hV₀ hWV₀ hWV₀ hV₀H hV₀H
  induction B, hB using MeasurableSpace.generateFrom_induction with
  | hC B hB =>
    obtain ⟨U, hU, hUH, rfl⟩ := hB
    have e : A₁ ⁻¹' {S | (S ∩ U).Nonempty} ∩ E₀ =
        E₀ \ ({ω | Disjoint (A₁ ω) (V₀ ∪ U)} ∩ {ω | Disjoint (A₂ ω) V₀}) := by
      ext ω
      simp only [E₀, mem_inter_iff, mem_preimage, mem_ofPred_eq, Set.mem_sdiff,
        disjoint_union_right, ← not_disjoint_iff_nonempty_inter]
      tauto
    rw [e]
    exact hE₀.diff (measurableSet_avoidSigma₂ (hV₀.union hU) hV₀ (hWV₀.trans subset_union_left)
      hWV₀ (union_subset hV₀H hUH) hV₀H)
  | empty => simp
  | compl B _ hB' =>
    have e : A₁ ⁻¹' Bᶜ ∩ E₀ = E₀ \ (A₁ ⁻¹' B ∩ E₀) := by
      ext ω; simp only [mem_inter_iff, mem_preimage, mem_compl_iff, Set.mem_sdiff]; tauto
    rw [e]
    exact hE₀.diff hB'
  | iUnion f _ hf =>
    rw [preimage_iUnion, iUnion_inter]
    exact MeasurableSet.iUnion hf

/-- **Trace of `σ(A₁, A₂)`** on a joint avoidance event. -/
theorem measurableSet_avoidSigma₂_inter_sup {A₁ A₂ : Ω → Set ℂ}
    {W V₀ : Set ℂ} (hV₀ : IsOpen V₀) (hWV₀ : W ⊆ V₀) (hV₀H : V₀ ⊆ H) {B : Set Ω}
    (hB : MeasurableSet[MeasurableSpace.comap A₁ hittingSigma ⊔
      MeasurableSpace.comap A₂ hittingSigma] B) :
    MeasurableSet[avoidSigma₂ A₁ A₂ W] (B ∩ ({ω | Disjoint (A₁ ω) V₀} ∩ {ω | Disjoint (A₂ ω) V₀})) := by
  have hE₀ : MeasurableSet[avoidSigma₂ A₁ A₂ W]
      ({ω | Disjoint (A₁ ω) V₀} ∩ {ω | Disjoint (A₂ ω) V₀}) :=
    measurableSet_avoidSigma₂ hV₀ hV₀ hWV₀ hWV₀ hV₀H hV₀H
  refine (sup_le ?_ ?_ : _ ≤ traceSigma (avoidSigma₂ A₁ A₂ W) _ hE₀) B hB
  · rintro _ ⟨B₁, hB₁, rfl⟩
    exact measurableSet_avoidSigma₂_inter hV₀ hWV₀ hV₀H hB₁
  · rintro _ ⟨B₂, hB₂, rfl⟩
    show MeasurableSet[avoidSigma₂ A₁ A₂ W] (A₂ ⁻¹' B₂ ∩ _)
    rw [avoidSigma₂_comm, inter_comm {ω | Disjoint (A₁ ω) V₀}]
    exact measurableSet_avoidSigma₂_inter hV₀ hWV₀ hV₀H hB₂

end Avoid2

section Indep2

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- If the conditional probability of `E` given `h` is a function of `Y = h − G h`, then
`E[1_E e^{iX(Φ)} e^{iY(Ψ)}] = E[e^{iX(Φ)}] E[1_E e^{iY(Ψ)}]`. -/
theorem setIntegral_exp_markov_of_condExp {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    {W : Opens ℂ} {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P) {E : Set Ω}
    (hE : MeasurableSet E) {k : DistOn upperHalfPlaneOpens → ℝ} (hk : Measurable k)
    (hce : (P⟦E|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P] fun ω => k (markovCompl G (h ω)))
    (Φ Ψ : TestOn upperHalfPlaneOpens) :
    ∫ ω in E, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      (∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P) *
        ∫ ω in E, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
  have hm : MeasurableSpace.comap h inferInstance ≤ mΩ := hhm.comap_le
  set k' : DistOn upperHalfPlaneOpens → ℂ := fun T => ((k T : ℝ) : ℂ)
  have hk' : Measurable k' := Complex.measurable_ofReal.comp hk
  have hXm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => G (h ω) :=
    hG.comp (comap_measurable h)
  have hYm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => markovCompl G (h ω) :=
    (measurable_markovCompl hG).comp (comap_measurable h)
  have hexp : ∀ (Z : Ω → DistOn upperHalfPlaneOpens) (χ : TestOn upperHalfPlaneOpens),
      Measurable[MeasurableSpace.comap h inferInstance] Z →
        StronglyMeasurable[MeasurableSpace.comap h inferInstance] fun ω =>
          Complex.exp (Complex.I * (Z ω χ : ℂ)) :=
    fun Z χ hZ => (@GFF.measurable_exp_I_mul Ω (MeasurableSpace.comap h inferInstance) _
      ((measurable_distOn_apply χ).comp hZ)).stronglyMeasurable
  have hnorm : ∀ x : ℝ, ‖Complex.exp (Complex.I * (x : ℂ))‖ ≤ 1 := fun x =>
    (Complex.norm_exp_I_mul_ofReal x).le
  have hL := setIntegral_eq_integral_condExp_mul (P := P) hm hE
    (W := fun ω => Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)))
    ((hexp _ Φ hXm).mul (hexp _ Ψ hYm)) (C := 1) fun ω => by
      rw [norm_mul]
      exact (mul_le_mul (hnorm _) (hnorm _) (norm_nonneg _) zero_le_one).trans (by norm_num)
  have hR := setIntegral_eq_integral_condExp_mul (P := P) hm hE (hexp _ Ψ hYm) (C := 1)
    fun ω => hnorm _
  rw [hL, hR]
  have e1 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) *
      (Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P =
      ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        (k' (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k', hω]; ring
  have e2 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      ∫ ω, k' (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k', hω]
  rw [e1, e2]
  have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
      Complex.exp (Complex.I * (T Φ : ℂ)))
    (g := fun T : DistOn upperHalfPlaneOpens => k' T * Complex.exp (Complex.I * (T Ψ : ℂ)))
    (hG.comp hhm).aemeasurable ((measurable_markovCompl hG).comp hhm).aemeasurable
    (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
    (hk'.mul (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ))).aestronglyMeasurable
  simpa [markovCompl] using this

/-- For a set satisfying Lemma 3.6 (i) and open `W ⊆ V ⊆ ℍ`, the conditional probability of
`{A ∩ V = ∅}` given `h` is a function of `h − G_W h`. -/
theorem exists_condExp_avoid_eq_comp {A : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) (hloc : IsAvoidanceLocal A h P)
    {W : Opens ℂ} {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens}
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P)
    {V : Set ℂ} (hV : IsOpen V) (hWV : (W : Set ℂ) ⊆ V) (hVH : V ⊆ H) :
    ∃ k : DistOn upperHalfPlaneOpens → ℝ, Measurable k ∧
      (P⟦{ω | Disjoint (A ω) V}|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
        fun ω => k (markovCompl G (h ω)) := by
  set V' : Opens ℂ := ⟨V, hV⟩
  obtain ⟨GV, hGV, hGVd⟩ := exists_markovMap V' hVH
  have hdV := hGVd hh
  obtain ⟨g, hg, hge⟩ := hloc V' GV hVH hGV hdV
  obtain ⟨Ψ', hΨ', hΨe⟩ := exists_measurable_markovCompl_comp (show W ≤ V' from hWV)
    (show V' ≤ upperHalfPlaneOpens from hVH) hh.measurable hd hdV
  refine ⟨fun T => g (Ψ' T), hg.comp hΨ', ?_⟩
  have hge' : (P⟦{ω | Disjoint (A ω) V}|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
      fun ω => g (markovCompl GV (h ω)) := hge
  filter_upwards [hge', hΨe] with ω h1 h2
  rw [h1, h2]

/-- **Independence for the conditionally independent pair**: if `A₁`, `A₂` satisfy Lemma 3.6 (i)
and are conditionally independent given `h`, the projection onto `H(W)` is independent of
`σ(h − G_W h) ∨ avoidSigma₂ A₁ A₂ W`. -/
theorem indep_markov_avoidSigma₂ {A₁ A₂ : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) (hA₁ : Measurable[mΩ, hittingSigma] A₁)
    (hA₂ : Measurable[mΩ, hittingSigma] A₂) (hl₁ : IsAvoidanceLocal A₁ h P)
    (hl₂ : IsAvoidanceLocal A₂ h P)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    {W : Opens ℂ} {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    Indep (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance)
      (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance ⊔
        avoidSigma₂ A₁ A₂ W) P := by
  have hhm := hh.measurable
  have hXm : Measurable fun ω => G (h ω) := hG.comp hhm
  have hYm : Measurable fun ω => markovCompl G (h ω) := (measurable_markovCompl hG).comp hhm
  have hle := avoidSigma₂_le hA₁ hA₂ (W : Set ℂ)
  refine indep_comap_sup_of_setIntegral_exp hXm hYm hle fun Φ Ψ m hm => ?_
  have hXΦ : Measurable fun ω => G (h ω) Φ := (measurable_distOn_apply Φ).comp hXm
  have hYΨ : Measurable fun ω => markovCompl G (h ω) Ψ := (measurable_distOn_apply Ψ).comp hYm
  have hF := integrable_exp_mul_exp (P := P) hXΦ hYΨ
  have hg := GFF.integrable_exp_I_mul (P := P) hYΨ
  set c := ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P
  have huniv : ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
        Complex.exp (Complex.I * (T Φ : ℂ)))
      (g := fun T : DistOn upperHalfPlaneOpens => Complex.exp (Complex.I * (T Ψ : ℂ)))
      hXm.aemeasurable hYm.aemeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ)).aestronglyMeasurable
    simpa [markovCompl] using this
  refine MeasurableSpace.induction_on_inter (m := avoidSigma₂ A₁ A₂ W)
    (C := fun s _ => ∫ ω in s, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω in s, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P)
    rfl (isPiSystem_avoidSets₂ A₁ A₂ W) (by simp) ?_ ?_ ?_ m hm
  · rintro _ ⟨V₁, V₂, hV₁, hV₂, hW₁, hW₂, hH₁, hH₂, rfl⟩
    obtain ⟨k₁, hk₁, hce₁⟩ := exists_condExp_avoid_eq_comp hh hl₁ hd hV₁ hW₁ hH₁
    obtain ⟨k₂, hk₂, hce₂⟩ := exists_condExp_avoid_eq_comp hh hl₂ hd hV₂ hW₂ hH₂
    have hpair : (P⟦{ω | Disjoint (A₁ ω) V₁} ∩ {ω | Disjoint (A₂ ω) V₂}|
        MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
        (P⟦{ω | Disjoint (A₁ ω) V₁}|MeasurableSpace.comap h inferInstance⟧) *
          (P⟦{ω | Disjoint (A₂ ω) V₂}|MeasurableSpace.comap h inferInstance⟧) :=
      hci {ω | Disjoint (A₁ ω) V₁} {ω | Disjoint (A₂ ω) V₂}
        ⟨_, measurableSet_avoid hV₁ hH₁, rfl⟩ ⟨_, measurableSet_avoid hV₂ hH₂, rfl⟩
    refine setIntegral_exp_markov_of_condExp hhm hG hd
      ((hA₁ (measurableSet_avoid hV₁ hH₁)).inter (hA₂ (measurableSet_avoid hV₂ hH₂)))
      (hk₁.mul hk₂) ?_ Φ Ψ
    filter_upwards [hpair, hce₁, hce₂] with ω h1 h2 h3
    refine h1.trans ?_
    rw [Pi.mul_apply, h2, h3, Pi.mul_apply]
  · intro t ht hC
    rw [setIntegral_compl (hle t ht) hF, setIntegral_compl (hle t ht) hg, huniv, hC, mul_sub]
  · intro f hdisj hfm hC
    have hfm' : ∀ i, MeasurableSet (f i) := fun i => hle _ (hfm i)
    have h1 := hasSum_integral_iUnion hfm' hdisj hF.integrableOn
    have h2 := (hasSum_integral_iUnion hfm' hdisj hg.integrableOn).mul_left c
    simp_rw [hC] at h1
    exact h1.unique h2

end Indep2
section Union

variable {Ω : Type u} {𝒦 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {A₁ A₂ : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}

omit [IsProbabilityMeasure P] in
lemma IsLocalSet.ae_relClosed_union (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    ∀ᵐ ω ∂P, A₁ ω ∪ A₂ ω ⊆ H ∧ IsOpen (H \ (A₁ ω ∪ A₂ ω)) := by
  filter_upwards [h₁.2.1, h₂.2.1] with ω ⟨hs₁, ho₁⟩ ⟨hs₂, ho₂⟩
  refine ⟨union_subset hs₁ hs₂, ?_⟩
  have e : H \ (A₁ ω ∪ A₂ ω) = (H \ A₁ ω) ∩ (H \ A₂ ω) := by
    ext z; simp only [Set.mem_sdiff, mem_union, mem_inter_iff]; tauto
  rw [e]
  exact ho₁.inter ho₂

/-- **Proposition 3.7 (locality).** The conditionally independent union of two local sets of a
zero-boundary GFF on `ℍ` is a local set. -/
theorem IsLocalSet.isLocalSet_union (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    IsLocalSet (fun ω => A₁ ω ∪ A₂ ω) h P :=
  ((isLocalSet_tfae hh (measurable_union_hitting hA₁ hA₂)
    (IsLocalSet.ae_relClosed_union h₁ h₂)).out 1 4).1
    (IsLocalSet.isAvoidanceLocal_union hh.measurable hA₁ hA₂ hci h₁ h₂)

/-- The conditionally independent union of two local sets also has the germ conditional law of
Lemma 3.6 (iii). -/
theorem IsLocalSet.isGermConditionalLaw_union (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    IsGermConditionalLaw (fun ω => A₁ ω ∪ A₂ ω) h P :=
  (IsLocalSet.isAvoidanceLocal_union hh.measurable hA₁ hA₂ hci h₁ h₂).isGermConditionalLaw hh
    (measurable_union_hitting hA₁ hA₂) (IsLocalSet.ae_relClosed_union h₁ h₂)

/-- The marking data of the conditionally independent union: `ℳ = σ(A₁, A₂)`,
`𝒮 = avoidSigma₂ A₁ A₂`. -/
theorem isCoverMarking_union (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hl₁ : IsAvoidanceLocal A₁ h P) (hl₂ : IsAvoidanceLocal A₂ h P)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P) :
    IsCoverMarking (fun ω => A₁ ω ∪ A₂ ω) h P
      (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma)
      (avoidSigma₂ A₁ A₂) where
  le := sup_le hA₁.comap_le hA₂.comap_le
  le_avoid := avoidSigma₂_le hA₁ hA₂
  comap_le := (@measurable_union_hitting Ω (MeasurableSpace.comap A₁ hittingSigma ⊔
    MeasurableSpace.comap A₂ hittingSigma) A₁ A₂ ((comap_measurable A₁).mono le_sup_left le_rfl)
    ((comap_measurable A₂).mono le_sup_right le_rfl)).comap_le
  trace := by
    intro j T B hB
    by_cases hT : T ⊆ coverIdx j
    · have hatom : MeasurableSet[MeasurableSpace.comap A₁ hittingSigma ⊔
          MeasurableSpace.comap A₂ hittingSigma] (coverAtom j (fun ω => A₁ ω ∪ A₂ ω) T) :=
        (@measurable_union_hitting Ω (MeasurableSpace.comap A₁ hittingSigma ⊔
          MeasurableSpace.comap A₂ hittingSigma) A₁ A₂ ((comap_measurable A₁).mono le_sup_left
          le_rfl) ((comap_measurable A₂).mono le_sup_right le_rfl)) (measurableSet_removedIdx_eq j T)
      have hsub : coverAtom j (fun ω => A₁ ω ∪ A₂ ω) T ⊆
          {ω | Disjoint (A₁ ω) (coverThick j T)} ∩ {ω | Disjoint (A₂ ω) (coverThick j T)} := by
        intro ω hω
        have := coverAtom_subset_avoid j _ T hω
        simp only [mem_ofPred_eq, disjoint_union_left] at this
        exact this
      have e : B ∩ coverAtom j (fun ω => A₁ ω ∪ A₂ ω) T =
          (B ∩ coverAtom j (fun ω => A₁ ω ∪ A₂ ω) T) ∩
            ({ω | Disjoint (A₁ ω) (coverThick j T)} ∩ {ω | Disjoint (A₂ ω) (coverThick j T)}) :=
        (inter_eq_left.2 (inter_subset_right.trans hsub)).symm
      rw [e]
      exact measurableSet_avoidSigma₂_inter_sup (isOpen_coverThick j T)
        (inter_subset_left.trans (coverOpen_subset_coverThick j T)) (coverThick_subset_H hT)
        (hB.inter hatom)
    · rw [coverAtom_eq_empty hT, inter_empty]
      exact @MeasurableSet.empty _ (avoidSigma₂ A₁ A₂ (markovOpen T))
  indep T := indep_markov_avoidSigma₂ hh hA₁ hA₂ hl₁ hl₂ hci (measurable_coverMarkov.{u} T)
    (isMarkovDecomposition_coverMarkov hh T)

/-- **Proposition 3.7 (marked-union law).** Let `A = A₁ ∪̃ A₂` be the conditionally independent
union of two local sets of a zero-boundary GFF `h` on `ℍ`. Given the germ σ-algebra `𝒜` of `A` and
the pair `(A₁, A₂)`, the conditional law of `h` is that of `h₁ + h₂`, with `h₁` an `𝒜`-measurable
random distribution, harmonic on `ℍ ∖ A` (the local-set mean `𝒞_A`), and `h₂` a zero-boundary GFF
on `ℍ ∖ A`. -/
theorem IsLocalSet.exists_condLaw_union_of (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P)
    (h𝒦A : germSigma (fun ω => A₁ ω ∪ A₂ ω) h ≤ 𝒦) (h𝒦le : 𝒦 ≤ mΩ)
    (h𝒦tr : ∀ j, 𝒦 ≤ aeSigma (coverSigmaM (MeasurableSpace.comap A₁ hittingSigma ⊔
      MeasurableSpace.comap A₂ hittingSigma) j (fun ω => A₁ ω ∪ A₂ ω) h) P) :
    ∃ g : Ω → DistOn upperHalfPlaneOpens,
      Measurable[germSigma (fun ω => A₁ ω ∪ A₂ ω) h] g ∧
      (∀ᵐ ω ∂P, IsHarmonicDistOn (g ω) (H \ (A₁ ω ∪ A₂ ω))) ∧
      IsCondZeroBoundaryGFF P 𝒦 (fun ω => H \ (A₁ ω ∪ A₂ ω)) (fun ω => h ω - g ω) := by
  have hhm := hh.measurable
  set A : Ω → Set ℂ := fun ω => A₁ ω ∪ A₂ ω
  have hA : Measurable[mΩ, hittingSigma] A := measurable_union_hitting hA₁ hA₂
  have hl₁ := (IsLocalSet.isMarkedAvoidanceLocal hhm hA₁ h₁).isAvoidanceLocal hA₁ hhm
  have hl₂ := (IsLocalSet.isMarkedAvoidanceLocal hhm hA₂ h₂).isAvoidanceLocal hA₂ hhm
  have hloc := IsLocalSet.isAvoidanceLocal_union hhm hA₁ hA₂ hci h₁ h₂
  have hAc := IsLocalSet.ae_relClosed_union h₁ h₂
  have hmk := isCoverMarking_union hh hA₁ hA₂ hl₁ hl₂ hci
  obtain ⟨M, g, hM, hMlim, hgm, hge⟩ := exists_germVersion hh hA hloc hAc
  refine ⟨g, hgm, ae_isHarmonicDistOn_germVersion hh hA hloc hAc hM hMlim hge, fun φ => ?_⟩
  obtain ⟨M₂, hM₂m, -, hM₂c, hM₂e⟩ := exists_condExp_germSigmaK hh hA hmk hAc h𝒦A h𝒦le h𝒦tr φ
  have hgle := germSigma_le hA hhm
  have hhi : Integrable (fun ω => h ω φ) P :=
    (hh.process.gaussian.hasGaussianLaw_eval φ).memLp_two.integrable one_le_two
  -- the two conditional means agree
  have hM₂M : M₂ =ᵐ[P] M φ := by
    have hM₂i : Integrable M₂ P := integrable_condExp.congr hM₂c.symm
    have e1 : P[M₂ | germSigma A h] = M₂ :=
      condExp_of_stronglyMeasurable hgle hM₂m.stronglyMeasurable hM₂i
    have e2 : P[M₂ | germSigma A h] =ᵐ[P] P[fun ω => h ω φ | germSigma A h] :=
      (condExp_congr_ae hM₂c).trans (condExp_condExp_of_le h𝒦A h𝒦le)
    rw [e1] at e2
    exact e2.trans (hM φ).2.1.symm
  have hgφ : Measurable[𝒦] fun ω => g ω φ :=
    (measurable_distOn_apply φ).comp (hgm.mono h𝒦A le_rfl)
  set W : Ω → ℂ := fun ω => Complex.exp (Complex.I * ((-(g ω φ) : ℝ) : ℂ))
  have hWm : StronglyMeasurable[𝒦] W :=
    (@GFF.measurable_exp_I_mul Ω 𝒦 _ hgφ.neg).stronglyMeasurable
  have hWb : ∀ ω, ‖W ω‖ ≤ 1 := fun ω => (Complex.norm_exp_I_mul_ofReal _).le
  have hF : Integrable (fun ω => Complex.exp (Complex.I * (h ω φ : ℂ))) P :=
    GFF.integrable_exp_I_mul ((measurable_distOn_apply φ).comp hhm)
  have hWF : Integrable (fun ω => W ω * Complex.exp (Complex.I * (h ω φ : ℂ))) P :=
    hF.bdd_mul (hWm.mono h𝒦le).aestronglyMeasurable (Eventually.of_forall hWb)
  have hpull := condExp_bilin_of_stronglyMeasurable_left (ContinuousLinearMap.mul ℝ ℂ) hWm
    (by simpa [ContinuousLinearMap.mul_apply'] using hWF) hF
  have e : (fun ω => Complex.exp (Complex.I * (((h ω - g ω) φ : ℝ) : ℂ))) =
      fun ω => (ContinuousLinearMap.mul ℝ ℂ) (W ω) (Complex.exp (Complex.I * (h ω φ : ℂ))) := by
    funext ω
    simp only [W, ContinuousLinearMap.mul_apply', sub_apply, Complex.ofReal_sub,
      Complex.ofReal_neg, ← Complex.exp_add]
    congr 1; ring
  rw [e]
  filter_upwards [hpull, hM₂e, hge φ, hM₂M, hAc] with ω h1 h2 h3 h4 ⟨hsub, hopen⟩
  rw [h1, ContinuousLinearMap.mul_apply', ← h2]
  have hrc : relClosureH (A ω) = A₁ ω ∪ A₂ ω := relClosureH_eq hsub hopen
  simp only [W, h3, ← h4, hrc, Complex.ofReal_neg, ← mul_assoc, ← Complex.exp_add, mul_neg,
    neg_add_cancel, Complex.exp_zero, one_mul]


omit mΩ [IsProbabilityMeasure P] in
lemma germNbhd_mono_set {δ : ℝ} {S S' : Set ℂ} (hSS' : S ⊆ S') : germNbhd δ S ⊆ germNbhd δ S' := by
  rintro z ⟨hz, h1 | h1⟩
  · exact ⟨hz, Or.inl (thickening_subset_of_subset δ
      (union_subset_union_left _ (inter_subset_inter_left _ hSS')) h1)⟩
  · exact ⟨hz, Or.inr h1⟩

/-- The germ σ-algebra of a subset `A' ⊆ A` recorded in `ℳ` lies in every cover σ-algebra of `A`
up to null sets. -/
theorem germSigma_le_aeSigma_of_subset {A A' : Ω → Set ℂ}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA𝒦 : MeasurableSpace.comap A hittingSigma ≤ 𝒦) (hA'𝒦 : MeasurableSpace.comap A' hittingSigma ≤ 𝒦)
    (hA'A : ∀ ω, A' ω ⊆ A ω) (j : ℕ) : germSigma A' h ≤ aeSigma (coverSigmaM 𝒦 j A h) P := by
  intro G hG
  have hG' := measurableSet_germSigmaAt_coverRad hG j
  have hM : 𝒦 ≤ aeSigma (coverSigmaM 𝒦 j A h) P :=
    (le_sup_left : 𝒦 ≤ coverSigmaM 𝒦 j A h).trans (le_aeSigma _ P)
  refine (sup_le (hA'𝒦.trans hM) (MeasurableSpace.generateFrom_le ?_) :
    germSigmaAt A' h (coverRad j) ≤ _) G hG'
  rintro _ ⟨φ, B, hB, rfl⟩
  have e : {ω | tsupport φ ⊆ germNbhd (coverRad j) (A' ω)} ∩ (fun ω => h ω φ) ⁻¹' B =
      {ω | tsupport φ ⊆ germNbhd (coverRad j) (A' ω)} ∩
        ({ω | tsupport φ ⊆ germNbhd (coverRad j) (A ω)} ∩ (fun ω => h ω φ) ⁻¹' B) := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq, mem_preimage]
    exact ⟨fun ⟨h1, h2⟩ => ⟨h1, h1.trans (germNbhd_mono_set (hA'A ω)), h2⟩,
      fun ⟨h1, _, h2⟩ => ⟨h1, h2⟩⟩
  rw [e]
  refine MeasurableSet.inter (hA'𝒦.trans hM _ ⟨_, measurableSet_subset_germNbhd
    φ.hasCompactSupport φ.tsupport_subset (coverRad_pos j), rfl⟩) ?_
  exact germSigmaAt_le_aeSigmaM hh hA𝒦 j _ (le_sup_right (a := MeasurableSpace.comap A hittingSigma) _
    (MeasurableSpace.measurableSet_generateFrom ⟨φ, B, hB, rfl⟩))

/-- **Proposition 3.7 (marked-union law)**: given `𝒜 ∨ σ(A₁, A₂)`, the conditional law of `h` is
`h₁ + h₂`, `h₁` the `𝒜`-measurable mean (harmonic on `ℍ ∖ A`), `h₂` a zero-boundary GFF on
`ℍ ∖ A`. -/
theorem IsLocalSet.exists_condLaw_union (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    ∃ g : Ω → DistOn upperHalfPlaneOpens,
      Measurable[germSigma (fun ω => A₁ ω ∪ A₂ ω) h] g ∧
      (∀ᵐ ω ∂P, IsHarmonicDistOn (g ω) (H \ (A₁ ω ∪ A₂ ω))) ∧
      IsCondZeroBoundaryGFF P (germSigma (fun ω => A₁ ω ∪ A₂ ω) h ⊔
          (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma))
        (fun ω => H \ (A₁ ω ∪ A₂ ω)) (fun ω => h ω - g ω) := by
  have hhm := hh.measurable
  have hA := measurable_union_hitting hA₁ hA₂
  have hmk := isCoverMarking_union hh hA₁ hA₂
    ((IsLocalSet.isMarkedAvoidanceLocal hhm hA₁ h₁).isAvoidanceLocal hA₁ hhm)
    ((IsLocalSet.isMarkedAvoidanceLocal hhm hA₂ h₂).isAvoidanceLocal hA₂ hhm) hci
  exact IsLocalSet.exists_condLaw_union_of hh hA₁ hA₂ hci h₁ h₂ le_sup_left
    (sup_le (germSigma_le hA hhm) hmk.le) fun j => sup_le (fun G hG =>
      germSigmaAt_le_aeSigmaM hh hmk.comap_le j G (measurableSet_germSigmaAt_coverRad hG j))
      ((le_sup_left : _ ≤ coverSigmaM _ j _ h).trans (le_aeSigma _ P))

/-- **Proposition 3.7, the strengthened marked-union law** (specification p. 58: "Taking
conditional expectations therefore gives the Gaussian law with mean `𝒞_A` and covariance
`G_{D∖A}` conditional on `𝒥`. … The stronger version with `𝒥` will also be used below"): the same
conditional law given `𝒥 = σ(A₁, A₂, 𝒜, 𝒜₁, 𝒜₂)`, with the individual germ σ-algebras retained. -/
theorem IsLocalSet.exists_condLaw_union_germs (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA₁ : Measurable[mΩ, hittingSigma] A₁) (hA₂ : Measurable[mΩ, hittingSigma] A₂)
    (hci : CondIndepEv (MeasurableSpace.comap h inferInstance)
      (MeasurableSpace.comap A₁ hittingSigma) (MeasurableSpace.comap A₂ hittingSigma) P)
    (h₁ : IsLocalSet A₁ h P) (h₂ : IsLocalSet A₂ h P) :
    ∃ g : Ω → DistOn upperHalfPlaneOpens,
      Measurable[germSigma (fun ω => A₁ ω ∪ A₂ ω) h] g ∧
      (∀ᵐ ω ∂P, IsHarmonicDistOn (g ω) (H \ (A₁ ω ∪ A₂ ω))) ∧
      IsCondZeroBoundaryGFF P (germSigma (fun ω => A₁ ω ∪ A₂ ω) h ⊔
          (MeasurableSpace.comap A₁ hittingSigma ⊔ MeasurableSpace.comap A₂ hittingSigma) ⊔
            (germSigma A₁ h ⊔ germSigma A₂ h))
        (fun ω => H \ (A₁ ω ∪ A₂ ω)) (fun ω => h ω - g ω) := by
  have hhm := hh.measurable
  have hA := measurable_union_hitting hA₁ hA₂
  have hmk := isCoverMarking_union hh hA₁ hA₂
    ((IsLocalSet.isMarkedAvoidanceLocal hhm hA₁ h₁).isAvoidanceLocal hA₁ hhm)
    ((IsLocalSet.isMarkedAvoidanceLocal hhm hA₂ h₂).isAvoidanceLocal hA₂ hhm) hci
  refine IsLocalSet.exists_condLaw_union_of hh hA₁ hA₂ hci h₁ h₂ (le_sup_left.trans le_sup_left)
    (sup_le (sup_le (germSigma_le hA hhm) hmk.le)
      (sup_le (germSigma_le hA₁ hhm) (germSigma_le hA₂ hhm))) fun j => ?_
  refine sup_le (sup_le (fun G hG => germSigmaAt_le_aeSigmaM hh hmk.comap_le j G
    (measurableSet_germSigmaAt_coverRad hG j))
    ((le_sup_left : _ ≤ coverSigmaM _ j _ h).trans (le_aeSigma _ P))) (sup_le ?_ ?_)
  · exact germSigma_le_aeSigma_of_subset hh hmk.comap_le le_sup_left
      (fun ω => subset_union_left) j
  · exact germSigma_le_aeSigma_of_subset hh hmk.comap_le le_sup_right
      (fun ω => subset_union_right) j

end Union

