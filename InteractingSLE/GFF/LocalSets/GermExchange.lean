import InteractingSLE.GFF.LocalSets.Basic
import QuantumZipper.Proofs.Probability.GermZeroOne


/-!
# Germ σ-algebras: exchange of intersection and independent join (toward Proposition 3.2)

Source: `source/ig1-specification.pdf`, §3.1, Proposition 3.2 and its proof (pp. 43–44;
transcription `source/spec/p001-048.md#prop-3.2`, `#prop-3.2-proof`): for a deterministic closed
`K ⊆ D`, `F_{K+}^h = ⋂_{U ⊇ K} F_U^h` (completed σ-algebras), where `F_{K+}^h` is generated by the
projection of `h` onto `H^⊥(D ∖ K)` and `F_U^h` by `h|_U`.

This file proves the measure-theoretic core of the inclusion `⋂ₙ F_{Uₙ} ⊆ F_{K+}` and reduces that
inclusion to one Gaussian input:

* `exists_ae_eq_of_mem_iInf_sup`: if `𝒜 ⫫ ℬ₀`, `ℬₙ ↓` and `⋂ ℬₙ` is trivial, then
  `⋂ₙ (𝒜 ⊔ ℬₙ) = 𝒜` modulo null sets (own proof, adapting QuantumZipper's independent-join lemma
  `GermZeroOne.measure_inter_rect_eq_of_join` and its `L²` mixing lemma
  `tendsto_integral_abs_condExp_sub_of_memLp`);
* `exists_ae_eq_complSigma_of_mem_iInf_restrictSigma`: with `h = h_V + (h − h_V)` a Markov
  decomposition (`V = D ∖ K`), `F_{Uₙ}^h ⊆ σ(h − h_V) ⊔ F_{Uₙ}^{h_V}` and `σ(h − h_V) ⫫ σ(h_V)`, so
  `⋂ₙ F_{Uₙ}^h ⊆ σ(h − h_V)` modulo null sets **provided** the germ σ-algebra
  `⋂ₙ F_{Uₙ}^{h_V}` of the zero-boundary part is trivial (hypothesis `htriv`: a conditional
  helper, not Proposition 3.2; see the PROVE-LS-A2 handoff for the missing input).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology
open QuantumZipper.GermZeroOne

namespace InteractingSLE
namespace GFF

/-- Key computation of the exchange lemma: for `G ∈ ⋂ₙ (𝒜 ⊔ ℬₙ)`, `A ∈ 𝒜`, `B ∈ ℬ₀`,
`P(G ∩ A ∩ B) = P(G ∩ A) P(B)` when `𝒜 ⫫ ℬ₀`, `ℬₙ ↓` and `⋂ ℬₙ` is trivial. -/
lemma measure_inter_inter_eq_of_mem_iInf_sup {Ω : Type*} {𝒜 : MeasurableSpace Ω}
    [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ℬ : ℕ → MeasurableSpace Ω} (h𝒜 : 𝒜 ≤ mΩ) (hℬ : ∀ n, ℬ n ≤ mΩ) (hb : Antitone ℬ)
    (hind : Indep 𝒜 (ℬ 0) P) (htb : IsTrivialSigma (⨅ n, ℬ n) P) {G A B : Set Ω}
    (hG : MeasurableSet[⨅ n, 𝒜 ⊔ ℬ n] G) (hA : MeasurableSet[𝒜] A)
    (hB : MeasurableSet[ℬ 0] B) :
    P.real (G ∩ (A ∩ B)) = P.real (G ∩ A) * P.real B := by
  have hsup : ∀ n, 𝒜 ⊔ ℬ n ≤ mΩ := fun n => sup_le h𝒜 (hℬ n)
  have hG' : ∀ n, MeasurableSet[𝒜 ⊔ ℬ n] G := fun n => (iInf_le (fun n => 𝒜 ⊔ ℬ n) n) G hG
  have hG0 : MeasurableSet G := hsup 0 _ (hG' 0)
  have hA0 : MeasurableSet A := h𝒜 _ hA
  have hB0 : MeasurableSet B := hℬ 0 _ hB
  set ia : Ω → ℝ := A.indicator (fun _ => (1 : ℝ)) with hia_def
  set ib : Ω → ℝ := B.indicator (fun _ => (1 : ℝ)) with hib_def
  have hia : Integrable ia P := (integrable_const (1 : ℝ)).indicator hA0
  have hib : Integrable ib P := (integrable_const (1 : ℝ)).indicator hB0
  have hia_sm : StronglyMeasurable[𝒜] ia := stronglyMeasurable_const.indicator hA
  have hib_sm : StronglyMeasurable[ℬ 0] ib := stronglyMeasurable_const.indicator hB
  set b : ℕ → Ω → ℝ := fun n => P[ib | ℬ n]
  have hb1 : ∀ n, ∀ᵐ ω ∂P, |b n ω| ≤ 1 := fun n =>
    ae_bdd_abs_condExp_of_ae_bdd_abs (m := ℬ n) (μ := P) (R := (1 : ℝ)) (f := ib)
      (Eventually.of_forall fun ω => abs_indicator_one_le B ω)
  have hu : Integrable (fun ω => ia ω * ib ω) P :=
    hib.bdd_mul hia.aestronglyMeasurable (c := 1)
      (Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact abs_indicator_one_le A ω)
  have hv : ∀ n, Integrable (fun ω => ia ω * b n ω) P := fun n =>
    integrable_condExp.bdd_mul hia.aestronglyMeasurable (c := 1)
      (Eventually.of_forall fun ω => by rw [Real.norm_eq_abs]; exact abs_indicator_one_le A ω)
  -- conditional factorization on `𝒜 ⊔ ℬₙ`
  have C1 : ∀ n G', MeasurableSet[𝒜 ⊔ ℬ n] G' →
      ∫ ω in G', ia ω * ib ω ∂P = ∫ ω in G', ia ω * b n ω ∂P := by
    intro n
    have hnℬ : ℬ n ≤ ℬ 0 := hb (Nat.zero_le n)
    have basic : ∀ A' B', MeasurableSet[𝒜] A' → MeasurableSet[ℬ n] B' →
        ∫ ω in A' ∩ B', ia ω * ib ω ∂P = ∫ ω in A' ∩ B', ia ω * b n ω ∂P := by
      intro A' B' hA' hB'
      have e1 : ∀ φ ψ : Ω → ℝ, ∫ ω in A' ∩ B', φ ω * ψ ω ∂P
          = ∫ ω, A'.indicator φ ω * B'.indicator ψ ω ∂P := by
        intro φ ψ
        rw [← integral_indicator (MeasurableSet.inter (h𝒜 _ hA') (hℬ n _ hB'))]
        congr 1; funext ω
        by_cases h1 : ω ∈ A' <;> by_cases h2 : ω ∈ B' <;> simp [Set.indicator, h1, h2]
      rw [e1, e1]
      rw [integral_mul_of_indep hind (hia_sm.indicator hA')
          (hib_sm.indicator (hnℬ _ hB')) h𝒜 (hℬ 0),
        integral_mul_of_indep hind (hia_sm.indicator hA')
          ((stronglyMeasurable_condExp.mono hnℬ).indicator (hnℬ _ hB')) h𝒜 (hℬ 0)]
      rw [integral_indicator (hℬ n _ hB'), integral_indicator (hℬ n _ hB'),
        setIntegral_condExp (hℬ n) hib hB']
    have total : ∫ ω, ia ω * ib ω ∂P = ∫ ω, ia ω * b n ω ∂P := by
      have := basic Set.univ Set.univ MeasurableSet.univ MeasurableSet.univ
      simpa using this
    intro G' hG'
    refine @MeasurableSpace.induction_on_inter Ω (𝒜 ⊔ ℬ n)
      (fun t _ => ∫ ω in t, ia ω * ib ω ∂P = ∫ ω in t, ia ω * b n ω ∂P) _
      (sup_eq_generateFrom_rectSets 𝒜 (ℬ n)) (isPiSystem_rectSets _ _) ?_ ?_ ?_ ?_ G' hG'
    · simp
    · rintro _ ⟨A', B', hA', hB', rfl⟩
      exact basic A' B' hA' hB'
    · intro t htm ih
      rw [setIntegral_compl (hsup n t htm) hu, setIntegral_compl (hsup n t htm) (hv n), ih, total]
    · intro f hd hfm ih
      rw [integral_iUnion (fun i => hsup n _ (hfm i)) hd hu.integrableOn,
        integral_iUnion (fun i => hsup n _ (hfm i)) hd (hv n).integrableOn]
      exact tsum_congr ih
  -- mixing
  set β := ∫ ω, ib ω ∂P
  have hβB : β = P.real B := by
    show ∫ ω, B.indicator (fun _ => (1 : ℝ)) ω ∂P = _
    rw [integral_indicator_const _ hB0, smul_eq_mul, mul_one]
  have C2 : Tendsto (fun n => ∫ ω, |b n ω - β| ∂P) atTop (𝓝 0) :=
    tendsto_integral_abs_condExp_sub_of_memLp hℬ hb htb
      (memLp_indicator_const 2 hB0 (1 : ℝ) (Or.inr (measure_ne_top _ _)))
  have e1 : ∫ ω in G, ia ω * ib ω ∂P = P.real (G ∩ (A ∩ B)) := by
    have : (fun ω => ia ω * ib ω) = (A ∩ B).indicator (fun _ => (1 : ℝ)) := by
      funext ω; by_cases h1 : ω ∈ A <;> by_cases h2 : ω ∈ B <;> simp [ia, ib, h1, h2]
    rw [this, integral_indicator_const _ (hA0.inter hB0),
      measureReal_restrict_apply (hA0.inter hB0), Set.inter_comm, smul_eq_mul, mul_one]
  have e2 : ∫ ω in G, ia ω ∂P = P.real (G ∩ A) := by
    rw [integral_indicator_const _ hA0, measureReal_restrict_apply hA0, Set.inter_comm,
      smul_eq_mul, mul_one]
  have bound : ∀ n, |P.real (G ∩ (A ∩ B)) - P.real (G ∩ A) * β| ≤ ∫ ω, |b n ω - β| ∂P := by
    intro n
    have hi2 : Integrable (fun ω => |b n ω - β|) P :=
      (integrable_condExp.sub (integrable_const _)).abs
    have hi3 : Integrable (fun ω => ia ω * (b n ω - β)) P :=
      ((hv n).sub (hia.mul_const β)).congr (Eventually.of_forall fun ω => by
        simp only [Pi.sub_apply]; ring)
    have hbd : ∀ ω, |ia ω * (b n ω - β)| ≤ |b n ω - β| := fun ω => by
      rw [abs_mul]
      calc |ia ω| * |b n ω - β| ≤ 1 * |b n ω - β| := by
            gcongr; exact abs_indicator_one_le A ω
        _ = _ := one_mul _
    calc |P.real (G ∩ (A ∩ B)) - P.real (G ∩ A) * β|
        = |∫ ω in G, ia ω * (b n ω - β) ∂P| := by
          congr 1
          rw [← e1, ← e2, C1 n G (hG' n), ← integral_mul_const,
            ← integral_sub (hv n).integrableOn (hia.mul_const β).integrableOn]
          congr 1; funext ω; ring
      _ ≤ ∫ ω in G, |ia ω * (b n ω - β)| ∂P := abs_integral_le_integral_abs
      _ ≤ ∫ ω, |ia ω * (b n ω - β)| ∂P :=
          setIntegral_le_integral hi3.abs (Eventually.of_forall fun _ => abs_nonneg _)
      _ ≤ ∫ ω, |b n ω - β| ∂P := integral_mono hi3.abs hi2 hbd
  have h0 := ge_of_tendsto' C2 bound
  rw [← hβB]
  exact sub_eq_zero.1 (abs_nonpos_iff.1 h0)


/-- **Exchange of intersection and join under independence.** If `𝒜 ⫫ ℬ₀`, `ℬₙ ↓` and
`⋂ₙ ℬₙ` is `P`-trivial, then every event of `⋂ₙ (𝒜 ⊔ ℬₙ)` agrees almost surely with an event of
`𝒜` (i.e. `⋂ₙ (𝒜 ⊔ ℬₙ) = 𝒜` modulo null sets). -/
theorem exists_ae_eq_of_mem_iInf_sup {Ω : Type*} {𝒜 : MeasurableSpace Ω}
    [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ℬ : ℕ → MeasurableSpace Ω} (h𝒜 : 𝒜 ≤ mΩ) (hℬ : ∀ n, ℬ n ≤ mΩ) (hb : Antitone ℬ)
    (hind : Indep 𝒜 (ℬ 0) P) (htb : IsTrivialSigma (⨅ n, ℬ n) P) {G : Set Ω}
    (hG : MeasurableSet[⨅ n, 𝒜 ⊔ ℬ n] G) :
    ∃ G' : Set Ω, MeasurableSet[𝒜] G' ∧ G =ᵐ[P] G' := by
  have hsup : 𝒜 ⊔ ℬ 0 ≤ mΩ := sup_le h𝒜 (hℬ 0)
  have hG0 : MeasurableSet[𝒜 ⊔ ℬ 0] G := (iInf_le (fun n => 𝒜 ⊔ ℬ n) 0) G hG
  have hGm : MeasurableSet G := hsup _ hG0
  set f : Ω → ℝ := G.indicator (fun _ => (1 : ℝ)) with hf_def
  have hf : Integrable f P := (integrable_const (1 : ℝ)).indicator hGm
  set g : Ω → ℝ := P[f | 𝒜] with hg_def
  have hg : Integrable g P := integrable_condExp
  have hfg : f =ᵐ[P] g := by
    refine ae_eq_of_forall_setIntegral_eq_of_sigmaFinite' hsup (fun s _ _ => hf.integrableOn)
      (fun s _ _ => hg.integrableOn) (fun s hs _ => ?_)
      (stronglyMeasurable_const.indicator hG0).aestronglyMeasurable
      (((stronglyMeasurable_condExp (m := 𝒜) (μ := P) (f := f)).mono
        (le_sup_left : 𝒜 ≤ 𝒜 ⊔ ℬ 0)).aestronglyMeasurable)
    have total : ∫ ω, f ω ∂P = ∫ ω, g ω ∂P := (integral_condExp h𝒜).symm
    refine @MeasurableSpace.induction_on_inter Ω (𝒜 ⊔ ℬ 0)
      (fun t _ => ∫ ω in t, f ω ∂P = ∫ ω in t, g ω ∂P) _
      (sup_eq_generateFrom_rectSets 𝒜 (ℬ 0)) (isPiSystem_rectSets _ _) ?_ ?_ ?_ ?_ s hs
    · simp
    · rintro _ ⟨A, B, hA, hB, rfl⟩
      have hA0 : MeasurableSet A := h𝒜 _ hA
      have hB0 : MeasurableSet B := hℬ 0 _ hB
      have hkey := measure_inter_inter_eq_of_mem_iInf_sup h𝒜 hℬ hb hind htb hG hA hB
      have e1 : ∫ ω in A ∩ B, f ω ∂P = P.real (G ∩ (A ∩ B)) := by
        rw [integral_indicator_const _ hGm, measureReal_restrict_apply hGm, Set.inter_comm,
          smul_eq_mul, mul_one]
      have e2 : ∫ ω in A ∩ B, g ω ∂P = (∫ ω in A, g ω ∂P) * P.real B := by
        have : ∫ ω in A ∩ B, g ω ∂P =
            ∫ ω, A.indicator g ω * B.indicator (fun _ => (1 : ℝ)) ω ∂P := by
          rw [← integral_indicator (hA0.inter hB0)]
          congr 1; funext ω
          by_cases h1 : ω ∈ A <;> by_cases h2 : ω ∈ B <;> simp [Set.indicator, h1, h2]
        rw [this, integral_mul_of_indep hind (stronglyMeasurable_condExp.indicator hA)
          (stronglyMeasurable_const.indicator hB) h𝒜 (hℬ 0), integral_indicator hA0,
          integral_indicator_const _ hB0, smul_eq_mul, mul_one]
      have e3 : ∫ ω in A, g ω ∂P = P.real (G ∩ A) := by
        rw [setIntegral_condExp h𝒜 hf hA, integral_indicator_const _ hGm,
          measureReal_restrict_apply hGm, Set.inter_comm, smul_eq_mul, mul_one]
      rw [e1, e2, e3, hkey]
    · intro t htm ih
      rw [setIntegral_compl (hsup t htm) hf, setIntegral_compl (hsup t htm) hg, ih, total]
    · intro F hd hFm ih
      rw [integral_iUnion (fun i => hsup _ (hFm i)) hd hf.integrableOn,
        integral_iUnion (fun i => hsup _ (hFm i)) hd hg.integrableOn]
      exact tsum_congr ih
  refine ⟨{ω | g ω = 1}, (stronglyMeasurable_condExp (m := 𝒜)).measurable
    (measurableSet_singleton (1 : ℝ)), ?_⟩
  filter_upwards [hfg] with ω hω
  show (ω ∈ G) = (g ω = 1)
  rw [← hω]
  by_cases h : ω ∈ G
  · simp [hf_def, h]
  · simp [hf_def, h]


open TopologicalSpace LQGMetric

/-- The σ-algebra `F_U^X` generated by the restriction of a random distribution `X` to `U`. -/
abbrev restrictSigma {Ω : Type*} {D : Opens ℂ} (U : Opens ℂ) (X : Ω → DistOn D) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => restrictDist U (X ω)) inferInstance

lemma restrictSigma_le {Ω : Type*} [mΩ : MeasurableSpace Ω] {D : Opens ℂ} (U : Opens ℂ)
    {X : Ω → DistOn D} (hX : Measurable X) : restrictSigma U X ≤ mΩ :=
  ((measurable_restrictDist U).comp hX).comap_le

lemma restrictSigma_antitone {Ω : Type*} {D : Opens ℂ} {U U' : Opens ℂ} (hU : U ≤ U')
    (hU'D : U' ≤ D) (X : Ω → DistOn D) : restrictSigma U X ≤ restrictSigma U' X := by
  have : (fun ω => restrictDist U (X ω)) = restrictDist U ∘ fun ω => restrictDist U' (X ω) :=
    funext fun ω => (restrictDist_restrictDist hU hU'D (X ω)).symm
  unfold restrictSigma
  rw [this, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_restrictDist U).comap_le

/-- The σ-algebra `σ(h − h_V)` of the complementary Markov projection (`F_{K+}^h`, `K = D ∖ V`). -/
abbrev complSigma {Ω : Type*} {D : Opens ℂ} (h hV : Ω → DistOn D) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => h ω - hV ω) inferInstance

/-- **Proposition 3.2, inclusion `⋂ₙ F_{Uₙ} ⊆ F_{K+}` modulo null sets, conditional on the germ
zero-one law of the zero-boundary part.** Let `h = h_V + (h − h_V)` be a Markov decomposition on
`V ⊆ D` (`V = D ∖ K`, so `σ(h − h_V) = F_{K+}^h`), and `Uₙ ⊆ D` decreasing open sets. If the germ
σ-algebra `⋂ₙ F_{Uₙ}^{h_V}` of the zero-boundary part is trivial, then every event of
`⋂ₙ F_{Uₙ}^h` agrees almost surely with an event of `σ(h − h_V)`. The hypothesis `htriv` is the
remaining (Gaussian) input; it is not proved here. -/
theorem exists_ae_eq_complSigma_of_mem_iInf_restrictSigma {D V : Opens ℂ} {Ω : Type*}
    [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {h hV : Ω → DistOn D}
    (hhm : Measurable h) (hd : IsMarkovDecomposition V D h hV P) {U : ℕ → Opens ℂ}
    (hU : Antitone U) (hUD : ∀ n, U n ≤ D)
    (htriv : QuantumZipper.GermZeroOne.IsTrivialSigma (⨅ n, restrictSigma (U n) hV) P)
    {E : Set Ω} (hE : MeasurableSet[⨅ n, restrictSigma (U n) h] E) :
    ∃ E' : Set Ω, MeasurableSet[complSigma h hV] E' ∧ E =ᵐ[P] E' := by
  have hVm : Measurable hV := hd.isZBGFFExtOn.measurable
  have hsubm : Measurable fun ω => h ω - hV ω :=
    measurable_distOn_iff.2 fun φ =>
      ((measurable_distOn_apply φ).comp hhm).sub ((measurable_distOn_apply φ).comp hVm)
  have hb : Antitone fun n => restrictSigma (U n) hV := fun m n hmn =>
    restrictSigma_antitone (hU hmn) (hUD m) hV
  have hind : Indep (complSigma h hV) (restrictSigma (U 0) hV) P := by
    have h1 : Indep (MeasurableSpace.comap hV inferInstance) (complSigma h hV) P :=
      (IndepFun_iff_Indep _ _ _).1 hd.indepFun
    have h2 : restrictSigma (U 0) hV ≤ MeasurableSpace.comap hV inferInstance := by
      show MeasurableSpace.comap (restrictDist (U 0) ∘ hV) inferInstance ≤ _
      rw [← MeasurableSpace.comap_comp]
      exact MeasurableSpace.comap_mono (measurable_restrictDist (U 0)).comap_le
    exact (indep_of_indep_of_le_left h1 h2).symm
  have hle : ∀ n, restrictSigma (U n) h ≤ complSigma h hV ⊔ restrictSigma (U n) hV := by
    intro n
    have h1 : Measurable[complSigma h hV] fun ω => restrictDist (U n) (h ω - hV ω) :=
      (measurable_restrictDist (U n)).comp (Measurable.of_comap_le le_rfl)
    have h2 : Measurable[restrictSigma (U n) hV] fun ω => restrictDist (U n) (hV ω) :=
      Measurable.of_comap_le le_rfl
    have hsum : Measurable[complSigma h hV ⊔ restrictSigma (U n) hV] fun ω =>
        restrictDist (U n) (h ω - hV ω) + restrictDist (U n) (hV ω) :=
      (measurable_add_distOn (U n)).comp ((h1.mono le_sup_left le_rfl).prodMk
        (h2.mono le_sup_right le_rfl))
    have e : (fun ω => restrictDist (U n) (h ω)) =
        fun ω => restrictDist (U n) (h ω - hV ω) + restrictDist (U n) (hV ω) :=
      funext fun ω => by rw [← restrictDist_add, sub_add_cancel]
    show MeasurableSpace.comap (fun ω => restrictDist (U n) (h ω)) inferInstance ≤ _
    rw [e]
    exact hsum.comap_le
  have hE' : MeasurableSet[⨅ n, complSigma h hV ⊔ restrictSigma (U n) hV] E := by
    rw [MeasurableSpace.measurableSet_iInf] at hE ⊢
    exact fun n => hle n _ (hE n)
  exact exists_ae_eq_of_mem_iInf_sup hsubm.comap_le (fun n => restrictSigma_le (U n) hVm) hb
    hind htriv hE'


end GFF
end InteractingSLE
