import InteractingSLE.Frozen.Spec.IsLocalSet
import QuantumZipper.Proofs.GFF.K3.DualExistence

/-!
# Random relatively closed subsets of `ℍ`: hitting events and random-domain covariances

Infrastructure for §3.2 of the specification (local sets, `source/spec/p049-096.md#32-local-sets`).
A random local set is a map `A : Ω → Set ℂ`, measurable for the hitting σ-algebra
`InteractingSLE.hittingSigma` (generated by `{S | (S ∩ U).Nonempty}`, `U ⊆ ℍ` open), whose values
are almost surely relatively closed subsets of `ℍ`.

## Main results

* `measurableSet_hitting` : the hitting events are measurable;
* `relClosureH S = ℍ ∩ cl (S ∩ ℍ)` : the relative closure, always relatively closed in `ℍ`, equal to
  `S` when `S` is, and with the same hitting events (`comap_relClosureH`);
* `measurableSet_disjoint_relClosureH` : avoidance of a compact `K ⊆ ℍ` by `relClosureH S` is a
  hitting-measurable event;
* `measurable_zeroGFFTestCov_compl` : `S ↦ zeroGFFTestCov (ℍ \ relClosureH S) φ ψ` is
  hitting-measurable (the conditional covariance of the residual field of a local set is a
  measurable function of the set);
* `tendsto_dualNormSq_iUnion`, `tendsto_zeroGFFTestCov_iUnion` : monotone Dirichlet-space
  approximation (specification p. 50, "Monotone Dirichlet-space approximation"): for open
  `U₀ ⊆ U₁ ⊆ ⋯ ⊆ ℍ`, the zero-boundary variances on `U n` converge to the variance on `⋃ U n`.

All are proved from QuantumZipper's countable test family (`QuantumZipper.K3.testFamily`,
`dualNormSq_eq_iSup_testFamily`, `measurable_zeroGFFTestCov`).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology TopologicalSpace Metric EMetric
open scoped ENNReal

namespace InteractingSLE
namespace LocalSets

open QuantumZipper QuantumZipper.K3

/-! ### Hitting events -/

/-- The hitting event `{S | S ∩ U ≠ ∅}` of an open `U ⊆ ℍ` is `hittingSigma`-measurable. -/
theorem measurableSet_hitting {U : Set ℂ} (hU : IsOpen U) (hUH : U ⊆ H) :
    MeasurableSet[hittingSigma] {S : Set ℂ | (S ∩ U).Nonempty} :=
  MeasurableSpace.measurableSet_generateFrom ⟨U, hU, hUH, rfl⟩

/-- The avoidance event `{S | S ∩ U = ∅}` of an open `U ⊆ ℍ` is `hittingSigma`-measurable. -/
theorem measurableSet_avoid {U : Set ℂ} (hU : IsOpen U) (hUH : U ⊆ H) :
    MeasurableSet[hittingSigma] {S : Set ℂ | Disjoint S U} := by
  have : {S : Set ℂ | Disjoint S U} = {S : Set ℂ | (S ∩ U).Nonempty}ᶜ := by
    ext S; simp [Set.not_nonempty_iff_eq_empty, Set.disjoint_iff_inter_eq_empty]
  rw [this]
  exact (measurableSet_hitting hU hUH).compl

/-! ### Relative closure in `ℍ` -/

/-- The relative closure `ℍ ∩ cl (S ∩ ℍ)` of `S` in `ℍ`. -/
def relClosureH (S : Set ℂ) : Set ℂ := H ∩ closure (S ∩ H)

lemma relClosureH_subset (S : Set ℂ) : relClosureH S ⊆ H := inter_subset_left

lemma isOpen_H_diff_relClosureH (S : Set ℂ) : IsOpen (H \ relClosureH S) := by
  have : H \ relClosureH S = H ∩ (closure (S ∩ H))ᶜ := by
    ext z; simp [relClosureH]
  rw [this]
  exact isOpen_H.inter isClosed_closure.isOpen_compl

/-- A relatively closed subset of `ℍ` is its own relative closure. -/
lemma relClosureH_eq {S : Set ℂ} (hS : S ⊆ H) (ho : IsOpen (H \ S)) : relClosureH S = S := by
  refine Subset.antisymm (fun z hz => ?_) fun z hz => ⟨hS hz, subset_closure ⟨hz, hS hz⟩⟩
  by_contra hzS
  have hzU : z ∈ H \ S := ⟨hz.1, hzS⟩
  obtain ⟨w, hw, hwS⟩ := mem_closure_iff.1 hz.2 (H \ S) ho hzU
  exact hw.2 hwS.1

/-- The relative closure has the same hitting events as the set. -/
lemma relClosureH_inter_nonempty_iff {S U : Set ℂ} (hU : IsOpen U) (hUH : U ⊆ H) :
    (relClosureH S ∩ U).Nonempty ↔ (S ∩ U).Nonempty := by
  constructor
  · rintro ⟨z, hz, hzU⟩
    obtain ⟨w, hwU, hw⟩ := mem_closure_iff.1 hz.2 U hU hzU
    exact ⟨w, hw.1, hwU⟩
  · rintro ⟨z, hz, hzU⟩
    exact ⟨z, ⟨hUH hzU, subset_closure ⟨hz, hUH hzU⟩⟩, hzU⟩

/-- `relClosureH` pulls the hitting σ-algebra back to itself. -/
theorem comap_relClosureH : hittingSigma.comap relClosureH = hittingSigma := by
  rw [hittingSigma, MeasurableSpace.comap_generateFrom]
  congr 1
  ext T
  constructor
  · rintro ⟨_, ⟨U, hU, hUH, rfl⟩, rfl⟩
    refine ⟨U, hU, hUH, ?_⟩
    ext S
    exact relClosureH_inter_nonempty_iff hU hUH
  · rintro ⟨U, hU, hUH, rfl⟩
    refine ⟨_, ⟨U, hU, hUH, rfl⟩, ?_⟩
    ext S
    exact relClosureH_inter_nonempty_iff hU hUH

theorem measurable_relClosureH : Measurable[hittingSigma, hittingSigma] relClosureH :=
  measurable_iff_comap_le.2 comap_relClosureH.le

/-- For a compact `K ⊆ ℍ`, avoidance of `K` by the relative closure of `S` is detected by the
open thickenings of `K`. -/
lemma disjoint_relClosureH_iff {K S : Set ℂ} (hK : IsCompact K) (hKH : K ⊆ H) :
    Disjoint K (relClosureH S) ↔
      ∃ n : ℕ, ¬ (S ∩ (thickening (1 / ((n : ℝ) + 1)) K ∩ H)).Nonempty := by
  constructor
  · intro hdis
    have hsub : K ⊆ (closure (S ∩ H))ᶜ := fun z hz hzc =>
      Set.disjoint_left.1 hdis hz ⟨hKH hz, hzc⟩
    obtain ⟨δ, hδ, hδK⟩ := hK.exists_thickening_subset_open isClosed_closure.isOpen_compl hsub
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hδ
    refine ⟨n, ?_⟩
    rintro ⟨z, hzS, hzK, hzH⟩
    exact hδK (thickening_mono hn.le K hzK) (subset_closure ⟨hzS, hzH⟩)
  · rintro ⟨n, hn⟩
    refine Set.disjoint_left.2 fun z hzK hz => hn ?_
    have hopen : IsOpen (thickening (1 / ((n : ℝ) + 1)) K ∩ H) := isOpen_thickening.inter isOpen_H
    have hz' : z ∈ thickening (1 / ((n : ℝ) + 1)) K ∩ H :=
      ⟨self_subset_thickening (by positivity) K hzK, hKH hzK⟩
    obtain ⟨w, hw, hwS⟩ := mem_closure_iff.1 hz.2 _ hopen hz'
    exact ⟨w, hwS.1, hw⟩

/-- Avoidance of a compact `K ⊆ ℍ` by the relative closure is a hitting-measurable event. -/
theorem measurableSet_disjoint_relClosureH {K : Set ℂ} (hK : IsCompact K) (hKH : K ⊆ H) :
    MeasurableSet[hittingSigma] {S : Set ℂ | Disjoint K (relClosureH S)} := by
  have : {S : Set ℂ | Disjoint K (relClosureH S)} =
      ⋃ n : ℕ, {S : Set ℂ | (S ∩ (thickening (1 / ((n : ℝ) + 1)) K ∩ H)).Nonempty}ᶜ := by
    ext S
    simp only [mem_ofPred_eq, mem_iUnion, mem_compl_iff]
    exact disjoint_relClosureH_iff hK hKH
  rw [this]
  exact MeasurableSet.iUnion fun n =>
    (measurableSet_hitting (isOpen_thickening.inter isOpen_H) inter_subset_right).compl

/-! ### The covariance of the zero-boundary GFF on `ℍ \ A` as a function of `A` -/

/-- A test function on `ℍ` as a QuantumZipper test function on `H`. -/
def toTestFunH (φ : LQGMetric.TestOn upperHalfPlaneOpens) : TestFun H :=
  ⟨φ, φ.contDiff, φ.hasCompactSupport, φ.tsupport_subset⟩

/-- `S ↦ zeroGFFTestCov (ℍ \ relClosureH S) φ ψ` is measurable for the hitting σ-algebra. -/
theorem measurable_zeroGFFTestCov_compl (φ ψ : LQGMetric.TestOn upperHalfPlaneOpens) :
    Measurable[hittingSigma] fun S : Set ℂ => zeroGFFTestCov (H \ relClosureH S) φ ψ := by
  let _ : MeasurableSpace (Set ℂ) := hittingSigma
  refine measurable_zeroGFFTestCov (U := fun S : Set ℂ => H \ relClosureH S)
    (fun S => ⟨isOpen_H_diff_relClosureH S, sdiff_subset⟩) (fun j => ?_)
    (toTestFunH φ) (toTestFunH ψ)
  have hj := testFamily_mem j
  have : {S : Set ℂ | tsupport (testFamily j) ⊆ H \ relClosureH S} =
      {S : Set ℂ | Disjoint (tsupport (testFamily j)) (relClosureH S)} := by
    ext S
    simp only [mem_ofPred_eq, subset_sdiff]
    exact ⟨fun h => h.2, fun h => ⟨hj.2.2, h⟩⟩
  rw [this]
  exact measurableSet_disjoint_relClosureH hj.2.1 hj.2.2

/-- For a random set `A`, measurable for the hitting σ-algebra, the conditional variance
`ω ↦ zeroGFFTestCov (ℍ \ relClosureH (A ω)) φ ψ` is measurable with respect to `σ(A)`. -/
theorem measurable_comap_zeroGFFTestCov_compl {Ω : Type*} (A : Ω → Set ℂ)
    (φ ψ : LQGMetric.TestOn upperHalfPlaneOpens) :
    Measurable[MeasurableSpace.comap A hittingSigma]
      fun ω => zeroGFFTestCov (H \ relClosureH (A ω)) φ ψ :=
  (measurable_zeroGFFTestCov_compl φ ψ).comp (Measurable.of_comap_le le_rfl)

/-! ### Monotone Dirichlet-space approximation -/

/-- The dual norm on the union of an increasing sequence of open subsets of `ℍ` is the supremum
of the dual norms. -/
theorem dualNormSq_iUnion_eq_iSup {U : ℕ → Set ℂ} (hU : ∀ n, IsOpen (U n)) (hmono : Monotone U)
    (hUH : ∀ n, U n ⊆ H) {μ : Measure ℂ} (hμ : IsGoodMeas μ) :
    dualNormSq (⋃ n, U n) (zeroSpace (⋃ n, U n)) μ = ⨆ n, dualNormSq (U n) (zeroSpace (U n)) μ := by
  obtain ⟨hμf, hsupp⟩ := hμ
  have hUo : IsOpen (⋃ n, U n) := isOpen_iUnion hU
  have hUH' : (⋃ n, U n) ⊆ H := iUnion_subset hUH
  rw [dualNormSq_eq_iSup_testFamily hUo hUH' hsupp]
  simp_rw [dualNormSq_eq_iSup_testFamily (hU _) (hUH _) hsupp]
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun j hj => ?_
    have hdir : Directed (· ⊆ ·) U := hmono.directed_le
    obtain ⟨n, hn⟩ := (testFamily_mem j).2.1.elim_directed_cover U hU hj.1 hdir
    exact le_iSup_of_le n (le_iSup₂_of_le j ⟨hn, hj.2⟩ le_rfl)
  · refine iSup_le fun n => iSup₂_le fun j hj => ?_
    exact le_iSup₂_of_le j ⟨hj.1.trans (subset_iUnion U n), hj.2⟩ le_rfl

/-- **Monotone Dirichlet-space approximation** (dual norms). -/
theorem tendsto_dualNormSq_iUnion {U : ℕ → Set ℂ} (hU : ∀ n, IsOpen (U n)) (hmono : Monotone U)
    (hUH : ∀ n, U n ⊆ H) {μ : Measure ℂ} (hμ : IsGoodMeas μ) :
    Tendsto (fun n => dualNormSq (U n) (zeroSpace (U n)) μ) atTop
      (𝓝 (dualNormSq (⋃ n, U n) (zeroSpace (⋃ n, U n)) μ)) := by
  rw [dualNormSq_iUnion_eq_iSup hU hmono hUH hμ]
  exact tendsto_atTop_iSup fun m n hmn => dualNormSq_zeroSpace_mono (hU m) (hmono hmn)

/-! ### Distance to a random set -/

/-- `S ↦ infEDist z (S ∩ ℍ)` is hitting-measurable. -/
theorem measurable_infEDist_inter_H (z : ℂ) :
    Measurable[hittingSigma] fun S : Set ℂ => infEDist z (S ∩ H) := by
  let _ : MeasurableSpace (Set ℂ) := hittingSigma
  refine measurable_of_Iio fun r => ?_
  have : (fun S : Set ℂ => infEDist z (S ∩ H)) ⁻¹' Iio r =
      {S : Set ℂ | (S ∩ (Metric.eball z r ∩ H)).Nonempty} := by
    ext S
    simp only [mem_preimage, mem_Iio, infEDist_lt_iff, mem_ofPred_eq]
    constructor
    · rintro ⟨y, ⟨hyS, hyH⟩, hy⟩
      exact ⟨y, hyS, by rwa [Metric.mem_eball, edist_comm], hyH⟩
    · rintro ⟨y, hyS, hy, hyH⟩
      exact ⟨y, ⟨hyS, hyH⟩, by rwa [Metric.mem_eball, edist_comm] at hy⟩
  rw [this]
  exact measurableSet_hitting (Metric.isOpen_eball.inter isOpen_H) inter_subset_right

/-- A compact set lies in the `δ`-thickening of `T` iff the supremum of the distances to `T` over
a dense subset is `< δ`. -/
theorem subset_thickening_iff_iSup {K D T : Set ℂ} (hK : IsCompact K) (hDK : D ⊆ K)
    (hKD : K ⊆ closure D) {δ : ℝ} (hδ : 0 < δ) :
    K ⊆ thickening δ T ↔ ⨆ z ∈ D, infEDist z T < ENNReal.ofReal δ := by
  constructor
  · intro hsub
    rcases K.eq_empty_or_nonempty with rfl | hne
    · have hD : D = ∅ := subset_empty_iff.1 hDK
      subst hD
      simp [hδ]
    · obtain ⟨z₀, hz₀, hmax⟩ := hK.exists_isMaxOn hne continuous_infEDist.continuousOn
      exact lt_of_le_of_lt (iSup₂_le fun z hz => hmax (hDK hz)) (hsub hz₀)
  · intro hlt z hz
    have hcl : IsClosed {x : ℂ | infEDist x T ≤ ⨆ z ∈ D, infEDist z T} :=
      isClosed_le continuous_infEDist continuous_const
    have hzc : z ∈ {x : ℂ | infEDist x T ≤ ⨆ z ∈ D, infEDist z T} :=
      closure_minimal (fun x hx => le_iSup₂ (f := fun z (_ : z ∈ D) => infEDist z T) x hx) hcl
        (hKD hz)
    exact lt_of_le_of_lt hzc hlt

/-- For a compact `K`, `{S | K ⊆ thickening δ (S ∩ ℍ)}` is hitting-measurable. -/
theorem measurableSet_subset_thickening {K : Set ℂ} (hK : IsCompact K) {δ : ℝ} (hδ : 0 < δ) :
    MeasurableSet[hittingSigma] {S : Set ℂ | K ⊆ thickening δ (S ∩ H)} := by
  let _ : MeasurableSpace (Set ℂ) := hittingSigma
  obtain ⟨D, hDK, hDc, hKD⟩ := (TopologicalSpace.IsSeparable.of_separableSpace K).exists_countable_dense_subset
  have : {S : Set ℂ | K ⊆ thickening δ (S ∩ H)} =
      {S : Set ℂ | ⨆ z ∈ D, infEDist z (S ∩ H) < ENNReal.ofReal δ} := by
    ext S
    exact subset_thickening_iff_iSup hK hDK hKD hδ
  rw [this]
  exact measurableSet_lt (Measurable.biSup D hDc fun z _ => measurable_infEDist_inter_H z)
    measurable_const

end LocalSets
end InteractingSLE
