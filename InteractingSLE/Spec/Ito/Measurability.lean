import InteractingSLE.Spec.Ito.Coordinates
import InteractingSLE.Spec.Sec2.GirsanovCut

/-!
# Measurability: null augmentation, a continuous Brownian version, stopped values

Packet PROVE-T11-ITO. The evolution of Definition 2.1 lives on an arbitrary filtration `𝓕`; its paths are continuous
only almost surely and its coordinates only before the lifetime. To apply `martingale_itoLocalized` we pass to the
filtration `𝓖 = 𝓕 ∨ 𝒩` with the `P`-null sets added (`nullAugmented`; the first step of the usual augmentation, which
every source statement uses), in which

* `isFilteredBrownianReal_modify`: modifying `B` off a measurable full-measure set `G` gives an `𝓖`-Brownian motion
  with every path continuous;
* `measurable_stopped_of_agree`: the stopped value `X_{t∧σ}` of a process that agrees up to `σ` with an adapted
  process `K` and is continuous on `[0, σ]` is `𝓖_t`-measurable (left dyadic approximations of `t ∧ σ`).
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology
open scoped NNReal ENNReal Classical

namespace InteractingSLE

namespace Ito

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ### The null augmentation -/

/-- The σ-algebra generated by the `P`-null measurable sets (definitionally the frozen `nullSigma P`). -/
@[instance_reducible]
def nullSets (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | MeasurableSet s ∧ P s = 0}

theorem nullSets_le (P : Measure Ω) : nullSets P ≤ mΩ :=
  MeasurableSpace.generateFrom_le fun _ hs => hs.1

/-- `𝓕_t ∨ 𝒩_P`: the filtration with the `P`-null sets added. -/
def nullAugmented (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) : Filtration ℝ≥0 mΩ :=
  𝓕 ⊔ Filtration.const ℝ≥0 (nullSets P) (nullSets_le P)

theorem nullAugmented_apply (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t : ℝ≥0) :
    nullAugmented 𝓕 P t = 𝓕 t ⊔ nullSets P := rfl

theorem le_nullAugmented (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t : ℝ≥0) :
    𝓕 t ≤ nullAugmented 𝓕 P t := le_sup_left

theorem measurableSet_nullAugmented_of_null {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω} {s : Set Ω}
    (hs : MeasurableSet s) (h0 : P s = 0) (t : ℝ≥0) : MeasurableSet[nullAugmented 𝓕 P t] s :=
  (le_sup_right : nullSets P ≤ 𝓕 t ⊔ nullSets P) s (MeasurableSpace.measurableSet_generateFrom ⟨hs, h0⟩)

/-- Every set of `𝓕_t ∨ 𝒩` is a.e. equal to a set of `𝓕_t`. -/
theorem exists_ae_eq_of_measurableSet_nullAugmented {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω}
    {t : ℝ≥0} {s : Set Ω} (hs : MeasurableSet[nullAugmented 𝓕 P t] s) :
    ∃ s', MeasurableSet[𝓕 t] s' ∧ s =ᵐ[P] s' :=
  (sup_le le_eventuallyMeasurableSpace (MeasurableSpace.generateFrom_le fun _ hu =>
      ⟨∅, @MeasurableSet.empty _ (𝓕 t), ae_eq_empty.mpr hu.2⟩) :
    𝓕 t ⊔ nullSets P ≤ eventuallyMeasurableSpace (𝓕 t) (ae P)) s hs

/-! ### A Brownian motion with every path continuous -/

/-- Modifying an `𝓕`-Brownian motion off a measurable full-measure set `G` of continuous paths gives a
Brownian motion of the null augmentation with every path continuous. -/
theorem isFilteredBrownianReal_modify {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω} {B : ℝ≥0 → Ω → ℝ}
    (hB : IsFilteredBrownianReal 𝓕 B P) {G : Set Ω} (hG : MeasurableSet G) (hGc : P Gᶜ = 0)
    (hGcont : ∀ ω ∈ G, Continuous (B · ω)) :
    IsFilteredBrownianReal (nullAugmented 𝓕 P) (fun t ω => if ω ∈ G then B t ω else 0) P ∧
      ∀ ω, Continuous fun t => (if ω ∈ G then B t ω else 0) := by
  set B' : ℝ≥0 → Ω → ℝ := fun t ω => if ω ∈ G then B t ω else 0 with hB'
  have hae : ∀ t, B t =ᵐ[P] B' t := fun t => by
    have : ∀ᵐ ω ∂P, ω ∈ G := by rw [ae_iff]; exact hGc
    filter_upwards [this] with ω hω
    simp only [hB', hω, ↓reduceIte]
  have hcont : ∀ ω, Continuous fun t => B' t ω := fun ω => by
    by_cases hω : ω ∈ G
    · simpa only [hB', hω, ↓reduceIte] using hGcont ω hω
    · simp only [hB', hω, ↓reduceIte]; exact continuous_const
  have hGt : ∀ t, MeasurableSet[nullAugmented 𝓕 P t] G := fun t => by
    have := measurableSet_nullAugmented_of_null (𝓕 := 𝓕) hG.compl hGc t
    simpa using this.compl
  refine ⟨⟨⟨hB.1.toIsPreBrownianReal.congr hae, Eventually.of_forall hcont⟩, fun t => ?_,
    fun s t hst => ?_⟩, hcont⟩
  · exact Measurable.ite (hGt t) (((hB.2.1 t).mono (le_nullAugmented 𝓕 P t) le_rfl))
      measurable_const
  · rw [Indep_iff]
    intro t1 t2 ht1 ht2
    obtain ⟨A, hA, rfl⟩ := ht1
    obtain ⟨t2', ht2', he2⟩ := exists_ae_eq_of_measurableSet_nullAugmented ht2
    have he1 : (fun ω => B' t ω - B' s ω) ⁻¹' A =ᵐ[P] (fun ω => B t ω - B s ω) ⁻¹' A := by
      filter_upwards [hae t, hae s] with ω h1 h2
      simp only [mem_preimage, h1, h2]
    have hind := Indep_iff _ _ _ |>.1 (hB.2.2 s t hst) ((fun ω => B t ω - B s ω) ⁻¹' A) t2'
      ⟨A, hA, rfl⟩ ht2'
    rw [measure_congr (he1.inter he2), measure_congr he1, measure_congr he2]
    exact hind

/-! ### Stopped values -/

theorem measurable_comp_index {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] {F : α → ℕ → β}
    (hF : ∀ k, Measurable fun a => F a k) {idx : α → ℕ} (hidx : Measurable idx) :
    Measurable fun a => F a (idx a) := by
  have h : Measurable fun q : α × ℕ => F q.1 q.2 := measurable_from_prod_countable_left hF
  exact h.comp (measurable_id.prodMk hidx)

/-- **Stopped values.** Let `σ` be a finite stopping time of `𝓖`, `G ∈ 𝓖₀`, and let `X` agree on `G` up to `σ`
with an adapted `K` and be continuous on `[0, σ]` there. Then `ω ↦ X_{t∧σ(ω)}(ω)` (and `c` off `G`) is
`𝓖_t`-measurable. -/
theorem measurable_stopped_of_agree {β : Type*} [TopologicalSpace β]
    [TopologicalSpace.PseudoMetrizableSpace β] [MeasurableSpace β] [BorelSpace β]
    {𝓖 : Filtration ℝ≥0 mΩ} {K X : ℝ≥0 → Ω → β} {σ : Ω → ℝ≥0}
    (hσ : IsStoppingTime 𝓖 fun ω => (σ ω : WithTop ℝ≥0)) (hK : ∀ s, Measurable[𝓖 s] (K s))
    {G : Set Ω} (hG : MeasurableSet[𝓖 0] G) (c : β) (hKX : ∀ ω ∈ G, ∀ s ≤ σ ω, K s ω = X s ω)
    (hXc : ∀ ω ∈ G, ContinuousOn (X · ω) (Iic (σ ω))) (t : ℝ≥0) :
    Measurable[𝓖 t] fun ω => if ω ∈ G then X (min t (σ ω)) ω else c := by
  -- the stopped time `t ∧ σ` is `𝓖_t`-measurable
  have hm : Measurable[𝓖 t] fun ω => min t (σ ω) := by
    refine measurable_of_Iic (mδ := 𝓖 t) fun x => ?_
    by_cases hx : t ≤ x
    · have : (fun ω => min t (σ ω)) ⁻¹' Iic x = univ := by
        ext ω; simp only [mem_preimage, mem_Iic, mem_univ, iff_true]; exact (min_le_left _ _).trans hx
      rw [this]; exact @MeasurableSet.univ _ (𝓖 t)
    · push Not at hx
      have : (fun ω => min t (σ ω)) ⁻¹' Iic x = {ω | (σ ω : WithTop ℝ≥0) ≤ x} := by
        ext ω
        simp only [mem_preimage, mem_Iic, min_le_iff, mem_ofPred_eq, WithTop.coe_le_coe]
        exact ⟨fun h => h.resolve_left (not_le.2 hx), Or.inr⟩
      rw [this]
      exact 𝓖.mono hx.le _ (hσ x)
  have hmr : Measurable[𝓖 t] fun ω => ((min t (σ ω) : ℝ≥0) : ℝ) := measurable_coe_nnreal_real.comp hm
  set idx : ℕ → Ω → ℕ := fun n ω => Girsanov.stepIdx n ((min t (σ ω) : ℝ≥0) : ℝ) with hidx
  have hidxm : ∀ n, Measurable[𝓖 t] (idx n) := fun n => (Girsanov.measurable_stepIdx n).comp hmr
  set f : ℕ → Ω → β := fun n ω => if ω ∈ G then K (min (Girsanov.grid n (idx n ω)) t) ω else c
    with hf
  have hfm : ∀ n, Measurable[𝓖 t] (f n) := fun n => by
    refine @measurable_comp_index Ω β (𝓖 t) _ (fun ω k => if ω ∈ G then K (min (Girsanov.grid n k) t) ω
      else c) (fun k => ?_) (idx n) (hidxm n)
    exact Measurable.ite (𝓖.mono (bot_le : (0 : ℝ≥0) ≤ t) _ hG)
      ((hK _).mono (𝓖.mono (min_le_right _ _)) le_rfl) measurable_const
  refine @measurable_of_tendsto_metrizable Ω β (𝓖 t) _ _ _ _ f _ hfm (tendsto_pi_nhds.2 fun ω => ?_)
  by_cases hω : ω ∈ G
  · have hle : ∀ n, Girsanov.grid n (idx n ω) ≤ min t (σ ω) := fun n => by
      rw [← NNReal.coe_le_coe]; exact Girsanov.coe_grid_stepIdx_le (NNReal.coe_nonneg _)
    have hlim : Tendsto (fun n => Girsanov.grid n (idx n ω)) atTop (𝓝 (min t (σ ω))) := by
      rw [← NNReal.tendsto_coe]; exact Girsanov.tendsto_coe_grid_stepIdx (NNReal.coe_nonneg _)
    have heq : ∀ n, f n ω = X (Girsanov.grid n (idx n ω)) ω := fun n => by
      simp only [hf, hω, ↓reduceIte, min_eq_left ((hle n).trans (min_le_left _ _))]
      exact hKX ω hω _ ((hle n).trans (min_le_right _ _))
    simp only [hω, ↓reduceIte]
    simp_rw [heq]
    have hmem : min t (σ ω) ∈ Iic (σ ω) := mem_Iic.2 (min_le_right _ _)
    exact ((hXc ω hω) _ hmem).tendsto.comp (tendsto_nhdsWithin_iff.2 ⟨hlim,
      Eventually.of_forall fun n => mem_Iic.2 ((hle n).trans (min_le_right _ _))⟩)
  · simp only [hf, hω, ↓reduceIte]
    exact tendsto_const_nhds

/-! ### Fixed-time measurability of the Loewner map along the driver -/

section Loewner

variable {𝓖 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {G : Set Ω} {z : ℂ}

/-- The event that, at time `s`, `ω` is good, alive (`s < ζ`) and `z` has a forward solution on `[0, s]`. -/
def aliveSet (W : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (G : Set Ω) (z : ℂ) (s : ℝ≥0) : Set Ω :=
  {ω | ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω ∧ ∃ u, QuantumZipper.IsForwardSol (rpath (W · ω)) z s u}

/-- The driver path on `[0, s]` as a point of `C([0, s])` (junk `0` off `G ∩ {s < ζ}`). -/
def drvPathMap (W : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (G : Set Ω)
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω}) (s : ℝ≥0) (ω : Ω) :
    C(Icc (0 : ℝ) s, ℝ) :=
  if h : ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω then
    ⟨fun r => W (r : ℝ).toNNReal ω, (continuousOn_rpath (hGc ω h.1) h.2).domRestrict⟩
  else 0

theorem drvPathMap_apply (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    {s : ℝ≥0} {ω : Ω} (h : ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω) (r : Icc (0 : ℝ) s) :
    drvPathMap W ζ G hGc s ω r = W (r : ℝ).toNNReal ω := by
  rw [drvPathMap, dite_eq_left_of_eq_true (eq_true h)]
  rfl

theorem extIccPath_drvPathMap_eqOn (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    {s : ℝ≥0} {ω : Ω} (h : ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω) :
    EqOn (QuantumZipper.extIccPath s.coe_nonneg (drvPathMap W ζ G hGc s ω)) (rpath (W · ω))
      (Icc 0 (s : ℝ)) := fun r hr => by
  rw [QuantumZipper.extIccPath_of_mem s.coe_nonneg _ hr, drvPathMap_apply hGc h]
  rfl

theorem measurable_drvPathMap (hW : AdaptedBefore 𝓖 ζ W)
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    (hG : MeasurableSet[𝓖 0] G) (s : ℝ≥0) :
    @Measurable Ω C(Icc (0 : ℝ) s, ℝ) (𝓖 s) (borel _) (drvPathMap W ζ G hGc s) := by
  let _ : MeasurableSpace C(Icc (0 : ℝ) s, ℝ) := borel _
  have _ : BorelSpace C(Icc (0 : ℝ) s, ℝ) := ⟨rfl⟩
  have hev : MeasurableSet[𝓖 s] {ω | ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω} := by
    have h1 := hW s univ MeasurableSet.univ
    simp only [mem_univ, and_true] at h1
    exact (𝓖.mono (bot_le : (0 : ℝ≥0) ≤ s) _ hG).inter h1
  refine @QuantumZipper.measurable_to_continuousMap_Icc Ω (𝓖 s) (s : ℝ) _ _ _ fun r => ?_
  have hr : (r : ℝ).toNNReal ≤ s := Real.toNNReal_le_iff_le_coe.2 r.2.2
  have hk := (Girsanov.measurable_killed hW (r : ℝ).toNNReal).mono (𝓖.mono hr) le_rfl
  have heq : (fun ω => drvPathMap W ζ G hGc s ω r) = fun ω =>
      if ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω then Girsanov.killed ζ W (r : ℝ).toNNReal ω else 0 := by
    funext ω
    by_cases h : ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω
    · rw [ite_eq_left_of_eq_true _ _ (eq_true h), drvPathMap_apply hGc h, Girsanov.killed_of_lt
        (lt_of_le_of_lt (by exact_mod_cast hr) h.2)]
    · simp only [drvPathMap, h, ↓reduceDIte, ↓reduceIte, ContinuousMap.zero_apply]
  rw [heq]
  exact Measurable.ite hev hk measurable_const

/-- `aliveSet` is `𝓖_s`-measurable. -/
theorem measurableSet_aliveSet (hW : AdaptedBefore 𝓖 ζ W)
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    (hG : MeasurableSet[𝓖 0] G) (hz : 0 < z.im) (s : ℝ≥0) :
    MeasurableSet[𝓖 s] (aliveSet W ζ G z s) := by
  let _ : MeasurableSpace C(Icc (0 : ℝ) s, ℝ) := borel _
  have _ : BorelSpace C(Icc (0 : ℝ) s, ℝ) := ⟨rfl⟩
  have hev : MeasurableSet[𝓖 s] {ω | ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω} := by
    have h1 := hW s univ MeasurableSet.univ
    simp only [mem_univ, and_true] at h1
    exact (𝓖.mono (bot_le : (0 : ℝ≥0) ≤ s) _ hG).inter h1
  obtain ⟨hO, -⟩ := QuantumZipper.isOpen_goodPaths_continuousOn_fwdMap hz s.coe_nonneg
  have heq : aliveSet W ζ G z s = {ω | ω ∈ G ∧ (s : ℝ≥0∞) < ζ ω} ∩
      drvPathMap W ζ G hGc s ⁻¹' {g | ∃ u, QuantumZipper.IsForwardSol
        (QuantumZipper.extIccPath s.coe_nonneg g) z s u} := by
    ext ω
    simp only [aliveSet, mem_ofPred_eq, mem_inter_iff, mem_preimage]
    constructor
    · rintro ⟨h1, h2, u, hu⟩
      exact ⟨⟨h1, h2⟩, u, (isForwardSol_iff_of_eqOn (extIccPath_drvPathMap_eqOn hGc ⟨h1, h2⟩) u).2 hu⟩
    · rintro ⟨⟨h1, h2⟩, u, hu⟩
      exact ⟨h1, h2, u, (isForwardSol_iff_of_eqOn (extIccPath_drvPathMap_eqOn hGc ⟨h1, h2⟩) u).1 hu⟩
  rw [heq]
  exact hev.inter (measurable_drvPathMap hW hGc hG s hO.measurableSet)

/-- **The killed Loewner map is adapted**: `ω ↦ f_s(z)` on `aliveSet` (and `0` elsewhere) is
`𝓖_s`-measurable. -/
theorem measurable_fwdMap_alive (hW : AdaptedBefore 𝓖 ζ W)
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    (hG : MeasurableSet[𝓖 0] G) (hz : 0 < z.im) (s : ℝ≥0) :
    Measurable[𝓖 s] fun ω =>
      if ω ∈ aliveSet W ζ G z s then QuantumZipper.fwdMap (rpath (W · ω)) s z else 0 := by
  let _ : MeasurableSpace C(Icc (0 : ℝ) s, ℝ) := borel _
  have _ : BorelSpace C(Icc (0 : ℝ) s, ℝ) := ⟨rfl⟩
  obtain ⟨hO, hcont⟩ := QuantumZipper.isOpen_goodPaths_continuousOn_fwdMap hz s.coe_nonneg
  set O := {g : C(Icc (0 : ℝ) s, ℝ) | ∃ u, QuantumZipper.IsForwardSol
    (QuantumZipper.extIccPath s.coe_nonneg g) z s u} with hOdef
  have hh : Measurable (O.piecewise (fun g => QuantumZipper.fwdMap
      (QuantumZipper.extIccPath s.coe_nonneg g) s z) fun _ => (0 : ℂ)) :=
    hcont.measurable_piecewise continuousOn_const hO.measurableSet
  have heq : (fun ω => if ω ∈ aliveSet W ζ G z s then QuantumZipper.fwdMap (rpath (W · ω)) s z
      else 0) = fun ω => if ω ∈ aliveSet W ζ G z s then
        O.piecewise (fun g => QuantumZipper.fwdMap (QuantumZipper.extIccPath s.coe_nonneg g) s z)
          (fun _ => (0 : ℂ)) (drvPathMap W ζ G hGc s ω) else 0 := by
    funext ω
    by_cases hω : ω ∈ aliveSet W ζ G z s
    · simp only [hω, ↓reduceIte]
      obtain ⟨h1, h2, u, hu⟩ := hω
      have hmem : drvPathMap W ζ G hGc s ω ∈ O :=
        ⟨u, (isForwardSol_iff_of_eqOn (extIccPath_drvPathMap_eqOn hGc ⟨h1, h2⟩) u).2 hu⟩
      rw [Set.piecewise_eq_of_mem _ _ _ hmem]
      exact fwdMap_congr_of_eqOn (extIccPath_drvPathMap_eqOn hGc ⟨h1, h2⟩) |>.symm
    · simp only [hω, ↓reduceIte]
  rw [heq]
  exact Measurable.ite (measurableSet_aliveSet hW hGc hG hz s)
    (hh.comp (measurable_drvPathMap hW hGc hG s)) measurable_const

theorem aliveSet_mono {s s' : ℝ≥0} (h : s' ≤ s) : aliveSet W ζ G z s ⊆ aliveSet W ζ G z s' := by
  rintro ω ⟨hG, hζ, u, hu⟩
  exact ⟨hG, lt_of_le_of_lt (by exact_mod_cast h) hζ, u,
    isForwardSol_of_le hu s'.coe_nonneg (by exact_mod_cast h)⟩

theorem ne_zero_of_im_pos' {w : ℂ} (h : 0 < w.im) : w ≠ 0 := fun hw => by
  rw [hw, Complex.zero_im] at h; exact lt_irrefl 0 h

/-- **The killed branch of `log f_s'(z)` is adapted.** -/
theorem measurable_logDerivFwd_alive (hW : AdaptedBefore 𝓖 ζ W)
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    (hG : MeasurableSet[𝓖 0] G) (hz : 0 < z.im) (s : ℝ≥0) :
    Measurable[𝓖 s] fun ω =>
      if ω ∈ aliveSet W ζ G z s then QuantumZipper.logDerivFwd (rpath (W · ω)) s z else 0 := by
  set c : ℝ → ℝ≥0 := fun r => (min (max r 0) (s : ℝ)).toNNReal with hcdef
  have hcc : ∀ r, ((c r : ℝ≥0) : ℝ) = min (max r 0) (s : ℝ) := fun r =>
    Real.coe_toNNReal _ (le_min (le_max_right _ _) s.coe_nonneg)
  have hc : ∀ r, c r ≤ s := fun r => by
    rw [← NNReal.coe_le_coe, hcc]; exact min_le_right _ _
  have hA := measurableSet_aliveSet hW hGc hG hz s
  set Y : ℝ → Ω → ℂ := fun r ω => if ω ∈ aliveSet W ζ G z s then
    2 / QuantumZipper.fwdMap (rpath (W · ω)) (c r) z ^ 2 else 0 with hYdef
  have hYm : ∀ r, Measurable[𝓖 s] (Y r) := fun r => by
    have hf := (measurable_fwdMap_alive hW hGc hG hz (c r)).mono (𝓖.mono (hc r)) le_rfl
    have heq : Y r = fun ω => if ω ∈ aliveSet W ζ G z s then 2 / (if ω ∈ aliveSet W ζ G z (c r) then
        QuantumZipper.fwdMap (rpath (W · ω)) (c r) z else 0) ^ 2 else 0 := by
      funext ω
      by_cases hω : ω ∈ aliveSet W ζ G z s
      · simp only [hYdef, hω, aliveSet_mono (hc r) hω, ↓reduceIte]
      · simp only [hYdef, hω, ↓reduceIte]
    rw [heq]
    exact Measurable.ite hA (measurable_const.div (hf.pow_const 2)) measurable_const
  have hYc : ∀ ω, Continuous fun r => Y r ω := fun ω => by
    by_cases hω : ω ∈ aliveSet W ζ G z s
    · obtain ⟨h1, h2, hsol⟩ := hω
      have hwc := continuousOn_rpath (hGc ω h1) h2
      have hfc := continuousOn_fwdMap_of_continuousOn s.coe_nonneg hwc hz hsol
      have hcl : Continuous fun r : ℝ => min (max r 0) (s : ℝ) :=
        (continuous_id.max continuous_const).min continuous_const
      have hmaps : ∀ r, min (max r 0) (s : ℝ) ∈ Icc 0 (s : ℝ) := fun r =>
        ⟨le_min (le_max_right _ _) s.coe_nonneg, min_le_right _ _⟩
      have h2f : ContinuousOn (fun r => 2 / QuantumZipper.fwdMap (rpath (W · ω)) r z ^ 2)
          (Icc 0 (s : ℝ)) :=
        continuousOn_const.div (hfc.pow 2) fun r hr => pow_ne_zero 2
          (ne_zero_of_im_pos' (im_fwdMap_pos_of_continuousOn s.coe_nonneg hwc hz hsol hr))
      refine (h2f.comp_continuous hcl hmaps).congr fun r => ?_
      simp only [hYdef, Function.comp_apply, hcc, show ω ∈ aliveSet W ζ G z s from ⟨h1, h2, hsol⟩,
        ↓reduceIte]
    · simp only [hYdef, hω, ↓reduceIte]; exact continuous_const
  have hI := QuantumZipper.Dynkin.measurable_intervalIntegral_of_continuous (mα := 𝓖 s) hYm hYc 0 s
  have heq : (fun ω => if ω ∈ aliveSet W ζ G z s then
      QuantumZipper.logDerivFwd (rpath (W · ω)) s z else 0) =
      fun ω => -∫ r in (0 : ℝ)..s, Y r ω := by
    funext ω
    by_cases hω : ω ∈ aliveSet W ζ G z s
    · simp only [hω, ↓reduceIte, QuantumZipper.logDerivFwd]
      congr 1
      refine intervalIntegral.integral_congr fun r hr => ?_
      rw [uIcc_of_le s.coe_nonneg] at hr
      simp only [hYdef, hω, ↓reduceIte, hcc, max_eq_left hr.1, min_eq_left hr.2]
    · simp [hω, hYdef]
  rw [heq]
  exact hI.neg

end Loewner

/-! ### The killed coordinate process -/

section Coordinates

variable {nL nR : ℕ} {𝓖 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {G : Set Ω} {z : ℂ}

theorem adaptedBefore_mono {𝓕 𝓖 : Filtration ℝ≥0 mΩ} (h : 𝓕 ≤ 𝓖) {ζ : Ω → ℝ≥0∞}
    {X : ℝ≥0 → Ω → ℝ} (hX : AdaptedBefore 𝓕 ζ X) : AdaptedBefore 𝓖 ζ X := fun t A hA =>
  h t _ (hX t A hA)

/-- A point of the localization region used off the good event. -/
def coordBase (z : ℂ) : Coord nL nR := (z, fun _ => z, fun _ => z, 0)

/-- The coordinate process of the evolution at `z`. -/
def coordProc (κ : ℝ) (z : ℂ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) (ω : Ω) : Coord nL nR :=
  coordAt κ z (W · ω) (fun i t => VL i t ω) (fun i t => VR i t ω) (B · ω) t

/-- The coordinate process killed outside `aliveSet` (value `coordBase z` there). -/
def killedCoord (κ : ℝ) (z : ℂ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (G : Set Ω) (s : ℝ≥0)
    (ω : Ω) : Coord nL nR :=
  if ω ∈ aliveSet W ζ G z s then coordProc κ z W VL VR B s ω else coordBase z

/-- **The killed coordinate process is adapted.** -/
theorem measurable_killedCoord (κ : ℝ) (hW : AdaptedBefore 𝓖 ζ W)
    (hVL : ∀ i, AdaptedBefore 𝓖 ζ (VL i)) (hVR : ∀ i, AdaptedBefore 𝓖 ζ (VR i))
    (hBm : ∀ t, Measurable[𝓖 t] (B t))
    (hGc : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω})
    (hG : MeasurableSet[𝓖 0] G) (hz : 0 < z.im) (s : ℝ≥0) :
    Measurable[𝓖 s] (killedCoord κ z W VL VR B ζ G s) := by
  have hA := measurableSet_aliveSet hW hGc hG hz s
  have hf := measurable_fwdMap_alive hW hGc hG hz s
  have hL := measurable_logDerivFwd_alive hW hGc hG hz s
  set fbar : Ω → ℂ := fun ω => if ω ∈ aliveSet W ζ G z s then
    QuantumZipper.fwdMap (rpath (W · ω)) s z else 0
  set Lbar : Ω → ℂ := fun ω => if ω ∈ aliveSet W ζ G z s then
    QuantumZipper.logDerivFwd (rpath (W · ω)) s z else 0
  have hof : Measurable fun x : ℝ => (x : ℂ) := Complex.measurable_ofReal
  have hkW := Girsanov.measurable_killed hW s
  have heq : killedCoord κ z W VL VR B ζ G s = fun ω => if ω ∈ aliveSet W ζ G z s then
      ((fbar ω + (Real.sqrt κ : ℂ) * (B s ω : ℂ),
        fun i => fbar ω - ((Girsanov.killed ζ (VL i) s ω - Girsanov.killed ζ W s ω : ℝ) : ℂ),
        fun i => fbar ω - ((Girsanov.killed ζ (VR i) s ω - Girsanov.killed ζ W s ω : ℝ) : ℂ),
        Lbar ω) : Coord nL nR) else coordBase z := by
    funext ω
    by_cases hω : ω ∈ aliveSet W ζ G z s
    · simp only [killedCoord, coordProc, coordAt, fbar, Lbar, hω, ↓reduceIte,
        Girsanov.killed_of_lt hω.2.1]
    · simp only [killedCoord, hω, ↓reduceIte]
  rw [heq]
  refine Measurable.ite hA ?_ measurable_const
  refine (hf.add (measurable_const.mul (hof.comp (hBm s)))).prodMk
    ((@Measurable.of_eval Ω (Fin nL) (fun _ => ℂ) (𝓖 s) _ _ fun i => hf.sub (hof.comp
      ((Girsanov.measurable_killed (hVL i) s).sub hkW))).prodMk
    ((@Measurable.of_eval Ω (Fin nR) (fun _ => ℂ) (𝓖 s) _ _ fun i => hf.sub (hof.comp
      ((Girsanov.measurable_killed (hVR i) s).sub hkW))).prodMk hL))

end Coordinates

end Ito

