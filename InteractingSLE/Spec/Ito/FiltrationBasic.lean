import InteractingSLE.Spec.Ito.Measurability
import InteractingSLE.Frozen.Spec.IsIntegratedSLEEvolution
import InteractingSLE.Frozen.Spec.usualAugmentation
import InteractingSLE.Frozen.Spec.drivingFiltration

/-!
# The usual augmentation: a Brownian motion stays Brownian

Packet PROVE-T11-ITO2 (Specification §3.3 L496: "the usual completion and right-continuous augmentation of the
filtration generated by `(W, V^{i,q})` and `B`"). The Itô core of PROVE-T11-ITO works in the filtration
`nullAugmented 𝓕 P = 𝓕 ∨ 𝒩`. The source works in the usual augmentation `𝓕⁺ = ⋂_{u > t} (𝓕_u ∨ 𝒩)` (the frozen
`usualAugmentation`), and Theorem 1.1 quantifies over the stopping times of the frozen `drivingFiltration`, the usual
augmentation of the filtration generated by the killed driving process.

* `isFilteredBrownianReal_usualAugmentation`: an `𝓕`-Brownian motion is a Brownian motion of the usual augmentation
  of `𝓕` (an increment `B_t − B_s` is independent of `𝓕_u ∨ 𝒩` for every `u ∈ (s, t)`, and `B_t − B_u → B_t − B_s`
  almost surely as `u ↓ s`; independence passes to the limit through integrals of bounded continuous functions);
* `isIntegratedSLEEvolution_usualAugmentation`: an integrated `SLE_κ(ρ)` evolution on `𝓕` is one on its usual
  augmentation, so every result of PROVE-T11-ITO applies with `𝓕` replaced by `usualAugmentation 𝓕 P`;
* `nullAugmented_usualAugmentation`: the usual augmentation already contains the null sets;
* `drivingFiltration_le_usualAugmentation`: the frozen driving filtration is smaller than the usual augmentation of
  the evolution's filtration, so its stopping times are stopping times of `usualAugmentation 𝓕 P`.
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Ito

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ### The usual augmentation -/

/-- The frozen `usualAugmentation` is the right continuation of `nullAugmented`. -/
theorem usualAugmentation_eq_rightCont (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    usualAugmentation 𝓕 P = (nullAugmented 𝓕 P).rightCont := rfl

theorem usualAugmentation_apply (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t : ℝ≥0) :
    usualAugmentation 𝓕 P t = ⨅ u > t, nullAugmented 𝓕 P u := by
  rw [usualAugmentation_eq_rightCont, Filtration.rightCont_eq]

theorem nullAugmented_le_usualAugmentation (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    nullAugmented 𝓕 P ≤ usualAugmentation 𝓕 P :=
  Filtration.le_rightCont _

theorem le_usualAugmentation (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    𝓕 ≤ usualAugmentation 𝓕 P := fun t =>
  (le_nullAugmented 𝓕 P t).trans (nullAugmented_le_usualAugmentation 𝓕 P t)

instance isRightContinuous_usualAugmentation (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    (usualAugmentation 𝓕 P).IsRightContinuous := by
  rw [usualAugmentation_eq_rightCont]; infer_instance

theorem nullSets_le_usualAugmentation (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t : ℝ≥0) :
    nullSets P ≤ usualAugmentation 𝓕 P t :=
  le_sup_right.trans (nullAugmented_le_usualAugmentation 𝓕 P t)

/-- A null set belongs to every σ-algebra of the usual augmentation. -/
theorem measurableSet_usualAugmentation_of_null {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω} {s : Set Ω}
    (hs : MeasurableSet s) (h0 : P s = 0) (t : ℝ≥0) : MeasurableSet[usualAugmentation 𝓕 P t] s :=
  nullAugmented_le_usualAugmentation 𝓕 P t _ (measurableSet_nullAugmented_of_null hs h0 t)

/-- **The usual augmentation already contains the null sets.** -/
theorem nullAugmented_usualAugmentation (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    nullAugmented (usualAugmentation 𝓕 P) P = usualAugmentation 𝓕 P := by
  refine Filtration.ext (funext fun t => ?_)
  change usualAugmentation 𝓕 P t ⊔ nullSets P = usualAugmentation 𝓕 P t
  exact sup_eq_left.2 (nullSets_le_usualAugmentation 𝓕 P t)

theorem nullAugmented_mono {𝓕 𝓕' : Filtration ℝ≥0 mΩ} (h : 𝓕 ≤ 𝓕') (P : Measure Ω) :
    nullAugmented 𝓕 P ≤ nullAugmented 𝓕' P := fun t =>
  sup_le_sup_right (h t) _

theorem usualAugmentation_mono {𝓕 𝓕' : Filtration ℝ≥0 mΩ} (h : 𝓕 ≤ 𝓕') (P : Measure Ω) :
    usualAugmentation 𝓕 P ≤ usualAugmentation 𝓕' P := fun t => by
  rw [usualAugmentation_apply, usualAugmentation_apply]
  exact iInf₂_mono fun u _ => nullAugmented_mono h P u

/-- A set of the usual augmentation at time `s` is a.e. equal to a set of `𝓕_u` for every `u > s`. -/
theorem exists_ae_eq_of_measurableSet_usualAugmentation {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω}
    {s u : ℝ≥0} (hsu : s < u) {A : Set Ω} (hA : MeasurableSet[usualAugmentation 𝓕 P s] A) :
    ∃ A', MeasurableSet[𝓕 u] A' ∧ A =ᵐ[P] A' := by
  rw [usualAugmentation_apply] at hA
  have hA' : MeasurableSet[nullAugmented 𝓕 P u] A :=
    (iInf₂_le (κ := fun v => v > s) (f := fun v _ => nullAugmented 𝓕 P v) u hsu : _) A hA
  exact exists_ae_eq_of_measurableSet_nullAugmented hA'

/-! ### A Brownian motion of the usual augmentation -/

section Brownian

variable {𝓕 : Filtration ℝ≥0 mΩ} {P : Measure Ω} {B : ℝ≥0 → Ω → ℝ}

/-- Laws are preserved under almost sure limits: if `X_n → X` almost surely for two finite measures and the laws of
every `X_n` agree, then so do the laws of `X` (integrals of bounded continuous functions converge by dominated
convergence). -/
theorem map_eq_of_tendsto {μ ν : Measure Ω} [IsFiniteMeasure μ] [IsFiniteMeasure ν] {X : Ω → ℝ}
    {Xn : ℕ → Ω → ℝ} (hX : Measurable X) (hXn : ∀ n, Measurable (Xn n))
    (hμ : ∀ᵐ ω ∂μ, Tendsto (Xn · ω) atTop (𝓝 (X ω)))
    (hν : ∀ᵐ ω ∂ν, Tendsto (Xn · ω) atTop (𝓝 (X ω))) (h : ∀ n, μ.map (Xn n) = ν.map (Xn n)) :
    μ.map X = ν.map X := by
  refine ext_of_forall_integral_eq_of_IsFiniteMeasure fun g => ?_
  rw [integral_map hX.aemeasurable g.continuous.aestronglyMeasurable,
    integral_map hX.aemeasurable g.continuous.aestronglyMeasurable]
  have hlim : ∀ ρ : Measure Ω, IsFiniteMeasure ρ → (∀ᵐ ω ∂ρ, Tendsto (Xn · ω) atTop (𝓝 (X ω))) →
      Tendsto (fun n => ∫ ω, g (Xn n ω) ∂ρ) atTop (𝓝 (∫ ω, g (X ω) ∂ρ)) := fun ρ _ hρ =>
    tendsto_integral_of_dominated_convergence (fun _ => ‖g‖)
      (fun n => (g.continuous.measurable.comp (hXn n)).aestronglyMeasurable) (integrable_const _)
      (fun n => Eventually.of_forall fun ω => g.norm_coe_le_norm _)
      (hρ.mono fun ω hω => (g.continuous.tendsto _).comp hω)
  have heq : ∀ n, ∫ ω, g (Xn n ω) ∂μ = ∫ ω, g (Xn n ω) ∂ν := fun n => by
    rw [← integral_map (hXn n).aemeasurable g.continuous.aestronglyMeasurable, h n,
      integral_map (hXn n).aemeasurable g.continuous.aestronglyMeasurable]
  refine tendsto_nhds_unique (hlim μ inferInstance hμ) ?_
  simpa only [heq] using hlim ν inferInstance hν

/-- **The increments of an `𝓕`-Brownian motion are independent of the usual augmentation.** For `s < t` and
`A ∈ 𝓕⁺_s`, `A` is a.e. equal to a set of `𝓕_u` for each `u ∈ (s, t)`, so `B_t − B_u` is independent of `A`; letting
`u ↓ s` along a sequence, `B_t − B_u → B_t − B_s` almost surely, and the laws of `B_t − B_u` under `P(· ∩ A)` and
`P(A) P` pass to the limit (`map_eq_of_tendsto`). -/
theorem indep_incr_usualAugmentation (hB : IsFilteredBrownianReal 𝓕 B P) {s t : ℝ≥0} (hst : s ≤ t) :
    Indep (MeasurableSpace.comap (fun ω => B t ω - B s ω) inferInstance) (usualAugmentation 𝓕 P s) P := by
  have := hB.isProbabilityMeasure'
  rw [Indep_iff]
  rintro _ A ⟨S, hS, rfl⟩ hA
  have hAm : MeasurableSet A := (usualAugmentation 𝓕 P).le s _ hA
  rcases hst.eq_or_lt with rfl | hlt
  · by_cases h0 : (0 : ℝ) ∈ S
    · have : (fun ω => B s ω - B s ω) ⁻¹' S = univ := by ext ω; simp [h0]
      rw [this, univ_inter, measure_univ, one_mul]
    · have : (fun ω => B s ω - B s ω) ⁻¹' S = ∅ := by ext ω; simp [h0]
      rw [this, empty_inter, measure_empty, zero_mul]
  obtain ⟨u, -, hu, hlim⟩ := exists_seq_strictAnti_tendsto' hlt
  set X : Ω → ℝ := fun ω => B t ω - B s ω with hXdef
  set Xn : ℕ → Ω → ℝ := fun n ω => B t ω - B (u n) ω with hXndef
  have hXm : Measurable X := (hB.measurable' t).sub (hB.measurable' s)
  have hXnm : ∀ n, Measurable (Xn n) := fun n => (hB.measurable' t).sub (hB.measurable' (u n))
  set c : ℝ≥0 := (P A).toNNReal with hc
  have hcA : (c : ℝ≥0∞) = P A := ENNReal.coe_toNNReal (measure_ne_top P A)
  -- the laws agree at every approximating time
  have hmapn : ∀ n, (P.restrict A).map (Xn n) = (c • P).map (Xn n) := fun n => by
    ext S' hS'
    obtain ⟨A', hA', hAA'⟩ := exists_ae_eq_of_measurableSet_usualAugmentation (hu n).1 hA
    have hind := Indep_iff _ _ _ |>.1 (hB.2.2 (u n) t (hu n).2.le) (Xn n ⁻¹' S') A'
      ⟨S', hS', rfl⟩ hA'
    have hinter : (Xn n ⁻¹' S' ∩ A : Set Ω) =ᵐ[P] (Xn n ⁻¹' S' ∩ A' : Set Ω) := by
      filter_upwards [hAA'] with ω hω
      show (ω ∈ Xn n ⁻¹' S' ∧ ω ∈ A) = (ω ∈ Xn n ⁻¹' S' ∧ ω ∈ A')
      rw [hω]
    rw [Measure.map_apply (hXnm n) hS', Measure.map_apply (hXnm n) hS',
      Measure.restrict_apply (hXnm n hS'), Measure.smul_apply, measure_congr hinter,
      hind, ← measure_congr hAA', ENNReal.smul_def, smul_eq_mul, hcA, mul_comm]
  -- almost sure convergence
  have hconv : ∀ᵐ ω ∂P, Tendsto (Xn · ω) atTop (𝓝 (X ω)) := by
    filter_upwards [hB.1.cont] with ω hω
    exact tendsto_const_nhds.sub ((hω.tendsto s).comp hlim)
  have hm := map_eq_of_tendsto hXm hXnm (ae_restrict_of_ae hconv) (Measure.ae_smul_measure hconv c) hmapn
  have := congrArg (fun μ : Measure ℝ => μ S) hm
  simp only [Measure.map_apply hXm hS, Measure.restrict_apply (hXm hS), Measure.smul_apply,
    ENNReal.smul_def, smul_eq_mul, hcA] at this
  rw [this, mul_comm]

/-- **An `𝓕`-Brownian motion is a Brownian motion of the usual augmentation of `𝓕`.** -/
theorem isFilteredBrownianReal_usualAugmentation (hB : IsFilteredBrownianReal 𝓕 B P) :
    IsFilteredBrownianReal (usualAugmentation 𝓕 P) B P :=
  ⟨hB.1, fun t => (hB.2.1 t).mono (le_usualAugmentation 𝓕 P t) le_rfl,
    fun _ _ hst => indep_incr_usualAugmentation hB hst⟩

end Brownian

/-! ### The evolution and the driving filtration -/

section Evolution

variable {P : Measure Ω} {𝓕 : Filtration ℝ≥0 mΩ} {nL nR : ℕ} {κ : ℝ} {xL : Fin nL → ℝ}
  {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

/-- **An integrated `SLE_κ(ρ)` evolution on `𝓕` is one on the usual augmentation of `𝓕`.** -/
theorem isIntegratedSLEEvolution_usualAugmentation
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ) :
    IsIntegratedSLEEvolution κ xL xR ρL ρR P (usualAugmentation 𝓕 P) W VL VR B ζ :=
  ⟨isFilteredBrownianReal_usualAugmentation hE.1, adaptedBefore_mono (le_usualAugmentation 𝓕 P) hE.2.1,
    fun i => adaptedBefore_mono (le_usualAugmentation 𝓕 P) (hE.2.2.1 i),
    fun i => adaptedBefore_mono (le_usualAugmentation 𝓕 P) (hE.2.2.2.1 i), hE.2.2.2.2⟩

/-- The killed driving process generates a filtration smaller than any filtration in which its coordinates are
adapted before `ζ`. -/
theorem killedDrivingFiltration_le (hW : AdaptedBefore 𝓕 ζ W) (hVL : ∀ i, AdaptedBefore 𝓕 ζ (VL i))
    (hVR : ∀ i, AdaptedBefore 𝓕 ζ (VR i)) (hX : IsMeasurableKilledDriving W VL VR ζ) :
    killedDrivingFiltration hX ≤ 𝓕 := fun t => by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨r, hrt, A, hA, rfl⟩
  refine 𝓕.mono hrt _ ?_
  have hζ : MeasurableSet[𝓕 r] {ω | (r : ℝ≥0∞) < ζ ω} := by
    simpa using hW r univ MeasurableSet.univ
  have hg : Measurable[𝓕 r] fun ω => (Girsanov.killed ζ W r ω, fun i => Girsanov.killed ζ (VL i) r ω,
      fun i => Girsanov.killed ζ (VR i) r ω) :=
    (Girsanov.measurable_killed hW r).prodMk
      ((@Measurable.of_eval Ω (Fin nL) (fun _ => ℝ) (𝓕 r) _ _ fun i =>
          Girsanov.measurable_killed (hVL i) r).prodMk
        (@Measurable.of_eval Ω (Fin nR) (fun _ => ℝ) (𝓕 r) _ _ fun i =>
          Girsanov.measurable_killed (hVR i) r))
  have heq : {ω | (r : ℝ≥0∞) < ζ ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ A} =
      {ω | (r : ℝ≥0∞) < ζ ω} ∩ (fun ω => (Girsanov.killed ζ W r ω, fun i => Girsanov.killed ζ (VL i) r ω,
        fun i => Girsanov.killed ζ (VR i) r ω)) ⁻¹' A := by
    ext ω
    simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      simpa only [Girsanov.killed, h1, ↓reduceIte] using h2
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      simpa only [Girsanov.killed, h1, ↓reduceIte] using h2
  rw [heq]
  exact hζ.inter (hg hA)

/-- **The frozen driving filtration is smaller than the usual augmentation of the evolution's filtration.** -/
theorem drivingFiltration_le_usualAugmentation
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ)
    (hX : IsMeasurableKilledDriving W VL VR ζ) :
    drivingFiltration P hX ≤ usualAugmentation 𝓕 P :=
  usualAugmentation_mono (killedDrivingFiltration_le hE.2.1 hE.2.2.1 hE.2.2.2.1 hX) P

/-- A stopping time of the frozen driving filtration is a stopping time of the usual augmentation of the
evolution's filtration. -/
theorem isStoppingTime_usualAugmentation_of_drivingFiltration
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ)
    (hX : IsMeasurableKilledDriving W VL VR ζ) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime (drivingFiltration P hX) τ) : IsStoppingTime (usualAugmentation 𝓕 P) τ :=
  fun i => drivingFiltration_le_usualAugmentation hE hX i _ (hτ i)

/-- The σ-algebra of a stopping time grows with the filtration. -/
theorem measurableSpace_le_of_filtration_le {𝓖 𝓗 : Filtration ℝ≥0 mΩ} (h : 𝓖 ≤ 𝓗)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime 𝓖 τ) (hτ' : IsStoppingTime 𝓗 τ) :
    hτ.measurableSpace ≤ hτ'.measurableSpace := fun s hs =>
  ⟨(iSup_mono h : ⨆ t, 𝓖 t ≤ ⨆ t, 𝓗 t) s hs.1, fun i => h i _ (hs.2 i)⟩

/-- The σ-algebra `𝓕_τ` of a stopping time `τ` of the frozen driving filtration is contained in that of `τ` as a
stopping time of the usual augmentation of the evolution's filtration (so conditional expectations given the former
are obtained from those given the latter by the tower property). -/
theorem measurableSpace_drivingFiltration_le
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ)
    (hX : IsMeasurableKilledDriving W VL VR ζ) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime (drivingFiltration P hX) τ) :
    hτ.measurableSpace ≤ (isStoppingTime_usualAugmentation_of_drivingFiltration hE hX hτ).measurableSpace :=
  measurableSpace_le_of_filtration_le (drivingFiltration_le_usualAugmentation hE hX) hτ _

/-- **The lifetime is a stopping time** of every filtration in which a process is adapted before it. -/
theorem isStoppingTime_lifetime {X : ℝ≥0 → Ω → ℝ} (hX : AdaptedBefore 𝓕 ζ X) :
    IsStoppingTime 𝓕 fun ω => (ζ ω : WithTop ℝ≥0) := fun t => by
  have h := (hX t univ MeasurableSet.univ).compl
  convert h using 1
  ext ω
  simp only [mem_ofPred_eq, mem_compl_iff, mem_univ, and_true, not_lt]
  rfl

end Evolution

end Ito

end InteractingSLE
