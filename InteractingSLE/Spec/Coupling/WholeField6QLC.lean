import InteractingSLE.Spec.Coupling.WholeField5Freeze

/-!
# Quasi-left continuity of the driving filtration at announced stops

Packet PROVE-WHOLEFIELD6 (follow-up note C.4, `ig1_followup_proofs.txt` L1651–1704; R39 Aux. 48, "Lemma 7.4 shows
that this contains the complete stopped driving history through `σ_z`", `ig1_additional_proofs.txt` L3170–3175).

The pocket kernel of C.3 is computed given the announced pre-birth information `⋁ₙ Γ(𝓕_{ρₙ}, K_{ρₙ})`; C.4 needs it
given the history at the birth `β = lim ρₙ`. The two agree because the driving filtration is **quasi-left continuous**
at `β`: `𝓕_β ⊆ ⋁ₙ 𝓕_{ρₙ}` (every σ-algebra here contains the null sets). Proof:

* **generation from an announced base** (`iSup_driving_le_sup_restartCylSys_of_base`): for any σ-algebra `𝒜`
  containing the null sets, `T`, the state at `T`, and the before-`T` parts `E ∩ {r < T}` of the driving events,
  `⋁_t 𝓕_t ≤ 𝒜 ⊔ σ(restarted cylinders at T)` (the proof of `iSup_driving_le_sup_restartCylSys` with the split
  `{r < T}` / `{T ≤ r}`); for `𝒜 = ⋁ₙ 𝓕_{ρₙ}` the hypotheses follow from `ρₙ ↑ T` and path continuity before `ζ`;
* **the restart law (WF7)** gives `E[1_C | 𝓕_T] = restartLaw(V_T − W_T)`, an `𝒜`-measurable density, so
  `E[1_C | 𝓕_T] = E[1_C | 𝒜]` on the cylinders; the π-system freeze lemma `condExp_eq_of_le_sup_generateFrom` then
  gives `1_A = E[1_A | 𝓕_T] = E[1_A | 𝒜]` for `A ∈ 𝓕_T`.

## Main results

* `iSup_driving_le_sup_restartCylSys_of_base`;
* `measurable_of_ae_tendsto` (an a.e. limit is measurable for a σ-algebra with the null sets);
* **`stopping_le_iSup_of_tendsto`** (quasi-left continuity).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace WholeField

/-! ### Measurability of almost-everywhere limits -/

section Limits

/-- A pointwise `limUnder` of measurable real functions is measurable (for the instance σ-algebra). -/
theorem measurable_limUnder_nat {X : Type*} [MeasurableSpace X] {f : ℕ → X → ℝ}
    (hf : ∀ i, Measurable (f i)) : Measurable fun x => limUnder atTop (f · x) :=
  (StronglyMeasurable.limUnder fun i => (hf i).stronglyMeasurable).measurable

variable {Ω : Type*} {𝒜 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- An almost-everywhere limit of `𝒜`-measurable real functions is `𝒜`-measurable when `𝒜 ≤ mΩ` contains the null
sets (and the limit is `mΩ`-measurable). -/
theorem measurable_of_ae_tendsto (h𝒜 : 𝒜 ≤ mΩ)
    (hnull : ∀ N : Set Ω, MeasurableSet N → P N = 0 → MeasurableSet[𝒜] N) {f : ℕ → Ω → ℝ}
    (hf : ∀ n, Measurable[𝒜] (f n)) {g : Ω → ℝ} (hg : Measurable g)
    (hlim : ∀ᵐ ω ∂P, Tendsto (fun n => f n ω) atTop (𝓝 (g ω))) : Measurable[𝒜] g := by
  have hg' : Measurable[𝒜] fun ω => limUnder atTop (fun n => f n ω) :=
    @measurable_limUnder_nat Ω 𝒜 f hf
  intro U hU
  refine measurableSet_of_ae_eq h𝒜 hnull (hg hU) (hg' hU) ?_
  filter_upwards [hlim] with ω hω
  simp only [mem_preimage, hω.limUnder_eq]

end Limits

/-! ### The driving σ-algebra is generated by an announced base and the restarted cylinders -/

section Gen

universe u

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {Ω : Type u} {𝒜 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ}
  {ζ : Ω → ℝ≥0∞} {Bv : ℝ≥0 → Ω → ℝ} {T : Ω → ℝ≥0}

open Sec2 Sec2.Restart Sec2.Assembly

open scoped Classical in
/-- **Generation from a base σ-algebra.** Let `T` be a driving stop, `Bv` a continuous version of the noise and `G` a
measurable co-null set of good paths. If a σ-algebra `𝒜 ≤ mΩ` contains the null sets, makes `T` and the state at `T`
measurable, and contains the before-`T` part `E ∩ {r < T}` of every event `E ∈ 𝓕_r`, then
`⋁_t 𝓕_t ≤ 𝒜 ⊔ σ(G ∩ restarted cylinders)`. (For `𝒜 = 𝓕_T` this is `iSup_driving_le_sup_restartCylSys`.) -/
theorem iSup_driving_le_sup_restartCylSys_of_base (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    (hBvc : ∀ ω, Continuous fun t => Bv t ω) (hBvm : ∀ t, Measurable (Bv t))
    {G : Set Ω} (hGm : MeasurableSet G) (hGc : P Gᶜ = 0)
    (hG : ∀ ω ∈ G, IsIntegratedSLEPath κ xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω)
      (fun j t => VR j t ω) (fun t => B t ω) (ζ ω) ∧ (T ω : ℝ≥0∞) < ζ ω ∧ ∀ t, Bv t ω = B t ω)
    (h𝒜 : 𝒜 ≤ mΩ) (hnull𝒜 : ∀ N : Set Ω, MeasurableSet N → P N = 0 → MeasurableSet[𝒜] N)
    (hT𝒜 : Measurable[𝒜] T) (hW𝒜 : Measurable[𝒜] fun ω => progVersion ζ W (T ω) ω)
    (hVL𝒜 : ∀ i, Measurable[𝒜] fun ω => progVersion ζ (VL i) (T ω) ω)
    (hVR𝒜 : ∀ j, Measurable[𝒜] fun ω => progVersion ζ (VR j) (T ω) ω)
    (hbefore : ∀ (r : ℝ≥0) (E : Set Ω), MeasurableSet[drivingFiltration P hX r] E →
      MeasurableSet[𝒜] (E ∩ {ω | r < T ω})) :
    (⨆ t, drivingFiltration P hX t) ≤
      𝒜 ⊔ MeasurableSpace.generateFrom (restartCylSys W VL VR Bv ζ T G) := by
  set 𝒞 := restartCylSys W VL VR Bv ζ T G with h𝒞
  have hMle : (𝒜 ⊔ MeasurableSpace.generateFrom 𝒞) ≤ mΩ := sup_le h𝒜 (MeasurableSpace.generateFrom_le
    fun C hC => by
      rcases hC with rfl | ⟨n, ts, K, hK, rfl⟩
      · exact MeasurableSet.univ
      · exact hGm.inter (measurableSet_restartCyl hX hT hBvc hBvm n ts hK))
  have hTM : 𝒜 ≤ (𝒜 ⊔ MeasurableSpace.generateFrom 𝒞) := le_sup_left
  have h𝒞M : MeasurableSpace.generateFrom 𝒞 ≤ (𝒜 ⊔ MeasurableSpace.generateFrom 𝒞) := le_sup_right
  have hnullM : ∀ N : Set Ω, MeasurableSet N → P N = 0 →
      MeasurableSet[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] N :=
    fun N hN h0 => hTM _ (hnull𝒜 N hN h0)
  have hG𝒜 : MeasurableSet[𝒜] G := by
    have := (hnull𝒜 _ hGm.compl hGc).compl; rwa [compl_compl] at this
  have hGae : ∀ᵐ ω ∂P, ω ∈ G := by rw [ae_iff]; exact hGc
  have hTm' : Measurable T := hT𝒜.mono h𝒜 le_rfl
  -- the one-time cylinders
  have hcyl1 : ∀ (q : ℝ≥0) (U : Set (RState nL nR)), MeasurableSet U →
      MeasurableSet[MeasurableSpace.generateFrom 𝒞]
        (G ∩ {ω | (q : ℝ≥0∞) < ζ ω - T ω ∧ restartTuple W VL VR Bv ζ T q ω ∈ U}) := by
    intro q U hU
    rw [← restartCyl_one]
    exact MeasurableSpace.measurableSet_generateFrom
      (inter_restartCyl_mem 1 ![q] fun j => by fin_cases j; exact hU)
  -- the restarted state at `0` is known in the base
  have hR0 : Measurable[𝒜] (restartTuple W VL VR Bv ζ T 0) := by
    have e : restartTuple W VL VR Bv ζ T 0 = fun ω => ((0 : ℝ),
        fun i => progVersion ζ (VL i) (T ω) ω - progVersion ζ W (T ω) ω,
        fun j => progVersion ζ (VR j) (T ω) ω - progVersion ζ W (T ω) ω, (0 : ℝ)) := by
      funext ω; simp only [restartTuple, add_zero, sub_self]
    rw [e]
    exact measurable_const.prodMk (((measurable_pi_iff' _).2 fun i => (hVL𝒜 i).sub hW𝒜).prodMk
      (((measurable_pi_iff' _).2 fun j => (hVR𝒜 j).sub hW𝒜).prodMk measurable_const))
  -- the dyadic codes of the restarted coordinates
  set code : (RState nL nR → ℝ) → Ω → PCode := fun φ ω =>
    killedCode (fun q ω' => if ω' ∈ G then φ (restartTuple W VL VR Bv ζ T q ω') else 0)
      (φ (restartTuple W VL VR Bv ζ T 0 ω)) (fun ω' => ζ ω' - T ω') ω with hcode
  have hcodeM : ∀ φ : RState nL nR → ℝ, Continuous φ →
      Measurable[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] (code φ) := by
    intro φ hφ
    rw [measurable_pi_iff' _]; intro n
    rw [measurable_pi_iff' _]; intro k
    by_cases hd : dyad n k = 0
    · have e : (fun ω => code φ ω n k) = fun ω => φ (restartTuple W VL VR Bv ζ T 0 ω) := by
        funext ω; simp only [hcode, killedCode, hd, ↓reduceIte]
      rw [e]
      exact (hφ.measurable.comp hR0).mono hTM le_rfl
    · have e : (fun ω => code φ ω n k) = fun ω => if ((dyad n k : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω then
          (if ω ∈ G then φ (restartTuple W VL VR Bv ζ T (dyad n k) ω) else 0) else 0 := by
        funext ω; simp only [hcode, killedCode, hd, ↓reduceIte]
      rw [e]
      intro U hU
      have h1 := hcyl1 (dyad n k) (φ ⁻¹' U) (hφ.measurable hU)
      have h2 := hcyl1 (dyad n k) univ MeasurableSet.univ
      have e2 : (fun ω => if ((dyad n k : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω then
          (if ω ∈ G then φ (restartTuple W VL VR Bv ζ T (dyad n k) ω) else 0) else 0) ⁻¹' U =
          (G ∩ {ω | ((dyad n k : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω ∧
            restartTuple W VL VR Bv ζ T (dyad n k) ω ∈ φ ⁻¹' U}) ∪
          (if (0 : ℝ) ∈ U then (G ∩ {ω | ((dyad n k : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω ∧
            restartTuple W VL VR Bv ζ T (dyad n k) ω ∈ (univ : Set (RState nL nR))})ᶜ else ∅) := by
        ext ω
        by_cases hq : ((dyad n k : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω <;> by_cases hω : ω ∈ G <;>
          by_cases h0 : (0 : ℝ) ∈ U <;> simp [hq, hω, h0]
      rw [e2]
      refine h𝒞M _ (h1.union ?_)
      split_ifs
      · exact h2.compl
      · exact @MeasurableSet.empty _ (MeasurableSpace.generateFrom 𝒞)
  have hdec : ∀ φ : RState nL nR → ℝ, Continuous φ → ∀ ω ∈ G, ∀ s : ℝ≥0, (s : ℝ≥0∞) < ζ ω - T ω →
      dec (code φ ω) s = φ (restartTuple W VL VR Bv ζ T s ω) := by
    intro φ hφ ω hω s hs
    obtain ⟨hp, hTζ, hBv⟩ := hG ω hω
    have hc : ContinuousOn (fun q => (fun q ω' => if ω' ∈ G then φ (restartTuple W VL VR Bv ζ T q ω')
        else 0) q ω) {t : ℝ≥0 | (t : ℝ≥0∞) < ζ ω - T ω} := by
      simp only [hω, ↓reduceIte]
      exact hφ.comp_continuousOn (continuousOn_restartTuple hp hTζ hBv (hBvc ω))
    have := dec_killedCode (X := fun q ω' => if ω' ∈ G then φ (restartTuple W VL VR Bv ζ T q ω') else 0)
      (x₀ := φ (restartTuple W VL VR Bv ζ T 0 ω)) (ζ := fun ω' => ζ ω' - T ω') (ω := ω)
      (by simp only [hω, ↓reduceIte]) hc hs
    simpa only [hω, ↓reduceIte] using this
  -- the decoded driving state at `r`
  refine iSup_le fun t => ?_
  have hD : drivingFiltration P hX t ≤ killedDrivingFiltration hX (t + 1) ⊔ Ito.nullSets P := by
    show usualAugmentation (killedDrivingFiltration hX) P t ≤ _
    rw [Ito.usualAugmentation_apply]
    exact (iInf₂_le (t + 1) (lt_add_one t)).trans (le_of_eq (Ito.nullAugmented_apply _ _ _))
  refine hD.trans (sup_le ?_ (MeasurableSpace.generateFrom_le fun N hN => hnullM N hN.1 hN.2))
  show killedDrivingSigma W VL VR ζ (t + 1) ≤ (𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨r, -, A', hA', rfl⟩
  set E := {ω | (r : ℝ≥0∞) < ζ ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ A'} with hE
  have hEd : MeasurableSet[drivingFiltration P hX r] E := Ito.le_usualAugmentation _ _ r _
    (MeasurableSpace.measurableSet_generateFrom ⟨r, le_rfl, A', hA', rfl⟩)
  have hEm : MeasurableSet E := (drivingFiltration P hX).le r _ hEd
  -- before `T`
  have hE1 : MeasurableSet[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] (E ∩ {ω | r < T ω}) :=
    hTM _ (hbefore r E hEd)
  -- after `T`
  set s : Ω → ℝ≥0 := fun ω => r - T ω with hs
  have hsM : Measurable[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] s :=
    (measurable_const.sub hT𝒜).mono hTM le_rfl
  set Wp : Ω → ℝ := fun ω => progVersion ζ W (T ω) ω with hWp
  have hWpM : Measurable[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] Wp := hW𝒜.mono hTM le_rfl
  have hdecM : ∀ φ : RState nL nR → ℝ, Continuous φ →
      Measurable[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] fun ω => dec (code φ ω) (s ω) :=
    fun φ hφ => measurable_dec.comp ((hcodeM φ hφ).prodMk hsM)
  have cL : ∀ i, Continuous fun x : RState nL nR => x.2.1 i := fun i =>
    (continuous_apply i).comp (continuous_fst.comp continuous_snd)
  have cR : ∀ j, Continuous fun x : RState nL nR => x.2.2.1 j := fun j =>
    (continuous_apply j).comp (continuous_fst.comp (continuous_snd.comp continuous_snd))
  set Φ : Ω → ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) := fun ω =>
    (Wp ω + dec (code (fun x => x.1) ω) (s ω), fun i => Wp ω + dec (code (fun x => x.2.1 i) ω) (s ω),
      fun j => Wp ω + dec (code (fun x => x.2.2.1 j) ω) (s ω)) with hΦ
  have hΦM : Measurable[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] Φ :=
    (hWpM.add (hdecM _ continuous_fst)).prodMk (((measurable_pi_iff' _).2 fun i =>
      hWpM.add (hdecM _ (cL i))).prodMk ((measurable_pi_iff' _).2 fun j => hWpM.add (hdecM _ (cR j))))
  set Aliv : Set Ω := ⋃ q : ℚ, {ω | ((s ω : ℝ≥0) : ℝ≥0∞) < ((Real.toNNReal q : ℝ≥0) : ℝ≥0∞)} ∩
    (G ∩ {ω | ((Real.toNNReal q : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω ∧
      restartTuple W VL VR Bv ζ T (Real.toNNReal q) ω ∈ (univ : Set (RState nL nR))}) with hAliv
  have hAlivM : MeasurableSet[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] Aliv := MeasurableSet.iUnion fun q =>
    (measurableSet_lt (measurable_coe_nnreal_ennreal.comp hsM) measurable_const).inter
      (h𝒞M _ (hcyl1 _ univ MeasurableSet.univ))
  set S : Set Ω := G ∩ {ω | T ω ≤ r} ∩ Aliv ∩ Φ ⁻¹' A' with hSdef
  have hSM : MeasurableSet[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] S :=
    (((hTM _ hG𝒜).inter (hTM _ (measurableSet_le hT𝒜 measurable_const))).inter hAlivM).inter (hΦM hA')
  have hES : ∀ ω ∈ G, (ω ∈ E ∧ T ω ≤ r) ↔ ω ∈ S := by
    intro ω hω
    obtain ⟨hp, hTζ, hBv⟩ := hG ω hω
    have hsr : ∀ hTr : T ω ≤ r, ((s ω : ℝ≥0) : ℝ≥0∞) + T ω = r := fun hTr => by
      rw [← ENNReal.coe_add, hs, tsub_add_cancel_of_le hTr]
    have halive : T ω ≤ r → ((r : ℝ≥0∞) < ζ ω ↔ ω ∈ Aliv) := by
      intro hTr
      constructor
      · intro hr
        have hlt : ((s ω : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω := lt_tsub_iff_right.2 ((hsr hTr).symm ▸ hr)
        obtain ⟨q, -, h1, h2⟩ := ENNReal.lt_iff_exists_rat_btwn.1 hlt
        exact mem_iUnion.2 ⟨q, h1, hω, h2, mem_univ _⟩
      · intro hA
        obtain ⟨q, h1, -, h2, -⟩ := mem_iUnion.1 hA
        have := lt_tsub_iff_right.1 (h1.trans h2)
        rwa [hsr hTr] at this
    have hΦeq : T ω ≤ r → (r : ℝ≥0∞) < ζ ω → Φ ω = (W r ω, fun i => VL i r ω, fun j => VR j r ω) := by
      intro hTr hr
      have hlt : ((s ω : ℝ≥0) : ℝ≥0∞) < ζ ω - T ω := lt_tsub_iff_right.2 ((hsr hTr).symm ▸ hr)
      have hTs : T ω + s ω = r := add_tsub_cancel_of_le hTr
      have hraw := restartTuple_eq_raw hp hTζ hBv hlt
      obtain ⟨b1, -, -⟩ := restart_values hp hTζ
      simp only [hΦ, hdec _ continuous_fst ω hω _ hlt, hdec _ (cL _) ω hω _ hlt, hdec _ (cR _) ω hω _ hlt,
        hraw, hWp, b1, hTs, add_sub_cancel]
    constructor
    · rintro ⟨⟨hr, hX'⟩, hTr⟩
      refine ⟨⟨⟨hω, hTr⟩, (halive hTr).1 hr⟩, ?_⟩
      show Φ ω ∈ A'
      rw [hΦeq hTr hr]; exact hX'
    · rintro ⟨⟨⟨-, hTr⟩, hA⟩, hΦA⟩
      have hr := (halive hTr).2 hA
      have hΦA' : Φ ω ∈ A' := hΦA
      rw [hΦeq hTr hr] at hΦA'
      exact ⟨⟨hr, hΦA'⟩, hTr⟩
  have hE2 : MeasurableSet[(𝒜 ⊔ MeasurableSpace.generateFrom 𝒞)] (E ∩ {ω | T ω ≤ r}) := by
    refine measurableSet_of_ae_eq hMle hnullM (hEm.inter (measurableSet_le hTm' measurable_const)) hSM ?_
    filter_upwards [hGae] with ω hω
    exact propext (hES ω hω)
  have e : E = (E ∩ {ω | r < T ω}) ∪ (E ∩ {ω | T ω ≤ r}) := by
    ext ω
    simp only [mem_union, mem_inter_iff, mem_ofPred_eq]
    constructor
    · intro h
      rcases lt_or_ge r (T ω) with h' | h'
      · exact Or.inl ⟨h, h'⟩
      · exact Or.inr ⟨h, h'⟩
    · rintro (h | h) <;> exact h.1
  rw [e]
  exact hE1.union hE2

end Gen

/-! ### Quasi-left continuity at announced stops -/

section Coupling

universe u

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {Ω : Type u} {𝒜 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
  {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}

open Sec2 Sec2.Restart Sec2.Assembly LQGMetric QuantumZipper

omit [IsProbabilityMeasure P] in
/-- A stopping σ-algebra lies in the terminal driving σ-algebra. -/
theorem stopping_le_iSup_driving (hX : IsMeasurableKilledDriving W VL VR ζ) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime (drivingFiltration P hX) τ) :
    hτ.measurableSpace ≤ ⨆ t, drivingFiltration P hX t := fun _ hA => hA.1

omit [IsProbabilityMeasure P] in
/-- The real value of a real-valued stop is measurable for its own stopping σ-algebra. -/
theorem measurable_stop_coe {𝓖 : Filtration ℝ≥0 mΩ} {T : Ω → ℝ≥0}
    (hT : IsStoppingTime 𝓖 fun ω => (T ω : WithTop ℝ≥0)) : Measurable[hT.measurableSpace] T := by
  have := (WithTop.measurable_untopD (0 : ℝ≥0)).comp hT.measurable
  simpa only [Function.comp_def, WithTop.untopD_coe] using this

/-- **The stopping σ-algebra lies in any base generating with the restarted cylinders.** For the frozen coupling, a
driving stop `T < ζ` (positive, or a separated word) and a σ-algebra `𝒜 ≤ 𝓕_T` with the null sets, measurable `T`
and state at `T`, and the before-`T` parts of the driving events: `𝓕_T ≤ 𝒜`. (The restart law (WF7) makes
`E[1_C | 𝓕_T]` an `𝒜`-measurable function on the restarted cylinders; the π-system freeze lemma gives
`1_A = E[1_A | 𝓕_T] = E[1_A | 𝒜]` for `A ∈ 𝓕_T`.) -/
theorem stopping_le_of_base (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hκ : 0 < κ) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR) (forceJumpSet xL xR) u₀)
    (hX : IsMeasurableKilledDriving W VL VR ζ) {T : Ω → ℝ≥0}
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    (hTζ : ∀ᵐ ω ∂P, (T ω : ℝ≥0∞) < ζ ω) (hT0 : ∀ᵐ ω ∂P, 0 < T ω ∨ ∀ i j, xL i < xR j)
    (h𝒜 : 𝒜 ≤ mΩ) (hnull𝒜 : ∀ N : Set Ω, MeasurableSet N → P N = 0 → MeasurableSet[𝒜] N)
    (h𝒜T : 𝒜 ≤ hT.measurableSpace) (hT𝒜 : Measurable[𝒜] T)
    (hstate : ∀ X : ℝ≥0 → Ω → ℝ, AdaptedBefore (drivingFiltration P hX) ζ X →
      (∀ᵐ ω ∂P, ContinuousOn (fun s => X s ω) {s | (s : ℝ≥0∞) < ζ ω}) →
      Measurable[𝒜] fun ω => progVersion ζ X (T ω) ω)
    (hbefore : ∀ (r : ℝ≥0) (E : Set Ω), MeasurableSet[drivingFiltration P hX r] E →
      MeasurableSet[𝒜] (E ∩ {ω | r < T ω})) :
    hT.measurableSpace ≤ 𝒜 := by
  have hE := hC.1
  -- a continuous version of the noise and the good paths
  obtain ⟨Bv, hBvm, hBvc, -, -, hBvae⟩ := QuantumZipper.RS.exists_good_version0 hE.1.1
  set good : Ω → Prop := fun ω => IsIntegratedSLEPath κ xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω)
    (fun j t => VR j t ω) (fun t => B t ω) (ζ ω) ∧ (T ω : ℝ≥0∞) < ζ ω ∧ ∀ t, Bv t ω = B t ω with hgood
  have hae : ∀ᵐ ω ∂P, good ω := by
    filter_upwards [hE.2.2.2.2, hTζ, hBvae] with ω h1 h2 h3 using ⟨h1, h2, h3⟩
  obtain ⟨G, hGm, hGc, hGgood⟩ : ∃ G : Set Ω, MeasurableSet G ∧ P Gᶜ = 0 ∧ ∀ ω ∈ G, good ω := by
    refine ⟨(toMeasurable P {ω | ¬ good ω})ᶜ, (measurableSet_toMeasurable _ _).compl, ?_,
      fun ω hω => ?_⟩
    · rw [compl_compl, measure_toMeasurable]; exact ae_iff.1 hae
    · by_contra h'; exact hω (subset_toMeasurable _ _ h')
  have hGae : ∀ᵐ ω ∂P, ω ∈ G := by rw [ae_iff]; exact hGc
  have hW𝒜 := hstate W (Ito.adaptedBefore_mono (Ito.le_usualAugmentation _ _)
    (Coupling.adaptedBefore_killedDriving_W hX)) (hE.2.2.2.2.mono fun ω hp => hp.isForcePath.continuousOn_w)
  have hVL𝒜 := fun i => hstate (VL i) (Ito.adaptedBefore_mono (Ito.le_usualAugmentation _ _)
    (Coupling.adaptedBefore_killedDriving_VL hX i))
    (hE.2.2.2.2.mono fun ω hp => hp.isForcePath.continuousOn_vL i)
  have hVR𝒜 := fun j => hstate (VR j) (Ito.adaptedBefore_mono (Ito.le_usualAugmentation _ _)
    (Coupling.adaptedBefore_killedDriving_VR hX j))
    (hE.2.2.2.2.mono fun ω hp => hp.isForcePath.continuousOn_vR j)
  have hgen := iSup_driving_le_sup_restartCylSys_of_base hX hT hBvc hBvm hGm hGc hGgood h𝒜 hnull𝒜 hT𝒜
    hW𝒜 hVL𝒜 hVR𝒜 hbefore
  -- the restart law on the cylinders
  have h𝒞m : ∀ C ∈ restartCylSys W VL VR Bv ζ T G, MeasurableSet C := by
    rintro C (rfl | ⟨n, ts, K, hK, rfl⟩)
    · exact MeasurableSet.univ
    · exact hGm.inter (measurableSet_restartCyl hX hT hBvc hBvm n ts hK)
  have hker := hC.2.2.2.choose_spec
  obtain ⟨AT, hATm, hATe, -⟩ := IsLocalSet.exists_measurable_version
    ((hker _ hT (hTζ.mono fun ω hω => hω)).1) hC.2.1
  have hATK : ∀ᵐ ω ∂P, AT ω = fwdHull (fun s : ℝ => W s.toNNReal ω) (T ω : ℝ) := by
    filter_upwards [hATe] with ω hω
    rw [hω, WithTop.untopD_coe]
  have hle : hT.measurableSpace ≤ histGerm hT.measurableSpace AT (centredField h u₀) := le_histGerm _ _
  have hlaw : ∀ C ∈ restartCylSys W VL VR Bv ζ T G, P[C.indicator (fun _ => (1 : ℝ)) | hT.measurableSpace]
      =ᵐ[P] P[C.indicator (fun _ => (1 : ℝ)) | 𝒜] := by
    rintro C (rfl | ⟨n, ts, K, hK, rfl⟩)
    · simp only [indicator_univ]
      rw [condExp_const hT.measurableSpace_le, condExp_const h𝒜]
    · obtain ⟨g, -, hgae, hgA⟩ := exists_restart_germ hC hκ hu₀ hX hT hTζ hT0 hATm hATK ts hK
      set g' : Ω → ℝ≥0∞ := fun ω => restartLaw κ ρL ρR ts K
        ((fun i => progVersion ζ (VL i) (T ω) ω - progVersion ζ W (T ω) ω),
          fun j => progVersion ζ (VR j) (T ω) ω - progVersion ζ W (T ω) ω) with hg'
      have hg'm : Measurable[𝒜] g' :=
        (measurable_restartLaw ts hK).comp (((measurable_pi_iff' _).2 fun i => (hVL𝒜 i).sub hW𝒜).prodMk
          ((measurable_pi_iff' _).2 fun j => (hVR𝒜 j).sub hW𝒜))
      have hgg' : g =ᵐ[P] g' := by
        filter_upwards [hgae, hGae] with ω h1 hω
        obtain ⟨hp, hTζω, -⟩ := hGgood ω hω
        obtain ⟨b1, b2, b3⟩ := restart_values hp hTζω
        rw [h1, hg']
        simp only [b1, b2, b3]
      have hEm : MeasurableSet (G ∩ restartCyl W VL VR Bv ζ T n ts K) :=
        h𝒞m _ (inter_restartCyl_mem n ts hK)
      have hid : ∀ A, MeasurableSet[hT.measurableSpace] A →
          P (A ∩ (G ∩ restartCyl W VL VR Bv ζ T n ts K)) = ∫⁻ ω in A, g' ω ∂P := by
        intro A hA
        rw [← lintegral_congr_ae (ae_restrict_of_ae hgg'), ← hgA A (hle A hA)]
        refine measure_congr ?_
        filter_upwards [hGae] with ω hω
        obtain ⟨hp, hTζω, hBv⟩ := hGgood ω hω
        apply propext
        simp only [mem_inter_iff, restartCyl, mem_ofPred_eq, hω, true_and]
        refine and_congr_right fun _ => forall_congr' fun j => and_congr_right fun hlt => ?_
        rw [restartTuple_eq_raw hp hTζω hBv hlt]
      exact (condExp_indicator_eq_toReal hT.measurableSpace_le hEm (hg'm.mono h𝒜T le_rfl) hid).trans
        (condExp_indicator_eq_toReal h𝒜 hEm hg'm fun A hA => hid A (h𝒜T A hA)).symm
  -- the freeze lemma with `Y = 1_A`
  intro A hA
  have hAm : MeasurableSet A := hT.measurableSpace_le _ hA
  have hY : StronglyMeasurable[hT.measurableSpace] (A.indicator fun _ => (1 : ℝ)) :=
    stronglyMeasurable_const.indicator hA
  have hfr := condExp_eq_of_le_sup_generateFrom (μ := P) h𝒜T hT.measurableSpace_le h𝒜T
    ((stopping_le_iSup_driving hX hT).trans hgen) isPiSystem_restartCylSys univ_mem_restartCylSys h𝒞m hY
    (c := 1) (Eventually.of_forall fun ω => by
      by_cases hω : ω ∈ A <;> simp [indicator_of_mem, indicator_of_notMem, hω]) hlaw
  rw [condExp_of_stronglyMeasurable hT.measurableSpace_le hY
    ((integrable_const (1 : ℝ)).indicator hAm)] at hfr
  have hfm : Measurable[𝒜] (P[A.indicator (fun _ => (1 : ℝ)) | 𝒜]) := stronglyMeasurable_condExp.measurable
  refine measurableSet_of_ae_eq h𝒜 hnull𝒜 hAm (hfm (measurableSet_singleton (1 : ℝ))) ?_
  filter_upwards [hfr] with ω hω
  apply propext
  simp only [mem_preimage, mem_singleton_iff, ← hω]
  by_cases h' : ω ∈ A <;> simp [h']

/-- **Quasi-left continuity of the driving filtration** (C.4; R39 Aux. 48: the announced pre-birth information
"contains the complete stopped driving history through `σ_z`"). For the frozen coupling, a driving stop `T < ζ`
(positive, or a separated word) and driving stops `ρₙ ≤ T` converging to `T` almost surely: `𝓕_T ≤ ⋁ₙ 𝓕_{ρₙ}`. -/
theorem stopping_le_iSup_of_tendsto (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hκ : 0 < κ) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR) (forceJumpSet xL xR) u₀)
    (hX : IsMeasurableKilledDriving W VL VR ζ) {T : Ω → ℝ≥0}
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    (hTζ : ∀ᵐ ω ∂P, (T ω : ℝ≥0∞) < ζ ω) (hT0 : ∀ᵐ ω ∂P, 0 < T ω ∨ ∀ i j, xL i < xR j)
    {ρ : ℕ → Ω → ℝ≥0} (hρ : ∀ n, IsStoppingTime (drivingFiltration P hX) fun ω => (ρ n ω : WithTop ℝ≥0))
    (hρT : ∀ n ω, ρ n ω ≤ T ω) (hρlim : ∀ᵐ ω ∂P, Tendsto (fun n => ρ n ω) atTop (𝓝 (T ω))) :
    hT.measurableSpace ≤ ⨆ n, (hρ n).measurableSpace := by
  have h𝒜 : (⨆ n, (hρ n).measurableSpace) ≤ mΩ := iSup_le fun n => (hρ n).measurableSpace_le
  have hle𝒜 : ∀ n, (hρ n).measurableSpace ≤ ⨆ n, (hρ n).measurableSpace := fun n =>
    le_iSup (fun n => (hρ n).measurableSpace) n
  have hnull𝒜 : ∀ N : Set Ω, MeasurableSet N → P N = 0 → MeasurableSet[⨆ n, (hρ n).measurableSpace] N :=
    fun N hN h0 => hle𝒜 0 _ (measurableSet_stopping_driving_of_null hX (hρ 0) hN h0)
  have h𝒜T : (⨆ n, (hρ n).measurableSpace) ≤ hT.measurableSpace := iSup_le fun n =>
    IsStoppingTime.measurableSpace_mono (hρ n) hT fun ω => WithTop.coe_le_coe.2 (hρT n ω)
  have hρm : ∀ n, Measurable[⨆ n, (hρ n).measurableSpace] (fun ω => (ρ n ω : ℝ)) := fun n =>
    (measurable_coe_nnreal_real.comp (measurable_stop_coe (hρ n))).mono (hle𝒜 n) le_rfl
  have hTr : Measurable[⨆ n, (hρ n).measurableSpace] (fun ω => (T ω : ℝ)) :=
    measurable_of_ae_tendsto h𝒜 hnull𝒜 hρm
      (measurable_coe_nnreal_real.comp ((measurable_stop_coe hT).mono hT.measurableSpace_le le_rfl))
      (hρlim.mono fun ω hω => NNReal.tendsto_coe.2 hω)
  have hT𝒜 : Measurable[⨆ n, (hρ n).measurableSpace] T := by
    have := hTr.real_toNNReal
    simpa only [Real.toNNReal_coe] using this
  refine stopping_le_of_base hC hκ hu₀ hX hT hTζ hT0 h𝒜 hnull𝒜 h𝒜T hT𝒜 ?_ ?_
  · -- the state at `T` is the limit of the states at `ρₙ`
    intro X hXa hXc
    refine measurable_of_ae_tendsto h𝒜 hnull𝒜 (f := fun n ω => progVersion ζ X (ρ n ω) ω)
      (fun n => (measurable_eval_stop (isStronglyProgressive_progVersion hXa) (hρ n)).mono (hle𝒜 n) le_rfl)
      ((measurable_eval_stop (isStronglyProgressive_progVersion hXa) hT).mono hT.measurableSpace_le le_rfl)
      ?_
    filter_upwards [hXc, hρlim, hTζ] with ω hc hlim hTζ'
    have hρζ : ∀ n, (ρ n ω : ℝ≥0∞) < ζ ω := fun n =>
      lt_of_le_of_lt (ENNReal.coe_le_coe.2 (hρT n ω)) hTζ'
    simp only [progVersion_eq hc (hρζ _), progVersion_eq hc hTζ']
    have hO : {s : ℝ≥0 | (s : ℝ≥0∞) < ζ ω} ∈ 𝓝 (T ω) :=
      (isOpen_lt ENNReal.continuous_coe continuous_const).mem_nhds hTζ'
    exact (hc.continuousAt hO).tendsto.comp hlim
  · -- the before-`T` parts of driving events are announced
    intro r E hE
    have hc := isStoppingTime_const (drivingFiltration P hX) r
    have hn : ∀ n, MeasurableSet[⨆ n, (hρ n).measurableSpace]
        (E ∩ {ω | ((r : ℝ≥0) : WithTop ℝ≥0) ≤ (ρ n ω : WithTop ℝ≥0)}) := by
      intro n
      have := IsStoppingTime.measurableSet_inter_le hc (hρ n) E
        (by rw [IsStoppingTime.measurableSpace_const]; exact hE)
      exact hle𝒜 n _ (IsStoppingTime.measurableSpace_mono (hc.min (hρ n)) (hρ n)
        (fun ω => min_le_right _ _) _ this)
    have hlt : MeasurableSet[⨆ n, (hρ n).measurableSpace] {ω | r < T ω} :=
      measurableSet_lt measurable_const hT𝒜
    have hEm : MeasurableSet E := (drivingFiltration P hX).le r _ hE
    refine measurableSet_of_ae_eq h𝒜 hnull𝒜
      (hEm.inter (measurableSet_lt measurable_const ((measurable_stop_coe hT).mono
        hT.measurableSpace_le le_rfl)))
      ((MeasurableSet.iUnion hn).inter hlt) ?_
    filter_upwards [hρlim] with ω hω
    apply propext
    simp only [mem_inter_iff, mem_iUnion, mem_ofPred_eq, WithTop.coe_le_coe]
    constructor
    · rintro ⟨hEω, hrT⟩
      obtain ⟨n, hn⟩ := (hω.eventually (lt_mem_nhds hrT)).exists
      exact ⟨⟨n, hEω, hn.le⟩, hrT⟩
    · rintro ⟨⟨n, hEω, -⟩, hrT⟩
      exact ⟨hEω, hrT⟩

