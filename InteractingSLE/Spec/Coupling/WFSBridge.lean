import InteractingSLE.Spec.Coupling.CouplingThrough
import InteractingSLE.Spec.Ito.FiltrationBasic

/-!
# Stopping times before the WFS cutoff

The full driving filtration is only observed through the killed-at-`V` filtration before `V`. This file proves
that a full-filtration stopping time which is almost surely strictly before `V` is a stopping time of that
killed-at-`V` filtration.
-/

set_option autoImplicit false

noncomputable section

open Filter MeasureTheory ProbabilityTheory Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace WFS

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- Restricting an event generated by the driving killed at `ζ` to `{q < V}` makes it measurable
for the driving killed at `V`, provided `V ≤ ζ`. -/
theorem measurableSet_killedDrivingSigma_inter_lt
    {nL nR : ℕ} {W : ℝ≥0 → Ω → ℝ}
    {VL : Fin nL → ℝ≥0 → Ω → ℝ}
    {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ V : Ω → ℝ≥0∞} {q : ℝ≥0}
    (hVζ : ∀ ω, V ω ≤ ζ ω) {A : Set Ω}
    (hA : MeasurableSet[killedDrivingSigma W VL VR ζ q] A) :
    MeasurableSet[killedDrivingSigma W VL VR V q]
      (A ∩ {ω | (q : ℝ≥0∞) < V ω}) := by
  let C : Set (Set Ω) :=
    {E | ∃ r ≤ q, ∃ B : Set (ℝ × (Fin nL → ℝ) × (Fin nR → ℝ)), MeasurableSet B ∧
      E = {ω | (r : ℝ≥0∞) < ζ ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ B}}
  change MeasurableSet[MeasurableSpace.generateFrom C] A at hA
  refine MeasurableSpace.generateFrom_induction C
    (fun E _ => MeasurableSet[killedDrivingSigma W VL VR V q]
      (E ∩ {ω | (q : ℝ≥0∞) < V ω})) ?_ ?_ ?_ ?_ A hA
  · rintro E ⟨r, hrq, B, hB, rfl⟩ _
    have hq : MeasurableSet[killedDrivingSigma W VL VR V q]
        {ω | (q : ℝ≥0∞) < V ω} := by
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨q, le_rfl, Set.univ, MeasurableSet.univ, by ext ω; simp⟩
    have hgen : MeasurableSet[killedDrivingSigma W VL VR V q]
        {ω | (r : ℝ≥0∞) < V ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ B} := by
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨r, hrq, B, hB, rfl⟩
    have heq :
        {ω | (r : ℝ≥0∞) < ζ ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ B} ∩
            {ω | (q : ℝ≥0∞) < V ω} =
          {ω | (r : ℝ≥0∞) < V ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ B} ∩
            {ω | (q : ℝ≥0∞) < V ω} := by
      ext ω
      simp only [mem_inter_iff, mem_setOf_eq]
      constructor
      · rintro ⟨⟨_, hdata⟩, hqV⟩
        exact ⟨⟨lt_of_le_of_lt (by exact_mod_cast hrq) hqV, hdata⟩, hqV⟩
      · rintro ⟨⟨hrV, hdata⟩, hqV⟩
        exact ⟨⟨lt_of_lt_of_le hrV (hVζ ω), hdata⟩, hqV⟩
    rw [heq]
    exact hgen.inter hq
  · simp
  · intro E hE hEI
    have hq : MeasurableSet[killedDrivingSigma W VL VR V q]
        {ω | (q : ℝ≥0∞) < V ω} := by
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨q, le_rfl, Set.univ, MeasurableSet.univ, by ext ω; simp⟩
    have heq : Eᶜ ∩ {ω | (q : ℝ≥0∞) < V ω} =
        {ω | (q : ℝ≥0∞) < V ω} \ (E ∩ {ω | (q : ℝ≥0∞) < V ω}) := by
      ext ω
      simp only [mem_inter_iff, mem_setOf_eq, mem_diff, mem_compl_iff]
      tauto
    rw [heq]
    exact hq.diff hEI
  · intro f hf hfI
    rw [iUnion_inter]
    exact MeasurableSet.iUnion hfI

/-- **A full-filtration stopping time strictly before `V` is a stopping time of the killed-at-`V`
driving filtration.** The proof uses right-continuity to pass from events at times decreasing to the
target time, while restricting the full killed history to the interval before `V`. -/
theorem isStoppingTime_drivingFiltration_of_lt
    {nL nR : ℕ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
    {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ V : Ω → ℝ≥0∞} {P : Measure Ω}
    (hXζ : IsMeasurableKilledDriving W VL VR ζ) (hXV : IsMeasurableKilledDriving W VL VR V)
    (hVζ : ∀ ω, V ω ≤ ζ ω) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime (drivingFiltration P hXζ) τ)
    (hτV : ∀ᵐ ω ∂P, (τ ω : ℝ≥0∞) < V ω) :
    IsStoppingTime (drivingFiltration P hXV) τ := by
  intro t
  let A : Set Ω := {ω | τ ω ≤ (t : WithTop ℝ≥0)}
  have hA : MeasurableSet[usualAugmentation (killedDrivingFiltration hXζ) P t] A := hτ t
  have hAm : MeasurableSet A := (usualAugmentation (killedDrivingFiltration hXζ) P).le t A hA
  change MeasurableSet[usualAugmentation (killedDrivingFiltration hXV) P t] A
  rw [Ito.usualAugmentation_apply]
  simp only [MeasurableSpace.measurableSet_iInf]
  intro s hts
  obtain ⟨q, -, hq, hlim⟩ := exists_seq_strictAnti_tendsto' hts
  have hAq_exists : ∀ n, ∃ B : Set Ω,
      MeasurableSet[killedDrivingSigma W VL VR ζ (q n)] B ∧ A =ᵐ[P] B := by
    intro n
    exact Ito.exists_ae_eq_of_measurableSet_usualAugmentation (hq n).1 hA
  choose B hB hAB using hAq_exists
  have hBv : ∀ n, MeasurableSet[killedDrivingSigma W VL VR V (q n)]
      (B n ∩ {ω | (q n : ℝ≥0∞) < V ω}) := by
    intro n
    exact measurableSet_killedDrivingSigma_inter_lt hVζ (hB n)
  have hdead : MeasurableSet[killedDrivingSigma W VL VR V t]
      {ω | V ω ≤ (t : ℝ≥0∞)} := by
    have halive : MeasurableSet[killedDrivingSigma W VL VR V t]
        {ω | (t : ℝ≥0∞) < V ω} := by
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨t, le_rfl, Set.univ, MeasurableSet.univ, by ext ω; simp⟩
    have hset : {ω | V ω ≤ (t : ℝ≥0∞)} = {ω | ¬ (t : ℝ≥0∞) < V ω} := by
      ext ω
      simp only [mem_setOf_eq, not_lt]
    rw [hset]
    exact halive.compl
  let Btot : Set Ω := {ω | V ω ≤ (t : ℝ≥0∞)} ∪
    ⋃ n, B n ∩ {ω | (q n : ℝ≥0∞) < V ω}
  have hBtot : MeasurableSet[killedDrivingSigma W VL VR V s] Btot := by
    have hdead' : MeasurableSet[killedDrivingSigma W VL VR V s]
        {ω | V ω ≤ (t : ℝ≥0∞)} := by
      exact (killedDrivingFiltration hXV).mono (le_of_lt hts) _ hdead
    apply hdead'.union
    apply MeasurableSet.iUnion
    intro n
    exact (killedDrivingFiltration hXV).mono (le_of_lt (hq n).2) _ (hBv n)
  have hAeq : A =ᵐ[P] Btot := by
    filter_upwards [hτV, ae_all_iff.2 hAB] with ω hτVω hABω
    simp only [A, Btot, Set.mem_setOf_eq, Set.mem_union, Set.mem_iUnion, Set.mem_inter_iff]
    apply propext
    constructor
    · intro hτt
      by_cases hVt : V ω ≤ (t : ℝ≥0∞)
      · exact Or.inl hVt
      · right
        have htV : (t : ℝ≥0∞) < V ω := lt_of_not_ge hVt
        cases hVω : V ω with
        | top => exact ⟨0, (Iff.of_eq (hABω 0)).mp hτt, by simp [hVω]⟩
        | coe v =>
          have htv : t < v := by
            exact_mod_cast (show (t : ℝ≥0∞) < (v : ℝ≥0∞) by simpa [hVω] using htV)
          obtain ⟨n, hn⟩ := (hlim.eventually (Iio_mem_nhds htv)).exists
          have hqv : (q n : ℝ≥0∞) < (v : ℝ≥0∞) := by exact_mod_cast hn
          exact ⟨n, (Iff.of_eq (hABω n)).mp hτt, by simpa [hVω] using hqv⟩
    · rintro (hVt | ⟨n, hnB, hqV⟩)
      · exact le_of_lt (lt_of_lt_of_le hτVω hVt)
      · exact (Iff.of_eq (hABω n)).mpr hnB
  exact Coupling.measurableSet_nullAugmented_of_ae_eq hAm hBtot hAeq

end WFS

end InteractingSLE
