import InteractingSLE.Foundations.Loewner.CapacityEstimates
import InteractingSLE.Foundations.Loewner.Capacity
import InteractingSLE.GFF.LocalSets.HittingSigma

/-!
# Half-plane capacity is a measurable function of a hull

Packet PROVE-WHOLEFIELD2 (ruling R36). Specification Aux. lemma 18, proof (`source/spec/p097-144.md#aux-18-proof`,
p. 97): "Capacity is a measurable function of a hull and distinguishes the two branches". The specification uses this
without proof. It is proved here for the hitting σ-algebra `hittingSigma` (generated by `{A ∩ U ≠ ∅}`, `U ⊆ ℍ` open).

## The measurable version

For the closed grid squares `Q` of width `1/(n + 1)` in the closed upper half-plane and a finite set `s` of them, put
`C = ⋃ s`. The event `{K ⊆ C}` is the avoidance event of the open set `ℍ \ C` (for `K ⊆ ℍ`), so

`hcapHit K = ⨅_{n, s} (hcap(fill C) if K ∩ (ℍ \ C) = ∅, else ∞)`

is `hittingSigma`-measurable (a countable infimum of functions taking two values on a measurable event).

## It is the capacity on compact `ℍ`-hulls (outer continuity)

`hcapHit K ≥ hcap K` by monotonicity of capacity. For the reverse inequality we prove **outer continuity**
(`IsHPHull.exists_hcapFill_le`): for a compact `ℍ`-hull `K` and `ε > 0` there is `d > 0` such that every closed bounded
`C ⊇ K` within distance `d` of `K` (with `C ∪ {Im ≤ 0}` connected) has `hcap(fill C) ≤ hcap K + ε`. Proof:
* let `g` map out `K`, `|g(z) − z| ≤ M`, and `V = {z ∈ ℍ \ K : Im g(z) > η}`. `V` is the image of the half-plane
  `{Im w > η}` under the continuous inverse of `g`, hence connected and unbounded;
* `cl V` does not meet `cl K` (on `V`, `Im z ≥ Im g(z) > η`, so a common point lies in `K`, where `Im g → 0`), so a
  closed `d`-neighbourhood of the compact `cl K` misses `V`;
* if `C` lies in that neighbourhood, `V` is a connected unbounded subset of `ℍ \ C`, so it lies in the unbounded
  component and misses `fill C`; thus `Im g ≤ η` on `fill C \ K`;
* by the composition rule `hcap(fill C) = hcap K + hcap(g(fill C \ K))`, and `g(fill C \ K)` lies in the rectangle
  `[−a, a] × [0, η]`, whose filled capacity is at most `2aη + η²`.

The grid cover of `K` at width `δ` (the squares meeting `cl K`) is such a `C` within distance `2δ`.

## Main results

* `measurable_hcapHit`: `hcapHit` is `hittingSigma`-measurable;
* `IsHPHull.exists_hcapFill_le`: outer continuity of the half-plane capacity;
* **`IsHPHull.hcapHit_eq`**: `hcapHit K = hcap K` for every compact `ℍ`-hull;
* **`hcapHit_fwdHull`**: `hcapHit K_t = 2t` for the Loewner hulls of a continuous driver with `W 0 = 0`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Complex Set Metric Filter Topology Bornology MeasureTheory
open scoped ENNReal NNReal

open QuantumZipper (H)

namespace InteractingSLE

namespace WholeField

/-! ### Grid squares -/

/-- The grid width `1/(n + 1)`. -/
def gridWidth (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)

theorem gridWidth_pos (n : ℕ) : 0 < gridWidth n := by
  unfold gridWidth
  positivity

/-- The closed grid square `[iδ, (i + 1)δ] × [jδ, (j + 1)δ]`, `δ = 1/(n + 1)`, of the closed upper half-plane. -/
def gridSq (n : ℕ) (p : ℤ × ℕ) : Set ℂ :=
  Icc ((p.1 : ℝ) * gridWidth n) (((p.1 : ℝ) + 1) * gridWidth n) ×ℂ
    Icc ((p.2 : ℝ) * gridWidth n) (((p.2 : ℝ) + 1) * gridWidth n)

/-- A finite union of closed grid squares. -/
def gridUnion (n : ℕ) (s : Finset (ℤ × ℕ)) : Set ℂ :=
  ⋃ p ∈ s, gridSq n p

theorem isCompact_gridSq (n : ℕ) (p : ℤ × ℕ) : IsCompact (gridSq n p) :=
  isCompact_Icc.reProdIm isCompact_Icc

theorem isClosed_gridUnion (n : ℕ) (s : Finset (ℤ × ℕ)) : IsClosed (gridUnion n s) :=
  s.finite_toSet.isClosed_biUnion fun p _ => (isCompact_gridSq n p).isClosed

theorem isBounded_gridUnion (n : ℕ) (s : Finset (ℤ × ℕ)) : IsBounded (gridUnion n s) :=
  (isBounded_biUnion_finset s).2 fun p _ => (isCompact_gridSq n p).isBounded

theorem isPreconnected_gridSq (n : ℕ) (p : ℤ × ℕ) : IsPreconnected (gridSq n p) := by
  refine Convex.isPreconnected ?_
  intro x hx y hy a b ha hb hab
  rw [gridSq, mem_reProdIm] at hx hy ⊢
  simp only [add_re, add_im, Complex.smul_re, Complex.smul_im, smul_eq_mul]
  exact ⟨(convex_Icc _ _) hx.1 hy.1 ha hb hab, (convex_Icc _ _) hx.2 hy.2 ha hb hab⟩

/-- Every point of the closed upper half-plane lies in the grid square indexed by the floors of its coordinates. -/
theorem mem_gridSq_floor (n : ℕ) {z : ℂ} (hz : 0 ≤ z.im) :
    z ∈ gridSq n (⌊z.re / gridWidth n⌋, ⌊z.im / gridWidth n⌋₊) := by
  have hδ := gridWidth_pos n
  rw [gridSq, mem_reProdIm, mem_Icc, mem_Icc]
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · rw [← le_div_iff₀ hδ]; exact Int.floor_le _
  · rw [← div_le_iff₀ hδ]; exact (Int.lt_floor_add_one _).le
  · rw [← le_div_iff₀ hδ]; exact Nat.floor_le (div_nonneg hz hδ.le)
  · rw [← div_le_iff₀ hδ]; exact (Nat.lt_floor_add_one _).le

/-- Two points of a grid square are within `2δ`. -/
theorem dist_le_of_mem_gridSq {n : ℕ} {p : ℤ × ℕ} {z w : ℂ} (hz : z ∈ gridSq n p)
    (hw : w ∈ gridSq n p) : dist z w ≤ 2 * gridWidth n := by
  rw [gridSq, mem_reProdIm, mem_Icc, mem_Icc] at hz hw
  rw [dist_eq_norm]
  refine (Complex.norm_le_abs_re_add_abs_im _).trans ?_
  simp only [sub_re, sub_im]
  have h1 : |z.re - w.re| ≤ gridWidth n := by
    rw [abs_le]; constructor <;> nlinarith [hz.1.1, hz.1.2, hw.1.1, hw.1.2]
  have h2 : |z.im - w.im| ≤ gridWidth n := by
    rw [abs_le]; constructor <;> nlinarith [hz.2.1, hz.2.2, hw.2.1, hw.2.2]
  linarith

/-! ### The measurable capacity -/

open Classical in
/-- The filled capacity of a finite union of grid squares (`∞` if it is not connected to the lower half-plane). -/
def gridCap (n : ℕ) (s : Finset (ℤ × ℕ)) : ℝ≥0∞ :=
  if h : IsPreconnected (gridUnion n s ∪ {z : ℂ | z.im ≤ 0}) then
    ENNReal.ofReal (hcapFill (gridUnion n s) (isBounded_gridUnion n s) h) else ⊤

open Classical in
/-- **The measurable half-plane capacity**: the infimum of the filled capacities of the finite unions of grid
squares containing `K ∩ ℍ`. -/
def hcapHit (K : Set ℂ) : ℝ≥0∞ :=
  ⨅ (n : ℕ) (s : Finset (ℤ × ℕ)), if Disjoint K (H \ gridUnion n s) then gridCap n s else ⊤

/-- **`hcapHit` is measurable for the hitting σ-algebra.** -/
theorem measurable_hcapHit : Measurable[hittingSigma] hcapHit := by
  classical
  let _ : MeasurableSpace (Set ℂ) := hittingSigma
  refine Measurable.iInf fun n => Measurable.iInf fun s => ?_
  refine Measurable.ite ?_ measurable_const measurable_const
  exact LocalSets.measurableSet_avoid (QuantumZipper.isOpen_H.sdiff (isClosed_gridUnion n s))
    sdiff_subset

/-- `hcap(K) ≤ hcapHit K` for a compact `ℍ`-hull: capacity is monotone. -/
theorem IsHPHull.ofReal_hcap_le_hcapHit {K : Set ℂ} (hK : IsHPHull K) :
    ENNReal.ofReal (HPHull.hcap ⟨K, hK⟩) ≤ hcapHit K := by
  classical
  refine le_iInf₂ fun n s => ?_
  split_ifs with hd
  · have hKC : K ⊆ gridUnion n s := by
      intro z hz
      by_contra hzC
      exact Set.disjoint_left.1 hd hz ⟨hK.1 hz, hzC⟩
    unfold gridCap
    split_ifs with hc
    · refine ENNReal.ofReal_le_ofReal ?_
      rw [← HPHull.hcapFill_eq ⟨K, hK⟩]
      exact hcapFill_mono hKC _ _ _ _
    · exact le_top
  · exact le_top

/-! ### Outer continuity of the half-plane capacity -/

/-- The super-level set `{z ∈ ℍ \ K : Im g(z) > η}` (`η ≥ 0`) of a mapping-out function is preconnected (it is the
image of a half-plane under the continuous inverse of `g`) and unbounded. -/
theorem IsMapOut.isPreconnected_superlevel {K : Set ℂ} {g : ℂ → ℂ} (hK : IsHPHull K) (hg : IsMapOut K g)
    {η : ℝ} (hη : 0 ≤ η) :
    IsPreconnected {z | z ∈ H \ K ∧ η < (g z).im} ∧ ¬ IsBounded {z | z ∈ H \ K ∧ η < (g z).im} := by
  obtain ⟨h, hhd, hright, hleft⟩ := hg.exists_symm hK
  obtain ⟨M, hM⟩ := hg.exists_norm_sub_le hK
  set V' : Set ℂ := {w | η < w.im} with hV'
  have hV'H : V' ⊆ H := fun w hw => lt_of_le_of_lt hη hw
  have hVeq : {z | z ∈ H \ K ∧ η < (g z).im} = h '' V' := by
    ext z
    constructor
    · rintro ⟨hz, hzη⟩
      exact ⟨g z, hzη, hleft z hz⟩
    · rintro ⟨w, hw, rfl⟩
      have := hright w (hV'H hw)
      exact ⟨this.1, by rw [this.2]; exact hw⟩
  refine ⟨?_, ?_⟩
  · rw [hVeq]
    have hc : Convex ℝ V' := convex_halfSpace_gt (f := fun z : ℂ => z.im) Complex.imLm.isLinear η
    exact hc.isPreconnected.image h ((hhd.mono hV'H).continuousOn)
  · intro hb
    obtain ⟨R, hR⟩ := hb.subset_closedBall 0
    set w : ℂ := ((|R| + |M| + η + 1 : ℝ) : ℂ) * I with hw
    have hwV : w ∈ V' := by
      show η < w.im
      simp only [hw, mul_im, ofReal_re, I_im, mul_one, ofReal_im, I_re, mul_zero, add_zero]
      linarith [abs_nonneg R, abs_nonneg M]
    have hz := hright w (hV'H hwV)
    have hzV : h w ∈ {z | z ∈ H \ K ∧ η < (g z).im} := ⟨hz.1, by rw [hz.2]; exact hwV⟩
    have h1 : ‖h w‖ ≤ R := mem_closedBall_zero_iff.1 (hR hzV)
    have h2 : ‖g (h w) - h w‖ ≤ M := hM _ hz.1
    rw [hz.2] at h2
    have h3 : ‖w‖ = |R| + |M| + η + 1 := by
      rw [hw, norm_mul, norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by
        linarith [abs_nonneg R, abs_nonneg M])]
    have h4 : ‖w‖ ≤ ‖w - h w‖ + ‖h w‖ := by
      calc ‖w‖ = ‖(w - h w) + h w‖ := by rw [sub_add_cancel]
        _ ≤ ‖w - h w‖ + ‖h w‖ := norm_add_le _ _
    linarith [le_abs_self R, le_abs_self M]

/-- **Outer continuity of the half-plane capacity.** For a compact `ℍ`-hull `K` and `ε > 0` there is `d > 0` such
that every closed bounded `C ⊇ K` inside the closed `d`-neighbourhood of `cl K` (with `C ∪ {Im ≤ 0}` connected) has
`hcap(fill C) ≤ hcap K + ε`. -/
theorem IsHPHull.exists_hcapFill_le {K : Set ℂ} (hK : IsHPHull K) {ε : ℝ} (hε : 0 < ε) :
    ∃ d > 0, ∀ (C : Set ℂ) (hCb : IsBounded C) (hCc : IsPreconnected (C ∪ {z : ℂ | z.im ≤ 0})),
      IsClosed C → K ⊆ C → C ⊆ cthickening d (closure K) →
        hcapFill C hCb hCc ≤ HPHull.hcap ⟨K, hK⟩ + ε := by
  obtain ⟨g, hg⟩ := hK.exists_isMapOut
  obtain ⟨M, hM⟩ := hg.exists_norm_sub_le hK
  obtain ⟨R₀, hR₀⟩ := hK.2.1.closure.subset_closedBall (0 : ℂ)
  set R : ℝ := |R₀| with hRdef
  have hR : closure K ⊆ closedBall 0 R :=
    hR₀.trans (closedBall_subset_closedBall (le_abs_self R₀))
  set a : ℝ := R + 1 + |M| + 1 with hadef
  have ha : 0 < a := by positivity
  set η : ℝ := min 1 (ε / (2 * a + 1)) with hηdef
  have hη : 0 < η := lt_min one_pos (by positivity)
  have hηε : 2 * a * η + η ^ 2 ≤ ε := by
    have h1 : η ≤ 1 := min_le_left _ _
    have h2 : η ≤ ε / (2 * a + 1) := min_le_right _ _
    have h3 : η ^ 2 ≤ η := by nlinarith
    have h4 : (2 * a + 1) * η ≤ ε := by
      rw [le_div_iff₀ (by positivity)] at h2
      linarith
    nlinarith
  set V : Set ℂ := {z | z ∈ H \ K ∧ η < (g z).im} with hVdef
  obtain ⟨hVpc, hVub⟩ := IsMapOut.isPreconnected_superlevel hK hg hη.le
  -- the closures of `V` and `K` are disjoint
  have hVsub : V ⊆ {z | η ≤ z.im} := fun z hz => (hz.2.trans_le (hg.im_le hK hz.1)).le
  have hKV : closure K ⊆ (closure V)ᶜ := by
    intro q hqK hqV
    have hqim : η ≤ q.im := closure_minimal hVsub (isClosed_le continuous_const continuous_im) hqV
    have hqH : q ∈ H := lt_of_lt_of_le hη hqim
    have hqK' : q ∈ K := hK.mem_of_mem_closure hqH hqK
    have hT := hg.tendsto_im_nhdsWithin hK (q := q) fun h => h.2 hqK'
    have hne : (𝓝[V] q).NeBot := mem_closure_iff_nhdsWithin_neBot.1 hqV
    have hT' := hT.mono_left (nhdsWithin_mono q fun z (hz : z ∈ V) => hz.1)
    have h1 : ∀ᶠ z in 𝓝[V] q, (g z).im < η := hT' (Iio_mem_nhds hη)
    have h2 : ∀ᶠ z in 𝓝[V] q, η < (g z).im := eventually_nhdsWithin_of_forall fun z (hz : z ∈ V) => hz.2
    obtain ⟨z, hz1, hz2⟩ := (h1.and h2).exists
    linarith
  obtain ⟨d₀, hd₀, hd₀V⟩ :=
    (hK.2.1.isCompact_closure).exists_cthickening_subset_open isClosed_closure.isOpen_compl hKV
  refine ⟨min d₀ 1, lt_min hd₀ one_pos, fun C hCb hCc hCcl hKC hCd => ?_⟩
  have hCd₀ : C ⊆ (closure V)ᶜ :=
    hCd.trans ((cthickening_mono (min_le_left _ _) _).trans hd₀V)
  have hCV : Disjoint C V := Set.disjoint_left.2 fun z hzC hzV => hCd₀ hzC (subset_closure hzV)
  -- `Im g ≤ η` on `fill C \ K`
  have hfill : ∀ z ∈ fillH C, z ∉ K → (g z).im ≤ η := by
    intro z hz hzK
    by_contra hlt
    rw [not_le] at hlt
    have hzV : z ∈ V := ⟨⟨hz.1, hzK⟩, hlt⟩
    have hVC : V ⊆ H \ closure C := by
      rw [hCcl.closure_eq]
      exact fun w hw => ⟨hw.1.1, fun hwC => Set.disjoint_left.1 hCV hwC hw⟩
    rcases hz.2 with hzC | hb
    · rw [hCcl.closure_eq] at hzC
      exact Set.disjoint_left.1 hCV hzC hzV
    · exact hVub (hb.subset (hVpc.subset_connectedComponentIn hzV hVC))
  -- `fill C` lies in a fixed disc
  have hCR : closure C ⊆ closedBall 0 (R + 1) := by
    rw [hCcl.closure_eq]
    refine hCd.trans ((cthickening_subset_of_subset _ hR).trans ?_)
    rw [cthickening_closedBall (le_min hd₀.le zero_le_one) (abs_nonneg _)]
    exact closedBall_subset_closedBall (by linarith [min_le_right d₀ 1])
  have hfillR := fillH_subset_closedBall_zero hCR
  -- the composition rule
  have hg' : IsMapOut (fillH K) g := by rw [hK.fillH_eq]; exact hg
  have hcomp := hcapFill_union_eq_add hK.2.1 hK.isPreconnected_union_lowerHalf hCb hCc hg'
  have hKCe : K ∪ C = C := union_eq_right.2 hKC
  have eK : hcapFill K hK.2.1 hK.isPreconnected_union_lowerHalf = HPHull.hcap ⟨K, hK⟩ :=
    HPHull.hcapFill_eq ⟨K, hK⟩
  rw [hcapFill_congr hKCe _ _ hCb hCc, eK] at hcomp
  have hImg : ∀ hI : IsHPHull (g '' (fillH (K ∪ C) \ fillH K)), HPHull.hcap ⟨_, hI⟩ ≤ ε := by
    intro hI
    rw [← HPHull.hcapFill_eq ⟨_, hI⟩]
    refine (hcapFill_le_of_subset_rect hI.2.1 hI.isPreconnected_union_lowerHalf ha hη ?_).trans hηε
    rintro w ⟨z, ⟨hz, hzK⟩, rfl⟩
    rw [hKCe] at hz
    rw [hK.fillH_eq] at hzK
    have hzH : z ∈ H \ K := ⟨hz.1, hzK⟩
    have him : 0 < (g z).im := hg.1.2.mapsTo hzH
    have hnz : ‖z‖ ≤ R + 1 := mem_closedBall_zero_iff.1 (hfillR hz)
    have hgz : ‖g z‖ ≤ ‖z‖ + M := by
      have := hM z hzH
      calc ‖g z‖ = ‖(g z - z) + z‖ := by rw [sub_add_cancel]
        _ ≤ ‖g z - z‖ + ‖z‖ := norm_add_le _ _
        _ ≤ M + ‖z‖ := add_le_add this le_rfl
        _ = ‖z‖ + M := add_comm _ _
    refine ⟨(abs_re_le_norm _).trans ?_, ?_⟩
    · linarith [le_abs_self M]
    · rw [abs_of_pos him]
      exact hfill z hz hzK
  rw [hcomp, add_comm]
  exact add_le_add le_rfl (hImg _)

/-! ### Grid covers -/

/-- The index box `[−N, N] × [0, N]`. -/
def gridBox (N : ℕ) : Finset (ℤ × ℕ) :=
  Finset.Icc (-(N : ℤ)) N ×ˢ Finset.range (N + 1)

open Classical in
/-- The grid cover of `K` at width `1/(n + 1)` inside the box `N`: the grid squares meeting `cl K`. -/
def gridCover (n N : ℕ) (K : Set ℂ) : Finset (ℤ × ℕ) :=
  (gridBox N).filter fun p => (gridSq n p ∩ closure K).Nonempty

/-- A grid square meeting the disc `B̄(0, R)` has its index in the box `N` once `R(n + 1) + 1 ≤ N`. -/
theorem mem_gridBox_of_mem {n N : ℕ} {R : ℝ} (hN : R * ((n : ℝ) + 1) + 1 ≤ N) {p : ℤ × ℕ} {z : ℂ}
    (hz : z ∈ gridSq n p) (hzR : ‖z‖ ≤ R) : p ∈ gridBox N := by
  rw [gridSq, mem_reProdIm, mem_Icc, mem_Icc] at hz
  have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  have hδ : gridWidth n * ((n : ℝ) + 1) = 1 := by
    unfold gridWidth; field_simp
  have hre := abs_re_le_norm z
  have him := abs_im_le_norm z
  rw [abs_le] at hre him
  have h1 : (p.1 : ℝ) ≤ R * ((n : ℝ) + 1) := by
    have : (p.1 : ℝ) * gridWidth n ≤ R := by linarith [hz.1.1]
    calc (p.1 : ℝ) = (p.1 : ℝ) * gridWidth n * ((n : ℝ) + 1) := by rw [mul_assoc, hδ, mul_one]
      _ ≤ R * ((n : ℝ) + 1) := mul_le_mul_of_nonneg_right this hn.le
  have h2 : -(R * ((n : ℝ) + 1)) - 1 ≤ (p.1 : ℝ) := by
    have : -R ≤ ((p.1 : ℝ) + 1) * gridWidth n := by linarith [hz.1.2]
    have h' : -R * ((n : ℝ) + 1) ≤ (p.1 : ℝ) + 1 := by
      calc -R * ((n : ℝ) + 1) ≤ ((p.1 : ℝ) + 1) * gridWidth n * ((n : ℝ) + 1) :=
            mul_le_mul_of_nonneg_right this hn.le
        _ = (p.1 : ℝ) + 1 := by rw [mul_assoc, hδ, mul_one]
    linarith
  have h3 : (p.2 : ℝ) ≤ R * ((n : ℝ) + 1) := by
    have : (p.2 : ℝ) * gridWidth n ≤ R := by linarith [hz.2.1]
    calc (p.2 : ℝ) = (p.2 : ℝ) * gridWidth n * ((n : ℝ) + 1) := by rw [mul_assoc, hδ, mul_one]
      _ ≤ R * ((n : ℝ) + 1) := mul_le_mul_of_nonneg_right this hn.le
  rw [gridBox, Finset.mem_product, Finset.mem_Icc, Finset.mem_range]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · have : (-(N : ℤ) : ℝ) ≤ (p.1 : ℝ) := by push_cast; linarith
    exact_mod_cast this
  · have : (p.1 : ℝ) ≤ ((N : ℤ) : ℝ) := by push_cast; linarith
    exact_mod_cast this
  · have : (p.2 : ℝ) < ((N + 1 : ℕ) : ℝ) := by push_cast; linarith
    exact_mod_cast this

/-- The grid cover contains every set of the closed upper half-plane inside `B̄(0, R)`. -/
theorem subset_gridUnion_gridCover {n N : ℕ} {R : ℝ} (hN : R * ((n : ℝ) + 1) + 1 ≤ N) {K : Set ℂ}
    (hKim : ∀ z ∈ K, 0 ≤ z.im) (hKR : closure K ⊆ closedBall 0 R) :
    K ⊆ gridUnion n (gridCover n N K) := by
  classical
  intro z hz
  have hzs := mem_gridSq_floor n (hKim z hz)
  refine mem_iUnion₂.2 ⟨_, ?_, hzs⟩
  rw [gridCover, Finset.mem_filter]
  exact ⟨mem_gridBox_of_mem hN hzs (mem_closedBall_zero_iff.1 (hKR (subset_closure hz))),
    z, hzs, subset_closure hz⟩

/-- The grid cover lies in the closed `2δ`-neighbourhood of `cl K`. -/
theorem gridUnion_gridCover_subset (n N : ℕ) (K : Set ℂ) :
    gridUnion n (gridCover n N K) ⊆ cthickening (2 * gridWidth n) (closure K) := by
  classical
  intro z hz
  obtain ⟨p, hp, hzp⟩ := mem_iUnion₂.1 hz
  rw [gridCover, Finset.mem_filter] at hp
  obtain ⟨w, hwp, hwK⟩ := hp.2
  exact mem_cthickening_of_dist_le z w _ _ hwK (dist_le_of_mem_gridSq hzp hwp)

/-- The grid cover of a compact `ℍ`-hull, together with the lower half-plane, is connected. -/
theorem IsHPHull.isPreconnected_gridUnion_gridCover {n N : ℕ} {R : ℝ}
    (hN : R * ((n : ℝ) + 1) + 1 ≤ N) {K : Set ℂ} (hK : IsHPHull K) (hKR : closure K ⊆ closedBall 0 R) :
    IsPreconnected (gridUnion n (gridCover n N K) ∪ {z : ℂ | z.im ≤ 0}) := by
  classical
  set L : Set ℂ := {z : ℂ | z.im ≤ 0} with hL
  set C := gridUnion n (gridCover n N K) with hC
  have hLc : IsClosed L := isClosed_le continuous_im continuous_const
  set T : Set ℂ := closure K ∪ L with hT
  have hTpc : IsPreconnected T := by
    have := hK.isPreconnected_union_lowerHalf.closure
    rwa [closure_union, hLc.closure_eq] at this
  have hKC : K ⊆ C := subset_gridUnion_gridCover hN (fun z hz => (hK.1 hz).le) hKR
  have hclK : closure K ⊆ C ∪ L := by
    intro q hq
    by_cases hqim : 0 < q.im
    · exact Or.inl (hKC (hK.mem_of_mem_closure hqim hq))
    · exact Or.inr (not_lt.1 hqim)
  set f : Option (ℤ × ℕ) → Set ℂ := fun i => match i with
    | none => T
    | some p => if p ∈ gridCover n N K then gridSq n p ∪ T else T with hf
  have h0T : (0 : ℂ) ∈ T := Or.inr (show (0 : ℂ).im ≤ 0 by simp)
  have hfpc : ∀ i, IsPreconnected (f i) := by
    rintro (_ | p)
    · exact hTpc
    · simp only [hf]
      split_ifs with hp
      · rw [gridCover, Finset.mem_filter] at hp
        obtain ⟨x, hx1, hx2⟩ := hp.2
        exact (isPreconnected_gridSq n p).union x hx1 (Or.inl hx2) hTpc
      · exact hTpc
  have hfT : ∀ i, T ⊆ f i := by
    rintro (_ | p)
    · exact le_rfl
    · simp only [hf]
      split_ifs
      · exact subset_union_right
      · exact le_rfl
  have hU : (⋃ i, f i) = C ∪ L := by
    apply subset_antisymm
    · refine iUnion_subset ?_
      rintro (_ | p)
      · exact union_subset hclK subset_union_right
      · simp only [hf]
        split_ifs with hp
        · exact union_subset (fun z hz => Or.inl (mem_iUnion₂.2 ⟨p, hp, hz⟩))
            (union_subset hclK subset_union_right)
        · exact union_subset hclK subset_union_right
    · refine union_subset ?_ ?_
      · intro z hz
        obtain ⟨p, hp, hzp⟩ := mem_iUnion₂.1 hz
        refine mem_iUnion.2 ⟨some p, ?_⟩
        simp only [hf, hp, ite_true]
        exact Or.inl hzp
      · exact fun z hz => mem_iUnion.2 ⟨none, Or.inr hz⟩
  rw [← hU]
  exact isPreconnected_iUnion ⟨0, mem_iInter.2 fun i => hfT i h0T⟩ hfpc

/-! ### The measurable capacity is the capacity -/

/-- **`hcapHit` is the half-plane capacity on compact `ℍ`-hulls.** -/
theorem IsHPHull.hcapHit_eq {K : Set ℂ} (hK : IsHPHull K) :
    hcapHit K = ENNReal.ofReal (HPHull.hcap ⟨K, hK⟩) := by
  classical
  refine le_antisymm ?_ (IsHPHull.ofReal_hcap_le_hcapHit hK)
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  obtain ⟨d, hd, hdC⟩ := IsHPHull.exists_hcapFill_le hK (ε := ε) (by exact_mod_cast hε)
  obtain ⟨R, hR⟩ := hK.2.1.closure.subset_closedBall (0 : ℂ)
  obtain ⟨n, hn⟩ := exists_nat_gt (2 / d)
  set N : ℕ := ⌈R * ((n : ℝ) + 1)⌉₊ + 1 with hNdef
  have hN : R * ((n : ℝ) + 1) + 1 ≤ N := by
    rw [hNdef]; push_cast
    linarith [Nat.le_ceil (R * ((n : ℝ) + 1))]
  set s := gridCover n N K with hs
  have hKC : K ⊆ gridUnion n s := subset_gridUnion_gridCover hN (fun z hz => (hK.1 hz).le) hR
  have hc : IsPreconnected (gridUnion n s ∪ {z : ℂ | z.im ≤ 0}) :=
    IsHPHull.isPreconnected_gridUnion_gridCover hN hK hR
  have h2δ : 2 * gridWidth n ≤ d := by
    unfold gridWidth
    have hn' : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    rw [div_lt_iff₀ hd] at hn
    rw [mul_one_div, div_le_iff₀ hn']
    linarith
  have hCd : gridUnion n s ⊆ cthickening d (closure K) :=
    (gridUnion_gridCover_subset n N K).trans (cthickening_mono h2δ _)
  have hdisj : Disjoint K (H \ gridUnion n s) :=
    Set.disjoint_left.2 fun z hz hz' => hz'.2 (hKC hz)
  have hle := hdC (gridUnion n s) (isBounded_gridUnion n s) hc (isClosed_gridUnion n s) hKC hCd
  calc hcapHit K ≤ (if Disjoint K (H \ gridUnion n s) then gridCap n s else ⊤) :=
        iInf₂_le (f := fun n s => if Disjoint K (H \ gridUnion n s) then gridCap n s else ⊤) n s
    _ = ENNReal.ofReal (hcapFill (gridUnion n s) (isBounded_gridUnion n s) hc) := by
        simp only [hdisj, ↓reduceIte, gridCap, hc, ↓reduceDIte]
    _ ≤ ENNReal.ofReal (HPHull.hcap ⟨K, hK⟩ + ε) := ENNReal.ofReal_le_ofReal hle
    _ = ENNReal.ofReal (HPHull.hcap ⟨K, hK⟩) + ε := by
        have := ENNReal.ofReal_add (p := HPHull.hcap ⟨K, hK⟩) (q := (ε : ℝ)) (HPHull.hcap_nonneg _) ε.2
        rw [ENNReal.ofReal_coe_nnreal] at this
        exact this

/-- **The measurable capacity of a Loewner hull**: `hcapHit K_t = 2t` for a continuous driver with `W 0 = 0`. -/
theorem hcapHit_fwdHull {W : ℝ → ℝ} (hW : Continuous W) (hW0 : W 0 = 0) {t : ℝ} (ht : 0 ≤ t) :
    hcapHit (QuantumZipper.fwdHull W t) = ENNReal.ofReal (2 * t) := by
  rw [IsHPHull.hcapHit_eq (isHPHull_fwdHull hW ht), hcap_fwdHull hW hW0 ht]

