import InteractingSLE.Spec.Coupling.AnnounceLifetime
import InteractingSLE.Spec.Coupling.MartMeansLife

/-!
# The lifetime is announced in the driving filtration; unconditional martingale means

Packet PROVE-CPL-MART2, part (1). `AnnounceLifetime.exists_isAnnouncingSeq_le` builds an announcing sequence of the
lifetime `ζ` of an integrated `SLE_κ(ρ)` evolution in the usual augmentation of the evolution's own filtration. Its
candidates are hitting times of the killed state (`isStoppingTime_hitBelow_state`), which are stopping times of
**every** right-continuous filtration in which the state is adapted before `ζ` and whose time-zero σ-algebra contains
the measurable null sets. Here the construction is run in such a general filtration
(`exists_isAnnouncingSeq_le_of_adaptedBefore`), and applied to the frozen driving filtration
`drivingFiltration P hX` (the usual augmentation of the filtration generated by the killed driving process). This
removes the conditional hypothesis of `IsOptionalHullCoupling.exists_martingale_stoppedProcess_meanProc`.

## Main results

* `exists_isAnnouncingSeq_le_of_adaptedBefore`: the announcing sequence in a general filtration;
* `IsIntegratedSLEEvolution.exists_isAnnouncingSeq_drivingFiltration`: in the driving filtration;
* **`IsOptionalHullCoupling.exists_martingale_stoppedProcess_meanProc_of_admissible`**: the coupling means of the
  frozen optional hull specification are martingales up to localizing times exhausting `[0, ζ ∧ s(z))`, for an
  admissible seed and `κ > 0` (no further input).
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Coupling

open Ito

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ### The announcing sequence in a general filtration -/

section General

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {P : Measure Ω} {𝓕 𝓖 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

open scoped Classical in
/-- **The lifetime has an announcing sequence in every admissible filtration**: the construction of
`exists_isAnnouncingSeq_le`, run in a right-continuous filtration `𝓖` whose time-zero σ-algebra contains the measurable
`P`-null sets and in which the coordinates `W`, `V^L`, `V^R` are adapted before `ζ`. For an integrated `SLE_κ(ρ)`
evolution (on any filtration `𝓕`) with `κ > 0` and an admissible seed, there are stopping times `T_n ≤ n` of `𝓖`,
nondecreasing in `n`, with `T_n < ζ` almost surely and, almost surely, every `t < ζ` below some `T_n`. -/
theorem exists_isAnnouncingSeq_le_of_adaptedBefore [IsProbabilityMeasure P] [𝓖.IsRightContinuous]
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ) (hκ : 0 < κ)
    (hseed : ¬ ForceWord.ThresholdCondition ρL ρR 0 xL xR)
    (hnull : ∀ s, MeasurableSet s → P s = 0 → MeasurableSet[𝓖 0] s) (hWa : AdaptedBefore 𝓖 ζ W)
    (hVLa : ∀ i, AdaptedBefore 𝓖 ζ (VL i)) (hVRa : ∀ i, AdaptedBefore 𝓖 ζ (VR i)) :
    ∃ T : ℕ → Ω → ℝ≥0, IsAnnouncingSeq 𝓖 P ζ T ∧ ∀ n ω, T n ω ≤ n := by
  -- the good event: the pathwise conditions and Aux. lemma 3's terminal state
  set good : Ω → Prop := fun ω =>
    IsIntegratedSLEPath κ xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω) (fun i t => VR i t ω)
      (fun t => B t ω) (ζ ω) ∧
    ∀ T : ℝ≥0, 0 < T → (T : ℝ≥0∞) = ζ ω →
      ∃ (w₀ : ℝ) (vL₀ : Fin nL → ℝ) (vR₀ : Fin nR → ℝ),
        Tendsto (fun t => (W t ω, fun i => VL i t ω, fun i => VR i t ω)) (𝓝[<] T)
          (𝓝 (w₀, vL₀, vR₀)) ∧
        ForceWord.ThresholdCondition ρL ρR w₀ vL₀ vR₀ with hgood
  have hae : ∀ᵐ ω ∂P, good ω := by
    filter_upwards [hE.2.2.2.2, hE.ae_tendsto_threshold hκ] with ω h1 h2 using ⟨h1, h2⟩
  obtain ⟨G, hGm, hGc, hGgood⟩ : ∃ G : Set Ω, MeasurableSet G ∧ P Gᶜ = 0 ∧ ∀ ω ∈ G, good ω := by
    refine ⟨(toMeasurable P {ω | ¬ good ω})ᶜ, (measurableSet_toMeasurable _ _).compl, ?_,
      fun ω hω => ?_⟩
    · rw [compl_compl, measure_toMeasurable]; exact ae_iff.1 hae
    · by_contra h; exact hω (subset_toMeasurable _ _ h)
  have hG0 : MeasurableSet[𝓖 0] G := by
    have := (hnull _ hGm.compl hGc).compl
    rwa [compl_compl] at this
  have hGae : ∀ᵐ ω ∂P, ω ∈ G := by rw [ae_iff]; exact hGc
  have hF : ∀ ω ∈ G, Sec2.IsForcePath xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω)
      (fun i t => VR i t ω) (ζ ω) := fun ω hω => (hGgood ω hω).1.isForcePath
  have hcont : ∀ ω ∈ G, ContinuousOn (fun s => stateAt W VL VR s ω) {s : ℝ≥0 | (s : ℝ≥0∞) < ζ ω} :=
    fun ω hω => (hF ω hω).continuousOn_w.prodMk ((continuousOn_pi.2 (hF ω hω).continuousOn_vL).prodMk
      (continuousOn_pi.2 (hF ω hω).continuousOn_vR))
  -- the random candidates
  set a : ℕ → ℕ → Ω → WithTop ℝ≥0 := fun p k ω => if ω ∈ G then
    candTime ρL ρR (fun t => W t ω) (fun i t => VL i t ω) (fun i t => VR i t ω) (ζ ω) p k else ⊤
    with ha_def
  have hatop : ∀ p k, (∀ ω ∈ G, candTime ρL ρR (fun t => W t ω) (fun i t => VL i t ω)
      (fun i t => VR i t ω) (ζ ω) p k = ⊤) → IsStoppingTime 𝓖 (a p k) := by
    intro p k htop
    have : a p k = fun _ => ⊤ := by
      funext ω
      by_cases hω : ω ∈ G
      · simp only [ha_def, hω, ite_true]; exact htop ω hω
      · simp only [ha_def, hω, ite_false]
    rw [this]
    exact isStoppingTime_top'
  have ha : ∀ p k, IsStoppingTime 𝓖 (a p k) := by
    intro p k
    by_cases hc : (Nat.unpair p).1 < nL
    · set j : Fin nL := ⟨(Nat.unpair p).1, hc⟩ with hj
      set m := (Nat.unpair p).2 with hm
      by_cases hs : (∑ i ∈ Finset.Iic j, ρL i) ≤ -2
      · have e : a p k = fun ω => if ω ∈ G then hitBelow (fun s =>
            (fun x : ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) => sideVal m j x.1 x.2.1) (stateAt W VL VR s ω))
            (ζ ω) (1 / ((k : ℝ) + 1)) else ⊤ := by
          funext ω
          simp only [ha_def, candTime, hc, ↓reduceDIte, hitL, ← hj, ← hm, hs, ↓reduceIte, stateAt]
        rw [e]
        exact isStoppingTime_hitBelow_state hWa hVLa hVRa hG0 hcont
          ((continuous_sideVal m j).comp (continuous_fst.prodMk (continuous_fst.comp continuous_snd))) _
      · exact hatop p k fun ω _ => by
          simp only [candTime, hc, ↓reduceDIte, hitL, ← hj, hs, ↓reduceIte]
    by_cases hc' : (Nat.unpair p).1 - nL < nR
    · set j : Fin nR := ⟨(Nat.unpair p).1 - nL, hc'⟩ with hj
      set m := (Nat.unpair p).2 with hm
      by_cases hs : (∑ i ∈ Finset.Iic j, ρR i) ≤ -2
      · have e : a p k = fun ω => if ω ∈ G then hitBelow (fun s =>
            (fun x : ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) => sideVal m j (-x.1) (-x.2.2))
              (stateAt W VL VR s ω)) (ζ ω) (1 / ((k : ℝ) + 1)) else ⊤ := by
          funext ω
          simp only [ha_def, candTime, hc, hc', ↓reduceDIte, hitL, ← hj, ← hm, hs, ↓reduceIte, stateAt]
          rfl
        rw [e]
        exact isStoppingTime_hitBelow_state hWa hVLa hVRa hG0 hcont
          ((continuous_sideVal m j).comp
            (continuous_fst.neg.prodMk (continuous_snd.comp continuous_snd).neg)) _
      · exact hatop p k fun ω _ => by
          simp only [candTime, hc, hc', ↓reduceDIte, hitL, ← hj, hs, ↓reduceIte]
    · exact hatop p k fun ω _ => by simp only [candTime, hc, hc', ↓reduceDIte]
  have hmono : ∀ p ω, Monotone fun k => a p k ω := by
    intro p ω
    by_cases hω : ω ∈ G
    · simp only [ha_def, hω, ite_true]
      exact candTime_mono p
    · simp only [ha_def, hω, ite_false]
      exact monotone_const
  have hbdd : ∀ ω ∈ G, ∀ p, BddSeq (a p) ω ↔ ∃ M : ℕ, ∀ k, candTime ρL ρR (fun t => W t ω)
      (fun i t => VL i t ω) (fun i t => VR i t ω) (ζ ω) p k ≤ ((M : ℝ≥0) : WithTop ℝ≥0) := by
    intro ω hω p
    simp only [BddSeq, ha_def, hω, ite_true]
  refine exists_isAnnouncingSeq_le_of_candidates ha hmono ?_ ?_ ?_
  · -- bounded candidates stay below the lifetime
    filter_upwards [hGae] with ω hω p hp k
    have := candTime_lt_of_bdd ((hbdd ω hω p).1 hp) k
    simpa only [ha_def, hω, ite_true] using this
  · -- uniformity over the bounded candidates
    filter_upwards [hGae] with ω hω t ht
    obtain ⟨K, hK⟩ := exists_eventually_le_candTime (hF ω hω) ht
    refine ⟨K, fun p hp k hk => ?_⟩
    have := hK p ((hbdd ω hω p).1 hp) k hk
    simpa only [ha_def, hω, ite_true] using this
  · -- some candidate is bounded at a finite lifetime
    filter_upwards [hGae] with ω hω hζ
    have hTζ : (((ζ ω).toNNReal : ℝ≥0) : ℝ≥0∞) = ζ ω := ENNReal.coe_toNNReal hζ
    have hT : 0 < (ζ ω).toNNReal := by
      refine pos_iff_ne_zero.2 fun h0 => hseed ((hF ω hω).threshold_of_eq_zero ?_)
      rw [← hTζ, h0, ENNReal.coe_zero]
    obtain ⟨w₀, vL₀, vR₀, hlim, hth⟩ := (hGgood ω hω).2 _ hT hTζ
    obtain ⟨p, hp⟩ := exists_bdd_candTime (hF ω hω) hT hTζ hlim hth
    exact ⟨p, (hbdd ω hω p).2 hp⟩

end General

/-! ### The driving filtration -/

section Driving

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {P : Measure Ω} {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

/-- The frozen driving filtration is right-continuous. -/
theorem isRightContinuous_drivingFiltration (hX : IsMeasurableKilledDriving W VL VR ζ) :
    (drivingFiltration P hX).IsRightContinuous := by
  unfold drivingFiltration usualAugmentation; infer_instance

/-- **The lifetime is announced in the driving filtration** (the input missing in PROVE-CPL-MART's
`IsOptionalHullCoupling.exists_martingale_stoppedProcess_meanProc`): for an integrated `SLE_κ(ρ)` evolution with
`κ > 0` and an admissible seed, and any measurability witness `hX` of the killed driving process, the lifetime has an
announcing sequence `T_n ≤ n` of stopping times of `drivingFiltration P hX`. -/
theorem _root_.InteractingSLE.IsIntegratedSLEEvolution.exists_isAnnouncingSeq_drivingFiltration
    [IsProbabilityMeasure P] (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ) (hκ : 0 < κ)
    (hseed : ¬ ForceWord.ThresholdCondition ρL ρR 0 xL xR) (hX : IsMeasurableKilledDriving W VL VR ζ) :
    ∃ T : ℕ → Ω → ℝ≥0, IsAnnouncingSeq (drivingFiltration P hX) P ζ T ∧ ∀ n ω, T n ω ≤ n := by
  have := isRightContinuous_drivingFiltration (P := P) hX
  have hle : killedDrivingFiltration hX ≤ drivingFiltration P hX := le_usualAugmentation _ P
  exact exists_isAnnouncingSeq_le_of_adaptedBefore hE hκ hseed
    (fun s hs h0 => measurableSet_usualAugmentation_of_null hs h0 0)
    (adaptedBefore_mono hle (adaptedBefore_killedDriving_W hX))
    (fun i => adaptedBefore_mono hle (adaptedBefore_killedDriving_VL hX i))
    (fun i => adaptedBefore_mono hle (adaptedBefore_killedDriving_VR hX i))

variable {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}

/-- **Martingale means of the frozen optional hull specification** (unconditional for an admissible seed and
`κ > 0`). For every choice `u` of the bounded harmonic extensions and every `z ∈ ℍ` there are stopping times `σ_n` of
the driving filtration, almost surely below `ζ` and the swallowing time `s(z)` and exhausting `[0, ζ ∧ s(z))`, such
that each stopped coupling mean `t ↦ 𝔥_{t∧σ_n}(z)` agrees almost surely, at every time, with a martingale of the
driving filtration. -/
theorem _root_.InteractingSLE.IsOptionalHullCoupling.exists_martingale_stoppedProcess_meanProc_of_admissible
    [IsProbabilityMeasure P] (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h) (hκ : 0 < κ)
    (hseed : ¬ ForceWord.ThresholdCondition ρL ρR 0 xL xR) (hX : IsMeasurableKilledDriving W VL VR ζ)
    (u : Ω → ℝ≥0 → ℂ → ℝ)
    (hu : ∀ ω t, IsBoundedHarmonicExtension
      (forceBoundaryData κ ρL ρR (fun i => VL i t ω - W t ω) (fun i => VR i t ω - W t ω))
      (forceJumpSet (fun i => VL i t ω - W t ω) (fun i => VR i t ω - W t ω)) (u ω t))
    {z : ℂ} (hz : z ∈ QuantumZipper.H) :
    ∃ σ : ℕ → Ω → WithTop ℝ≥0, (∀ n, IsStoppingTime (drivingFiltration P hX) (σ n)) ∧
      (∀ n, ∀ᵐ ω ∂P, (σ n ω : ℝ≥0∞) < ζ ω ∧
        (σ n ω : ℝ≥0∞) ≤ QuantumZipper.swallowTime (fun s : ℝ => W s.toNNReal ω) z) ∧
      (∀ᵐ ω ∂P, ∀ r : ℝ≥0, (r : ℝ≥0∞) < ζ ω →
        (r : ℝ≥0∞) < QuantumZipper.swallowTime (fun s : ℝ => W s.toNNReal ω) z →
        ∀ᶠ n in atTop, (r : WithTop ℝ≥0) < σ n ω) ∧
      ∀ n, ∃ M : ℝ≥0 → Ω → ℝ, Martingale M (drivingFiltration P hX) P ∧
        ∀ t, stoppedProcess (MartMeans.meanProc κ W u z) (σ n) t =ᵐ[P] M t := by
  obtain ⟨T, hT, -⟩ := hC.1.exists_isAnnouncingSeq_drivingFiltration hκ hseed hX
  exact hC.exists_martingale_stoppedProcess_meanProc hX hT u hu hz

end Driving

end Coupling

end InteractingSLE
