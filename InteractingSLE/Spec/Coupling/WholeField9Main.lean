/-!
# The retained-range kernel for `0 < κ ≤ 4` (Aux. lemma 16's kernel)

Packet PROVE-WHOLEFIELD9 (specification Aux. lemma 16, p. 90, and Aux. lemma 56, p. 249; follow-up note Part C;
ruling R38).

**`hasRetainedRangeKernel_of_trace`**: every coupling satisfying the frozen optional hull specification of Theorem 1.1
with `0 < κ ≤ 4`, whose driver almost surely has a continuous generating trace through its lifetime (the hypothesis of
Aux. lemma 16: "Suppose that an ordered integrated `SLE_κ(ρ)` evolution is already known to be generated by a continuous
trace `η`, before its continuation threshold"), has PROVE-WHOLEFIELD8's retained-range kernel
`WholeField.HasRetainedRangeKernel`: at every bounded driving stop `τ < ζ` there is a random distribution `M`, almost
surely harmonic on `ℍ \ η[0,τ]`, with `E[e^{i(h,φ)} | 𝓕_τ] = exp(i M(φ) − ½ G_{ℍ∖η[0,τ]}(φ, φ))`.

Assembly:
* the conditional characteristic functions are Gaussian with the conditional mean for **every** test
  (`ae_condExp_exp_eq_gaussCF_of_trace`, C.4–C.5 in conditional-mean form);
* the conditional means of the centred field are the pairings of an `𝓕_τ`-measurable random distribution
  (`exists_condMean_version`); `M` is that distribution plus the deterministic mean `𝔥₀`;
* `M` is harmonic on every finite union of labelled rational balls (the conditional means annihilate Laplacian tests
  supported there, `ae_condExp_lapH_eq_zero_of_disjoint`; Weyl's lemma, `LocalSets.isHarmonicDistOn_of_lapTest`), hence
  on `ℍ \ η[0,τ]` (compactness);
* the variance is `G_{ℍ∖η[0,τ]}` (`WangWu.zeroGFFTestCov_compl_image_eq_retainedGreenEnergy`; the range has zero area by
  the dimension bound).

`RetainedRangeKernelTraceStatement` is PROVE-WHOLEFIELD8's named input `RetainedRangeKernelStatement` with Aux. lemma
16's trace hypothesis; **`retainedRangeKernelTraceStatement`** proves it.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology Metric Complex
open scoped NNReal ENNReal

namespace InteractingSLE

namespace WholeField

open LQGMetric QuantumZipper LocalSets Ito Coupling
open SupercriticalConformalCovariance.GM24 (smoothDist smoothDist_apply)

section Main

universe u

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {Ω : Type u} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {𝓕 : Filtration ℝ≥0 mΩ}
  {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ}
  {ζ : Ω → ℝ≥0∞} {h : Ω → DistOn upperHalfPlaneOpens}

/-- A finite union of rational balls, as an open set. -/
def ballUnion (F : Finset (ℚ × ℚ × ℚ)) : TopologicalSpace.Opens ℂ :=
  ⟨⋃ q ∈ F, ball (qCentre q) (qRad q), isOpen_biUnion fun _ _ => isOpen_ball⟩

theorem ballUnion_le {F : Finset (ℚ × ℚ × ℚ)} (hF : ∀ q ∈ F, IsGoodBall q) : ballUnion F ≤ upperHalfPlaneOpens := by
  intro z hz
  obtain ⟨q, hq, hzq⟩ := mem_iUnion₂.1 hz
  exact (hF q hq).2 (ball_subset_closedBall hzq)

/-- **The conditional characteristic functions of the centred field** at a bounded stop, for every test. -/
theorem ae_condExp_exp_centred (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hκ : 0 < κ) (hκ4 : κ ≤ 4) (hX : IsMeasurableKilledDriving W VL VR ζ) {σ : Ω → ℝ≥0}
    (hσ : IsStoppingTime (drivingFiltration P hX) fun ω => (σ ω : WithTop ℝ≥0))
    (hσζ : ∀ᵐ ω ∂P, (σ ω : ℝ≥0∞) < ζ ω) {N : ℝ≥0} (hσN : ∀ ω, σ ω ≤ N)
    (htr : ∀ᵐ ω ∂P, ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace (fun t => W t ω) (ζ ω) η) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR) (forceJumpSet xL xR) u₀)
    (ψ : TestOn upperHalfPlaneOpens) (t : ℝ) :
    P[fun ω => cexp (Complex.I * ((t * centredField h u₀ ω ψ : ℝ) : ℂ)) | hσ.measurableSpace] =ᵐ[P]
      fun ω => cexp (Complex.I * ((t * (P[fun ω => centredField h u₀ ω ψ | hσ.measurableSpace]) ω : ℝ) : ℂ)) *
        ((Real.exp (-(1 / 2) * (t ^ 2 * WangWu.retainedGreenEnergy (W · ω) (σ ω) ψ)) : ℝ) : ℂ) := by
  set c : ℝ := ∫ z, u₀ z * ψ z with hc
  have hcen : ∀ ω, centredField h u₀ ω ψ = h ω ψ - c := fun ω => centredField_apply h hu₀.1 ω ψ
  have e1 : (fun ω => cexp (Complex.I * ((t * centredField h u₀ ω ψ : ℝ) : ℂ))) =
      cexp (-(Complex.I * ((t * c : ℝ) : ℂ))) • fun ω => cexp (Complex.I * ((t * h ω ψ : ℝ) : ℂ)) := by
    funext ω
    rw [Pi.smul_apply, smul_eq_mul, ← Complex.exp_add, hcen]
    congr 1; push_cast; ring
  have hint := integrable_pairing hC ψ
  have hmean : P[fun ω => centredField h u₀ ω ψ | hσ.measurableSpace] =ᵐ[P]
      fun ω => (P[fun ω => h ω ψ | hσ.measurableSpace]) ω - c := by
    have e2 : (fun ω => centredField h u₀ ω ψ) = (fun ω => h ω ψ) - fun _ => c := by
      funext ω; rw [hcen]; rfl
    rw [e2]
    refine (condExp_sub hint (integrable_const c) _).trans ?_
    rw [condExp_const hσ.measurableSpace_le c]
    rfl
  rw [e1]
  filter_upwards [condExp_smul (μ := P) (cexp (-(Complex.I * ((t * c : ℝ) : ℂ))))
    (fun ω => cexp (Complex.I * ((t * h ω ψ : ℝ) : ℂ))) hσ.measurableSpace,
    ae_condExp_exp_eq_gaussCF_of_trace hC hκ hκ4 hX hσ hσζ hσN htr ψ t, hmean] with ω h1 h2 h3
  rw [h1, Pi.smul_apply, smul_eq_mul, h2, h3, gaussCF_eq_mul, ← mul_assoc, ← Complex.exp_add]
  congr 2; push_cast; ring

/-- **The version is harmonic off the label set.** If `h₁(ψ) = E[(h − 𝔥₀)(ψ) | 𝓕_σ]` almost surely for every test, then
almost surely `h₁` is harmonic on every open `V ⊆ ℍ` avoiding `offLabels G`. -/
theorem ae_isHarmonicDistOn_version (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hκ : 0 < κ) (hX : IsMeasurableKilledDriving W VL VR ζ) {σ : Ω → ℝ≥0}
    (hσ : IsStoppingTime (drivingFiltration P hX) fun ω => (σ ω : WithTop ℝ≥0))
    (hσζ : ∀ᵐ ω ∂P, (σ ω : ℝ≥0∞) < ζ ω) {N : ℝ≥0} (hσN : ∀ ω, σ ω ≤ N) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR) (forceJumpSet xL xR) u₀)
    {h₁ : Ω → DistOn upperHalfPlaneOpens}
    (hh₁ : ∀ ψ, (fun ω => h₁ ω ψ) =ᵐ[P] P[fun ω => centredField h u₀ ω ψ | hσ.measurableSpace])
    {G : ℚ × ℚ × ℚ → Set Ω} (hGgood : ∀ ω q, ω ∈ G q → IsGoodBall q)
    (hGall : ∀ᵐ ω ∂P, ∀ q, IsGoodBall q → (ω ∈ G q ↔ IsLabel (W · ω) (closedBall (qCentre q) (qRad q)) (σ ω))) :
    ∀ᵐ ω ∂P, ∀ V : Set ℂ, IsOpen V → V ⊆ H → Disjoint V (offLabels G ω) → IsHarmonicDistOn (h₁ ω) V := by
  -- the Laplacian tests of the generators on a finite union of labelled balls
  have hstep : ∀ (F : Finset (ℚ × ℚ × ℚ)) (k : ℕ × ℕ), ∀ᵐ ω ∂P, (∀ q ∈ F, ω ∈ G q) →
      h₁ ω (lapTest (ballUnion F) (MarkovAsm.toZs (distGen (ballUnion F) k))) = 0 := by
    intro F k
    by_cases hgood : ∀ q ∈ F, IsGoodBall q
    · have hle := ballUnion_le hgood
      set ψf : TestOn upperHalfPlaneOpens := GFF.testIncl (ballUnion F) upperHalfPlaneOpens
        (distGen (ballUnion F) k) with hψf
      have hcoe : (⇑ψf : ℂ → ℝ) = ⇑(distGen (ballUnion F) k) := GFF.coe_testIncl hle _
      have hlap : lapTest (ballUnion F) (MarkovAsm.toZs (distGen (ballUnion F) k)) = lapH ψf :=
        lapTest_eq_lapH hle _ ψf hcoe
      have hsupp : tsupport ψf ⊆ ballUnion F := by
        rw [hcoe]; exact (distGen (ballUnion F) k).tsupport_subset
      have hu0 : ∫ z, u₀ z * lapH ψf z = 0 := by
        rw [coe_lapH]
        exact HarmLoc.integral_mul_cmTest_of_harmonic isOpen_H hu₀.1 _ (ψf.tsupport_subset)
      have hint := integrable_pairing hC (lapH ψf)
      have hcen : (fun ω => centredField h u₀ ω (lapH ψf)) = fun ω => h ω (lapH ψf) := by
        funext ω; rw [centredField_apply h hu₀.1 ω, hu0, sub_zero]
      filter_upwards [hh₁ (lapH ψf), ae_condExp_lapH_eq_zero_of_disjoint (h := h) hC hκ hX hσ hσζ hσN hGgood
        hGall ψf] with ω h1 h2 hF
      rw [hlap, h1, hcen]
      refine h2 (Set.disjoint_left.2 fun z hz hzA => hzA.2 ?_)
      obtain ⟨q, hq, hzq⟩ := mem_iUnion₂.1 (hsupp hz)
      exact mem_iUnion₂.2 ⟨q, hF q hq, hzq⟩
    · refine Eventually.of_forall fun ω hF => absurd (fun q hq => hGgood ω q (hF q hq)) hgood
  filter_upwards [ae_all_iff.2 fun F : Finset (ℚ × ℚ × ℚ) => ae_all_iff.2 (hstep F)] with ω hω V hVo hVH hVd
  -- harmonic on every finite union of labelled balls
  have hharm : ∀ F : Finset (ℚ × ℚ × ℚ), (∀ q ∈ F, ω ∈ G q) → IsHarmonicDistOn (h₁ ω) (ballUnion F) :=
    fun F hF => isHarmonicDistOn_of_lapTest (ballUnion_le fun q hq => hGgood ω q (hF q hq))
      fun k => hω F k hF
  set U' : TopologicalSpace.Opens ℂ := ⟨V, hVo⟩
  refine isHarmonicDistOn_of_lapTest (U := U') hVH fun k => ?_
  set f := MarkovAsm.toZs (distGen U' k)
  have hK : IsCompact (tsupport f.1) := f.2.2.1
  have hcov : tsupport f.1 ⊆ ⋃ q : {q : ℚ × ℚ × ℚ // ω ∈ G q}, ball (qCentre q.1) (qRad q.1) := by
    intro z hz
    have hzV : z ∈ V := f.2.2.2 hz
    by_contra hz'
    refine Set.disjoint_left.1 hVd hzV ⟨hVH hzV, fun hzU => hz' ?_⟩
    obtain ⟨q, hq, hzq⟩ := mem_iUnion₂.1 hzU
    exact mem_iUnion.2 ⟨⟨q, hq⟩, hzq⟩
  obtain ⟨T, hT⟩ := hK.elim_finite_subcover _ (fun _ => isOpen_ball) hcov
  set F : Finset (ℚ × ℚ × ℚ) := T.image Subtype.val
  have hF : ∀ q ∈ F, ω ∈ G q := fun q hq => by
    obtain ⟨q', -, rfl⟩ := Finset.mem_image.1 hq
    exact q'.2
  have hsub : tsupport f.1 ⊆ ballUnion F := fun z hz => by
    obtain ⟨q', hq', hzq⟩ := mem_iUnion₂.1 (hT hz)
    exact mem_iUnion₂.2 ⟨q'.1, Finset.mem_image_of_mem _ hq', hzq⟩
  let f' : MarkovZB.zsSub (ballUnion F : Set ℂ) := ⟨f.1, f.2.1, f.2.2.1, hsub⟩
  have hle := ballUnion_le fun q hq => hGgood ω q (hF q hq)
  rw [lapTest_congr hVH hle f f' rfl]
  exact IsHarmonicDistOn.apply_lapTest_eq_zero (ballUnion F).isOpen (hharm F hF) hle subset_rfl f'

/-- **The retained-range kernel for `0 < κ ≤ 4`** (specification Aux. lemma 16's kernel; follow-up note Part C,
(WF2)). Every coupling satisfying the frozen optional hull specification with `0 < κ ≤ 4` whose driver almost surely has
a continuous generating trace through its lifetime has `HasRetainedRangeKernel`. -/
theorem hasRetainedRangeKernel_of_trace (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hκ : 0 < κ) (hκ4 : κ ≤ 4) (htr : ∀ᵐ ω ∂P, ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace (fun t => W t ω) (ζ ω) η)
    (hX : IsMeasurableKilledDriving W VL VR ζ) : HasRetainedRangeKernel P W VL VR ζ h hX := by
  intro τ hτ hτN hτζ
  obtain ⟨N, hN⟩ := hτN
  have hE := hC.1
  obtain ⟨u₀, hu₀⟩ := exists_bhe κ ρL ρR xL xR
  have hh0 := isZeroBoundaryGFF_centredField hC hu₀
  obtain ⟨h₁, -, hh₁⟩ := exists_condMean_version hh0 hτ.measurableSpace_le
    (q := fun ψ ω => WangWu.retainedGreenEnergy (W · ω) (τ ω) ψ)
    fun ψ t => ae_condExp_exp_centred hC hκ hκ4 hX hτ hτζ hN htr hu₀ ψ t
  obtain ⟨G, -, hGgood, hGall⟩ := exists_labelEvents hE hκ hX hτ hτζ
  have hharm := ae_isHarmonicDistOn_version hC hκ hX hτ hτζ hN hu₀ hh₁ hGgood hGall
  have hu₀c : ContinuousOn u₀ (upperHalfPlaneOpens : Set ℂ) := fun z hz =>
    (hu₀.1 z hz).1.continuousAt.continuousWithinAt
  -- the trace through `τ` agrees with the trace through the lifetime; its range has zero area
  have hrange : ∀ᵐ ω ∂P, ∀ η : ℝ≥0 → ℂ, IsGeneratingTrace (fun t => W t ω) (τ ω) η →
      ∃ ηf : ℝ≥0 → ℂ, IsGeneratingTrace (fun t => W t ω) (ζ ω) ηf ∧ η '' Icc 0 (τ ω) = ηf '' Icc 0 (τ ω) ∧
        volume (ηf '' Icc 0 (τ ω) ∩ H) = 0 := by
    filter_upwards [htr, hE.2.2.2.2, hτζ, hE.ae_dimH_image_inter_H_le hκ (by linarith)] with ω ⟨ηf, hηf⟩ hp hlt
      hdim η hη
    have hwS : ContinuousOn (fun t => W t ω) {s : ℝ≥0 | (s : ℝ≥0∞) < (τ ω : ℝ≥0∞)} :=
      hp.2.2.2.1.mono fun s hs => lt_trans hs hlt
    refine ⟨ηf, hηf, image_congr fun t ht => hη.eq_of_le (hηf.mono_horizon hlt.le) hwS hp.1
      (ENNReal.coe_le_coe.2 ht.2), ?_⟩
    refine volume_eq_zero_of_dimH_lt_two (lt_of_le_of_lt (hdim ηf hηf (Icc 0 (τ ω)) fun s hs =>
      le_trans (ENNReal.coe_le_coe.2 hs.2) hlt.le) ?_)
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by norm_num]
    exact (ENNReal.ofReal_lt_ofReal_iff (by norm_num)).2 (Dimension.interiorDimBound_lt_two (by linarith))
  refine ⟨fun ω => h₁ ω + smoothDist upperHalfPlaneOpens u₀, ?_, fun φ => ?_⟩
  · filter_upwards [hharm, hrange, hE.2.2.2.2, hτζ, hGall] with ω hω hr hp hlt hgω η hη
    obtain ⟨ηf, hηf, himg, -⟩ := hr η hη
    have hoff : offLabels G ω ⊆ η '' Icc 0 (τ ω) := by
      rw [himg]; exact offLabels_subset_image hp.2.2.2.1 hηf hlt fun q hq hl => (hgω q hq).2 hl
    have hcpt : IsCompact (η '' Icc 0 (τ ω)) :=
      isCompact_Icc.image_of_continuousOn (hη.2.1.mono fun t ht => ENNReal.coe_le_coe.2 ht.2)
    have hVo : IsOpen (H \ η '' Icc 0 (τ ω)) := isOpen_H.sdiff hcpt.isClosed
    refine Coupling.IsHarmonicDistOn.add' hVo (hω _ hVo sdiff_subset ?_)
      (IsHarmonicDistOn.mono (isHarmonicDistOn_smoothDist hu₀.1) sdiff_subset)
    exact Set.disjoint_left.2 fun z hz hzA => hz.2 (hoff hzA)
  · have hint := integrable_pairing hC φ
    have hmean : P[fun ω => centredField h u₀ ω φ | hτ.measurableSpace] =ᵐ[P]
        fun ω => (P[fun ω => h ω φ | hτ.measurableSpace]) ω - ∫ z, u₀ z * φ z := by
      have e2 : (fun ω => centredField h u₀ ω φ) = (fun ω => h ω φ) - fun _ => ∫ z, u₀ z * φ z := by
        funext ω; rw [centredField_apply h hu₀.1 ω φ]; rfl
      rw [e2]
      refine (condExp_sub hint (integrable_const _) _).trans ?_
      rw [condExp_const hτ.measurableSpace_le]
      rfl
    filter_upwards [ae_condExp_exp_eq_gaussCF_of_trace hC hκ hκ4 hX hτ hτζ hN htr φ 1, hh₁ φ, hmean, hrange,
      hE.2.2.2.2, hτζ] with ω h1 h2 h3 hr hp hlt η hη
    obtain ⟨ηf, hηf, himg, harea⟩ := hr η hη
    have e1 : (fun ω' => cexp (Complex.I * (h ω' φ : ℂ))) =
        fun ω' => cexp (Complex.I * (((1 : ℝ) * h ω' φ : ℝ) : ℂ)) := by funext ω'; rw [one_mul]
    rw [e1, h1, rangeKerCF, himg, zeroGFFTestCov_compl_image_eq_retainedGreenEnergy hηf hp.2.2.2.1 hp.1
      hlt harea φ, add_apply, h2, h3, smoothDist_apply hu₀c, WangWu.gaussCF]
    have e3 : (∫ x, φ x * u₀ x) = ∫ z, u₀ z * φ z := integral_congr_ae (Eventually.of_forall fun z => mul_comm _ _)
    rw [e3]
    congr 1; push_cast; ring

end Main

universe u

/-- **Aux. lemma 16's kernel with its trace hypothesis, for `0 < κ < 4`** (PROVE-WHOLEFIELD8's named input
`RetainedRangeKernelStatement` with the hypothesis of specification Aux. lemma 16: the evolution is generated by a
continuous trace before its continuation threshold). -/
def RetainedRangeKernelTraceStatement : Prop :=
  ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ {nL nR : ℕ} (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ)
    (ρR : Fin nR → ℝ), IsOrderedForceWord xL xR →
    ∀ {Ω : Type u} {mΩ : MeasurableSpace Ω} (P : Measure Ω) [IsProbabilityMeasure P] (𝓕 : Filtration ℝ≥0 mΩ)
      (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ)
      (ζ : Ω → ℝ≥0∞) (h : Ω → DistOn upperHalfPlaneOpens),
      IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h →
      (∀ᵐ ω ∂P, ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace (fun t => W t ω) (ζ ω) η) →
        ∀ hX : IsMeasurableKilledDriving W VL VR ζ, HasRetainedRangeKernel P W VL VR ζ h hX

/-- **Aux. lemma 16's retained-range kernel for `0 < κ < 4`, proved.** -/
theorem retainedRangeKernelTraceStatement : RetainedRangeKernelTraceStatement.{u} := by
  intro κ hκ hκ4 nL nR xL xR ρL ρR _ Ω mΩ P _ 𝓕 W VL VR B ζ h hC htr hX
  exact hasRetainedRangeKernel_of_trace hC hκ hκ4.le htr hX

/-- **PROVE-WHOLEFIELD8's `RetainedRangeKernelStatement` from trace completeness**: if every ordered word with
`0 < κ < 4` is complete (its evolutions almost surely have a continuous generating trace through the lifetime,
`LP.IsCompleteForceWord`, the conclusion of Theorem 1.3 for the word), the trace hypothesis of Aux. lemma 16 holds for
every coupling. -/
theorem retainedRangeKernelStatement_of_complete
    (hcomp : ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ {nL nR : ℕ} (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ)
      (ρR : Fin nR → ℝ), IsOrderedForceWord xL xR → LP.IsCompleteForceWord.{u} κ xL xR ρL ρR) :
    RetainedRangeKernelStatement.{u} := by
  intro κ hκ hκ4 nL nR xL xR ρL ρR hord Ω mΩ P _ 𝓕 W VL VR B ζ h hC hX
  have htr := hcomp κ hκ hκ4 xL xR ρL ρR hord P 𝓕 W VL VR B ζ hC.1
  exact hasRetainedRangeKernel_of_trace hC hκ hκ4.le
    (htr.mono fun ω hω => by obtain ⟨η, hη, -⟩ := hω; exact ⟨η, hη⟩) hX

end WholeField

