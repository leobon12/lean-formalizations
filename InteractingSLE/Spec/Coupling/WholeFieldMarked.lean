import InteractingSLE.GFF.LocalSets.GermLaw

/-!
# History-marked local sets: the germ law with a retained history (Aux. lemma 18, second paragraph)

Packet PROVE-WHOLEFIELD (ruling R36). Specification §3.2, Aux. lemma 18 (`source/spec/p049-096.md#aux-18`,
`p097-144.md#aux-18-proof`, pp. 96–98): "To obtain the conditional field law with this history retained, repeat
the finite-cover argument from Proposition 3.7 with the stopped history in place of the two set labels. Namely,
take finite-valued shrinking covers `C_n` of `K_τ` … and put `𝓕*_n = σ(stopped history, Q_{C_n} h)`. On each event
`{C_n = C}` the marked criterion says that the projection onto `H(ℍ ∖ C)` has its unchanged zero-boundary law after
conditioning on the history and `Q_C h`. … Reverse martingale convergence … gives this Gaussian kernel … The
intersection contains the stopped history and the hull germ."

Here the history is an arbitrary σ-algebra `ℋ` of marks (the stopped driving history `𝓕_τ` in the application).
The **history-marked avoidance criterion** (`IsHistoryAvoidanceLocal ℋ A h P`, the first conclusion of Aux. lemma 18): for
every deterministic open `U ⊆ ℍ`, every Markov projection `G` onto `H(U)` and every mark `F ∈ ℋ`, the conditional
probability `P[F ∩ {A ∩ U = ∅} | h]` is a measurable function of `h − G h`. With `F = Ω` it is Lemma 3.6 (i).

## Main results

* `indep_markov_histAvoidSigma`: the projection onto `H(W)` is independent of the complementary projection together
  with the marked avoidance events `F ∩ {A ∩ V = ∅}` (`V ⊇ W` open, `F ∈ ℋ`);
* `isCoverMarking_history`: the marking data of the landed cover argument (`IsCoverMarking`) with
  `ℳ = σ(A) ∨ ℋ`;
* `exists_condExp_germSigma_history` (**Aux. lemma 18, the conditional law with the history retained**):
  `E[h(φ) | 𝒜 ∨ ℋ] = M` and `E[e^{i h(φ)} | 𝒜 ∨ ℋ] = e^{iM} e^{−σ²_{ℍ∖A}(φ)/2}`, `M` measurable for the germ
  σ-algebra `𝒜` of `A` alone.

The proofs follow the unmarked ones (`GFF/LocalSets/AvoidIndep.lean`, `CoverLaw.lean`); the only change is that the
avoidance events carry a mark `F ∈ ℋ`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

universe u

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped RealInnerProductSpace ENNReal

namespace InteractingSLE

namespace WholeField

open LocalSets QuantumZipper QuantumZipper.K3 QuantumZipper.Thm11Asm LQGMetric LQGMetric.MarkovZB

/-! ### Marked avoidance events -/

section Sigma

variable {Ω : Type*}

/-- The marked avoidance events `F ∩ {A ∩ V = ∅}` of the open sets `W ⊆ V ⊆ ℍ` and the marks `F ∈ ℋ`. -/
def histAvoidSets (A : Ω → Set ℂ) (ℋ : MeasurableSpace Ω) (W : Set ℂ) : Set (Set Ω) :=
  {E | ∃ V : Set ℂ, ∃ F : Set Ω, IsOpen V ∧ W ⊆ V ∧ V ⊆ H ∧ MeasurableSet[ℋ] F ∧
    E = {ω | Disjoint (A ω) V} ∩ F}

/-- The σ-algebra generated by the marked avoidance events of the open sets containing `W`. -/
@[instance_reducible]
def histAvoidSigma (A : Ω → Set ℂ) (ℋ : MeasurableSpace Ω) (W : Set ℂ) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom (histAvoidSets A ℋ W)

theorem isPiSystem_histAvoidSets (A : Ω → Set ℂ) (ℋ : MeasurableSpace Ω) (W : Set ℂ) :
    IsPiSystem (histAvoidSets A ℋ W) := by
  rintro _ ⟨V, F, hV, hWV, hVH, hF, rfl⟩ _ ⟨V', F', hV', hWV', hVH', hF', rfl⟩ -
  refine ⟨V ∪ V', F ∩ F', hV.union hV', hWV.trans subset_union_left, union_subset hVH hVH',
    hF.inter hF', ?_⟩
  ext ω
  simp only [mem_inter_iff, mem_ofPred_eq, disjoint_union_right]
  tauto

theorem measurableSet_histAvoidSigma {A : Ω → Set ℂ} {ℋ : MeasurableSpace Ω} {W V : Set ℂ}
    (hV : IsOpen V) (hWV : W ⊆ V) (hVH : V ⊆ H) {F : Set Ω} (hF : MeasurableSet[ℋ] F) :
    MeasurableSet[histAvoidSigma A ℋ W] ({ω | Disjoint (A ω) V} ∩ F) :=
  MeasurableSpace.measurableSet_generateFrom ⟨V, F, hV, hWV, hVH, hF, rfl⟩

theorem avoidSigma_le_histAvoidSigma (A : Ω → Set ℂ) (ℋ : MeasurableSpace Ω) (W : Set ℂ) :
    avoidSigma A W ≤ histAvoidSigma A ℋ W := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨V, hV, hWV, hVH, rfl⟩
  simpa using measurableSet_histAvoidSigma (A := A) (ℋ := ℋ) hV hWV hVH
    (@MeasurableSet.univ _ ℋ)

theorem histAvoidSigma_le [mΩ : MeasurableSpace Ω] {A : Ω → Set ℂ} {ℋ : MeasurableSpace Ω}
    (hA : Measurable[mΩ, hittingSigma] A) (hℋ : ℋ ≤ mΩ) (W : Set ℂ) :
    histAvoidSigma A ℋ W ≤ mΩ := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨V, F, hV, -, hVH, hF, rfl⟩
  exact (hA (measurableSet_avoid hV hVH)).inter (hℋ F hF)

end Sigma

/-! ### The history-marked avoidance criterion -/

section Criterion

variable {Ω : Type*} {ℋ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω]

variable (ℋ) in
/-- **History-marked avoidance criterion** (Aux. lemma 18, first conclusion; Lemma 3.6 (i) with marks): for every
deterministic open `U ⊆ ℍ`, every Borel version `G` of the projection onto `H(U)` and every mark `F ∈ ℋ`, the
conditional probability of `F ∩ {A ∩ U = ∅}` given `h` is a measurable function of `h − G h`. -/
def IsHistoryAvoidanceLocal (A : Ω → Set ℂ)
    (h : Ω → DistOn upperHalfPlaneOpens) (P : Measure Ω) : Prop :=
  ∀ (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens),
    (U : Set ℂ) ⊆ H → Measurable G →
      GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P →
      ∀ F : Set Ω, MeasurableSet[ℋ] F →
        ∃ g : DistOn upperHalfPlaneOpens → ℝ, Measurable g ∧
          P⟦{ω | Disjoint (A ω) U} ∩ F | MeasurableSpace.comap h inferInstance⟧ =ᵐ[P]
            fun ω => g (markovCompl G (h ω))

/-- The marked criterion contains the unmarked one (`F = Ω`). -/
theorem IsHistoryAvoidanceLocal.isAvoidanceLocal {A : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} {P : Measure Ω} (hloc : IsHistoryAvoidanceLocal ℋ A h P) :
    IsAvoidanceLocal A h P := by
  intro U G hUH hG hd
  obtain ⟨g, hg, hge⟩ := hloc U G hUH hG hd univ (@MeasurableSet.univ _ ℋ)
  exact ⟨g, hg, by simpa using hge⟩

end Criterion

/-! ### Independence of the projection from the marked avoidance events -/

section KeyIndep

variable {Ω : Type*} {ℋ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- **The basic identity for a marked event**: if the conditional probability of a measurable `E` given `h` is a
function of the projection onto `H^⊥(V)` for an open `V ⊇ W`, then with the Markov decomposition `h = X + Y` on `W`,
`E[1_E e^{iX(Φ)} e^{iY(Ψ)}] = E[e^{iX(Φ)}] E[1_E e^{iY(Ψ)}]`. -/
theorem setIntegral_exp_markov_of_condExp {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) {W V : Opens ℂ} (hWV : W ≤ V)
    (hVH : (V : Set ℂ) ⊆ H)
    {G GV : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P)
    (hdV : GFF.IsMarkovDecomposition V upperHalfPlaneOpens h (fun ω => GV (h ω)) P)
    {E : Set Ω} (hE : MeasurableSet E) {g : DistOn upperHalfPlaneOpens → ℝ} (hg : Measurable g)
    (hge : P⟦E | MeasurableSpace.comap h inferInstance⟧ =ᵐ[P] fun ω => g (markovCompl GV (h ω)))
    (Φ Ψ : TestOn upperHalfPlaneOpens) :
    ∫ ω in E, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      (∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P) *
        ∫ ω in E, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
  have hhm := hh.measurable
  have hVle : V ≤ upperHalfPlaneOpens := hVH
  obtain ⟨Ψ', hΨ', hΨe⟩ := exists_measurable_markovCompl_comp hWV hVle hhm hd hdV
  have hm : MeasurableSpace.comap h inferInstance ≤ mΩ := hhm.comap_le
  have hce : (P⟦E|MeasurableSpace.comap h inferInstance⟧) =ᵐ[P]
      fun ω => g (Ψ' (markovCompl G (h ω))) := by
    filter_upwards [hge, hΨe] with ω h1 h2
    rw [h1, h2]
  set k : DistOn upperHalfPlaneOpens → ℂ := fun T => ((g (Ψ' T) : ℝ) : ℂ)
  have hk : Measurable k := Complex.measurable_ofReal.comp (hg.comp hΨ')
  have hXm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => G (h ω) :=
    hG.comp (comap_measurable h)
  have hYm : Measurable[MeasurableSpace.comap h inferInstance] fun ω => markovCompl G (h ω) :=
    (measurable_markovCompl hG).comp (comap_measurable h)
  have hexp : ∀ (Z : Ω → DistOn upperHalfPlaneOpens) (χ : TestOn upperHalfPlaneOpens),
      Measurable[MeasurableSpace.comap h inferInstance] Z →
        StronglyMeasurable[MeasurableSpace.comap h inferInstance]
          fun ω => Complex.exp (Complex.I * (Z ω χ : ℂ)) :=
    fun Z χ hZ => (@GFF.measurable_exp_I_mul Ω (MeasurableSpace.comap h inferInstance) _
      ((measurable_distOn_apply χ).comp hZ)).stronglyMeasurable
  have hnorm : ∀ x : ℝ, ‖Complex.exp (Complex.I * (x : ℂ))‖ ≤ 1 := fun x =>
    (Complex.norm_exp_I_mul_ofReal x).le
  have hL := setIntegral_eq_integral_condExp_mul (P := P) hm hE
    (W := fun ω => Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)))
    ((hexp _ Φ hXm).mul (hexp _ Ψ hYm)) (C := 1) fun ω => by
      rw [norm_mul]
      exact (mul_le_mul (hnorm _) (hnorm _) (norm_nonneg _) zero_le_one).trans (by norm_num)
  have hR := setIntegral_eq_integral_condExp_mul (P := P) hm hE (hexp _ Ψ hYm) (C := 1)
    fun ω => hnorm _
  rw [hL, hR]
  have e1 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) *
      (Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P =
      ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        (k (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ))) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k, hω]; ring
  have e2 : ∫ ω, ((P⟦E|MeasurableSpace.comap h inferInstance⟧) ω : ℂ) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      ∫ ω, k (markovCompl G (h ω)) * Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hce] with ω hω
    simp only [k, hω]
  rw [e1, e2]
  have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
      Complex.exp (Complex.I * (T Φ : ℂ)))
    (g := fun T : DistOn upperHalfPlaneOpens => k T * Complex.exp (Complex.I * (T Ψ : ℂ)))
    (hG.comp hhm).aemeasurable ((measurable_markovCompl hG).comp hhm).aemeasurable
    (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
    (hk.mul (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ))).aestronglyMeasurable
  simpa [markovCompl] using this

/-- **Independence of the projection onto `H(W)` from the complementary projection and the marked avoidance
events** of the open sets containing `W`, for a set satisfying the history-marked avoidance criterion. -/
theorem indep_markov_histAvoidSigma {A : Ω → Set ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P) (hA : Measurable[mΩ, hittingSigma] A)
    (hℋ : ℋ ≤ mΩ) (hloc : IsHistoryAvoidanceLocal ℋ A h P) {W : Opens ℂ}
    {G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens} (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition W upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    Indep (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance)
      (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance ⊔
        histAvoidSigma A ℋ W) P := by
  have hhm := hh.measurable
  have hXm : Measurable fun ω => G (h ω) := hG.comp hhm
  have hYm : Measurable fun ω => markovCompl G (h ω) := (measurable_markovCompl hG).comp hhm
  have hle := histAvoidSigma_le hA hℋ (W : Set ℂ)
  refine indep_comap_sup_of_setIntegral_exp hXm hYm hle fun Φ Ψ m hm => ?_
  have hXΦ : Measurable fun ω => G (h ω) Φ := (measurable_distOn_apply Φ).comp hXm
  have hYΨ : Measurable fun ω => markovCompl G (h ω) Ψ := (measurable_distOn_apply Ψ).comp hYm
  have hF := integrable_exp_mul_exp (P := P) hXΦ hYΨ
  have hg := GFF.integrable_exp_I_mul (P := P) hYΨ
  set c := ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) ∂P
  have huniv : ∫ ω, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
      Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P := by
    have := hd.indepFun.integral_fun_comp_mul_comp (f := fun T : DistOn upperHalfPlaneOpens =>
        Complex.exp (Complex.I * (T Φ : ℂ)))
      (g := fun T : DistOn upperHalfPlaneOpens => Complex.exp (Complex.I * (T Ψ : ℂ)))
      hXm.aemeasurable hYm.aemeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Φ)).aestronglyMeasurable
      (GFF.measurable_exp_I_mul (measurable_distOn_apply Ψ)).aestronglyMeasurable
    simpa [markovCompl] using this
  refine MeasurableSpace.induction_on_inter (m := histAvoidSigma A ℋ W)
    (C := fun s _ => ∫ ω in s, Complex.exp (Complex.I * (G (h ω) Φ : ℂ)) *
        Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P =
      c * ∫ ω in s, Complex.exp (Complex.I * (markovCompl G (h ω) Ψ : ℂ)) ∂P)
    rfl (isPiSystem_histAvoidSets A ℋ W) (by simp) ?_ ?_ ?_ m hm
  · rintro _ ⟨V, F, hV, hWV, hVH, hFm, rfl⟩
    set V' : Opens ℂ := ⟨V, hV⟩
    have hV'H : (V' : Set ℂ) ⊆ H := hVH
    obtain ⟨GV, hGV, hGVd⟩ := exists_markovMap V' hV'H
    have hdV := hGVd hh
    obtain ⟨g, hgm, hge⟩ := hloc V' GV hV'H hGV hdV F hFm
    exact setIntegral_exp_markov_of_condExp hh (V := V') hWV hV'H hG hd hdV
      ((hA (measurableSet_avoid hV hVH)).inter (hℋ F hFm)) hgm hge Φ Ψ
  · intro t ht hC
    rw [setIntegral_compl (hle t ht) hF, setIntegral_compl (hle t ht) hg, huniv, hC, mul_sub]
  · intro f hdisj hfm hC
    have hfm' : ∀ i, MeasurableSet (f i) := fun i => hle _ (hfm i)
    have h1 := hasSum_integral_iUnion hfm' hdisj hF.integrableOn
    have h2 := (hasSum_integral_iUnion hfm' hdisj hg.integrableOn).mul_left c
    simp_rw [hC] at h1
    exact h1.unique h2

end KeyIndep

/-! ### The marking data and the conditional law with the history retained -/

section Law

variable {Ω : Type u} {ℋ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P] {A : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens}

omit [IsProbabilityMeasure P] in
/-- **The history-marked criterion gives the marking data of the cover argument** with `ℳ = σ(A) ∨ ℋ` and
`𝒮 = histAvoidSigma A ℋ`: on each atom of each cover, every event of `σ(A) ∨ ℋ` is a marked avoidance event of
`W_T` (for a mark `F`, `F ∩ {C_j(A) = ℍ ∖ W_T} = (F ∩ {A ∩ W_j^T = ∅}) ∩ {C_j(A) = ℍ ∖ W_T}`), and the
projection onto `H(W_T)` is independent of the complementary projection and these events. -/
theorem isCoverMarking_history (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA : Measurable[mΩ, hittingSigma] A) (hℋ : ℋ ≤ mΩ) (hloc : IsHistoryAvoidanceLocal ℋ A h P)
    [IsProbabilityMeasure P] :
    IsCoverMarking A h P (MeasurableSpace.comap A hittingSigma ⊔ ℋ) (histAvoidSigma A ℋ) where
  le := sup_le hA.comap_le hℋ
  le_avoid := histAvoidSigma_le hA hℋ
  comap_le := le_sup_left
  trace := by
    intro j T B hB
    by_cases hT : T ⊆ coverIdx j
    · set C := coverAtom j A T
      have hC : MeasurableSet[histAvoidSigma A ℋ (markovOpen T)] C := by
        have := measurableSet_avoidSigma_coverAtom (A := A) j T (MeasurableSet.univ)
        rw [preimage_univ, univ_inter] at this
        exact avoidSigma_le_histAvoidSigma A ℋ _ _ this
      let 𝒯 : MeasurableSpace Ω :=
        { MeasurableSet' := fun B => MeasurableSet[histAvoidSigma A ℋ (markovOpen T)] (B ∩ C)
          measurableSet_empty := by
            rw [empty_inter]; exact @MeasurableSet.empty _ (histAvoidSigma A ℋ (markovOpen T))
          measurableSet_compl := fun B hB' => by
            have e : Bᶜ ∩ C = C \ (B ∩ C) := by
              ext ω; simp only [mem_inter_iff, mem_compl_iff, Set.mem_sdiff]; tauto
            rw [e]
            exact hC.diff hB'
          measurableSet_iUnion := fun f hf => by
            rw [iUnion_inter]
            exact MeasurableSet.iUnion hf }
      have hle : MeasurableSpace.comap A hittingSigma ⊔ ℋ ≤ 𝒯 := by
        refine sup_le ?_ ?_
        · rintro _ ⟨S, hS, rfl⟩
          exact avoidSigma_le_histAvoidSigma A ℋ _ _ (measurableSet_avoidSigma_coverAtom j T hS)
        · intro F hF
          have hsub : ((markovOpen T : Opens ℂ) : Set ℂ) ⊆ coverThick j T :=
            inter_subset_left.trans (coverOpen_subset_coverThick j T)
          have e : F ∩ C = ({ω | Disjoint (A ω) (coverThick j T)} ∩ F) ∩ C := by
            ext ω
            constructor
            · rintro ⟨h1, h2⟩; exact ⟨⟨coverAtom_subset_avoid j A T h2, h1⟩, h2⟩
            · rintro ⟨⟨-, h1⟩, h2⟩; exact ⟨h1, h2⟩
          change MeasurableSet[histAvoidSigma A ℋ (markovOpen T)] (F ∩ C)
          rw [e]
          exact (measurableSet_histAvoidSigma (isOpen_coverThick j T) hsub
            (coverThick_subset_H hT) hF).inter hC
      exact hle B hB
    · rw [coverAtom_eq_empty hT, inter_empty]
      exact @MeasurableSet.empty _ (histAvoidSigma A ℋ (markovOpen T))
  indep T := indep_markov_histAvoidSigma hh hA hℋ hloc (measurable_coverMarkov.{u} T)
    (isMarkovDecomposition_coverMarkov hh T)

/-- **The conditional law of the field given the germ σ-algebra and the retained history** (Aux. lemma 18,
p. 97: "Reverse martingale convergence … gives this Gaussian kernel on `⋂ₙ 𝓕*ₙ`. The intersection contains the
stopped history and the hull germ, and the kernel is measurable from them"). If `A` satisfies the history-marked
avoidance criterion for the marks `ℋ`, then for every test function `φ` there is a germ-measurable `M` with
`E[h(φ) | 𝒜 ∨ ℋ] = M` and `E[e^{i h(φ)} | 𝒜 ∨ ℋ] = e^{iM} e^{−σ²_{ℍ∖A}(φ)/2}`. -/
theorem exists_condExp_germSigma_history (hh : IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hA : Measurable[mΩ, hittingSigma] A) (hℋ : ℋ ≤ mΩ) (hloc : IsHistoryAvoidanceLocal ℋ A h P)
    (hAc : ∀ᵐ ω ∂P, A ω ⊆ H ∧ IsOpen (H \ A ω)) (φ : TestOn upperHalfPlaneOpens) :
    ∃ M : Ω → ℝ, Measurable[germSigma A h] M ∧
      M =ᵐ[P] P[fun ω => h ω φ | germSigma A h ⊔ ℋ] ∧
      (fun ω => Complex.exp (Complex.I * (M ω : ℂ)) *
          ((Real.exp (-(1 / 2) * zeroGFFTestCov (H \ relClosureH (A ω)) φ φ) : ℝ) : ℂ)) =ᵐ[P]
        P[fun ω => Complex.exp (Complex.I * (h ω φ : ℂ)) | germSigma A h ⊔ ℋ] := by
  obtain ⟨M, hM, -, hM1, hM2⟩ :=
    exists_condExp_germSigmaM hh hA (isCoverMarking_history hh hA hℋ hloc) hAc φ
  have e : germSigma A h ⊔ (MeasurableSpace.comap A hittingSigma ⊔ ℋ) = germSigma A h ⊔ ℋ := by
    rw [← sup_assoc, sup_eq_left.2 (comap_le_germSigma A h)]
  rw [e] at hM1 hM2
  exact ⟨M, hM, hM1, hM2⟩

end Law

end WholeField

