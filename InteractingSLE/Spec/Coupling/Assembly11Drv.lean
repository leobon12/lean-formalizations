import InteractingSLE.Spec.Coupling.Assembly11Meas
import InteractingSLE.Spec.Coupling.StopLemma311
import InteractingSLE.Spec.Coupling.SafeFamily

/-!
# The tested mean and the avoidance event at a stopping time of the driving filtration

Packet PROVE-T11-ASM (obligation 5 of `planning/handoffs/PROVE-T11-L312.md` §4). For a stopping time `τ < ζ` of the
frozen `drivingFiltration` (the usual augmentation of the filtration generated by the killed driving process) and a
test function `ψ`, with `τ` read at `τ.untopD 0`:

* `exists_drivingStopped_measurable`: there is an event `E'` of the stopped σ-algebra `𝓕_τ` of the driving
  filtration, contained in the avoidance event `E = {supp ψ ∩ K_τ = ∅}` and almost surely equal to it, on which the
  frozen right-hand side `exp(i (𝔥_τ, ψ) − E_τ(ψ)/2)` is `𝓕_τ`-measurable (for every choice of the bounded harmonic
  extensions `u ω`).

Proof: the safe stops `ρ_n ≤ τ ∧ n` of `supp ψ` for the driving filtration (`exists_safeSeq_of_adapted`); the pair
(tested mean, energy) at `ρ_n` is `𝓕_{ρ_n}`-measurable (`measurable_stoppedPair`), `𝓕_{ρ_n} ⊆ 𝓕_τ`, and
`E' = ⋃ₙ {ρ_n = τ}` on a good event; on `E'` the values at `ρ_n` are eventually those at `τ`.
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology QuantumZipper
open scoped NNReal ENNReal Classical

namespace InteractingSLE

namespace Coupling

open Ito

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {nL nR : ℕ}
  {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

/-! ### The driver is adapted to the killed driving filtration -/

theorem adaptedBefore_killedDriving_W (hX : IsMeasurableKilledDriving W VL VR ζ) :
    AdaptedBefore (killedDrivingFiltration hX) ζ W := fun t A hA =>
  MeasurableSpace.measurableSet_generateFrom ⟨t, le_rfl,
    (fun p : ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) => p.1) ⁻¹' A, measurable_fst hA, by ext ω; simp⟩

theorem adaptedBefore_killedDriving_VL (hX : IsMeasurableKilledDriving W VL VR ζ) (i : Fin nL) :
    AdaptedBefore (killedDrivingFiltration hX) ζ (VL i) := fun t A hA =>
  MeasurableSpace.measurableSet_generateFrom ⟨t, le_rfl,
    (fun p : ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) => p.2.1 i) ⁻¹' A,
    ((measurable_pi_apply i).comp measurable_snd.fst) hA, by ext ω; simp⟩

theorem adaptedBefore_killedDriving_VR (hX : IsMeasurableKilledDriving W VL VR ζ) (i : Fin nR) :
    AdaptedBefore (killedDrivingFiltration hX) ζ (VR i) := fun t A hA =>
  MeasurableSpace.measurableSet_generateFrom ⟨t, le_rfl,
    (fun p : ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) => p.2.2 i) ⁻¹' A,
    ((measurable_pi_apply i).comp measurable_snd.snd) hA, by ext ω; simp⟩

/-! ### Reading a stopping time at `untopD 0` does not change its σ-algebra -/

theorem measurableSet_eq_top_of_isStoppingTime {𝓖 : Filtration ℝ≥0 mΩ} {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime 𝓖 τ) : MeasurableSet {ω | τ ω = ⊤} := by
  have e : {ω | τ ω = ⊤} = ⋂ n : ℕ, {ω | τ ω ≤ (n : ℝ≥0)}ᶜ := by
    ext ω
    simp only [mem_ofPred_eq, mem_iInter, mem_compl_iff, not_le]
    constructor
    · intro h n; rw [h]; exact WithTop.coe_lt_top _
    · intro h
      by_contra hne
      obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.1 hne
      obtain ⟨n, hn⟩ := exists_nat_ge a
      have := h n
      rw [← ha, WithTop.coe_lt_coe] at this
      exact absurd hn (not_le.2 this)
  rw [e]
  exact MeasurableSet.iInter fun n => (𝓖.le _ _ (hτ (n : ℝ≥0))).compl

/-- For a filtration containing the null sets at time `0`, a stopping time that is almost surely finite and its
reading at `untopD 0` have the same stopped σ-algebra. -/
theorem measurableSpace_untopD_eq {𝓖 : Filtration ℝ≥0 mΩ}
    (hnull : ∀ s : Set Ω, MeasurableSet s → P s = 0 → MeasurableSet[𝓖 0] s) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime 𝓖 τ) (hτf : ∀ᵐ ω ∂P, τ ω ≠ ⊤)
    (hτ' : IsStoppingTime 𝓖 fun ω => (((τ ω).untopD 0 : ℝ≥0) : WithTop ℝ≥0)) :
    hτ.measurableSpace = hτ'.measurableSpace := by
  have htop := measurableSet_eq_top_of_isStoppingTime hτ
  have hnull_top : P {ω | τ ω = ⊤} = 0 := by
    exact measure_mono_null (fun ω (h : τ ω = ⊤) => (not_not.2 h : ¬ τ ω ≠ ⊤)) (ae_iff.1 hτf)
  have hsup : ⨆ t, 𝓖 t ≤ mΩ := iSup_le fun t => 𝓖.le t
  have key : ∀ (A : Set Ω), MeasurableSet A → ∀ t : ℝ≥0,
      A ∩ {ω | (((τ ω).untopD 0 : ℝ≥0) : WithTop ℝ≥0) ≤ t} =
        (A ∩ {ω | τ ω ≤ t}) ∪ (A ∩ {ω | τ ω = ⊤}) := fun A _ t => by
    ext ω
    simp only [mem_inter_iff, mem_union, mem_ofPred_eq]
    by_cases h : τ ω = ⊤
    · rw [h, WithTop.untopD_top]
      constructor
      · rintro ⟨hA, -⟩; exact Or.inr ⟨hA, rfl⟩
      · rintro (⟨hA, -⟩ | ⟨hA, -⟩) <;> exact ⟨hA, by exact_mod_cast zero_le (a := t)⟩
    · obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.1 h
      rw [← ha, WithTop.untopD_coe]
      constructor
      · intro h'; exact Or.inl h'
      · rintro (h' | ⟨-, h'⟩)
        · exact h'
        · exact absurd h' WithTop.coe_ne_top
  have hN : ∀ (A : Set Ω), MeasurableSet A → ∀ t : ℝ≥0,
      MeasurableSet[𝓖 t] (A ∩ {ω | τ ω = ⊤}) := fun A hA t =>
    𝓖.mono (zero_le (a := t)) _ (hnull _ (hA.inter htop)
      (measure_mono_null inter_subset_right hnull_top))
  ext A
  rw [IsStoppingTime.measurableSet, IsStoppingTime.measurableSet]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, fun t => ?_⟩
    rw [key A (hsup _ h1) t]
    exact (h2 t).union (hN A (hsup _ h1) t)
  · rintro ⟨h1, h2⟩
    refine ⟨h1, fun t => ?_⟩
    have e : A ∩ {ω | τ ω ≤ t} = (A ∩ {ω | (((τ ω).untopD 0 : ℝ≥0) : WithTop ℝ≥0) ≤ t}) \
        (A ∩ {ω | τ ω = ⊤}) := by
      rw [key A (hsup _ h1) t]
      ext ω
      simp only [mem_union, mem_inter_iff, Set.mem_sdiff, mem_ofPred_eq]
      constructor
      · rintro ⟨hA, hle⟩
        refine ⟨Or.inl ⟨hA, hle⟩, fun ⟨_, htop'⟩ => ?_⟩
        rw [htop'] at hle
        exact absurd hle (not_le.2 (WithTop.coe_lt_top t))
      · rintro ⟨hA | hA, hn⟩
        · exact hA
        · exact absurd hA hn
    rw [e]
    exact (h2 t).diff (hN A (hsup _ h1) t)

/-! ### The frozen right-hand side at a stopping time of the driving filtration -/

/-- The frozen right-hand side `exp(i (𝔥_r, φ) − E_r(φ)/2)` of Theorem 1.1 at the random time `r`, for the
bounded harmonic extensions `u ω`. -/
def frozenRHS (κ : ℝ) (W : ℝ≥0 → Ω → ℝ) (u : Ω → ℂ → ℝ) (φ : ℂ → ℝ) (r : Ω → ℝ≥0) (ω : Ω) : ℂ :=
  Complex.exp (Complex.I * ((∫ z, couplingMean κ (fun s : ℝ => W s.toNNReal ω) (r ω : ℝ≥0) (u ω) z *
      φ z : ℝ) : ℂ) -
    (((1 / 2 : ℝ) * loewnerGreenEnergy (fun s : ℝ => W s.toNNReal ω) (r ω : ℝ≥0) φ : ℝ) : ℂ))

/-- The continuous map `(a, e) ↦ exp(i a − e/2)`. -/
def cfPair (p : ℝ × ℝ) : ℂ := Complex.exp (Complex.I * (p.1 : ℂ) - (((1 / 2 : ℝ) * p.2 : ℝ) : ℂ))

theorem continuous_cfPair : Continuous cfPair := by
  unfold cfPair
  fun_prop

variable {𝓕 : Filtration ℝ≥0 mΩ} {κ : ℝ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {B : ℝ≥0 → Ω → ℝ}

/-- **Measurability for the driving filtration at a frozen stopping time.** For a stopping time `τ < ζ` of the
frozen `drivingFiltration` and a test function `ψ`, there is an event `E'` of `𝓕_τ` (the frozen stopped
σ-algebra), contained in the avoidance event `{supp ψ ∩ K_τ = ∅}` and almost surely containing it, on which the
frozen tested mean does not depend on the bounded harmonic extension, `‖exp(i (𝔥_τ, ψ) − E_τ(ψ)/2)‖ ≤ 1`, and
`1_{E'} exp(i (𝔥_τ, ψ) − E_τ(ψ)/2)` is `𝓕_τ`-measurable. -/
theorem exists_drivingStopped_measurable
    (hE : IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ)
    (hX : IsMeasurableKilledDriving W VL VR ζ) (ψ : LQGMetric.TestOn upperHalfPlaneOpens)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (drivingFiltration P hX) τ)
    (hτζ : ∀ᵐ ω ∂P, (τ ω : ℝ≥0∞) < ζ ω) (u : Ω → ℂ → ℝ)
    (hu : ∀ ω, IsBoundedHarmonicExtension
      (forceBoundaryData κ ρL ρR (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
        (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω))
      (forceJumpSet (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
        (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)) (u ω)) :
    ∃ E' : Set Ω, MeasurableSet[hτ.measurableSpace] E' ∧
      E' ⊆ {ω | Disjoint (tsupport ψ)
        (fwdHull (fun s : ℝ => W s.toNNReal ω) ((τ ω).untopD 0 : ℝ≥0))} ∧
      (∀ᵐ ω ∂P, Disjoint (tsupport ψ)
        (fwdHull (fun s : ℝ => W s.toNNReal ω) ((τ ω).untopD 0 : ℝ≥0)) → ω ∈ E') ∧
      (∀ ω ∈ E', ∀ v : ℂ → ℝ, IsBoundedHarmonicExtension
        (forceBoundaryData κ ρL ρR (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
          (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω))
        (forceJumpSet (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
          (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)) v →
        ∫ z, couplingMean κ (fun s : ℝ => W s.toNNReal ω) ((τ ω).untopD 0 : ℝ≥0) v z * ψ z =
          ∫ z, couplingMean κ (fun s : ℝ => W s.toNNReal ω) ((τ ω).untopD 0 : ℝ≥0) (u ω) z * ψ z) ∧
      (∀ ω ∈ E', ContinuousOn (rpath (W · ω)) (Icc 0 (((τ ω).untopD 0 : ℝ≥0) : ℝ)) ∧ W 0 ω = 0 ∧
        ∀ z ∈ tsupport ψ, ∃ v, IsForwardSol (rpath (W · ω)) z (((τ ω).untopD 0 : ℝ≥0) : ℝ) v) ∧
      StronglyMeasurable[hτ.measurableSpace]
        (E'.indicator (frozenRHS κ W u ψ fun ω => (τ ω).untopD 0)) := by
  set 𝓗 := killedDrivingFiltration hX with h𝓗
  set 𝓓 := drivingFiltration P hX with h𝓓
  have h𝓓u : 𝓓 = usualAugmentation 𝓗 P := rfl
  set τ' : Ω → ℝ≥0 := fun ω => (τ ω).untopD 0 with hτ'def
  have hτf : ∀ᵐ ω ∂P, τ ω ≠ ⊤ := hτζ.mono fun _ h => ne_top_of_lt_zeta h
  have hτ' : IsStoppingTime 𝓓 fun ω => (τ' ω : WithTop ℝ≥0) := isStoppingTime_untopD (𝓕 := 𝓗) hτ hτf
  have hnull : ∀ s : Set Ω, MeasurableSet s → P s = 0 → MeasurableSet[𝓓 0] s := fun s hs h0 =>
    measurableSet_usualAugmentation_of_null (𝓕 := 𝓗) hs h0 0
  have hσeq : hτ.measurableSpace = hτ'.measurableSpace := measurableSpace_untopD_eq hnull hτ hτf hτ'
  have hWa : AdaptedBefore 𝓓 ζ W :=
    adaptedBefore_mono (le_usualAugmentation 𝓗 P) (adaptedBefore_killedDriving_W hX)
  have hVLa : ∀ i, AdaptedBefore 𝓓 ζ (VL i) := fun i =>
    adaptedBefore_mono (le_usualAugmentation 𝓗 P) (adaptedBefore_killedDriving_VL hX i)
  have hVRa : ∀ i, AdaptedBefore 𝓓 ζ (VR i) := fun i =>
    adaptedBefore_mono (le_usualAugmentation 𝓗 P) (adaptedBefore_killedDriving_VR hX i)
  have hpath := hE.2.2.2.2
  have hpath' : ∀ᵐ ω ∂P, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω} ∧ W 0 ω = 0 := by
    filter_upwards [hpath] with ω hP using ⟨hP.2.2.2.1, hP.1⟩
  -- the support of `ψ`
  set K : Set ℂ := tsupport ψ with hKdef
  have hKH : K ⊆ H := tsupport_subset_H ψ
  have hK : IsCompact K := ψ.hasCompactSupport.isCompact
  obtain ⟨m, hm, hKm⟩ := exists_pos_le_im_of_isCompact hK hKH
  -- the truncations `τ ∧ n` and the safe stops below them
  set σ₀ : ℕ → Ω → ℝ≥0 := fun n ω => min (τ' ω) n with hσ₀_def
  have hσ₀ : ∀ n : ℕ, IsStoppingTime 𝓓 fun ω => (σ₀ n ω : WithTop ℝ≥0) := fun n => by
    have h := hτ'.min_const (n : ℝ≥0)
    convert h using 2 with ω
    simp only [hσ₀_def, WithTop.coe_min]
  have hσ₀m : ∀ ω, Monotone fun n => σ₀ n ω := fun ω n n' h =>
    min_le_min le_rfl (by exact_mod_cast h)
  have hσ₀ζ : ∀ n, ∀ᵐ ω ∂P, (σ₀ n ω : ℝ≥0∞) < ζ ω := fun n => by
    filter_upwards [hτζ] with ω h
    exact lt_of_le_of_lt (by exact_mod_cast min_le_left _ _) (coe_untopD_lt_zeta h)
  obtain ⟨ρ, hρst, hρle, hρmono, hρsafe, hρex⟩ := exists_safeSeq_of_adapted (𝓗 := 𝓗) (P := P)
    (adaptedBefore_killedDriving_W hX) hpath' hK hKH hm hKm hσ₀ hσ₀m hσ₀ζ
  -- the good event
  set good : Ω → Prop := fun ω => IsIntegratedSLEPath κ xL xR ρL ρR (fun t => W t ω)
      (fun i t => VL i t ω) (fun i t => VR i t ω) (fun t => B t ω) (ζ ω) ∧
    ((τ' ω : ℝ≥0∞) < ζ ω) ∧
    (∀ n : ℕ, IsSafeAt K (m / ((n : ℝ) + 1)) n (σ₀ n ω) (ζ ω) (W · ω) (ρ n ω)) ∧
    ∀ (j : ℕ) (t : ℝ≥0), t ≤ σ₀ j ω →
      (∀ z ∈ K, ∃ u, IsForwardSol (rpath (W · ω)) z t u) → ∀ᶠ n in atTop, t ≤ ρ n ω with hgood
  have hae : ∀ᵐ ω ∂P, good ω := by
    filter_upwards [hpath, hτζ, ae_all_iff.2 hρsafe, hρex] with ω h1 h2 h3 h4
    exact ⟨h1, coe_untopD_lt_zeta h2, h3, h4⟩
  obtain ⟨G, hGm, hGc, hGgood⟩ : ∃ G : Set Ω, MeasurableSet G ∧ P Gᶜ = 0 ∧ ∀ ω ∈ G, good ω := by
    refine ⟨(toMeasurable P {ω | ¬ good ω})ᶜ, (measurableSet_toMeasurable _ _).compl, ?_,
      fun ω hω => ?_⟩
    · rw [compl_compl, measure_toMeasurable]; exact ae_iff.1 hae
    · by_contra h; exact hω (subset_toMeasurable _ _ h)
  have hG0 : MeasurableSet[𝓓 0] G := by
    have := (hnull _ hGm.compl hGc).compl
    rwa [compl_compl] at this
  have hGae : ∀ᵐ ω ∂P, ω ∈ G := by rw [ae_iff]; exact hGc
  have hGw : ∀ ω ∈ G, ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω} := fun ω hω =>
    (hGgood ω hω).1.2.2.2.1
  have hGv : ∀ ω ∈ G, (∀ i, ContinuousOn (fun t => VL i t ω) {t | (t : ℝ≥0∞) < ζ ω}) ∧
      ∀ i, ContinuousOn (fun t => VR i t ω) {t | (t : ℝ≥0∞) < ζ ω} := fun ω hω =>
    ⟨(hGgood ω hω).1.2.2.2.2.1, (hGgood ω hω).1.2.2.2.2.2.1⟩
  have hδ : ∀ n : ℕ, 0 < m / ((n : ℝ) + 1) := fun n => by positivity
  have hψc : Continuous (ψ : ℂ → ℝ) := ψ.continuous
  -- the stopped pairs
  have hY : ∀ n : ℕ, Measurable[(hρst n).measurableSpace] fun ω => if ω ∈ G then
      ((∫ z, meanCan κ ρL ρR (W · ω) (fun i t => VL i t ω) (fun i t => VR i t ω) (ρ n ω) z * ψ z),
        loewnerGreenEnergy (rpath (W · ω)) (ρ n ω) ψ) else ((0 : ℝ), (0 : ℝ)) := fun n =>
    measurable_stoppedPair hWa hVLa hVRa hGw hGv hG0 hψc ψ.hasCompactSupport hKH (hδ n) (hρst n)
      fun ω hω => (hGgood ω hω).2.2.1 n
  have hle : ∀ n, (hρst n).measurableSpace ≤ hτ'.measurableSpace := fun n =>
    IsStoppingTime.measurableSpace_mono (hρst n) hτ' fun ω =>
      WithTop.coe_le_coe.2 ((hρle n ω).trans (min_le_left _ _))
  -- the events `F n = G ∩ {ρ_n = τ}`
  set F : ℕ → Set Ω := fun n => G ∩ {ω | ρ n ω = τ' ω} with hFdef
  have hGτ : MeasurableSet[hτ'.measurableSpace] G := by
    have h0 := IsStoppingTime.measurableSpace_mono (isStoppingTime_const 𝓓 (0 : ℝ≥0)) hτ'
      (fun ω => WithTop.coe_le_coe.2 (zero_le (a := τ' ω)))
    rw [IsStoppingTime.measurableSpace_const] at h0
    exact h0 _ hG0
  have hF : ∀ n, MeasurableSet[hτ'.measurableSpace] (F n) := fun n => by
    have h := IsStoppingTime.measurableSet_eq_stopping_time hτ' (hρst n)
    have e : {ω | ρ n ω = τ' ω} = {ω | (τ' ω : WithTop ℝ≥0) = (ρ n ω : WithTop ℝ≥0)} := by
      ext ω; simp only [mem_ofPred_eq, WithTop.coe_inj, eq_comm]
    rw [hFdef]; simp only
    rw [e]
    exact hGτ.inter h
  have hFmono : ∀ ω n n', n ≤ n' → ω ∈ F n → ω ∈ F n' := fun ω n n' hnn' ⟨hω, heq⟩ =>
    ⟨hω, le_antisymm ((hρle n' ω).trans (min_le_left _ _)) (heq ▸ hρmono ω hnn')⟩
  -- on `F n`, the support is safe at `τ`
  have hsafeτ : ∀ n, ∀ ω ∈ F n,
      IsSafeAt K (m / ((n : ℝ) + 1)) n (σ₀ n ω) (ζ ω) (W · ω) (τ' ω) := fun n ω ⟨hω, heq⟩ => by
    have := (hGgood ω hω).2.2.1 n
    rwa [heq] at this
  have hmeanEq : ∀ n, ∀ ω ∈ F n, ∀ v : ℂ → ℝ, IsBoundedHarmonicExtension
      (forceBoundaryData κ ρL ρR (fun i => VL i (τ' ω) ω - W (τ' ω) ω)
        (fun i => VR i (τ' ω) ω - W (τ' ω) ω))
      (forceJumpSet (fun i => VL i (τ' ω) ω - W (τ' ω) ω) (fun i => VR i (τ' ω) ω - W (τ' ω) ω)) v →
      ∫ z, couplingMean κ (fun s : ℝ => W s.toNNReal ω) (τ' ω : ℝ≥0) v z * ψ z =
        ∫ z, meanCan κ ρL ρR (W · ω) (fun i t => VL i t ω) (fun i t => VR i t ω) (τ' ω) z * ψ z :=
    fun n ω hωF v hv => by
      have hω := hωF.1
      have hP := (hGgood ω hω).1
      have hτζω := (hGgood ω hω).2.1
      refine integral_congr_ae (ae_of_all _ fun z => ?_)
      by_cases hz : z ∈ K
      · obtain ⟨-, -, -, -, -, -, -, hvLw, hwvR, -⟩ := hP
        have h1 : ∀ i, VL i (τ' ω) ω ≤ W (τ' ω) ω := fun i => hvLw (τ' ω) hτζω i
        have h2 : ∀ i, W (τ' ω) ω ≤ VR i (τ' ω) ω := fun i => hwvR (τ' ω) hτζω i
        have := couplingMean_eq_meanCan (κ := κ) (ρL := ρL) (ρR := ρR) (w := (W · ω))
          (vL := fun i t => VL i t ω) (vR := fun i t => VR i t ω) (s := τ' ω) (z := z)
          (hGw ω hω) hKH (hsafeτ n ω hωF) (hδ n) le_rfl hz h1 h2 hv
        dsimp only
        rw [show (fun s : ℝ => W s.toNNReal ω) = rpath (W · ω) from rfl, this]
      · simp [image_eq_zero_of_notMem_tsupport hz]
  refine ⟨⋃ n, F n, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hσeq]; exact MeasurableSet.iUnion hF
  · -- inside the avoidance event
    rintro ω ⟨_, ⟨n, rfl⟩, hωF⟩
    have hs := hsafeτ n ω hωF
    have hw := hGw ω hωF.1
    refine Set.disjoint_left.2 fun z hz hzK => ?_
    exact notMem_fwdHull_of_alive hw hs.1 (hKH hz) (hs.2.2.2 z hz).1 hzK
  · -- almost surely equal to it
    filter_upwards [hGae] with ω hω hdis
    obtain ⟨hP, hτζω, -, hexh⟩ := hGgood ω hω
    have halive : ∀ z ∈ K, ∃ u, IsForwardSol (rpath (W · ω)) z (τ' ω) u := fun z hz =>
      exists_isForwardSol_of_mem (τ' ω).coe_nonneg ⟨hKH hz, Set.disjoint_left.1 hdis hz⟩
    obtain ⟨j, hj⟩ : ∃ j : ℕ, τ' ω ≤ (j : ℝ≥0) := by
      obtain ⟨j, hj⟩ := exists_nat_ge (τ' ω); exact ⟨j, hj⟩
    have hτj : τ' ω ≤ σ₀ j ω := le_min le_rfl hj
    obtain ⟨n, hn⟩ := (hexh j (τ' ω) hτj halive).exists
    exact mem_iUnion.2 ⟨n, hω, le_antisymm ((hρle n ω).trans (min_le_left _ _)) hn⟩
  · -- the mean does not depend on the bounded harmonic extension
    rintro ω ⟨_, ⟨n, rfl⟩, hωF⟩ v hv
    rw [hmeanEq n ω hωF v hv, hmeanEq n ω hωF (u ω) (hu ω)]
  · -- path facts
    rintro ω ⟨_, ⟨n, rfl⟩, hωF⟩
    have hs := hsafeτ n ω hωF
    exact ⟨continuousOn_rpath (hGw ω hωF.1) hs.1, (hGgood ω hωF.1).1.1,
      fun z hz => (hs.2.2.2 z hz).1⟩
  · -- measurability, as a limit of the values at the safe stops
    rw [hσeq]
    set Z : ℕ → Ω → ℂ := fun n => (F n).indicator fun ω => cfPair (if ω ∈ G then
      ((∫ z, meanCan κ ρL ρR (W · ω) (fun i t => VL i t ω) (fun i t => VR i t ω) (ρ n ω) z * ψ z),
        loewnerGreenEnergy (rpath (W · ω)) (ρ n ω) ψ) else ((0 : ℝ), (0 : ℝ))) with hZ
    have hZm : ∀ n, StronglyMeasurable[hτ'.measurableSpace] (Z n) := fun n =>
      (((continuous_cfPair.measurable.comp (hY n)).mono (hle n) le_rfl).stronglyMeasurable).indicator
        (hF n)
    refine stronglyMeasurable_of_tendsto (m := hτ'.measurableSpace) atTop hZm
      (tendsto_pi_nhds.2 fun ω => ?_)
    by_cases hω : ω ∈ ⋃ n, F n
    · obtain ⟨n₀, hn₀⟩ := mem_iUnion.1 hω
      rw [indicator_of_mem hω]
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_ge_atTop n₀] with n hn
      have hωF := hFmono ω n₀ n hn hn₀
      have hωG : ω ∈ G := hωF.1
      simp only [hZ, indicator_of_mem hωF, hωG, ↓reduceIte, frozenRHS, cfPair]
      rw [hmeanEq n ω hωF (u ω) (hu ω), hωF.2]
      rfl
    · rw [indicator_of_notMem hω]
      have : ∀ n, Z n ω = 0 := fun n => indicator_of_notMem (fun h => hω (mem_iUnion.2 ⟨n, h⟩)) _
      simp only [this]
      exact tendsto_const_nhds

end Coupling

