import InteractingSLE.Spec.Supplement.SB2FlCore

/-!
# The step through one piece for the masked canonical driver, with completed marks

Worker PROVE-SB2-F3LAW (target 1). The step core `Qw.ae_isGFF_stepField` asks the coarse marks to be generated by a
standard-Borel map. Here the coarse marks `𝓜` are only null-equivalent to such a σ-algebra (`comap p ≤ 𝓜 ≤ aeSigma
(comap p)`, e.g. the completed line σ-algebra `Ms.lineFiltC P 𝓖 0` with `𝓖 0 = comap p`), and the offset `x₀`, the word
`β` and the masking event `L` are `𝓜`-measurable. The generator is enlarged to `(p, x₀, β, 1_L)`, which leaves the
conditional kernel unchanged almost surely.

* `canonField` (the field read in `Mo.hullChart (fill K) x₀`), `measurable_canonField`, `canonField_eq_of_transport`;
* **`ae_isGFF_next`**: given `𝓜`, on `L`, the stage field `canonField K x₀` is a GFF with the data of `β`; the
  record of the masked canonical driver is measurable for the finer marks `ℋ`; `A` is marked local for `ℋ`, equal to
  `fill K₂` almost surely on `G ∈ ℋ`, `G ⊆ L` with finite canonical lifetime; the terminal hull identity
  `fill K₂ = fill K ∪ c⁻¹(K_T)` holds where the record is good. Then, given `ℋ`, on `G`, the field read in the new hull
  chart `Mo.hullChart (fill K₂) 0` is a GFF with the data of `Qw.stepWord` of the masked canonical driver.

R48: Theorems 1.2–1.3 appear only as hypotheses (Theorem 1.4).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal
open QuantumZipper (H chiC)
open LQGMetric (DistOn TestOn)

universe u

namespace InteractingSLE.Theorem14.SB.Fl

open Restart Exist Exist.Staged Exist.StagedLaw LocalSets WholeField Qw

/-- The field read in the canonical hull chart `Mo.hullChart (fill K) x₀`. -/
abbrev canonField (κ : ℝ) {Ω : Type*} (h : Ω → DistOn upperHalfPlaneOpens) {K : Ω → Set ℂ} (x₀ : Ω → ℝ)
    (hKc : ∀ ω, IsCompact (K ω)) (hKp : ∀ ω, IsPreconnected (K ω ∪ Restart.lowerHalf)) (ω : Ω) :
    DistOn upperHalfPlaneOpens :=
  Chart.chartTransport (Mu.isConformal_canon x₀ hKc hKp ω) 1 0 (chiC κ) (h ω)

theorem measurable_canonField (κ : ℝ) {Ω : Type*} [mΩ : MeasurableSpace Ω] {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : Measurable h) {K : Ω → Set ℂ} {x₀ : Ω → ℝ} (hKc : ∀ ω, IsCompact (K ω))
    (hKp : ∀ ω, IsPreconnected (K ω ∪ Restart.lowerHalf)) (hK : @IsDyadicHitMeasurable Ω mΩ K)
    (hx₀ : Measurable x₀) : Measurable (canonField κ h x₀ hKc hKp) := by
  obtain ⟨-, hliftc, -, hdom, hfwd, hlift⟩ := @Mt.hullChart_k2Inputs Ω mΩ K x₀ hK hKc hKp hx₀
  exact @Chart.measurable_chartTransport_random' Ω mΩ _ (Mu.isConformal_canon x₀ hKc hKp) hdom hfwd hlift hliftc
    _ hh 1 0 (chiC κ)

/-- The canonical field is the chart transport through the hull chart. -/
theorem isChartTransport_canonField (κ : ℝ) {Ω : Type*} (h : Ω → DistOn upperHalfPlaneOpens) {K : Ω → Set ℂ}
    (x₀ : Ω → ℝ) (hKc : ∀ ω, IsCompact (K ω)) (hKp : ∀ ω, IsPreconnected (K ω ∪ Restart.lowerHalf)) (ω : Ω) :
    IsChartTransport (Mo.hullChart (fillH (K ω)) (x₀ ω)) 1 0 (chiC κ) (h ω) (canonField κ h x₀ hKc hKp ω) :=
  Chart.isChartTransport_chartTransport (Mu.isConformal_canon x₀ hKc hKp ω)
    (Chart.locallyIntegrableOn_of_continuousOn
      (Mu.continuousOn_lift_inv_hullChart (Mo.isHPHull_fillH hKc hKp ω) (x₀ ω))) 1 0 (chiC κ) (h ω)

/-- Any chart transport through the hull chart is the canonical field. -/
theorem canonField_eq_of_transport {κ : ℝ} {Ω : Type*} {h : Ω → DistOn upperHalfPlaneOpens} {K : Ω → Set ℂ}
    {x₀ : Ω → ℝ} (hKc : ∀ ω, IsCompact (K ω)) (hKp : ∀ ω, IsPreconnected (K ω ∪ Restart.lowerHalf)) {ω : Ω}
    {Y : DistOn upperHalfPlaneOpens}
    (hY : IsChartTransport (Mo.hullChart (fillH (K ω)) (x₀ ω)) 1 0 (chiC κ) (h ω) Y) :
    Y = canonField κ h x₀ hKc hKp ω :=
  hY.unique (Mu.isConformal_canon x₀ hKc hKp ω) (isChartTransport_canonField κ h x₀ hKc hKp ω)

/-- **The step through one piece for the masked canonical driver, with completed coarse marks.** See the module
docstring. -/
theorem ae_isGFF_next (h12p : Theorem12ParamStatement.{u}) (h13 : Exist.Theorem13Statement.{u})
    {κ : ℝ} (hκ : 0 < κ) {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} {𝓜 ℋ : MeasurableSpace Ω}
    [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : IsGFFWithBoundaryData P h b jumps) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension b jumps u₀) {S : Type*} [MeasurableSpace S] [StandardBorelSpace S]
    {p : Ω → S} (hp : Measurable p) (h𝓜 : 𝓜 ≤ mΩ) (hp𝓜 : Measurable[𝓜] p)
    (h𝓜p : 𝓜 ≤ aeSigma (MeasurableSpace.comap p inferInstance) P)
    {K : Ω → Set ℂ} (hKc : ∀ ω, IsCompact (K ω)) (hKp : ∀ ω, IsPreconnected (K ω ∪ Restart.lowerHalf))
    (hKm : @IsDyadicHitMeasurable Ω mΩ K) {x₀ : Ω → ℝ} (hx₀ : Measurable[𝓜] x₀) {β : Ω → BoundaryWord}
    (hβ : Measurable[𝓜] β) {L : Set Ω} (hL : MeasurableSet[𝓜] L) {θ : ℝ}
    (hlaw : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → IsGFFWithBoundaryData (condExpKernel P 𝓜 ω₀) (canonField κ h x₀ hKc hKp)
      (β ω₀).fn (β ω₀).jumps)
    (hℋ : ℋ ≤ mΩ) (h𝓜ℋ : 𝓜 ≤ ℋ)
    (hrℋ : Measurable[ℋ] fun ω => recOf ⊤ (maskDrv L (fun ω =>
      driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)) ω))
    {K₂ : Ω → Set ℂ} (hK₂m : @IsDyadicHitMeasurable Ω ℋ K₂) (hK₂c : ∀ ω, IsCompact (K₂ ω))
    (hK₂p : ∀ ω, IsPreconnected (K₂ ω ∪ Restart.lowerHalf)) {A : Ω → Set ℂ}
    (hAm : Measurable[mΩ, hittingSigma] A) (hAc : ∀ ω, A ω ⊆ H ∧ IsOpen (H \ A ω))
    (hAloc : IsHistoryAvoidanceLocal ℋ A (centredField h u₀) P) (hAl : IsLocalSet A (centredField h u₀) P)
    {G : Set Ω} (hG : MeasurableSet[ℋ] G) (hGL : G ⊆ L)
    (hGζ : ∀ ω ∈ G, (driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)).2 ≠ ⊤)
    (hGA : ∀ᵐ ω ∂P, ω ∈ G → A ω = fillH (K₂ ω))
    (hK₂ : ∀ᵐ ω ∂P, ω ∈ G →
      LocalExt.IsDrvGood (recHist (recOf ⊤ (driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)))) →
      fillH (K₂ ω) = stepHull (fillH (K ω)) (x₀ ω) (recDrv (driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)))
        ((driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)).2.toNNReal : ℝ)) :
    ∀ᵐ ω₀ ∂P, ω₀ ∈ G → IsGFFWithBoundaryData (condExpKernel P ℋ ω₀)
      (canonField κ h (fun _ => (0 : ℝ)) hK₂c hK₂p)
      (stepWord κ θ x₀ β (maskDrv L fun ω => driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)) ω₀).fn
      (stepWord κ θ x₀ β (maskDrv L fun ω => driverOf h12p hκ θ (β ω, canonField κ h x₀ hKc hKp ω)) ω₀).jumps := by
  classical
  set Z := canonField κ h x₀ hKc hKp with hZdef
  set e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞ := fun ω => driverOf h12p hκ θ (β ω, Z ω) with hedef
  set e' := maskDrv L e with he'def
  -- the enlarged generator
  set p' : Ω → S × ℝ × BoundaryWord × ℝ := fun ω => (p ω, x₀ ω, β ω, L.indicator (fun _ => (1 : ℝ)) ω)
    with hp'def
  have hx₀m : Measurable x₀ := hx₀.mono h𝓜 le_rfl
  have hβm : Measurable β := hβ.mono h𝓜 le_rfl
  have hLm : MeasurableSet L := h𝓜 _ hL
  have hp'm : Measurable p' := hp.prodMk (hx₀m.prodMk (hβm.prodMk (measurable_const.indicator hLm)))
  have hp'𝓜 : Measurable[𝓜] p' := hp𝓜.prodMk (hx₀.prodMk (hβ.prodMk (measurable_const.indicator hL)))
  have hP'𝓜 : MeasurableSpace.comap p' inferInstance ≤ 𝓜 := hp'𝓜.comap_le
  have hP'Ω : MeasurableSpace.comap p' inferInstance ≤ mΩ := hp'm.comap_le
  have hpP' : MeasurableSpace.comap p inferInstance ≤ MeasurableSpace.comap p' inferInstance :=
    (measurable_fst.comp (Measurable.of_comap_le le_rfl : Measurable[MeasurableSpace.comap p' inferInstance] p')
      ).comap_le
  have hk := KernelTower.ae_condExpKernel_eq_of_le_aeSigma (P := P) h𝓜 hP'Ω
    (h𝓜p.trans (Sec7.Lemma71L.aeSigma_mono P hpP')) (hP'𝓜.trans (le_aeSigma 𝓜 P))
  have hp'meas : Measurable[MeasurableSpace.comap p' inferInstance] p' := Measurable.of_comap_le le_rfl
  have hx₀' : Measurable[MeasurableSpace.comap p' inferInstance] x₀ := measurable_fst.comp (measurable_snd.comp hp'meas)
  have hβ' : Measurable[MeasurableSpace.comap p' inferInstance] β :=
    measurable_fst.comp (measurable_snd.comp (measurable_snd.comp hp'meas))
  have hL' : MeasurableSet[MeasurableSpace.comap p' inferInstance] L := by
    have hi : Measurable[MeasurableSpace.comap p' inferInstance] (L.indicator fun _ => (1 : ℝ)) :=
      measurable_snd.comp (measurable_snd.comp (measurable_snd.comp hp'meas))
    have e1 : L = (L.indicator fun _ => (1 : ℝ)) ⁻¹' {1} := by
      ext ω
      by_cases hω : ω ∈ L <;> simp [hω]
    rw [e1]
    exact hi (measurableSet_singleton 1)
  have hZm : Measurable Z := measurable_canonField κ hh.1 hKc hKp hKm hx₀m
  have hlaw' : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → IsGFFWithBoundaryData
      (condExpKernel P (MeasurableSpace.comap p' inferInstance) ω₀) Z (β ω₀).fn (β ω₀).jumps :=
    ae_isGFF_of_kernel_eq hk hlaw
  have hfl := ae_isFlowLineDriver_maskDrv h12p h13 hκ θ hP'Ω hβ' hZm hL' hlaw'
  have hem : Measurable e := (measurable_driverOf h12p hκ θ).comp (hβm.prodMk hZm)
  have he'm : Measurable e' := measurable_maskDrv hLm hem
  have hreg : ∀ ω, IsRegularDriver (e' ω) :=
    isRegularDriver_maskDrv (fun ω => Mz.isRegularDriver_driverOf h12p hκ θ _)
  have hpℋ : Measurable[ℋ] p' := hp'𝓜.mono h𝓜ℋ le_rfl
  have hGζ' : ∀ ω ∈ G, (e' ω).2 ≠ ⊤ := fun ω hω => by
    rw [he'def, maskDrv_of_mem (hGL hω)]; exact hGζ ω hω
  -- goodness of the record, almost surely on `L` with finite lifetime
  have hgood : ∀ᵐ ω ∂P, ω ∈ L → ω ∈ {ω | (e' ω).2 ≠ ⊤ → LocalExt.IsDrvGood (recHist (recOf ⊤ (e' ω)))} := by
    have hr : Measurable fun ω => recOf ⊤ (e' ω) := measurable_recOf he'm hreg ⊤
    have hF : MeasurableSet {ω | (e' ω).2 ≠ ⊤} := (measurableSet_eq_fun (measurable_snd.comp he'm)
      measurable_const).compl
    have hGd : MeasurableSet {ω | LocalExt.IsDrvGood (recHist (recOf ⊤ (e' ω)))} :=
      LocalExt.measurableSet_isDrvGood.preimage (measurable_recHist.comp hr)
    refine GW2Schedule.ae_of_ae_condExpKernel_on hP'Ω hL' ((hF.compl.union hGd).congr ?_) ?_
    · ext ω; simp only [mem_union, mem_compl_iff, mem_ofPred_eq]; tauto
    · filter_upwards [hfl] with ω₀ hfl₀ hω₀
      filter_upwards [ae_isDrvGood_of_isFlowLineDriver hκ ⊤ hreg (hfl₀ hω₀)] with ω hω hfin
      exact hω (by rwa [min_eq_right le_top])
  -- the field after the piece, read in the new hull chart
  have hYt₂ : ∀ᵐ ω ∂P, ω ∈ G → LocalExt.IsDrvGood (recHist (recOf ⊤ (e' ω))) →
      IsChartTransport (Mo.hullChart (fillH (K₂ ω)) 0) 1 0 (chiC κ) (h ω) (stepField κ x₀ e' Z ω) := by
    filter_upwards [hK₂] with ω hK₂ω hωG hg
    have hmL : e' ω = e ω := maskDrv_of_mem (hGL hωG)
    rw [hmL] at hg
    exact isChartTransport_stepField (K := fun ω => fillH (K ω)) (Mo.isHPHull_fillH hKc hKp ω)
      (isChartTransport_canonField κ h x₀ hKc hKp ω) (hreg ω) (by rw [hmL]; exact hg)
      (by rw [hmL]; exact hK₂ω hωG hg)
  have hstep := ae_isGFF_stepField hκ hh hu₀ hp'm hℋ hpℋ hβ' hZm he'm hreg hrℋ hL' hfl hx₀' hK₂m hK₂c hK₂p hAm hAc
    hAloc hAl hG hGL hGζ' hGA hYt₂
  -- the field after the piece is the canonical field of the new hull
  have hK₂Ω : @IsDyadicHitMeasurable Ω mΩ K₂ := fun n j => hℋ _ (hK₂m n j)
  refine ae_isGFF_congr_on hℋ hG (measurable_canonField κ hh.1 hK₂c hK₂p hK₂Ω measurable_const) hstep ?_
  filter_upwards [hgood, hYt₂] with ω hgω hYω hωG
  exact canonField_eq_of_transport (x₀ := fun _ => (0 : ℝ)) hK₂c hK₂p
    (hYω hωG (hgω (hGL hωG) (hGζ' ω hωG)))

end InteractingSLE.Theorem14.SB.Fl
