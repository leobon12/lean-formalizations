/-!
# GW2's tip exhaustion: the joint chart at a counterflow stop and its pre-contact kernel

Packet PROVE-T14-TIP9. Theorem GB9's proof (supplement p. 524–525, `source/spec/p481-528.md` L1059–L1067) and follow-up
note A (`source/external/AstraIG1/ig1_followup_a_e_audited.txt`, A.4–A.5, ruling R53) work in the **joint chart** of a
counterflow stop: "Fix a bounded original counterflow stopping time `r`, on its event of an interior current tip `p`
… Map its actual active component to `ℍ` by `ψ`, taking `(x, p)` to `(0, ∞)` … Its inverse extends continuously at
infinity with physical value `p`."

For the centred counterflow (`IsCenteredCounterflowDriver`: the driver `W'` generates, in the inverted picture
`z ↦ −1/z`, a trace `γ` from `0` to `∞`), the physical counterflow at own time `s` is `−1/γ`, its physical tip is
`p = −1/γ(s)`, and the joint chart is explicit: `ψ(z) = −1/f_s(−1/z)` (`f_s` the centred Loewner map of `W'`), i.e. the
inversion followed by the counterflow's own-component chart (`ownComponentChart`). It is GB6's relative map with the
roles of the two curves exchanged (`ψ = Supp8.GB6.relMap W' s`). This file proves:

* `isDomainChart_jointChart`: `ψ` is a chart of the physical complement `−1/(ℍ \ K_s)` of the counterflow hull;
* `tendsto_jointChart_inv_tip`: its inverse tends to the physical tip `p` at `∞` (GB9: "Its inverse extends
  continuously at infinity with physical value `p`");
* `mem_closure_of_not_isBounded_jointChart`: a set of physical points in the domain whose joint-chart image is
  unbounded accumulates at `p` (GB9, p. 526: "Unbounded points in the `ψ` chart pull back to `p`"; follow-up A.5) —
  the last step of the exhaustion.

It also states the **pre-contact kernel** of GB9 (p. 525: "Before a new flow prefix first meets the retained
counterflow, the conditional exploration has its full canonical word in this joint chart … This identifies the full
field–path kernel") as the named input `GW2JointKernelStatement`, in the (R1)/(Det) form of its mirror image,
Proposition GB6's `Supp8.GB6.GB6CondDetStatement` (the flow prefix retained and the counterflow read in the flow's
chart). See the statement's docstring for what it needs.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal
open QuantumZipper (H)

universe u

namespace InteractingSLE

namespace Theorem14

namespace GW2JointKernel

open Restart Sec2.Assembly LQGMetric Supp8.GB6

/-! ### The joint chart -/

/-- **The joint chart at a counterflow stop**, in physical coordinates: the inversion `z ↦ −1/z` (physical picture to
the counterflow's own picture) followed by the counterflow's own-component chart `w ↦ −1/f_s(w)` at own time `s`. It
sends the physical root `0` to `0` and the physical tip `−1/γ(s)` to `∞`. -/
def jointChart (w : ℝ → ℝ) (s : ℝ) : Chart := infinitySourceChart.trans (ownComponentChart w s)

/-- The forward joint chart is GB6's relative map with the roles of the two curves exchanged. -/
theorem jointChart_fst (w : ℝ → ℝ) (s : ℝ) (z : ℂ) : (jointChart w s).1 z = relMap w s z := rfl

/-- The inverse joint chart: `v ↦ −1/f_s⁻¹(−1/v)`. -/
theorem jointChart_inv (w : ℝ → ℝ) (s : ℝ) (v : ℂ) :
    (jointChart w s).2.1 v = -(QuantumZipper.fwdMapInv w s (-v⁻¹))⁻¹ := rfl

/-- **The joint chart is a chart of the physical complement of the counterflow hull** `−1/(ℍ \ K_s)`. -/
theorem isDomainChart_jointChart {w : ℝ → ℝ} (hw : Continuous w) (hw0 : w 0 = 0) {s : ℝ} (hs : 0 ≤ s) :
    IsDomainChart ((fun z : ℂ => -z⁻¹) '' (H \ QuantumZipper.fwdHull w s)) (jointChart w s) :=
  isDomainChart_infinitySourceChart.trans (isDomainChart_ownComponentChart hw hw0 hs)

/-- **The inverse joint chart tends to the physical tip at `∞`** (GB9, p. 524: "Its inverse extends continuously at
infinity with physical value `p`"): for a trace `γ` generated by `w` before `T` and an own time `s < T` with
`γ(s) ≠ 0`, `ψ⁻¹(v) → −1/γ(s)` as `v → ∞` in `ℍ`. -/
theorem tendsto_jointChart_inv_tip {w : ℝ≥0 → ℝ} {T : ℝ≥0∞} {γ : ℝ≥0 → ℂ} (hγ : IsGeneratingTrace w T γ)
    (hw : ContinuousOn w {s | (s : ℝ≥0∞) < T}) (hw0 : w 0 = 0) {s : ℝ≥0} (hs : (s : ℝ≥0∞) < T)
    (hγs : γ s ≠ 0) :
    Tendsto (jointChart (fun r : ℝ => w r.toNNReal) s).2.1 (Bornology.cobounded ℂ ⊓ 𝓟 H)
      (𝓝 (-(γ s)⁻¹)) := by
  have hR : ContinuousAt (fun z : ℂ => -z⁻¹) (γ s) := (continuousAt_inv₀ hγs).neg
  exact hR.tendsto.comp (tendsto_ownComponentChart_inv_tip hγ hw hw0 hs)

/-- **Unbounded joint-chart images accumulate at the physical tip** (GB9, p. 526: "Unbounded points in the `ψ` chart
pull back to `p` by continuity of `ψ⁻¹` at infinity"; follow-up note A.5: "The inverse chart sends points tending to
infinity to `p`"). If `A` lies in the physical domain of the joint chart and `ψ(A)` is unbounded, then the physical tip
`−1/γ(s)` lies in the closure of `A`. -/
theorem mem_closure_of_not_isBounded_jointChart {w : ℝ≥0 → ℝ} {T : ℝ≥0∞} {γ : ℝ≥0 → ℂ}
    (hγ : IsGeneratingTrace w T γ) (hwc : ContinuousOn w {s | (s : ℝ≥0∞) < T}) (hw0 : w 0 = 0) {s : ℝ≥0}
    (hs : (s : ℝ≥0∞) < T) (hγs : γ s ≠ 0)
    (hW : Continuous fun r : ℝ => w r.toNNReal) {A : Set ℂ}
    (hA : A ⊆ (fun z : ℂ => -z⁻¹) '' (H \ QuantumZipper.fwdHull (fun r : ℝ => w r.toNNReal) s))
    (hunb : ¬ Bornology.IsBounded ((jointChart (fun r : ℝ => w r.toNNReal) s).1 '' A)) :
    -(γ s)⁻¹ ∈ closure A := by
  have hc := isDomainChart_jointChart hW (by simpa using hw0) s.2
  have hsub : (jointChart (fun r : ℝ => w r.toNNReal) s).1 '' A ⊆ H := by
    rintro _ ⟨z, hz, rfl⟩
    exact hc.fwd_mem (hA hz)
  have himg : (jointChart (fun r : ℝ => w r.toNNReal) s).2.1 ''
      ((jointChart (fun r : ℝ => w r.toNNReal) s).1 '' A) = A := by
    rw [image_image]
    conv_rhs => rw [← image_id A]
    exact image_congr fun z hz => hc.inv_fwd (hA hz)
  have h := Supp8.GB9Cap.mem_closure_image_of_tendsto_cobounded
    (tendsto_jointChart_inv_tip hγ hwc hw0 hs hγs) hsub hunb
  rwa [himg] at h

/-! ### The pre-contact kernel (named input) -/

/-- **Named input: GB9's pre-contact kernel at a counterflow stop, (R1) and (Det) form** (supplement p. 525: "Before a
new flow prefix first meets the retained counterflow, the conditional exploration has its full canonical word in this
joint chart. … This identifies the full field–path kernel. Fixed-hull restriction on positive-separation buffers gives
the continuous relative Loewner driver and its strictly increasing adapted clock"; follow-up note A.4: "The actual
piece is identified through the outer buffer by the precontact kernel"). It is the mirror image of Proposition GB6's
named input (d), `Supp8.GB6.GB6CondDetStatement`, with the roles of the two curves exchanged: there the flow prefix is
retained and the counterflow is read in the flow's own chart; here the counterflow prefix is retained (through own time
`s`) and the flow line is read in the counterflow's joint chart `jointChart W s`.

Binders of `GB6CondDetStatement` (verbatim: a GFF `h` with piecewise-constant data, its centred counterflow `W` at
`16/κ` with admissible word, complete transient trace `γ`, and a flow line `Wα` of angle `θ ∈ [−π/2, π/2]` with
generating trace `α`), a counterflow own time `s`, **any** measurable version `Hc` of the field `h` read in the joint
chart (flow-line transport, almost surely on the interior-tip event `γ(s) ∈ ℍ`), and **any** canonical driver code `F`
of the flow line at angle `θ` (`Restart.IsCanonicalDriverCode κ θ F`). There are a sub-σ-algebra `𝒢` (the retained
counterflow history), a `𝒢`-event `M` and a `𝒢`-measurable conditional word `β` such that:

* on `M`: `β` is sorted and the canonical driver code `F (β, Hc)` of the conditional field is good;
* **(R1)** on `M`, conditionally on `𝒢`, `Hc` has the Gaussian characteristic functional of the GFF with word `β`
  ("The conditional field has a finite-piece mean", p. 524);
* **(Det)** almost surely on `{γ(s) ∈ ℍ}`: `ω ∈ M`, and **before the flow's first contact** with the physical
  counterflow prefix `−1/γ([0, s])`, the canonical flow line of the conditional field (decoded from `F (β, Hc)`)
  generates the joint-chart images `ψ(K^α_t)` of the physical flow hulls in the relative clock (`relClock`).

**Why it is a named input (the obstruction).** Its proof needs the conditional law of the field given **both** the
counterflow history and the flow prefix (the union of the two hulls as a local set, with the canonical word as its
mean in the joint chart), and the identification of the field-determined flow line with the flow line of the
conditional field up to first contact (flow-line locality, `RLC.FlowLocalityStatement`, itself open; PROVE-RLC-D). The
stopped K2 (`Restart.StoppedK2.ae_isStoppedHullCoupling_k`, PROVE-STOPPEDK2) supplies the (Det) clause **from** these
inputs ((E-stop), the safe law `HasSafeLaw` and the safe members `HasSafeMembers` of the continuation in the joint
chart, with an announcing sequence of the first-contact stop); the safe law and members are the missing two-curve
statements. The mirror statement `GB6CondDetStatement` is open for the same reason. -/
def GW2JointKernelStatement : Prop :=
  ∀ (κ θ : ℝ), 0 < κ → κ < 4 → -(Real.pi / 2) ≤ θ → θ ≤ Real.pi / 2 →
  ∀ (Ω : Type u) (mΩ : MeasurableSpace Ω) (P : Measure Ω), IsProbabilityMeasure P →
  ∀ (h : Ω → LQGMetric.DistOn upperHalfPlaneOpens) (b : ℝ → ℝ) (J : Finset ℝ)
    (W Wα : ℝ≥0 → Ω → ℝ) (ζ ζα : Ω → ℝ≥0∞) (γ α : Ω → ℝ≥0 → ℂ)
    (b' : ℝ → ℝ) (J' : Finset ℝ) (h' : Ω → LQGMetric.DistOn upperHalfPlaneOpens),
    IsPiecewiseConstantBoundaryData b J → IsGFFWithBoundaryData P h b J →
    IsPiecewiseConstantBoundaryData b' J' →
    (∀ ω, IsChartTransport infinitySourceChart (-1) (-(Real.pi * QuantumZipper.chiC κ))
      (QuantumZipper.chiC (16 / κ)) (h ω) (h' ω)) →
    IsFlowLineDriver (16 / κ) b' J' 0 P h' W ζ →
    (∀ i : Fin (flowLineNL b' J' 0),
      -2 < ∑ l ∈ Finset.univ.filter (fun l => l ≤ i), flowLineRhoL (16 / κ) b' J' 0 0 l) →
    (∀ i : Fin (flowLineNR b' J' 0),
      -2 < ∑ l ∈ Finset.univ.filter (fun l => l ≤ i), flowLineRhoR (16 / κ) b' J' 0 0 l) →
    (∀ᵐ ω ∂P, ζ ω = ⊤ ∧ IsGeneratingTrace (fun t => W t ω) ⊤ (γ ω) ∧
      Tendsto (fun t => ‖γ ω t‖) atTop atTop) →
    IsFlowLineDriver κ b J θ P h Wα ζα →
    (∀ᵐ ω ∂P, IsGeneratingTrace (fun t => Wα t ω) (ζα ω) (α ω)) →
    ∀ (s : ℝ≥0) (Hc : Ω → LQGMetric.DistOn upperHalfPlaneOpens), Measurable Hc →
    (∀ᵐ ω ∂P, γ ω s ∈ H →
      IsChartTransport (jointChart (fun r : ℝ => W r.toNNReal ω) s) 1 0 (QuantumZipper.chiC κ) (h ω) (Hc ω)) →
    ∀ F : BoundaryWord × LQGMetric.DistOn upperHalfPlaneOpens → PCode × ℝ≥0∞, IsCanonicalDriverCode κ θ F →
    ∃ (𝒢 : {m : MeasurableSpace Ω // m ≤ mΩ}) (M : Set Ω) (β : Ω → BoundaryWord),
      MeasurableSet[𝒢.1] M ∧ Measurable[𝒢.1] β ∧
      (∀ᵐ ω ∂P, ω ∈ M → (β ω).IsSorted ∧ IsGoodDrvCode (F (β ω, Hc ω))) ∧
      (∀ φ : LQGMetric.TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ω ∈ M →
        P[fun ω' => Complex.exp (Complex.I * (Hc ω' φ : ℂ)) | 𝒢.1] ω = gaussCF (β ω) φ) ∧
      ∀ᵐ ω ∂P, γ ω s ∈ H →
        ω ∈ M ∧
        ∀ t : ℝ≥0, (t : ℝ≥0∞) < firstContactTime (fun t => (α ω t : OnePoint ℂ))
            ((fun r => sphereInv (γ ω r : OnePoint ℂ)) '' Icc 0 s) →
          QuantumZipper.fwdHull (fun r : ℝ => drvDec (F (β ω, Hc ω)) r.toNNReal)
              (relClock (fun r : ℝ => W r.toNNReal ω) s (fun r : ℝ => Wα r.toNNReal ω) t) =
            relMap (fun r : ℝ => W r.toNNReal ω) s '' QuantumZipper.fwdHull (fun r : ℝ => Wα r.toNNReal ω) t

end GW2JointKernel

