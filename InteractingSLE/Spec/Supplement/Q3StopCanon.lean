/-!
# GB6's canonical relative space: the record, the relative driver and the stop

Packet PROVE-Q3-REL4 (step (D)). The stopped K2 needs a standard Borel space; GB6's probability space is arbitrary.
The joint law of the record of the flow prefix and GB6's relative variable `(Hc, R, V)` lives on the standard Borel
space `CanonSpace = RecData × RelSpace`. This file sets up that space:

* the coordinates `canonDrv` (the decoded relative driver), `canonStp` (the stop), `canonFld` (the chart field);
* **`canonFilt`**: the filtration generated by the record (at time `0`), the driver on `[0, t]` and the events
  `{stop ≤ u}`, `u ≤ t` (Astra's (Q3.2): `G_u = σ(R, η̃[0, u] with its driving history)`);
* `measurableSet_canonFilt_of_detUpTo`: a (record, path) event determined by the path on `[0, t]` is an event of
  `canonFilt t`;
* `hasSafeLaw_map`, `hasSafeMembers_map`: K2's inputs (S) and (L) pass from a probability space to the image law of
  a measurable map, for the pulled-back filtration; `hasSafeLaw_cond`, `hasSafeMembers_cond`: and to the law
  conditioned on the live event (with the live event replaced by everything).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology
open scoped NNReal ENNReal
open LQGMetric (TestOn DistOn)
open QuantumZipper (H fwdHull)

namespace InteractingSLE.Supp8.Q3Stop

open Restart Restart.DomainMarkov Restart.DomainMarkov.K2 Exist.StagedLaw Supp8.GB6.RelDrv

/-! ### The canonical space and its filtration -/

/-- **GB6's canonical relative space**: the record of the flow prefix and the relative variable. -/
abbrev CanonSpace : Type := RecData × RelSpace

/-- The relative driver coordinate. -/
def canonDrv (t : ℝ≥0) (y : CanonSpace) : ℝ := relDrv t y.2

/-- The stop coordinate. -/
def canonStp (y : CanonSpace) : ℝ≥0∞ := relStp y.2

/-- The chart field coordinate. -/
def canonFld (y : CanonSpace) : DistOn upperHalfPlaneOpens := relFld y.2

theorem measurable_canonDrv (t : ℝ≥0) : Measurable (canonDrv t) := (measurable_relDrv t).comp measurable_snd

theorem measurable_canonStp : Measurable canonStp := measurable_relStp.comp measurable_snd

theorem measurable_canonFld : Measurable canonFld := measurable_relFld.comp measurable_snd

theorem canonDrv_zero (y : CanonSpace) : canonDrv 0 y = 0 := Restart.FCDet.decDrv_zero _

theorem continuous_canonDrv (y : CanonSpace) : Continuous fun t => canonDrv t y :=
  Restart.FCDet.continuous_decDrv _

/-- The σ-algebra at time `t` of the canonical filtration: the record, the driver on `[0, t]` and the events
`{stop ≤ u}`, `u ≤ t`. -/
@[instance_reducible]
def canonSigma (t : ℝ≥0) : MeasurableSpace CanonSpace :=
  MeasurableSpace.comap Prod.fst inferInstance ⊔
    ⨆ (u : ℝ≥0) (_ : u ≤ t), (MeasurableSpace.comap (canonDrv u) inferInstance ⊔
      MeasurableSpace.generateFrom {{y | canonStp y ≤ (u : ℝ≥0∞)}})

theorem canonSigma_le (t : ℝ≥0) : canonSigma t ≤ (inferInstance : MeasurableSpace CanonSpace) :=
  sup_le measurable_fst.comap_le (iSup₂_le fun u _ => sup_le (measurable_canonDrv u).comap_le
    (MeasurableSpace.generateFrom_le fun _ hs => by
      rw [mem_singleton_iff.1 hs]
      exact measurableSet_le measurable_canonStp measurable_const))

theorem canonSigma_mono {s t : ℝ≥0} (hst : s ≤ t) : canonSigma s ≤ canonSigma t :=
  sup_le_sup_left (iSup₂_le fun u hu => le_iSup₂_of_le (f := fun (u : ℝ≥0) (_ : u ≤ t) =>
    MeasurableSpace.comap (canonDrv u) inferInstance ⊔
      MeasurableSpace.generateFrom {{y : CanonSpace | canonStp y ≤ (u : ℝ≥0∞)}}) u (hu.trans hst) le_rfl) _

/-- **The canonical filtration** (Astra's (Q3.2) on the canonical space). -/
def canonFilt : Filtration ℝ≥0 (inferInstance : MeasurableSpace CanonSpace) where
  seq := canonSigma
  mono' _ _ hst := canonSigma_mono hst
  le' := canonSigma_le

/-- The record σ-algebra of the canonical space. -/
@[instance_reducible]
def canonRec : MeasurableSpace CanonSpace := MeasurableSpace.comap Prod.fst inferInstance

theorem measurable_fst_canonRec : Measurable[canonRec] (Prod.fst : CanonSpace → RecData) :=
  comap_measurable _

theorem canonRec_le : canonRec ≤ (inferInstance : MeasurableSpace CanonSpace) := measurable_fst.comap_le

theorem canonRec_le_canonFilt (t : ℝ≥0) : canonRec ≤ canonFilt t := le_sup_left

theorem comap_fst_le_canonFilt (t : ℝ≥0) :
    MeasurableSpace.comap (Prod.fst : CanonSpace → RecData) inferInstance ≤ canonFilt t :=
  le_sup_left

theorem measurable_canonDrv_canonFilt {u t : ℝ≥0} (hu : u ≤ t) : Measurable[canonFilt t] (canonDrv u) := by
  refine Measurable.of_comap_le ?_
  exact (le_sup_left.trans (le_iSup₂_of_le (f := fun (u : ℝ≥0) (_ : u ≤ t) =>
    MeasurableSpace.comap (canonDrv u) inferInstance ⊔
      MeasurableSpace.generateFrom {{y : CanonSpace | canonStp y ≤ (u : ℝ≥0∞)}}) u hu le_rfl)).trans le_sup_right

theorem measurableSet_canonStp_le {u t : ℝ≥0} (hu : u ≤ t) :
    MeasurableSet[canonFilt t] {y : CanonSpace | canonStp y ≤ (u : ℝ≥0∞)} := by
  have h : MeasurableSpace.generateFrom {{y : CanonSpace | canonStp y ≤ (u : ℝ≥0∞)}} ≤ canonFilt t :=
    (le_sup_right.trans (le_iSup₂_of_le (f := fun (u : ℝ≥0) (_ : u ≤ t) =>
      MeasurableSpace.comap (canonDrv u) inferInstance ⊔
        MeasurableSpace.generateFrom {{y : CanonSpace | canonStp y ≤ (u : ℝ≥0∞)}}) u hu le_rfl)).trans le_sup_right
  exact h _ (MeasurableSpace.measurableSet_generateFrom rfl)

theorem stronglyAdapted_canonDrv : StronglyAdapted canonFilt canonDrv := fun _ =>
  (measurable_canonDrv_canonFilt le_rfl).stronglyMeasurable

/-- **(Record, path) events determined by the path on `[0, t]` are events of the canonical filtration at `t`.** -/
theorem measurableSet_canonFilt_of_detUpTo (t : ℝ≥0) {B : Set (RecData × (ℝ≥0 → ℝ))} (hB : MeasurableSet B)
    (hdet : IsDetUpTo t B) :
    MeasurableSet[canonFilt t] {y : CanonSpace | (y.1, fun u => canonDrv u y) ∈ B} := by
  set g : CanonSpace → RecData × (ℝ≥0 → ℝ) := fun y => (y.1, fun u => canonDrv (min u t) y) with hg
  have hgm : Measurable[canonFilt t] g := by
    have h1 : Measurable[canonFilt t] (Prod.fst : CanonSpace → RecData) :=
      Measurable.of_comap_le (comap_fst_le_canonFilt t)
    have h2 : Measurable[canonFilt t] (fun y : CanonSpace => fun u => canonDrv (min u t) y) :=
      @measurable_pi_iff CanonSpace ℝ≥0 (fun _ => ℝ) (canonFilt t) _ _ |>.2 fun u =>
        measurable_canonDrv_canonFilt (min_le_right u t)
    exact h1.prodMk h2
  have e : {y : CanonSpace | (y.1, fun u => canonDrv u y) ∈ B} = g ⁻¹' B := by
    ext y
    simp only [mem_ofPred_eq, mem_preimage, hg]
    exact hdet y.1 _ _ fun u hu => by simp only [min_eq_left hu]
  rw [e]
  exact hgm hB

/-! ### The stopped driver match on the canonical space -/

section Core

open Restart.DomainMarkov.Aux79 Restart.FCDet Sec7.PocketTraversal Supp8.GB6.HullId

/-- **The relative stopped driver match from (S) and (L) on the canonical space.** Let `Q` be a probability on
`CanonSpace` under which, for the canonical filtration, the decoded relative driver with the flowed marks of a word
`β(record)` of fixed type `(nL, nR, ρL, ρR)` (`IsFlowType` at angle `0`) has K2's inputs (S) and (L) with lifetime the
stop, the stop is positive, before the continuation threshold, given by a measurable path rule `ρ` of (record, path),
and announced by measurable finite path rules `ρs k`, and the chart field is integrable. Then `Q`-almost surely the
driver matches the canonical driver code of `(β(record), field)` at every dyadic time before the stop.

Proof: Theorem 2.4 through the mean martingales gives the local evolution of the random word on an enlargement
(`StoppedK2.isRandomWordEvolutionUpTo_prod_of_isCouplingCharFun`); the announcing rules are kernel stops
(`isKernelStop_of_pathRule`), so the stopped K2 with kernel stops gives, under almost every conditional law given the
record, a coupling through the stop with a driver frozen after it (`ae_isStoppedHullCoupling_kk_prod`); the stop is
the Galmarino history rule of `ρ` at the record (`HullId.histRule_killedHistory`), so the proved Aux. lemma 54 in
rule form gives the match (`HullDetGen.ae_isStopDrvMatch_of_isStoppedHullCouplingR`); it is integrated back over the
conditional laws. -/
theorem ae_isStopDrvMatch_canon {Q : Measure CanonSpace} [IsProbabilityMeasure Q] {κ : ℝ} (hκ : 0 < κ)
    {Fd : BoundaryWord × DistOn upperHalfPlaneOpens → Sec2.Assembly.PCode × ℝ≥0∞}
    (hFd : IsCanonicalDriverCode κ 0 Fd) {β : RecData → BoundaryWord} (hβ : Measurable β)
    {nL nR : ℕ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {xL : RecData → Fin nL → ℝ} {xR : RecData → Fin nR → ℝ}
    (hxL : Measurable xL) (hxR : Measurable xR) (hxL0 : ∀ r i, xL r i ≤ 0) (hxR0 : ∀ r j, 0 ≤ xR r j)
    (hxLa : ∀ r, Antitone (xL r)) (hxRm : ∀ r, Monotone (xR r))
    (htype : ∀ᵐ y ∂Q, IsFlowType κ 0 (β y.1) (xL y.1) (xR y.1) ρL ρR)
    (hint : ∀ φ : TestOn upperHalfPlaneOpens, Integrable (fun y => canonFld y φ) Q)
    (hV0 : ∀ᵐ y ∂Q, 0 < canonStp y)
    (hthr : ∀ᵐ y ∂Q, canonStp y ≤ thr ρL ρR canonDrv (fun y => xL y.1) (fun y => xR y.1) y)
    {ρ : RecData × (ℝ≥0 → ℝ) → ℝ≥0∞} (hρm : Measurable ρ) (hρ : IsPathRule ρ)
    (hVρ : ∀ᵐ y ∂Q, canonStp y = ρ (y.1, fun t => canonDrv t y))
    {ρs : ℕ → RecData × (ℝ≥0 → ℝ) → ℝ≥0∞} (hρsm : ∀ k, Measurable (ρs k)) (hρs : ∀ k, IsPathRule (ρs k))
    (hρsfin : ∀ k x, ρs k x ≠ ⊤) (hρsmono : ∀ x, Monotone fun k => ρs k x)
    (hρslt : ∀ᵐ y ∂Q, ∀ k, ρs k (y.1, fun t => canonDrv t y) < canonStp y)
    (hρslim : ∀ᵐ y ∂Q, Tendsto (fun k => ρs k (y.1, fun t => canonDrv t y)) atTop (𝓝 (canonStp y)))
    (hlaw : HasSafeLaw κ ρL ρR Q canonFilt univ canonStp canonDrv (geomLW canonDrv fun y => xL y.1)
      (geomRW canonDrv fun y => xR y.1) canonFld)
    (hmem : HasSafeMembers Q canonFilt univ canonStp canonDrv canonFld) :
    ∀ᵐ y ∂Q, IsStopDrvMatch (Fd (β y.1, canonFld y)) (fun t => canonDrv t y) (canonStp y) := by
  have h𝒢 : canonRec ≤ canonFilt 0 := canonRec_le_canonFilt 0
  have hxL' : Measurable[canonRec] fun y : CanonSpace => xL y.1 := hxL.comp measurable_fst_canonRec
  have hxR' : Measurable[canonRec] fun y : CanonSpace => xR y.1 := hxR.comp measurable_fst_canonRec
  have hxL₀ : Measurable[canonFilt 0] fun y : CanonSpace => xL y.1 := hxL'.mono h𝒢 le_rfl
  have hxR₀ : Measurable[canonFilt 0] fun y : CanonSpace => xR y.1 := hxR'.mono h𝒢 le_rfl
  have hWa : StronglyAdapted canonFilt canonDrv := stronglyAdapted_canonDrv
  have hVst : ∀ t : ℝ≥0, MeasurableSet[canonFilt t] {y | canonStp y ≤ t} := fun t =>
    measurableSet_canonStp_le le_rfl
  have hVst' : ∀ t : ℝ≥0, MeasurableSet {y : CanonSpace | canonStp y ≤ t} := fun t =>
    canonFilt.le t _ (hVst t)
  have hWa₀ : AdaptedBefore canonFilt canonStp canonDrv := MartChar.adaptedBefore_of_stronglyAdapted hVst hWa
  have hVLa₀ : ∀ i, AdaptedBefore canonFilt canonStp (geomLW canonDrv (fun y => xL y.1) i) := fun i =>
    MartChar.adaptedBefore_of_stronglyAdapted hVst
      (stronglyAdapted_geomLW hWa continuous_canonDrv hxL₀ i)
  have hVRa₀ : ∀ j, AdaptedBefore canonFilt canonStp (geomRW canonDrv (fun y => xR y.1) j) := fun j =>
    MartChar.adaptedBefore_of_stronglyAdapted hVst
      (stronglyAdapted_geomRW hWa continuous_canonDrv hxR₀ j)
  have hXψ : ∀ ψ : TestOn upperHalfPlaneOpens, Measurable fun y => canonFld y ψ := fun ψ =>
    (LQGMetric.measurable_distOn_apply ψ).comp measurable_canonFld
  have hcf := isCouplingCharFun_of_hasSafeLaw canonFld hXψ hlaw
    (ae_of_all _ (isForceReg_thr canonDrv_zero continuous_canonDrv (fun y => xL y.1) (fun y => xR y.1)
      canonStp)) (ae_of_all _ fun y h => absurd (mem_univ y) h) hWa₀ hVLa₀ hVRa₀
  have hWaU : StronglyAdapted (usualAugmentation canonFilt Q) canonDrv := fun t =>
    (hWa t).mono (Ito.le_usualAugmentation canonFilt Q t)
  have hVU : IsStoppingTime (usualAugmentation canonFilt Q) fun y => (canonStp y : WithTop ℝ≥0) := fun t =>
    Ito.le_usualAugmentation canonFilt Q t _ (hVst t)
  -- the announcing sequence of the stop
  set T : ℕ → CanonSpace → ℝ≥0 := fun k y => (ρs k (y.1, fun t => canonDrv t y)).toNNReal with hTdef
  have hTe : ∀ k y, ((T k y : ℝ≥0) : ℝ≥0∞) = ρs k (y.1, fun t => canonDrv t y) := fun k y =>
    ENNReal.coe_toNNReal (hρsfin k _)
  have hTst : ∀ k, IsStoppingTime (usualAugmentation canonFilt Q) fun y => ((T k y : ℝ≥0) : WithTop ℝ≥0) := by
    intro k t
    have hB : MeasurableSet {x : RecData × (ℝ≥0 → ℝ) | ρs k x ≤ (t : ℝ≥0∞)} :=
      measurableSet_le (hρsm k) measurable_const
    have hdet : IsDetUpTo t {x : RecData × (ℝ≥0 → ℝ) | ρs k x ≤ (t : ℝ≥0∞)} := by
      intro r w w' hww'
      simp only [mem_ofPred_eq]
      constructor
      · intro h
        rw [hρs k r w w' fun u hu => hww' u (ENNReal.coe_le_coe.1 (hu.trans h))]
        exact h
      · intro h
        rw [hρs k r w' w fun u hu => (hww' u (ENNReal.coe_le_coe.1 (hu.trans h))).symm]
        exact h
    have h1 := measurableSet_canonFilt_of_detUpTo t hB hdet
    have e : {y : CanonSpace | ((T k y : ℝ≥0) : WithTop ℝ≥0) ≤ (t : WithTop ℝ≥0)} =
        {y : CanonSpace | (y.1, fun u => canonDrv u y) ∈ {x : RecData × (ℝ≥0 → ℝ) | ρs k x ≤ (t : ℝ≥0∞)}} := by
      ext y
      simp only [mem_ofPred_eq]
      change ((T k y : ℝ≥0) : ℝ≥0∞) ≤ (t : ℝ≥0∞) ↔ _
      rw [hTe]
    rw [e]
    exact Ito.le_usualAugmentation canonFilt Q t _ h1
  have hTann : Coupling.IsAnnouncingSeq (usualAugmentation canonFilt Q) Q canonStp T := by
    refine ⟨hTst, fun y k l hkl => ?_, fun k => ?_, ?_⟩
    · have h : ρs k (y.1, fun t => canonDrv t y) ≤ ρs l (y.1, fun t => canonDrv t y) :=
        hρsmono (y.1, fun t => canonDrv t y) hkl
      exact ENNReal.toNNReal_mono (hρsfin l _) h
    · filter_upwards [hρslt] with y hy
      rw [hTe]
      exact hy k
    · filter_upwards [hρslim] with y hy t ht
      obtain ⟨k, hk⟩ := (hy.eventually (lt_mem_nhds ht)).exists
      refine ⟨k, ?_⟩
      have h := hk.le
      rw [← hTe] at h
      exact_mod_cast h
  obtain ⟨P₀, hP₀, 𝓦, B, hE, -, -⟩ := StoppedK2.isRandomWordEvolutionUpTo_prod_of_isCouplingCharFun
    (𝒢 := canonRec) hκ (fun s hs h0 => Ito.measurableSet_usualAugmentation_of_null hs h0 0)
    (h𝒢.trans (Ito.le_usualAugmentation canonFilt Q 0)) MeasurableSet.univ hxL' hxR' (fun y => hxL0 y.1)
    (fun y => hxR0 y.1) (fun y => hxLa y.1) (fun y => hxRm y.1) canonDrv_zero continuous_canonDrv hWaU hVU hTann
    hint hcf (hthr.mono fun y h _ => h)
  -- the announcing rules are kernel stops of the enlargement
  set σ : ℕ → CanonSpace × (ℕ → ℝ) → WithTop ℝ≥0 :=
    fun k p => (ρs k (p.1.1, fun t => canonDrv t p.1) : WithTop ℝ≥0) with hσdef
  have hrec2 : Measurable[canonRec.comap Prod.fst] fun p : CanonSpace × (ℕ → ℝ) => p.1.1 :=
    measurable_fst_canonRec.comp (comap_measurable Prod.fst)
  have h𝒢2 : canonRec.comap Prod.fst ≤ (inferInstance : MeasurableSpace (CanonSpace × (ℕ → ℝ))) :=
    (MeasurableSpace.comap_mono canonRec_le).trans measurable_fst.comap_le
  have hTk : ∀ k, IsKernelStop (canonRec.comap Prod.fst) (Q.prod P₀) (Prod.fst ⁻¹' univ)
      (fun t p => canonDrv t p.1) (fun i t p => geomLW canonDrv (fun y => xL y.1) i t p.1)
      (fun j t p => geomRW canonDrv (fun y => xR y.1) j t p.1) (fun p => canonStp p.1) (σ k) := fun k =>
    isKernelStop_of_pathRule h𝒢2 hrec2 (hρsm k) (hρs k) (fun t => (measurable_canonDrv t).comp measurable_fst)
      (@MeasurableSet.univ _ (canonRec.comap Prod.fst)) (by
        filter_upwards [ConverseBefore.ae_fst_of_ae (P₀ := P₀) hρslt] with p hp _ using hp k)
  have hσm : ∀ p, Monotone fun k => σ k p := fun p k l hkl => hρsmono _ hkl
  have hσV : ∀ᵐ p ∂(Q.prod P₀), p.1 ∈ (univ : Set CanonSpace) → ∀ k, (σ k p : ℝ≥0∞) < canonStp p.1 := by
    filter_upwards [ConverseBefore.ae_fst_of_ae (P₀ := P₀) hρslt] with p hp _ using hp
  have hσlim : ∀ᵐ p ∂(Q.prod P₀), p.1 ∈ (univ : Set CanonSpace) →
      Tendsto (fun k => (σ k p : ℝ≥0∞)) atTop (𝓝 (canonStp p.1)) := by
    filter_upwards [ConverseBefore.ae_fst_of_ae (P₀ := P₀) hρslim] with p hp _ using hp
  have hcont : ∀ᵐ y ∂Q, y ∈ (univ : Set CanonSpace) → canonStp y ≠ ⊤ →
      ContinuousOn (canonDrv · y) (Iic (canonStp y).toNNReal) ∧
      (∀ i, ContinuousOn (geomLW canonDrv (fun y => xL y.1) i · y) (Iic (canonStp y).toNNReal)) ∧
      ∀ j, ContinuousOn (geomRW canonDrv (fun y => xR y.1) j · y) (Iic (canonStp y).toNNReal) :=
    ae_of_all _ fun y _ _ => ⟨(continuous_canonDrv y).continuousOn,
      fun i => (isForcePath_geomLW continuous_canonDrv (fun y => xL y.1) y i).1.continuousOn,
      fun j => (isForcePath_geomRW continuous_canonDrv (fun y => xR y.1) y j).1.continuousOn⟩
  have hK := ae_isStoppedHullCoupling_kk_prod (P₀ := P₀) (F := univ) (ΘL := fun y => xL y.1)
    (ΘR := fun y => xR y.1) hE hcont measurable_canonFld (hV0.mono fun y h _ => h) h𝒢 hWa₀ hVLa₀ hVRa₀ hlaw hmem
    (σ := σ) hTk hσm hσV hσlim
  -- under almost every conditional law given the record: the stopped match
  have hEm : MeasurableSet {p : CanonSpace × (ℕ → ℝ) |
      IsStopDrvMatch (Fd (β p.1.1, canonFld p.1)) (fun t => canonDrv t p.1) (canonStp p.1)} :=
    measurableSet_isStopDrvMatch (S := CanonSpace × (ℕ → ℝ))
      (G := fun p => Fd (β p.1.1, canonFld p.1))
      (hFd.1.comp ((hβ.comp (measurable_fst.comp measurable_fst)).prodMk (measurable_canonFld.comp measurable_fst)))
      (fun t => (measurable_canonDrv t).comp measurable_fst) (measurable_canonStp.comp measurable_fst)
  have hall : ∀ᵐ p ∂(Q.prod P₀),
      IsStopDrvMatch (Fd (β p.1.1, canonFld p.1)) (fun t => canonDrv t p.1) (canonStp p.1) := by
    refine Sec5.Lemma56Stages.ae_of_ae_condExpKernel h𝒢2 hEm ?_
    filter_upwards [hK, ConverseBefore.ae_fst_of_ae (P₀ := P₀) htype,
      Sec7.Lemma725RefK2.ae_ae_condExpKernel_eq_self (P := Q.prod P₀) h𝒢2 hrec2,
      Sec7.Aux122Disint.ae_ae_condExpKernel (P := Q.prod P₀) h𝒢2 (ConverseBefore.ae_fst_of_ae (P₀ := P₀) hVρ)]
      with p₀ hK₀ htype₀ hrec₀ hVρ₀
    obtain ⟨𝓕', W', VL', VR', B', hSC, hag, hfrz⟩ := hK₀ (mem_univ _)
    set ν := condExpKernel (Q.prod P₀) (canonRec.comap Prod.fst) p₀ with hν
    set r₀ := p₀.1.1 with hr₀
    set c := β r₀ with hc
    obtain ⟨eL, eR, hxLc, hxRc, hρLc, hρRc⟩ := htype₀
    have hSC1 : StoppedExtend.IsStoppedHullCoupling κ (xL r₀) (xR r₀) ρL ρR ν 𝓕' W' VL' VR' B'
        (fun p => canonStp p.1) (fun p => canonFld p.1) := hSC
    have hSC' := StoppedK2.isStoppedHullCoupling_cast eL eR hSC1
    rw [hxLc, hxRc, hρLc, hρRc] at hSC'
    have hreg := Aux54.isRegularStop_of_frozen hSC' hfrz
    have hRe : ∀ᵐ p ∂ν, canonStp p.1 = histRule ρ r₀ (LawUnique.killedHistory W' (fun i => VL' (Fin.cast eL i))
        (fun j => VR' (Fin.cast eR j)) (fun p => canonStp p.1) p) := by
      filter_upwards [hag, hrec₀, hVρ₀] with p hagp hrp hVp
      have hagb : Exist.AgreeBefore (fun t (p : CanonSpace × (ℕ → ℝ)) => canonDrv t p.1) W'
