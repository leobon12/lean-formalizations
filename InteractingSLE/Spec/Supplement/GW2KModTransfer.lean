/-!
# Regular conditional laws given a map of two variables, computed fibre by fibre

Packet PROVE-GW2-KMODELS (Theorem 1.4, GW2's root test). GW2's retained stage σ-algebra is generated by the counterflow
record `X = cfRec` and the stopped records of the earlier pieces. Before contact with the retained counterflow, those
records are functions `Ψ (X, Y)` of the counterflow record and of the field `Y = Hc` read in the joint chart, whose
regular conditional law given `X` is the GFF law of the joint word (`GW2JointKernel.exists_jointKernel_r1`). This file
proves the measure-theoretic principle that turns the conditional law of a further function `S (X, Y)` given
`(X, Ψ (X, Y))` into a conditional law **on the fibre**: for fixed `x`, the conditional law of `S (x, ·)` given
`Ψ (x, ·)` under the conditional law of `Y` given `X = x`.

* `ae_condExpKernel_map_eq_condDistrib`: the regular conditional kernel given `σ(V)`, pushed forward by `Z`, is
  `condDistrib Z V` evaluated at `V`;
* `ae_condExpKernel_map_eq_of_compProd`: the same with any kernel `κ` disintegrating the joint law of `(V, Z)`;
* `fibreKernel η Ψ S`: at `x`, the law of `(Ψ (x, y), S (x, y))` for `y ∼ η x`; `fibreKernel_apply`,
  `map_compProd_eq_compProd_fibreKernel`;
* **`ae_condExpKernel_map_eq_condKernel_fibre`**: the conditional law of `S (X, Y)` given `(X, Ψ (X, Y))` is the
  disintegration kernel of `fibreKernel (condDistrib Y X μ) Ψ S` at `(X, Ψ (X, Y))`;
* **`ae_condExpKernel_map_mem_of_fibre`**: a measurable property of measures that holds for the fibre conditional laws
  (Mathlib's measure disintegration `Measure.condKernel` of the fibre law) holds for the regular conditional law;
* **`ae_condExpKernel_eq_of_restrict`**: two maps that determine each other almost surely on an event known to both
  give the same regular conditional kernels almost surely on that event;
* **`ae_condExpKernel_map_mem_of_ident`**: the combination — conditioning on a σ-algebra identified with
  `(X, Ψ (X, Y))` on an event;
* `measurableSet_lt_apply`, `measurableSet_le_apply`: the measurable sets of measures of the stage-model bounds.

All statements are standard measure theory (no input).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal

namespace InteractingSLE.Theorem14.GW2KMod

/-! ### The regular conditional kernel given a map -/

section CondKernel

variable {Ω β γ : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] [MeasurableSpace β]
  [MeasurableSpace γ] [StandardBorelSpace γ] [Nonempty γ] {μ : Measure Ω} [IsFiniteMeasure μ]

/-- **The regular conditional kernel given `σ(V)`, pushed forward by `Z`, is `condDistrib Z V μ` at `V`**, almost
surely. -/
theorem ae_condExpKernel_map_eq_condDistrib {V : Ω → β} {Z : Ω → γ} (hV : Measurable V) (hZ : Measurable Z) :
    ∀ᵐ ω ∂μ, (condExpKernel μ (MeasurableSpace.comap V inferInstance) ω).map Z = condDistrib Z V μ (V ω) := by
  obtain ⟨C, hCc, hCpi, hCgen⟩ := Exist.Param12.exists_countable_isPiSystem_generate γ
  have hCm : ∀ s ∈ C, MeasurableSet s := fun s hs => by
    rw [hCgen]
    exact MeasurableSpace.measurableSet_generateFrom hs
  have hall : ∀ᵐ ω ∂μ, ∀ s ∈ C, condDistrib Z V μ (V ω) s =
      (condExpKernel μ (MeasurableSpace.comap V inferInstance)).map Z ω s :=
    (ae_ball_iff hCc).2 fun s hs => condDistrib_apply_ae_eq_condExpKernel_map hZ hV (hCm s hs)
  filter_upwards [hall] with ω hω
  refine ext_of_generate_finite C hCgen hCpi (fun s hs => ?_) (by rw [measure_univ, measure_univ])
  rw [hω s hs, Kernel.map_apply _ hZ]

/-- **The regular conditional kernel given `σ(V)`, pushed forward by `Z`, is any kernel disintegrating the joint law
of `(V, Z)`**, almost surely. -/
theorem ae_condExpKernel_map_eq_of_compProd {V : Ω → β} {Z : Ω → γ} (hV : Measurable V) (hZ : Measurable Z)
    {κ : Kernel β γ} [IsFiniteKernel κ] (hκ : μ.map (fun ω => (V ω, Z ω)) = μ.map V ⊗ₘ κ) :
    ∀ᵐ ω ∂μ, (condExpKernel μ (MeasurableSpace.comap V inferInstance) ω).map Z = κ (V ω) := by
  have h1 := condDistrib_ae_eq_of_measure_eq_compProd hV.aemeasurable hZ.aemeasurable hκ
  have h2 : ∀ᵐ ω ∂μ, condDistrib Z V μ (V ω) = κ (V ω) := ae_of_ae_map hV.aemeasurable h1
  filter_upwards [ae_condExpKernel_map_eq_condDistrib hV hZ, h2] with ω h h' using h.trans h'

end CondKernel

/-! ### The fibre kernel -/

section Fibre

variable {A B C D : Type*} [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C] [MeasurableSpace D]

/-- **The fibre kernel**: at `x`, the law of `(Ψ (x, y), S (x, y))` for `y` distributed as `η x`. -/
def fibreKernel (η : Kernel A B) (Ψ : A × B → C) (S : A × B → D) : Kernel A (C × D) :=
  (Kernel.id ×ₖ η).map fun p => (Ψ p, S p)

theorem fibreKernel_apply (η : Kernel A B) [IsSFiniteKernel η] {Ψ : A × B → C} {S : A × B → D}
    (hΨ : Measurable Ψ) (hS : Measurable S) (x : A) :
    fibreKernel η Ψ S x = (η x).map fun y => (Ψ (x, y), S (x, y)) := by
  rw [fibreKernel, Kernel.map_apply _ (hΨ.prodMk hS), Kernel.prod_apply, Kernel.id_apply, Measure.dirac_prod,
    Measure.map_map (hΨ.prodMk hS) measurable_prodMk_left]
  rfl

instance isFiniteKernel_fibreKernel (η : Kernel A B) [IsFiniteKernel η] (Ψ : A × B → C) (S : A × B → D) :
    IsFiniteKernel (fibreKernel η Ψ S) := by
  rw [fibreKernel]
  infer_instance

/-- Equal finite measures have equal disintegration kernels. -/
theorem condKernel_congr [StandardBorelSpace D] [Nonempty D] {M₁ M₂ : Measure (C × D)} [IsFiniteMeasure M₁]
    [IsFiniteMeasure M₂] (h : M₁ = M₂) : M₁.condKernel = M₂.condKernel := by
  subst h
  rfl

theorem isMarkovKernel_fibreKernel (η : Kernel A B) [IsMarkovKernel η] {Ψ : A × B → C} {S : A × B → D}
    (hΨ : Measurable Ψ) (hS : Measurable S) : IsMarkovKernel (fibreKernel η Ψ S) := by
  rw [fibreKernel]
  exact Kernel.IsMarkovKernel.map _ (hΨ.prodMk hS)

/-- **Pushing a joint law forward by a fibrewise map**: `(ν ⊗ₘ η).map (x, y) ↦ (x, Ψ (x, y), S (x, y))` is
`ν ⊗ₘ fibreKernel η Ψ S`. -/
theorem map_compProd_eq_compProd_fibreKernel (ν : Measure A) [SFinite ν] (η : Kernel A B) [IsSFiniteKernel η]
    {Ψ : A × B → C} {S : A × B → D} (hΨ : Measurable Ψ) (hS : Measurable S) :
    (ν ⊗ₘ η).map (fun p => (p.1, Ψ p, S p)) = ν ⊗ₘ fibreKernel η Ψ S := by
  have hg : Measurable fun p : A × B => (p.1, Ψ p, S p) := measurable_fst.prodMk (hΨ.prodMk hS)
  have : IsSFiniteKernel (fibreKernel η Ψ S) := by rw [fibreKernel]; infer_instance
  ext s hs
  rw [Measure.map_apply hg hs, Measure.compProd_apply (hg hs), Measure.compProd_apply hs]
  refine lintegral_congr fun x => ?_
  have hf : Measurable fun y : B => (Ψ (x, y), S (x, y)) :=
    (hΨ.comp measurable_prodMk_left).prodMk (hS.comp measurable_prodMk_left)
  rw [fibreKernel_apply η hΨ hS x, Measure.map_apply hf (measurable_prodMk_left hs)]
  rfl

/-- The first marginal of `ν ⊗ₘ ρ` read on `(x, c)`: `(ν ⊗ₘ ρ).map (x, (c, d)) ↦ (x, c)` is `ν ⊗ₘ ρ.fst`. -/
theorem map_compProd_fst_eq (ν : Measure A) [SFinite ν] (ρ : Kernel A (C × D)) [IsSFiniteKernel ρ] :
    (ν ⊗ₘ ρ).map (fun p => (p.1, p.2.1)) = ν ⊗ₘ ρ.fst := by
  have hg : Measurable fun p : A × C × D => (p.1, p.2.1) := measurable_fst.prodMk (measurable_fst.comp measurable_snd)
  ext s hs
  rw [Measure.map_apply hg hs, Measure.compProd_apply (hg hs), Measure.compProd_apply hs]
  refine lintegral_congr fun x => ?_
  rw [Kernel.fst_apply' _ _ (measurable_prodMk_left hs)]
  rfl

end Fibre

/-! ### The conditional law given `(X, Ψ (X, Y))` -/

section Main

variable {Ω A B C D : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] [MeasurableSpace A]
  [MeasurableSpace B] [StandardBorelSpace B] [Nonempty B] [MeasurableSpace C] [MeasurableSpace D]
  [StandardBorelSpace D] [Nonempty D] {μ : Measure Ω} [IsFiniteMeasure μ] {X : Ω → A} {Y : Ω → B}
  {Ψ : A × B → C} {S : A × B → D}

omit [StandardBorelSpace Ω] [StandardBorelSpace D] [Nonempty D] in
/-- The joint law of `(X, Ψ (X, Y), S (X, Y))` is `law(X) ⊗ fibreKernel (condDistrib Y X μ) Ψ S`. -/
theorem map_triple_eq_compProd_fibreKernel (hX : Measurable X) (hY : Measurable Y) (hΨ : Measurable Ψ)
    (hS : Measurable S) :
    μ.map (fun ω => (X ω, Ψ (X ω, Y ω), S (X ω, Y ω))) = μ.map X ⊗ₘ fibreKernel (condDistrib Y X μ) Ψ S := by
  have hXY : μ.map (fun ω => (X ω, Y ω)) = μ.map X ⊗ₘ condDistrib Y X μ :=
    (compProd_map_condDistrib hX.aemeasurable hY.aemeasurable).symm
  rw [← map_compProd_eq_compProd_fibreKernel _ _ hΨ hS, ← hXY,
    Measure.map_map (measurable_fst.prodMk (hΨ.prodMk hS)) (hX.prodMk hY)]
  rfl

omit [StandardBorelSpace Ω] [StandardBorelSpace D] [Nonempty D] in
/-- The joint law of `(X, Ψ (X, Y))` is `law(X) ⊗ (fibreKernel …).fst`. -/
theorem map_pair_eq_compProd_fst_fibreKernel (hX : Measurable X) (hY : Measurable Y) (hΨ : Measurable Ψ)
    (hS : Measurable S) :
    μ.map (fun ω => (X ω, Ψ (X ω, Y ω))) = μ.map X ⊗ₘ (fibreKernel (condDistrib Y X μ) Ψ S).fst := by
  have : IsMarkovKernel (fibreKernel (condDistrib Y X μ) Ψ S) := isMarkovKernel_fibreKernel _ hΨ hS
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  have hg : Measurable fun p : A × C × D => (p.1, p.2.1) :=
    measurable_fst.prodMk (measurable_fst.comp measurable_snd)
  have hf : Measurable fun ω => (X ω, Ψ (X ω, Y ω), S (X ω, Y ω)) :=
    hX.prodMk ((hΨ.comp hXY).prodMk (hS.comp hXY))
  rw [← map_compProd_fst_eq, ← map_triple_eq_compProd_fibreKernel hX hY hΨ hS, Measure.map_map hg hf]
  rfl

variable [MeasurableSpace.CountableOrCountablyGenerated A C]

omit [StandardBorelSpace Ω] in
/-- **The joint law of `((X, Ψ (X, Y)), S (X, Y))` disintegrates through the conditional kernel of the fibre
kernel.** -/
theorem map_eq_compProd_condKernel_fibreKernel (hX : Measurable X) (hY : Measurable Y) (hΨ : Measurable Ψ)
    (hS : Measurable S) :
    μ.map (fun ω => ((X ω, Ψ (X ω, Y ω)), S (X ω, Y ω))) =
      μ.map (fun ω => (X ω, Ψ (X ω, Y ω))) ⊗ₘ (fibreKernel (condDistrib Y X μ) Ψ S).condKernel := by
  have : IsMarkovKernel (fibreKernel (condDistrib Y X μ) Ψ S) := isMarkovKernel_fibreKernel _ hΨ hS
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  have hf : Measurable fun ω => (X ω, Ψ (X ω, Y ω), S (X ω, Y ω)) :=
    hX.prodMk ((hΨ.comp hXY).prodMk (hS.comp hXY))
  rw [map_pair_eq_compProd_fst_fibreKernel hX hY hΨ hS, ← Measure.compProd_assoc, Kernel.disintegrate,
    ← map_triple_eq_compProd_fibreKernel hX hY hΨ hS, Measure.map_map (MeasurableEquiv.measurable _) hf]
  rfl

/-- **The regular conditional law of `S (X, Y)` given `(X, Ψ (X, Y))`** is the conditional kernel of the fibre kernel
at `(X, Ψ (X, Y))`, almost surely. -/
theorem ae_condExpKernel_map_eq_condKernel_fibre (hX : Measurable X) (hY : Measurable Y) (hΨ : Measurable Ψ)
    (hS : Measurable S) :
    ∀ᵐ ω ∂μ, (condExpKernel μ (MeasurableSpace.comap (fun ω => (X ω, Ψ (X ω, Y ω))) inferInstance) ω).map
        (fun ω => S (X ω, Y ω)) = (fibreKernel (condDistrib Y X μ) Ψ S).condKernel (X ω, Ψ (X ω, Y ω)) := by
  have : IsMarkovKernel (fibreKernel (condDistrib Y X μ) Ψ S) := isMarkovKernel_fibreKernel _ hΨ hS
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  exact ae_condExpKernel_map_eq_of_compProd (hX.prodMk (hΨ.comp hXY)) (hS.comp hXY)
    (map_eq_compProd_condKernel_fibreKernel hX hY hΨ hS)

/-- **Measurable properties of the fibre conditional laws pass to the regular conditional law.** Let `𝒮` be a
measurable set of probability measures on `D` and `G` a measurable set of values of `X`. If, almost surely on
`{X ∈ G}`, the conditional laws of `S (X ω, ·)` given `Ψ (X ω, ·)` **on the fibre** — Mathlib's disintegration
`Measure.condKernel` of the fibre law of `(Ψ (X ω, y), S (X ω, y))`, `y ∼ condDistrib Y X μ (X ω)` — lie in `𝒮` for
almost every value of `Ψ (X ω, ·)`, then almost surely on `{X ∈ G}` the regular conditional law of `S (X, Y)` given
`(X, Ψ (X, Y))` lies in `𝒮`. -/
theorem ae_condExpKernel_map_mem_of_fibre (hX : Measurable X) (hY : Measurable Y) (hΨ : Measurable Ψ)
    (hS : Measurable S) {G : Set A} (hG : MeasurableSet G) {𝒮 : Set (Measure D)} (h𝒮 : MeasurableSet 𝒮)
    (hfib : ∀ᵐ ω ∂μ, X ω ∈ G → ∀ᵐ c ∂((condDistrib Y X μ (X ω)).map fun y => Ψ (X ω, y)),
      ((condDistrib Y X μ (X ω)).map fun y => (Ψ (X ω, y), S (X ω, y))).condKernel c ∈ 𝒮) :
    ∀ᵐ ω ∂μ, X ω ∈ G → (condExpKernel μ (MeasurableSpace.comap (fun ω => (X ω, Ψ (X ω, Y ω))) inferInstance)
      ω).map (fun ω => S (X ω, Y ω)) ∈ 𝒮 := by
  set ρ := fibreKernel (condDistrib Y X μ) Ψ S with hρ
  have : IsMarkovKernel ρ := isMarkovKernel_fibreKernel _ hΨ hS
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  -- the fibre law and its first marginal
  have hfst : ∀ x, ρ.fst x = (condDistrib Y X μ x).map fun y => Ψ (x, y) := by
    intro x
    have hf : Measurable fun y : B => Ψ (x, y) := hΨ.comp measurable_prodMk_left
    have hg : Measurable fun y : B => S (x, y) := hS.comp measurable_prodMk_left
    rw [Kernel.fst_apply, hρ, fibreKernel_apply _ hΨ hS x, Measure.map_map measurable_fst (hf.prodMk hg)]
    rfl
  -- the property of the kernel disintegration on each fibre
  set E : Set (A × C) := {p | ρ.condKernel p ∈ 𝒮} with hE
  have hEm : MeasurableSet E := (Kernel.measurable ρ.condKernel) h𝒮
  have hPm : MeasurableSet {x : A | x ∈ G → ρ.fst x (Prod.mk x ⁻¹' Eᶜ) = 0} :=
    (hG.compl.union ((Kernel.measurable_kernel_prodMk_left hEm.compl) (measurableSet_singleton 0))).congr
      (by ext x; simp only [mem_union, mem_compl_iff, mem_ofPred_eq, mem_preimage]; tauto)
  have hω : ∀ᵐ ω ∂μ, X ω ∈ G → ρ.fst (X ω) (Prod.mk (X ω) ⁻¹' Eᶜ) = 0 := by
    filter_upwards [hfib] with ω hω hG'
    have h1 := Kernel.condKernel_apply_eq_condKernel ρ (X ω)
    have h2 := hω hG'
    rw [← hfst] at h2
    have h3 : (ρ (X ω)).condKernel =
        ((condDistrib Y X μ (X ω)).map fun y => (Ψ (X ω, y), S (X ω, y))).condKernel :=
      condKernel_congr (fibreKernel_apply _ hΨ hS (X ω))
    refine measure_eq_zero_iff_ae_notMem.2 ?_
    filter_upwards [h1, h2] with c hc1 hc2
    simp only [mem_preimage, mem_compl_iff, hE, not_not]
    change ρ.condKernel (X ω, c) ∈ 𝒮
    rw [hc1, h3]
    exact hc2
  have hx : ∀ᵐ x ∂μ.map X, x ∈ G → ρ.fst x (Prod.mk x ⁻¹' Eᶜ) = 0 :=
    (ae_map_iff hX.aemeasurable hPm).2 hω
  have hset : MeasurableSet {p : A × C | p.1 ∈ G → p ∈ E} :=
    ((hG.preimage measurable_fst).compl.union hEm).congr
      (by ext p; simp only [mem_union, mem_compl_iff, mem_preimage, mem_ofPred_eq]; tauto)
  have hp : ∀ᵐ p ∂(μ.map X ⊗ₘ ρ.fst), p.1 ∈ G → p ∈ E := by
    refine (Measure.ae_compProd_iff hset).2 ?_
    filter_upwards [hx] with x hx'
    by_cases hxG : x ∈ G
    · have h0 : ∀ᵐ c ∂(ρ.fst x), c ∉ Prod.mk x ⁻¹' Eᶜ := measure_eq_zero_iff_ae_notMem.1 (hx' hxG)
      filter_upwards [h0] with c hc _
      simpa only [mem_preimage, mem_compl_iff, not_not] using hc
    · exact Eventually.of_forall fun c h => absurd h hxG
  rw [← map_pair_eq_compProd_fst_fibreKernel hX hY hΨ hS] at hp
  have hV := ae_of_ae_map (hX.prodMk (hΨ.comp hXY)).aemeasurable hp
  filter_upwards [hV, ae_condExpKernel_map_eq_condKernel_fibre (μ := μ) hX hY hΨ hS] with ω h1 h2 hG'
  rw [h2]
  exact h1 hG'

end Main

/-! ### Conditioning on maps that agree on an event -/

section Trace

variable {Ω : Type*} {m₁ m₂ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {μ : Measure Ω}
  [IsFiniteMeasure μ]

/-- **Regular conditional kernels for two σ-algebras with the same trace on an event `A ∈ m₁` agree almost surely on
`A`.** -/
theorem ae_condExpKernel_eq_of_trace (hm₁ : m₁ ≤ mΩ) (hm₂ : m₂ ≤ mΩ) {A : Set Ω}
    (hA : MeasurableSet[m₁] A) (htr : ∀ t, MeasurableSet[m₁] (A ∩ t) ↔ MeasurableSet[m₂] (A ∩ t)) :
    ∀ᵐ ω ∂μ, ω ∈ A → condExpKernel μ m₁ ω = condExpKernel μ m₂ ω := by
  have : MeasurableSpace.CountablyGenerated Ω := by
    let := upgradeStandardBorel Ω
    infer_instance
  obtain ⟨C, hCc, hCpi, hCgen⟩ := Exist.Param12.exists_countable_isPiSystem_generate Ω
  have hCm : ∀ s ∈ C, MeasurableSet s := fun s hs => by
    rw [hCgen]
    exact MeasurableSpace.measurableSet_generateFrom hs
  have hs : ∀ s ∈ C, ∀ᵐ ω ∂μ, ω ∈ A → (condExpKernel μ m₁ ω).real s = (condExpKernel μ m₂ ω).real s := by
    intro s hsC
    have h1 := condExpKernel_ae_eq_condExp (μ := μ) hm₁ (hCm s hsC)
    have h2 := condExpKernel_ae_eq_condExp (μ := μ) hm₂ (hCm s hsC)
    have h3 : μ⟦s | m₁⟧ =ᵐ[μ.restrict A] μ⟦s | m₂⟧ :=
      condExp_ae_eq_restrict_of_measurableSpace_eq_on hm₁ hm₂ hA htr
    rw [EventuallyEq, ae_restrict_iff' (hm₁ _ hA)] at h3
    filter_upwards [h1, h2, h3] with ω e1 e2 e3 hωA
    rw [e1, e2, e3 hωA]
  filter_upwards [(ae_ball_iff hCc).2 hs] with ω hω hωA
  refine ext_of_generate_finite C hCgen hCpi (fun s hsC => ?_) (by rw [measure_univ, measure_univ])
  exact (measureReal_eq_measureReal_iff).1 (hω s hsC hωA)

end Trace

section Restrict

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {μ : Measure Ω} [IsFiniteMeasure μ]

/-- **Adding a map that is almost surely a function of `V` on `{V ∈ B}` does not change the regular conditional
kernel there.** -/
theorem ae_condExpKernel_eq_comap_pair {β γ : Type*} [MeasurableSpace β] [MeasurableSpace γ] {V : Ω → β}
    {U : Ω → γ} (hV : Measurable V) (hU : Measurable U) {B : Set β} (hB : MeasurableSet B) {ψ : β → γ}
    (hψ : Measurable ψ) (hUV : ∀ᵐ ω ∂μ, V ω ∈ B → U ω = ψ (V ω)) :
    ∀ᵐ ω ∂μ, V ω ∈ B → condExpKernel μ (MeasurableSpace.comap V inferInstance) ω =
      condExpKernel μ (MeasurableSpace.comap (fun ω => (V ω, U ω)) inferInstance) ω := by
  classical
  set U' : Ω → γ := fun ω => if V ω ∈ B then ψ (V ω) else U ω with hU'
  have hU'm : Measurable U' := Measurable.ite (hV hB) (hψ.comp hV) hU
  have hUU' : ∀ᵐ ω ∂μ, (V ω, U ω) = (V ω, U' ω) := by
    filter_upwards [hUV] with ω hω
    by_cases hb : V ω ∈ B
    · simp only [hU', hb, ↓reduceIte, hω hb]
    · simp only [hU', hb, ↓reduceIte]
  have hpair := KernelTower.ae_condExpKernel_comap_eq (P := μ) (hV.prodMk hU) (hV.prodMk hU'm) measurable_id
    measurable_id hUU' (hUU'.mono fun _ h => h.symm)
  have hA : MeasurableSet[MeasurableSpace.comap V inferInstance] (V ⁻¹' B) := ⟨B, hB, rfl⟩
  have hle : MeasurableSpace.comap V inferInstance ≤ MeasurableSpace.comap (fun ω => (V ω, U' ω)) inferInstance := by
    have : V = Prod.fst ∘ fun ω => (V ω, U' ω) := rfl
    conv_lhs => rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono measurable_fst.comap_le
  have htr : ∀ t, MeasurableSet[MeasurableSpace.comap V inferInstance] (V ⁻¹' B ∩ t) ↔
      MeasurableSet[MeasurableSpace.comap (fun ω => (V ω, U' ω)) inferInstance] (V ⁻¹' B ∩ t) := by
    intro t
    refine ⟨fun h => hle _ h, ?_⟩
    rintro ⟨E, hE, hEt⟩
    refine ⟨B ∩ (fun x => (x, ψ x)) ⁻¹' E, hB.inter ((measurable_id.prodMk hψ) hE), ?_⟩
    ext ω
    constructor
    · rintro ⟨hb, hE'⟩
      have h' : (V ω, U' ω) ∈ E := by simpa only [hU', hb, ↓reduceIte, mem_preimage] using hE'
      rw [← hEt]
      exact h'
    · intro hω
      have hω' : ω ∈ (fun ω => (V ω, U' ω)) ⁻¹' E := hEt ▸ hω
      have hb : V ω ∈ B := hω.1
      refine ⟨hb, ?_⟩
      simpa only [mem_preimage, hU', hb, ↓reduceIte] using hω'
  have hmain := ae_condExpKernel_eq_of_trace (μ := μ) hV.comap_le (hV.prodMk hU'm).comap_le hA htr
  filter_upwards [hmain, hpair] with ω h1 h2 hb
  rw [h1 hb, h2]

/-- **Two maps that determine each other almost surely on a common event give the same regular conditional kernels
almost surely on that event.** The event is `{V₁ ∈ B₁}`, almost surely equal to `{V₂ ∈ B₂}`; on it `V₁ = φ (V₂)` and
`V₂ = ψ (V₁)` almost surely. -/
theorem ae_condExpKernel_eq_of_restrict {β₁ β₂ : Type*} [MeasurableSpace β₁] [MeasurableSpace β₂] {V₁ : Ω → β₁}
    {V₂ : Ω → β₂} (hV₁ : Measurable V₁) (hV₂ : Measurable V₂) {B₁ : Set β₁} (hB₁ : MeasurableSet B₁) {B₂ : Set β₂}
    (hB₂ : MeasurableSet B₂) (hA : V₁ ⁻¹' B₁ =ᵐ[μ] V₂ ⁻¹' B₂) {φ : β₂ → β₁} (hφ : Measurable φ) {ψ : β₁ → β₂}
    (hψ : Measurable ψ) (h₁ : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → V₁ ω = φ (V₂ ω))
    (h₂ : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → V₂ ω = ψ (V₁ ω)) :
    ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → condExpKernel μ (MeasurableSpace.comap V₁ inferInstance) ω =
      condExpKernel μ (MeasurableSpace.comap V₂ inferInstance) ω := by
  have hA' : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ ↔ V₂ ω ∈ B₂ := by
    filter_upwards [hA] with ω hω
    exact Iff.of_eq hω
  have k1 := ae_condExpKernel_eq_comap_pair (μ := μ) hV₁ hV₂ hB₁ hψ h₂
  have h₁' : ∀ᵐ ω ∂μ, V₂ ω ∈ B₂ → V₁ ω = φ (V₂ ω) := by
    filter_upwards [h₁, hA'] with ω h h' hb
    exact h (h'.2 hb)
  have k2 := ae_condExpKernel_eq_comap_pair (μ := μ) hV₂ hV₁ hB₂ hφ h₁'
  have hswap := KernelTower.ae_condExpKernel_comap_eq (P := μ) (hV₁.prodMk hV₂) (hV₂.prodMk hV₁) measurable_swap
    measurable_swap (Eventually.of_forall fun _ => rfl) (Eventually.of_forall fun _ => rfl)
  filter_upwards [k1, k2, hswap, hA'] with ω e1 e2 e3 e4 hb
  rw [e1 hb, e3, ← e2 (e4.1 hb)]

end Restrict

/-! ### Conditioning on a σ-algebra identified with `(X, Ψ (X, Y))` on an event -/

section Ident

variable {Ω A B C D β₁ : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] [MeasurableSpace A]
  [MeasurableSpace B] [StandardBorelSpace B] [Nonempty B] [MeasurableSpace C] [MeasurableSpace D]
  [StandardBorelSpace D] [Nonempty D] [MeasurableSpace β₁] [MeasurableSpace.CountableOrCountablyGenerated A C]
  {μ : Measure Ω} [IsFiniteMeasure μ]

/-- **The retained-kernel transfer.** Let `V₁` generate the conditioning σ-algebra, and suppose that on the event
`{V₁ ∈ B₁}` — almost surely the event `{(X, Ψ (X, Y)) ∈ B₂}` — `V₁` and `(X, Ψ (X, Y))` determine each other almost
surely (`V₁ = φ (X, Ψ (X, Y))`, `(X, Ψ (X, Y)) = ψ (V₁)`), and the sample is `S (X, Y)` almost surely. If the fibre
conditional laws (`ae_condExpKernel_map_mem_of_fibre`) lie in a measurable set `𝒮` on `{X ∈ G}`, then almost surely on
`{X ∈ G} ∩ {V₁ ∈ B₁}` the regular conditional law of the sample given `σ(V₁)` lies in `𝒮`. -/
theorem ae_condExpKernel_map_mem_of_ident {X : Ω → A} {Y : Ω → B} {V₁ : Ω → β₁} {Z : Ω → D} {Ψ : A × B → C}
    {S : A × B → D} (hX : Measurable X) (hY : Measurable Y) (hV₁ : Measurable V₁) (hΨ : Measurable Ψ)
    (hS : Measurable S) {B₁ : Set β₁} (hB₁ : MeasurableSet B₁) {B₂ : Set (A × C)}
    (hB₂ : MeasurableSet B₂) (hA : V₁ ⁻¹' B₁ =ᵐ[μ] (fun ω => (X ω, Ψ (X ω, Y ω))) ⁻¹' B₂) {φ : A × C → β₁}
    (hφ : Measurable φ) {ψ : β₁ → A × C} (hψ : Measurable ψ)
    (h₁ : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → V₁ ω = φ (X ω, Ψ (X ω, Y ω)))
    (h₂ : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → (X ω, Ψ (X ω, Y ω)) = ψ (V₁ ω))
    (hZS : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ → Z ω = S (X ω, Y ω)) {G : Set A} (hG : MeasurableSet G) {𝒮 : Set (Measure D)}
    (h𝒮 : MeasurableSet 𝒮)
    (hfib : ∀ᵐ ω ∂μ, X ω ∈ G → ∀ᵐ c ∂((condDistrib Y X μ (X ω)).map fun y => Ψ (X ω, y)),
      ((condDistrib Y X μ (X ω)).map fun y => (Ψ (X ω, y), S (X ω, y))).condKernel c ∈ 𝒮) :
    ∀ᵐ ω ∂μ, X ω ∈ G → V₁ ω ∈ B₁ → (condExpKernel μ (MeasurableSpace.comap V₁ inferInstance) ω).map Z ∈ 𝒮 := by
  have hXY : Measurable fun ω => (X ω, Y ω) := hX.prodMk hY
  set V₂ : Ω → A × C := fun ω => (X ω, Ψ (X ω, Y ω)) with hV₂def
  have hV₂ : Measurable V₂ := hX.prodMk (hΨ.comp hXY)
  have hSm : Measurable fun ω => S (X ω, Y ω) := hS.comp hXY
  -- the two conditional kernels agree on the event
  have hk := ae_condExpKernel_eq_of_restrict (μ := μ) hV₁ hV₂ hB₁ hB₂ hA hφ hψ h₁ h₂
  -- the sample is `S (X, Y)` under the conditional kernel given `σ(V₂)`, on the event
  have hA' : ∀ᵐ ω ∂μ, V₁ ω ∈ B₁ ↔ V₂ ω ∈ B₂ := by
    filter_upwards [hA] with ω hω
    exact Iff.of_eq hω
  have hZS₂ : ∀ᵐ ω ∂μ, V₂ ω ∈ B₂ → Z ω = S (X ω, Y ω) := by
    filter_upwards [hZS, hA'] with ω h h' hb
    exact h (h'.2 hb)
  have hm₂ : MeasurableSpace.comap V₂ inferInstance ≤ mΩ := hV₂.comap_le
  have hE₂ : MeasurableSet[MeasurableSpace.comap V₂ inferInstance] (V₂ ⁻¹' B₂) := ⟨B₂, hB₂, rfl⟩
  have hker := KernelTower.ae_ae_condExpKernel_of_ae (P := μ) hm₂ hZS₂
  have hconc := KernelTower.ae_condExpKernel_compl_eq_zero (P := μ) hm₂ hE₂
  have hmap : ∀ᵐ ω ∂μ, V₂ ω ∈ B₂ → (condExpKernel μ (MeasurableSpace.comap V₂ inferInstance) ω).map Z =
      (condExpKernel μ (MeasurableSpace.comap V₂ inferInstance) ω).map fun ω => S (X ω, Y ω) := by
    filter_upwards [hker, hconc] with ω h1 h2 hb
    refine Measure.map_congr ?_
    have h3 : ∀ᵐ x ∂(condExpKernel μ (MeasurableSpace.comap V₂ inferInstance) ω), x ∈ V₂ ⁻¹' B₂ :=
      measure_eq_zero_iff_ae_notMem.1 (by simpa only [compl_def] using h2.1 hb) |>.mono fun x hx => by
        simpa only [mem_compl_iff, not_not, mem_preimage, mem_ofPred_eq] using hx
    filter_upwards [h1, h3] with x hx1 hx2
    exact hx1 hx2
  have hfibre := ae_condExpKernel_map_mem_of_fibre (μ := μ) hX hY hΨ hS hG h𝒮 hfib
  filter_upwards [hk, hmap, hfibre, hA'] with ω e1 e2 e3 e4 hG' hb
  rw [e1 hb, e2 (e4.1 hb)]
  exact e3 hG'

end Ident

/-! ### The measurable sets of measures used by the stage-model estimates -/

section Sets

variable {D : Type*} [MeasurableSpace D]

/-- The measures giving a measurable event mass above a bound form a measurable set (the crossing bound
`1 − ε < K(reach)` of `IsStageModel`). -/
theorem measurableSet_lt_apply {E : Set D} (hE : MeasurableSet E) (r : ℝ≥0∞) :
    MeasurableSet {ν : Measure D | r < ν E} :=
  measurableSet_lt measurable_const (Measure.measurable_coe hE)

/-- The measures giving a measurable event mass at least a bound form a measurable set (the slow bound
`p₀ ≤ K(slow)` of `IsStageModel`). -/
theorem measurableSet_le_apply {E : Set D} (hE : MeasurableSet E) (r : ℝ≥0∞) :
    MeasurableSet {ν : Measure D | r ≤ ν E} :=
  measurableSet_le measurable_const (Measure.measurable_coe hE)

end Sets

end InteractingSLE.Theorem14.GW2KMod
