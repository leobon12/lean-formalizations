/-!
# The later-line facts of a retained continuation for mean-identified words (any retained pair)

Packet PROVE-T15-ORDDET (Theorem 1.5's leaf 3, `RLC.RetOrdDetStatement`). The safe law (S) of K2 for the retained
continuation is assembled from line facts (`RetAux79.hasSafeLaw_of_retLines`, its hypothesis `hline`): at every later
line, (III-a) the later chart is the stop-line chart followed by the continuation's Loewner map, and (III-b) the force
data of the stop-line word, flowed to the line, are the later word plus `θχ` off a finite set. PROVE-RETAUX79B proved
them for the explicit zone words of disjoint pairs (`RetAux79.retLine_facts`, `exists_retLine_facts_canon`). This file
proves them for **any** words identifying the conditional means at the two lines (`IsRetMeanIdentOn`, e.g. the data of
`RetOrdMeanWordStatement` at both pairs), for every retained pair — touching or not — and through real contacts of the
continuation, with one remaining pathwise input, the **slit heights** of the later word (its values on the chart images
of the two sides of the new piece):

* **`ae_retLine_facts_of_meanIdent`** (a.s.): (III-a) from `RetAux79.retChart_trans_of_image`; (III-b) from the
  transport identity at alive real points (`OrdDet.ae_fn_eq_of_trans`, Aux. lemma 79 by nested Proposition 3.8) and the
  assembly `OrdDet.forceBoundaryData_eq_add_of_transport`, given the slit heights;
* **`exists_ordCont_facts`** (pathwise): at an ordinary retained pair the canonical retained clock of the second
  continuation (stopped at its first new contact with the retained union only, real contacts allowed) has a continuous
  driver generating it, and at every continuation time its capacity time and chart images are those required above
  (`Supp7.isRetCont_snd`, `RetAux79.canonRetPath_facts`).

For Theorem 1.5; uses Lemma 7.5 only (R43/R48).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology Metric Complex
open scoped NNReal ENNReal

open QuantumZipper (H fwdMap fwdMapInv fwdHull logDerivFwd)
open LQGMetric (DistOn TestOn)

universe u

namespace InteractingSLE

namespace RLC

namespace OrdDet

open Sec7 Sec7.Lemma76F Restart Restart.RetAux79 Supp7 MartChar.RealFlow

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {x₁ x₂ θ₁ θ₂ : ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω]
  {P : Measure Ω} [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ}
  {ζ₁ ζ₂ : Ω → ℝ≥0∞}

/-- **The later-line facts for mean-identified words** (see the module docstring). Two retained data `d` (cutoffs
`(u, r)`) and `d'` (cutoffs `(u, r + t)`) of the same paths, words `β₀`, `β₁` identifying the conditional means on
`O₀`, `O₁`. Almost surely, at every sample of `O₀ ∩ O₁` with both cutoffs alive and in both chart events, for every
chart path `γ` of the continuation (generated by a continuous driver `W`, injective, `0 < Q < ζc`, with
`d.inv ∘ γ ([0, Q]) = η₂([r, r + t])` ending at the later tip) for which the later word has the slit heights at `Q`:
the later chart is the stop-line chart followed by `f_Q`, and the flowed force data of `β₀` equal `β₁ + θχ` off a
finite set. -/
theorem ae_retLine_facts_of_meanIdent (hL75 : Theorem15.Lemma75Statement.{u}) (hκ : 0 < κ) (hκ4 : κ < 4)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hh : IsGFFWithBoundaryData P h b jumps)
    (hη₁ : IsFlowLine κ b jumps x₁ θ₁ P h η₁ ζ₁) (hη₂ : IsFlowLine κ b jumps x₂ θ₂ P h η₂ ζ₂)
    {u₀ : ℂ → ℝ} (hu₀ : IsBoundedHarmonicExtension b jumps u₀)
    {d d' : RetData Ω} (hd : d.IsMeasGood) (hd' : d'.IsMeasGood)
    (hag : ∀ᵐ ω ∂P, (d.u : ℝ≥0∞) < ζ₁ ω → (d.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d.G ∧
      (∀ s ≤ d.u, d.η₁ ω s = η₁ ω s) ∧ ∀ t ≤ d.r, d.η₂ ω t = η₂ ω t)
    (hag' : ∀ᵐ ω ∂P, (d'.u : ℝ≥0∞) < ζ₁ ω → (d'.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d'.G ∧
      (∀ s ≤ d'.u, d'.η₁ ω s = η₁ ω s) ∧ ∀ t ≤ d'.r, d'.η₂ ω t = η₂ ω t)
    (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) (hu : d'.u = d.u) {t : ℝ≥0} (hr : d'.r = d.r + t)
    {O₀ O₁ : Set Ω} {β₀ β₁ : Ω → BoundaryWord}
    (hm₀ : IsRetMeanIdentOn κ P h η₁ η₂ ζ₁ ζ₂ u₀ hd O₀ β₀)
    (hm₁ : IsRetMeanIdentOn κ P h η₁ η₂ ζ₁ ζ₂ u₀ hd' O₁ β₁) (θ : ℝ) :
    ∀ᵐ ω ∂P, ω ∈ O₀ → ω ∈ O₁ → (d'.u : ℝ≥0∞) < ζ₁ ω → (d'.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d.E → ω ∈ d'.E →
      (β₀ ω).IsSorted → (β₁ ω).IsSorted →
      ∀ (W : ℝ≥0 → ℝ) (γ : ℝ≥0 → ℂ) (ζc : ℝ≥0∞) (Q : ℝ≥0), IsGeneratingTrace W ζc γ → Continuous W →
        W 0 = 0 → InjOn γ {s | (s : ℝ≥0∞) ≤ ζc} → (Q : ℝ≥0∞) < ζc → 0 < Q →
        (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t) →
        d.inv ω (γ Q) = d.η₂ ω (d.r + t) →
        (∃ S' : Set ℝ, S'.Finite ∧
          (∀ y ∉ S', -rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - W Q < y → y < 0 →
            (β₁ ω).fn y = -sleLambda κ - θ * QuantumZipper.chiC κ) ∧
          (∀ y ∉ S', 0 < y → y < rightImg (fun s : ℝ => W s.toNNReal) 0 Q - W Q →
            (β₁ ω).fn y = sleLambda κ - θ * QuantumZipper.chiC κ)) →
        (∀ w ∈ H, (d'.chart ω).2.1 w = (d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)) ∧
        (∀ w ∈ H, (d'.chart ω).2.2 ((d'.chart ω).2.1 w) =
          (logDerivFwd (fun s : ℝ => W s.toNNReal) Q (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)).im +
            (d.chart ω).2.2 ((d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))) ∧
        ∃ S : Set ℝ, S.Finite ∧ ∀ y ∉ S,
          forceBoundaryData κ (flowLineRhoL κ (β₀ ω).fn (β₀ ω).jumps 0 θ)
              (flowLineRhoR κ (β₀ ω).fn (β₀ ω).jumps 0 θ)
              (fun i => -rightImg (fun s : ℝ => -W s.toNNReal) (-flowLineXL (β₀ ω).fn (β₀ ω).jumps 0 i) Q - W Q)
              (fun j => rightImg (fun s : ℝ => W s.toNNReal) (flowLineXR (β₀ ω).fn (β₀ ω).jumps 0 j) Q - W Q) y =
            (β₁ ω).fn y + θ * QuantumZipper.chiC κ := by
  have huu : d.u ≤ d'.u := hu.ge
  have hrr : d.r ≤ d'.r := by rw [hr]; exact le_self_add
  have htr := ae_fn_eq_of_trans hL75 hκ hκ4 hb hh hη₁ hη₂ hu₀ hd hd' hag hag' huu hrr hm₀ hm₁
  filter_upwards [htr] with ω htrω
  intro hO₀ hO₁ hu₁ hr₁ hE hE' hs₀ hs₁ W γ ζc Q hg hWc hW0 hinj hQ hQ0 himg htip hslit
  obtain ⟨hinv, hlift⟩ := retChart_trans_of_image hd hd' h₁ h₂ hu hr hE hE' hg hWc hW0 hinj hQ hQ0 himg htip
  refine ⟨hinv, hlift, ?_⟩
  have hw'c : Continuous fun s : ℝ => W s.toNNReal := hWc.comp continuous_real_toNNReal
  have hw'0 : (fun s : ℝ => W s.toNNReal) 0 = 0 := by simp [hW0]
  have htr' : ∀ (x : ℝ) (v : ℝ → ℂ), QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q v →
      x ∉ (β₀ ω).jumps → (v Q).re ∉ (β₁ ω).jumps → (β₁ ω).fn (v Q).re = (β₀ ω).fn x :=
    fun x v hv hx hy => htrω hO₀ hO₁ hu₁ hr₁ hE hE' hs₀ hs₁ _ Q hw'c hw'0 Q.coe_nonneg hinv hlift x v hv hx hy
  obtain ⟨S', hS', hL, hR⟩ := hslit
  exact forceBoundaryData_eq_add_of_transport hκ θ hWc htr' hS' hL hR

/-- **The canonical retained clock of the second continuation at an ordinary retained pair** (pathwise). At a
sample of the chart event of retained data `d` agreeing with a good path `η` on `[0, r]`, with the second tip interior,
off the first prefix and adherent to the active domain: the canonical retained clock (stop at the first new contact
with `η₁[0, u] ∪ η[0, r]`, real contacts allowed) has a continuous driver `W` with `W 0 = 0` generating it injectively
up to its lifetime, and at every continuation time `t` before the stop the capacity time `Q = C(t)` satisfies `0 < Q`
(for `t > 0`), `Q <` the lifetime, `d.inv ∘ γ([0, Q]) = η([r, r + t])` and `d.inv (γ Q) = η(r + t)`. -/
theorem exists_ordCont_facts {d : RetData Ω} (hd : d.IsMeasGood) {ω : Ω} (hω : ω ∈ d.E) {η : ℝ≥0 → ℂ}
    {ζ : ℝ≥0∞} {x : ℝ} (hp : IsPathGood η ζ x) (hβ₀ : ∀ s ≤ d.r, d.η₂ ω s = η s) (hrζ : (d.r : ℝ≥0∞) < ζ) :
    ∃ W : ℝ≥0 → ℝ, Continuous W ∧ W 0 = 0 ∧
      IsGeneratingTrace W (canonRetLife (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0)
        (canonRetPath (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0) ∧
      InjOn (canonRetPath (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0)
        {s | (s : ℝ≥0∞) ≤ canonRetLife (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0} ∧
      ∀ t : ℝ≥0, 0 < t → (t : ℝ≥0∞) < contLife η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) →
        let Q := (chartClock (contPath (d.D ω) (d.fwd ω) η d.r
          (contLife η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r))) t).toNNReal
        0 < Q ∧ (Q : ℝ≥0∞) < canonRetLife (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0 ∧
        (fun s => d.inv ω (canonRetPath (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0 s)) ''
            Icc 0 Q = η '' Icc d.r (d.r + t) ∧
        d.inv ω (canonRetPath (d.D ω) (d.fwd ω) η ζ d.r (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) 0 Q) =
          η (d.r + t) := by
  have hg := hd.good ω (RetData.E_subset_G hω)
  obtain ⟨⟨x₀, hx₀⟩, hC⟩ := hd.isRetChart hω
  have hφ : ∃ x₀ : ℝ, ∀ z, d.fwd ω z =
      ConformalImage.mapOut (fillH (prefixSet (d.η₁ ω) d.u (d.η₂ ω) d.r)) z - x₀ :=
    ⟨x₀, fun z => by
      show d.g ω z - d.shift ω = _
      rw [hx₀, RetData.g, RetData.K_of_mem hω]⟩
  have hωE₀ := RetData.E_subset_E₀ hω
  have hcl : d.η₂ ω d.r ∈ closure (activeDomain (d.η₁ ω) d.u (d.η₂ ω) d.r) := by
    rw [← hd.DOf_of_mem RetData.E₀_subset_G hωE₀]
    exact hω.2
  have hR := isRetCont_snd hg hC hφ hp hβ₀ hrζ hωE₀.1.2 hωE₀.2 hcl
  have hD : d.D ω = H \ fillH (d.η₁ ω '' Icc 0 d.u ∪ η '' Icc 0 d.r) := by
    rw [hd.D_of_mem hω, activeDomain_eq (isCompact_prefixSet' hg.1 hg.2.1).isClosed, prefixSet,
      image_congr fun t ht => hβ₀ t ht.2]
  rw [hD]
  obtain ⟨W, hWc, hW0, hgen, hinj, hfacts⟩ := canonRetPath_facts hR
  refine ⟨W, hWc, hW0, hgen, hinj, fun t ht0 htV => ?_⟩
  obtain ⟨-, hQlt, hQpos, himg, htip⟩ := hfacts t htV.le
  exact ⟨hQpos ht0, hQlt htV, himg, htip⟩

