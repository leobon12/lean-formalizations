/-!
# SB2(2)'s retained-law induction: the step through one piece (`ℓ → ℓ + 2`)

Worker REVIEW-FABLE-T14 (items 2–3 of PROVE-SB2-LCMEAN's handoff R13.8; R121's route). At stage `ℓ` let the marks be
generated by `p` (B's uncompleted marks `𝓖_ℓ 0`), `Y` the field read in the canonical hull chart `Mo.hullChart K x₀`
offset at the seed, `β` a sorted marks-measurable word, and `e` a measurable, everywhere regular driver that is, given
the marks, the angle-`θ` flow-line driver of `Y` with the data of `β` on `L` (the conditional half at stage `ℓ`; for
the canonical relative driver this is Theorem 1.3, `Exist.StagedAssembly.exists_flowDrv_condKernel`). Let `ℋ` be the
finer marks of stage `ℓ + 2`, for which `p` and the record of `e` are measurable (the record matching), `A` the
retained union through the start of stage `ℓ + 2` (marked local for `ℋ`), `K₂` an `ℋ`-measurable compact hull, and
`G ∈ ℋ` an event inside `L` with finite lifetime on which `A = fill K₂` and, when the record is good,
`fill K₂ = K ∪ (Mo.hullChart K x₀)⁻¹(K_T)` (the terminal hull identity, `Qw.hull_eq_of_cofinal`).

Then the field after the piece (`stepField`: the record field shifted by `x₀ + W_T`, defined at every sample) is the
field read in `Mo.hullChart (fill K₂) 0` almost surely on `G`, and given `ℋ` it is almost surely on `G` a GFF with the
stopped word shifted (`stepWord`). Ingredients: the single-stage law (`Qt.ae_condExp_recField_eq_gaussCF`), the
goodness of the record (`Exist.StagedLaw.ae_isDrvGood_of_isFlowLineDriver`), the chart identity
(`Qw.isChartTransport_hullChart_recField`), and the retained law given finer marks
(`Qw.ae_isGFF_of_coarse_of_marked_on`).

* `endV`, `stepField`, `stepWord` (+ measurability);
* **`ae_isChartTransport_stepField`**;
* **`ae_isGFF_stepField`**.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal
open QuantumZipper (H chiC)
open LQGMetric (DistOn TestOn)

universe u

namespace InteractingSLE.Theorem14.SB.Qw

open Restart Exist Exist.Staged Exist.StagedLaw LocalSets WholeField

/-- The driver of a record at its recorded time (the end value of a good record). -/
def endV (r : RecData) : ℝ := LocalExt.histDrv (recHist r) (LocalExt.histTime (recHist r))

theorem measurable_endV : Measurable endV := by
  have h := (LocalExt.measurable_histDrv (nL := 0) (nR := 0)).comp
    (measurable_id.prodMk (LocalExt.measurable_histTime (nL := 0) (nR := 0)))
  exact h.comp measurable_recHist

theorem endV_recOf {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (he : IsRegularDriver e)
    (hg : LocalExt.IsDrvGood (recHist (recOf ⊤ e))) : endV (recOf ⊤ e) = recDrv e (e.2.toNNReal : ℝ) := by
  have hT : LocalExt.histTime (recHist (recOf ⊤ e)) = e.2.toNNReal := by
    change ((recOf ⊤ e).2.1 : WithTop ℝ≥0).untopD 0 = e.2.toNNReal
    have h2 : (recOf ⊤ e).2.1 = e.2 := min_eq_right le_top
    rw [h2]
    cases e.2 with
    | top => rfl
    | coe a => rfl
  unfold endV recDrv
  rw [hT, histDrv_recHist he hg, Real.toNNReal_coe]

/-- The field after the piece: the record field of `Y`, shifted by `x₀ + W_T`. -/
def stepField (κ : ℝ) {Ω : Type*} (x₀ : Ω → ℝ) (e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (Y : Ω → DistOn upperHalfPlaneOpens)
    (ω : Ω) : DistOn upperHalfPlaneOpens :=
  flowField (-(x₀ ω + endV (recOf ⊤ (e ω)))) 0 (recField κ (recOf ⊤ (e ω)) (Y ω))

/-- The word after the piece: the stopped word, shifted by `x₀ + W_T`. -/
def stepWord (κ θ : ℝ) {Ω : Type*} (x₀ : Ω → ℝ) (β : Ω → BoundaryWord) (e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (ω : Ω) :
    BoundaryWord :=
  BoundaryWord.shiftW (-(x₀ ω + endV (recOf ⊤ (e ω)))) (stopWord κ (β ω, θ, recOf ⊤ (e ω)))

theorem measurable_stepField (κ : ℝ) {Ω : Type*} [MeasurableSpace Ω] {x₀ : Ω → ℝ} (hx₀ : Measurable x₀)
    {e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} (hr : Measurable fun ω => recOf ⊤ (e ω)) {Y : Ω → DistOn upperHalfPlaneOpens}
    (hY : Measurable Y) : Measurable (stepField κ x₀ e Y) := by
  have hs : Measurable fun ω => -(x₀ ω + endV (recOf ⊤ (e ω))) := (hx₀.add (measurable_endV.comp hr)).neg
  have hz : Measurable fun ω => recField κ (recOf ⊤ (e ω)) (Y ω) := measurable_recField_comp κ hr hY
  have h := measurable_flowField_uncurry.comp (hs.prodMk hz)
  exact h

theorem measurable_stepWord (κ θ : ℝ) {Ω : Type*} {m : MeasurableSpace Ω} {x₀ : Ω → ℝ} (hx₀ : Measurable[m] x₀)
    {β : Ω → BoundaryWord} (hβ : Measurable[m] β) {e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}
    (hr : Measurable[m] fun ω => recOf ⊤ (e ω)) : Measurable[m] (stepWord κ θ x₀ β e) := by
  have hs : Measurable[m] fun ω => -(x₀ ω + endV (recOf ⊤ (e ω))) := (hx₀.add (measurable_endV.comp hr)).neg
  have hw : Measurable[m] fun ω => stopWord κ (β ω, θ, recOf ⊤ (e ω)) :=
    (measurable_stopWord κ).comp (hβ.prodMk (measurable_const.prodMk hr))
  have h := BoundaryWord.measurable_shiftW.comp (hs.prodMk hw)
  exact h

theorem isSorted_stepWord (κ θ : ℝ) {Ω : Type*} (x₀ : Ω → ℝ) (β : Ω → BoundaryWord) (e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞)
    (ω : Ω) : (stepWord κ θ x₀ β e ω).IsSorted :=
  BoundaryWord.isSorted_shiftW (isSorted_stopWord κ _) _

/-- **The field after the piece is read in the new hull chart**, where the record is good and the terminal hull
identity holds. -/
theorem isChartTransport_stepField {κ : ℝ} {Ω : Type*} {x₀ : Ω → ℝ} {e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}
    {Y : Ω → DistOn upperHalfPlaneOpens} {h : Ω → DistOn upperHalfPlaneOpens} {K K₂ : Ω → Set ℂ} {ω : Ω}
    (hK : IsHPHull (K ω)) (hYt : IsChartTransport (Mo.hullChart (K ω) (x₀ ω)) 1 0 (chiC κ) (h ω) (Y ω))
    (hreg : IsRegularDriver (e ω)) (hg : LocalExt.IsDrvGood (recHist (recOf ⊤ (e ω))))
    (hK₂ : fillH (K₂ ω) = stepHull (K ω) (x₀ ω) (recDrv (e ω)) ((e ω).2.toNNReal : ℝ)) :
    IsChartTransport (Mo.hullChart (fillH (K₂ ω)) 0) 1 0 (chiC κ) (h ω) (stepField κ x₀ e Y ω) := by
  have h1 := isChartTransport_hullChart_recField hK (x₀ ω) hYt hreg hg
  unfold stepField
  rw [hK₂, endV_recOf hreg hg]
  exact h1

/-- **The step through one piece.** See the module docstring. -/
theorem ae_isGFF_stepField {κ : ℝ} (hκ : 0 < κ) {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u}
    {ℋ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : IsGFFWithBoundaryData P h b jumps) {u₀ : ℂ → ℝ}
    (hu₀ : IsBoundedHarmonicExtension b jumps u₀) {S : Type*} [MeasurableSpace S] [StandardBorelSpace S]
    {p : Ω → S} (hp : Measurable p) (hℋ : ℋ ≤ mΩ) (hpℋ : Measurable[ℋ] p)
    {β : Ω → BoundaryWord} (hβ : Measurable[MeasurableSpace.comap p inferInstance] β)
    {Y : Ω → DistOn upperHalfPlaneOpens} (hY : Measurable Y) {e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} (he : Measurable e)
    (hreg : ∀ ω, IsRegularDriver (e ω)) (hrℋ : Measurable[ℋ] fun ω => recOf ⊤ (e ω)) {θ : ℝ} {L : Set Ω}
    (hL : MeasurableSet[MeasurableSpace.comap p inferInstance] L)
    (hfl : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → IsFlowLineDriver κ (β ω₀).fn (β ω₀).jumps θ
      (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀) Y (fun t ω => (e ω).1 t) (fun ω => (e ω).2))
    {x₀ : Ω → ℝ} (hx₀ : Measurable[MeasurableSpace.comap p inferInstance] x₀)
    {K₂ : Ω → Set ℂ} (hK₂m : @IsDyadicHitMeasurable Ω ℋ K₂) (hK₂c : ∀ ω, IsCompact (K₂ ω))
    (hK₂p : ∀ ω, IsPreconnected (K₂ ω ∪ Restart.lowerHalf)) {A : Ω → Set ℂ}
    (hAm : Measurable[mΩ, hittingSigma] A) (hAc : ∀ ω, A ω ⊆ H ∧ IsOpen (H \ A ω))
    (hAloc : IsHistoryAvoidanceLocal ℋ A (centredField h u₀) P) (hAl : IsLocalSet A (centredField h u₀) P)
    {G : Set Ω} (hG : MeasurableSet[ℋ] G) (hGL : G ⊆ L) (hGζ : ∀ ω ∈ G, (e ω).2 ≠ ⊤)
    (hGA : ∀ᵐ ω ∂P, ω ∈ G → A ω = fillH (K₂ ω))
    (hYt₂ : ∀ᵐ ω ∂P, ω ∈ G → LocalExt.IsDrvGood (recHist (recOf ⊤ (e ω))) →
      IsChartTransport (Mo.hullChart (fillH (K₂ ω)) 0) 1 0 (chiC κ) (h ω) (stepField κ x₀ e Y ω)) :
    ∀ᵐ ω₀ ∂P, ω₀ ∈ G → IsGFFWithBoundaryData (condExpKernel P ℋ ω₀) (stepField κ x₀ e Y)
      (stepWord κ θ x₀ β e ω₀).fn (stepWord κ θ x₀ β e ω₀).jumps := by
  classical
  set r : Ω → RecData := fun ω => recOf ⊤ (e ω) with hrdef
  have hr : Measurable r := measurable_recOf he hreg ⊤
  have hPΩ : MeasurableSpace.comap p inferInstance ≤ mΩ := hp.comap_le
  have hpr : Measurable fun ω => (p ω, r ω) := hp.prodMk hr
  have hmΩ : MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance ≤ mΩ := hpr.comap_le
  have hpm : Measurable[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance] p :=
    measurable_fst.comp (Measurable.of_comap_le le_rfl)
  have hrm : Measurable[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance] r :=
    measurable_snd.comp (Measurable.of_comap_le le_rfl)
  have hPm : MeasurableSpace.comap p inferInstance ≤ MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance :=
    hpm.comap_le
  have hmℋ : MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance ≤ ℋ := (hpℋ.prodMk hrℋ).comap_le
  -- goodness of the record, almost surely on `L` with finite lifetime
  have hGood : MeasurableSet[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance]
      {ω | LocalExt.IsDrvGood (recHist (r ω))} :=
    LocalExt.measurableSet_isDrvGood.preimage (measurable_recHist.comp hrm)
  have hFin : MeasurableSet[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance] {ω | (e ω).2 ≠ ⊤} := by
    have he2 : ∀ ω, (r ω).2.1 = (e ω).2 := fun ω => min_eq_right le_top
    have : {ω | (e ω).2 ≠ ⊤} = {ω | (r ω).2.1 ≠ ⊤} := by ext ω; simp only [mem_ofPred_eq, he2]
    rw [this]
    exact (measurableSet_eq_fun ((measurable_fst.comp measurable_snd).comp hrm) measurable_const).compl
  have hgood : ∀ᵐ ω ∂P, ω ∈ L → ω ∈ {ω | (e ω).2 ≠ ⊤ → LocalExt.IsDrvGood (recHist (r ω))} := by
    refine GW2Schedule.ae_of_ae_condExpKernel_on hPΩ hL ((hmΩ _ hFin).compl.union (hmΩ _ hGood) |>.congr ?_) ?_
    · ext ω; simp only [mem_union, mem_compl_iff, mem_ofPred_eq]; tauto
    · filter_upwards [hfl] with ω₀ hfl₀ hω₀
      filter_upwards [ae_isDrvGood_of_isFlowLineDriver hκ ⊤ hreg (hfl₀ hω₀)] with ω hω hfin
      exact hω (by rwa [min_eq_right le_top])
  -- the law of the record field given `m`, on `L` with finite lifetime
  set M : Set Ω := L ∩ {ω | (e ω).2 ≠ ⊤} with hMdef
  have hZm : Measurable fun ω => recField κ (r ω) (Y ω) := measurable_recField_comp κ hr hY
  have hlawZ : ∀ᵐ ω₀ ∂P, ω₀ ∈ M → IsGFFWithBoundaryData
      (condExpKernel P (MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance) ω₀)
      (fun ω => recField κ (r ω) (Y ω))
      (stopWord κ (β ω₀, θ, r ω₀)).fn (stopWord κ (β ω₀, θ, r ω₀)).jumps := by
    refine ae_isGFFWithBoundaryData_condExpKernel hmΩ (Eventually.of_forall fun ω _ => isSorted_stopWord κ _) hZm
      fun φ => ?_
    filter_upwards [Qt.ae_condExp_recField_eq_gaussCF hκ hp hβ hY he hreg hL hfl φ] with ω hω hωM
    exact hω hωM.1 hωM.2
  -- the shifted field's law given `m`, on `M` ∩ good
  set s : Ω → ℝ := fun ω => x₀ ω + endV (r ω) with hsdef
  have hsm : Measurable[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance] s :=
    (hx₀.mono hPm le_rfl).add (measurable_endV.comp hrm)
  set L' : Set Ω := M ∩ {ω | LocalExt.IsDrvGood (recHist (r ω))} with hL'def
  have hL' : MeasurableSet[MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance] L' :=
    ((hPm _ hL).inter hFin).inter hGood
  have hYm₂ : Measurable (stepField κ x₀ e Y) :=
    measurable_stepField κ (hx₀.mono hPΩ le_rfl) hr hY
  have hlaw₂ : ∀ᵐ ω₀ ∂P, ω₀ ∈ L' → IsGFFWithBoundaryData
      (condExpKernel P (MeasurableSpace.comap (fun ω => (p ω, r ω)) inferInstance) ω₀)
      (stepField κ x₀ e Y)
      (stepWord κ θ x₀ β e ω₀).fn (stepWord κ θ x₀ β e ω₀).jumps := by
    filter_upwards [hlawZ, Sec7.Aux122Disint.ae_ae_condExpKernel_eq (P := P) hmΩ hsm] with ω₀ hl hseq hω₀
    have hg := hl hω₀.1
    have hrec := Supp9.IsGFFWithBoundaryData.recenter
      (stopWord κ (β ω₀, θ, r ω₀)).isPiecewiseConstantBoundaryData (-s ω₀) hg
    have hfn : (stepWord κ θ x₀ β e ω₀).fn = fun y => (stopWord κ (β ω₀, θ, r ω₀)).fn (y + -s ω₀) :=
      funext (BoundaryWord.fn_shiftW _ _)
    have hj : (stepWord κ θ x₀ β e ω₀).jumps = (stopWord κ (β ω₀, θ, r ω₀)).jumps.image (· - -s ω₀) :=
      BoundaryWord.jumps_shiftW _ _
    rw [hfn, hj]
    refine isGFFWithBoundaryData_congr_ae hrec hYm₂ ?_
    filter_upwards [hseq] with ω hω
    change flowField (-s ω₀) 0 (recField κ (r ω) (Y ω)) = flowField (-s ω) 0 (recField κ (r ω) (Y ω))
    rw [hω]
  -- the retained law given `ℋ`
  set G' : Set Ω := G ∩ {ω | LocalExt.IsDrvGood (recHist (r ω))} with hG'def
  have hG' : MeasurableSet[ℋ] G' := hG.inter (hmℋ _ hGood)
  have hG'L' : G' ⊆ L' := fun ω hω => ⟨⟨hGL hω.1, hGζ ω hω.1⟩, hω.2⟩
  have hYt' : ∀ᵐ ω ∂P, ω ∈ G' →
      IsChartTransport (Mo.hullChart (fillH (K₂ ω)) 0) 1 0 (chiC κ) (h ω) (stepField κ x₀ e Y ω) := by
    filter_upwards [hYt₂] with ω hω hωG
    exact hω hωG.1 hωG.2
  have hGA' : ∀ᵐ ω ∂P, ω ∈ G' → A ω = fillH (K₂ ω) := by
    filter_upwards [hGA] with ω hω hωG
    exact hω hωG.1
  have hmain := ae_isGFF_of_coarse_of_marked_on hh hu₀ hmℋ hℋ hK₂m hK₂c hK₂p hYm₂ hYt'
    (measurable_stepWord κ θ (hx₀.mono hPm le_rfl) (hβ.mono hPm le_rfl) hrm) (isSorted_stepWord κ θ x₀ β e) hL'
    hlaw₂ hAm hAc hAloc hAl hG' hG'L' hGA'
  filter_upwards [hmain, hgood] with ω hω hgω hωG
  exact hω ⟨hωG, hgω (hGL hωG) (hGζ ω hωG)⟩

end InteractingSLE.Theorem14.SB.Qw
