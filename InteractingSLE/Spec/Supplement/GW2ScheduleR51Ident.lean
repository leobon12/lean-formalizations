import InteractingSLE.Spec.Supplement.GW2ScheduleR51

/-!
# Identification of a staged history with the canonical construction under ruling R51

Packet PROVE-T14-TIP6 (`planning/handoffs/PROVE-T14-TIP3.md` §5.1). Proof of Proposition 1.1 of the shortcut note
(ruling
R52, `source/external/AstraIG1/ig1_shortcuts_audited.txt` §1.2, "Choosing the switches": "By field determination and
canonical consistency it is a member of the originally fixed countable family"; Lemma GB9, p. 526: "its field-determined
physical prefix is that same member of the fixed family"), for the staged families of the version-2 Theorem 1.4 anchors:
measurable staged histories (`IsStagedHistory`) whose launched pieces are almost surely continuous curves
(`StagedPiecesRegular`, ruling R51), with no regularity at the remaining samples.

PROVE-T14-TIP3 proved the identification (`GW2Schedule.ae_agree_canon`) for families regular at every sample; its proof
used that regularity to compute the conditional law of the field given the retained past of `E` itself. Here that law is
obtained from the canonical family `C` (regular at every sample, `GW2ScheduleLaw`) instead, by induction over the
instructions:

* pathwise (`GW2ScheduleR51.lean`): if the pieces agree at rational times wherever the canonical prefix succeeds, then
  the
  two histories have the same success events and the same runs (`allSucc_iff_of_agreeRat`, `run_eq_of_agreeRat`), using
  only the continuity of the launched pieces on `[0, min t ζ]`;
* the conditional law (`ae_isGFF_wField_canon`): the retained pasts of `E` and `C` agree almost surely, so on the event
  of a launch, conditioning on the past of `E` or on both pasts gives the same conditional characteristic functionals
  (`Restart.ae_condExp_eq_of_trace` for the σ-algebra generated by both pasts), which are those of the canonical word;
* determination (`ae_agreeRat_step`): under the conditional law given the past of `E` at a launch, the piece is a flow
  line of the canonical field in its chart, so Theorem 1.2 (through `Staged.ae_detCode_eq`) makes it the canonical
  piece,
  almost surely; the agreement at rational times is a measurable event and passes to `P`
  (`GW2Schedule.ae_of_ae_condExpKernel_on`).

Main results: `ae_agreeRat_canon_R51`, `ae_identify_canon_R51` (same success events, same stopped pieces, same runs),
`ae_physSet_eq_canon_R51` (the physical set of the history is the canonical one).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

namespace Theorem14

namespace GW2Schedule

open Exist Staged StagedLaw Restart LQGMetric

/-! ### Pathwise consequences of rational agreement -/

section Path

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {spec : ExplSpec} {θ : ℕ → ℝ} {Δ : ℕ → ℝ≥0∞}

/-- Rational agreement (with equal lifetimes) of the pieces launched after a successful prefix of `D'` gives the same
success events. -/
theorem allSucc_iff_of_agreeRat {D D' : ℕ → (ℝ≥0 → ℝ) × ℝ≥0∞} :
    ∀ {k : ℕ}, (∀ i < k, AllSucc Δ D' i → AgreeRat (D i) (D' i)) → (AllSucc Δ D k ↔ AllSucc Δ D' k)
  | 0, _ => iff_of_true (allSucc_zero Δ _) (allSucc_zero Δ _)
  | k + 1, hI => by
    have ihk := allSucc_iff_of_agreeRat (D := D) (D' := D') (k := k) fun i hi => hI i (Nat.lt_succ_of_lt hi)
    rw [allSucc_succ, allSucc_succ]
    constructor
    · rintro ⟨hE', hlt⟩
      have hC' := ihk.1 hE'
      exact ⟨hC', by rw [← (hI k (Nat.lt_succ_self k) hC').1]; exact hlt⟩
    · rintro ⟨hC', hlt⟩
      exact ⟨ihk.2 hC', by rw [(hI k (Nat.lt_succ_self k) hC').1]; exact hlt⟩

/-- **The runs agree**: if the pieces of `D` launched after a successful prefix are continuous on `[0, min Δ ζ]` and
start
at `0`, and agree at rational times with those of a family `D'` regular at every sample, then the runs agree. -/
theorem run_eq_of_agreeRat (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ) (hΔ : ∀ j, Δ j ≠ ⊤)
    {D D' : ℕ → (ℝ≥0 → ℝ) × ℝ≥0∞} {k : ℕ} (hk : k ≤ spec.2.2.length)
    (hI : ∀ i < k, AllSucc Δ D' i → AgreeRat (D i) (D' i))
    (hR : ∀ i < k, AllSucc Δ D i → (D i).1 0 = 0 ∧ ContinuousOn (D i).1 {s : ℝ≥0 | (s : ℝ≥0∞) ≤ min (Δ i) (D i).2})
    (hreg' : ∀ i, IsRegularDriver (D' i)) :
    ExplState.run κ b jumps spec D k = ExplState.run κ b jumps spec D' k :=
  run_gw2_eq_of_canonDrv hgw hprog hΔ k hk fun j hj hs => by
    have hs' := (allSucc_iff_of_agreeRat (D := D) (D' := D') fun i hi => hI i (lt_trans hi hj)).1 hs
    exact canonDrv_eq_of_agreeRat (hI j hj hs') (hR j hj hs).1 (hR j hj hs).2 (hreg' j)

/-- Equal runs give equal retained pasts. -/
theorem pastMap_eq_of_run_eq {Ω Ω' : Type*} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} {E' : ℕ → Ω' → (ℝ≥0 → ℝ) × ℝ≥0∞}
    {k : ℕ} {ω : Ω} {ω' : Ω'}
    (h : ExplState.run κ b jumps spec (fun j => E j ω) k = ExplState.run κ b jumps spec (fun j => E' j ω') k) :
    pastMap κ b jumps spec E k ω = pastMap κ b jumps spec E' k ω' := by
  funext i
  simp only [pastMap]
  rw [h]

end Path

/-! ### The regularity of the launched pieces -/

section Reg

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {spec : ExplSpec} {θ : ℕ → ℝ} {Δ : ℕ → ℝ≥0∞} {Ω : Type u}
  [MeasurableSpace Ω] {P : Measure Ω} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- **R51 for a GW2 schedule**: almost surely, every piece launched after a successful prefix starts at `0` and is
continuous on `[0, min Δ ζ]`. -/
theorem ae_piece_regular (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ) (hΔ : ∀ j, Δ j ≠ ⊤)
    (hR : StagedPiecesRegular κ b jumps P spec E) :
    ∀ᵐ ω ∂P, ∀ i < spec.2.2.length, AllSucc Δ (fun j => E j ω) i →
      (E i ω).1 0 = 0 ∧ ContinuousOn (E i ω).1 {s : ℝ≥0 | (s : ℝ≥0∞) ≤ min (Δ i) (E i ω).2} := by
  filter_upwards [hR] with ω hω i hi hs
  obtain ⟨h0, hc, -⟩ := hω i (θ i) (Δ i) _ (hprog i hi)
    ((launches_run_gw2 (κ := κ) (b := b) (jumps := jumps) hgw hprog hΔ (fun j => E j ω) hi).1 hs)
  exact ⟨h0, hc⟩

end Reg

/-! ### The conditional law given the retained past of `E` -/

section Law

variable {κ : ℝ} (hκ : 0 < κ) (h12p : Theorem12ParamStatement.{u}) (θ : ℕ → ℝ) (Δ : ℕ → ℝ≥0∞)
  (βA : BoundaryWord × ℝ × RecData → BoundaryWord) (c₀ : BoundaryWord) {b : ℝ → ℝ} {jumps : Finset ℝ}
  {spec : ExplSpec} {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- The retained past of a staged history is a measurable map. -/
theorem measurable_pastMap_of_isStagedHistory (hE : IsStagedHistory κ b jumps P h spec E) (k : ℕ) :
    Measurable (pastMap κ b jumps spec E k) :=
  Measurable.of_comap_le (by rw [← pastSigma_eq_comap]; exact hE.2.1 k)

/-- The σ-algebra generated by the retained pasts of two families. -/
@[instance_reducible]
def pastSigma₂ (κ : ℝ) (b : ℝ → ℝ) (jumps : Finset ℝ) (spec : ExplSpec) {Ω' : Type*}
    (E E' : ℕ → Ω' → (ℝ≥0 → ℝ) × ℝ≥0∞) (k : ℕ) : MeasurableSpace Ω' :=
  MeasurableSpace.comap (fun ω => (pastMap κ b jumps spec E k ω, pastMap κ b jumps spec E' k ω)) inferInstance

/-- **The field of the canonical chart is, given the retained past of `E`, the GFF of the word read off that past**, at
every launch, provided the retained pasts of `E` and of the canonical family `C` agree almost surely and their success
events agree almost surely. The canonical conditional characteristic functionals given the past of `C` are those of the
canonical word; on the success event the larger σ-algebra generated by both pasts adds nothing
(`Restart.ae_condExp_eq_of_trace`), and the tower property passes to the past of `E`. -/
theorem ae_isGFF_wField_canon (h13 : Theorem13Statement.{u}) (hβA : IsStopLaw.{u} κ βA)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hc₀J : c₀.jumps = jumps) (hc₀ : ∀ y ∉ jumps, c₀.fn y = b y)
    (hh : IsGFFWithBoundaryData P h b jumps) (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ)
    (hΔ : ∀ j, Δ j ≠ ⊤) (hE : IsStagedHistory κ b jumps P h spec E) {k : ℕ} (hk : k < spec.2.2.length)
    (hgood : ∀ᵐ ω ∂P, (AllSucc Δ (fun j => E j ω) k ↔
        AllSucc Δ (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) k) ∧
      pastMap κ b jumps spec E k ω = pastMap κ b jumps spec (canonFam hκ h12p βA c₀ θ Δ spec.1 h) k ω) :
    ∀ᵐ ω₀ ∂P, AllSucc Δ (fun j => E j ω₀) k →
      IsGFFWithBoundaryData (condExpKernel P (pastSigma κ b jumps spec E k) ω₀)
        (wField κ b jumps spec h (canonFam hκ h12p βA c₀ θ Δ spec.1 h) k)
        (wWord θ βA c₀ κ b jumps spec E k ω₀).fn (wWord θ βA c₀ κ b jumps spec E k ω₀).jumps := by
  classical
  set C := canonFam hκ h12p βA c₀ θ Δ spec.1 h with hCdef
  have hC : IsStagedHistory κ b jumps P h spec C :=
    isStagedHistory_canonFam hκ h12p βA c₀ θ Δ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ
  have hCm : ∀ j, Measurable (C j) := hC.1
  have hCreg : ∀ j ω, IsRegularDriver (C j ω) := fun j ω =>
    isRegularDriver_canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω
  have hWC := stageWitness_all θ Δ βA c₀ hβA hκ hb hc₀J hc₀ hh hgw hprog hΔ hCm hCreg hC.2.2.2 k
  have hlaunchC : ∀ ω, AllSucc Δ (fun j => C j ω) k →
      (ExplState.run κ b jumps spec (fun j => C j ω) (k + 1)).2.2.2.1 k ≠ none := fun ω hs =>
    (launch_ne_none_iff (κ := κ) (b := b) (jumps := jumps) θ Δ hgw hprog hΔ (fun j => C j ω) hk).2 hs
  rcases Nat.eq_zero_or_pos k with rfl | hkpos
  · -- instruction `0`: both pasts are trivial and the words are the root word
    have e1 : pastSigma κ b jumps spec E 0 = pastSigma κ b jumps spec C 0 := by
      rw [pastSigma_zero, pastSigma_zero]
    filter_upwards [hWC.2.2.2] with ω₀ h0 _
    rw [e1]
    exact h0 (hlaunchC ω₀ (allSucc_zero Δ _))
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  have hsort : ∀ (F : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) ω, (wWord θ βA c₀ κ b jumps spec F (j + 1) ω).IsSorted :=
    fun F ω => by rw [wWord_succ]; exact hβA.2.1 _
  have hpm := measurable_pastMap_of_isStagedHistory hE (j + 1)
  have hpmC := measurable_pastMap_of_isStagedHistory hC (j + 1)
  have hprm : Measurable fun ω => (pastMap κ b jumps spec E (j + 1) ω, pastMap κ b jumps spec C (j + 1) ω) :=
    hpm.prodMk hpmC
  have h𝒦' : pastSigma₂ κ b jumps spec E C (j + 1) ≤ mΩ := hprm.comap_le
  have hG𝒦' : pastSigma κ b jumps spec E (j + 1) ≤ pastSigma₂ κ b jumps spec E C (j + 1) := by
    rw [pastSigma_eq_comap]
    have hm : Measurable[pastSigma₂ κ b jumps spec E C (j + 1)] (pastMap κ b jumps spec E (j + 1)) :=
      measurable_fst.comp (comap_measurable
        (fun ω => (pastMap κ b jumps spec E (j + 1) ω, pastMap κ b jumps spec C (j + 1) ω)))
    exact hm.comap_le
  have h𝒦𝒦' : pastSigma κ b jumps spec C (j + 1) ≤ pastSigma₂ κ b jumps spec E C (j + 1) := by
    rw [pastSigma_eq_comap]
    have hm : Measurable[pastSigma₂ κ b jumps spec E C (j + 1)] (pastMap κ b jumps spec C (j + 1)) :=
      measurable_snd.comp (comap_measurable
        (fun ω => (pastMap κ b jumps spec E (j + 1) ω, pastMap κ b jumps spec C (j + 1) ω)))
    exact hm.comap_le
  have h𝒢 : pastSigma κ b jumps spec E (j + 1) ≤ mΩ := hE.2.1 (j + 1)
  have hA : MeasurableSet[pastSigma κ b jumps spec E (j + 1)] {ω | AllSucc Δ (fun i => E i ω) (j + 1)} :=
    measurableSet_allSucc (κ := κ) (b := b) (jumps := jumps) hgw hprog hΔ E hk.le
  have hAC : MeasurableSet[pastSigma κ b jumps spec C (j + 1)] {ω | AllSucc Δ (fun i => C i ω) (j + 1)} :=
    measurableSet_allSucc (κ := κ) (b := b) (jumps := jumps) hgw hprog hΔ C hk.le
  have hYm : Measurable (wField κ b jumps spec h C (j + 1)) := measurable_wField hb hh.1 hCm hCreg (j + 1)
  have hβm : Measurable[pastSigma κ b jumps spec E (j + 1)] (wWord θ βA c₀ κ b jumps spec E (j + 1)) := by
    rw [pastSigma_eq_comap]
    exact (measurable_pastWord βA c₀ spec.1 θ hβA.1 (j + 1)).comp (comap_measurable _)
  have hCF : ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ω ∈ {ω | AllSucc Δ (fun i => E i ω) (j + 1)} →
      P[fun ω' => Complex.exp (Complex.I * (wField κ b jumps spec h C (j + 1) ω' φ : ℂ)) |
        pastSigma κ b jumps spec E (j + 1)] ω = gaussCF (wWord θ βA c₀ κ b jumps spec E (j + 1) ω) φ := by
    intro φ
    have hXi : Integrable (fun ω' => Complex.exp (Complex.I * (wField κ b jumps spec h C (j + 1) ω' φ : ℂ))) P :=
      GFF.integrable_exp_I_mul ((measurable_distOn_apply φ).comp hYm)
    -- the canonical conditional characteristic functional
    have hCFc : ∀ᵐ ω ∂P, AllSucc Δ (fun i => C i ω) (j + 1) →
        P[fun ω' => Complex.exp (Complex.I * (wField κ b jumps spec h C (j + 1) ω' φ : ℂ)) |
          pastSigma κ b jumps spec C (j + 1)] ω = gaussCF (wWord θ βA c₀ κ b jumps spec C (j + 1) ω) φ := by
      filter_upwards [hWC.2.2.2, condExp_ae_eq_integral_condExpKernel (hC.2.1 (j + 1)) hXi] with ω h1 h2 hs
      rw [h2]
      exact integral_cexp_eq_gaussCF (hsort C ω) (h1 (hlaunchC ω hs)) φ
    -- on the success event, both pasts carry the information of the canonical one
    have htr : ∀ B, MeasurableSet[pastSigma₂ κ b jumps spec E C (j + 1)] B →
        MeasurableSet[LocalSets.aeSigma (pastSigma κ b jumps spec C (j + 1)) P]
          (B ∩ {ω | AllSucc Δ (fun i => E i ω) (j + 1)}) := by
      intro B hB
      obtain ⟨S, hS, rfl⟩ := hB
      refine ⟨(fun ω => (pastMap κ b jumps spec C (j + 1) ω, pastMap κ b jumps spec C (j + 1) ω)) ⁻¹' S ∩
        {ω | AllSucc Δ (fun i => C i ω) (j + 1)}, ?_, ?_⟩
      · refine MeasurableSet.inter ?_ hAC
        rw [pastSigma_eq_comap]
        exact ⟨(fun u => (u, u)) ⁻¹' S, (measurable_id.prodMk measurable_id) hS, rfl⟩
      · filter_upwards [hgood] with ω hω
        simp only [mem_inter_iff, mem_preimage, mem_ofPred_eq, hω.2, hω.1]
    have htrace := ae_condExp_eq_of_trace h𝒦𝒦' h𝒦' htr hXi
    have hcomb : ∀ᵐ ω ∂P, ω ∈ {ω | AllSucc Δ (fun i => E i ω) (j + 1)} →
        P[fun ω' => Complex.exp (Complex.I * (wField κ b jumps spec h C (j + 1) ω' φ : ℂ)) |
          pastSigma₂ κ b jumps spec E C (j + 1)] ω = gaussCF (wWord θ βA c₀ κ b jumps spec E (j + 1) ω) φ := by
      filter_upwards [htrace, hCFc, hgood] with ω h1 h2 hω hAω
      rw [h1 hAω, h2 (hω.1.1 hAω)]
      simp only [wWord, hω.2]
    exact ae_condExp_eq_on_of_le hG𝒦' h𝒦' hXi ((measurable_gaussCF φ).comp hβm).stronglyMeasurable
      (fun ω => norm_gaussCF_le _ φ) hA hcomb
  filter_upwards [ae_isGFFWithBoundaryData_condExpKernel h𝒢 (M := {ω | AllSucc Δ (fun i => E i ω) (j + 1)})
    (β := wWord θ βA c₀ κ b jumps spec E (j + 1)) (Eventually.of_forall fun ω _ => hsort E ω) hYm hCF]
    with ω₀ hω₀ hs
  exact hω₀ hs

/-- **Determination step under R51.** If, almost surely, the pieces of `E` before instruction `k` agree at rational
times
with the canonical ones wherever the canonical prefix succeeds, then so does the `k`-th piece. -/
theorem ae_agreeRat_step (h13 : Theorem13Statement.{u}) (hβA : IsStopLaw.{u} κ βA)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hc₀J : c₀.jumps = jumps) (hc₀ : ∀ y ∉ jumps, c₀.fn y = b y)
    (hh : IsGFFWithBoundaryData P h b jumps) (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ)
    (hΔ : ∀ j, Δ j ≠ ⊤) (hE : IsStagedHistory κ b jumps P h spec E) (hR : StagedPiecesRegular κ b jumps P spec E)
    {k : ℕ} (hk : k < spec.2.2.length)
    (hI : ∀ᵐ ω ∂P, ∀ i < k, AllSucc Δ (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) i →
      AgreeRat (E i ω) (canonFam hκ h12p βA c₀ θ Δ spec.1 h i ω)) :
    ∀ᵐ ω ∂P, AllSucc Δ (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) k →
      AgreeRat (E k ω) (canonFam hκ h12p βA c₀ θ Δ spec.1 h k ω) := by
  classical
  set C := canonFam hκ h12p βA c₀ θ Δ spec.1 h with hCdef
  have hC : IsStagedHistory κ b jumps P h spec C :=
    isStagedHistory_canonFam hκ h12p βA c₀ θ Δ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ
  have hCm : ∀ j, Measurable (C j) := hC.1
  have hCreg : ∀ j ω, IsRegularDriver (C j ω) := fun j ω =>
    isRegularDriver_canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω
  have hWC := stageWitness_all θ Δ βA c₀ hβA hκ hb hc₀J hc₀ hh hgw hprog hΔ hCm hCreg hC.2.2.2 k
  have hEm : ∀ j, Measurable (E j) := hE.1
  -- pathwise: the same success events and the same runs, hence the same retained pasts
  have hgood : ∀ᵐ ω ∂P, (AllSucc Δ (fun j => E j ω) k ↔ AllSucc Δ (fun j => C j ω) k) ∧
      ExplState.run κ b jumps spec (fun j => E j ω) k = ExplState.run κ b jumps spec (fun j => C j ω) k := by
    filter_upwards [hI, ae_piece_regular (θ := θ) hgw hprog hΔ hR] with ω hIω hRω
    exact ⟨allSucc_iff_of_agreeRat hIω,
      run_eq_of_agreeRat hgw hprog hΔ hk.le hIω (fun i hi => hRω i (lt_trans hi hk)) fun i => hCreg i ω⟩
  have hgood' : ∀ᵐ ω ∂P, (AllSucc Δ (fun j => E j ω) k ↔ AllSucc Δ (fun j => C j ω) k) ∧
      pastMap κ b jumps spec E k ω = pastMap κ b jumps spec C k ω := by
    filter_upwards [hgood] with ω hω
    exact ⟨hω.1, pastMap_eq_of_run_eq hω.2⟩
  have hgffE := ae_isGFF_wField_canon hκ h12p θ Δ βA c₀ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ hE hk hgood'
  -- the target driver: the field-determined driver of the word read off the past of `E` and the canonical field
  have hpm := measurable_pastMap_of_isStagedHistory hE k
  have h𝒢 : pastSigma κ b jumps spec E k ≤ mΩ := hE.2.1 k
  have hWEm : Measurable (wWord θ βA c₀ κ b jumps spec E k) :=
    (measurable_pastWord βA c₀ spec.1 θ hβA.1 k).comp hpm
  have hYCm : Measurable (wField κ b jumps spec h C k) := measurable_wField hb hh.1 hCm hCreg k
  have hDm : Measurable fun ω => wordDrv hκ h12p (θ k) (wWord θ βA c₀ κ b jumps spec E k ω)
      (wField κ b jumps spec h C k ω) :=
    measurable_comp_pair (F := fun c f => wordDrv hκ h12p (θ k) c f) (measurable_wordDrv hκ h12p (θ k)) hWEm hYCm
  have hL := measurableSet_allSucc (κ := κ) (b := b) (jumps := jumps) hgw hprog hΔ E hk.le
  have hA := measurableSet_agreeRat (hEm k) hDm
  have : StandardBorelSpace (PastData k) := inferInstance
  have : MeasurableSpace.CountablySeparated (PastData k) := inferInstance
  have hatom0 := ae_ae_eq_of_comap (P := P) hpm
  rw [← pastSigma_eq_comap] at hatom0
  have hmain := ae_of_ae_condExpKernel_on (P := P) h𝒢 hL hA (by
    filter_upwards [hE.2.2.2 k, hgffE, Sec7.Aux122Disint.ae_ae_condExpKernel_mem (P := P) h𝒢 hL, hatom0,
      Sec7.Aux122Disint.ae_ae_condExpKernel (P := P) h𝒢 (hgood.and hWC.2.2.1), hgood, hWC.2.2.1]
      with ω₀ hok₀ hgff₀ hmem hatom hgoodK hgood₀ hpathC₀ hs₀
    have hs₀' : AllSucc Δ (fun j => E j ω₀) k := hs₀
    have hsC₀ : AllSucc Δ (fun j => C j ω₀) k := hgood₀.1.1 hs₀'
    have hl' := (launches_run_gw2 (κ := κ) (b := b) (jumps := jumps) hgw hprog hΔ (fun j => E j ω₀) hk).1 hs₀'
    obtain ⟨b', J', h', hb', hT', hfl⟩ := hok₀ _ _ hl'
    -- the chart of the launch is the canonical chart at `ω₀`
    have hc : succChart spec.1 Δ (fun j => E j ω₀) k =
        (ExplState.run κ b jumps spec (fun j => C j ω₀) k).2.2.2.2.1 := by
      rw [← chart_run_eq θ Δ hgw hprog hΔ (fun j => E j ω₀) hk.le hs₀', hgood₀.2]
    rw [hc] at hT'
    obtain ⟨hconf, hlift, -⟩ := hpathC₀ ((launch_ne_none_iff (κ := κ) (b := b) (jumps := jumps) θ Δ hgw hprog hΔ
      (fun j => C j ω₀) hk).2 hsC₀)
    set ν := condExpKernel P (pastSigma κ b jumps spec E k) ω₀ with hν
    have hmem' := hmem hs₀'
    have hh'eq : h' = fun ω => Chart.chartTransport hconf 1 0 (QuantumZipper.chiC κ) (h ω) := funext fun ω =>
      (hT' ω).eq_chartTransport hconf (Chart.locallyIntegrableOn_of_continuousOn hlift)
    have hh'm : Measurable h' := by rw [hh'eq]; exact (Chart.measurable_chartTransport hconf 1 0 _).comp hh.1
    have hpE₀ : pastMap κ b jumps spec E k ω₀ = pastMap κ b jumps spec C k ω₀ := pastMap_eq_of_run_eq hgood₀.2
    have hYh' : ∀ᵐ ω ∂ν, wField κ b jumps spec h C k ω = h' ω := by
      filter_upwards [hmem', hatom, hgoodK] with ω hω hpω ⟨hgω, hpathω⟩
      have hsCω : AllSucc Δ (fun j => C j ω) k := hgω.1.1 hω
      have hpC : pastMap κ b jumps spec C k ω = pastMap κ b jumps spec C k ω₀ := by
        rw [← pastMap_eq_of_run_eq hgω.2, hpω, hpE₀]
      have hrun : ExplState.run κ b jumps spec (fun j => C j ω) k =
          ExplState.run κ b jumps spec (fun j => C j ω₀) k :=
        run_eq_of_readRec_eq spec (fun j _ => hCreg j ω) (fun j _ => hCreg j ω₀) fun i hi => congrFun hpC ⟨i, hi⟩
      obtain ⟨-, -, hTω⟩ := hpathω ((launch_ne_none_iff (κ := κ) (b := b) (jumps := jumps) θ Δ hgw hprog hΔ
        (fun j => C j ω) hk).2 hsCω)
      rw [hrun] at hTω
      exact hTω.unique hconf (hT' ω)
    have hgff' := isGFFWithBoundaryData_congr_ae (hgff₀ hs₀') hh'm hYh'
    set w := wWord θ βA c₀ κ b jumps spec E k ω₀ with hw
    obtain ⟨h'', 𝓕, VL, VR, B, htr, hC'⟩ := isFlowLineDriver_word hκ hgff' hb' hfl
    have hh'' : h'' = fun ω => flowField 0 (θ k * QuantumZipper.chiC κ) (h' ω) := by
      funext ω
      ext φ
      have e1 := htr ω φ φ (fun z => by rw [Complex.ofReal_zero, add_zero])
      have e2 := isTranslateAddConst_flowField 0 (θ k * QuantumZipper.chiC κ) (h' ω) φ φ
        (fun z => by rw [Complex.ofReal_zero, add_zero])
      rw [e1, e2]
    have hF := Theorem15.isOrderedForceWord_flowLine w.fn w.jumps 0
    have hΦ := (h12p κ hκ (flowLineNL w.fn w.jumps 0) (flowLineNR w.fn w.jumps 0)).choose_spec.2 _ _ _ _ hF hC'
    have hdet := ae_detCode_eq hκ hF h13 hC' hΦ
    filter_upwards [hdet, hatom, hYh'] with ω ⟨x₀, hx₀, hζx, hwx, hcode⟩ hpω hYω
    have hww : wWord θ βA c₀ κ b jumps spec E k ω = w := by
      simp only [hw, wWord, hpω]
    have hΨ : wordDrv hκ h12p (θ k) (wWord θ βA c₀ κ b jumps spec E k ω) (wField κ b jumps spec h C k ω) =
        drvOf (dOf x₀) := by
      rw [← hcode, hh'', hww, hYω, wordDrv_eq]
      rfl
    change AgreeRat (E k ω) (wordDrv hκ h12p (θ k) (wWord θ βA c₀ κ b jumps spec E k ω)
      (wField κ b jumps spec h C k ω))
    rw [hΨ, drvOf_of_mem (dOf_mem_DSet hx₀)]
    refine ⟨hζx.symm, fun q hq => ?_⟩
    have hq' : ((((q : ℝ).toNNReal : ℝ≥0)) : ℝ≥0∞) < (dOf x₀).1 := by
      change _ < Sec2.Assembly.cζ x₀; rw [hζx]; exact hq
    change (E k ω).1 (q : ℝ).toNNReal = drvPath (dOf x₀) (q : ℝ).toNNReal
    rw [drvPath_of_lt hq']
    exact ((hwx _ hq).1).symm)
  filter_upwards [hmain, hgood'] with ω hω hg hsC
  have h1 := hω (hg.1.2 hsC)
  have hDC : wordDrv hκ h12p (θ k) (wWord θ βA c₀ κ b jumps spec E k ω) (wField κ b jumps spec h C k ω) =
      C k ω := by
    rw [hCdef, canonFam_eq_witDrv hκ h12p θ Δ βA c₀ hgw hprog hΔ hk.le hsC]
    change wordDrv hκ h12p (θ k) (pastWord βA c₀ spec.1 θ k (pastMap κ b jumps spec E k ω))
        (fieldChain κ spec.1 k (pastMap κ b jumps spec C k ω) (h ω)) =
      wordDrv hκ h12p (θ k) (pastWord βA c₀ spec.1 θ k (pastMap κ b jumps spec C k ω))
        (fieldChain κ spec.1 k (pastMap κ b jumps spec C k ω) (h ω))
    rw [hg.2]
  rw [← hDC]
  exact h1

/-- **Identification under R51, rational form**: almost surely, every piece of `E` launched after a successful canonical
prefix agrees with the canonical piece at rational times, with the same lifetime. -/
theorem ae_agreeRat_canon_R51 (h13 : Theorem13Statement.{u}) (hβA : IsStopLaw.{u} κ βA)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hc₀J : c₀.jumps = jumps) (hc₀ : ∀ y ∉ jumps, c₀.fn y = b y)
    (hh : IsGFFWithBoundaryData P h b jumps) (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ)
    (hΔ : ∀ j, Δ j ≠ ⊤) (hE : IsStagedHistory κ b jumps P h spec E) (hR : StagedPiecesRegular κ b jumps P spec E) :
    ∀ k ≤ spec.2.2.length, ∀ᵐ ω ∂P, ∀ i < k, AllSucc Δ (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) i →
      AgreeRat (E i ω) (canonFam hκ h12p βA c₀ θ Δ spec.1 h i ω)
  | 0, _ => Eventually.of_forall fun _ i hi => absurd hi (Nat.not_lt_zero _)
  | k + 1, hk1 => by
    have ih := ae_agreeRat_canon_R51 h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ hE hR k (Nat.le_of_succ_le hk1)
    filter_upwards [ih, ae_agreeRat_step hκ h12p θ Δ βA c₀ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ hE hR hk1 ih]
      with ω h1 h2 i hi hs
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
    · exact h1 i hi hs
    · exact h2 hs

/-- **Identification of a staged history with the canonical construction under R51** (GB9, p. 526: "its
field-determined physical prefix is that same member of the fixed family"; shortcut note §1.2). For a GW2 schedule and
a staged history `E` whose launched pieces are almost surely continuous curves (`StagedPiecesRegular`), almost surely:
`E` and the canonical family have the same success events and the same runs before every instruction, and every launched
piece of `E` has the canonical lifetime and the canonical stopped driver. -/
theorem ae_identify_canon_R51 (h13 : Theorem13Statement.{u}) (hβA : IsStopLaw.{u} κ βA)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hc₀J : c₀.jumps = jumps) (hc₀ : ∀ y ∉ jumps, c₀.fn y = b y)
    (hh : IsGFFWithBoundaryData P h b jumps) (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ)
    (hΔ : ∀ j, Δ j ≠ ⊤) (hE : IsStagedHistory κ b jumps P h spec E) (hR : StagedPiecesRegular κ b jumps P spec E) :
    ∀ᵐ ω ∂P, (∀ k ≤ spec.2.2.length,
        (AllSucc Δ (fun j => E j ω) k ↔ AllSucc Δ (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) k) ∧
        ExplState.run κ b jumps spec (fun j => E j ω) k =
          ExplState.run κ b jumps spec (fun j => canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω) k) ∧
      ∀ k < spec.2.2.length, AllSucc Δ (fun j => E j ω) k →
        (E k ω).2 = (canonFam hκ h12p βA c₀ θ Δ spec.1 h k ω).2 ∧
        canonDrv (Δ k) (E k ω) = canonDrv (Δ k) (canonFam hκ h12p βA c₀ θ Δ spec.1 h k ω) := by
  set C := canonFam hκ h12p βA c₀ θ Δ spec.1 h with hCdef
  have hCreg : ∀ j ω, IsRegularDriver (C j ω) := fun j ω =>
    isRegularDriver_canonFam hκ h12p βA c₀ θ Δ spec.1 h j ω
  filter_upwards [ae_agreeRat_canon_R51 hκ h12p θ Δ βA c₀ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ hE hR
    spec.2.2.length le_rfl, ae_piece_regular (θ := θ) hgw hprog hΔ hR] with ω hI hRω
  refine ⟨fun k hk => ⟨allSucc_iff_of_agreeRat fun i hi => hI i (lt_of_lt_of_le hi hk),
    run_eq_of_agreeRat hgw hprog hΔ hk (fun i hi => hI i (lt_of_lt_of_le hi hk))
      (fun i hi => hRω i (lt_of_lt_of_le hi hk)) fun i => hCreg i ω⟩, fun k hk hs => ?_⟩
  have hsC := (allSucc_iff_of_agreeRat (D := fun j => E j ω) (D' := fun j => C j ω)
    fun i hi => hI i (lt_trans hi hk)).1 hs
  have hag := hI k hk hsC
  exact ⟨hag.1, canonDrv_eq_of_agreeRat hag (hRω k hk hs).1 (hRω k hk hs).2 (hCreg k ω)⟩

/-- **The physical set of a staged history is the canonical one** (R51): for a GW2 schedule, almost surely the
physical set of `E` equals that of the canonical family, a jointly measurable function of the field. -/
theorem ae_physSet_eq_canon_R51 (h13 : Theorem13Statement.{u}) (hβA : IsStopLaw.{u} κ βA)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hc₀J : c₀.jumps = jumps) (hc₀ : ∀ y ∉ jumps, c₀.fn y = b y)
    (hh : IsGFFWithBoundaryData P h b jumps) (hgw : spec.2.1 = true) (hprog : IsFlowProg spec.2.2 θ Δ)
    (hΔ : ∀ j, Δ j ≠ ⊤) (hE : IsStagedHistory κ b jumps P h spec E) (hR : StagedPiecesRegular κ b jumps P spec E) :
    ∀ᵐ ω ∂P, ExplState.physSet κ b jumps spec (fun k => E k ω) =
      ExplState.physSet κ b jumps spec (fun k => canonFam hκ h12p βA c₀ θ Δ spec.1 h k ω) := by
  filter_upwards [ae_identify_canon_R51 hκ h12p θ Δ βA c₀ h13 hβA hb hc₀J hc₀ hh hgw hprog hΔ hE hR] with ω hω
  simp only [ExplState.physSet, (hω.1 _ le_rfl).2]

