import InteractingSLE.Spec.Supplement.KernelTower2
import InteractingSLE.Spec.Sec7.Aux122Disint

/-!
# The tower identity for nested conditional kernels

Packet PROVE-T14-SB2LIFT (round 3; shared with PROVE-T14-SB2DRV). SB2(2)'s conditional half asks for flow-line
couplings under the **nested** kernel `condExpKernel (condExpKernel P 𝒢 ω₀) ℋ ω₁` (first the upper past `𝒢`, then,
in that conditional world, the relative lower past `ℋ`), while K2 produces them under a single kernel
`condExpKernel P 𝒢' ω₁`. For `𝒢 = comap f` generated by a map into a standard Borel space:

* **`ae_ae_condExpKernel_condExpKernel_comap_sup`**: for `P`-almost every `ω₀`, almost surely under
  `ν = condExpKernel P (comap f) ω₀`, `condExpKernel ν ℋ = condExpKernel P (comap f ⊔ ℋ)` (when `comap f ⊔ ℋ` is
  countably generated). Proof: `KernelTower.ae_ae_condExpKernel_condExpKernel_eq` (kernel of a kernel for
  `comap f ≤ comap f ⊔ ℋ`); under `ν` the map `f` is almost surely the constant `f ω₀`
  (`Sec7.Aux122Disint.ae_ae_condExpKernel_eq`), so the `comap f`-events are `ν`-trivial and `ℋ`, `comap f ⊔ ℋ` agree up
  to `ν`-null sets (`KernelTower.ae_condExpKernel_eq_of_le_aeSigma`);
* `ae_ae_condExpKernel_condExpKernel_comap_comap`: the form for `ℋ = comap g` (both maps into standard Borel spaces);
* **`ae_ae_nested_of_ae_sup`**: a property that holds `P`-almost surely of the kernel given `comap f ⊔ ℋ` holds, for
  `P`-almost every `ω₀`, `ν`-almost surely of the nested kernel.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter

namespace InteractingSLE.Theorem14.SB.Lk

variable {Ω : Type*} {ℋ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P]

omit [StandardBorelSpace Ω] [IsProbabilityMeasure P] in
/-- The σ-algebra of a map that is almost surely constant is trivial up to null sets: it is contained, up to null
sets, in any σ-algebra. -/
theorem comap_le_aeSigma_of_ae_eq_const {X : Type*} [MeasurableSpace X] {f : Ω → X} {ν : Measure Ω} {x₀ : X}
    (hc : ∀ᵐ ω ∂ν, f ω = x₀) :
    MeasurableSpace.comap f inferInstance ≤ LocalSets.aeSigma ℋ ν := by
  rintro _ ⟨B, -, rfl⟩
  by_cases hx : x₀ ∈ B
  · refine ⟨univ, @MeasurableSet.univ Ω ℋ, ?_⟩
    filter_upwards [hc] with ω hω
    simp only [mem_preimage, hω, hx, mem_univ]
  · refine ⟨∅, @MeasurableSet.empty Ω ℋ, ?_⟩
    filter_upwards [hc] with ω hω
    simp only [mem_preimage, hω, hx, mem_empty_iff_false]

/-- **The tower identity for nested conditional kernels**: conditioning first on `comap f` (a map into a standard
Borel space) and then, in that conditional world, on `ℋ` is conditioning on `comap f ⊔ ℋ`. -/
theorem ae_ae_condExpKernel_condExpKernel_comap_sup {X : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    {f : Ω → X} (hf : Measurable f) (hℋ : ℋ ≤ mΩ)
    (hcg : @MeasurableSpace.CountablyGenerated Ω (MeasurableSpace.comap f inferInstance ⊔ ℋ)) :
    ∀ᵐ ω₀ ∂P, ∀ᵐ x ∂(condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀),
      condExpKernel (condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) ℋ x =
        condExpKernel P (MeasurableSpace.comap f inferInstance ⊔ ℋ) x := by
  let := upgradeStandardBorel X
  have h𝒢 : MeasurableSpace.comap f inferInstance ≤ mΩ := hf.comap_le
  have h𝒦 : MeasurableSpace.comap f inferInstance ⊔ ℋ ≤ mΩ := sup_le h𝒢 hℋ
  have h1 := KernelTower.ae_ae_condExpKernel_condExpKernel_eq (P := P) (m := MeasurableSpace.comap f inferInstance)
    (m' := MeasurableSpace.comap f inferInstance ⊔ ℋ) le_sup_left h𝒦 hcg
  have hfib := Sec7.Aux122Disint.ae_ae_condExpKernel_eq (P := P) (𝓔 := MeasurableSpace.comap f inferInstance) h𝒢
    (comap_measurable f)
  filter_upwards [h1, hfib] with ω₀ h1₀ hfib₀
  have h2 := KernelTower.ae_condExpKernel_eq_of_le_aeSigma
    (P := condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) hℋ h𝒦
    (le_sup_right.trans (LocalSets.le_aeSigma _ _))
    (sup_le (comap_le_aeSigma_of_ae_eq_const (ℋ := ℋ) hfib₀) (LocalSets.le_aeSigma ℋ _))
  filter_upwards [h1₀, h2] with x hx1 hx2
  rw [hx2, hx1]

/-- **The tower identity for two maps** into standard Borel spaces. -/
theorem ae_ae_condExpKernel_condExpKernel_comap_comap {X Y : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    [MeasurableSpace Y] [StandardBorelSpace Y] {f : Ω → X} {g : Ω → Y} (hf : Measurable f) (hg : Measurable g) :
    ∀ᵐ ω₀ ∂P, ∀ᵐ x ∂(condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀),
      condExpKernel (condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀)
          (MeasurableSpace.comap g inferInstance) x =
        condExpKernel P (MeasurableSpace.comap f inferInstance ⊔ MeasurableSpace.comap g inferInstance) x := by
  have hcg : @MeasurableSpace.CountablyGenerated Ω
      (MeasurableSpace.comap f inferInstance ⊔ MeasurableSpace.comap g inferInstance) := by
    rw [← MeasurableSpace.comap_prodMk]
    have : MeasurableSpace.CountablyGenerated (X × Y) := by
      let := upgradeStandardBorel X
      let := upgradeStandardBorel Y
      infer_instance
    exact MeasurableSpace.CountablyGenerated.comap _
  exact ae_ae_condExpKernel_condExpKernel_comap_sup hf hg.comap_le hcg

/-- **Transfer to the nested kernel**: a property of the sample and of the kernel given `comap f ⊔ ℋ` that holds
`P`-almost surely holds, for `P`-almost every `ω₀`, almost surely under `condExpKernel P (comap f) ω₀` for the nested
kernel given `ℋ`. -/
theorem ae_ae_nested_of_ae_sup {X : Type*} [MeasurableSpace X] [StandardBorelSpace X] {f : Ω → X}
    (hf : Measurable f) (hℋ : ℋ ≤ mΩ)
    (hcg : @MeasurableSpace.CountablyGenerated Ω (MeasurableSpace.comap f inferInstance ⊔ ℋ))
    {p : Ω → Measure Ω → Prop}
    (h : ∀ᵐ x ∂P, p x (condExpKernel P (MeasurableSpace.comap f inferInstance ⊔ ℋ) x)) :
    ∀ᵐ ω₀ ∂P, ∀ᵐ x ∂(condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀),
      p x (condExpKernel (condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) ℋ x) := by
  filter_upwards [KernelTower.ae_ae_condExpKernel_of_ae hf.comap_le h,
    ae_ae_condExpKernel_condExpKernel_comap_sup hf hℋ hcg] with ω₀ h₀ htower
  filter_upwards [h₀, htower] with x hx hxt
  rw [hxt]
  exact hx

end InteractingSLE.Theorem14.SB.Lk
