/-!
# Regular conditional kernels: the kernel of a kernel, and σ-algebras equal up to null sets

Packet PROVE-T14-BR7, the first two of the three lemmas listed in `planning/handoffs/PROVE-T14-BR6.md` §5 (a) for GW1's
inductive step ("auxiliary stage encodings may be forgotten by the tower property", supplement p. 620).

* **`ae_ae_condExpKernel_condExpKernel_eq`** (*kernel of a kernel*): for `m ≤ m' ≤ mΩ` with `m'` countably generated,
  for `P`-almost every `ω₀` and almost every `x` under `ν = condExpKernel P m ω₀`, the regular conditional law of `ν`
  given `m'` at `x` is the regular conditional law of `P` given `m'` at `x`. (Conditioning first on `m` and then, in
  that conditional world, on `m'` is conditioning on `m'`.)
* **`ae_condExpKernel_eq_of_le_aeSigma`** (*null-equivalent σ-algebras*): if two sub-σ-algebras are contained in each
  other up to null sets, their regular conditional kernels agree almost surely; **`ae_condExpKernel_comap_eq`**: the
  form for σ-algebras generated by two maps each of which is almost surely a measurable function of the other.

## Proof of the kernel-of-kernel identity

Let `κ = condExpKernel P m`, `κ' = condExpKernel P m'`. For `C ∈ m'` and measurable `A`, the tower property
(`KernelTower.ae_condExpKernel_eq_lintegral`) for `C ∩ A`, together with `κ'(x)(C ∩ A) = 1_C(x) κ'(x)(A)` for
`P`-almost every `x` (the kernel lives on the side of `C` containing `x`), gives for `P`-almost every `ω₀`:
`∫_C κ'(x)(A) dκ(ω₀)(x) = κ(ω₀)(C ∩ A)`. Take a countable π-system generating `m'` and one generating the whole space;
for almost every `ω₀` these identities hold simultaneously. Fix such `ω₀` and `ν = κ(ω₀)`. For each `A` of the second
π-system, Dynkin's π–λ theorem extends the identity to every `C ∈ m'`, so `κ'(·)(A)` (an `m'`-measurable function) has
the defining integrals of `condExpKernel ν m'(·)(A)` on all of `m'`, hence equals it `ν`-almost everywhere. Two
probability measures that agree on a generating π-system are equal.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal

namespace InteractingSLE

namespace KernelTower

variable {Ω : Type*} {m m' : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω}
  [IsFiniteMeasure P]

/-- On an event `C` of `m'`, the conditional probability of `C ∩ A` given `m'` is that of `A` on `C` and `0` off `C`. -/
theorem ae_condExpKernel_inter_eq_indicator (hm' : m' ≤ mΩ) {C : Set Ω} (hC : MeasurableSet[m'] C) (A : Set Ω) :
    ∀ᵐ x ∂P, condExpKernel P m' x (C ∩ A) = C.indicator (fun x => condExpKernel P m' x A) x := by
  filter_upwards [ae_condExpKernel_compl_eq_zero (P := P) hm' hC] with x hx
  by_cases hxC : x ∈ C
  · rw [indicator_of_mem hxC, inter_comm]
    exact measure_inter_conull (hx.1 hxC)
  · rw [indicator_of_notMem hxC]
    exact measure_mono_null inter_subset_left (hx.2 hxC)

/-- **The integral of the conditional probability given `m'` over an event of `m'`, under the conditional law given
`m ≤ m'`**: almost surely `∫_C κ_{m'}(x)(A) dκ_m(ω)(x) = κ_m(ω)(C ∩ A)`. -/
theorem ae_setLIntegral_condExpKernel_eq (hm : m ≤ m') (hm' : m' ≤ mΩ) {C : Set Ω} (hC : MeasurableSet[m'] C)
    {A : Set Ω} (hA : MeasurableSet A) :
    ∀ᵐ ω ∂P, ∫⁻ x in C, condExpKernel P m' x A ∂(condExpKernel P m ω) = condExpKernel P m ω (C ∩ A) := by
  have hCΩ : MeasurableSet C := hm' _ hC
  filter_upwards [ae_condExpKernel_eq_lintegral (P := P) hm hm' (hCΩ.inter hA),
    ae_ae_condExpKernel_of_ae (P := P) (m := m) (hm.trans hm')
      (ae_condExpKernel_inter_eq_indicator (P := P) hm' hC A)] with ω h1 h2
  rw [h1, ← lintegral_indicator hCΩ]
  exact (lintegral_congr_ae h2).symm

omit [StandardBorelSpace Ω] [IsFiniteMeasure P] in
/-- **Dynkin extension of a disintegration identity.** If `∫_C f dν = ν(C ∩ A)` for every `C` of a π-system generating
`m'` and for `C = univ`, then it holds for every `C ∈ m'`. -/
theorem setLIntegral_eq_of_generate {ν : Measure Ω} [IsFiniteMeasure ν] (hm' : m' ≤ mΩ) {C' : Set (Set Ω)}
    (hgen : m' = MeasurableSpace.generateFrom C') (hpi : IsPiSystem C') (f : Ω → ℝ≥0∞) {A : Set Ω}
    (hA : MeasurableSet A) (hC : ∀ C ∈ C', ∫⁻ x in C, f x ∂ν = ν (C ∩ A)) (huniv : ∫⁻ x, f x ∂ν = ν A) :
    ∀ C, MeasurableSet[m'] C → ∫⁻ x in C, f x ∂ν = ν (C ∩ A) := by
  refine @MeasurableSpace.induction_on_inter Ω m' (fun C _ => ∫⁻ x in C, f x ∂ν = ν (C ∩ A)) C' hgen hpi
    ?_ (fun t ht => hC t ht) ?_ ?_
  · simp
  · intro t htm ih
    have htΩ : MeasurableSet t := hm' _ htm
    have h1 := lintegral_add_compl (μ := ν) f htΩ
    have h2 := measure_inter_add_sdiff (μ := ν) A htΩ
    rw [ih, huniv] at h1
    rw [inter_comm A t] at h2
    have h3 : ν (tᶜ ∩ A) = ν (A \ t) := by rw [sdiff_eq, inter_comm]
    rw [h3]
    have hne : ν (t ∩ A) ≠ ⊤ := measure_ne_top _ _
    exact (ENNReal.add_right_inj hne).1 (h1.trans h2.symm)
  · intro g hdisj hgm ih
    have hgΩ : ∀ i, MeasurableSet (g i) := fun i => hm' _ (hgm i)
    rw [lintegral_iUnion hgΩ hdisj, iUnion_inter,
      measure_iUnion (hdisj.mono fun i j h => h.mono inter_subset_left inter_subset_left)
        fun i => (hgΩ i).inter hA]
    exact tsum_congr ih

/-- **The kernel of a kernel** (GW1, p. 620: "auxiliary stage encodings may be forgotten by the tower property"). For
`m ≤ m' ≤ mΩ` with `m'` countably generated: for `P`-almost every `ω₀`, under `ν = condExpKernel P m ω₀`, almost every
`x` has `condExpKernel ν m' x = condExpKernel P m' x`. -/
theorem ae_ae_condExpKernel_condExpKernel_eq (hm : m ≤ m') (hm' : m' ≤ mΩ)
    (hcg : @MeasurableSpace.CountablyGenerated Ω m') :
    ∀ᵐ ω ∂P, ∀ᵐ x ∂(condExpKernel P m ω), condExpKernel (condExpKernel P m ω) m' x = condExpKernel P m' x := by
  obtain ⟨C', hC'c, hC'pi, hC'gen⟩ := @Exist.Param12.exists_countable_isPiSystem_generate Ω m' hcg
  have : MeasurableSpace.CountablyGenerated Ω := by
    let := upgradeStandardBorel Ω
    infer_instance
  obtain ⟨CΩ, hCΩc, hCΩpi, hCΩgen⟩ := Exist.Param12.exists_countable_isPiSystem_generate Ω
  have hmC' : ∀ C ∈ C', MeasurableSet[m'] C := fun C hC => by
    rw [hC'gen]
    exact MeasurableSpace.measurableSet_generateFrom hC
  have hmA : ∀ A ∈ CΩ, MeasurableSet A := fun A hA => by
    rw [hCΩgen]
    exact MeasurableSpace.measurableSet_generateFrom hA
  have hall : ∀ᵐ ω ∂P, ∀ A ∈ CΩ,
      (∀ C ∈ C', ∫⁻ x in C, condExpKernel P m' x A ∂(condExpKernel P m ω) = condExpKernel P m ω (C ∩ A)) ∧
        ∫⁻ x, condExpKernel P m' x A ∂(condExpKernel P m ω) = condExpKernel P m ω A := by
    refine (ae_ball_iff hCΩc).2 fun A hA => ?_
    refine ((ae_ball_iff hC'c).2 fun C hC => ae_setLIntegral_condExpKernel_eq hm hm' (hmC' C hC) (hmA A hA)).and ?_
    filter_upwards [ae_setLIntegral_condExpKernel_eq (P := P) hm hm' (@MeasurableSet.univ Ω m') (hmA A hA)]
      with ω hω
    rwa [Measure.restrict_univ, univ_inter] at hω
  filter_upwards [hall] with ω hω
  have hA : ∀ A ∈ CΩ, ∀ᵐ x ∂(condExpKernel P m ω),
      condExpKernel (condExpKernel P m ω) m' x A = condExpKernel P m' x A := by
    intro A hA
    have hAm := hmA A hA
    have hF : Measurable[m'] fun x => condExpKernel P m' x A := measurable_condExpKernel hAm
    have hG : Measurable[m'] fun x => condExpKernel (condExpKernel P m ω) m' x A := measurable_condExpKernel hAm
    have hset := setLIntegral_eq_of_generate (ν := condExpKernel P m ω) hm' hC'gen hC'pi
      (fun x => condExpKernel P m' x A) hAm (hω A hA).1 (hω A hA).2
    refine ae_of_ae_trim hm' ?_
    refine ae_eq_of_forall_setLIntegral_eq_of_sigmaFinite hG hF fun C hC _ => ?_
    rw [setLIntegral_trim hm' hG hC, setLIntegral_trim hm' hF hC, setLIntegral_condExpKernel hm' hC hAm,
      hset C hC]
  filter_upwards [(ae_ball_iff hCΩc).2 hA] with x hx
  exact ext_of_generate_finite CΩ hCΩgen hCΩpi hx (by rw [measure_univ, measure_univ])

end KernelTower

/-! ### σ-algebras equal up to null sets -/

namespace KernelTower

variable {Ω : Type*} {m₀ m₁ m₂ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]

/-- If `m₁ ≤ m ≤ mΩ` and every `m`-set is an `m₁`-set up to a null set, the conditional expectations agree. -/
theorem condExp_ae_eq_of_le_aeSigma_sup (h₁ : m₁ ≤ m₀) (hm : m₀ ≤ mΩ)
    (htr : m₀ ≤ LocalSets.aeSigma m₁ P) {X : Ω → ℝ} (hX : Integrable X P) : P[X | m₁] =ᵐ[P] P[X | m₀] := by
  have hm₁ : m₁ ≤ mΩ := h₁.trans hm
  refine ae_eq_condExp_of_forall_setIntegral_eq hm hX (fun s _ _ => integrable_condExp.integrableOn)
    (fun s hs _ => ?_) ((stronglyMeasurable_condExp.mono h₁).aestronglyMeasurable)
  obtain ⟨C, hCm, hsC⟩ := htr s hs
  rw [setIntegral_congr_set hsC, setIntegral_condExp hm₁ hX hCm, ← setIntegral_congr_set hsC]

/-- **Null-equivalent σ-algebras have almost surely equal regular conditional kernels**: if `m₁` and `m₂` are each
contained in the other up to `P`-null sets, then `condExpKernel P m₁ = condExpKernel P m₂` almost surely. -/
theorem ae_condExpKernel_eq_of_le_aeSigma [StandardBorelSpace Ω] (h₁ : m₁ ≤ mΩ) (h₂ : m₂ ≤ mΩ)
    (h₁₂ : m₁ ≤ LocalSets.aeSigma m₂ P) (h₂₁ : m₂ ≤ LocalSets.aeSigma m₁ P) :
    ∀ᵐ ω ∂P, condExpKernel P m₁ ω = condExpKernel P m₂ ω := by
  have hm := sup_le h₁ h₂
  have htr₁ : m₁ ⊔ m₂ ≤ LocalSets.aeSigma m₁ P := sup_le (LocalSets.le_aeSigma m₁ P) h₂₁
  have htr₂ : m₁ ⊔ m₂ ≤ LocalSets.aeSigma m₂ P := sup_le h₁₂ (LocalSets.le_aeSigma m₂ P)
  have hset : ∀ A : Set Ω, MeasurableSet A →
      ∀ᵐ ω ∂P, condExpKernel P m₁ ω A = condExpKernel P m₂ ω A := by
    intro A hA
    have hX : Integrable (A.indicator fun _ => (1 : ℝ)) P := (integrable_const (1 : ℝ)).indicator hA
    filter_upwards [condExpKernel_ae_eq_condExp h₁ hA, condExpKernel_ae_eq_condExp h₂ hA,
      condExp_ae_eq_of_le_aeSigma_sup le_sup_left hm htr₁ hX,
      condExp_ae_eq_of_le_aeSigma_sup le_sup_right hm htr₂ hX] with ω e1 e2 e3 e4
    have hreal : (condExpKernel P m₁ ω).real A = (condExpKernel P m₂ ω).real A := by
      rw [e1, e2]
      exact e3.trans e4.symm
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).1 hreal
  have : MeasurableSpace.CountablyGenerated Ω := by
    let := upgradeStandardBorel Ω
    infer_instance
  obtain ⟨Cp, hc, hpi, hgen⟩ := Exist.Param12.exists_countable_isPiSystem_generate Ω
  have hall : ∀ᵐ ω ∂P, ∀ A ∈ Cp, condExpKernel P m₁ ω A = condExpKernel P m₂ ω A :=
    (ae_ball_iff hc).2 fun A hA => hset A (by rw [hgen]; exact MeasurableSpace.measurableSet_generateFrom hA)
  filter_upwards [hall] with ω hω
  exact ext_of_generate_finite Cp hgen hpi hω (by rw [measure_univ, measure_univ])

omit [IsFiniteMeasure P] in
/-- `comap f` is contained in `comap g` up to null sets when `f` is almost surely a measurable function of `g`. -/
theorem comap_le_aeSigma_comap {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y] {f : Ω → X} {g : Ω → Y}
    {φ : Y → X} (hφ : Measurable φ) (hfg : ∀ᵐ ω ∂P, f ω = φ (g ω)) :
    MeasurableSpace.comap f inferInstance ≤ LocalSets.aeSigma (MeasurableSpace.comap g inferInstance) P := by
  rintro _ ⟨B, hB, rfl⟩
  refine ⟨g ⁻¹' (φ ⁻¹' B), ⟨φ ⁻¹' B, hφ hB, rfl⟩, ?_⟩
  filter_upwards [hfg] with ω hω
  simp only [mem_preimage, hω]

/-- **Regular conditional kernels given two maps that determine each other almost surely agree almost surely.** -/
theorem ae_condExpKernel_comap_eq [StandardBorelSpace Ω] {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {f : Ω → X} {g : Ω → Y}
    (hf : Measurable f) (hg : Measurable g) {φ : Y → X} (hφ : Measurable φ) {ψ : X → Y} (hψ : Measurable ψ)
    (hfg : ∀ᵐ ω ∂P, f ω = φ (g ω)) (hgf : ∀ᵐ ω ∂P, g ω = ψ (f ω)) :
    ∀ᵐ ω ∂P, condExpKernel P (MeasurableSpace.comap f inferInstance) ω =
      condExpKernel P (MeasurableSpace.comap g inferInstance) ω :=
  ae_condExpKernel_eq_of_le_aeSigma hf.comap_le hg.comap_le (comap_le_aeSigma_comap hφ hfg)
    (comap_le_aeSigma_comap hψ hgf)

end KernelTower

end InteractingSLE
