/-!
# GW2's `noThreshold`: no threshold while the explored curve is interior to the stage domain (one sample, root `x`)

Packet PROVE-GW2-NOTHR (round 2, decision D38). At a root `x`, a root-`x` version `R` of the relative driver
(`GW2Rz.VersionAtX`) is generated, before the root-`x` contact and below its stop, by the re-centred relative image of
the physical explored trace (BUF's `GW2Bf.isGeneratingTrace_capacityTip_of_hull`, ROOT2's `rootTipRead_eq`). Hence, if
the explored trace at a physical time `τ` (after the stage time `T`, before the contact) is an interior point of
`ℍ \ K_T`, the stage driver `R(S + ·) − R(S)` (`S` the clock at `T`) has no continuation threshold at the stage time
of `τ`, for any force word (`GW2Nt.not_threshold_shift_of_mem`, through a global frozen extension of `R`,
`GW2Fb.exists_frozen_generatingTrace`).

* `isGeneratingTrace_versionX`, `capacityTip_clock_eq`;
* **`not_threshold_of_interiorX`**.

Deterministic, one sample; no named input.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Filter Topology
open scoped NNReal ENNReal
open QuantumZipper (H fwdHull)
open QuantumZipper.RS (shiftDrive)

namespace InteractingSLE.Theorem14.GW2Nt

open Restart Exist Exist.StagedLaw Supp8.GB6 Supp8.GB6.CoordB GW2TipSystem GW2Rz MartChar.RealFlow


/-- **The relative map is injective on the relative domain.** -/
theorem injOn_relMap {U : ℝ → ℝ} (hU : Continuous U) {σ : ℝ} (hσ : 0 ≤ σ) :
    InjOn (relMap U σ) (relDomain U σ) := by
  intro z hz z' hz' h
  have hm : ∀ {y : ℂ}, y ∈ relDomain U σ → -y⁻¹ ∈ H \ fwdHull U σ := fun {y} hy =>
    ⟨Supp8.GB6.neg_inv_mem_H hy.1, fun hK => hy.2 ⟨-y⁻¹, hK, neg_inv_neg_inv y⟩⟩
  have h1 : QuantumZipper.fwdMap U σ (-z⁻¹) = QuantumZipper.fwdMap U σ (-z'⁻¹) := by
    unfold relMap at h
    exact inv_injective (neg_injective h)
  have h2 := QuantumZipper.FwdHolo.injOn_fwdMap hU hσ (hm hz) (hm hz') h1
  have h3 : z⁻¹ = z'⁻¹ := neg_injective h2
  exact inv_injective h3

section Interior

variable {Ω : Type*} {x : ℝ} {s : ℝ≥0} {W' : ℝ≥0 → Ω → ℝ} {ζ' : Ω → ℝ≥0∞} {w : ℝ≥0 → Ω → ℝ}
  {γ α : Ω → ℝ≥0 → ℂ} {GT : Set Ω} (hGT : ∀ ω ∈ GT, PhysGoodX x s W' ζ' w γ α ω) (hs : 0 < s) (hx : 0 ≤ x)

include hGT hs hx

/-- **A root-`x` version is generated by the capacity tip** up to a horizon `v` before the contact and below the stop. -/
theorem isGeneratingTrace_versionX {R : ℝ≥0 → Ω → ℝ} {V : Ω → ℝ≥0∞} {ω : Ω} (hω : ω ∈ GT)
    (hR : VersionAtX x s W' ζ' w γ α R V ω) {v : ℝ≥0} (hvc : (v : ℝ≥0∞) < contactX x s γ α ω)
    (hvV : ENNReal.ofReal (clockX x s W' ζ' w v ω) ≤ V ω) :
    IsGeneratingTrace (fun t => R t ω) (ENNReal.ofReal (clockX x s W' ζ' w v ω))
      (fun u => RootI30.capacityTipRead x s v u (recPair s W' ζ' w v ω)) := by
  obtain ⟨⟨hwc, hw0, hγ⟩, ⟨hα, hW, hW0, hζ⟩, harc, -, -⟩ := hGT ω hω
  obtain ⟨-, -, hhull⟩ := hR
  have he := Gm.isRegularDriver_top hwc hw0
  have hv : (v : ℝ≥0∞) < min (contactX x s γ α ω) ((fun t => w t ω), (⊤ : ℝ≥0∞)).2 := by
    rw [min_top_right]; exact hvc
  obtain ⟨-, hmono, -⟩ := clock_props W' ζ' ω hα hW hW0 hζ hs hx harc hwc hw0 hγ
  have hpre : ∀ t ≤ v, clockX x s W' ζ' w t ω =
      RootH29.forwardCapacity x s t (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤)) := fun t ht =>
    forwardCapacity_prefix_eq' he _ ENNReal.coe_lt_top ht le_rfl
  have hpreH : ∀ t ≤ v, hullX x s W' ζ' w t ω =
      (fun z : ℂ => z + ((-GW2Bf.relBase x s (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤)) : ℝ) :
        ℂ)) '' RootH29.forwardHull x s t (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤)) := by
    intro t ht
    unfold hullX recPair
    rw [forwardHull_prefix_eq he _ ENNReal.coe_lt_top ht le_rfl]
    rfl
  have hB := GW2Bf.isGeneratingTrace_capacityTip_of_hull W' ζ' ω hα hW hW0 hζ hs hx harc he hγ hv
    (R := fun t => R t ω) fun t ht => by
      have htc : (t : ℝ≥0∞) < contactX x s γ α ω := (ENNReal.coe_le_coe.2 ht.2).trans_lt hvc
      have htV : ENNReal.ofReal (clockX x s W' ζ' w t ω) ≤ V ω :=
        (ENNReal.ofReal_le_ofReal (hmono.monotoneOn htc hvc ht.2)).trans hvV
      rw [← hpre t ht.2, hhull t htc htV, hpreH t ht.2]
  rw [← hpre v le_rfl] at hB
  exact hB

/-- **The capacity tip at the clock of a physical time** is the re-centred relative image of the explored point. -/
theorem capacityTip_clock_eq {ω : Ω} (hω : ω ∈ GT) {v τ : ℝ≥0} (hvc : (v : ℝ≥0∞) < contactX x s γ α ω)
    (hτv : τ ≤ v) :
    RootI30.capacityTipRead x s v (clockX x s W' ζ' w τ ω).toNNReal (recPair s W' ζ' w v ω) =
      relBdry (rdrv (cfRec s W' ζ' ω)) s ((x : ℂ) + γ ω τ) - relBdry (rdrv (cfRec s W' ζ' ω)) s x := by
  obtain ⟨⟨hwc, hw0, hγ⟩, ⟨hα, hW, hW0, hζ⟩, harc, -, -⟩ := hGT ω hω
  have he := Gm.isRegularDriver_top hwc hw0
  have hv : (v : ℝ≥0∞) < min (contactX x s γ α ω) ((fun t => w t ω), (⊤ : ℝ≥0∞)).2 := by
    rw [min_top_right]; exact hvc
  obtain ⟨-, -, h0, hm, hc, -⟩ := RootI30.exists_reader_chain W' ζ' ω hα hW hW0 hζ hs hx harc he hγ hv
  have hset : {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (v : ℝ≥0∞)} = Icc 0 v := by
    ext t
    simp only [mem_ofPred_eq, ENNReal.coe_le_coe, mem_Icc, zero_le, true_and]
  have ha : IsClockOn (fun t => RootH29.forwardCapacity x s t
      (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤))) (v : ℝ≥0∞) :=
    ⟨h0, hset ▸ hm, hset ▸ hc, fun h => (ENNReal.coe_ne_top h).elim⟩
  have hpre : clockX x s W' ζ' w τ ω =
      RootH29.forwardCapacity x s τ (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤)) :=
    forwardCapacity_prefix_eq' he _ ENNReal.coe_lt_top hτv le_rfl
  unfold RootI30.capacityTipRead RootI30.clockInverse
  rw [hpre]
  change RootH29.rootTipRead x s (invClock (fun t => RootH29.forwardCapacity x s t
      (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤))) (v : ℝ≥0∞)
      (RootH29.forwardCapacity x s τ (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤))).toNNReal)
      (cfRec s W' ζ' ω, recOf (v : ℝ≥0∞) ((fun t => w t ω), ⊤)) = _
  rw [ha.invClock_apply (ENNReal.coe_le_coe.2 hτv)]
  exact RootH29.rootTipRead_eq W' ζ' ω hα hW hW0 hζ hx harc he hγ hv hτv

/-- **No threshold while the explored curve is interior** (one sample, root `x`). Let `τ` be a physical time after
the stage time `T` and before a horizon `v` before the contact and below the version's stop, with stage start
`S = clock(T)` and `S + u = clock(τ)`. If the explored trace at `τ` is an interior point of `ℍ \ K_T`, the stage
driver `R(S + ·) − R(S)` has no continuation threshold at `u`, for any force word. -/
theorem not_threshold_of_interiorX {R : ℝ≥0 → Ω → ℝ} {V : Ω → ℝ≥0∞} {ω : Ω} (hω : ω ∈ GT)
    (hR : VersionAtX x s W' ζ' w γ α R V ω) {T τ v : ℝ≥0} (hTτ : T < τ) (hτv : τ < v)
    (hvc : (v : ℝ≥0∞) < contactX x s γ α ω) (hvV : ENNReal.ofReal (clockX x s W' ζ' w v ω) ≤ V ω)
    {S u : ℝ≥0} (hS : (S : ℝ) = clockX x s W' ζ' w T ω) (hSu : ((S + u : ℝ≥0) : ℝ) = clockX x s W' ζ' w τ ω)
    (hmem : γ ω τ ∈ H \ fwdHull (fun r : ℝ => w r.toNNReal ω) T)
    {nL nR : ℕ} {xL ρL : Fin nL → ℝ} {xR ρR : Fin nR → ℝ} (hxL : ∀ i, xL i ≤ 0) (hxR : ∀ j, 0 ≤ xR j) :
    ¬ ForceWord.ThresholdCondition ρL ρR (GW2Rd.stgDrv (fun t => R t ω) S u)
      (fun i => -rightImg (fun v : ℝ => -GW2Rd.stgDrv (fun t => R t ω) S v.toNNReal) (-xL i) u)
      (fun j => rightImg (fun v : ℝ => GW2Rd.stgDrv (fun t => R t ω) S v.toNNReal) (xR j) u) := by
  have hR' := hR
  obtain ⟨⟨hwc, hw0, hγ⟩, ⟨hα, hW, hW0, hζ⟩, harc, -, -⟩ := hGT ω hω
  obtain ⟨hRc, hR0, hhull⟩ := hR'
  have he := Gm.isRegularDriver_top hwc hw0
  have hv : (v : ℝ≥0∞) < min (contactX x s γ α ω) ((fun t => w t ω), (⊤ : ℝ≥0∞)).2 := by
    rw [min_top_right]; exact hvc
  obtain ⟨-, hmono, -⟩ := clock_props W' ζ' ω hα hW hW0 hζ hs hx harc hwc hw0 hγ
  have hτc : (τ : ℝ≥0∞) < contactX x s γ α ω := (ENNReal.coe_lt_coe.2 hτv).trans hvc
  have hTc : (T : ℝ≥0∞) < contactX x s γ α ω := (ENNReal.coe_lt_coe.2 hTτ).trans hτc
  have hTτ' : clockX x s W' ζ' w T ω < clockX x s W' ζ' w τ ω := hmono hTc hτc hTτ
  have hτv' : clockX x s W' ζ' w τ ω < clockX x s W' ζ' w v ω := hmono hτc hvc hτv
  have hu : (0 : ℝ) < u := by
    have h1 : ((S + u : ℝ≥0) : ℝ) = S + u := NNReal.coe_add S u
    linarith
  -- the generating trace of the version and a global frozen extension
  have hB := isGeneratingTrace_versionX hGT hs hx hω hR hvc hvV
  have hlt : ((S + u : ℝ≥0) : ℝ≥0∞) < ENNReal.ofReal (clockX x s W' ζ' w v ω) := by
    rw [← ENNReal.ofReal_coe_nnreal, hSu]
    exact (ENNReal.ofReal_lt_ofReal_iff (lt_of_le_of_lt (hSu ▸ (S + u).coe_nonneg) hτv')).2 hτv'
  obtain ⟨R', α', t₂, hlt₂, -, hR'c, hR'0, hR'g, hRR', hαα'⟩ :=
    GW2Fb.exists_frozen_generatingTrace hB hRc.continuousOn hR0 hlt
  have hL := isLoewnerTrace_of_isGeneratingTrace hR'g
  set W : ℝ → ℝ := fun r : ℝ => R' r.toNNReal with hWdef
  have hWc : Continuous W := hR'c.comp continuous_real_toNNReal
  have hW0' : W 0 = 0 := by simp only [hWdef, Real.toNNReal_zero, hR'0]
  -- the explored point read in the relative chart
  set U := rdrv (cfRec s W' ζ' ω) with hU
  have hUc : Continuous U := continuous_rdrv _
  have hU0 : U 0 = 0 := rdrv_zero _
  have hsafe := RootH29.trace_mem_record_relSafe W' ζ' ω hα hW hW0 hζ hx harc he hγ hv hτv.le
  have hsafe0 := RootH29.trace_mem_record_relSafe W' ζ' ω hα hW hW0 hζ hx harc he hγ hv (t := 0) zero_le
  rw [hγ.1, add_zero] at hsafe0
  have hzH : (x : ℂ) + γ ω τ ∈ H := by
    have h := hmem.1
    change 0 < (γ ω τ).im at h
    change 0 < ((x : ℂ) + γ ω τ).im
    simpa using h
  have hbx : (relBdry U s x).im = 0 := im_relBdry_of_real hUc hU0 s.coe_nonneg hsafe0.2
  have htip : (fun r : ℝ => α' r.toNNReal) ((S : ℝ) + u) =
      relBdry U s ((x : ℂ) + γ ω τ) - relBdry U s x := by
    have e1 : ((S : ℝ) + u).toNNReal = S + u := by rw [← NNReal.coe_add, Real.toNNReal_coe]
    have e2 : (clockX x s W' ζ' w τ ω).toNNReal = S + u := by rw [← hSu, Real.toNNReal_coe]
    simp only [e1]
    rw [hαα' _ hlt₂.le, ← e2]
    exact capacityTip_clock_eq hGT hs hx hω hvc hτv.le
  have hmem' : (fun r : ℝ => α' r.toNNReal) ((S : ℝ) + u) ∈ H \ fwdHull W S := by
    rw [htip]
    refine ⟨?_, fun hK => ?_⟩
    · have h1 := (relBdry_mem_H_iff hUc hU0 s.coe_nonneg hsafe).2 hzH
      change 0 < (relBdry U s ((x : ℂ) + γ ω τ) - relBdry U s x).im
      rw [Complex.sub_im, hbx, sub_zero]
      exact h1
    · -- the relative hull at `S` is the image of the physical hull at `T`
      have hSt : (S : ℝ) < t₂ := lt_of_le_of_lt (by simpa using (le_self_add : S ≤ S + u)) hlt₂
      have hKW : fwdHull W S = fwdHull (fun r : ℝ => R r.toNNReal ω) (clockX x s W' ζ' w T ω) := by
        rw [← hS]
        refine fwdHull_eq_of_eqOn S.coe_nonneg hSt fun r hr => ?_
        exact hRR' _ (Real.toNNReal_le_iff_le_coe.2 hr.2)
      have hTV : ENNReal.ofReal (clockX x s W' ζ' w T ω) ≤ V ω :=
        (ENNReal.ofReal_le_ofReal (hTτ'.trans hτv').le).trans hvV
      rw [hKW, hhull T hTc hTV] at hK
      unfold hullX recPair at hK
      rw [forwardHull_prefix_eq he _ ENNReal.coe_lt_top (hTτ.trans hτv).le le_rfl] at hK
      obtain ⟨z, hz, hzeq⟩ := hK
      unfold RootH29.forwardHull at hz
      obtain ⟨y, ⟨hyK, hyD⟩, rfl⟩ := hz
      have hcre : ((GW2Bf.relBase x s (cfRec s W' ζ' ω, recOf (T : ℝ≥0∞) ((fun t => w t ω), ⊤)) : ℝ) : ℂ) =
          relBdry U s x := Complex.ext (by simp only [GW2Bf.relBase, Complex.ofReal_re]; rfl) (by simp [hbx])
      rw [Complex.ofReal_neg, hcre] at hzeq
      have heq : relMap U s y = relMap U s ((x : ℂ) + γ ω τ) := by
        rw [← relBdry_eq hUc s.coe_nonneg hzH hsafe.2]
        linear_combination hzeq
      have hzD : (x : ℂ) + γ ω τ ∈ relDomain U s := ⟨hzH, fun h => hsafe.2 (subset_closure h)⟩
      have hyz := injOn_relMap hUc s.coe_nonneg hyD hzD heq
      obtain ⟨q, hq, hqy⟩ := hyK
      rw [RootZ21.fwdHull_record_of_le_of_live he ENNReal.coe_lt_top (hTτ.trans hτv).le] at hq
      have hqγ : q = γ ω τ := by
        have := hqy.trans hyz
        linear_combination this
      exact hmem.2 (hqγ ▸ hq)
  have hn := not_threshold_shift_of_mem (ρL := ρL) (ρR := ρR) hWc hW0' hL S.coe_nonneg hu hmem' hxL hxR
  -- the shifted driver is the stage driver on `[0, u]`
  have hagree : ∀ r ∈ Icc (0 : ℝ) u,
      (fun v : ℝ => GW2Rd.stgDrv (fun t => R t ω) S v.toNNReal) r = shiftDrive W S r := by
    intro r hr
    have hr' : r.toNNReal ≤ u := Real.toNNReal_le_iff_le_coe.2 hr.2
    have e1 : ((S : ℝ) + r).toNNReal = S + r.toNNReal := by
      rw [Real.toNNReal_add S.coe_nonneg hr.1, Real.toNNReal_coe]
    simp only [GW2Rd.stgDrv, QuantumZipper.RS.shiftDrive, hWdef, e1, Real.toNNReal_coe]
    rw [hRR' _ ((add_le_add le_rfl hr').trans hlt₂.le), hRR' _ (le_self_add.trans hlt₂.le)]
  have hsc : Continuous (shiftDrive W S) := QuantumZipper.RS.continuous_shiftDrive hWc S
  have eD : GW2Rd.stgDrv (fun t => R t ω) S u = shiftDrive W S u := by
    have := hagree u ⟨u.coe_nonneg, le_rfl⟩
    simpa only [Real.toNNReal_coe] using this
  have eR : ∀ y, rightImg (fun v : ℝ => GW2Rd.stgDrv (fun t => R t ω) S v.toNNReal) y u =
      rightImg (shiftDrive W S) y u := fun y => Supp8.GB6.rightImg_congr hsc u.coe_nonneg hagree
  have eL : ∀ y, rightImg (fun v : ℝ => -GW2Rd.stgDrv (fun t => R t ω) S v.toNNReal) y u =
      rightImg (fun v => -shiftDrive W S v) y u := fun y =>
    Supp8.GB6.rightImg_congr hsc.neg u.coe_nonneg fun r hr => by
      have h := hagree r hr
      simp only at h
      simp only [Pi.neg_apply, h]
  rw [eD]
  simp only [eR, eL]
  exact hn

end Interior

end InteractingSLE.Theorem14.GW2Nt
