import InteractingSLE.Spec.Supplement.SB2MvRP
import InteractingSLE.Spec.Supplement.SB2LkTower

/-!
# The retained-law induction, step `j ≥ 1`: one piece through the single-stage law and the kernel tower

Packet PROVE-SB2-LCMEAN, round 14 (orchestrator split after R121: the `j ≥ 1` step is LCMEAN's). The generic core of
`Exist.StagedLaw.post_stage` with arbitrary marks: if the marks are generated by a map `f` into a standard Borel space,
the chart field `Y` is, given the marks, a GFF with a marks-measurable word `β`, and a driver `E` is, given the marks, a
flow-line driver of `Y` with that word, then the field after the piece (`recField` of `E`'s record at `t`) is, given
the marks and the record, a GFF with the stopped word `βA (β, θ, record)` (Theorem 1.2's single-stage law
`IsStopLaw`, `Exist.StagedLaw.stopLawStatement`).

The step is run at the `P` level, with the marks of B's stage (they do not depend on the upper-past sample, handoff
§R13.5): the conditional half at the previous stage supplies the flow-line driver, the single-stage law the law after
the piece, and the nested-kernel tower (`Lk.ae_ae_condExpKernel_condExpKernel_comap_comap`) puts it under `P` given
the marks and the record.

* **`ae_condExp_recField_eq`**.

R48: Theorems 1.2–1.3 enter only through `IsStopLaw` (proved from them).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal
open LQGMetric (DistOn TestOn)

universe u

namespace InteractingSLE.Theorem14.SB.Mw

open Restart Exist Exist.Staged Exist.StagedLaw

/-- **The field after one piece, given the marks and the piece's record** (the generic core of
`Exist.StagedLaw.post_stage`). -/
theorem ae_condExp_recField_eq {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] {X : Type*} [MeasurableSpace X] [StandardBorelSpace X] {f : Ω → X}
    (hf : Measurable f) {κ θ : ℝ} {βA : BoundaryWord × ℝ × RecData → BoundaryWord} (hβA : IsStopLaw.{u} κ βA)
    {β : Ω → BoundaryWord} (hβ : Measurable[MeasurableSpace.comap f inferInstance] β)
    {Y : Ω → DistOn upperHalfPlaneOpens} (hY : Measurable Y) {E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} (hE : Measurable E)
    (hreg : ∀ ω, IsRegularDriver (E ω)) {G : Set Ω} (hG : MeasurableSet[MeasurableSpace.comap f inferInstance] G)
    (hfl : ∀ᵐ ω₀ ∂P, ω₀ ∈ G → IsFlowLineDriver κ (β ω₀).fn (β ω₀).jumps θ
      (condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) Y (fun s ω => (E ω).1 s) (fun ω => (E ω).2))
    (t : ℝ≥0∞) (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂P, ω ∈ G → min t (E ω).2 ≠ ⊤ →
      P[fun ω' => Complex.exp (Complex.I * (recField κ (recOf t (E ω')) (Y ω') φ : ℂ)) |
        MeasurableSpace.comap f inferInstance ⊔ MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance] ω =
      gaussCF (βA (β ω, θ, recOf t (E ω))) φ := by
  have h𝒢 : MeasurableSpace.comap f inferInstance ≤ mΩ := hf.comap_le
  have hrec : Measurable fun ω => recOf t (E ω) := measurable_recOf hE hreg t
  have h𝒦 : MeasurableSpace.comap f inferInstance ⊔
      MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance ≤ mΩ := sup_le h𝒢 hrec.comap_le
  have hXm : Measurable fun ω' => recField κ (recOf t (E ω')) (Y ω') φ :=
    (LQGMetric.measurable_distOn_apply φ).comp (measurable_recField_comp κ hrec hY)
  have hFm : Measurable fun ω' => Complex.exp (Complex.I * (recField κ (recOf t (E ω')) (Y ω') φ : ℂ)) :=
    GFF.measurable_exp_I_mul hXm
  have hFi : Integrable (fun ω' => Complex.exp (Complex.I * (recField κ (recOf t (E ω')) (Y ω') φ : ℂ))) P :=
    GFF.integrable_exp_I_mul hXm
  have hβm : Measurable β := hβ.mono h𝒢 le_rfl
  have hGm : Measurable (fun ω => gaussCF (βA (β ω, θ, recOf t (E ω))) φ) :=
    (measurable_gaussCF φ).comp (hβA.1.comp (hβm.prodMk (measurable_const.prodMk hrec)))
  have hIm : Measurable fun ω => ∫ y, Complex.exp (Complex.I * (recField κ (recOf t (E y)) (Y y) φ : ℂ))
      ∂(condExpKernel P (MeasurableSpace.comap f inferInstance ⊔
        MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance) ω) :=
    (hFm.stronglyMeasurable.integral_condExpKernel).measurable.mono h𝒦 le_rfl
  have hζm : Measurable fun ω => (E ω).2 := measurable_snd.comp hE
  have hS : MeasurableSet {ω | ω ∈ G → min t (E ω).2 ≠ ⊤ →
      ∫ y, Complex.exp (Complex.I * (recField κ (recOf t (E y)) (Y y) φ : ℂ))
        ∂(condExpKernel P (MeasurableSpace.comap f inferInstance ⊔
          MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance) ω) =
      gaussCF (βA (β ω, θ, recOf t (E ω))) φ} := by
    have h1 : MeasurableSet {ω | min t (E ω).2 = ⊤} :=
      measurableSet_eq_fun (measurable_const.min hζm) measurable_const
    have h2 := measurableSet_eq_fun hIm hGm
    exact ((h𝒢 _ hG).compl.union (h1.union h2)).congr (by
      ext ω
      simp only [mem_union, mem_compl_iff, mem_ofPred_eq]
      tauto)
  have hker : ∀ᵐ ω₀ ∂P, ∀ᵐ ω ∂(condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀),
      ω ∈ {ω | ω ∈ G → min t (E ω).2 ≠ ⊤ →
        ∫ y, Complex.exp (Complex.I * (recField κ (recOf t (E y)) (Y y) φ : ℂ))
          ∂(condExpKernel P (MeasurableSpace.comap f inferInstance ⊔
            MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance) ω) =
        gaussCF (βA (β ω, θ, recOf t (E ω))) φ} := by
    filter_upwards [hfl, Lk.ae_ae_condExpKernel_condExpKernel_comap_comap (P := P) hf hrec,
      Sec7.Aux122Disint.ae_ae_condExpKernel_eq (P := P) h𝒢 hβ,
      Sec7.Aux122Disint.ae_condExpKernel_apply_eq_indicator (P := P) h𝒢 hG] with ω₀ hfl₀ htower hβeq hind
    by_cases h₀ : ω₀ ∈ G
    · obtain ⟨-, hcf⟩ := hβA.2.2 (β ω₀) θ t (condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) Y E
        hE hreg (hfl₀ h₀)
      have hQ := condExp_ae_eq_integral_condExpKernel
        (μ := condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀)
        (m := MeasurableSpace.comap (fun ω => recOf t (E ω)) inferInstance) hrec.comap_le
        (GFF.integrable_exp_I_mul (P := condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀) hXm)
      filter_upwards [hcf φ, hQ, htower, hβeq] with ω h1 h2 h3 h4 _ hfin
      have h1' := h1 hfin
      rw [h4, ← h3, ← h2]
      exact h1'
    · have h0 : condExpKernel P (MeasurableSpace.comap f inferInstance) ω₀ G = 0 := by
        rw [hind, indicator_of_notMem h₀]
      filter_upwards [measure_eq_zero_iff_ae_notMem.1 h0] with ω hω hG'
      exact absurd hG' hω
  have hSae := Sec5.Lemma56Stages.ae_of_ae_condExpKernel h𝒢 hS hker
  filter_upwards [hSae, condExp_ae_eq_integral_condExpKernel (μ := P) h𝒦 hFi] with ω h1 h2 hG' hfin
  rw [h2]
  exact h1 hG' hfin

end InteractingSLE.Theorem14.SB.Mw
