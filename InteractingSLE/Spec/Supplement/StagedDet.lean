/-!
# Theorem 1.4: the retained past of a staged history is determined by the field

Packet PROVE-T14-SB7, item (a1) (first half). For a staged history `E` of a GFF `h` (frozen `IsStagedHistory`, with
`StagedPiecesRegular` as in the version-2 Theorem 1.4 anchors, ruling R51), the retained past before every instruction
`k` (`pastMap`, the map generating the frozen `pastSigma`) is almost surely a Borel function of the field. Hence so
are the states of the run (charts, physical sets, statuses: `run_eq_of_pastMap_eq_of_le`) and, at a launch, the record
of the launched piece (its driver up to its own stop and its lifetime).

The proof is the induction the source performs (Lemma GW1, p. 618–620: "each piece is the flow line of the
conditional field"; the frozen Theorem 1.2 at each stage):

* **`exists_stageField`** (deterministic chart bookkeeping): the field read in the chart of the state after `k`
  instructions has a version measurable for the σ-algebra of the retained past **and the field**
  (`pastFieldSigma`): it is built recursively from the record charts (`recField`) and the recentrings, as in
  PROVE-STAGEDLAW's `stageLaw_succ`;
* **`ae_recOf_eq_stageRec`**: at a launch, under the regular conditional law given the retained past, the launched
  driver is the flow-line driver of that field for the word of the stage (PROVE-STAGEDLAW's invariant), so by the
  parametric Theorem 1.2 (`Theorem12ParamStatement`, allowed for Theorem 1.4) and Theorem 1.3 it is the field-determined
  staged driver `stagedDrv`; the records agree (`retOf_eq_of_agree`, using continuity up to the stop);
* **`exists_pastMap_eq_comp_field`**: induction on `k`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

namespace Theorem14

namespace StagedDet

open LQGMetric Restart Exist Exist.Staged Exist.StagedLaw

/-! ### The retained past together with the field -/

section Sigma

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω]

/-- The σ-algebra generated by the retained past before `k` and the field. -/
@[instance_reducible]
def pastFieldSigma (κ : ℝ) (b : ℝ → ℝ) (jumps : Finset ℝ) (spec : ExplSpec) (E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞)
    (h : Ω → DistOn upperHalfPlaneOpens) (k : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (pastMap κ b jumps spec E k ω, h ω)) inferInstance

variable {spec : ExplSpec} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} {h : Ω → DistOn upperHalfPlaneOpens}

omit mΩ in
theorem pastSigma_le_pastFieldSigma (k : ℕ) :
    pastSigma κ b jumps spec E k ≤ pastFieldSigma κ b jumps spec E h k := by
  rw [pastSigma_eq_comap, pastFieldSigma]
  have e : pastMap κ b jumps spec E k = Prod.fst ∘ fun ω => (pastMap κ b jumps spec E k ω, h ω) := rfl
  rw [e, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono measurable_fst.comap_le

omit mΩ in
theorem measurable_field_pastFieldSigma (k : ℕ) : Measurable[pastFieldSigma κ b jumps spec E h k] h := by
  exact measurable_snd.comp (comap_measurable (fun ω => (pastMap κ b jumps spec E k ω, h ω)))

omit mΩ in
theorem pastFieldSigma_mono {j k : ℕ} (hjk : j ≤ k) :
    pastFieldSigma κ b jumps spec E h j ≤ pastFieldSigma κ b jumps spec E h k := by
  rw [pastFieldSigma, pastFieldSigma]
  set pr : PastData k × DistOn upperHalfPlaneOpens → PastData j × DistOn upperHalfPlaneOpens :=
    fun p => (fun i : Fin j => p.1 (Fin.castLE hjk i), p.2) with hpr
  have hprm : Measurable pr :=
    (measurable_pi_iff.2 fun i => (measurable_pi_apply _).comp measurable_fst).prodMk measurable_snd
  have e : (fun ω => (pastMap κ b jumps spec E j ω, h ω)) =
      pr ∘ fun ω => (pastMap κ b jumps spec E k ω, h ω) := by
    funext ω
    refine Prod.ext (funext fun i => ?_) rfl
    exact pastMap_castLE spec E hjk ω i
  rw [e, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hprm.comap_le

theorem pastFieldSigma_le {k : ℕ} (hpm : Measurable (pastMap κ b jumps spec E k)) (hhm : Measurable h) :
    pastFieldSigma κ b jumps spec E h k ≤ mΩ :=
  (hpm.prodMk hhm).comap_le

end Sigma

/-! ### The stage fields -/

section Field

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {P : Measure Ω} {h : Ω → DistOn upperHalfPlaneOpens} {spec : ExplSpec} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- **A stage field at `k`**: at a launch of instruction `k`, `Y` is the field read in the chart of the state after
`k` instructions (with the flow coefficient), and that chart is conformal with a continuous lift (the path clause of
PROVE-STAGEDLAW's `StageLaw`). -/
def IsStageField (κ : ℝ) (b : ℝ → ℝ) (jumps : Finset ℝ) (P : Measure Ω) (h : Ω → DistOn upperHalfPlaneOpens)
    (spec : ExplSpec) (E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (k : ℕ) (Y : Ω → DistOn upperHalfPlaneOpens) : Prop :=
  ∀ᵐ ω ∂P, (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none →
    (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.IsConformal ∧
    ContinuousOn (fun w => (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.2.2
      ((ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.2.1 w)) QuantumZipper.H ∧
    IsChartTransport (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1 1 0 (QuantumZipper.chiC κ)
      (h ω) (Y ω)

/-- Launched pieces are continuous up to their own stop (the second clause of `StagedPiecesRegular`). -/
def PiecesContinuous (κ : ℝ) (b : ℝ → ℝ) (jumps : Finset ℝ) (P : Measure Ω) (spec : ExplSpec)
    (E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) : Prop :=
  ∀ᵐ ω ∂P, ∀ k, (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none →
    ContinuousOn (E k ω).1 {s | (s : ℝ≥0∞) ≤ min (instrTime spec k) (E k ω).2}

omit [StandardBorelSpace Ω] in
theorem piecesContinuous_of_stagedPiecesRegular (hR : StagedPiecesRegular κ b jumps P spec E) :
    PiecesContinuous κ b jumps P spec E := by
  filter_upwards [hR.ae_pieceRegular] with ω hω k hk
  obtain ⟨⟨c, θ⟩, hcθ⟩ := Option.ne_none_iff_exists'.1 hk
  exact (hω k c θ hcθ).2.1

/-- **The stage fields** (deterministic chart bookkeeping, as in `stageLaw_succ`): for measurable drivers regular at
every sample whose launched pieces are almost surely continuous up to their stops, at every `k` there is a stage field
measurable for the retained past before `k` together with the field. -/
theorem exists_stageField (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hEm : ∀ j, Measurable (E j)) (hreg : ∀ j ω, IsRegularDriver (E j ω))
    (hcont : PiecesContinuous κ b jumps P spec E) :
    ∀ k, ∃ Y : Ω → DistOn upperHalfPlaneOpens, Measurable[pastFieldSigma κ b jumps spec E h k] Y ∧
      IsStageField κ b jumps P h spec E k Y := by
  classical
  have hB := runMeasStatement.{u}
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · refine ⟨fun ω => flowField spec.1 0 (h ω), (measurable_flowField _ _).comp
      (measurable_field_pastFieldSigma (κ := κ) (b := b) (jumps := jumps) (spec := spec) (E := E) 0),
      Eventually.of_forall fun ω _ => ?_⟩
    exact ⟨Chart.isConformal_id.recenter _, Chart.continuousOn_recenter_lift Chart.continuousOn_id_lift,
      isChartTransport_shiftChart _ _ _⟩
  have H : ∀ ℓ, ∃ Y : Ω → DistOn upperHalfPlaneOpens, ℓ < k →
      Measurable[pastFieldSigma κ b jumps spec E h ℓ] Y ∧ IsStageField κ b jumps P h spec E ℓ Y := by
    intro ℓ
    by_cases hℓ : ℓ < k
    · obtain ⟨Y, hY⟩ := ih ℓ hℓ
      exact ⟨Y, fun _ => hY⟩
    · exact ⟨fun _ => 0, fun h' => absurd h' hℓ⟩
  choose Y hY using H
  have hEm' : ∀ j < k, Measurable (E j) := fun j _ => hEm j
  have hreg' : ∀ j < k, ∀ ω, IsRegularDriver (E j ω) := fun j _ => hreg j
  -- the event of the last launch `ℓ`
  set A : ℕ → Set Ω := fun ℓ => {ω | ℓ < k ∧
    (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none ∧
    (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.1 ℓ ≠ none ∧
    ∀ j, ℓ < j → j < k → (ExplState.run κ b jumps spec (fun i => E i ω) (j + 1)).2.2.2.1 j = none} with hAdef
  -- the recentring after piece `ℓ`
  set a : ℕ → Ω → ℝ := fun ℓ ω => ((ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1.1 0 -
    (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.1 0).re with hadef
  -- the field right after piece `ℓ`
  set Zr : ℕ → Ω → DistOn upperHalfPlaneOpens := fun ℓ ω =>
    recField κ (pastMap κ b jumps spec E (ℓ + 1) ω (Fin.last ℓ)) (Y ℓ ω) with hZrdef
  set Yk : Ω → DistOn upperHalfPlaneOpens := finPw A (fun ℓ ω => flowField (a ℓ ω) 0 (Zr ℓ ω)) (fun _ => 0) k
    with hYkdef
  have hdisj : ∀ ℓ ω, ω ∈ A ℓ → ∀ j, j ≠ ℓ → ω ∉ A j := by
    rintro ℓ ω ⟨hℓ, -, hl, hn⟩ j hj ⟨hj', -, hl', hn'⟩
    exact hj (eq_of_last_launch hℓ hj' hl hl' hn hn').symm
  have hcover : ∀ ω, (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none → ∃ ℓ, ω ∈ A ℓ := by
    intro ω hω
    obtain ⟨⟨c, θ⟩, hcθ⟩ := Option.ne_none_iff_exists'.1 hω
    obtain ⟨ℓ, hℓ, ⟨c', θ', hl'⟩, -, hn', -⟩ := exists_last_launch spec (fun j => E j ω) hk hcθ
    exact ⟨ℓ, hℓ, hω, by rw [hl']; simp, hn'⟩
  have hYk : ∀ ℓ ω, ω ∈ A ℓ → Yk ω = flowField (a ℓ ω) 0 (Zr ℓ ω) := fun ℓ ω hω =>
    finPw_eq hω (hdisj ℓ ω hω) k hω.1
  -- measurability for the retained past before `k`
  have hAm : ∀ ℓ < k, MeasurableSet (A ℓ) := by
    intro ℓ hℓ
    have hset : A ℓ = {ω | (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none} ∩
        ({ω | (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.1 ℓ ≠ none} ∩
          ⋂ j ∈ (Finset.range k).filter (ℓ < ·),
            {ω | (ExplState.run κ b jumps spec (fun i => E i ω) (j + 1)).2.2.2.1 j ≠ none}ᶜ) := by
      ext ω
      simp only [hAdef, mem_ofPred_eq, mem_inter_iff, mem_iInter, Finset.mem_filter, Finset.mem_range, mem_compl_iff,
        not_not, hℓ, true_and]
      constructor
      · rintro ⟨h1, h2, h3⟩; exact ⟨h1, h2, fun j hj => h3 j hj.2 hj.1⟩
      · rintro ⟨h1, h2, h3⟩; exact ⟨h1, h2, fun j hj hjk => h3 j ⟨hjk, hj⟩⟩
    rw [hset]
    refine (measurableSet_launch_self hB hb hEm' hreg').inter
      ((measurableSet_launch hB hb spec hEm' hreg' hℓ).inter ?_)
    refine Finset.measurableSet_biInter _ fun j hj => (measurableSet_launch hB hb spec hEm' hreg' ?_).compl
    exact (Finset.mem_range.1 (Finset.mem_filter.1 hj).1)
  have hA𝒢 : ∀ ℓ < k, MeasurableSet[pastSigma κ b jumps spec E k] (A ℓ) := by
    intro ℓ hℓ
    refine measurableSet_pastSigma_of_runs hB hb hEm' hreg' (hAm ℓ hℓ) fun ω ω' he hω => ?_
    obtain ⟨-, hlk, hl, hn⟩ := hω
    refine ⟨hℓ, ?_, ?_, fun j hj hjk => ?_⟩
    · rw [← launches_run_succ_of_run_eq spec (he k le_rfl)]; exact hlk
    · rw [← launches_run_of_lt spec _ hℓ, ← he k le_rfl, launches_run_of_lt spec _ hℓ]; exact hl
    · rw [← launches_run_of_lt spec _ hjk, ← he k le_rfl, launches_run_of_lt spec _ hjk]; exact hn j hj hjk
  have ham : ∀ ℓ < k, Measurable (a ℓ) := fun ℓ hℓ =>
    Complex.measurable_re.comp ((measurable_chart_apply hB hb spec hEm' hreg' (by omega) 0).sub
      (measurable_chart_apply hB hb spec hEm' hreg' le_rfl 0))
  have ha𝒢 : ∀ ℓ < k, Measurable[pastSigma κ b jumps spec E k] (a ℓ) := fun ℓ hℓ =>
    measurable_pastSigma_of_runs hB hb hEm' hreg' (ham ℓ hℓ) fun ω ω' he => by
      simp only [hadef, he (ℓ + 1) (by omega), he k le_rfl]
  have hlast𝒢 : ∀ ℓ < k, Measurable[pastSigma κ b jumps spec E k]
      fun ω => pastMap κ b jumps spec E (ℓ + 1) ω (Fin.last ℓ) := by
    intro ℓ hℓ
    have h1 : Measurable[pastSigma κ b jumps spec E (ℓ + 1)]
        fun ω => pastMap κ b jumps spec E (ℓ + 1) ω (Fin.last ℓ) := by
      rw [pastSigma_eq_comap]
      exact (measurable_pi_apply (X := fun _ : Fin (ℓ + 1) => RecData) (Fin.last ℓ)).comp
        (comap_measurable (pastMap κ b jumps spec E (ℓ + 1)))
    exact h1.mono (pastSigma_mono spec E (by omega)) le_rfl
  have hle : pastSigma κ b jumps spec E k ≤ pastFieldSigma κ b jumps spec E h k := pastSigma_le_pastFieldSigma k
  have hZm : ∀ ℓ < k, Measurable[pastFieldSigma κ b jumps spec E h k] (Zr ℓ) := fun ℓ hℓ => by
    have h1 : Measurable[pastFieldSigma κ b jumps spec E h k]
        fun ω => pastMap κ b jumps spec E (ℓ + 1) ω (Fin.last ℓ) := (hlast𝒢 ℓ hℓ).mono hle le_rfl
    have h2 : Measurable[pastFieldSigma κ b jumps spec E h k] (Y ℓ) :=
      ((hY ℓ hℓ).1).mono (pastFieldSigma_mono hℓ.le) le_rfl
    have e : Zr ℓ = (fun p : RecData × DistOn upperHalfPlaneOpens => recField κ p.1 p.2) ∘
        (fun ω => (pastMap κ b jumps spec E (ℓ + 1) ω (Fin.last ℓ), Y ℓ ω)) := rfl
    rw [e]
    exact (measurable_recField κ).comp (h1.prodMk h2)
  have hFm : ∀ ℓ < k, Measurable[pastFieldSigma κ b jumps spec E h k]
      (fun ω => flowField (a ℓ ω) 0 (Zr ℓ ω)) := fun ℓ hℓ => by
    have h1 : Measurable[pastFieldSigma κ b jumps spec E h k] (a ℓ) := (ha𝒢 ℓ hℓ).mono hle le_rfl
    have e : (fun ω => flowField (a ℓ ω) 0 (Zr ℓ ω)) =
        (fun p : ℝ × DistOn upperHalfPlaneOpens => flowField p.1 0 p.2) ∘ (fun ω => (a ℓ ω, Zr ℓ ω)) := rfl
    rw [e]
    exact measurable_flowField_uncurry.comp (h1.prodMk (hZm ℓ hℓ))
  have hA' : ∀ ℓ < k, MeasurableSet[pastFieldSigma κ b jumps spec E h k] (A ℓ) := fun ℓ hℓ =>
    hle _ (hA𝒢 ℓ hℓ)
  have hYkm : Measurable[pastFieldSigma κ b jumps spec E h k] Yk :=
    measurable_finPw (mα := pastFieldSigma κ b jumps spec E h k) (A := A)
      (F := fun ℓ ω => flowField (a ℓ ω) 0 (Zr ℓ ω)) (d := fun _ => 0) measurable_const k hA' hFm
  refine ⟨Yk, hYkm, ?_⟩
  -- the earlier stages, almost surely for all of them
  have hpathAll : ∀ᵐ ω ∂P, ∀ ℓ, ℓ < k →
      (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.1 ℓ ≠ none →
      (ExplState.run κ b jumps spec (fun j => E j ω) ℓ).2.2.2.2.1.IsConformal ∧
      ContinuousOn (fun w => (ExplState.run κ b jumps spec (fun j => E j ω) ℓ).2.2.2.2.1.2.2
        ((ExplState.run κ b jumps spec (fun j => E j ω) ℓ).2.2.2.2.1.2.1 w)) QuantumZipper.H ∧
      IsChartTransport (ExplState.run κ b jumps spec (fun j => E j ω) ℓ).2.2.2.2.1 1 0 (QuantumZipper.chiC κ)
        (h ω) (Y ℓ ω) := by
    refine ae_all_iff.2 fun ℓ => ?_
    by_cases hℓ : ℓ < k
    · exact (hY ℓ hℓ).2.mono fun ω hω _ => hω
    · exact Eventually.of_forall fun ω h' => absurd h' hℓ
  filter_upwards [hpathAll, hcont] with ω hp hc hω
  obtain ⟨ℓ, hωA⟩ := hcover ω hω
  obtain ⟨hℓ, hlk, hl, hn⟩ := hωA
  obtain ⟨hstop, a₀, ha₀⟩ := last_launch_props hℓ hlk hl hn
  obtain ⟨hconf, hlift, hT⟩ := hp ℓ hℓ hl
  have hregℓ := hreg ℓ ω
  have hgood : LocalExt.IsDrvGood (recHist (recOf (instrTime spec ℓ) (E ℓ ω))) :=
    isDrvGood_of_continuousOn_le hregℓ hstop (hc ℓ hl)
  obtain ⟨⟨c, θ⟩, hcθ⟩ := Option.ne_none_iff_exists'.1 hl
  obtain ⟨-, hrun, -⟩ := eq_launch_of_launches spec _ hcθ
  have hWc : Continuous fun x : ℝ => (retOf (instrTime spec ℓ) (E ℓ ω)).1 x.toNNReal :=
    (continuous_retOf hregℓ hgood).comp continuous_real_toNNReal
  have hW0 : (fun x : ℝ => (retOf (instrTime spec ℓ) (E ℓ ω)).1 x.toNNReal) 0 = 0 := by
    change (E ℓ ω).1 (min (((0 : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) (min (instrTime spec ℓ) (E ℓ ω).2)).toNNReal = 0
    rw [Real.toNNReal_zero, ENNReal.coe_zero, min_eq_left (zero_le (a := min (instrTime spec ℓ) (E ℓ ω).2)),
      ENNReal.toNNReal_zero]
    exact hregℓ.2.1
  have hchart1 : (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1 =
      (ExplState.run κ b jumps spec (fun j => E j ω) ℓ).2.2.2.2.1.loewner
        (fun x : ℝ => (retOf (instrTime spec ℓ) (E ℓ ω)).1 x.toNNReal)
        ((min (instrTime spec ℓ) (E ℓ ω).2).toNNReal : ℝ) := by
    rw [hrun]
    exact chart_launch _ _ _ _ _ hstop
  have hconf1 : (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1.IsConformal := by
    rw [hchart1]; exact hconf.loewner hWc hW0 (NNReal.coe_nonneg _)
  have hlift1 : ContinuousOn (fun w => (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1.2.2
      ((ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1.2.1 w)) QuantumZipper.H := by
    rw [hchart1]; exact hconf.continuousOn_loewner_lift hlift hWc hW0 (NNReal.coe_nonneg _)
  have hT1 : IsChartTransport (ExplState.run κ b jumps spec (fun j => E j ω) (ℓ + 1)).2.2.2.2.1 1 0
      (QuantumZipper.chiC κ) (h ω) (Zr ℓ ω) := by
    rw [hchart1, InteractingSLE.Chart.loewner_eq_trans, ← recChart_eq_loewner hregℓ hgood]
    have hZ : Zr ℓ ω = recField κ (recOf (instrTime spec ℓ) (E ℓ ω)) (Y ℓ ω) := by
      simp only [hZrdef, pastMap_last_of_launch hl]
    rw [hZ]
    exact IsChartTransport.trans hconf (isConformal_recChart _) hlift (continuousOn_recChart_lift _) hT
      (isChartTransport_recField κ _ _)
  have haω : a ℓ ω = a₀ := by
    simp only [hadef, ha₀, InteractingSLE.Chart.recenter, sub_sub_cancel, Complex.ofReal_re]
  rw [ha₀]
  refine ⟨hconf1.recenter a₀, Chart.continuousOn_recenter_lift hlift1, ?_⟩
  rw [hYk ℓ ω ⟨hℓ, hlk, hl, hn⟩, haω, Chart.recenter_eq_trans]
  exact IsChartTransport.trans hconf1 (isConformal_shiftChart a₀) hlift1 (continuousOn_shiftChart_lift a₀) hT1
    (isChartTransport_shiftChart a₀ _ _)

/-! ### Records of drivers that agree before their lifetime -/

/-- **Two regular drivers with the same lifetime that agree before it have the same retained datum** for the own time
`t`, when the first is continuous up to its stop (the second then has the same left limit at a finite lifetime). -/
theorem retOf_eq_of_agree {t : ℝ≥0∞} {e e' : (ℝ≥0 → ℝ) × ℝ≥0∞} (he : IsRegularDriver e)
    (he' : IsRegularDriver e') (hc : ContinuousOn e.1 {s | (s : ℝ≥0∞) ≤ min t e.2}) (hζ : e'.2 = e.2)
    (hagree : ∀ s : ℝ≥0, (s : ℝ≥0∞) < e.2 → e'.1 s = e.1 s) : retOf t e' = retOf t e := by
  have hval : ∀ s : ℝ≥0, (s : ℝ≥0∞) ≤ min t e.2 → e'.1 s = e.1 s := by
    intro s hs
    rcases lt_or_eq_of_le (hs.trans (min_le_right _ _)) with hlt | heq
    · exact hagree s hlt
    rcases eq_or_ne s 0 with rfl | hs0
    · rw [he'.2.1, he.2.1]
    have hne : e.2 ≠ ⊤ := heq ▸ ENNReal.coe_ne_top
    have hpos : 0 < e.2 := heq ▸ ENNReal.coe_pos.2 (pos_iff_ne_zero.2 hs0)
    have hsζ : e.2.toNNReal = s := by rw [← heq, ENNReal.toNNReal_coe]
    have ht : Tendsto e.1 (𝓝[<] s) (𝓝 (e.1 s)) := by
      refine (hc s hs).tendsto.mono_left (nhdsWithin_mono _ fun r (hr : r < s) => ?_)
      exact (ENNReal.coe_le_coe.2 hr.le).trans hs
    have ht' : Tendsto e'.1 (𝓝[<] s) (𝓝 (e.1 s)) := by
      refine ht.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with r (hr : r < s)
      exact (hagree r (heq ▸ ENNReal.coe_lt_coe.2 hr)).symm
    have hfin : e'.2 ≠ ⊤ := hζ ▸ hne
    have hpos' : 0 < e'.2 := hζ ▸ hpos
    have key := he'.2.2.2 hfin hpos' (e.1 s) (by rw [hζ, hsζ]; exact ht')
    rwa [hζ, hsζ] at key
  change ((fun r : ℝ≥0 => e'.1 (min (r : ℝ≥0∞) (min t e'.2)).toNNReal), min t e'.2, decide (e'.2 ≤ t)) =
    ((fun r : ℝ≥0 => e.1 (min (r : ℝ≥0∞) (min t e.2)).toNNReal), min t e.2, decide (e.2 ≤ t))
  rw [hζ]
  refine Prod.ext (funext fun r => hval _ ?_) rfl
  rw [ENNReal.coe_toNNReal (ne_top_of_le_ne_top ENNReal.coe_ne_top (min_le_left _ _))]
  exact min_le_right _ _

/-! ### The field-determined record of a stage -/

/-- **The field-determined record of a stage**: from the retained past `x` (read through the boundary word `Wd x` of
the stage) and the stage field `f`, the record for own time `t` of the field-determined staged driver `stagedDrv` of
the angle-`θ` flow line (the field `f` translated by `θ χ`). -/
def stageRec (h12p : Theorem12ParamStatement.{u}) {κ : ℝ} (hκ : 0 < κ) {R : Type*} (Wd : R → BoundaryWord)
    (θ : ℝ) (t : ℝ≥0∞) (x : R) (f : DistOn upperHalfPlaneOpens) : RecData :=
  recOf t (stagedDrv h12p hκ (fun x => flowLineNL (Wd x).fn (Wd x).jumps 0)
    (fun x => flowLineNR (Wd x).fn (Wd x).jumps 0) (fun x => padFL κ θ (Wd x).fn (Wd x).jumps) x
    (flowField 0 (θ * QuantumZipper.chiC κ) f))

theorem measurable_stageRec (h12p : Theorem12ParamStatement.{u}) {κ : ℝ} (hκ : 0 < κ) {R : Type*}
    [MeasurableSpace R] {Wd : R → BoundaryWord} (hWd : Measurable Wd) (θ : ℝ) (t : ℝ≥0∞) :
    Measurable fun p : R × DistOn upperHalfPlaneOpens => stageRec h12p hκ Wd θ t p.1 p.2 := by
  have hnL : Measurable fun x => flowLineNL (Wd x).fn (Wd x).jumps 0 := wordMeasStatement.1.comp hWd
  have hnR : Measurable fun x => flowLineNR (Wd x).fn (Wd x).jumps 0 := wordMeasStatement.2.1.comp hWd
  have hpw : Measurable fun x => padFL κ θ (Wd x).fn (Wd x).jumps := (wordMeasStatement.2.2 κ θ).comp hWd
  set D : R × DistOn upperHalfPlaneOpens → (ℝ≥0 → ℝ) × ℝ≥0∞ := fun p =>
    stagedDrv h12p hκ (fun x => flowLineNL (Wd x).fn (Wd x).jumps 0) (fun x => flowLineNR (Wd x).fn (Wd x).jumps 0)
      (fun x => padFL κ θ (Wd x).fn (Wd x).jumps) p.1 (flowField 0 (θ * QuantumZipper.chiC κ) p.2) with hD
  have h1 : Measurable D := (measurable_stagedDrv h12p hκ hnL hnR hpw).comp
    (measurable_fst.prodMk ((measurable_flowField 0 (θ * QuantumZipper.chiC κ)).comp measurable_snd))
  have h2 : ∀ p, IsRegularDriver (D p) := fun p => stagedDrv_regular h12p hκ _ _ _ _ _
  have e : (fun p : R × DistOn upperHalfPlaneOpens => stageRec h12p hκ Wd θ t p.1 p.2) =
      fun p => recOf t (D p) := rfl
  rw [e]
  exact measurable_recOf h1 h2 t

end Field

/-! ### The record of a launched piece is the field-determined record -/

section Kernel

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {P : Measure Ω} [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens} {spec : ExplSpec}
  {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- **At a launch, the record of the piece is the field-determined record of the stage.** For a staged history with
drivers regular at every sample and pieces continuous up to their stops, and a measurable stage field `Y` at `k`, there
is a Borel boundary word `Wd` of the retained past such that almost surely, at a launch of `k`, the record of the
launched driver is `stageRec Wd θ_k t_k (past, Y)`. Inputs: the parametric Theorem 1.2 and Theorem 1.3 (applied under
the regular conditional law given the retained past, where the piece is the flow line of `Y` for the word of the stage,
PROVE-STAGEDLAW's invariant). -/
theorem ae_recOf_eq_stageRec (h12p : Theorem12ParamStatement.{u}) (h13 : Theorem13Statement.{u}) (hκ : 0 < κ)
    (hκ4 : κ < 4) (hb : IsPiecewiseConstantBoundaryData b jumps) (hh : IsGFFWithBoundaryData P h b jumps)
    (hE : IsStagedHistory κ b jumps P h spec E) (hreg : ∀ j ω, IsRegularDriver (E j ω))
    (hcont : PiecesContinuous κ b jumps P spec E) (k : ℕ) {Y : Ω → DistOn upperHalfPlaneOpens}
    (hYm : Measurable Y) (hY : IsStageField κ b jumps P h spec E k Y) :
    ∃ Wd : PastData k → BoundaryWord, Measurable Wd ∧
      ∀ᵐ ω ∂P, (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none →
        recOf (instrTime spec k) (E k ω) =
          stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω) (Y ω) := by
  have hB := runMeasStatement.{u}
  obtain ⟨βA, hβA⟩ := stopLawStatement.{u} κ hκ hκ4
  obtain ⟨β, Yw, hβ, hYw, hpw, hker⟩ := stageLaw hβA hB hκ hb hh k (fun j _ => hE.1 j) (fun j _ => hreg j)
    (fun j _ => hE.2.2.2 j)
  have hpm : Measurable (pastMap κ b jumps spec E k) :=
    measurable_pastMap hB hb spec (fun j _ => hE.1 j) (fun j _ => hreg j) k le_rfl
  have h𝒢 : pastSigma κ b jumps spec E k ≤ mΩ := by rw [pastSigma_eq_comap]; exact hpm.comap_le
  obtain ⟨Wd, hWdm, hβW⟩ : ∃ Wd : PastData k → BoundaryWord, Measurable Wd ∧
      β = Wd ∘ pastMap κ b jumps spec E k := by
    rw [pastSigma_eq_comap] at hβ
    exact hβ.exists_eq_measurable_comp
  refine ⟨Wd, hWdm, ?_⟩
  set L : Set Ω := {ω | (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none} with hLdef
  have hLm : MeasurableSet L := measurableSet_launch_self hB hb (fun j _ => hE.1 j) (fun j _ => hreg j)
  have h1G : Measurable fun ω => recOf (instrTime spec k) (E k ω) := measurable_recOf (hE.1 k) (hreg k) _
  have h2G : Measurable fun ω =>
      stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω) (Y ω) := by
    have e : (fun ω => stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω)
        (Y ω)) = (fun p : PastData k × DistOn upperHalfPlaneOpens =>
          stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) p.1 p.2) ∘
        (fun ω => (pastMap κ b jumps spec E k ω, Y ω)) := rfl
    rw [e]
    exact (measurable_stageRec h12p hκ hWdm _ _).comp (hpm.prodMk hYm)
  have hGm := measurableSet_eq_fun h1G h2G
  set G : Set Ω := {ω | recOf (instrTime spec k) (E k ω) =
    stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω) (Y ω)} with hGdef
  suffices key : ∀ᵐ ω ∂P, ω ∈ Lᶜ ∪ G by
    filter_upwards [key] with ω hω hl
    rcases hω with hω | hω
    · exact absurd hl hω
    · exact hω
  refine Sec5.Lemma56Stages.ae_of_ae_condExpKernel h𝒢 (hLm.compl.union hGm) ?_
  filter_upwards [hE.2.2.2 k, hY, hker, Sec7.Aux122Disint.ae_ae_condExpKernel h𝒢 hY,
    Sec7.Aux122Disint.ae_ae_condExpKernel h𝒢 hpw, Sec7.Aux122Disint.ae_ae_condExpKernel h𝒢 hcont,
    ae_ae_run_eq hB hb spec (k := k) (fun j _ => hE.1 j) (fun j _ => hreg j) (P := P)]
    with ω₀ hstg hp₀ hk₀ hpK hpwK hcK hrunK
  by_cases hl : ω₀ ∈ L
  swap
  · filter_upwards [hrunK] with ω hrω
    refine Or.inl fun hlω => hl ?_
    change (ExplState.run κ b jumps spec (fun j => E j ω₀) (k + 1)).2.2.2.1 k ≠ none
    rw [← launches_run_succ_of_run_eq spec hrω]
    exact hlω
  obtain ⟨⟨c, θ⟩, hcθ⟩ := Option.ne_none_iff_exists'.1 hl
  obtain ⟨hspec, -, hc⟩ := eq_launch_of_launches spec _ hcθ
  have hθ : instrAngle spec k = θ := by unfold instrAngle; rw [hspec]
  obtain ⟨b', J', h', hb', hT', hfl⟩ := hstg c θ hcθ
  obtain ⟨hconf, hlift, -⟩ := hp₀ hl
  rw [← hc] at hconf hlift
  have hgT : ∀ ω, IsChartTransport c 1 0 (QuantumZipper.chiC κ) (h ω)
      (Chart.chartTransport hconf 1 0 (QuantumZipper.chiC κ) (h ω)) := fun ω =>
    Chart.isChartTransport_chartTransport hconf (Chart.locallyIntegrableOn_of_continuousOn hlift) 1 0 _ (h ω)
  have hh'e : h' = fun ω => Chart.chartTransport hconf 1 0 (QuantumZipper.chiC κ) (h ω) :=
    funext fun ω => (hT' ω).unique hconf (hgT ω)
  have hh'm : Measurable h' := by
    rw [hh'e]; exact (Chart.measurable_chartTransport hconf 1 0 _).comp hh.1
  have hfield : ∀ (Z : Ω → DistOn upperHalfPlaneOpens), IsStageField κ b jumps P h spec E k Z →
      (∀ᵐ ω ∂(condExpKernel P (pastSigma κ b jumps spec E k) ω₀),
        (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none →
        (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.IsConformal ∧
        ContinuousOn (fun w => (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.2.2
          ((ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1.2.1 w)) QuantumZipper.H ∧
        IsChartTransport (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.2.2.1 1 0 (QuantumZipper.chiC κ)
          (h ω) (Z ω)) →
      ∀ᵐ ω ∂(condExpKernel P (pastSigma κ b jumps spec E k) ω₀), Z ω = h' ω := by
    intro Z _ hZK
    filter_upwards [hZK, hrunK] with ω hpω hrω
    have hlω : (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none := by
      rw [launches_run_succ_of_run_eq spec hrω]; exact hl
    obtain ⟨-, -, hT⟩ := hpω hlω
    rw [hrω, ← hc] at hT
    exact hT.unique hconf (hT' ω)
  have hYh' := hfield Y hY hpK
  have hYwh' := hfield Yw hpw hpwK
  have hG : IsGFFWithBoundaryData (condExpKernel P (pastSigma κ b jumps spec E k) ω₀) h' (β ω₀).fn
      (β ω₀).jumps := isGFFWithBoundaryData_congr_ae (hk₀ hl) hh'm hYwh'
  obtain ⟨h'', 𝓕, VL, VR, B, htr, hC⟩ := isFlowLineDriver_word hκ hG hb' hfl
  have hh'' : h'' = fun ω => flowField 0 (θ * QuantumZipper.chiC κ) (h' ω) := by
    funext ω
    ext φ
    have e1 := htr ω φ φ (fun z => by rw [Complex.ofReal_zero, add_zero])
    have e2 := isTranslateAddConst_flowField 0 (θ * QuantumZipper.chiC κ) (h' ω) φ φ
      (fun z => by rw [Complex.ofReal_zero, add_zero])
    rw [e1, e2]
  have hF := Theorem15.isOrderedForceWord_flowLine (β ω₀).fn (β ω₀).jumps 0
  have hΦ := (h12p κ hκ (flowLineNL (β ω₀).fn (β ω₀).jumps 0) (flowLineNR (β ω₀).fn (β ω₀).jumps 0)).choose_spec.2
    _ _ _ _ hF hC
  have hdet := ae_detCode_eq hκ hF h13 hC hΦ
  filter_upwards [hdet, hYh', hcK, hrunK] with ω hdω hYω hcω hrω
  refine Or.inr ?_
  obtain ⟨x₀, hx₀, hζx, hagx, hdx⟩ := hdω
  have hlω : (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none := by
    rw [launches_run_succ_of_run_eq spec hrω]; exact hl
  have hpω : pastMap κ b jumps spec E k ω = pastMap κ b jumps spec E k ω₀ := by
    unfold pastMap; rw [hrω]
  have hx : Wd (pastMap κ b jumps spec E k ω) = β ω₀ := by
    rw [hpω]; exact (congrFun hβW ω₀).symm
  have hdx' : detCode (paramΦ h12p hκ (flowLineNL (β ω₀).fn (β ω₀).jumps 0) (flowLineNR (β ω₀).fn (β ω₀).jumps 0))
      (((flowLineXL (β ω₀).fn (β ω₀).jumps 0, flowLineXR (β ω₀).fn (β ω₀).jumps 0),
        flowLineRhoL κ (β ω₀).fn (β ω₀).jumps 0 θ, flowLineRhoR κ (β ω₀).fn (β ω₀).jumps 0 θ),
        flowField 0 (θ * QuantumZipper.chiC κ) (Y ω)) = dOf x₀ := by
    rw [hYω, ← congrFun hh'' ω]; exact hdx
  set D := stagedDrv h12p hκ (fun x => flowLineNL (Wd x).fn (Wd x).jumps 0)
    (fun x => flowLineNR (Wd x).fn (Wd x).jumps 0) (fun x => padFL κ (instrAngle spec k) (Wd x).fn (Wd x).jumps)
    (pastMap κ b jumps spec E k ω) (flowField 0 (instrAngle spec k * QuantumZipper.chiC κ) (Y ω)) with hDdef
  have hDreg : IsRegularDriver D := stagedDrv_regular h12p hκ _ _ _ _ _
  have hD : D = (drvPath (dOf x₀), (dOf x₀).1) := by
    rw [hDdef]
    unfold stagedDrv
    beta_reduce
    rw [hx, hθ, truncWord_padFL, hdx', drvOf_of_mem (dOf_mem_DSet hx₀)]
  have hret : retOf (instrTime spec k) D = retOf (instrTime spec k) (E k ω) := by
    refine retOf_eq_of_agree (hreg k ω) hDreg (hcω k hlω) ?_ fun s hs => ?_
    · rw [hD]; exact hζx
    · rw [hD]
      exact ((drvPath_dOf_agree x₀).2 s (hζx ▸ hs)).trans (hagx s hs).1
  change readRec (retOf (instrTime spec k) (E k ω)) = readRec (retOf (instrTime spec k) D)
  rw [hret]

end Kernel

/-! ### The induction -/

section Main

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {P : Measure Ω} [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens} {spec : ExplSpec}
  {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- **The retained past is a Borel function of the field**, for drivers regular at every sample whose launched
pieces are almost surely continuous up to their stops. -/
theorem exists_pastMap_eq_comp_field_of_regular (h12p : Theorem12ParamStatement.{u})
    (h13 : Theorem13Statement.{u}) (hκ : 0 < κ) (hκ4 : κ < 4) (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hh : IsGFFWithBoundaryData P h b jumps) (hE : IsStagedHistory κ b jumps P h spec E)
    (hreg : ∀ j ω, IsRegularDriver (E j ω)) (hcont : PiecesContinuous κ b jumps P spec E) :
    ∀ k, ∃ f : DistOn upperHalfPlaneOpens → PastData k, Measurable f ∧
      pastMap κ b jumps spec E k =ᵐ[P] f ∘ h := by
  have hB := runMeasStatement.{u}
  intro k
  induction k with
  | zero =>
    exact ⟨fun _ i => i.elim0, measurable_const, Eventually.of_forall fun ω => funext fun i => i.elim0⟩
  | succ k ih =>
  obtain ⟨f, hfm, hf⟩ := ih
  have hEm' : ∀ j < k, Measurable (E j) := fun j _ => hE.1 j
  have hreg' : ∀ j < k, ∀ ω, IsRegularDriver (E j ω) := fun j _ => hreg j
  have hpm : Measurable (pastMap κ b jumps spec E k) := measurable_pastMap hB hb spec hEm' hreg' k le_rfl
  have hle := pastFieldSigma_le (κ := κ) (b := b) (jumps := jumps) (spec := spec) (E := E) (k := k) hpm hh.1
  obtain ⟨Y, hYm, hY⟩ := exists_stageField hb hE.1 hreg hcont k
  obtain ⟨Wd, hWdm, hrec⟩ := ae_recOf_eq_stageRec h12p h13 hκ hκ4 hb hh hE hreg hcont k (hYm.mono hle le_rfl) hY
  -- the stage record, as a Borel function of the past and the field
  have hRm : Measurable[MeasurableSpace.comap (fun ω => (pastMap κ b jumps spec E k ω, h ω)) inferInstance]
      fun ω => stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω) (Y ω) := by
    have hpm' : Measurable[pastFieldSigma κ b jumps spec E h k] (pastMap κ b jumps spec E k) :=
      (comap_measurable _).mono (pastSigma_le_pastFieldSigma k) le_rfl
    have e : (fun ω => stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) (pastMap κ b jumps spec E k ω)
        (Y ω)) = (fun p : PastData k × DistOn upperHalfPlaneOpens =>
          stageRec h12p hκ Wd (instrAngle spec k) (instrTime spec k) p.1 p.2) ∘
        (fun ω => (pastMap κ b jumps spec E k ω, Y ω)) := rfl
    rw [e]
    exact (measurable_stageRec h12p hκ hWdm _ _).comp (hpm'.prodMk hYm)
  obtain ⟨ρ, hρm, hρ⟩ := hRm.exists_eq_measurable_comp
  -- the launch event, as an event of the past
  have hL : MeasurableSet[pastSigma κ b jumps spec E k]
      {ω | (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none} :=
    measurableSet_pastSigma_of_runs hB hb hEm' hreg' (measurableSet_launch_self hB hb hEm' hreg')
      fun ω ω' he hω => by
        change (ExplState.run κ b jumps spec (fun j => E j ω') (k + 1)).2.2.2.1 k ≠ none
        rw [← launches_run_succ_of_run_eq spec (he k le_rfl)]
        exact hω
  rw [pastSigma_eq_comap] at hL
  obtain ⟨Λ, hΛm, hΛ⟩ := MeasurableSpace.measurableSet_comap.1 hL
  classical
  set nr : PastData k × DistOn upperHalfPlaneOpens → RecData := fun p =>
    if p.1 ∈ Λ then ρ p else readRec (fun _ => 0, 0, false) with hnr
  have hnrm : Measurable nr := Measurable.ite (hΛm.preimage measurable_fst) hρm measurable_const
  refine ⟨fun g => Fin.snoc (α := fun _ => RecData) (f g) (nr (f g, g)),
    measurable_snoc hfm (hnrm.comp (hfm.prodMk measurable_id)), ?_⟩
  filter_upwards [hf, hrec] with ω hfω hrecω
  have hfω' : pastMap κ b jumps spec E k ω = f (h ω) := hfω
  have hmem : (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none ↔
      pastMap κ b jumps spec E k ω ∈ Λ := by
    rw [← mem_preimage, hΛ]; rfl
  change pastMap κ b jumps spec E (k + 1) ω = Fin.snoc (α := fun _ => RecData) (f (h ω)) (nr (f (h ω), h ω))
  rw [pastMap_succ, readRec_retained_succ, hfω']
  congr 1
  by_cases hl : (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k = none
  · have hn : f (h ω) ∉ Λ := fun hΛω => (hmem.2 (hfω' ▸ hΛω)) hl
    rw [hnr]
    simp only [hl, hn, ↓reduceIte]
  · have hy : f (h ω) ∈ Λ := hfω' ▸ hmem.1 hl
    rw [hnr]
    simp only [hl, hy, ↓reduceIte]
    rw [hrecω hl, ← hfω']
    exact congrFun hρ ω

omit [StandardBorelSpace Ω] [IsProbabilityMeasure P] in
/-- The regularized history of a `StagedPiecesRegular` family has launched pieces continuous up to their stops. -/
theorem piecesContinuous_regHist (hR : StagedPiecesRegular κ b jumps P spec E) :
    PiecesContinuous κ b jumps P spec (StagedReg.regHist spec E) := by
  filter_upwards [hR.ae_pieceRegular, StagedReg.ae_run_regHist hR] with ω hω hrun k hk
  rw [hrun (k + 1)] at hk
  obtain ⟨⟨c, θ⟩, hcθ⟩ := Option.ne_none_iff_exists'.1 hk
  obtain ⟨h0, hc, -⟩ := hω k c θ hcθ
  have hcan := StagedReg.canonDrv_regularize h0 hc
  have hζ : (StagedReg.regHist spec E k ω).2 = (E k ω).2 := StagedReg.regHist_snd k ω
  rw [hζ]
  refine hc.congr fun s (hs : (s : ℝ≥0∞) ≤ min (instrTime spec k) (E k ω).2) => ?_
  have e1 := congrArg (fun D : (ℝ≥0 → ℝ) × ℝ≥0∞ => D.1 s) hcan
  simp only [canonDrv, StagedReg.regularize_snd] at e1
  rw [min_eq_left hs, ENNReal.toNNReal_coe] at e1
  exact e1

/-- **Theorem 1.4, (a1): the retained past of a staged history is a Borel function of the field.** For a staged
history `E` (frozen `IsStagedHistory`) of a GFF with piecewise-constant data, `0 < κ < 4`, which is
`StagedPiecesRegular` (ruling R51), the retained past before every instruction `k` is almost surely `f_k(h)` for a Borel
`f_k`. Inputs: the parametric Theorem 1.2 (`Theorem12ParamStatement`) and Theorem 1.3. -/
theorem exists_pastMap_eq_comp_field (h12p : Theorem12ParamStatement.{u}) (h13 : Theorem13Statement.{u})
    (hκ : 0 < κ) (hκ4 : κ < 4) (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hh : IsGFFWithBoundaryData P h b jumps) (hE : IsStagedHistory κ b jumps P h spec E)
    (hR : StagedPiecesRegular κ b jumps P spec E) (k : ℕ) :
    ∃ f : DistOn upperHalfPlaneOpens → PastData k, Measurable f ∧ pastMap κ b jumps spec E k =ᵐ[P] f ∘ h := by
  obtain ⟨f, hfm, hf⟩ := exists_pastMap_eq_comp_field_of_regular h12p h13 hκ hκ4 hb hh
    (StagedReg.isStagedHistory_regHist hb hE hR) (StagedReg.isRegularDriver_regHist (spec := spec) (E := E))
    (piecesContinuous_regHist hR) k
  exact ⟨f, hfm, (StagedReg.ae_pastMap_regHist hR k).symm.trans hf⟩

/-- **The record of a launched piece is a Borel function of the field** (the driver up to its own stop and its
lifetime, `recOf`). -/
theorem exists_recOf_eq_comp_field (h12p : Theorem12ParamStatement.{u}) (h13 : Theorem13Statement.{u})
    (hκ : 0 < κ) (hκ4 : κ < 4) (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hh : IsGFFWithBoundaryData P h b jumps) (hE : IsStagedHistory κ b jumps P h spec E)
    (hR : StagedPiecesRegular κ b jumps P spec E) (k : ℕ) :
    ∃ g : DistOn upperHalfPlaneOpens → RecData, Measurable g ∧
      ∀ᵐ ω ∂P, (ExplState.run κ b jumps spec (fun j => E j ω) (k + 1)).2.2.2.1 k ≠ none →
        recOf (instrTime spec k) (E k ω) = g (h ω) := by
  obtain ⟨f, hfm, hf⟩ := exists_pastMap_eq_comp_field h12p h13 hκ hκ4 hb hh hE hR (k + 1)
  refine ⟨fun x => f x (Fin.last k), (measurable_pi_apply _).comp hfm, ?_⟩
  filter_upwards [hf] with ω hω hl
  rw [← pastMap_last_of_launch hl]
  exact congrFun hω (Fin.last k)

