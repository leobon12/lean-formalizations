import InteractingSLE.Spec.Supplement.SB2QtCore
import InteractingSLE.Spec.Supplement.GW1ActiveLaw

/-!
# The single-stage law at a piece's lifetime, given the marks and the piece's record

Worker REVIEW-FABLE-T14 (the induction step of SB2(2)'s retained-law induction; orchestrator split of
PROVE-SB2-LCMEAN's handoff R13.8, item 3).

The step from stage `ℓ` to the next launching stage starts from the retained law at `ℓ` and the conditional half at
`ℓ`: under the regular conditional law given the marks, the canonical relative driver of `B`'s piece `ℓ` is the
angle-`θ` flow-line driver of the canonical chart field with the retained word. The single-stage law
(`Exist.StagedLaw.IsStopLaw`, proved: `GW1W.isStopLaw_stopWord`) then gives, under that conditional law and given the
piece's record at its lifetime, the law of the field read in the chart after the piece. Here it is moved to `P`,
given the marks joined with the record (the marks generated by a map into a standard Borel space):

* **`ae_condExp_recField_eq_gaussCF`**: almost surely on the marks' event `L` and on a finite lifetime,
  `P[exp(i ⟨recField κ (record) Y, φ⟩) | σ(p, record)] = gaussCF (stopWord κ (β, θ, record)) φ`.

This is `Exist.StagedLaw.post_stage`'s passage from the kernel to `P` for an arbitrary mark map `p` and driver `e`,
instead of a staged history's retained past and own piece.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal
open QuantumZipper (H chiC)
open LQGMetric (DistOn TestOn)

universe u

namespace InteractingSLE.Theorem14.SB.Qt

open Restart Exist Exist.Staged Exist.StagedLaw

/-- **The single-stage law at a piece's lifetime, at the `P` level.** Let `p : Ω → S` (standard Borel) generate the
marks, `β` a word measurable for them, `L` an event of them, `Y` a measurable field and `e` a measurable driver
regular at every sample. If, for almost every `ω₀ ∈ L`, under `condExpKernel P (comap p) ω₀` the driver `e` is the
angle-`θ` flow-line driver of `Y` with the data of `β ω₀`, then almost surely on `L` and on a finite lifetime, given
the marks joined with the record of the piece at its lifetime, the field read in the chart after the piece has the
characteristic functional of `stopWord κ (β, θ, record)`. -/
theorem ae_condExp_recField_eq_gaussCF {κ : ℝ} (hκ : 0 < κ) {Ω : Type u} [mΩ : MeasurableSpace Ω]
    [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {S : Type*} [MeasurableSpace S]
    [StandardBorelSpace S] {p : Ω → S} (hp : Measurable p) {β : Ω → BoundaryWord}
    (hβ : Measurable[MeasurableSpace.comap p inferInstance] β) {Y : Ω → DistOn upperHalfPlaneOpens}
    (hY : Measurable Y) {e : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} (he : Measurable e) (hreg : ∀ ω, IsRegularDriver (e ω))
    {θ : ℝ} {L : Set Ω} (hL : MeasurableSet[MeasurableSpace.comap p inferInstance] L)
    (hfl : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → IsFlowLineDriver κ (β ω₀).fn (β ω₀).jumps θ
      (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀) Y (fun t ω => (e ω).1 t) (fun ω => (e ω).2))
    (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂P, ω ∈ L → (e ω).2 ≠ ⊤ →
      P[fun ω' => Complex.exp (Complex.I * (recField κ (recOf ⊤ (e ω')) (Y ω') φ : ℂ)) |
        MeasurableSpace.comap (fun ω => (p ω, recOf ⊤ (e ω))) inferInstance] ω =
        gaussCF (stopWord κ (β ω, θ, recOf ⊤ (e ω))) φ := by
  have hβA := GW1W.isStopLaw_stopWord.{u} hκ
  obtain ⟨Wβ, hWβ, hβW⟩ : ∃ Wβ : S → BoundaryWord, Measurable Wβ ∧ β = Wβ ∘ p :=
    hβ.exists_eq_measurable_comp
  have hRm : Measurable fun ω => recOf ⊤ (e ω) := measurable_recOf he hreg ⊤
  have hXm : Measurable fun ω' => Complex.exp (Complex.I * (recField κ (recOf ⊤ (e ω')) (Y ω') φ : ℂ)) :=
    GFF.measurable_exp_I_mul ((LQGMetric.measurable_distOn_apply φ).comp (measurable_recField_comp κ hRm hY))
  have hGm : Measurable fun x : S × RecData => gaussCF (stopWord κ (Wβ x.1, θ, x.2)) φ :=
    (measurable_gaussCF φ).comp ((measurable_stopWord κ).comp ((hWβ.comp measurable_fst).prodMk
      (measurable_const.prodMk measurable_snd)))
  have hrec2 : ∀ ω, (recOf ⊤ (e ω)).2.1 = (e ω).2 := fun ω => by
    show min ⊤ (e ω).2 = (e ω).2
    exact min_eq_right le_top
  have hN : MeasurableSet {r : RecData | r.2.1 ≠ ⊤} :=
    (measurableSet_eq_fun (measurable_fst.comp measurable_snd) measurable_const).compl
  have hk : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → ∀ᵐ ω ∂(condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀),
      recOf ⊤ (e ω) ∈ {r : RecData | r.2.1 ≠ ⊤} →
      (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀)[fun ω' => Complex.exp (Complex.I *
        (recField κ (recOf ⊤ (e ω')) (Y ω') φ : ℂ)) | MeasurableSpace.comap (fun ω => recOf ⊤ (e ω)) inferInstance] ω =
        gaussCF (stopWord κ (Wβ (p ω₀), θ, recOf ⊤ (e ω))) φ := by
    filter_upwards [hfl] with ω₀ hfl₀ hL₀
    obtain ⟨-, hcf⟩ := hβA.2.2 (β ω₀) θ ⊤ (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀) Y e he hreg
      (hfl₀ hL₀)
    filter_upwards [hcf φ] with ω hω hRN
    have hfin : min (⊤ : ℝ≥0∞) (e ω).2 ≠ ⊤ := by
      rw [min_eq_right le_top, ← hrec2 ω]
      exact hRN
    rw [hω hfin, hβW]
    rfl
  have key := ae_condExp_eq_of_condExpKernel (P := P) hp hRm (π := fun ω => (p ω, recOf ⊤ (e ω)))
    (hp.prodMk hRm) (Φ := id) measurable_id (Ψ := id) measurable_id (fun ω => rfl) hL
    (fun ω _ => ⟨rfl, rfl⟩) hN hXm (fun ω => (Complex.norm_exp_I_mul_ofReal _).le) hGm
    (fun x => norm_gaussCF_le _ φ) hk
  filter_upwards [key] with ω hω hL' hfin
  have hfin' : recOf ⊤ (e ω) ∈ {r : RecData | r.2.1 ≠ ⊤} := by
    show (recOf ⊤ (e ω)).2.1 ≠ ⊤
    rw [hrec2 ω]
    exact hfin
  rw [hω hL' hfin', hβW]
  rfl

end InteractingSLE.Theorem14.SB.Qt
