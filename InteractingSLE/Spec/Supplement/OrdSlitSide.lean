/-- A point of the active domain is off both prefixes. -/
theorem notMem_of_mem_activeDomain {α β : ℝ≥0 → ℂ} {a b : ℝ≥0} {z : ℂ} (hz : z ∈ activeDomain α a β b) :
    z ∈ H ∧ z ∉ α '' Icc 0 a ∧ z ∉ β '' Icc 0 b :=
  ⟨hz.1.1, fun h => hz.1.2 (Or.inl h), fun h => hz.1.2 (Or.inr h)⟩

/-- **A Loewner trace has non-real points in every open time interval of `[0, t]`** (strict growth of the hulls,
`IsLoewnerTrace.exists_mem_diff`). -/
theorem exists_im_ne_zero_of_lt {W : ℝ → ℝ} {η : ℝ → ℂ} (hη : IsLoewnerTrace W η) (hW : Continuous W)
    (hW0 : W 0 = 0) {t : ℝ} {a b : ℝ} (hab : a < b) (hsub : Ioo a b ⊆ Icc 0 t) :
    ∃ s ∈ Ioo a b, (η s).im ≠ 0 := by
  have ha : 0 ≤ a := by
    by_contra hneg
    push Not at hneg
    have hm : min (a / 2) ((a + b) / 2) ∈ Ioo a b :=
      ⟨lt_min (by linarith) (by linarith), (min_le_right _ _).trans_lt (by linarith)⟩
    have h0 := (hsub hm).1
    have : min (a / 2) ((a + b) / 2) ≤ a / 2 := min_le_left _ _
    linarith
  obtain ⟨s, hs, hsK⟩ := hη.exists_mem_diff hW hW0 ha (show a < (a + b) / 2 by linarith)
  refine ⟨s, ⟨hs.1, hs.2.trans_lt (by linarith)⟩, ?_⟩
  have : (0 : ℝ) < (η s).im := hsK.1.1
  exact this.ne'

/-- The inverse of the retained chart on the chart event. -/
theorem chart_inv_eq {Ω : Type*} {e : RetData Ω} {ω : Ω} (he : ω ∈ e.E) : (e.chart ω).2.1 = e.inv ω := by
  simp [RetData.chart, he]

/-- **The slit sides of a later line, dense form** (see the module docstring). Every open interval inside the two slit
images contains a point `y` whose later-chart image is an interior point of the second prefix, off the first prefix
and off the later tip. -/
theorem exists_slitSide_of_lt {Ω : Type u} [MeasurableSpace Ω] {d d' : RetData Ω} (hd : d.IsMeasGood)
    (hd' : d'.IsMeasGood) (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) (hu : d'.u = d.u) {t : ℝ≥0}
    (hr : d'.r = d.r + t) {ω : Ω} (hω : ω ∈ d.E) (hω' : ω ∈ d'.E) {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞}
    {Q : ℝ≥0} (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0)
    (hinj : InjOn γ {s | (s : ℝ≥0∞) ≤ ζc}) (hQ : (Q : ℝ≥0∞) < ζc) (hQ0 : 0 < Q)
    (himg : (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t))
    (htip : d.inv ω (γ Q) = d.η₂ ω (d.r + t)) {a b : ℝ} (hab : a < b)
    (hslit : Ioo a b ⊆ Ioo (-rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - W Q) 0 ∪
      Ioo 0 (rightImg (fun s : ℝ => W s.toNNReal) 0 Q - W Q)) :
    ∃ y ∈ Ioo a b, d'.inv ω y ∈ H ∧ d'.inv ω y ∈ d.η₂ ω '' Icc 0 (d.r + t) ∧
      d'.inv ω y ≠ d.η₂ ω (d.r + t) ∧ d'.inv ω y ∉ d.η₁ ω '' Icc 0 d.u := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  -- the global model of the chart path
  obtain ⟨Wg, γg, T', hQT', hWgc, hWg0, hγg, hWeq, hγeq⟩ :=
    Sec7.ReverseArc.exists_global_model hg hWc.continuousOn hW0 hQ
  have hWeqQ : EqOn w' Wg (Icc 0 (Q : ℝ)) := fun r hr => (hWeq r ⟨hr.1, hr.2.trans hQT'.le⟩).symm
  have hΦeq : fwdMapInv w' Q = fwdMapInv Wg Q := fwdMapInv_eq_of_eqOn hQr hQT' fun r hr => (hWeq r hr).symm
  have hWQ : W Q = Wg Q := by
    rw [hWeq Q ⟨hQr, hQT'.le⟩, Real.toNNReal_coe]
  have hRR : rightImg (fun s : ℝ => W s.toNNReal) 0 Q = rightImg Wg 0 Q :=
    Sec7.Lemma71B.rightImg_congr hWgc hQr hWeqQ 0
  have hRL : rightImg (fun s : ℝ => -W s.toNNReal) 0 Q = rightImg (fun s => -Wg s) 0 Q :=
    Sec7.Lemma71B.rightImg_congr hWgc.neg hQr (fun r hr => by
      show -W r.toNNReal = -Wg r
      rw [show W r.toNNReal = w' r from rfl, hWeqQ hr]) 0
  rw [hWQ, hRR, hRL] at hslit
  have hγQ : γg Q = γ Q := by rw [hγeq Q ⟨hQr, hQT'.le⟩, Real.toNNReal_coe]
  have himgg : γg '' Icc 0 (Q : ℝ) = γ '' Icc 0 Q := by
    rw [image_congr (fun r hr => hγeq r ⟨hr.1, hr.2.trans hQT'.le⟩), image_toNNReal_Icc γ hQr,
      Real.toNNReal_coe]
  have hi : InjOn γg (Icc 0 (Q : ℝ)) := by
    intro s hs s' hs' he
    have hle : ∀ x ∈ Icc (0 : ℝ) Q, ((x.toNNReal : ℝ≥0) : ℝ≥0∞) ≤ ζc := fun x hx =>
      (ENNReal.coe_le_coe.2 (Real.toNNReal_le_iff_le_coe.2 hx.2)).trans hQ.le
    rw [hγeq s ⟨hs.1, hs.2.trans hQT'.le⟩, hγeq s' ⟨hs'.1, hs'.2.trans hQT'.le⟩] at he
    have := hinj (hle s hs) (hle s' hs') he
    rw [← Real.coe_toNNReal s hs.1, ← Real.coe_toNNReal s' hs'.1, this]
  -- the middle chart points land on the chart path, and some of them in `ℍ`
  set Φ := extendFrom H (fwdMapInv Wg Q) with hΦdef
  have hmid : ∀ z ∈ Ioo a b, Φ z ∈ γg '' Icc 0 (Q : ℝ) := by
    intro z hz
    have h1 := le_rightImg hWgc 0 hQr
    have h2 : -Wg Q ≤ rightImg (fun s => -Wg s) 0 Q := le_rightImg (w := fun s => -Wg s) hWgc.neg 0 hQr
    rcases hslit hz with h | h
    · exact Sec7.Lemma71P.mem_image_of_mid hγg hWgc hWg0 hQr h.1 (by linarith [h.2])
    · exact Sec7.Lemma71P.mem_image_of_mid hγg hWgc hWg0 hQr (by linarith [h.1]) h.2
  obtain ⟨z, hz, hzH⟩ := Sec7.Lemma71P.exists_mem_H_of_lt hγg hWgc hWg0 hQr hi
    (fun a' b' hab' hsub => exists_im_ne_zero_of_lt hγg hWgc hWg0 hab' hsub) hab hmid
  have hz0 : z ≠ 0 := by
    rcases hslit hz with h | h
    · exact h.2.ne
    · exact h.1.ne'
  -- the two charts
  have hG := hd.good ω (RetData.E₀_subset_G (RetData.E_subset_E₀ hω))
  have h0₂ : (d.η₂ ω 0).im = 0 := hG.2.2.2.2.2.1
  have hC := (hd.isRetChart hω).2
  have hC' := (hd'.isRetChart hω').2
  have hIIIa := (Restart.RetAux79.retChart_trans_of_image hd hd' h₁ h₂ hu hr hω hω' hg hWc hW0 hinj hQ hQ0 himg
    htip).1
  rw [chart_inv_eq hω', chart_inv_eq hω] at hIIIa
  have hΦc : ContinuousOn Φ Hbar := (hγg.hasBdryLimits hWgc hWg0 hQr).continuousOn
  have hΦm : MapsTo Φ Hbar Hbar := fun x hx => Sec7.Lemma71P.extendFrom_mem_Hbar hγg hWgc hWg0 hQr hx
  have hψ : EqOn (d'.inv ω) (fun w => d.inv ω (Φ w)) Hbar := by
    refine Set.EqOn.of_subset_closure (s := H) (fun w hw => ?_) hC'.continuousOn_inv
      (hC.continuousOn_inv.comp hΦc hΦm) QuantumZipper.H_subset_Hbar (by rw [closure_H])
    rw [hIIIa w hw, hΦdef, ZhanGT4.extendFrom_eq_fwdMapInv hWgc hWg0 hQr hw, hΦeq]
  have hzHb : ((z : ℝ) : ℂ) ∈ Hbar := mem_Hbar_of_im_eq_zero (by simp)
  have hψz : d'.inv ω z = d.inv ω (Φ z) := hψ hzHb
  -- the image lies in the stop-line active domain and on the new piece
  have hD : d.inv ω (Φ z) ∈ activeDomain (d.η₁ ω) d.u (d.η₂ ω) d.r := (hC.bijOn h0₂).mapsTo hzH
  obtain ⟨hDH, hD₁, -⟩ := notMem_of_mem_activeDomain hD
  obtain ⟨s, hs, hsz⟩ := hmid z hz
  rw [himgg] at hmid
  have hnew : d.inv ω (Φ z) ∈ d.η₂ ω '' Icc d.r (d.r + t) := by
    obtain ⟨s', hs', hs'z⟩ := hmid z hz
    rw [← himg, ← hs'z]
    exact ⟨s', hs', rfl⟩
  refine ⟨z, hz, ?_, ?_, ?_, ?_⟩
  · rw [hψz]; exact hDH
  · rw [hψz]; exact image_mono (Icc_subset_Icc_left zero_le) hnew
  · rw [hψz, ← htip]
    intro he
    by_cases hγH : γ Q ∈ H
    · have hΦγ : Φ z = γg Q := by rw [hγQ]; exact (hC.bijOn h0₂).injOn hzH hγH he
      exact hz0 (by exact_mod_cast Sec7.Lemma71P.eq_zero_of_extendFrom_eq_tip hγg hWgc hWg0 hQr hi hΦγ)
    · exact hC.inv_notMem h0₂ (γ Q) hγH (he ▸ hD)
  · rw [hψz]; exact hD₁

/-- **The slit heights from density.** If every open interval inside the two slit images `(ℓ, 0)`, `(0, ϱ)` contains a
point sent by the chart inverse to an interior point of the second prefix, off the first prefix and off the second tip,
then a word with the outer word `IsRetainedWord` has the canonical new-side heights on the slit images off its jumps
(the word is locally constant off its jumps). -/
theorem slitHeights_of_dense {κ θ₁ θ₂ : ℝ} {α β : ℝ≥0 → ℂ} {a b : ℝ≥0} {ψ : ℂ → ℂ} {c : BoundaryWord}
    (hw : IsRetainedWord κ θ₁ θ₂ α a β b ψ c) {ℓ ϱ : ℝ}
    (hside : ∀ a' b' : ℝ, a' < b' → Ioo a' b' ⊆ Ioo ℓ 0 ∪ Ioo 0 ϱ → ∃ y ∈ Ioo a' b',
      ψ y ∈ H ∧ ψ y ∈ β '' Icc 0 b ∧ ψ y ≠ β b ∧ ψ y ∉ α '' Icc 0 a) :
    (∀ y ∉ (c.jumps : Set ℝ), ℓ < y → y < 0 → c.fn y = -sleLambda κ - θ₂ * QuantumZipper.chiC κ) ∧
      (∀ y ∉ (c.jumps : Set ℝ), 0 < y → y < ϱ → c.fn y = sleLambda κ - θ₂ * QuantumZipper.chiC κ) := by
  have hgood : ∀ y : ℝ, ψ y ∈ H → ψ y ∈ β '' Icc 0 b → ψ y ≠ β b → ψ y ∉ α '' Icc 0 a →
      (y < 0 → c.fn y = -sleLambda κ - θ₂ * QuantumZipper.chiC κ) ∧
        (0 < y → c.fn y = sleLambda κ - θ₂ * QuantumZipper.chiC κ) := by
    intro y hH hβ htip hα
    have hα' : ψ y ≠ α a := fun e => hα (e ▸ ⟨a, ⟨zero_le, le_rfl⟩, rfl⟩)
    exact (hw y hH htip hα' fun h => hα h.1).2.2.1 hβ
  have hloc : ∀ y ∉ (c.jumps : Set ℝ), ∃ ε > 0, ∀ z : ℝ, dist z y < ε → c.fn z = c.fn y := fun y hy =>
    Metric.eventually_nhds_iff.1 (c.isPiecewiseConstantBoundaryData y (by exact_mod_cast hy))
  refine ⟨fun y hy hℓ hy0 => ?_, fun y hy hy0 hϱ => ?_⟩
  · obtain ⟨ε, hε, hεy⟩ := hloc y hy
    obtain ⟨y', hy', hH, hβ, htip, hα⟩ := hside (max ℓ (y - ε)) y (max_lt hℓ (by linarith))
      (fun z hz => Or.inl ⟨(le_max_left _ _).trans_lt hz.1, hz.2.trans hy0⟩)
    have hd : dist y' y < ε := by
      rw [Real.dist_eq, abs_lt]
      constructor <;> linarith [le_max_right ℓ (y - ε), hy'.1, hy'.2]
    rw [← hεy y' hd]
    exact (hgood y' hH hβ htip hα).1 (hy'.2.trans hy0)
  · obtain ⟨ε, hε, hεy⟩ := hloc y hy
    obtain ⟨y', hy', hH, hβ, htip, hα⟩ := hside y (min ϱ (y + ε)) (lt_min hϱ (by linarith))
      (fun z hz => Or.inr ⟨hy0.trans hz.1, hz.2.trans_le (min_le_left _ _)⟩)
    have hd : dist y' y < ε := by
      rw [Real.dist_eq, abs_lt]
      constructor <;> linarith [min_le_right ϱ (y + ε), hy'.1, hy'.2]
    rw [← hεy y' hd]
    exact (hgood y' hH hβ htip hα).2 (hy0.trans hy'.1)

open Restart.RetAux79 in
/-- **The later-line facts with the outer word, with no named input** (the `hline` facts (III-a) and (III-b) of
`RetAux79.hasSafeLaw_of_retLines` at one line, for touching pairs and through real contacts): as
`OrdDet.ae_retLine_facts_of_retainedWord`, with the slit heights from `exists_slitSide_of_lt` and
`slitHeights_of_dense` instead of `OrdSlitSideStatement`; neither ordinariness at the later pair nor the absence of new
contacts is needed. -/
theorem ae_retLine_facts_of_retainedWord_dense {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ}
    {x₁ x₂ θ₁ θ₂ : ℝ} {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞}
    (hL75 : Theorem15.Lemma75Statement.{u}) (hκ : 0 < κ) (hκ4 : κ < 4)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hh : IsGFFWithBoundaryData P h b jumps)
    (hη₁ : IsFlowLine κ b jumps x₁ θ₁ P h η₁ ζ₁) (hη₂ : IsFlowLine κ b jumps x₂ θ₂ P h η₂ ζ₂)
    {u₀ : ℂ → ℝ} (hu₀ : IsBoundedHarmonicExtension b jumps u₀)
    {d d' : RetData Ω} (hd : d.IsMeasGood) (hd' : d'.IsMeasGood)
    (hag : ∀ᵐ ω ∂P, (d.u : ℝ≥0∞) < ζ₁ ω → (d.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d.G ∧
      (∀ s ≤ d.u, d.η₁ ω s = η₁ ω s) ∧ ∀ t ≤ d.r, d.η₂ ω t = η₂ ω t)
    (hag' : ∀ᵐ ω ∂P, (d'.u : ℝ≥0∞) < ζ₁ ω → (d'.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d'.G ∧
      (∀ s ≤ d'.u, d'.η₁ ω s = η₁ ω s) ∧ ∀ t ≤ d'.r, d'.η₂ ω t = η₂ ω t)
    (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) (hu : d'.u = d.u) {t : ℝ≥0} (hr : d'.r = d.r + t)
    {O₀ O₁ : Set Ω} {β₀ β₁ : Ω → BoundaryWord}
    (hm₀ : IsRetMeanIdentOn κ P h η₁ η₂ ζ₁ ζ₂ u₀ hd O₀ β₀)
    (hm₁ : IsRetMeanIdentOn κ P h η₁ η₂ ζ₁ ζ₂ u₀ hd' O₁ β₁) :
    ∀ᵐ ω ∂P, ω ∈ O₀ → ω ∈ O₁ → (d'.u : ℝ≥0∞) < ζ₁ ω → (d'.r : ℝ≥0∞) < ζ₂ ω → ω ∈ d.E → ω ∈ d'.E →
      (β₀ ω).IsSorted → (β₁ ω).IsSorted →
      IsRetainedWord κ θ₁ θ₂ (d.η₁ ω) d.u (d.η₂ ω) (d.r + t) (d'.inv ω) (β₁ ω) →
      ∀ (W : ℝ≥0 → ℝ) (γ : ℝ≥0 → ℂ) (ζc : ℝ≥0∞) (Q : ℝ≥0), IsGeneratingTrace W ζc γ → Continuous W →
        W 0 = 0 → InjOn γ {s | (s : ℝ≥0∞) ≤ ζc} → (Q : ℝ≥0∞) < ζc → 0 < Q →
        (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t) →
        d.inv ω (γ Q) = d.η₂ ω (d.r + t) →
        (∀ w ∈ H, (d'.chart ω).2.1 w = (d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)) ∧
        (∀ w ∈ H, (d'.chart ω).2.2 ((d'.chart ω).2.1 w) =
          (logDerivFwd (fun s : ℝ => W s.toNNReal) Q (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)).im +
            (d.chart ω).2.2 ((d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))) ∧
        ∃ S : Set ℝ, S.Finite ∧ ∀ y ∉ S,
          forceBoundaryData κ (flowLineRhoL κ (β₀ ω).fn (β₀ ω).jumps 0 θ₂)
              (flowLineRhoR κ (β₀ ω).fn (β₀ ω).jumps 0 θ₂)
              (fun i => -rightImg (fun s : ℝ => -W s.toNNReal) (-flowLineXL (β₀ ω).fn (β₀ ω).jumps 0 i) Q - W Q)
              (fun j => rightImg (fun s : ℝ => W s.toNNReal) (flowLineXR (β₀ ω).fn (β₀ ω).jumps 0 j) Q - W Q) y =
            (β₁ ω).fn y + θ₂ * QuantumZipper.chiC κ := by
  have hl := ae_retLine_facts_of_meanIdent hL75 hκ hκ4 hb hh hη₁ hη₂ hu₀ hd hd' hag hag' h₁ h₂ hu hr hm₀ hm₁ θ₂
  filter_upwards [hl] with ω hlω
  intro hO₀ hO₁ hu₁ hr₁ hE hE' hs₀ hs₁ hrw W γ ζc Q hg hWc hW0 hinj hQ hQ0 himg htip
  obtain ⟨hL, hR⟩ := slitHeights_of_dense hrw (ℓ := -rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - W Q)
    (ϱ := rightImg (fun s : ℝ => W s.toNNReal) 0 Q - W Q) fun a' b' hab' hsub =>
      exists_slitSide_of_lt hd hd' h₁ h₂ hu hr hE hE' hg hWc hW0 hinj hQ hQ0 himg htip hab' hsub
  exact hlω hO₀ hO₁ hu₁ hr₁ hE hE' hs₀ hs₁ W γ ζc Q hg hWc hW0 hinj hQ hQ0 himg htip
    ⟨_, (β₁ ω).jumps.finite_toSet, hL, hR⟩

/-- **The later tip is adherent to the later active domain** (deterministic). With the stop-line chart `ψ₀` of `d` and
a chart path `γ` of the continuation as in `exists_slitSide_of_lt`, the image `ψ₀ ∘ F̄_Q(ℍ)` is a connected unbounded
subset of `ℍ` off `η₁([0, u]) ∪ η₂([0, r + t])`, hence lies in the later active domain, and `ψ₀(F̄_Q(0)) = ψ₀(γ(Q))` is
the later tip `η₂(r + t)`. No ordinariness, no contact hypothesis and no later chart is used. -/
theorem later_tip_mem_closure_activeDomain {Ω : Type u} [MeasurableSpace Ω] {d : RetData Ω} (hd : d.IsMeasGood)
    {t : ℝ≥0} {ω : Ω} (hω : ω ∈ d.E) {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0}
    (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (himg : (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t))
    (htip : d.inv ω (γ Q) = d.η₂ ω (d.r + t)) :
    (fun w => d.inv ω (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w)) '' H ⊆
        activeDomain (d.η₁ ω) d.u (d.η₂ ω) (d.r + t) ∧
      d.η₂ ω (d.r + t) ∈ closure (activeDomain (d.η₁ ω) d.u (d.η₂ ω) (d.r + t)) := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  obtain ⟨Wg, γg, T', hQT', hWgc, hWg0, hγg, hWeq, hγeq⟩ :=
    Sec7.ReverseArc.exists_global_model hg hWc.continuousOn hW0 hQ
  have hΦeq : fwdMapInv w' Q = fwdMapInv Wg Q := fwdMapInv_eq_of_eqOn hQr hQT' fun r hr => (hWeq r hr).symm
  have hγQ : γg Q = γ Q := by rw [hγeq Q ⟨hQr, hQT'.le⟩, Real.toNNReal_coe]
  have himgg : γg '' Icc 0 (Q : ℝ) = γ '' Icc 0 Q := by
    rw [image_congr (fun r hr => hγeq r ⟨hr.1, hr.2.trans hQT'.le⟩), image_toNNReal_Icc γ hQr,
      Real.toNNReal_coe]
  rw [hΦeq]
  set Φ := extendFrom H (fwdMapInv Wg Q) with hΦdef
  have hG := hd.good ω (RetData.E₀_subset_G (RetData.E_subset_E₀ hω))
  have h0₂ : (d.η₂ ω 0).im = 0 := hG.2.2.2.2.2.1
  have hC := (hd.isRetChart hω).2
  set ψ₀ := d.inv ω with hψ₀
  have hΦc : ContinuousOn Φ Hbar := (hγg.hasBdryLimits hWgc hWg0 hQr).continuousOn
  have hΦm : MapsTo Φ Hbar Hbar := fun x hx => Sec7.Lemma71P.extendFrom_mem_Hbar hγg hWgc hWg0 hQr hx
  have hFc : ContinuousOn (fun w => ψ₀ (Φ w)) Hbar := hC.continuousOn_inv.comp hΦc hΦm
  -- the image of `ℍ` is off the later union
  have hK : fwdHull Wg Q = fillH (γ '' Icc 0 Q) := by rw [hγg.2.2 Q hQr, himgg]
  have hoff : ∀ w ∈ H, ψ₀ (Φ w) ∈ H \ (d.η₁ ω '' Icc 0 d.u ∪ d.η₂ ω '' Icc 0 (d.r + t)) := by
    intro w hw
    have hΦw : Φ w ∈ H \ fwdHull Wg Q := by
      rw [hΦdef, ZhanGT4.extendFrom_eq_fwdMapInv hWgc hWg0 hQr hw]
      exact QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hWgc hWg0 hQr hw
    have hD : ψ₀ (Φ w) ∈ activeDomain (d.η₁ ω) d.u (d.η₂ ω) d.r := (hC.bijOn h0₂).mapsTo hΦw.1
    obtain ⟨hDH, hD₁, hD₂⟩ := notMem_of_mem_activeDomain hD
    refine ⟨hDH, ?_⟩
    rintro (h1 | ⟨s, hs, hse⟩)
    · exact hD₁ h1
    rcases le_total s d.r with hsr | hrs
    · exact hD₂ ⟨s, ⟨hs.1, hsr⟩, hse⟩
    -- a point of the new piece is the chart image of a point of the chart path
    have hnew : d.η₂ ω s ∈ (fun s => ψ₀ (γ s)) '' Icc 0 Q := by rw [himg]; exact ⟨s, ⟨hrs, hs.2⟩, rfl⟩
    obtain ⟨q, hq, hqe⟩ := hnew
    by_cases hγH : γ q ∈ H
    · have he : Φ w = γ q := (hC.bijOn h0₂).injOn hΦw.1 hγH (by rw [← hse]; exact hqe.symm)
      exact hΦw.2 (by rw [he, hK]; exact ⟨hγH, Or.inl (subset_closure ⟨q, hq, rfl⟩)⟩)
    · have he : ψ₀ (γ q) = ψ₀ (Φ w) := hqe.trans hse
      exact hC.inv_notMem h0₂ (γ q) hγH (by rw [he]; exact hD)
  -- the image of `ℍ` is preconnected and unbounded
  set S := (fun w => ψ₀ (Φ w)) '' H with hSdef
  have hSc : IsPreconnected S := convex_H.isPreconnected.image _ (hFc.mono QuantumZipper.H_subset_Hbar)
  obtain ⟨M, hM⟩ := hC.2.2.2.2.2.2.2.2.2.1
  obtain ⟨C, hCb⟩ := Sec7.Lemma71P.exists_norm_extendFrom_sub_le' hγg hWgc hWg0 hQr
  have hSu : ¬ Bornology.IsBounded S := by
    intro hb
    obtain ⟨R, hR⟩ := hb.subset_closedBall 0
    set w : ℂ := ((|R| + |M| + |C| + 1 : ℝ) : ℂ) * I with hwdef
    have hwH : w ∈ H := by
      show 0 < w.im
      simp only [hwdef, mul_im, ofReal_re, I_im, ofReal_im, I_re, mul_zero, add_zero, mul_one]
      positivity
    have hwn : ‖w‖ = |R| + |M| + |C| + 1 := by
      rw [hwdef, norm_mul, norm_I, mul_one, norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have h1 := hM (Φ w) (hΦm (QuantumZipper.H_subset_Hbar hwH))
    have h2 := hCb w (QuantumZipper.H_subset_Hbar hwH)
    have h3 : ψ₀ (Φ w) ∈ closedBall (0 : ℂ) R := hR ⟨w, hwH, rfl⟩
    rw [mem_closedBall, dist_zero_right] at h3
    have h4 := norm_sub_norm_le w (Φ w)
    have h5 := norm_sub_norm_le (Φ w) (ψ₀ (Φ w))
    rw [norm_sub_rev] at h4 h5
    linarith [le_abs_self R, le_abs_self M, le_abs_self C]
  have hSsub : S ⊆ activeDomain (d.η₁ ω) d.u (d.η₂ ω) (d.r + t) := by
    rintro _ ⟨w, hw, rfl⟩
    refine ⟨hoff w hw, fun hb => hSu (hb.subset ?_)⟩
    exact hSc.subset_connectedComponentIn ⟨w, hw, rfl⟩ (by rintro _ ⟨w', hw', rfl⟩; exact hoff w' hw')
  refine ⟨hSsub, ?_⟩
  have h0cl : (0 : ℂ) ∈ closure H := by rw [closure_H]; exact mem_Hbar_of_im_eq_zero (by simp)
  have hcw : ContinuousWithinAt (fun w => ψ₀ (Φ w)) H 0 :=
    (hFc 0 (mem_Hbar_of_im_eq_zero (by simp))).mono QuantumZipper.H_subset_Hbar
  have hval : ψ₀ (Φ 0) = d.η₂ ω (d.r + t) := by
    rw [hΦdef, ZhanGT4.extendFrom_zero_eq hγg hWgc hWg0 hQr, hγQ, htip]
  rw [← hval]
  exact closure_mono hSsub (hcw.mem_closure_image h0cl)

/-- **The later chart event**: with a chart path of the continuation as in `later_tip_mem_closure_activeDomain`, a
sample of the stop-line chart event that is good for the later data, with the later tip interior and off the first
prefix, lies in the later chart event. -/
theorem mem_E_of_later {Ω : Type u} [MeasurableSpace Ω] {d d' : RetData Ω} (hd : d.IsMeasGood)
    (hd' : d'.IsMeasGood) (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) (hu : d'.u = d.u) {t : ℝ≥0}
    (hr : d'.r = d.r + t) {ω : Ω} (hω : ω ∈ d.E) (hG' : ω ∈ d'.G) (hH : d.η₂ ω (d.r + t) ∈ H)
    (hnc : d.η₂ ω (d.r + t) ∉ d.η₁ ω '' Icc 0 d.u) {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0}
    (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (himg : (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t))
    (htip : d.inv ω (γ Q) = d.η₂ ω (d.r + t)) : ω ∈ d'.E := by
  have hE₀ : ω ∈ d'.E₀ := ⟨⟨hG', by rw [h₂, hr]; exact hH⟩, by rw [h₂, hr, h₁, hu]; exact hnc⟩
  refine ⟨hE₀, ?_⟩
  have hcl := (later_tip_mem_closure_activeDomain hd hω hg hWc hW0 hQ himg htip).2
  have hKc : IsClosed (prefixSet (d'.η₁ ω) d'.u (d'.η₂ ω) d'.r) := by
    have h := (hd'.isCompact_KOf (fun _ h => h.1.1) ω (F := d'.E₀)).isClosed
    rwa [RetData.KOf_of_mem hE₀] at h
  show d'.η₂ ω d'.r ∈ closure (H \ fillH (d'.KOf d'.E₀ ω))
  rw [RetData.KOf_of_mem hE₀, ← activeDomain_eq hKc, h₁, h₂, hu, hr]
  exact hcl

