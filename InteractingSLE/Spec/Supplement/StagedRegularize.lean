/-!
# Regularizing a staged history (ruling R51)

Packet PROVE-T14-GW1X. The frozen Theorem 1.4 anchors (version 2, ruling R51) assume that every staged family is
`StagedPiecesRegular`: almost surely every launched piece is continuous, from `0`, on `[0, min t ζ]`. The landed
staged-law machinery (PROVE-STAGEDLAW, PROVE-T14-GW1W) needs drivers that are regular at **every** sample
(`IsRegularDriver`). This file bridges the two without changing anything the runs see.

* `regularize t e`: a measurable map on drivers with the same lifetime, regular at every sample
  (`isRegularDriver_regularize`), equal to `e` before the lifetime when `e` is continuous there from `0`
  (`regularize_eq_of_lt`), and with the same retained datum for the own time `t` when `e` is continuous from `0` on
  `[0, min t ζ]` (`canonDrv_regularize`). It reads the driver at dyadic times (`Sec2.Assembly.enc`): the decoded path
  when the codes are uniformly continuous before the lifetime, otherwise the decoded path stopped at `t` when the codes
  are uniformly continuous on `[0, t]`, otherwise `0`.
* `run_eq_of_canonDrv_eq_on_launch`: two driver families whose launched pieces have the same retained data run
  through the same states.
* `ae_condExpKernel_eq_of_ae_eq`: σ-algebras generated by almost surely equal maps have almost surely equal regular
  conditional laws.
* `isFlowLineDriver_congr_ae`: `IsFlowLineDriver` only sees the driver before its lifetime, up to null sets.
* **`isStagedHistory_regHist`**, **`isRegularDriver_regHist`**, **`ae_run_regHist`**: for a staged history that is
  `StagedPiecesRegular`, the regularized family `regHist spec E` is a staged history, regular at every sample, with
  almost surely the same runs (hence the same physical sets, statuses and retained pasts).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

namespace Theorem14

namespace StagedReg

open Sec2.Assembly Exist.Staged Exist.StagedLaw

/-! ### The regularization of one driver -/

/-- The dyadic codes of the driver are uniformly continuous on every dyadic `[0, d]` before the lifetime, and the
driver starts at `0`. -/
def GoodAll (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : Prop :=
  e.1 0 = 0 ∧ ∀ n k, (dyad n k : ℝ≥0∞) < e.2 → UC (enc e.1) (dyad n k)

/-- The driver starts at `0`, is alive after `t`, and its dyadic codes are uniformly continuous on `[0, t]`. -/
def GoodTo (t : ℝ≥0∞) (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : Prop :=
  e.1 0 = 0 ∧ t < e.2 ∧ UC (enc e.1) t.toNNReal

open Classical in
/-- **The regularized driver** for the own time `t`: same lifetime; the decoded dyadic path (frozen at its left limit
from the lifetime on) if the codes are uniformly continuous before the lifetime; otherwise the decoded path stopped at
`t` if the codes are uniformly continuous on `[0, t]` and the driver lives beyond `t`; otherwise `0`. -/
def regularize (t : ℝ≥0∞) (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : (ℝ≥0 → ℝ) × ℝ≥0∞ :=
  if GoodAll e then (drvPath (e.2, enc e.1), e.2)
  else if GoodTo t e then (fun s => dec (enc e.1) (min s t.toNNReal), e.2) else (fun _ => 0, e.2)

theorem regularize_snd (t : ℝ≥0∞) (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : (regularize t e).2 = e.2 := by
  unfold regularize
  split_ifs <;> rfl

theorem measurable_enc' : Measurable (enc : (ℝ≥0 → ℝ) → PCode) :=
  measurable_pi_iff.2 fun _ => measurable_pi_iff.2 fun _ => measurable_pi_apply _

theorem measurableSet_goodAll : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | GoodAll e} := by
  have h0 : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | e.1 0 = 0} :=
    measurableSet_eq_fun ((measurable_pi_apply 0).comp measurable_fst) measurable_const
  have hUC : ∀ T : ℝ≥0, MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | UC (enc e.1) T} := fun T =>
    (measurable_enc'.comp measurable_fst) (measurableSet_UC T)
  have hlt : ∀ n k, MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | (dyad n k : ℝ≥0∞) < e.2} := fun n k =>
    measurableSet_lt measurable_const measurable_snd
  refine measurableSet_setOfPred.2 (Measurable.and (measurableSet_setOfPred.1 h0) ?_)
  refine Measurable.forall fun n => Measurable.forall fun k => ?_
  exact (measurableSet_setOfPred.1 (hlt n k)).imp (measurableSet_setOfPred.1 (hUC _))

theorem measurableSet_goodTo (t : ℝ≥0∞) : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | GoodTo t e} := by
  have h0 : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | e.1 0 = 0} :=
    measurableSet_eq_fun ((measurable_pi_apply 0).comp measurable_fst) measurable_const
  have hUC : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | UC (enc e.1) t.toNNReal} :=
    (measurable_enc'.comp measurable_fst) (measurableSet_UC _)
  have hlt : MeasurableSet {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | t < e.2} := measurableSet_lt measurable_const measurable_snd
  exact h0.inter (hlt.inter hUC)

theorem measurable_regularize (t : ℝ≥0∞) : Measurable (regularize t) := by
  classical
  unfold regularize
  refine Measurable.ite measurableSet_goodAll ?_ (Measurable.ite (measurableSet_goodTo t) ?_ ?_)
  · exact (measurable_drvPath.comp (measurable_snd.prodMk (measurable_enc'.comp measurable_fst))).prodMk
      measurable_snd
  · refine Measurable.prodMk (measurable_pi_iff.2 fun s => ?_) measurable_snd
    exact measurable_dec.comp ((measurable_enc'.comp measurable_fst).prodMk measurable_const)
  · exact measurable_const.prodMk measurable_snd

/-- Decoding at time `0` returns the value at `0`. -/
theorem dec_enc_zero (f : ℝ≥0 → ℝ) : dec (enc f) 0 = f 0 := by
  refine dec_enc ?_
  have e : Iic (0 : ℝ≥0) = {0} := by
    ext x; simp only [mem_Iic, mem_singleton_iff, nonpos_iff_eq_zero]
  rw [e]; exact continuousWithinAt_singleton

/-- A function continuous at a positive time `ζ₀` from the left takes the value of its left limit there. -/
theorem eq_of_tendsto_nhdsLT {f : ℝ≥0 → ℝ} {ζ₀ : ℝ≥0} (hζ₀ : 0 < ζ₀) (hf : ContinuousWithinAt f (Iic ζ₀) ζ₀)
    {c : ℝ} (hc : Tendsto f (𝓝[<] ζ₀) (𝓝 c)) : f ζ₀ = c := by
  have : (𝓝[<] ζ₀).NeBot := nhdsLT_neBot_of_exists_lt ⟨0, hζ₀⟩
  exact tendsto_nhds_unique ((hf.mono Iio_subset_Iic_self).tendsto) hc

/-- The frozen value of `drvPath` from the lifetime on. -/
theorem drvPath_of_le {z : DCode} {s : ℝ≥0} (hs : z.1 ≤ s) :
    drvPath z s = drvPath z z.1.toNNReal := by
  have hne : z.1 ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top hs
  have h1 : ¬ (s : ℝ≥0∞) < z.1 := not_lt.2 hs
  have h2 : ¬ ((z.1.toNNReal : ℝ≥0) : ℝ≥0∞) < z.1 := by
    rw [ENNReal.coe_toNNReal hne]; exact lt_irrefl _
  simp only [drvPath, h1, h2, ↓reduceIte]

/-- `drvPath` at time `0`, for a code of a driver from `0`. -/
theorem drvPath_enc_zero {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0) : drvPath (e.2, enc e.1) 0 = 0 := by
  by_cases hpos : ((0 : ℝ≥0) : ℝ≥0∞) < e.2
  · rw [drvPath_of_lt hpos]; exact (dec_enc_zero _).trans h0
  · have hζ : e.2 = 0 := by
      rw [ENNReal.coe_zero] at hpos; exact le_antisymm (not_lt.1 hpos) zero_le
    have e1 : ∀ m : ℕ, (e.2, enc e.1).1.toNNReal - 1 / ((m : ℝ≥0) + 1) = 0 := fun m => by
      simp [hζ]
    simp only [drvPath, hpos, ↓reduceIte, e1, limsup_const, dec_enc_zero, h0]

/-- **The regularized driver is regular at every sample.** -/
theorem isRegularDriver_regularize (t : ℝ≥0∞) (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : IsRegularDriver (regularize t e) := by
  classical
  by_cases hA : GoodAll e
  · have hr : regularize t e = (drvPath (e.2, enc e.1), e.2) := by simp only [regularize, hA, ↓reduceIte]
    rw [hr]
    refine ⟨(continuousOn_dec_of_UC hA.2).congr fun s hs => drvPath_of_lt hs, drvPath_enc_zero hA.1,
      fun s hs => drvPath_of_le hs, fun hne hpos c hc => drvPath_eq_of_tendsto hne hpos hc⟩
  by_cases hT : GoodTo t e
  · have hr : regularize t e = (fun s => dec (enc e.1) (min s t.toNNReal), e.2) := by
      simp only [regularize, hA, hT, ↓reduceIte]
    rw [hr]
    have hc : Continuous fun s : ℝ≥0 => dec (enc e.1) (min s t.toNNReal) :=
      hT.2.2.continuousOn.comp_continuous (continuous_id.min continuous_const) fun s => Set.mem_Iic.2 (min_le_right _ _)
    have htne : t ≠ ⊤ := ne_top_of_lt hT.2.1
    refine ⟨hc.continuousOn, ?_, fun s hs => ?_, fun hne hpos c hlim => ?_⟩
    · simp only [zero_le, min_eq_left, dec_enc_zero, hT.1]
    · have hne : e.2 ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top hs
      have h1 : t.toNNReal ≤ s := by
        rw [← ENNReal.coe_le_coe, ENNReal.coe_toNNReal htne]; exact hT.2.1.le.trans hs
      have h2 : t.toNNReal ≤ e.2.toNNReal := (ENNReal.toNNReal_le_toNNReal htne hne).2 hT.2.1.le
      simp only [min_eq_right h1, min_eq_right h2]
    · exact eq_of_tendsto_nhdsLT (ENNReal.toNNReal_pos hpos.ne' hne) hc.continuousWithinAt hlim
  · have hr : regularize t e = (fun _ => 0, e.2) := by simp only [regularize, hA, hT, ↓reduceIte]
    rw [hr]
    exact ⟨continuousOn_const, rfl, fun _ _ => rfl, fun hne hpos c hlim =>
      eq_of_tendsto_nhdsLT (ENNReal.toNNReal_pos hpos.ne' hne) continuousWithinAt_const hlim⟩

/-! ### What the regularization keeps -/

/-- Continuity of a driver on `{s ≤ S}` gives left continuity at every point of it. -/
theorem continuousWithinAt_Iic_of_le {f : ℝ≥0 → ℝ} {S : ℝ≥0∞} (hc : ContinuousOn f {s | (s : ℝ≥0∞) ≤ S})
    {s : ℝ≥0} (hs : (s : ℝ≥0∞) ≤ S) : ContinuousWithinAt f (Iic s) s :=
  (hc s hs).mono fun _ hx => le_trans (ENNReal.coe_le_coe.2 hx) hs

/-- The codes of a driver from `0`, continuous on `[0, d]` for every dyadic `d` before its lifetime, are good. -/
theorem goodAll_of {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0)
    (hc : ∀ d : ℝ≥0, (d : ℝ≥0∞) < e.2 → ContinuousOn e.1 (Iic d)) : GoodAll e :=
  ⟨h0, fun _ _ hd => uc_enc (hc _ hd)⟩

/-- **Before the lifetime, the regularization of a driver continuous there from `0` is the driver.** -/
theorem regularize_eq_of_lt (t : ℝ≥0∞) {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0)
    (hc : ContinuousOn e.1 {s | (s : ℝ≥0∞) < e.2}) {s : ℝ≥0} (hs : (s : ℝ≥0∞) < e.2) :
    (regularize t e).1 s = e.1 s := by
  classical
  have hA : GoodAll e := goodAll_of h0 fun d hd =>
    hc.mono fun x hx => lt_of_le_of_lt (ENNReal.coe_le_coe.2 hx) hd
  have hr : regularize t e = (drvPath (e.2, enc e.1), e.2) := by simp only [regularize, hA, ↓reduceIte]
  rw [hr]
  change drvPath (e.2, enc e.1) s = e.1 s
  rw [drvPath_of_lt hs]
  have hU : IsOpen {s : ℝ≥0 | (s : ℝ≥0∞) < e.2} := isOpen_lt ENNReal.continuous_coe continuous_const
  exact dec_enc ((hc.continuousAt (hU.mem_nhds hs)).continuousWithinAt)

/-- The regularization of a driver from `0` is `0` at `0`. -/
theorem regularize_zero (t : ℝ≥0∞) {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0) : (regularize t e).1 0 = e.1 0 :=
  (isRegularDriver_regularize t e).2.1.trans h0.symm

/-- **On `[0, min t ζ]` the regularization of a driver continuous there from `0` is the driver.** -/
theorem regularize_eq_of_le {t : ℝ≥0∞} {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0)
    (hc : ContinuousOn e.1 {s | (s : ℝ≥0∞) ≤ min t e.2}) {s : ℝ≥0} (hs : (s : ℝ≥0∞) ≤ min t e.2) :
    (regularize t e).1 s = e.1 s := by
  classical
  by_cases hA : GoodAll e
  · have hr : regularize t e = (drvPath (e.2, enc e.1), e.2) := by simp only [regularize, hA, ↓reduceIte]
    rw [hr]
    change drvPath (e.2, enc e.1) s = e.1 s
    have hlt : ∀ x : ℝ≥0, (x : ℝ≥0∞) < e.2 → x ≤ s → drvPath (e.2, enc e.1) x = e.1 x := fun x hx hxs => by
      rw [drvPath_of_lt hx]
      exact dec_enc (continuousWithinAt_Iic_of_le hc ((ENNReal.coe_le_coe.2 hxs).trans hs))
    by_cases hse : (s : ℝ≥0∞) < e.2
    · exact hlt s hse le_rfl
    have hse' : e.2 = s := le_antisymm (not_lt.1 hse) (hs.trans (min_le_right _ _))
    have hsz : (e.2, enc e.1).1.toNNReal = s := by
      change e.2.toNNReal = s; rw [hse', ENNReal.toNNReal_coe]
    by_cases hs0 : s = 0
    · subst hs0; exact (drvPath_enc_zero h0).trans h0.symm
    have hpos : 0 < (e.2, enc e.1).1 := by
      change 0 < e.2; rw [hse']; exact ENNReal.coe_pos.2 (pos_iff_ne_zero.2 hs0)
    have hne : (e.2, enc e.1).1 ≠ ⊤ := by change e.2 ≠ ⊤; rw [hse']; exact ENNReal.coe_ne_top
    have htend : Tendsto (drvPath (e.2, enc e.1)) (𝓝[<] (e.2, enc e.1).1.toNNReal) (𝓝 (e.1 s)) := by
      rw [hsz]
      refine ((continuousWithinAt_Iic_of_le hc hs).mono Iio_subset_Iic_self).tendsto.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with x (hx : x < s)
      exact (hlt x (by rw [hse']; exact ENNReal.coe_lt_coe.2 hx) hx.le).symm
    have := drvPath_eq_of_tendsto hne hpos htend
    rwa [hsz] at this
  by_cases hT : GoodTo t e
  · have hr : regularize t e = (fun s => dec (enc e.1) (min s t.toNNReal), e.2) := by
      simp only [regularize, hA, hT, ↓reduceIte]
    rw [hr]
    have htne : t ≠ ⊤ := ne_top_of_lt hT.2.1
    have hst : s ≤ t.toNNReal := by
      rw [← ENNReal.coe_le_coe, ENNReal.coe_toNNReal htne]; exact hs.trans (min_le_left _ _)
    change dec (enc e.1) (min s t.toNNReal) = e.1 s
    rw [min_eq_left hst]
    exact dec_enc (continuousWithinAt_Iic_of_le hc hs)
  · exfalso
    by_cases hle : e.2 ≤ t
    · refine hA (goodAll_of h0 fun d hd => hc.mono fun x hx => ?_)
      rw [mem_ofPred_eq, min_eq_right hle]
      exact ((ENNReal.coe_le_coe.2 hx).trans hd.le)
    · have hlt : t < e.2 := not_le.1 hle
      have htne : t ≠ ⊤ := ne_top_of_lt hlt
      refine hT ⟨h0, hlt, uc_enc (hc.mono fun x hx => ?_)⟩
      rw [mem_ofPred_eq, min_eq_left hlt.le]
      exact (ENNReal.coe_le_coe.2 hx).trans (ENNReal.coe_toNNReal htne).le

/-- **The regularization keeps the retained datum** of a driver continuous from `0` on `[0, min t ζ]`. -/
theorem canonDrv_regularize {t : ℝ≥0∞} {e : (ℝ≥0 → ℝ) × ℝ≥0∞} (h0 : e.1 0 = 0)
    (hc : ContinuousOn e.1 {s | (s : ℝ≥0∞) ≤ min t e.2}) : canonDrv t (regularize t e) = canonDrv t e := by
  have h2 := regularize_snd t e
  unfold canonDrv
  rw [h2]
  refine Prod.ext (funext fun r => ?_) rfl
  dsimp only
  have hne : min (r : ℝ≥0∞) (min t e.2) ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top (min_le_left _ _)
  refine regularize_eq_of_le h0 hc ?_
  rw [ENNReal.coe_toNNReal hne]; exact min_le_right _ _

/-! ### Runs only see the retained data of the launched pieces -/

section Run

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ}

/-- **Two driver families whose launched pieces have the same retained data run through the same states.** -/
theorem run_eq_of_canonDrv_eq_on_launch (spec : ExplSpec) {D D' : ℕ → (ℝ≥0 → ℝ) × ℝ≥0∞}
    (h : ∀ (k : ℕ) (c : Chart) (θ : ℝ), (ExplState.run κ b jumps spec D (k + 1)).2.2.2.1 k = some (c, θ) →
      canonDrv (instrTime spec k) (D' k) = canonDrv (instrTime spec k) (D k)) :
    ∀ k, ExplState.run κ b jumps spec D' k = ExplState.run κ b jumps spec D k := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [run_succ spec D' k, run_succ spec D k, ih]
    cases hk : spec.2.2[k]? with
    | none => rfl
    | some a =>
      rcases a with ⟨θ, t⟩ | pref | ⟨v, pref⟩
      · change ExplState.flowStep κ b spec.2.1 (ExplState.run κ b jumps spec D k) k (D' k) θ t =
          ExplState.flowStep κ b spec.2.1 (ExplState.run κ b jumps spec D k) k (D k) θ t
        have ht : instrTime spec k = t := by unfold instrTime; rw [hk]
        rcases flowStep_cases (κ := κ) (b := b) spec.2.1 (ExplState.run κ b jumps spec D k) k θ t with hc | hc
        · exact hc _ _
        · have hl : (ExplState.run κ b jumps spec D (k + 1)).2.2.2.1 k =
              some ((ExplState.run κ b jumps spec D k).2.2.2.2.1, θ) := by
            rw [run_succ spec D k, hk]
            change (ExplState.flowStep κ b spec.2.1 (ExplState.run κ b jumps spec D k) k (D k) θ t).2.2.2.1 k = _
            rw [hc, launches_launch, Function.update_self]
          have hcan := h k _ θ hl
          rw [ht] at hcan
          rw [hc, hc, ← launch_canonDrv _ _ (D' k), hcan, launch_canonDrv]
      · rfl
      · rfl

end Run

/-! ### Conditional laws given almost surely equal data -/

section Kernel

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]

/-- If `m₁ ≤ m ≤ mΩ` and every `m`-set is an `m₁`-set up to a null set, the two conditional expectations agree. -/
theorem condExp_ae_eq_of_le_aeSigma {m₁ m : MeasurableSpace Ω} (h₁ : m₁ ≤ m) (hm : m ≤ mΩ)
    (htr : m ≤ LocalSets.aeSigma m₁ P) {X : Ω → ℝ} (hX : Integrable X P) : P[X | m₁] =ᵐ[P] P[X | m] := by
  have hm₁ : m₁ ≤ mΩ := h₁.trans hm
  refine ae_eq_condExp_of_forall_setIntegral_eq hm hX (fun s _ _ => integrable_condExp.integrableOn)
    (fun s hs _ => ?_) ((stronglyMeasurable_condExp.mono h₁).aestronglyMeasurable)
  obtain ⟨C, hCm, hsC⟩ := htr s hs
  rw [setIntegral_congr_set hsC, setIntegral_condExp hm₁ hX hCm, ← setIntegral_congr_set hsC]

omit [IsFiniteMeasure P] in
/-- `comap g` is contained in `comap f` up to null sets when `f = g` almost surely. -/
theorem comap_le_aeSigma {X : Type*} [MeasurableSpace X] {f g : Ω → X} (hfg : f =ᵐ[P] g) :
    MeasurableSpace.comap g inferInstance ≤ LocalSets.aeSigma (MeasurableSpace.comap f inferInstance) P := by
  rintro _ ⟨C, hC, rfl⟩
  refine ⟨f ⁻¹' C, ⟨C, hC, rfl⟩, ?_⟩
  filter_upwards [hfg] with ω hω
  simp only [mem_preimage, hω]

variable [StandardBorelSpace Ω]

/-- **σ-algebras generated by almost surely equal maps have almost surely equal regular conditional laws.** -/
theorem ae_condExpKernel_eq_of_ae_eq {X : Type*} [MeasurableSpace X] {f g : Ω → X} (hf : Measurable f)
    (hg : Measurable g) (hfg : f =ᵐ[P] g) :
    ∀ᵐ ω ∂P, condExpKernel P (MeasurableSpace.comap f inferInstance) ω =
      condExpKernel P (MeasurableSpace.comap g inferInstance) ω := by
  have hm₁ := hf.comap_le
  have hm₂ := hg.comap_le
  have hm := sup_le hm₁ hm₂
  have htr₁ := sup_le (LocalSets.le_aeSigma (MeasurableSpace.comap f inferInstance) P) (comap_le_aeSigma hfg)
  have htr₂ := sup_le (comap_le_aeSigma hfg.symm) (LocalSets.le_aeSigma (MeasurableSpace.comap g inferInstance) P)
  -- one measurable set
  have hset : ∀ A : Set Ω, MeasurableSet A →
      ∀ᵐ ω ∂P, condExpKernel P (MeasurableSpace.comap f inferInstance) ω A =
        condExpKernel P (MeasurableSpace.comap g inferInstance) ω A := by
    intro A hA
    have hX : Integrable (A.indicator fun _ => (1 : ℝ)) P := (integrable_const (1 : ℝ)).indicator hA
    filter_upwards [condExpKernel_ae_eq_condExp hm₁ hA, condExpKernel_ae_eq_condExp hm₂ hA,
      condExp_ae_eq_of_le_aeSigma le_sup_left hm htr₁ hX,
      condExp_ae_eq_of_le_aeSigma le_sup_right hm htr₂ hX] with ω e1 e2 e3 e4
    have hreal : (condExpKernel P (MeasurableSpace.comap f inferInstance) ω).real A =
        (condExpKernel P (MeasurableSpace.comap g inferInstance) ω).real A := by
      rw [e1, e2]
      exact e3.trans e4.symm
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).1 hreal
  have : MeasurableSpace.CountablyGenerated Ω := by
    let := upgradeStandardBorel Ω; infer_instance
  obtain ⟨Cp, hc, hpi, hgen⟩ := Exist.Param12.exists_countable_isPiSystem_generate Ω
  have hall : ∀ᵐ ω ∂P, ∀ A ∈ Cp, condExpKernel P (MeasurableSpace.comap f inferInstance) ω A =
      condExpKernel P (MeasurableSpace.comap g inferInstance) ω A :=
    (ae_ball_iff hc).2 fun A hA => hset A (hgen ▸ MeasurableSpace.measurableSet_generateFrom hA)
  filter_upwards [hall] with ω hω
  exact ext_of_generate_finite Cp hgen hpi hω (by rw [measure_univ, measure_univ])

end Kernel

/-! ### Flow-line drivers only see the driver before the lifetime -/

/-- **`IsFlowLineDriver` is insensitive to null modifications of the driver before its lifetime.** -/
theorem isFlowLineDriver_congr_ae {κ : ℝ} {b : ℝ → ℝ} {J : Finset ℝ} {θ : ℝ} {Ω : Type u}
    [mΩ : MeasurableSpace Ω] {Q : Measure Ω} {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}
    {W W' : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} (hfl : IsFlowLineDriver κ b J θ Q h W ζ)
    (hW' : ∀ t, Measurable (W' t))
    (hagree : ∀ᵐ ω ∂Q, W' 0 ω = W 0 ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) < ζ ω → W' t ω = W t ω) :
    IsFlowLineDriver κ b J θ Q h W' ζ := by
  obtain ⟨h', 𝓕, VL, VR, B, htr, hC⟩ := hfl
  have hC' := hC
  obtain ⟨hEv, hrest⟩ := hC'
  have hCa : IsOptionalHullCoupling κ (flowLineXL b J 0) (flowLineXR b J 0) (flowLineRhoL κ b J 0 θ)
      (flowLineRhoR κ b J 0 θ) Q (usualAugmentation 𝓕 Q) W VL VR B ζ h' :=
    ⟨Ito.isIntegratedSLEEvolution_usualAugmentation hEv, hrest⟩
  set 𝓒 : Filtration ℝ≥0 mΩ := Filtration.const ℝ≥0 mΩ le_rfl
  have h𝓒 : 𝓕 ≤ 𝓒 := fun t => 𝓕.le t
  have hζt : ∀ t : ℝ≥0, MeasurableSet {ω | (t : ℝ≥0∞) < ζ ω} := fun t => by
    have h1 := 𝓕.le t _ (hEv.2.1 t univ MeasurableSet.univ)
    simpa only [mem_univ, and_true] using h1
  have hW'a : AdaptedBefore 𝓒 ζ W' := fun t A hA => by
    change MeasurableSet {ω | (t : ℝ≥0∞) < ζ ω ∧ W' t ω ∈ A}
    exact (hζt t).inter (hW' t hA)
  have hX' : IsMeasurableKilledDriving W' VL VR ζ :=
    Coupling.isMeasurableKilledDriving_of_adaptedBefore hW'a
      (fun i => Ito.adaptedBefore_mono h𝓒 (hEv.2.2.1 i)) fun i => Ito.adaptedBefore_mono h𝓒 (hEv.2.2.2.1 i)
  exact ⟨h', usualAugmentation 𝓕 Q, VL, VR, B, htr, IsOptionalHullCoupling.congr_ae hCa
    (fun t N hN h0 => Ito.measurableSet_usualAugmentation_of_null hN h0 t) hX'
    (hagree.mono fun ω hω => ⟨rfl, hω.1, hω.2⟩)⟩

/-! ### The regularized staged history -/

/-- **The regularized history**: every driver regularized for its instruction's own time. -/
def regHist {Ω : Type*} (spec : ExplSpec) (E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞ :=
  fun k ω => regularize (instrTime spec k) (E k ω)

section Hist

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω]
  {spec : ExplSpec} {E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

omit mΩ in
/-- The regularized history is regular at every sample. -/
theorem isRegularDriver_regHist (k : ℕ) (ω : Ω) : IsRegularDriver (regHist spec E k ω) :=
  isRegularDriver_regularize _ _

theorem measurable_regHist (hE : ∀ k, Measurable (E k)) (k : ℕ) : Measurable (regHist spec E k) :=
  (measurable_regularize _).comp (hE k)

omit mΩ in
theorem regHist_snd (k : ℕ) (ω : Ω) : (regHist spec E k ω).2 = (E k ω).2 :=
  regularize_snd _ _

/-- **The regularized history runs through the same states**, almost surely, when the launched pieces are almost
surely continuous from `0` on `[0, min t ζ]` (`StagedPiecesRegular`). -/
theorem ae_run_regHist {P : Measure Ω} (hR : StagedPiecesRegular κ b jumps P spec E) :
    ∀ᵐ ω ∂P, ∀ k, ExplState.run κ b jumps spec (fun j => regHist spec E j ω) k =
      ExplState.run κ b jumps spec (fun j => E j ω) k := by
  filter_upwards [hR.ae_pieceRegular] with ω hω
  exact run_eq_of_canonDrv_eq_on_launch spec fun k c θ hl =>
    canonDrv_regularize (hω k c θ hl).1 (hω k c θ hl).2.1

/-- The retained pasts of the regularized history agree almost surely with those of the history. -/
theorem ae_pastMap_regHist {P : Measure Ω} (hR : StagedPiecesRegular κ b jumps P spec E) (k : ℕ) :
    pastMap κ b jumps spec (regHist spec E) k =ᵐ[P] pastMap κ b jumps spec E k := by
  filter_upwards [ae_run_regHist hR] with ω hω
  unfold pastMap
  rw [hω k]

variable [StandardBorelSpace Ω] {P : Measure Ω} [IsFiniteMeasure P] {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}

/-- **The regularized history of a `StagedPiecesRegular` staged history is a staged history.** -/
theorem isStagedHistory_regHist (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hE : IsStagedHistory κ b jumps P h spec E) (hR : StagedPiecesRegular κ b jumps P spec E) :
    IsStagedHistory κ b jumps P h spec (regHist spec E) := by
  have hm' : ∀ k, Measurable (regHist spec E k) := measurable_regHist hE.1
  have hpm' : ∀ k, Measurable (pastMap κ b jumps spec (regHist spec E) k) := fun k =>
    measurable_pastMap runMeasStatement hb spec (fun j _ => hm' j) (fun j _ ω => isRegularDriver_regHist j ω) k
      le_rfl
  have hpm : ∀ k, Measurable (pastMap κ b jumps spec E k) := fun k => Measurable.of_comap_le (hE.2.1 k)
  refine ⟨hm', fun k => (hpm' k).comap_le, fun k => Eventually.of_forall fun ω =>
    (isRegularDriver_regHist k ω).2.2.2, fun k => ?_⟩
  filter_upwards [hE.2.2.2 k, ae_condExpKernel_eq_of_ae_eq (hpm' k) (hpm k) (ae_pastMap_regHist hR k),
    ae_run_regHist hR] with ω₀ h4 hK hrun c θ hl
  rw [hrun (k + 1)] at hl
  obtain ⟨b', jumps', h', hb', htr, hfl⟩ := h4 c θ hl
  refine ⟨b', jumps', h', hb', htr, ?_⟩
  rw [pastSigma_eq_comap, hK]
  rw [pastSigma_eq_comap] at hfl
  have hζ : (fun ω => (regHist spec E k ω).2) = fun ω => (E k ω).2 := funext fun ω => regHist_snd k ω
  rw [hζ]
  refine isFlowLineDriver_congr_ae hfl (fun t => (measurable_pi_apply t).comp (measurable_fst.comp (hm' k))) ?_
  obtain ⟨_, _, _, _, _, _, hC⟩ := hfl
  filter_upwards [hC.1.2.2.2.2] with ω hp
  exact ⟨regularize_zero _ hp.1, fun t ht => regularize_eq_of_lt _ hp.1 hp.2.2.2.1 ht⟩

end Hist

/-! ### Families of staged histories -/

/-- **The regularized family** of a family of staged histories (one per program). -/
def regFam {Ω : Type*} (E : ExplSpec → ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) : ExplSpec → ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞ :=
  fun spec => regHist spec (E spec)

section Fam

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {P : Measure Ω} [IsFiniteMeasure P] {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}
  {E : ExplSpec → ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}

/-- **Regularization of the staged families of the version-2 Theorem 1.4 anchors** (ruling R51): if every
boundary-continued program has a `StagedPiecesRegular` staged history `E spec`, the regularized family is again a
staged history for every such program, is regular at every sample, and has almost surely the same runs. -/
theorem regFam_spec (hb : IsPiecewiseConstantBoundaryData b jumps)
    (hE : ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 → IsStagedHistory κ b jumps P h spec (E spec))
    (hR : ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 → StagedPiecesRegular κ b jumps P spec (E spec)) :
    (∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 → IsStagedHistory κ b jumps P h spec (regFam E spec)) ∧
      (∀ spec k ω, IsRegularDriver (regFam E spec k ω)) ∧
      ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 → ∀ᵐ ω ∂P, ∀ k,
        ExplState.run κ b jumps spec (fun j => regFam E spec j ω) k =
          ExplState.run κ b jumps spec (fun j => E spec j ω) k :=
  ⟨fun spec hs => isStagedHistory_regHist hb (hE spec hs) (hR spec hs), fun _ k ω => isRegularDriver_regHist k ω,
    fun spec hs => ae_run_regHist (hR spec hs)⟩

omit [StandardBorelSpace Ω] [IsFiniteMeasure P] in
/-- **Transfer along countably many programs**: almost surely the regularized family runs through the same states as
the family for every program of a countable set of boundary-continued programs. -/
theorem ae_run_regFam_countable
    (hR : ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 → StagedPiecesRegular κ b jumps P spec (E spec))
    {S : Set ExplSpec} (hS : S.Countable) (hSb : ∀ spec ∈ S, IsBoundaryContinuedProgram spec.2.2) :
    ∀ᵐ ω ∂P, ∀ spec ∈ S, ∀ k, ExplState.run κ b jumps spec (fun j => regFam E spec j ω) k =
      ExplState.run κ b jumps spec (fun j => E spec j ω) k :=
  (ae_ball_iff hS).2 fun spec hs => ae_run_regHist (hR spec (hSb spec hs))

omit [StandardBorelSpace Ω] [IsFiniteMeasure P] mΩ in
/-- The physical set only sees the final state of the run. -/
theorem physSet_eq_of_run_eq {spec : ExplSpec} {D D' : ℕ → (ℝ≥0 → ℝ) × ℝ≥0∞}
    (h : ExplState.run κ b jumps spec D' spec.2.2.length = ExplState.run κ b jumps spec D spec.2.2.length) :
    ExplState.physSet κ b jumps spec D' = ExplState.physSet κ b jumps spec D := by
  unfold ExplState.physSet
  rw [h]

end Fam

