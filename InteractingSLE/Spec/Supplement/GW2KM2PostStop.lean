import InteractingSLE.Spec.Supplement.GW2KM2StopLaw
import InteractingSLE.Spec.Exist.StagedLawKernel

/-!
# One stage of the canonical construction at a stopping time, under the conditional law given the past

Packet PROVE-GW2-KMODELS2, part (II). On the canonical space of GW2's joint chart the relative pieces switch at random
times (stopping times of the pieces). This file proves one stage of the staged law there, in the iterable form of
`Exist.StagedLaw.post_stage` (deterministic times), for the canonical (field-determined) pieces of
`GW2Schedule.wordDrv`:

* the past is a measurable map `p : Ω → S` into a standard Borel space; the current field is `F`; conditionally on the
  past, on the alive event `{p ∈ A}`, `F` is a GFF with the data of the word `Wβ (p)`;
* the piece is the canonical flow line `E = wordDrv θ (Wβ p) F`, stopped at `T = τ (p, E)`, where for each past `x`
  the time `τ x` is decided by the killed path (`IsKilledStopFunctional`);
* **`ae_condExp_recField_post_stop`**: given the enlarged past `(p, recOf T E)`, on `{p ∈ A} ∩ {min T ζ < ∞}` the field
  read in the record chart has the Gaussian characteristic functional of `stopWord κ (Wβ p, θ, recOf T E)`;
* **`ae_isGFF_post_stop`**: the same in the form needed for the next stage — under the regular conditional law given
  the enlarged past, the next field is a GFF with the data of the next word.

The proof applies the single-stage law at a stopping time (`ae_condExp_recField_stop`, `GW2KM2StopLaw`) under the
regular conditional law given the past (where the past is almost surely constant, so `T` differs from the stopping
time `τ (p ω₀) ∘ E` only on a null set, which the usual augmentation contains), the canonical driver being an optional
hull coupling of the conditional GFF (`Exist.Staged.isOptionalHullCoupling_drv`), and the kernel tower
`Exist.StagedLaw.ae_condExp_eq_of_condExpKernel`.

R48: Theorem 1.4 only; Theorems 1.2–1.3 enter as the hypotheses `h12p`, `h13` (the canonical driver's coupling).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE.Theorem14.GW2KM2

open QuantumZipper Exist Exist.StagedLaw Staged Restart LQGMetric GW2Schedule

/-! ### Stopping functionals of the killed path -/

/-- The σ-algebra on driver space `(path, lifetime)` generated by the killed coordinates up to time `t`. -/
@[instance_reducible]
def pathKilledSigma (t : ℝ≥0) : MeasurableSpace ((ℝ≥0 → ℝ) × ℝ≥0∞) :=
  MeasurableSpace.generateFrom
    {S | ∃ r ≤ t, ∃ A : Set ℝ, MeasurableSet A ∧ S = {e : (ℝ≥0 → ℝ) × ℝ≥0∞ | (r : ℝ≥0∞) < e.2 ∧ e.1 r ∈ A}}

/-- A set of paths decided by the killed path up to `t` pulls back to an event of the killed driver up to `t`. -/
theorem measurableSet_killedDriverSigma_preimage {Ω : Type*} (E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (t : ℝ≥0)
    {S : Set ((ℝ≥0 → ℝ) × ℝ≥0∞)} (hS : MeasurableSet[pathKilledSigma t] S) :
    MeasurableSet[killedDriverSigma (fun s ω => (E ω).1 s) (fun ω => (E ω).2) t] (E ⁻¹' S) := by
  have h : MeasurableSpace.comap E (pathKilledSigma t) ≤
      killedDriverSigma (fun s ω => (E ω).1 s) (fun ω => (E ω).2) t := by
    rw [pathKilledSigma, MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨S', ⟨r, hr, A, hA, rfl⟩, rfl⟩
    exact MeasurableSpace.measurableSet_generateFrom ⟨r, hr, A, hA, rfl⟩
  exact h _ ⟨S, hS, rfl⟩

/-! ### The stage objects -/

section Stage

variable {κ : ℝ} (hκ : 0 < κ) (h12p : Theorem12ParamStatement.{u}) (θ : ℝ) {Ω S : Type*}
  (Wβ : S → BoundaryWord) (p : Ω → S) (F : Ω → DistOn upperHalfPlaneOpens)
  (τ : S → (ℝ≥0 → ℝ) × ℝ≥0∞ → ℝ≥0∞)

/-- The canonical piece of the current field `F` at angle `θ`, for the word read from the past. -/
def stageDrv (ω : Ω) : (ℝ≥0 → ℝ) × ℝ≥0∞ := wordDrv hκ h12p θ (Wβ (p ω)) (F ω)

/-- The record of the canonical piece stopped at the time `τ (past, piece)`. -/
def stageRec (ω : Ω) : RecData :=
  recOf (τ (p ω) (stageDrv hκ h12p θ Wβ p F ω)) (stageDrv hκ h12p θ Wβ p F ω)

theorem stageDrv_apply (ω : Ω) : stageDrv hκ h12p θ Wβ p F ω = wordDrv hκ h12p θ (Wβ (p ω)) (F ω) := rfl

theorem stageRec_apply (ω : Ω) :
    stageRec hκ h12p θ Wβ p F τ ω =
      recOf (τ (p ω) (stageDrv hκ h12p θ Wβ p F ω)) (stageDrv hκ h12p θ Wβ p F ω) := rfl

theorem isRegularDriver_stageDrv (ω : Ω) : IsRegularDriver (stageDrv hκ h12p θ Wβ p F ω) :=
  isRegularDriver_wordDrv hκ h12p θ _ _

variable [MeasurableSpace Ω] [MeasurableSpace S]

theorem measurable_stageDrv {Wβ : S → BoundaryWord} (hWβ : Measurable Wβ) {p : Ω → S} (hp : Measurable p)
    {F : Ω → DistOn upperHalfPlaneOpens} (hF : Measurable F) : Measurable (stageDrv hκ h12p θ Wβ p F) := by
  have h := (measurable_wordDrv hκ h12p θ).comp ((hWβ.comp hp).prodMk hF)
  exact h

theorem measurable_stageRec {Wβ : S → BoundaryWord} (hWβ : Measurable Wβ) {p : Ω → S} (hp : Measurable p)
    {F : Ω → DistOn upperHalfPlaneOpens} (hF : Measurable F) {τ : S → (ℝ≥0 → ℝ) × ℝ≥0∞ → ℝ≥0∞}
    (hτm : Measurable fun x : S × ((ℝ≥0 → ℝ) × ℝ≥0∞) => τ x.1 x.2) :
    Measurable (stageRec hκ h12p θ Wβ p F τ) := by
  have hE := measurable_stageDrv hκ h12p θ hWβ hp hF
  have hT : Measurable fun ω => τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) := hτm.comp (hp.prodMk hE)
  have h := measurable_recOf_joint hE (isRegularDriver_stageDrv hκ h12p θ Wβ p F) hT
  exact h

end Stage

/-! ### One stage -/

section Post

variable {κ : ℝ} (hκ : 0 < κ) (h12p : Theorem12ParamStatement.{u}) (h13 : Theorem13Statement.{u}) (θ : ℝ)
  {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {S : Type*} [MeasurableSpace S] [StandardBorelSpace S]

include h13 in
/-- **One stage at a stopping time, under the conditional law given the past.** If, conditionally on the past `p`, on
the alive event `{p ∈ A}` the current field `F` is a GFF with the data of the word `Wβ p`, and the stop of the
canonical piece `E = wordDrv θ (Wβ p) F` is `τ (p, E)` with each `τ x` decided by the killed path, then given the
enlarged past `(p, recOf T E)`, on `{p ∈ A} ∩ {min T ζ < ∞}` the field read in the record chart has the Gaussian
characteristic functional of the word `stopWord κ (Wβ p, θ, recOf T E)`. -/
theorem ae_condExp_recField_post_stop {p : Ω → S} (hp : Measurable p) {F : Ω → DistOn upperHalfPlaneOpens}
    (hF : Measurable F) {Wβ : S → BoundaryWord} (hWβ : Measurable Wβ) {A : Set S} (hA : MeasurableSet A)
    (hker : ∀ᵐ ω₀ ∂P, p ω₀ ∈ A →
      IsGFFWithBoundaryData (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀) F
        (Wβ (p ω₀)).fn (Wβ (p ω₀)).jumps)
    {τ : S → (ℝ≥0 → ℝ) × ℝ≥0∞ → ℝ≥0∞} (hτm : Measurable fun x : S × ((ℝ≥0 → ℝ) × ℝ≥0∞) => τ x.1 x.2)
    (hτ : ∀ x (t : ℝ≥0), MeasurableSet[pathKilledSigma t] {e | τ x e ≤ (t : ℝ≥0∞)})
    (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂P, p ω ∈ A → (stageRec hκ h12p θ Wβ p F τ ω).2.1 ≠ ⊤ →
      P[fun ω' => Complex.exp (Complex.I * (recField κ (stageRec hκ h12p θ Wβ p F τ ω') (F ω') φ : ℂ)) |
          MeasurableSpace.comap (fun ω' => (p ω', stageRec hκ h12p θ Wβ p F τ ω')) inferInstance] ω =
        gaussCF (stopWord κ (Wβ (p ω), θ, stageRec hκ h12p θ Wβ p F τ ω)) φ := by
  classical
  have hEm := measurable_stageDrv hκ h12p θ hWβ hp hF
  have hEreg := isRegularDriver_stageDrv hκ h12p θ Wβ p F
  have hTm : Measurable fun ω => τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) := hτm.comp (hp.prodMk hEm)
  have hRm := measurable_stageRec hκ h12p θ hWβ hp hF hτm
  have hatom := ae_ae_eq_of_comap (P := P) hp
  have hN : MeasurableSet {r : RecData | r.2.1 ≠ ⊤} :=
    (measurableSet_eq_fun (measurable_fst.comp measurable_snd) measurable_const).compl
  have hXm : Measurable fun ω' => Complex.exp (Complex.I *
      (recField κ (stageRec hκ h12p θ Wβ p F τ ω') (F ω') φ : ℂ)) := by
    have h1 := measurable_recField_comp κ hRm hF
    have h2 := GFF.measurable_exp_I_mul ((measurable_distOn_apply φ).comp h1)
    exact h2
  have hGm : Measurable fun x : S × RecData => gaussCF (stopWord κ (Wβ x.1, θ, x.2)) φ :=
    (measurable_gaussCF φ).comp ((measurable_stopWord κ).comp ((hWβ.comp measurable_fst).prodMk
      (measurable_const.prodMk measurable_snd)))
  have hL : MeasurableSet[MeasurableSpace.comap p inferInstance] (p ⁻¹' A) := ⟨A, hA, rfl⟩
  have hK := ae_condExp_eq_of_condExpKernel (P := P) (Φ := id) (Ψ := id) hp hRm (hp.prodMk hRm) measurable_id
    measurable_id (fun ω => rfl) hL (fun ω _ => ⟨rfl, rfl⟩) hN hXm
    (fun ω => (Complex.norm_exp_I_mul_ofReal _).le) hGm (fun x => norm_gaussCF_le _ φ) ?hk
  · filter_upwards [hK] with ω hω hA' hfin using hω hA' hfin
  -- the kernel statement: the single-stage law under the conditional law given the past
  filter_upwards [hker, hatom] with ω₀ hgff hat hA₀
  set ν := condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀ with hν
  set c := Wβ (p ω₀) with hc
  have hgff₀ := hgff hA₀
  have hPC : IsPiecewiseConstantBoundaryData c.fn c.jumps := c.isPiecewiseConstantBoundaryData
  have hgff' := isGFFWithBoundaryData_flowField hκ hPC 0 θ hgff₀
  have hCeq : ∀ᵐ ω ∂ν, stageDrv hκ h12p θ Wβ p F ω = drvOf (detCode (paramΦ h12p hκ (flowLineNL c.fn c.jumps 0)
      (flowLineNR c.fn c.jumps 0)) (((flowLineXL c.fn c.jumps 0, flowLineXR c.fn c.jumps 0),
        (flowLineRhoL κ c.fn c.jumps 0 θ, flowLineRhoR κ c.fn c.jumps 0 θ)),
        flowField 0 (θ * QuantumZipper.chiC κ) (F ω))) := by
    filter_upwards [hat] with ω hω
    change wordDrv hκ h12p θ (Wβ (p ω)) (F ω) = _
    rw [hω]
    simp only [wordDrv, stagedDrv, wNL, wNR, wPad, truncWord_padFL]
    rfl
  obtain ⟨𝓕, VL, VR, B, hcoup⟩ := isOptionalHullCoupling_drv h12p h13 hκ
    (Theorem15.isOrderedForceWord_flowLine _ _ 0) hgff' hEm hCeq
  have htr : ∀ ω, IsTranslateAddConst 0 (θ * QuantumZipper.chiC κ) (F ω)
      (flowField 0 (θ * QuantumZipper.chiC κ) (F ω)) := fun ω => isTranslateAddConst_flowField 0 _ (F ω)
  obtain ⟨hX, -⟩ := hcoup.2.2.2
  -- the stop is a stopping time of the driving filtration under `ν` (it differs from `τ (p ω₀) ∘ E` on a null set)
  have hT : IsStoppingTime (drivingFiltration ν hX)
      ((fun ω => τ (p ω) (stageDrv hκ h12p θ Wβ p F ω)) : Ω → WithTop ℝ≥0) := by
    intro t
    change MeasurableSet[drivingFiltration ν hX t]
      {ω | τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)}
    have hNm : MeasurableSet {ω | p ω ≠ p ω₀} := (hp (measurableSet_singleton (p ω₀))).compl
    have hN0 : ν {ω | p ω ≠ p ω₀} = 0 := ae_iff.1 hat
    have h1 : MeasurableSet[drivingFiltration ν hX t]
        {ω | τ (p ω₀) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)} :=
      killedDriverSigma_le_drivingFiltration ν hX t _
        (measurableSet_killedDriverSigma_preimage (stageDrv hκ h12p θ Wβ p F) t (hτ (p ω₀) t))
    have h2 : MeasurableSet[drivingFiltration ν hX t] {ω | p ω ≠ p ω₀} :=
      Ito.measurableSet_usualAugmentation_of_null hNm hN0 t
    have h3 : MeasurableSet[drivingFiltration ν hX t]
        ({ω | τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)} ∩ {ω | p ω ≠ p ω₀}) :=
      Ito.measurableSet_usualAugmentation_of_null ((measurableSet_le hTm measurable_const).inter hNm)
        (measure_mono_null inter_subset_right hN0) t
    have e : {ω | τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)} =
        ({ω | τ (p ω₀) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)} ∩ {ω | p ω ≠ p ω₀}ᶜ) ∪
          ({ω | τ (p ω) (stageDrv hκ h12p θ Wβ p F ω) ≤ (t : ℝ≥0∞)} ∩ {ω | p ω ≠ p ω₀}) := by
      ext ω
      by_cases hω : p ω = p ω₀ <;> simp [hω]
    rw [e]
    exact (h1.inter h2.compl).union h3
  have hlaw := ae_condExp_recField_stop hκ c θ ν F (stageDrv hκ h12p θ Wβ p F) hEm hEreg htr hcoup hX hTm hT φ
  filter_upwards [hlaw] with ω h hRN
  exact h hRN

include h13 in
/-- **The next stage's conditional field law.** In the setting of `ae_condExp_recField_post_stop`, for almost every
`ω₀` with `p ω₀ ∈ A` and a finite stop, under the regular conditional law given the enlarged past `(p, recOf T E)`, the
field read in the record chart is a GFF with the data of the next word `stopWord κ (Wβ (p ω₀), θ, recOf T E (ω₀))`. -/
theorem ae_isGFF_post_stop {p : Ω → S} (hp : Measurable p) {F : Ω → DistOn upperHalfPlaneOpens}
    (hF : Measurable F) {Wβ : S → BoundaryWord} (hWβ : Measurable Wβ) {A : Set S} (hA : MeasurableSet A)
    (hker : ∀ᵐ ω₀ ∂P, p ω₀ ∈ A →
      IsGFFWithBoundaryData (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀) F
        (Wβ (p ω₀)).fn (Wβ (p ω₀)).jumps)
    {τ : S → (ℝ≥0 → ℝ) × ℝ≥0∞ → ℝ≥0∞} (hτm : Measurable fun x : S × ((ℝ≥0 → ℝ) × ℝ≥0∞) => τ x.1 x.2)
    (hτ : ∀ x (t : ℝ≥0), MeasurableSet[pathKilledSigma t] {e | τ x e ≤ (t : ℝ≥0∞)}) :
    ∀ᵐ ω₀ ∂P, ω₀ ∈ {ω | p ω ∈ A ∧ (stageRec hκ h12p θ Wβ p F τ ω).2.1 ≠ ⊤} →
      IsGFFWithBoundaryData
        (condExpKernel P (MeasurableSpace.comap (fun ω' => (p ω', stageRec hκ h12p θ Wβ p F τ ω')) inferInstance) ω₀)
        (fun ω => recField κ (stageRec hκ h12p θ Wβ p F τ ω) (F ω))
        (stopWord κ (Wβ (p ω₀), θ, stageRec hκ h12p θ Wβ p F τ ω₀)).fn
        (stopWord κ (Wβ (p ω₀), θ, stageRec hκ h12p θ Wβ p F τ ω₀)).jumps := by
  have hRm := measurable_stageRec hκ h12p θ hWβ hp hF hτm
  have hπ : Measurable fun ω' => (p ω', stageRec hκ h12p θ Wβ p F τ ω') := hp.prodMk hRm
  have hY : Measurable fun ω => recField κ (stageRec hκ h12p θ Wβ p F τ ω) (F ω) := by
    have h1 := measurable_recField_comp κ hRm hF
    exact h1
  refine ae_isGFFWithBoundaryData_condExpKernel (P := P) hπ.comap_le
    (M := {ω | p ω ∈ A ∧ (stageRec hκ h12p θ Wβ p F τ ω).2.1 ≠ ⊤})
    (β := fun ω => stopWord κ (Wβ (p ω), θ, stageRec hκ h12p θ Wβ p F τ ω))
    (Eventually.of_forall fun ω _ => isSorted_stopWord κ _) hY fun φ => ?_
  filter_upwards [ae_condExp_recField_post_stop hκ h12p h13 θ hp hF hWβ hA hker hτm hτ φ] with ω h hω
  exact h hω.1 hω.2

end Post

end InteractingSLE.Theorem14.GW2KM2
