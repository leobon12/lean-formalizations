/-!
# Union-mean inputs under the reflection `R(z) = −z̄`

Packet PROVE-SB2-LCMEAN (Theorem 1.4's SB2(2), the mean identification). SB2(2)'s union mean lives in a configuration
whose retained set lies on the LEFT of the explored piece (the mirror image of SB2(1)'s, supplement p. 631: "Use S2,
reflected"). It is obtained from FIN's union mean (`FinRel.ae_chartTransport_eq_couplingMean_of_relConfigJK`) by the
reflection `R(z) = −z̄`. This file collects the generic, geometry-free transfer steps that the landed reflection
library (`Sec7.FlowReflect*`, `Restart.FCPlumb.FCKerD.*Refl*`, `Lf.reflChart`) does not state yet:

* `isZeroBoundaryGFF_reflField`: the zero-boundary GFF is reflection invariant (as a law);
* `lowerUnion_image_reflectC`, `forall_not_isBounded_component_reflect`: the unbounded-component hypothesis of the
  union mean is reflection invariant;
* `comap_image_reflectC`, `comap_reflField`: the σ-algebras generated by reflected sets and fields;
* `continuousOn_lift_reflChart`, **`chartTransport_reflChart`**: for a conformal chart `c` with continuous lift, the
  chart transport in the reflected chart `Lf.reflChart c` of `−G ∘ R` is the reflected chart transport (additive
  constant `a ↦ −a`);
* `harmonicOnNhd_neg_comp_reflectC`, `integral_comp_reflTest`, **`rep_of_reflField_rep`**: a harmonic
  representative of `−g ∘ R` off `R(S)` gives one of `g` off `S`.

R48: serves Theorem 1.4 only.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology Complex
open scoped ComplexConjugate
open QuantumZipper (H)
open LQGMetric (DistOn TestOn)
open SupercriticalConformalCovariance.GM24 (smoothDist)

universe u

namespace InteractingSLE.Theorem14.SB.Lm

open LP (reflectC)
open Sec7.FlowReflect (reflField reflTest)
open LocalSets WholeField

/-! ### Fields and σ-algebras -/

/-- **The zero-boundary GFF is reflection invariant**: `−X ∘ R` is a zero-boundary GFF when `X` is. -/
theorem isZeroBoundaryGFF_reflField {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {X : Ω → DistOn upperHalfPlaneOpens} (hX : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens X P) :
    LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens (fun ω => reflField (X ω)) P := by
  refine ⟨Sec7.FlowReflect.measurable_reflField.comp hX.measurable, ?_⟩
  have h := Sec7.FlowReflect.isZBGFFProcess_reflField (P := P) (h := X) (u := fun _ => 0) (by
    simpa using hX.process)
  simpa using h

/-- The σ-algebra generated by a reflected random set is the one generated by the set. -/
theorem comap_image_reflectC {Ω : Type*} (A : Ω → Set ℂ) :
    MeasurableSpace.comap (fun ω => reflectC '' A ω) hittingSigma = MeasurableSpace.comap A hittingSigma := by
  change MeasurableSpace.comap ((fun S : Set ℂ => reflectC '' S) ∘ A) hittingSigma = _
  rw [← MeasurableSpace.comap_comp, Sec7.FlowReflect.comap_eq_of_involutive'
    Sec7.FlowReflect.measurable_image_reflectC Sec7.FlowReflect.imageReflectC_involutive]

/-- The σ-algebra generated by a reflected random field is the one generated by the field. -/
theorem comap_reflField {Ω : Type*} (X : Ω → DistOn upperHalfPlaneOpens) :
    MeasurableSpace.comap (fun ω => reflField (X ω)) (inferInstance : MeasurableSpace (DistOn upperHalfPlaneOpens)) =
      MeasurableSpace.comap X inferInstance := by
  change MeasurableSpace.comap (reflField ∘ X) _ = _
  rw [← MeasurableSpace.comap_comp, Sec7.FlowReflect.comap_eq_of_involutive' Sec7.FlowReflect.measurable_reflField
    Sec7.FlowReflect.reflField_involutive]

/-! ### Unbounded components -/

/-- The lower union of a reflected set is the reflected lower union. -/
theorem lowerUnion_image_reflectC (S : Set ℂ) : lowerUnion (reflectC '' S) = reflectC '' lowerUnion S := by
  ext z
  simp only [lowerUnion, mem_union, mem_image, mem_ofPred_eq]
  constructor
  · rintro (⟨w, hw, rfl⟩ | hz)
    · exact ⟨w, Or.inl hw, rfl⟩
    · exact ⟨reflectC z, Or.inr (by rwa [LP.im_reflectC]), LP.reflectC_reflectC z⟩
  · rintro ⟨w, (hw | hw), rfl⟩
    · exact Or.inl ⟨w, hw, rfl⟩
    · exact Or.inr (by rwa [LP.im_reflectC])

theorem isBounded_image_reflectC {S : Set ℂ} (hS : Bornology.IsBounded S) : Bornology.IsBounded (reflectC '' S) :=
  (Sec7.FlowReflect.reflLIE.isometry.lipschitzWith).isBounded_image hS

/-- **The unbounded-component hypothesis of the union mean is reflection invariant.** -/
theorem forall_not_isBounded_component_reflect {S : Set ℂ}
    (h : ∀ z ∈ lowerUnion S, ¬ Bornology.IsBounded (connectedComponentIn (lowerUnion S) z)) :
    ∀ z ∈ lowerUnion (reflectC '' S),
      ¬ Bornology.IsBounded (connectedComponentIn (lowerUnion (reflectC '' S)) z) := by
  intro z hz hb
  rw [lowerUnion_image_reflectC] at hz hb
  obtain ⟨w, hw, rfl⟩ := hz
  have e : reflectC '' connectedComponentIn (lowerUnion S) w =
      connectedComponentIn (reflectC '' lowerUnion S) (reflectC w) :=
    LP.reflectHomeo.image_connectedComponentIn hw
  rw [← e] at hb
  have hb' := isBounded_image_reflectC hb
  rw [Sec7.FlowReflect.reflectC_image_image] at hb'
  exact h w hw hb'

/-! ### Charts -/

theorem continuousOn_lift_reflChart {c : Chart} (hc : c.IsConformal) (hℓ : ContinuousOn c.2.2 c.dom) :
    ContinuousOn (Lf.reflChart c).2.2 (Lf.reflChart c).dom := by
  have hmaps : MapsTo Supp9B.refl ((Lf.reflChart c).dom : Set ℂ) (c.dom : Set ℂ) := by
    intro z hz
    rw [(Lf.isConformal_reflChart hc).coe_dom] at hz
    rw [hc.coe_dom]
    obtain ⟨y, hy, rfl⟩ := hz
    exact ⟨Supp9B.refl y, Lf.refl_mem_H hy, by simp only [Lf.reflChart_inv, Supp9B.refl_refl]⟩
  exact (hℓ.comp Supp9B.continuous_refl.continuousOn hmaps).neg

/-- **The chart transport in the reflected chart is the reflected chart transport** (generic form of
`FCKerD.chartTransport_reflPair`; the additive constant changes sign). -/
theorem chartTransport_reflChart {c : Chart} (hc : c.IsConformal) (hℓ : ContinuousOn c.2.2 c.dom) (a k : ℝ)
    (G : DistOn upperHalfPlaneOpens) :
    Chart.chartTransport (Lf.isConformal_reflChart hc) 1 (-a) k (reflField G) =
      reflField (Chart.chartTransport hc 1 a k G) := by
  have hc' := Lf.isConformal_reflChart hc
  have hℓ' := continuousOn_lift_reflChart hc hℓ
  have hO : IsOpen ((Lf.reflChart c).2.1 '' H) := hc'.isOpen_image
  have hT := Chart.isChartTransport_chartTransport hc
    (Chart.locallyIntegrableOn_of_continuousOn (hc.continuousOn_lift_inv hℓ)) 1 a k G
  have hT' := Chart.isChartTransport_chartTransport hc'
    (Chart.locallyIntegrableOn_of_continuousOn (hc'.continuousOn_lift_inv hℓ')) 1 (-a) k (reflField G)
  exact hT'.unique hc' (Restart.FCPlumb.FCKerD.isChartTransport_reflect_of' hO (fun z _ => rfl) (fun w _ => rfl)
    (fun z _ => rfl) hT)

/-! ### Harmonic representatives -/

/-- `z ↦ −w(R z)` is harmonic off `S` when `w` is harmonic off `R(S)`. -/
theorem harmonicOnNhd_neg_comp_reflectC {w : ℂ → ℝ} {S : Set ℂ}
    (hw : InnerProductSpace.HarmonicOnNhd w (H \ reflectC '' S)) :
    InnerProductSpace.HarmonicOnNhd (fun z => -w (reflectC z)) (H \ S) := by
  have h := Sec7.FlowReflect.harmonicOnNhd_comp_reflectC hw
  rw [LP.H_diff_reflectC_image, Sec7.FlowReflect.reflectC_image_image] at h
  exact h.neg

/-- The test support of a reflected test function lies off `R(S)` when the test lies off `S`. -/
theorem tsupport_reflTest_subset {φ : TestOn upperHalfPlaneOpens} {S : Set ℂ} (hφ : tsupport φ ⊆ H \ S) :
    tsupport (reflTest φ) ⊆ H \ reflectC '' S := by
  rw [Sec7.FlowReflect.tsupport_reflTest, LP.H_diff_reflectC_image]
  exact image_mono hφ

theorem integral_mul_reflTest (w : ℂ → ℝ) (φ : TestOn upperHalfPlaneOpens) :
    ∫ z, w z * reflTest φ z = ∫ z, w (reflectC z) * φ z := by
  rw [← Sec7.FlowReflect.integral_comp_reflectC (fun z => w z * reflTest φ z)]
  simp only [Sec7.FlowReflect.reflTest_apply, LP.reflectC_reflectC]

/-- **A harmonic representative of `−g ∘ R` off `R(S)` gives one of `g` off `S`**: `z ↦ −w(R z)`. -/
theorem rep_of_reflField_rep {g : DistOn upperHalfPlaneOpens} {S : Set ℂ} {w : ℂ → ℝ}
    (hrep : ∀ φ : TestOn upperHalfPlaneOpens, tsupport φ ⊆ H \ reflectC '' S → reflField g φ = ∫ z, w z * φ z) :
    ∀ φ : TestOn upperHalfPlaneOpens, tsupport φ ⊆ H \ S → g φ = ∫ z, -w (reflectC z) * φ z := by
  intro φ hφ
  have e := hrep (reflTest φ) (tsupport_reflTest_subset hφ)
  rw [Sec7.FlowReflect.reflField_apply, Sec7.FlowReflect.reflTest_reflTest, integral_mul_reflTest] at e
  simp only [neg_mul]
  rw [integral_neg, ← e, neg_neg]

end InteractingSLE.Theorem14.SB.Lm
