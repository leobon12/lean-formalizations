/-!
# Leaf 3, the first continuation: (III-a) in the charts shifted to the first tip

Packet PROVE-T15-ORDDET2 (Theorem 1.5's leaf 3, `RLC.RetOrdDetFstStatement`; supplement p. 497, Lemma G7 for the first
current tip, as in Lemma W2's proof, p. 531).

The retained charts of `Supp7.RetData` are centred at the SECOND tip `η₂(r)`. At a later line `(u + t, r)` of the first
continuation, with `τ₀` the chart point of the first tip `η₁(u)` (the seed `tipPos` of the first canonical retained
clock) and `τ₁` that of the later first tip `η₁(u + t)`, the charts shifted to the first tip, `w ↦ ψ₀(w + τ₀)` and
`w ↦ ψ₁(w + τ₁)`, are again hydrodynamic charts (the landed `Supp7.IsDomChart.shift`), and the transition between them
is the centred Loewner map of the first continuation's chart path:

* **`retChart_trans_fst`**: `ψ₁(w + τ₁) = ψ₀(f_Q⁻¹(w) + τ₀)` on `ℍ`, with the chain rule for the lifts — the
  hypothesis form (III-a) of `RetAux79.hasSafeLaw_of_retLines` for the first continuation, in tip-shifted charts
  (`RetAux79.chartComp_of_trace` applied to the shifted charts; the later first tip is a single prime end by its
  regular-point uniqueness, `RLC.isChartRegularPoint_tip₁`).

For Theorem 1.5; uses nothing beyond landed deterministic chart facts (R43/R48).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Filter Topology Complex
open scoped NNReal ENNReal

open QuantumZipper (H Hbar fwdMap fwdMapInv fwdHull logDerivFwd)

namespace InteractingSLE

namespace RLC

namespace OrdDet

open Supp7 Restart

/-- **(III-a) for the first continuation, in the charts shifted to the first tip.** Retained data `d` (cutoffs
`(u, r)`) and `d'` (cutoffs `(u + t, r)`) of the same paths, a sample of both chart events, a chart path `γ` of the
first continuation from the seed `τ₀` (generated by a continuous driver `W` from `0`, injective, `0 < Q <` its
lifetime, tracing `η₁([u, u + t])` through `w ↦ ψ₀(w + τ₀)` and ending at the later first tip), and a chart point
`τ₁` of the later first tip `η₁(u + t)` in the later chart (injective first prefix, off the second prefix). Then
`ψ₁(w + τ₁) = ψ₀(f_Q⁻¹(w) + τ₀)` on `ℍ`, with the chain rule for the canonical lifts. -/
theorem retChart_trans_fst {Ω : Type*} [MeasurableSpace Ω] {d d' : RetData Ω} (hd : d.IsMeasGood)
    (hd' : d'.IsMeasGood) (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) {t : ℝ≥0} (hu : d'.u = d.u + t)
    (hr : d'.r = d.r) {ω : Ω} (hω : ω ∈ d.E) (hω' : ω ∈ d'.E) {τ₀ τ₁ : ℝ} {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ}
    {ζc : ℝ≥0∞} {Q : ℝ≥0} (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0)
    (hinj : InjOn γ {s | (s : ℝ≥0∞) ≤ ζc}) (hQ : (Q : ℝ≥0∞) < ζc) (hQ0 : 0 < Q)
    (himg : (fun s => d.inv ω (γ s + τ₀)) '' Icc 0 Q = d.η₁ ω '' Icc d.u (d.u + t))
    (htip : d.inv ω (γ Q + τ₀) = d.η₁ ω (d.u + t)) (hτ₁ : d'.inv ω τ₁ = d.η₁ ω (d.u + t))
    (hi₁ : InjOn (d.η₁ ω) (Icc 0 (d.u + t))) (hq₁ : d.η₁ ω (d.u + t) ∉ d.η₂ ω '' Icc 0 d.r) :
    (∀ w ∈ H, d'.inv ω (w + τ₁) = d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w + τ₀)) ∧
    ∀ w ∈ H, d'.lift ω (d'.inv ω (w + τ₁)) =
      (logDerivFwd (fun s : ℝ => W s.toNNReal) Q (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)).im +
        d.lift ω (d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w + τ₀)) := by
  obtain ⟨⟨x₀, hx₀⟩, hC₀⟩ := hd.isRetChart hω
  obtain ⟨⟨x₁, hx₁⟩, hC₁⟩ := hd'.isRetChart hω'
  have hgd := hd.good ω (RetData.E_subset_G hω)
  have hgd' := hd'.good ω (RetData.E_subset_G hω')
  have hK₀ := RetData.K_of_mem hω
  have hK₁ := RetData.K_of_mem hω'
  have hD₀ : IsDomChart (d.K ω) (fun z => ConformalImage.mapOut (fillH (d.K ω)) z - x₀) (d.inv ω) := by
    have h := hC₀.isDomChart hgd.2.2.2.2.2.1 (by rw [← hK₀]; exact (hd.isCompact_K ω).isClosed)
    rw [← hK₀] at h
    have hf : d.fwd ω = fun z => ConformalImage.mapOut (fillH (d.K ω)) z - x₀ := by
      funext z; rw [RetData.fwd, hx₀]; rfl
    rwa [hf] at h
  have hD₁ : IsDomChart (d'.K ω) (fun z => ConformalImage.mapOut (fillH (d'.K ω)) z - x₁) (d'.inv ω) := by
    have h := hC₁.isDomChart hgd'.2.2.2.2.2.1 (by rw [← hK₁]; exact (hd'.isCompact_K ω).isClosed)
    rw [← hK₁] at h
    have hf : d'.fwd ω = fun z => ConformalImage.mapOut (fillH (d'.K ω)) z - x₁ := by
      funext z; rw [RetData.fwd, hx₁]; rfl
    rwa [hf] at h
  have hK₁' : d'.K ω = prefixSet (d.η₁ ω) (d.u + t) (d.η₂ ω) d.r := by rw [hK₁, h₁, h₂, hu, hr]
  have hKP : fillH (d.K ω) ⊆ fillH (d'.K ω) := by
    refine fillH_mono ?_
    rw [hK₀, hK₁']
    exact union_subset_union_left _ (image_mono (Icc_subset_Icc_right le_self_add))
  have himg' : (fun w => d.inv ω (w + τ₀)) '' (γ '' Icc 0 Q) = d.η₁ ω '' Icc d.u (d.u + t) := by
    rw [image_image]; exact himg
  have hPK : d'.K ω ⊆ d.K ω ∪ (fun w => d.inv ω (w + τ₀)) '' (γ '' Icc 0 Q) := by
    rw [hK₁', himg', hK₀]
    rintro z (⟨s, hs, rfl⟩ | hz)
    · rcases le_total s d.u with hsu | hus
      · exact Or.inl (Or.inl ⟨s, ⟨zero_le, hsu⟩, rfl⟩)
      · exact Or.inr ⟨s, ⟨hus, hs.2⟩, rfl⟩
    · exact Or.inl (Or.inr hz)
  have hγP : ∀ s ∈ Icc 0 Q, (fun w => d.inv ω (w + τ₀)) (γ s) ∈ d'.K ω := by
    intro s hs
    have h : d.inv ω (γ s + τ₀) ∈ d.η₁ ω '' Icc d.u (d.u + t) := himg ▸ ⟨s, hs, rfl⟩
    rw [hK₁']
    exact Or.inl (image_mono (Icc_subset_Icc_left zero_le) h)
  have h0₂' : (d'.η₂ ω 0).im = 0 := hgd'.2.2.2.2.2.1
  have hreg : IsChartRegularPoint (d'.η₁ ω) d'.u (d'.η₂ ω) d'.r (d'.η₁ ω d'.u) := by
    refine RLC.isChartRegularPoint_tip₁ hgd'.1 hgd'.2.1 hgd'.2.2.2.2.1 h0₂' ?_ ?_
    · rw [h₁, h₂, hu, hr]; exact hq₁
    · rw [h₁, hu]; exact hi₁
  have htip' : (fun w => d.inv ω (w + τ₀)) (γ Q) = (fun w => d'.inv ω (w + τ₁)) 0 := by
    simp only [zero_add]
    rw [htip, hτ₁]
  have hτH : ((τ₁ : ℝ) : ℂ) ∈ Hbar := mem_Hbar_of_im_eq_zero (by simp)
  have hτ₁' : d'.inv ω τ₁ = d'.η₁ ω d'.u := by rw [hτ₁, h₁, hu]
  have huniq : ∀ w ∈ Hbar, (fun w => d'.inv ω (w + τ₁)) w = (fun w => d'.inv ω (w + τ₁)) 0 → w = 0 := by
    intro w hw he
    simp only [zero_add] at he
    have hwH : w + (τ₁ : ℂ) ∈ Hbar := by
      show (0 : ℝ) ≤ (w + τ₁).im
      simpa using (show (0 : ℝ) ≤ w.im from hw)
    have h := RLC.eq_of_inv_eq_of_regular hC₁ h0₂' hreg hτH hτ₁' hwH (he.trans hτ₁')
    simpa using h
  have hshift : ∀ (K : Set ℂ) (x τ : ℝ) (ψ : ℂ → ℂ),
      IsDomChart K (fun z => ConformalImage.mapOut (fillH K) z - x) ψ →
      IsDomChart K (fun z => ConformalImage.mapOut (fillH K) z - ((x + τ : ℝ) : ℂ)) (fun w => ψ (w + τ)) := by
    intro K x τ ψ hD
    have e : (fun z => ConformalImage.mapOut (fillH K) z - ((x + τ : ℝ) : ℂ)) =
        fun z => (fun z => ConformalImage.mapOut (fillH K) z - x) z - τ := by
      funext z; push_cast; ring
    rw [e]
    exact hD.shift τ
  obtain ⟨hinv, hlift⟩ := RetAux79.chartComp_of_trace (hd'.isCompact_K ω) (hd.isHPHull ω) (hd'.isHPHull ω) hKP
    (hshift _ _ τ₀ _ hD₀) (hshift _ _ τ₁ _ hD₁) hg hWc hW0 hinj hQ hQ0 hPK hγP htip' huniq
  exact ⟨hinv, hlift⟩

/-- **The first tip's chart point.** At a sample of the chart event where the first prefix is injective, its tip is off
the second prefix and adherent to the active domain, the forward chart tends to the real point `tipPos` at the first
tip, and the chart inverse sends `tipPos` back to the first tip (its regular-point uniqueness). This is the premise
`hτ₁` of `retChart_trans_fst` with `τ₁ = tipPos d' d'.η₁ ω`. -/
theorem inv_tipPos_eq {Ω : Type*} [MeasurableSpace Ω] {d : RetData Ω} (hd : d.IsMeasGood) {ω : Ω}
    (hω : ω ∈ d.E) (hi : InjOn (d.η₁ ω) (Icc 0 d.u)) (hq : d.η₁ ω d.u ∉ d.η₂ ω '' Icc 0 d.r)
    (hcl : d.η₁ ω d.u ∈ closure (activeDomain (d.η₁ ω) d.u (d.η₂ ω) d.r)) :
    d.inv ω (tipPos d d.η₁ ω) = d.η₁ ω d.u ∧
      Tendsto (d.fwd ω) (𝓝[d.D ω] (d.η₁ ω d.u)) (𝓝 (tipPos d d.η₁ ω : ℂ)) := by
  have hC := (hd.isRetChart hω).2
  have hgd := hd.good ω (RetData.E_subset_G hω)
  have h0₂ : (d.η₂ ω 0).im = 0 := hgd.2.2.2.2.2.1
  have hreg := RLC.isChartRegularPoint_tip₁ hgd.1 hgd.2.1 hgd.2.2.2.2.1 h0₂ hq hi
  obtain ⟨w, hwHb, hlim, hψw, -⟩ := hC.exists_tendsto_of_regular h0₂ hcl hreg
  have hD := hd.D_of_mem hω
  rw [← hD] at hlim hcl
  have hwre : w.im = 0 := by
    refine le_antisymm (not_lt.1 fun hwH => ?_) hwHb
    have hmem := (hC.bijOn h0₂).mapsTo (show w ∈ H from hwH)
    rw [hψw] at hmem
    exact (notMem_of_mem_activeDomain hmem).2.1 ⟨d.u, ⟨zero_le, le_rfl⟩, rfl⟩
  have hNe : (𝓝[d.D ω] (d.η₁ ω d.u)).NeBot := mem_closure_iff_nhdsWithin_neBot.1 hcl
  have htp : ((tipPos d d.η₁ ω : ℝ) : ℂ) = w := by
    apply Complex.ext
    · simp only [ofReal_re, tipPos, hlim.limUnder_eq]
    · simp only [ofReal_im, hwre]
  rw [htp]
  exact ⟨hψw, hlim⟩

