/-!
# Stopped histories of paths and Galmarino stopping times (Lemma 6.2, deterministic part)

Packet PROVE-SEC6-A3 (specification §6.1, `source/spec/p145-192.md`, `#lem-6.2`, p. 155).

The proof of Lemma 6.2 uses three facts about a continuous path `η` started outside an open set
`U` and its first entrance time `T^U = inf{t : η(t) ∈ U}`:
* the path through `T^U` avoids `U`, and `η([0, τ]) ∩ U = ∅ ⟺ τ ≤ T^U`;
* "given the earlier histories, the comparison `τ_j ≤ T_j^U` is determined by the history of `η_j`
  through `T_j^U`, because `τ_j` is a stopping time for the indicated enlarged filtration";
* on `{τ_j ≤ T_j^U}`, the history through `τ_j` is determined by the history through `T_j^U`.

Paths are recorded through their rational-time coordinates `c = (η(q))_{q ∈ ℚ≥0}` (which determine
a continuous path), and the stopped history through a time `T` is the pair
`(T, (η(q))_{q ≤ T})` (`stopCoord`, padded with `0` after `T`). A stopping time of the filtration
generated by earlier stopped histories `p` and the path `η` is written in canonical (Galmarino)
form: `τ = S(p, c)` with `S` measurable and `S(p, c') = S(p, c)` whenever `c' = c` at all rational
times `≤ S(p, c)` (Galmarino's test; `IsGalmarino`). With this form the second and third facts are
the deterministic `reconstruct` lemmas below, and no version of Galmarino's theorem is needed.

## Main definitions and results

* `pathCoord`, `stopCoord`, `firstEntrance` (`= inf{t : η(t) ∈ U}` for continuous paths,
  `firstEntrance_eq_sInf`);
* `disjoint_range_iff_le_firstEntrance`: `η([0, τ]) ∩ U = ∅ ⟺ τ ≤ T^U`;
* `IsGalmarino`, `prevHist`, `reconStage`, `recon`;
* `forall_le_iff_recon` : `(∀ j, τ_j ≤ T_j) ⟺ (∀ j, recon_j ≤ T_j)`, and then `recon = τ`.
-/

set_option autoImplicit false

noncomputable section

open Set MeasureTheory Filter Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec6

/-! ### Coordinates and stopped histories -/

/-- The rational-time coordinates of a path. -/
def pathCoord (γ : ℝ≥0 → ℂ) : ℚ≥0 → ℂ := fun q => γ q

/-- The coordinates of the path stopped at `T`: `c q` for `q ≤ T`, and `0` afterwards. -/
def stopCoord (c : ℚ≥0 → ℂ) (T : ℝ≥0∞) : ℚ≥0 → ℂ :=
  fun q => if (((q : ℝ≥0) : ℝ≥0∞) ≤ T) then c q else 0

/-- The type of stopped histories `(T, (η(q))_{q ≤ T})`. -/
abbrev Hist : Type := ℝ≥0∞ × (ℚ≥0 → ℂ)

/-- The stopped history of the coordinates `c` through `T`. -/
def histOf (c : ℚ≥0 → ℂ) (T : ℝ≥0∞) : Hist := (T, stopCoord c T)

theorem stopCoord_of_le {c : ℚ≥0 → ℂ} {T : ℝ≥0∞} {q : ℚ≥0} (hq : (((q : ℝ≥0) : ℝ≥0∞) ≤ T)) :
    stopCoord c T q = c q := ite_eq_left hq

theorem stopCoord_stopCoord {c : ℚ≥0 → ℂ} {τ T : ℝ≥0∞} (hτT : τ ≤ T) :
    stopCoord (stopCoord c T) τ = stopCoord c τ := by
  funext q
  unfold stopCoord
  by_cases hq : (((q : ℝ≥0) : ℝ≥0∞) ≤ τ)
  · rw [ite_eq_left hq, ite_eq_left hq, ite_eq_left (hq.trans hτT)]
  · rw [ite_eq_right hq, ite_eq_right hq]

theorem measurable_stopCoord : Measurable fun p : Hist => stopCoord p.2 p.1 := by
  refine Measurable.of_eval fun q => ?_
  have hs : MeasurableSet {p : Hist | (((q : ℝ≥0) : ℝ≥0∞) ≤ p.1)} :=
    measurableSet_le measurable_const measurable_fst
  exact Measurable.ite hs ((measurable_pi_apply q).comp measurable_snd) measurable_const

theorem measurable_histOf : Measurable fun p : Hist => histOf p.2 p.1 :=
  measurable_fst.prodMk measurable_stopCoord

/-! ### First entrance times -/

/-- The first entrance time of the coordinates `c` into `U`, through rational times. For a
continuous path and an open `U` this is `inf{t ≥ 0 : η(t) ∈ U}` (`firstEntrance_eq_sInf`). -/
def firstEntrance (U : Set ℂ) (c : ℚ≥0 → ℂ) : ℝ≥0∞ :=
  ⨅ (q : ℚ≥0) (_ : c q ∈ U), (((q : ℝ≥0) : ℝ≥0∞))

theorem measurable_firstEntrance {U : Set ℂ} (hU : MeasurableSet U) :
    Measurable (firstEntrance U) := by
  classical
  unfold firstEntrance
  refine Measurable.iInf fun q => ?_
  have : (fun c : ℚ≥0 → ℂ => ⨅ (_ : c q ∈ U), (((q : ℝ≥0) : ℝ≥0∞))) =
      fun c => if c q ∈ U then (((q : ℝ≥0) : ℝ≥0∞)) else ⊤ := by
    funext c
    by_cases h : c q ∈ U
    · rw [ite_eq_left h, iInf_pos h]
    · rw [ite_eq_right h, iInf_neg h]
  rw [this]
  have hs : MeasurableSet {c : ℚ≥0 → ℂ | c q ∈ U} := (measurable_pi_apply q) hU
  exact Measurable.ite hs measurable_const measurable_const

theorem firstEntrance_le {U : Set ℂ} {c : ℚ≥0 → ℂ} {q : ℚ≥0} (hq : c q ∈ U) :
    firstEntrance U c ≤ (((q : ℝ≥0) : ℝ≥0∞)) :=
  iInf₂_le q hq

/-- Before its first entrance time, a continuous path started outside the open set `U` stays
outside `U`, up to and including the first entrance time. -/
theorem notMem_of_le_firstEntrance {U : Set ℂ} (hU : IsOpen U) {γ : ℝ≥0 → ℂ}
    (hγ : Continuous γ) (h0 : γ 0 ∉ U) {t : ℝ≥0}
    (ht : (t : ℝ≥0∞) ≤ firstEntrance U (pathCoord γ)) : γ t ∉ U := by
  intro htU
  rcases eq_or_ne t 0 with rfl | ht0
  · exact h0 htU
  -- rational times slightly before `t` are in `U`
  have hev : ∀ᶠ s in 𝓝 t, γ s ∈ U := hγ.continuousAt.eventually (hU.mem_nhds htU)
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hev
  have htpos : (0 : ℝ) < t := lt_of_le_of_ne t.2 (fun h => ht0 (NNReal.eq h.symm))
  obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (show max 0 ((t : ℝ) - ε) < t by
    rw [max_lt_iff]; exact ⟨htpos, by linarith⟩)
  have hr0 : (0 : ℝ) ≤ r := (le_max_left _ _).trans hr1.le
  set q : ℚ≥0 := r.toNNRat with hqdef
  have hqt : ((q : ℝ≥0) : ℝ) = r := by
    rw [show ((q : ℝ≥0) : ℝ) = ((q : ℚ) : ℝ) by norm_cast, hqdef, Rat.coe_toNNRat r (by exact_mod_cast hr0)]
  have hm := (le_max_right 0 ((t : ℝ) - ε)).trans_lt hr1
  have hqU : γ q ∈ U := by
    refine hball ?_
    rw [NNReal.dist_eq, hqt, abs_sub_lt_iff]
    constructor
    · linarith
    · linarith
  have h1 := (firstEntrance_le (U := U) (c := pathCoord γ) hqU).trans' ht
  have h2 : (t : ℝ≥0∞) ≤ ((q : ℝ≥0) : ℝ≥0∞) := h1
  rw [ENNReal.coe_le_coe, ← NNReal.coe_le_coe, hqt] at h2
  linarith

/-- **`η([0, τ]) ∩ U = ∅ ⟺ τ ≤ T^U`** for a continuous path started outside the open set `U`. -/
theorem disjoint_range_iff_le_firstEntrance {U : Set ℂ} (hU : IsOpen U) {γ : ℝ≥0 → ℂ}
    (hγ : Continuous γ) (h0 : γ 0 ∉ U) (τ : ℝ≥0∞) :
    (∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ τ → γ t ∉ U) ↔ τ ≤ firstEntrance U (pathCoord γ) := by
  constructor
  · intro h
    by_contra hlt
    rw [not_le] at hlt
    unfold firstEntrance at hlt
    obtain ⟨q, hq⟩ := iInf_lt_iff.1 hlt
    obtain ⟨hqU, hqτ⟩ := iInf_lt_iff.1 hq
    exact h q hqτ.le hqU
  · intro hτ t ht
    exact notMem_of_le_firstEntrance hU hγ h0 (ht.trans hτ)

/-- For a continuous path and an open set, the rational first entrance time is the first entrance
time `inf{t ≥ 0 : η(t) ∈ U}`. -/
theorem firstEntrance_eq_sInf {U : Set ℂ} (hU : IsOpen U) {γ : ℝ≥0 → ℂ} (hγ : Continuous γ) :
    firstEntrance U (pathCoord γ) = ⨅ (t : ℝ≥0) (_ : γ t ∈ U), (t : ℝ≥0∞) := by
  refine le_antisymm ?_ ?_
  · refine le_iInf₂ fun t ht => ?_
    -- rational times slightly after `t` are in `U`
    have hev : ∀ᶠ s in 𝓝 t, γ s ∈ U := hγ.continuousAt.eventually (hU.mem_nhds ht)
    obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hev
    refine le_of_forall_gt fun b hb => ?_
    -- find a rational `q ∈ [t, t + ε)` with `q < b`
    obtain ⟨b', hb'1, hb'2⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hb
    have htb' : (t : ℝ) < b' := by exact_mod_cast (ENNReal.coe_lt_coe.1 hb'1)
    obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (show (t : ℝ) < min (b' : ℝ) (t + ε) by
      rw [lt_min_iff]; exact ⟨htb', by linarith⟩)
    have hr0 : (0 : ℝ) ≤ r := t.2.trans hr1.le
    set q : ℚ≥0 := r.toNNRat with hqdef
    have hqt : ((q : ℝ≥0) : ℝ) = r := by
      rw [show ((q : ℝ≥0) : ℝ) = ((q : ℚ) : ℝ) by norm_cast, hqdef, Rat.coe_toNNRat r (by exact_mod_cast hr0)]
    have hm := hr2.trans_le (min_le_right _ _)
    have hqU : γ q ∈ U := by
      refine hball ?_
      rw [NNReal.dist_eq, hqt, abs_sub_lt_iff]
      constructor
      · linarith
      · linarith
    refine (firstEntrance_le (U := U) (c := pathCoord γ) hqU).trans_lt ?_
    refine lt_of_lt_of_le ?_ hb'2.le
    rw [ENNReal.coe_lt_coe, ← NNReal.coe_lt_coe, hqt]
    exact hr2.trans_le (min_le_left _ _)
  · exact le_iInf₂ fun q hq => iInf₂_le (q : ℝ≥0) hq

/-! ### Galmarino stopping times and the reconstruction from first-entrance histories -/

variable {k : ℕ}

/-- **Galmarino's property** of a path functional `S(p, c)` (`p`: earlier stopped histories, `c`:
coordinates of the current path): `S(p, c)` only depends on `c` up to time `S(p, c)`. This is the
canonical form of a stopping time of the filtration generated by `p` and the path. -/
def IsGalmarino (S : (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) : Prop :=
  ∀ p c c', (∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ S p c) → c q = c' q) → S p c' = S p c

/-- The earlier stopped histories `(τ_i, η_i|_{[0, τ_i]})_{i < j}` (the default `(0, 0)` for
`i ≥ j`). -/
def prevHist (c : Fin k → ℚ≥0 → ℂ) (τ : Fin k → ℝ≥0∞) (j : Fin k) : Fin k → Hist :=
  fun i => if i < j then histOf (c i) (τ i) else (0, 0)

theorem prevHist_congr {c c' : Fin k → ℚ≥0 → ℂ} {τ τ' : Fin k → ℝ≥0∞} {j : Fin k}
    (h : ∀ i, i < j → τ i = τ' i ∧ stopCoord (c i) (τ i) = stopCoord (c' i) (τ' i)) :
    prevHist c τ j = prevHist c' τ' j := by
  funext i
  unfold prevHist histOf
  by_cases hij : i < j
  · rw [ite_eq_left hij, ite_eq_left hij, (h i hij).1, ← (h i hij).1, (h i hij).2, (h i hij).1]
  · rw [ite_eq_right hij, ite_eq_right hij]

/-- The stages of the reconstruction of the stopping times `τ_j` from the histories `x_j` through
the first entrance times: stage `n + 1` computes `τ_n = S_n(p_n, c_n)` from the stopped
coordinates `c_n` of `x_n` and the reconstructed earlier histories `p_n`. -/
def reconStage (S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) (x : Fin k → Hist) :
    ℕ → Fin k → ℝ≥0∞
  | 0 => fun _ => 0
  | n + 1 => fun i => if (i : ℕ) = n then
      S i (prevHist (fun i => (x i).2) (reconStage S x n) i) (x i).2 else reconStage S x n i

/-- The reconstructed stopping times. -/
def recon (S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) (x : Fin k → Hist) :
    Fin k → ℝ≥0∞ :=
  reconStage S x k

theorem reconStage_stable (S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) (x : Fin k → Hist)
    (i : Fin k) {n : ℕ} (hn : (i : ℕ) < n) : reconStage S x n i = reconStage S x ((i : ℕ) + 1) i := by
  induction n with
  | zero => exact absurd hn (Nat.not_lt_zero _)
  | succ n ih =>
    rcases Nat.lt_succ_iff_lt_or_eq.1 hn with h | h
    · have e : reconStage S x (n + 1) i = reconStage S x n i := by
        simp only [reconStage]
        exact ite_eq_right (Nat.ne_of_lt h)
      rw [e, ih h]
    · subst h; rfl

theorem recon_eq_reconStage (S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) (x : Fin k → Hist)
    (i : Fin k) {n : ℕ} (hn : (i : ℕ) < n) : recon S x i = reconStage S x n i := by
  rw [recon, reconStage_stable S x i i.2, reconStage_stable S x i hn]

/-- The fixed-point equation of the reconstruction. -/
theorem recon_eq (S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞) (x : Fin k → Hist)
    (j : Fin k) :
    recon S x j = S j (prevHist (fun i => (x i).2) (recon S x) j) (x j).2 := by
  rw [recon_eq_reconStage S x j (Nat.lt_succ_self _)]
  simp only [reconStage, ↓reduceIte]
  congr 1
  refine prevHist_congr fun i hij => ?_
  have hlt : (i : ℕ) < j := hij
  rw [recon_eq_reconStage S x i hlt]
  exact ⟨rfl, rfl⟩

theorem measurable_prevHist_aux (j : Fin k) :
    Measurable fun p : (Fin k → ℚ≥0 → ℂ) × (Fin k → ℝ≥0∞) => prevHist p.1 p.2 j := by
  refine Measurable.of_eval fun i => ?_
  unfold prevHist
  by_cases hij : i < j
  · simp only [ite_eq_left hij]
    have hm : Measurable fun p : (Fin k → ℚ≥0 → ℂ) × (Fin k → ℝ≥0∞) => ((p.2 i, p.1 i) : Hist) :=
      ((measurable_pi_apply i).comp measurable_snd).prodMk
        ((measurable_pi_apply i).comp measurable_fst)
    exact measurable_histOf.comp hm
  · simp only [ite_eq_right hij]
    exact measurable_const

theorem measurable_reconStage {S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞}
    (hS : ∀ j, Measurable (Function.uncurry (S j))) (n : ℕ) :
    Measurable fun x : Fin k → Hist => reconStage S x n := by
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
    refine Measurable.of_eval fun i => ?_
    simp only [reconStage]
    by_cases hin : (i : ℕ) = n
    · simp only [ite_eq_left hin]
      have hc : Measurable fun x : Fin k → Hist => fun i => (x i).2 :=
        Measurable.of_eval fun i => measurable_snd.comp (measurable_pi_apply i)
      exact (hS i).comp (((measurable_prevHist_aux i).comp (hc.prodMk ih)).prodMk
        (measurable_snd.comp (measurable_pi_apply i)))
    · simp only [ite_eq_right hin]
      exact (measurable_pi_apply i).comp ih

theorem measurable_recon {S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞}
    (hS : ∀ j, Measurable (Function.uncurry (S j))) :
    Measurable (recon S) :=
  measurable_reconStage hS k

/-- **The Galmarino transfer** (the induction step of Lemma 6.2's proof). Let `τ_j = S_j(p_j, c_j)`
be Galmarino stopping times of the paths with coordinates `c_j` (`p_j` the earlier stopped
histories), and let `x_j = (T_j, c_j|_{[0, T_j]})` be the histories through times `T_j`. Then
`τ_j ≤ T_j` for all `j` if and only if the reconstruction from the `x_j` satisfies
`recon_j ≤ T_j` for all `j`, and in that case `recon = τ`. -/
theorem forall_le_iff_recon {S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞}
    (hS : ∀ j, IsGalmarino (S j)) {c : Fin k → ℚ≥0 → ℂ} {τ T : Fin k → ℝ≥0∞}
    (hτ : ∀ j, τ j = S j (prevHist c τ j) (c j)) :
    ((∀ j, τ j ≤ T j) ↔ ∀ j, recon S (fun i => histOf (c i) (T i)) j ≤ T j) ∧
      ((∀ j, τ j ≤ T j) → recon S (fun i => histOf (c i) (T i)) = τ) := by
  set x : Fin k → Hist := fun i => histOf (c i) (T i) with hx
  set r := recon S x with hr
  -- the inductive statement along the index
  have key : ∀ n : ℕ, ∀ j : Fin k, (j : ℕ) < n →
      ((∀ i : Fin k, (i : ℕ) ≤ j → τ i ≤ T i) → r j = τ j) ∧
      ((∀ i : Fin k, (i : ℕ) ≤ j → r i ≤ T i) → r j = τ j) := by
    intro n
    induction n with
    | zero => intro j hj; exact absurd hj (Nat.not_lt_zero _)
    | succ n ih =>
      intro j hj
      -- the earlier reconstructed histories agree with the true ones under either hypothesis
      have hprev : ∀ (hyp : ∀ i : Fin k, (i : ℕ) < j → r i = τ i ∧ τ i ≤ T i),
          prevHist (fun i => (x i).2) r j = prevHist c τ j := by
        intro hyp
        refine prevHist_congr fun i hij => ?_
        obtain ⟨hri, hiT⟩ := hyp i hij
        refine ⟨hri, ?_⟩
        rw [hri, hx]
        exact stopCoord_stopCoord hiT
      have hrj : r j = S j (prevHist (fun i => (x i).2) r j) (x j).2 := recon_eq S x j
      have hagree : ∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ T j) → c j q = (x j).2 q :=
        fun q hq => (stopCoord_of_le hq).symm
      constructor
      · intro hall
        have hyp : ∀ i : Fin k, (i : ℕ) < j → r i = τ i ∧ τ i ≤ T i := by
          intro i hij
          refine ⟨(ih i (lt_of_lt_of_le hij (Nat.lt_succ_iff.1 hj))).1
            fun i' hi' => hall i' (hi'.trans hij.le), hall i hij.le⟩
        rw [hrj, hprev hyp, hτ j]
        exact hS j _ _ _ fun q hq => hagree q (hq.trans (by rw [← hτ j]; exact hall j le_rfl))
      · intro hall
        have hyp : ∀ i : Fin k, (i : ℕ) < j → r i = τ i ∧ τ i ≤ T i := by
          intro i hij
          have hri := (ih i (lt_of_lt_of_le hij (Nat.lt_succ_iff.1 hj))).2
            fun i' hi' => hall i' (hi'.trans hij.le)
          exact ⟨hri, hri ▸ hall i hij.le⟩
        have hle : r j ≤ T j := hall j le_rfl
        rw [hrj, hprev hyp] at hle ⊢
        rw [hτ j]
        exact (hS j (prevHist c τ j) (x j).2 (c j) fun q hq => (hagree q (hq.trans hle)).symm).symm
  have key' : ∀ j : Fin k, ((∀ i : Fin k, (i : ℕ) ≤ j → τ i ≤ T i) → r j = τ j) ∧
      ((∀ i : Fin k, (i : ℕ) ≤ j → r i ≤ T i) → r j = τ j) := fun j => key k j j.2
  refine ⟨⟨fun h j => ?_, fun h j => ?_⟩, fun h => funext fun j => (key' j).1 fun i _ => h i⟩
  · rw [(key' j).1 fun i _ => h i]; exact h j
  · rw [← (key' j).2 fun i _ => h i]; exact h j

end InteractingSLE.Sec6
