import InteractingSLE.Spec.Sec6.DrivingSimple
import InteractingSLE.Foundations.Loewner.YuanCharacterisationSimple

/-!
# Section 6.2: Proposition 6.12 without conditions

Packet PROVE-YUAN-M23, bridge module. `DrivingCriterion.lean` (PROVE-SEC6-B) proves Proposition
6.12 (`source/spec/p193-240.md`, printed pp. 210–212) conditional on the literature input
`YuanDriverInput` ([Yua22, Theorem 1.1, (iii) ⇒ (i)] with Loewner's theorem for locally growing
hull families). `yuanDriverInput` proves that input
(`YuanCharacterisation.exists_loewner_of_simpleApprox`), so the conditional helpers become
unconditional.

## Main results

* `yuanDriverInput : YuanDriverInput`.
* `exists_driver_of_drivingCriteria`: **Proposition 6.12** on `[0, S]`: a continuous path `η`
  with `η 0 = 0`, non-crossing in the specification's sense (`HasSimpleApproxOn`) and satisfying
  criteria (a) and (b), is generated by a Loewner chain with a continuous driver after the
  half-plane-capacity time change.
* `exists_driver_of_injOn`: the case of simple paths (Lemma 6.13 and Remarks 6.14–6.15 after their
  geometric reductions in `DrivingSimple.lean`).
-/

set_option autoImplicit false

noncomputable section

open Complex Set Metric Filter Topology

open QuantumZipper (H Hbar)

namespace InteractingSLE.Sec6

/-- **[Yua22, Theorem 1.1, (iii) ⇒ (i)] with the Loewner transform**: the input of Proposition
6.12 holds. -/
theorem yuanDriverInput : YuanDriverInput := by
  intro η S hS hc h0 hmono hnc
  obtain ⟨γ, hγ, hconv⟩ := hnc
  exact YuanCharacterisation.exists_loewner_of_simpleApprox hS hc h0 hmono hγ hconv

variable {η : ℝ → ℂ} {S : ℝ}

/-- **Proposition 6.12** on `[0, S]`. Let `η` be continuous on `[0, S]`, `η 0 = 0`, non-crossing
(`HasSimpleApproxOn`), and satisfy criteria (a) and (b). Then there are a continuous driver `W`,
`W 0 = 0`, and a continuous strictly increasing time change `σ`, `σ 0 = 0`, such that for every
`t ∈ [0, S]`: `0 ≤ σ t`, the Loewner hull of `W` at time `σ t` is `K_t = fill(η[0, t])`, and
`g_t = f_{σ t} + W(σ t)` maps out `K_t`. -/
theorem exists_driver_of_drivingCriteria (hS : 0 < S) (hc : ContinuousOn η (Icc 0 S))
    (h0 : η 0 = 0) (hnc : HasSimpleApproxOn η S) (ha : DrivingCriterionA η S)
    (hb : DrivingCriterionB η S) :
    ∃ W : ℝ → ℝ, Continuous W ∧ W 0 = 0 ∧ ∃ σ : ℝ → ℝ, σ 0 = 0 ∧ StrictMonoOn σ (Icc 0 S) ∧
      ContinuousOn σ (Icc 0 S) ∧ ∀ t ∈ Icc 0 S, 0 ≤ σ t ∧
        QuantumZipper.fwdHull W (σ t) = fillH (η '' Icc 0 t) ∧
        IsMapOut (fillH (η '' Icc 0 t)) (fun z => QuantumZipper.fwdMap W (σ t) z + W (σ t)) :=
  exists_driver_of_drivingCriteria_of_yuanDriverInput yuanDriverInput hS hc h0 hnc ha hb

/-- **A continuous driver for a simple path** (Lemma 6.13 and Remarks 6.14–6.15 after their
geometric reductions). -/
theorem exists_driver_of_injOn {D : Set ℝ} (hD : D.OrdConnected) (hc : ContinuousOn η D)
    (hinj : InjOn η D) (hH : MapsTo η D Hbar) (h0D : (0 : ℝ) ∈ D) (h0 : η 0 = 0)
    (hunb : ∀ u ∈ D, ¬ Bornology.IsBounded (η '' (D ∩ Ici u)))
    (hR : interior {u ∈ D | 0 < u ∧ (η u).im = 0} = ∅) {S : ℝ} (hS : 0 < S) (hSD : S ∈ D) :
    ∃ W : ℝ → ℝ, Continuous W ∧ W 0 = 0 ∧ ∃ σ : ℝ → ℝ, σ 0 = 0 ∧ StrictMonoOn σ (Icc 0 S) ∧
      ContinuousOn σ (Icc 0 S) ∧ ∀ t ∈ Icc 0 S, 0 ≤ σ t ∧
        QuantumZipper.fwdHull W (σ t) = fillH (η '' Icc 0 t) ∧
        IsMapOut (fillH (η '' Icc 0 t)) (fun z => QuantumZipper.fwdMap W (σ t) z + W (σ t)) :=
  exists_driver_of_injOn_of_yuanDriverInput yuanDriverInput hD hc hinj hH h0D h0 hunb hR hS hSD

end InteractingSLE.Sec6
