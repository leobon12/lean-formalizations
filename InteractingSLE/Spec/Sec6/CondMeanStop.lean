/-! ### Conditional independence from almost-sure measurability -/

section CondIndep

variable {Ω : Type*} {𝓗 𝓐 𝓑 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  [IsFiniteMeasure P]

/-- σ-algebras all of whose events are almost surely events of `𝓗` are conditionally independent of
every σ-algebra given `𝓗`. -/
theorem condIndepEv_of_le_aeSigma (h𝓗 : 𝓗 ≤ mΩ) (h𝓑 : 𝓑 ≤ mΩ)
    (hA : 𝓐 ≤ aeSigma 𝓗 P) : CondIndepEv 𝓗 𝓐 𝓑 P := by
  intro a b ha hb
  obtain ⟨a', ha', haa'⟩ := hA a ha
  have hbm : MeasurableSet b := h𝓑 b hb
  have h1 : P⟦a ∩ b | 𝓗⟧ =ᵐ[P] P⟦a' ∩ b | 𝓗⟧ :=
    condExp_congr_ae (indicator_ae_eq_of_ae_eq_set (haa'.inter (EventuallyEq.refl _ b)))
  have h2 : P⟦a' ∩ b | 𝓗⟧ =ᵐ[P] a'.indicator (P⟦b | 𝓗⟧) := by
    have e : (a' ∩ b).indicator (fun _ => (1 : ℝ)) = a'.indicator (b.indicator fun _ => 1) := by
      rw [indicator_indicator, inter_comm]
    rw [e]
    exact condExp_indicator ((integrable_const (1 : ℝ)).indicator hbm) ha'
  have h3 : P⟦a | 𝓗⟧ =ᵐ[P] a'.indicator (fun _ => (1 : ℝ)) := by
    refine (condExp_congr_ae (indicator_ae_eq_of_ae_eq_set haa')).trans ?_
    rw [condExp_of_stronglyMeasurable h𝓗
      (@StronglyMeasurable.indicator Ω ℝ (fun _ => (1 : ℝ)) 𝓗 _ _ stronglyMeasurable_const _ ha')
      ((integrable_const (1 : ℝ)).indicator (h𝓗 _ ha'))]
  filter_upwards [h1, h2, h3] with ω e1 e2 e3
  rw [Pi.mul_apply, e1, e2, e3]
  by_cases hω : ω ∈ a'
  · simp [indicator_of_mem hω]
  · simp [indicator_of_notMem hω]

end CondIndep

/-! ### Definitions -/

section Defs

variable {Ω : Type*}

/-- The σ-algebra of the pair `(1_E, Y on E)` (`Y` replaced by a cemetery off `E`): generated by
the sets `E ∩ {Y ∈ B}`. -/
@[instance_reducible]
def markedHistSigma {X : Type*} [MeasurableSpace X] (E : Set Ω) (Y : Ω → X) :
    MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | ∃ B : Set X, MeasurableSet B ∧ s = E ∩ Y ⁻¹' B}

/-- The path avoids `U` up to time `T`: `η([0, T]) ∩ U = ∅`. -/
def AvoidsUpTo (γ : ℝ≥0 → ℂ) (T : ℝ≥0∞) (U : Set ℂ) : Prop :=
  ∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ T → γ t ∉ U

/-- The ℍ-part of the explored set `⋃_i η_i([0, τ_i])` (a relatively closed subset of `ℍ` stands for
its union with `∂ℍ`, as for `IsLocalSet`). -/
def explored {k : ℕ} (η : Fin k → Ω → ℝ≥0 → ℂ) (τ : Fin k → Ω → ℝ≥0∞) (ω : Ω) : Set ℂ :=
  (⋃ i, η i ω '' {t : ℝ≥0 | (t : ℝ≥0∞) ≤ τ i ω}) ∩ H

/-- **Right-continuous Galmarino property** of a path functional: `S(c)` depends only on the path
up to any time `s > S(c)`. This is the canonical form of a stopping time of the right-continuous
filtration `(𝓕_{t+})` of a path (e.g. the first entrance time of an open set). -/
def IsOptionalGalmarino (S : (ℚ≥0 → ℂ) → ℝ≥0∞) : Prop :=
  ∀ c c' (s : ℝ≥0∞), S c < s → (∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ s) → c q = c' q) → S c' = S c

variable [MeasurableSpace Ω]

/-- **The history-sensitive locality of Lemma 6.2**, for all stopping times of `(𝓕_{t+})`: for every
deterministic open `U ⊆ ℍ` (with a Borel version `G` of the projection onto `H(U)`) and every stopping
time `T = S(η)` (`S` measurable, right-continuous Galmarino), with `E = {η([0, T]) ∩ U = ∅}`, given
`h_{U^c} = h − G h` the pair `(1_E, η|_{[0,T]} on E)` is conditionally independent of `h_U = G h`. -/
def IsHistoryLocal (η : Ω → ℝ≥0 → ℂ) (h : Ω → DistOn upperHalfPlaneOpens) (P : Measure Ω) :
    Prop :=
  ∀ (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens),
    (U : Set ℂ) ⊆ H → Measurable G →
      GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P →
      ∀ S : (ℚ≥0 → ℂ) → ℝ≥0∞, Measurable S → IsOptionalGalmarino S →
        CondIndepEv (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
          (markedHistSigma {ω | AvoidsUpTo (η ω) (S (pathCoord (η ω))) U}
            (fun ω => histOf (pathCoord (η ω)) (S (pathCoord (η ω)))))
          (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance) P

/-- The history-sensitive locality at first entrance times `T^U` only (what the proof of Lemma 6.2
uses). -/
def IsEntranceHistoryLocal (η : Ω → ℝ≥0 → ℂ) (h : Ω → DistOn upperHalfPlaneOpens)
    (P : Measure Ω) : Prop :=
  ∀ (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens),
    (U : Set ℂ) ⊆ H → Measurable G →
      GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P →
      CondIndepEv (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
        (markedHistSigma {ω | AvoidsUpTo (η ω) (firstEntrance U (pathCoord (η ω))) U}
          (fun ω => histOf (pathCoord (η ω)) (firstEntrance U (pathCoord (η ω)))))
        (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance) P

end Defs

/-- The first entrance time of an open set is a stopping time of `(𝓕_{t+})` (right-continuous
Galmarino property). -/
theorem isOptionalGalmarino_firstEntrance (U : Set ℂ) : IsOptionalGalmarino (firstEntrance U) := by
  intro c c' s hs hcc'
  -- a rational entrance time before `s`
  obtain ⟨q₀, hq₀⟩ := iInf_lt_iff.1 hs
  obtain ⟨hq₀U, hq₀s⟩ := iInf_lt_iff.1 hq₀
  have hagree : ∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ s) → (c q ∈ U ↔ c' q ∈ U) := fun q hq => by
    rw [hcc' q hq]
  refine le_antisymm ?_ ?_
  · refine le_iInf₂ fun q hq => ?_
    by_cases hqs : (((q : ℝ≥0) : ℝ≥0∞) ≤ s)
    · exact firstEntrance_le ((hagree q hqs).1 hq)
    · exact (firstEntrance_le ((hagree q₀ hq₀s.le).1 hq₀U)).trans (hq₀s.le.trans (not_le.1 hqs).le)
  · refine le_iInf₂ fun q hq => ?_
    by_cases hqs : (((q : ℝ≥0) : ℝ≥0∞) ≤ s)
    · exact firstEntrance_le ((hagree q hqs).2 hq)
    · exact hs.le.trans (not_le.1 hqs).le

/-- The source's hypothesis (for all stopping times of `(𝓕_{t+})`) implies the hypothesis at first
entrance times. -/
theorem IsHistoryLocal.isEntranceHistoryLocal {Ω : Type*} [MeasurableSpace Ω]
    {η : Ω → ℝ≥0 → ℂ} {h : Ω → DistOn upperHalfPlaneOpens} {P : Measure Ω}
    (hloc : IsHistoryLocal η h P) : IsEntranceHistoryLocal η h P :=
  fun U G hUH hG hd => hloc U G hUH hG hd _ (measurable_firstEntrance U.isOpen.measurableSet)
    (isOptionalGalmarino_firstEntrance U)

/-! ### Paths and their explored sets -/

/-- A continuous path in an open set at time `t` is in it at some rational time `q ≤ t`. -/
theorem exists_rat_le_mem {V : Set ℂ} (hV : IsOpen V) {γ : ℝ≥0 → ℂ} (hγ : Continuous γ)
    {t : ℝ≥0} (ht : γ t ∈ V) : ∃ q : ℚ≥0, ((q : ℝ≥0)) ≤ t ∧ γ q ∈ V := by
  rcases eq_or_ne t 0 with rfl | ht0
  · exact ⟨0, by simp, by simpa using ht⟩
  have hev : ∀ᶠ s in 𝓝 t, γ s ∈ V := hγ.continuousAt.eventually (hV.mem_nhds ht)
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hev
  have htpos : (0 : ℝ) < t := lt_of_le_of_ne t.2 (fun h => ht0 (NNReal.eq h.symm))
  obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (show max 0 ((t : ℝ) - ε) < t by
    rw [max_lt_iff]; exact ⟨htpos, by linarith⟩)
  have hr0 : (0 : ℝ) ≤ r := (le_max_left _ _).trans hr1.le
  set q : ℚ≥0 := r.toNNRat with hqdef
  have hqt : ((q : ℝ≥0) : ℝ) = r := by
    rw [show ((q : ℝ≥0) : ℝ) = ((q : ℚ) : ℝ) by norm_cast, hqdef,
      Rat.coe_toNNRat r (by exact_mod_cast hr0)]
  have hm := (le_max_right 0 ((t : ℝ) - ε)).trans_lt hr1
  refine ⟨q, ?_, hball ?_⟩
  · rw [← NNReal.coe_le_coe, hqt]; exact hr2.le
  · rw [NNReal.dist_eq, hqt, abs_sub_lt_iff]
    constructor
    · linarith
    · linarith

/-- The range of a continuous path up to `τ` meets an open set iff it does at a rational time. -/
theorem image_inter_nonempty_iff {V : Set ℂ} (hV : IsOpen V) {γ : ℝ≥0 → ℂ} (hγ : Continuous γ)
    (τ : ℝ≥0∞) :
    (γ '' {t : ℝ≥0 | (t : ℝ≥0∞) ≤ τ} ∩ V).Nonempty ↔
      ∃ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ τ) ∧ γ q ∈ V := by
  constructor
  · rintro ⟨_, ⟨t, ht, rfl⟩, htV⟩
    obtain ⟨q, hqt, hqV⟩ := exists_rat_le_mem hV hγ htV
    exact ⟨q, (ENNReal.coe_le_coe.2 hqt).trans ht, hqV⟩
  · rintro ⟨q, hq, hqV⟩
    exact ⟨γ q, ⟨q, hq, rfl⟩, hqV⟩

theorem disjoint_explored_iff {Ω : Type*} {k : ℕ} {η : Fin k → Ω → ℝ≥0 → ℂ}
    {τ : Fin k → Ω → ℝ≥0∞} {U : Set ℂ} (hUH : U ⊆ H) (ω : Ω) :
    Disjoint (explored η τ ω) U ↔ ∀ i, AvoidsUpTo (η i ω) (τ i ω) U := by
  rw [Set.disjoint_left]
  constructor
  · intro hd i t ht htU
    exact hd ⟨mem_iUnion.2 ⟨i, t, ht, rfl⟩, hUH htU⟩ htU
  · rintro hall z ⟨hz, -⟩ hzU
    obtain ⟨i, t, ht, rfl⟩ := mem_iUnion.1 hz
    exact hall i t ht hzU

theorem explored_inter_nonempty_iff {Ω : Type*} {k : ℕ} {η : Fin k → Ω → ℝ≥0 → ℂ}
    {τ : Fin k → Ω → ℝ≥0∞} (hc : ∀ i ω, Continuous (η i ω)) {V : Set ℂ} (hV : IsOpen V)
    (hVH : V ⊆ H) (ω : Ω) :
    (explored η τ ω ∩ V).Nonempty ↔
      ∃ i, ∃ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞) ≤ τ i ω) ∧ η i ω q ∈ V := by
  have e : explored η τ ω ∩ V = ⋃ i, (η i ω '' {t : ℝ≥0 | (t : ℝ≥0∞) ≤ τ i ω} ∩ V) := by
    rw [explored, inter_assoc, inter_eq_right.2 hVH, iUnion_inter]
  rw [e, nonempty_iUnion]
  exact exists_congr fun i => image_inter_nonempty_iff hV (hc i ω) _

/-! ### The history through the first entrance time is determined by `h_{U^c}` -/

section Entrance

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens}

/-- **"It is determined by `h_{U^c}` alone"** (proof of Lemma 6.2): for a continuous field-determined
path started outside the open `U ⊆ ℍ` and history-sensitively local at `T^U`, the history through
`T^U` is measurable for the σ-algebra of events almost surely equal to events of `σ(h_{U^c})`. -/
theorem measurable_entranceHist (hhm : Measurable h) {η : Ω → ℝ≥0 → ℂ}
    (hc : ∀ ω, Continuous (η ω)) (hηm : ∀ t, Measurable fun ω => η ω t)
    (hdet : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η ω t) =ᵐ[P] fun ω => f (h ω))
    (hloc : IsEntranceHistoryLocal η h P) (U : Opens ℂ)
    (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens) (hUH : (U : Set ℂ) ⊆ H)
    (hG : Measurable G) (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P)
    (h0 : ∀ ω, η ω 0 ∉ U) :
    Measurable[aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P]
      (fun ω => histOf (pathCoord (η ω)) (firstEntrance U (pathCoord (η ω)))) := by
  set Y : Ω → Hist := fun ω => histOf (pathCoord (η ω)) (firstEntrance U (pathCoord (η ω)))
    with hYdef
  have hcm : Measurable fun ω => pathCoord (η ω) := Measurable.of_eval fun q => hηm q
  have hFm := measurable_firstEntrance U.isOpen.measurableSet
  have hYm : Measurable Y :=
    measurable_histOf.comp ((hFm.comp hcm).prodMk hcm)
  have hE : {ω | AvoidsUpTo (η ω) (firstEntrance U (pathCoord (η ω))) U} = univ := by
    ext ω
    simp only [mem_ofPred_eq, mem_univ, iff_true]
    exact fun t ht => notMem_of_le_firstEntrance U.isOpen (hc ω) (h0 ω) ht
  have hci := hloc U G hUH hG hd
  rw [hE] at hci
  -- the field determines `Y`
  choose f hf hfh using fun q : ℚ≥0 => hdet (q : ℝ≥0)
  set Ψ : DistOn upperHalfPlaneOpens → Hist := fun T =>
    histOf (fun q => f q T) (firstEntrance U (fun q => f q T)) with hΨdef
  have hfm : Measurable fun T : DistOn upperHalfPlaneOpens => fun q => f q T :=
    Measurable.of_eval fun q => hf q
  have hΨm : Measurable Ψ := measurable_histOf.comp ((hFm.comp hfm).prodMk hfm)
  have hYΨ : Y =ᵐ[P] fun ω => Ψ (h ω) := by
    have hall : ∀ᵐ ω ∂P, ∀ q : ℚ≥0, η ω q = f q (h ω) := ae_all_iff.2 hfh
    filter_upwards [hall] with ω hω
    have e : pathCoord (η ω) = fun q => f q (h ω) := funext hω
    simp only [hYdef, hΨdef, e]
  intro B hB
  have hb : MeasurableSet[markedHistSigma univ Y] (Y ⁻¹' B) :=
    MeasurableSpace.measurableSet_generateFrom ⟨B, hB, by rw [univ_inter]⟩
  have hMle : markedHistSigma univ Y ≤ mΩ := by
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨B', hB', rfl⟩
    exact MeasurableSet.univ.inter (hYm hB')
  have h𝓗 : MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance ≤ mΩ :=
    ((measurable_markovCompl hG).comp hhm).comap_le
  have h𝓑 : MeasurableSpace.comap (fun ω => G (h ω)) inferInstance ≤ mΩ := (hG.comp hhm).comap_le
  obtain ⟨b', hb', hbb'⟩ := exists_measurableSet_ae_eq_of_condIndepEv h𝓗 h𝓑 hMle hci.symm hb
    ⟨h ⁻¹' (Ψ ⁻¹' B), comap_le_sup_markov (G := G) _ ⟨Ψ ⁻¹' B, hΨm hB, rfl⟩, by
      filter_upwards [hYΨ] with ω hω
      simp only [mem_preimage, hω]⟩
  exact ⟨b', hb', hbb'⟩

end Entrance

/-! ### Lemma 6.2 -/

section Main

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens} {k : ℕ} {η : Fin k → Ω → ℝ≥0 → ℂ} {x : Fin k → ℂ}
  {τ : Fin k → Ω → ℝ≥0∞} {S : Fin k → (Fin k → Hist) → (ℚ≥0 → ℂ) → ℝ≥0∞}

/-- The core of Lemma 6.2: for every open `U ⊆ ℍ`, the avoidance event of the explored set, the
ordered tuple of stopped histories on it, and the recorded explored set on it are all almost surely
determined by `h_{U^c}`. -/
theorem le_aeSigma_explored (hhm : Measurable h) (hc : ∀ i ω, Continuous (η i ω))
    (h0 : ∀ i ω, η i ω 0 = x i) (hηm : ∀ i t, Measurable fun ω => η i ω t)
    (hdet : ∀ i (t : ℝ≥0), ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η i ω t) =ᵐ[P] fun ω => f (h ω))
    (hloc : ∀ i, IsEntranceHistoryLocal (η i) h P)
    (hSm : ∀ j, Measurable (Function.uncurry (S j))) (hSg : ∀ j, IsGalmarino (S j))
    (hτ : ∀ j ω, τ j ω = S j (prevHist (fun i => pathCoord (η i ω)) (fun i => τ i ω) j)
      (pathCoord (η j ω)))
    (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens)
    (hUH : (U : Set ℂ) ⊆ H) (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    markedHistSigma {ω | Disjoint (explored η τ ω) U}
        (fun ω i => histOf (pathCoord (η i ω)) (τ i ω)) ≤
      aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P ∧
    markedSigma (explored η τ) U ≤
      aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P := by
  classical
  set N := aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P
    with hNdef
  let _ : MeasurableSpace Ω := mΩ
  set E : Set Ω := {ω | Disjoint (explored η τ ω) U} with hEdef
  by_cases hx : ∃ i, x i ∈ U
  · -- a starting point lies in `U`: the explored set always meets `U`
    obtain ⟨i₀, hi₀⟩ := hx
    have hE : E = ∅ := by
      ext ω
      simp only [hEdef, mem_ofPred_eq, mem_empty_iff_false, iff_false,
        disjoint_explored_iff hUH ω]
      intro hall
      exact hall i₀ 0 (by simp) (by rw [h0]; exact hi₀)
    have hm : ∀ ω, markedSet U (explored η τ ω) = ∅ := by
      intro ω
      ext z
      simp only [markedSet, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_and]
      intro hdj
      exact absurd (show ω ∈ E from hdj) (by rw [hE]; exact notMem_empty ω)
    refine ⟨MeasurableSpace.generateFrom_le ?_, sup_le ?_ ?_⟩
    · rintro _ ⟨B, -, rfl⟩
      rw [hE, empty_inter]
      exact @MeasurableSet.empty _ N
    · refine MeasurableSpace.generateFrom_le ?_
      rintro _ rfl
      change MeasurableSet[N] E
      rw [hE]
      exact @MeasurableSet.empty _ N
    · rintro _ ⟨B, -, rfl⟩
      have e : (fun ω => markedSet U (explored η τ ω)) ⁻¹' B = if (∅ : Set ℂ) ∈ B then univ else ∅ := by
        ext ω
        simp only [mem_preimage, hm ω]
        split_ifs with hB
        · simp [hB]
        · simp [hB]
      rw [e]
      split_ifs
      · exact @MeasurableSet.univ _ N
      · exact @MeasurableSet.empty _ N
  push Not at hx
  -- the histories through the first entrance times
  set T : Fin k → Ω → ℝ≥0∞ := fun i ω => firstEntrance U (pathCoord (η i ω)) with hTdef
  set Ht : Ω → Fin k → Hist := fun ω i => histOf (pathCoord (η i ω)) (T i ω) with hHtdef
  have hHt : Measurable[N] Ht := by
    refine @Measurable.of_eval Ω (Fin k) (fun _ => Hist) N (fun _ => inferInstance) Ht fun i => ?_
    exact measurable_entranceHist hhm (hc i) (hηm i) (hdet i) (hloc i) U G hUH hG hd
      (fun ω => by rw [h0]; exact hx i)
  -- the reconstruction
  set ΨE : Set (Fin k → Hist) := {y | ∀ j, recon S y j ≤ (y j).1} with hΨEdef
  have hrm : Measurable (recon S) := measurable_recon hSm
  have hΨE : MeasurableSet ΨE := by
    have : ΨE = ⋂ j, {y : Fin k → Hist | recon S y j ≤ (y j).1} := by
      ext y; simp [hΨEdef]
    rw [this]
    exact MeasurableSet.iInter fun j =>
      measurableSet_le ((measurable_pi_apply j).comp hrm)
        (measurable_fst.comp (measurable_pi_apply j))
  -- pointwise identification
  have hpt : ∀ ω, (ω ∈ E ↔ Ht ω ∈ ΨE) ∧ (ω ∈ E → recon S (Ht ω) = fun i => τ i ω) := by
    intro ω
    have hav : ω ∈ E ↔ ∀ i, τ i ω ≤ T i ω := by
      simp only [hEdef, mem_ofPred_eq, disjoint_explored_iff hUH ω]
      refine forall_congr' fun i => ?_
      exact disjoint_range_iff_le_firstEntrance U.isOpen (hc i ω) (by rw [h0]; exact hx i) _
    have hrec := forall_le_iff_recon (S := S) hSg (c := fun i => pathCoord (η i ω))
      (τ := fun i => τ i ω) (T := fun i => T i ω) (fun j => hτ j ω)
    refine ⟨hav.trans hrec.1, fun hω => hrec.2 (hav.1 hω)⟩
  have hEeq : E = Ht ⁻¹' ΨE := by
    ext ω; exact (hpt ω).1
  refine ⟨MeasurableSpace.generateFrom_le ?_, sup_le ?_ ?_⟩
  · -- the stopped histories on `E`
    rintro _ ⟨B, hB, rfl⟩
    set Φ : (Fin k → Hist) → Fin k → Hist := fun y i => histOf (y i).2 (recon S y i) with hΦdef
    have hΦm : Measurable Φ := by
      refine Measurable.of_eval fun i => ?_
      exact measurable_histOf.comp (((measurable_pi_apply i).comp hrm).prodMk
        (measurable_snd.comp (measurable_pi_apply i)))
    have e : E ∩ (fun ω i => histOf (pathCoord (η i ω)) (τ i ω)) ⁻¹' B =
        Ht ⁻¹' (ΨE ∩ Φ ⁻¹' B) := by
      ext ω
      simp only [mem_inter_iff, mem_preimage]
      refine ⟨fun ⟨hω, hB⟩ => ⟨(hpt ω).1.1 hω, ?_⟩, fun ⟨hω, hB⟩ => ⟨(hpt ω).1.2 hω, ?_⟩⟩
      · convert hB using 1
        funext i
        have hrτ := congrFun ((hpt ω).2 hω) i
        have hle : τ i ω ≤ T i ω := by
          rw [← hrτ]; exact ((hpt ω).1.1 hω) i
        show histOf (Ht ω i).2 (recon S (Ht ω) i) = _
        rw [hrτ]
        simp only [hHtdef, histOf, stopCoord_stopCoord hle]
      · have hω' := (hpt ω).1.2 hω
        convert hB using 1
        funext i
        have hrτ := congrFun ((hpt ω).2 hω') i
        have hle : τ i ω ≤ T i ω := by
          rw [← hrτ]; exact hω i
        show _ = histOf (Ht ω i).2 (recon S (Ht ω) i)
        rw [hrτ]
        simp only [hHtdef, histOf, stopCoord_stopCoord hle]
    rw [e]
    exact hHt (hΨE.inter (hΦm hB))
  · -- the avoidance event
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ rfl
    change MeasurableSet[N] E
    rw [hEeq]
    exact hHt hΨE
  · -- the recorded set
    unfold hittingSigma
    rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨_, ⟨V, hVo, hVH, rfl⟩, rfl⟩
    set Ψ : Set (Fin k → Hist) := ΨE ∩ ⋃ i, ⋃ q : ℚ≥0,
      ({y | (((q : ℝ≥0) : ℝ≥0∞)) ≤ recon S y i} ∩ {y | (y i).2 q ∈ V}) with hΨdef
    have hΨ : MeasurableSet Ψ := by
      refine hΨE.inter (MeasurableSet.iUnion fun i => MeasurableSet.iUnion fun q => ?_)
      refine (measurableSet_le measurable_const ((measurable_pi_apply i).comp hrm)).inter ?_
      exact ((measurable_pi_apply q).comp (measurable_snd.comp (measurable_pi_apply i)))
        hVo.measurableSet
    have e : (fun ω => markedSet U (explored η τ ω)) ⁻¹' {A | (A ∩ V).Nonempty} = Ht ⁻¹' Ψ := by
      ext ω
      simp only [mem_preimage, mem_ofPred_eq, markedSet_inter_nonempty_iff,
        explored_inter_nonempty_iff hc hVo hVH ω, hΨdef, mem_inter_iff, mem_iUnion]
      constructor
      · rintro ⟨hω, i, q, hq, hqV⟩
        have hrτ := congrFun ((hpt ω).2 hω) i
        have hle : τ i ω ≤ T i ω := by
          rw [← hrτ]; exact ((hpt ω).1.1 hω) i
        refine ⟨(hpt ω).1.1 hω, i, q, ?_, ?_⟩
        · show _ ≤ recon S (Ht ω) i
          rw [hrτ]; exact hq
        · show stopCoord (pathCoord (η i ω)) (T i ω) q ∈ V
          rw [stopCoord_of_le (hq.trans hle)]; exact hqV
      · rintro ⟨hω, i, q, hq, hqV⟩
        have hω' := (hpt ω).1.2 hω
        have hrτ := congrFun ((hpt ω).2 hω') i
        have hle : τ i ω ≤ T i ω := by
          rw [← hrτ]; exact hω i
        refine ⟨hω', i, q, ?_, ?_⟩
        · rw [← hrτ]; exact hq
        · have hq' : (((q : ℝ≥0) : ℝ≥0∞)) ≤ T i ω := (show _ ≤ recon S (Ht ω) i from hq).trans
            (by rw [hrτ]; exact hle)
          have := hqV
          change stopCoord (pathCoord (η i ω)) (T i ω) q ∈ V at this
          rwa [stopCoord_of_le hq'] at this
    rw [e]
    exact hHt hΨ

/-- **Lemma 6.2** (history-sensitive conclusion). Under the hypotheses of Lemma 6.2 (continuous
paths with deterministic starting points, almost surely determined by `h`, history-sensitively local;
`τ_j` stopping times of the enlarged filtrations in Galmarino form), for every deterministic open
`U ⊆ ℍ` and Borel version `G` of the projection onto `H(U)`: given `h_{U^c}`, the pair consisting of
`1_E`, `E = {⋃_i η_i([0, τ_i]) ∩ U = ∅}`, and the ordered tuple of stopped histories on `E` is
conditionally independent of `h_U`. -/
theorem condIndepEv_markedHistSigma_explored (hhm : Measurable h) (hc : ∀ i ω, Continuous (η i ω))
    (h0 : ∀ i ω, η i ω 0 = x i) (hηm : ∀ i t, Measurable fun ω => η i ω t)
    (hdet : ∀ i (t : ℝ≥0), ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η i ω t) =ᵐ[P] fun ω => f (h ω))
    (hloc : ∀ i, IsEntranceHistoryLocal (η i) h P)
    (hSm : ∀ j, Measurable (Function.uncurry (S j))) (hSg : ∀ j, IsGalmarino (S j))
    (hτ : ∀ j ω, τ j ω = S j (prevHist (fun i => pathCoord (η i ω)) (fun i => τ i ω) j)
      (pathCoord (η j ω)))
    (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens)
    (hUH : (U : Set ℂ) ⊆ H) (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    CondIndepEv (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
      (markedHistSigma {ω | Disjoint (explored η τ ω) U}
        (fun ω i => histOf (pathCoord (η i ω)) (τ i ω)))
      (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance) P :=
  condIndepEv_of_le_aeSigma ((measurable_markovCompl hG).comp hhm).comap_le
    (hG.comp hhm).comap_le
    (le_aeSigma_explored hhm hc h0 hηm hdet hloc hSm hSg hτ U G hUH hG hd).1

/-- **Lemma 6.2** (locality): the explored set `⋃_i η_i([0, τ_i])` satisfies the marked avoidance
characterization (ii) of Lemma 3.6. -/
theorem isMarkedAvoidanceLocal_explored (hhm : Measurable h) (hc : ∀ i ω, Continuous (η i ω))
    (h0 : ∀ i ω, η i ω 0 = x i) (hηm : ∀ i t, Measurable fun ω => η i ω t)
    (hdet : ∀ i (t : ℝ≥0), ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η i ω t) =ᵐ[P] fun ω => f (h ω))
    (hloc : ∀ i, IsEntranceHistoryLocal (η i) h P)
    (hSm : ∀ j, Measurable (Function.uncurry (S j))) (hSg : ∀ j, IsGalmarino (S j))
    (hτ : ∀ j ω, τ j ω = S j (prevHist (fun i => pathCoord (η i ω)) (fun i => τ i ω) j)
      (pathCoord (η j ω))) :
    IsMarkedAvoidanceLocal (explored η τ) h P := fun U G hUH hG hd =>
  condIndepEv_of_le_aeSigma ((measurable_markovCompl hG).comp hhm).comap_le
    (hG.comp hhm).comap_le
    (le_aeSigma_explored hhm hc h0 hηm hdet hloc hSm hSg hτ U G hUH hG hd).2

/-- The explored set is a random element of the space of closed sets (hitting σ-algebra). -/
theorem measurable_explored (hc : ∀ i ω, Continuous (η i ω))
    (hηm : ∀ i t, Measurable fun ω => η i ω t) (hτm : ∀ i, Measurable (τ i)) :
    Measurable[mΩ, hittingSigma] (explored η τ) := by
  refine @measurable_generateFrom Ω (Set ℂ) mΩ _ _ ?_
  rintro _ ⟨V, hVo, hVH, rfl⟩
  have e : explored η τ ⁻¹' {A | (A ∩ V).Nonempty} =
      ⋃ i, ⋃ q : ℚ≥0, ({ω | (((q : ℝ≥0) : ℝ≥0∞)) ≤ τ i ω} ∩ {ω | η i ω q ∈ V}) := by
    ext ω
    simp only [mem_preimage, mem_ofPred_eq, explored_inter_nonempty_iff hc hVo hVH ω, mem_iUnion,
      mem_inter_iff]
  rw [e]
  exact MeasurableSet.iUnion fun i => MeasurableSet.iUnion fun q =>
    (measurableSet_le measurable_const (hτm i)).inter (hηm i q hVo.measurableSet)

/-- **Lemma 6.2** (local set). For a zero-boundary GFF `h` on `ℍ`, under the hypotheses of Lemma 6.2
and if the explored set is almost surely relatively closed in `ℍ`, `⋃_i η_i([0, τ_i])` is a local set
of `h`. -/
theorem isLocalSet_explored (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hc : ∀ i ω, Continuous (η i ω))
    (h0 : ∀ i ω, η i ω 0 = x i) (hηm : ∀ i t, Measurable fun ω => η i ω t)
    (hdet : ∀ i (t : ℝ≥0), ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η i ω t) =ᵐ[P] fun ω => f (h ω))
    (hloc : ∀ i, IsEntranceHistoryLocal (η i) h P)
    (hSm : ∀ j, Measurable (Function.uncurry (S j))) (hSg : ∀ j, IsGalmarino (S j))
    (hτ : ∀ j ω, τ j ω = S j (prevHist (fun i => pathCoord (η i ω)) (fun i => τ i ω) j)
      (pathCoord (η j ω)))
    (hτm : ∀ i, Measurable (τ i)) (hcl : ∀ᵐ ω ∂P, IsOpen (H \ explored η τ ω)) :
    IsLocalSet (explored η τ) h P := by
  have hA := measurable_explored hc hηm hτm
  have hAc : ∀ᵐ ω ∂P, explored η τ ω ⊆ H ∧ IsOpen (H \ explored η τ ω) := by
    filter_upwards [hcl] with ω hω using ⟨inter_subset_right, hω⟩
  exact ((isLocalSet_tfae hh hA hAc).out 2 4).1
    (isMarkedAvoidanceLocal_explored hh.measurable hc h0 hηm hdet hloc hSm hSg hτ)

