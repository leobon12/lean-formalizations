/-!
# A.1's frozen-curve image law, I: the image-data filtration and the cap exhaustion

Packet PROVE-A1-FROZEN (R76). Source: Astra, *Follow-up 5* §1.3 (`source/external/AstraIG1/ig1_followup5.txt`
L203–L222, R73): "Conditional Girsanov gives the image SDE. Countable protected-rectangle exhaustion gives the law up
to first contact"; *Follow-up proofs* §A.1.3 (`ig1_followup_proofs.txt` L341–L353, R38): "By (D8) and Girsanov,
with the other curve stopped, the new drift of `W_j` is … (D10) … The time change `du = A²_{j,1} dt_j`, Lévy's
characterization, and uniqueness in law of the integrated force system identify the claimed conditional image law
inside this rectangle."

Generic tools for the frozen-curve clauses of `A1Core.IsRectImageCore` / `IsRectImageCoreFst`:

* `imageGen`, `imageFilt`: the filtration generated by the image data — image driver, image lifetime (through the
  events `{r < ζ}`), image force points, image noise and the rectangle caps (through the events `{S_m ≤ r}`), read at
  the times `r ≤ t`; the image data are adapted to it, the caps are stopping times of it, and the driver and force
  points are adapted before the lifetime (`imageFilt_adaptedBefore`, `isStoppingTime_imageFilt`, …);
* `measurableSet_inter_of_generateFrom`: an event of a generated σ-algebra, cut down to an event `C`,
  is `𝓜`-measurable as soon as every generator cut down to `C` is (the reduction of the stopped-record clauses and of
  the frozen-sample filtration clauses to the image data, before each cap);
* `isSLEPathUpTo_of_caps`: the countable cap exhaustion ("countable protected-rectangle exhaustion gives the law up to
  first contact"), pathwise: a local `SLE_a(ρ)` path before each cap (capped by the lifetime) is one before the
  lifetime once the caps cover it;
* `isSLEPathUpTo_of_geometry`: before a cap, the deterministic image equations (`SeedImageGeometry` of the image
  data stopped at the cap) and the image noise equal to the compensated residual `seedCapacityNoise` give the local
  path (A22's `SeedImageGeometry.isSLEPathUpTo` and the congruence `Sec2.Assembly2.isSLEPathUpTo_congr`).
-/

set_option autoImplicit false

noncomputable section

open Set Filter Topology MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace InteractingSLE.ZhanGT4.A1Frozen

open A1Canon A1Ref A1Core

/-! ### The trace σ-algebra -/

section Trace

variable {Z : Type*}

/-- **Generators suffice for the trace**: if every generator cut down to `C` is `𝓜`-measurable, so is every event of
the generated σ-algebra (the sets `A` with `A ∩ C ∈ 𝓜` form a σ-algebra, the trace of `𝓜` on `C`). -/
theorem measurableSet_inter_of_generateFrom {𝓜 : MeasurableSpace Z} {G : Set (Set Z)} {C : Set Z}
    (hC : MeasurableSet[𝓜] C) (hG : ∀ g ∈ G, MeasurableSet[𝓜] (g ∩ C)) {A : Set Z}
    (hA : MeasurableSet[MeasurableSpace.generateFrom G] A) : MeasurableSet[𝓜] (A ∩ C) := by
  let 𝓣 : MeasurableSpace Z :=
    { MeasurableSet' := fun A => MeasurableSet[𝓜] (A ∩ C)
      measurableSet_empty := by simp only [empty_inter, MeasurableSet.empty]
      measurableSet_compl := fun A hA => by
        have e : Aᶜ ∩ C = C \ (A ∩ C) := by
          ext z
          simp only [mem_inter_iff, mem_compl_iff, Set.mem_sdiff, not_and]
          exact ⟨fun h => ⟨h.2, fun h' => absurd h' h.1⟩, fun h => ⟨fun h' => h.2 h' h.1, h.1⟩⟩
        rw [e]; exact hC.diff hA
      measurableSet_iUnion := fun f hf => by rw [iUnion_inter]; exact MeasurableSet.iUnion hf }
  exact (MeasurableSpace.generateFrom_le (m := 𝓣) hG) A hA

end Trace

/-! ### The image-data filtration -/

section ImageFilt

variable {Z : Type*} [mZ : MeasurableSpace Z] {nL nR : ℕ}

/-- **The image-data generators at time `t`**: for `r ≤ t`, the preimages of Borel sets under the image driver `W`,
the image force points `VL`, `VR` and the image noise `N` at `r`, the cap events `{S m ≤ r}` and the lifetime events
`{r < ζ}`. -/
def imageGen (W : ℝ≥0 → Z → ℝ) (ζ : Z → ℝ≥0∞) (VL : Fin nL → ℝ≥0 → Z → ℝ) (VR : Fin nR → ℝ≥0 → Z → ℝ)
    (N : ℝ≥0 → Z → ℝ) (S : ℕ → Z → ℝ≥0) (t : ℝ≥0) : Set (Set Z) :=
  {A | ∃ r ≤ t, (∃ U : Set ℝ, MeasurableSet U ∧
      (A = W r ⁻¹' U ∨ (∃ i, A = VL i r ⁻¹' U) ∨ (∃ j, A = VR j r ⁻¹' U) ∨ A = N r ⁻¹' U)) ∨
    (∃ m, A = {z | S m z ≤ r}) ∨ A = {z | (r : ℝ≥0∞) < ζ z}}

variable {W : ℝ≥0 → Z → ℝ} {ζ : Z → ℝ≥0∞} {VL : Fin nL → ℝ≥0 → Z → ℝ} {VR : Fin nR → ℝ≥0 → Z → ℝ}
  {N : ℝ≥0 → Z → ℝ} {S : ℕ → Z → ℝ≥0}

omit mZ in
theorem imageGen_mono {s t : ℝ≥0} (hst : s ≤ t) : imageGen W ζ VL VR N S s ⊆ imageGen W ζ VL VR N S t :=
  fun _ ⟨r, hr, h⟩ => ⟨r, hr.trans hst, h⟩

variable (W ζ VL VR N S) in
/-- **The image-data filtration** (natural filtration of the image data and the caps, intersected with the ambient
σ-algebra so that no measurability proof enters the definition). -/
def imageFilt : Filtration ℝ≥0 mZ where
  seq t := MeasurableSpace.generateFrom (imageGen W ζ VL VR N S t) ⊓ mZ
  mono' _ _ hst := inf_le_inf_right _ (MeasurableSpace.generateFrom_mono (imageGen_mono hst))
  le' _ := inf_le_right

/-- A measurable generator is an event of the image-data filtration. -/
theorem measurableSet_imageFilt_of_mem {t : ℝ≥0} {A : Set Z} (hA : A ∈ imageGen W ζ VL VR N S t)
    (hAm : MeasurableSet A) : MeasurableSet[imageFilt W ζ VL VR N S t] A :=
  ⟨MeasurableSpace.measurableSet_generateFrom hA, hAm⟩

/-- Events of the image-data filtration are events of the generated σ-algebra. -/
theorem measurableSet_generateFrom_of_imageFilt {t : ℝ≥0} {A : Set Z}
    (hA : MeasurableSet[imageFilt W ζ VL VR N S t] A) :
    MeasurableSet[MeasurableSpace.generateFrom (imageGen W ζ VL VR N S t)] A :=
  hA.1

theorem measurable_imageFilt_W (hW : ∀ t, Measurable (W t)) (t : ℝ≥0) :
    Measurable[imageFilt W ζ VL VR N S t] (W t) := fun U hU =>
  measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inl ⟨U, hU, Or.inl rfl⟩⟩ (hW t hU)

theorem measurable_imageFilt_VL (hVL : ∀ i t, Measurable (VL i t)) (i : Fin nL) (t : ℝ≥0) :
    Measurable[imageFilt W ζ VL VR N S t] (VL i t) := fun U hU =>
  measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inl ⟨U, hU, Or.inr (Or.inl ⟨i, rfl⟩)⟩⟩ (hVL i t hU)

theorem measurable_imageFilt_VR (hVR : ∀ j t, Measurable (VR j t)) (j : Fin nR) (t : ℝ≥0) :
    Measurable[imageFilt W ζ VL VR N S t] (VR j t) := fun U hU =>
  measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inl ⟨U, hU, Or.inr (Or.inr (Or.inl ⟨j, rfl⟩))⟩⟩ (hVR j t hU)

theorem measurable_imageFilt_N (hN : ∀ t, Measurable (N t)) (t : ℝ≥0) :
    Measurable[imageFilt W ζ VL VR N S t] (N t) := fun U hU =>
  measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inl ⟨U, hU, Or.inr (Or.inr (Or.inr rfl))⟩⟩ (hN t hU)

/-- **The caps are stopping times of the image-data filtration.** -/
theorem isStoppingTime_imageFilt (hS : ∀ m, Measurable (S m)) (m : ℕ) :
    IsStoppingTime (imageFilt W ζ VL VR N S) fun z => (S m z : WithTop ℝ≥0) := fun t => by
  have e : {z | (S m z : WithTop ℝ≥0) ≤ t} = {z | S m z ≤ t} := by
    ext z; exact WithTop.coe_le_coe
  rw [e]
  exact measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inr (Or.inl ⟨m, rfl⟩)⟩ (measurableSet_le (hS m)
    measurable_const)

/-- The lifetime events `{t < ζ}` are events of the image-data filtration at `t`. -/
theorem measurableSet_imageFilt_lt (hζ : Measurable ζ) (t : ℝ≥0) :
    MeasurableSet[imageFilt W ζ VL VR N S t] {z | (t : ℝ≥0∞) < ζ z} :=
  measurableSet_imageFilt_of_mem ⟨t, le_rfl, Or.inr (Or.inr rfl)⟩ (measurableSet_lt measurable_const hζ)

/-- **A process adapted to a filtration in which the lifetime events are measurable is adapted before the
lifetime.** -/
theorem adaptedBefore_of_measurable {𝓗 : Filtration ℝ≥0 mZ} {X : ℝ≥0 → Z → ℝ}
    (hX : ∀ t, Measurable[𝓗 t] (X t)) (hζ : ∀ t : ℝ≥0, MeasurableSet[𝓗 t] {z | (t : ℝ≥0∞) < ζ z}) :
    AdaptedBefore 𝓗 ζ X := fun t A hA => by
  have e : {z | (t : ℝ≥0∞) < ζ z ∧ X t z ∈ A} = {z | (t : ℝ≥0∞) < ζ z} ∩ X t ⁻¹' A := rfl
  rw [e]; exact (hζ t).inter (hX t hA)

omit mZ in
/-- **Every generator of the image-data filtration at `s`**, by kind (the form used to check the trace conditions). -/
theorem forall_imageGen {s : ℝ≥0} {p : Set Z → Prop}
    (hW : ∀ r ≤ s, ∀ U : Set ℝ, MeasurableSet U → p (W r ⁻¹' U))
    (hVL : ∀ r ≤ s, ∀ U : Set ℝ, MeasurableSet U → ∀ i, p (VL i r ⁻¹' U))
    (hVR : ∀ r ≤ s, ∀ U : Set ℝ, MeasurableSet U → ∀ j, p (VR j r ⁻¹' U))
    (hN : ∀ r ≤ s, ∀ U : Set ℝ, MeasurableSet U → p (N r ⁻¹' U))
    (hS : ∀ r ≤ s, ∀ m, p {z | S m z ≤ r}) (hζ : ∀ r ≤ s, p {z | (r : ℝ≥0∞) < ζ z}) :
    ∀ g ∈ imageGen W ζ VL VR N S s, p g := by
  rintro g ⟨r, hr, ⟨U, hU, rfl | ⟨i, rfl⟩ | ⟨j, rfl⟩ | rfl⟩ | ⟨m, rfl⟩ | rfl⟩
  exacts [hW r hr U hU, hVL r hr U hU i, hVR r hr U hU j, hN r hr U hU, hS r hr m, hζ r hr]

end ImageFilt

/-! ### Sections of the image-data filtration -/

section Sections

variable {X Y : Type*} [mX : MeasurableSpace X] [mY : MeasurableSpace Y] {nL nR : ℕ}

/-- **Events of a section of the image-data filtration, cut down to `C`**: if the sections of all generators cut down
to `C` are `𝓗 s`-measurable, so are the sections of all its events (frozen conditioning sample `y`). -/
theorem measurableSet_section_inter {W : ℝ≥0 → X × Y → ℝ} {ζ : X × Y → ℝ≥0∞} {VL : Fin nL → ℝ≥0 → X × Y → ℝ}
    {VR : Fin nR → ℝ≥0 → X × Y → ℝ} {N : ℝ≥0 → X × Y → ℝ} {S : ℕ → X × Y → ℝ≥0} {y : Y} {s : ℝ≥0}
    {𝓗 : Filtration ℝ≥0 mX} {C : Set X} (hC : MeasurableSet[𝓗 s] C)
    (hG : ∀ g ∈ imageGen W ζ VL VR N S s, MeasurableSet[𝓗 s] ((fun x => (x, y)) ⁻¹' g ∩ C)) {A : Set X}
    (hA : MeasurableSet[sectionFiltration (imageFilt W ζ VL VR N S) y s] A) : MeasurableSet[𝓗 s] (A ∩ C) := by
  have hA' : MeasurableSet[MeasurableSpace.generateFrom
      (Set.image (Set.preimage fun x => (x, y)) (imageGen W ζ VL VR N S s))] A := by
    rw [← MeasurableSpace.comap_generateFrom]
    exact MeasurableSpace.comap_mono inf_le_left A hA
  refine measurableSet_inter_of_generateFrom hC ?_ hA'
  rintro _ ⟨g, hg, rfl⟩
  exact hG g hg

/-- The mirror: sections at a frozen sample `x ∈ X`. -/
theorem measurableSet_sectionFst_inter {W : ℝ≥0 → X × Y → ℝ} {ζ : X × Y → ℝ≥0∞}
    {VL : Fin nL → ℝ≥0 → X × Y → ℝ} {VR : Fin nR → ℝ≥0 → X × Y → ℝ} {N : ℝ≥0 → X × Y → ℝ}
    {S : ℕ → X × Y → ℝ≥0} {x : X} {s : ℝ≥0} {𝓗 : Filtration ℝ≥0 mY} {C : Set Y} (hC : MeasurableSet[𝓗 s] C)
    (hG : ∀ g ∈ imageGen W ζ VL VR N S s, MeasurableSet[𝓗 s] ((fun y => (x, y)) ⁻¹' g ∩ C)) {A : Set Y}
    (hA : MeasurableSet[sectionFiltrationFst (imageFilt W ζ VL VR N S) x s] A) : MeasurableSet[𝓗 s] (A ∩ C) := by
  have hA' : MeasurableSet[MeasurableSpace.generateFrom
      (Set.image (Set.preimage fun y => (x, y)) (imageGen W ζ VL VR N S s))] A := by
    rw [← MeasurableSpace.comap_generateFrom]
    exact MeasurableSpace.comap_mono inf_le_left A hA
  refine measurableSet_inter_of_generateFrom hC ?_ hA'
  rintro _ ⟨g, hg, rfl⟩
  exact hG g hg

end Sections

/-! ### The cap exhaustion of local paths -/

section Exhaust

variable {a : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {w : ℝ≥0 → ℝ} {vL : Fin nL → ℝ≥0 → ℝ} {vR : Fin nR → ℝ≥0 → ℝ} {b : ℝ≥0 → ℝ}

/-- **Countable cap exhaustion of local paths** (pathwise): if the caps `S m` cover `[0, ζ)` and the path is a local
`SLE_a(ρ)` path before every cap capped by `ζ`, it is one before `ζ`. -/
theorem isSLEPathUpTo_of_caps {S : ℕ → ℝ≥0} {ζ : ℝ≥0∞}
    (hcov : ∀ t : ℝ≥0, (t : ℝ≥0∞) < ζ → ∃ m, t ≤ S m)
    (h : ∀ m, Sec2.IsSLEPathUpTo a xL xR ρL ρR w vL vR b (min (S m : ℝ≥0∞) ζ)) :
    Sec2.IsSLEPathUpTo a xL xR ρL ρR w vL vR b ζ := by
  rcases eq_or_ne ζ 0 with hζ | hζ
  · have h0 := h 0
    rw [hζ] at h0 ⊢
    rwa [min_eq_right zero_le] at h0
  refine Sec2.Assembly2.isSLEPathUpTo_of_forall_lt (pos_iff_ne_zero.2 hζ) fun q _ hqζ => ?_
  obtain ⟨r, hqr, hrζ⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hqζ
  obtain ⟨m, hm⟩ := hcov r hrζ
  exact (h m).mono (le_min (hqr.le.trans (by exact_mod_cast hm)) hqζ.le)

/-- **Before a cap, the deterministic image equations and the residual noise give the local path**: if the image
data stopped at the cap `T` satisfy `SeedImageGeometry` up to `T` and the noise `b` is the compensated residual
`seedCapacityNoise` of the (unstopped) image data before `T`, then the image data are a local `SLE_a(ρ)` path before
`T` with noise `b`. -/
theorem isSLEPathUpTo_of_geometry (ha : 0 < a) {T : ℝ≥0}
    (hg : SeedImageGeometry xL xR ρL ρR (fun t => w (min t T)) (fun i t => vL i (min t T))
      (fun j t => vR j (min t T)) T)
    (hb : ∀ t : ℝ≥0, t < T → b t = seedCapacityNoise a ρL ρR w vL vR t) :
    Sec2.IsSLEPathUpTo a xL xR ρL ρR w vL vR b T := by
  have hp := hg.isSLEPathUpTo ha
  have hlt : ∀ t : ℝ≥0, (t : ℝ≥0∞) < T → t < T := fun t ht => by exact_mod_cast ht
  have hres : ∀ t : ℝ≥0, t < T →
      seedCapacityNoise a ρL ρR (fun t => w (min t T)) (fun i t => vL i (min t T)) (fun j t => vR j (min t T)) t =
        seedCapacityNoise a ρL ρR w vL vR t := fun t ht => by
    have hmin : ∀ s ∈ uIcc (0 : ℝ) t, min s.toNNReal T = s.toNNReal := fun s hs => by
      rw [uIcc_of_le t.coe_nonneg] at hs
      exact min_eq_left ((Real.toNNReal_le_iff_le_coe.2 hs.2).trans ht.le)
    have hL : ∀ i, (∫ s in (0 : ℝ)..t, ρL i / (w (min s.toNNReal T) - vL i (min s.toNNReal T))) =
        ∫ s in (0 : ℝ)..t, ρL i / (w s.toNNReal - vL i s.toNNReal) := fun i =>
      intervalIntegral.integral_congr fun s hs => by simp only [hmin s hs]
    have hR : ∀ j, (∫ s in (0 : ℝ)..t, ρR j / (w (min s.toNNReal T) - vR j (min s.toNNReal T))) =
        ∫ s in (0 : ℝ)..t, ρR j / (w s.toNNReal - vR j s.toNNReal) := fun j =>
      intervalIntegral.integral_congr fun s hs => by simp only [hmin s hs]
    unfold seedCapacityNoise
    dsimp only
    rw [min_eq_left ht.le]
    simp only [hL, hR]
  refine Sec2.Assembly2.isSLEPathUpTo_congr hp (by rw [min_eq_left zero_le])
    (fun i => by simp only [min_eq_left zero_le]) (fun j => by simp only [min_eq_left zero_le])
    (fun t ht => by simp only [min_eq_left (hlt t ht).le]) (fun t ht i => by simp only [min_eq_left (hlt t ht).le])
    (fun t ht j => by simp only [min_eq_left (hlt t ht).le]) (fun t ht => ?_)
  rw [hb t (hlt t ht), hres t (hlt t ht)]

end Exhaust

end InteractingSLE.ZhanGT4.A1Frozen
