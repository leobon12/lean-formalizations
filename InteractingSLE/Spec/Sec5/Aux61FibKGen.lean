import InteractingSLE.Spec.Sec5.Aux61FibKDisint

/-!
# A countable π-system for the raw killed σ-algebra of a continuous driver at a rational time

Packet PROVE-AUX61-FIB2. The disintegration (`Aux61FibKDisint`) passes identities on a countable π-system to almost
every fibre. For the raw σ-algebra of a driver `W` killed at `ζ` (no marks), at a rational time `q`:

* `ratGen W ζ q j`, `ratPi W ζ q T` (finite intersections, indexed by `Finset (ℚ × ℚ × ℚ)`): the events
  `{r < ζ, W_r ∈ (a, b)}` with `r ≤ q` rational and `a, b` rational;
* `isPiSystem_ratPi`;
* **`generateFrom_ratPi`**: if every path `W(·, s)` is continuous, the π-system generates exactly
  `killedDrivingSigma W 0 0 ζ q` (an irrational sampling time `r < q` is reached from rational times decreasing to `r`,
  through the killed values `1_{r < ζ} W_r`, which are pointwise limits).

Measure theory only. R48: nothing here uses Theorem 1.2/1.3.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.Aux61FibK

section Gen

variable {S : Type*} (W : ℝ≥0 → S → ℝ) (ζ : S → ℝ≥0∞)

/-- The absent marks. -/
abbrev noMarks : Fin 0 → ℝ≥0 → S → ℝ := fun _ _ _ => 0

/-- One generator at a rational time `r ≤ q`: `{r < ζ, W_r ∈ (a, b)}` (and `univ` for `r > q`). -/
def ratGen (q : ℝ≥0) (j : ℚ × ℚ × ℚ) : Set S :=
  if (j.1 : ℝ).toNNReal ≤ q then
    {s | (((j.1 : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (j.1 : ℝ).toNNReal s ∈ Ioo (j.2.1 : ℝ) (j.2.2 : ℝ)}
  else univ

/-- Finite intersections of the generators. -/
def ratPi (q : ℝ≥0) (T : Finset (ℚ × ℚ × ℚ)) : Set S := ⋂ j ∈ T, ratGen W ζ q j

theorem isPiSystem_ratPi (q : ℝ≥0) : IsPiSystem (range (ratPi W ζ q)) := by
  rintro _ ⟨T, rfl⟩ _ ⟨T', rfl⟩ _
  refine ⟨T ∪ T', ?_⟩
  ext s
  simp only [ratPi, mem_iInter, mem_inter_iff, Finset.mem_union]
  constructor
  · intro h
    exact ⟨fun j hj => h j (Or.inl hj), fun j hj => h j (Or.inr hj)⟩
  · rintro ⟨h1, h2⟩ j (hj | hj)
    exacts [h1 j hj, h2 j hj]

/-- The σ-algebra generated by the rational generators. -/
abbrev ratSigma (q : ℝ≥0) : MeasurableSpace S := MeasurableSpace.generateFrom (range (ratPi W ζ q))

theorem measurableSet_ratGen_of_le {q : ℝ≥0} (r : ℚ) (hr : (r : ℝ).toNNReal ≤ q) (a b : ℚ) :
    MeasurableSet[ratSigma W ζ q]
      {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo (a : ℝ) (b : ℝ)} := by
  refine MeasurableSpace.measurableSet_generateFrom ⟨{(r, a, b)}, ?_⟩
  simp only [ratPi, Finset.mem_singleton, iInter_iInter_eq_left, ratGen, hr, ↓reduceIte]

/-- At a rational time `r ≤ q`, the killed real interval events. -/
theorem measurableSet_ratGen_Ioo {q : ℝ≥0} (r : ℚ) (hr : (r : ℝ).toNNReal ≤ q) (x y : ℝ) :
    MeasurableSet[ratSigma W ζ q]
      {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo x y} := by
  have e : {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo x y} =
      ⋃ (a : ℚ) (b : ℚ), (if x < a ∧ (b : ℝ) < y then
        {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo (a : ℝ) (b : ℝ)} else ∅) := by
    ext s
    simp only [mem_ofPred_eq, mem_Ioo, mem_iUnion]
    constructor
    · rintro ⟨hζ, hx, hy⟩
      obtain ⟨a, ha1, ha2⟩ := exists_rat_btwn hx
      obtain ⟨b, hb1, hb2⟩ := exists_rat_btwn hy
      exact ⟨a, b, by simp only [ha1, hb2, and_self, ↓reduceIte, mem_ofPred_eq]; exact ⟨hζ, ha2, hb1⟩⟩
    · rintro ⟨a, b, hs⟩
      by_cases hab : x < a ∧ (b : ℝ) < y
      · simp only [hab, and_self, ↓reduceIte, mem_ofPred_eq] at hs
        exact ⟨hs.1, hab.1.trans hs.2.1, hs.2.2.trans hab.2⟩
      · simp only [hab, ↓reduceIte, mem_empty_iff_false] at hs
  let _ := ratSigma W ζ q
  rw [e]
  refine MeasurableSet.iUnion fun a => MeasurableSet.iUnion fun b => ?_
  split_ifs
  · exact measurableSet_ratGen_of_le W ζ r hr a b
  · exact MeasurableSet.empty

/-- At a rational time `r ≤ q`, the event `{r < ζ}`. -/
theorem measurableSet_lt_ratTime {q : ℝ≥0} (r : ℚ) (hr : (r : ℝ).toNNReal ≤ q) :
    MeasurableSet[ratSigma W ζ q] {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s} := by
  have e : {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s} =
      ⋃ m : ℕ, {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo (-(m : ℝ)) m} := by
    ext s
    simp only [mem_ofPred_eq, mem_iUnion, mem_Ioo]
    constructor
    · intro h
      obtain ⟨m, hm⟩ := exists_nat_gt |W (r : ℝ).toNNReal s|
      exact ⟨m, h, by linarith [neg_abs_le (W (r : ℝ).toNNReal s)], by linarith [le_abs_self (W (r : ℝ).toNNReal s)]⟩
    · rintro ⟨m, h, -⟩
      exact h
  let _ := ratSigma W ζ q
  rw [e]
  exact MeasurableSet.iUnion fun m => measurableSet_ratGen_Ioo W ζ r hr _ _

/-- The killed value `1_{t < ζ} W_t`. -/
def killedVal (t : ℝ≥0) (s : S) : ℝ := if (t : ℝ≥0∞) < ζ s then W t s else 0

/-- At a rational time `r ≤ q`, the killed value is measurable. -/
theorem measurable_killedVal_rat {q : ℝ≥0} (r : ℚ) (hr : (r : ℝ).toNNReal ≤ q) :
    Measurable[ratSigma W ζ q] (killedVal W ζ (r : ℝ).toNNReal) := by
  let _ := ratSigma W ζ q
  refine measurable_of_Iio fun x => ?_
  have e : killedVal W ζ (r : ℝ).toNNReal ⁻¹' Iio x =
      (⋃ m : ℕ, {s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s ∧ W (r : ℝ).toNNReal s ∈ Ioo (-(m : ℝ)) x}) ∪
        ({s | (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s}ᶜ ∩ {_s | (0 : ℝ) < x}) := by
    ext s
    simp only [killedVal, mem_preimage, mem_union, mem_iUnion, mem_ofPred_eq, mem_inter_iff, mem_compl_iff,
      mem_Iio, mem_Ioo]
    by_cases h : (((r : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s
    · simp only [h, ↓reduceIte, true_and, not_true_eq_false, false_and, or_false]
      constructor
      · intro hx
        obtain ⟨m, hm⟩ := exists_nat_gt |W (r : ℝ).toNNReal s|
        exact ⟨m, by linarith [neg_abs_le (W (r : ℝ).toNNReal s)], hx⟩
      · rintro ⟨m, -, hx⟩
        exact hx
    · simp [h]
  rw [e]
  refine (MeasurableSet.iUnion fun m => measurableSet_ratGen_Ioo W ζ r hr _ _).union
    ((measurableSet_lt_ratTime W ζ r hr).compl.inter ?_)
  by_cases h0 : (0 : ℝ) < x
  · simp only [h0, ofPred_true, MeasurableSet.univ]
  · simp only [h0, ofPred_false, MeasurableSet.empty]

/-- **The raw killed σ-algebra of a continuous driver at a rational time is generated by the rational events.** -/
theorem generateFrom_ratPi (hWc : ∀ s, Continuous fun t => W t s) {q : ℝ≥0}
    (hq : ∃ q₀ : ℚ, (q₀ : ℝ).toNNReal = q) :
    ratSigma W ζ q = killedDrivingSigma W (noMarks (S := S)) (noMarks (S := S)) ζ q := by
  obtain ⟨q₀, rfl⟩ := hq
  set q : ℝ≥0 := (q₀ : ℝ).toNNReal with hqdef
  let _ := ratSigma W ζ q
  refine le_antisymm (MeasurableSpace.generateFrom_le ?_) (MeasurableSpace.generateFrom_le ?_)
  · rintro _ ⟨T, rfl⟩
    refine Finset.measurableSet_biInter T fun j _ => ?_
    unfold ratGen
    split_ifs with hj
    · refine MeasurableSpace.measurableSet_generateFrom ⟨(j.1 : ℝ).toNNReal, hj,
        Ioo (j.2.1 : ℝ) (j.2.2 : ℝ) ×ˢ univ, measurableSet_Ioo.prod MeasurableSet.univ, ?_⟩
      ext s
      simp only [mem_ofPred_eq, mem_prod, mem_univ, and_true]
    · exact MeasurableSet.univ
  · rintro _ ⟨r, hrq, A, hA, rfl⟩
    -- the event `{r < ζ}` and the killed value at `r`
    have hlt : MeasurableSet[ratSigma W ζ q] {s | (r : ℝ≥0∞) < ζ s} := by
      rcases eq_or_lt_of_le hrq with hreq | hrlt
      · rw [hreq]; exact measurableSet_lt_ratTime W ζ q₀ le_rfl
      · have e : {s | (r : ℝ≥0∞) < ζ s} = ⋃ r' : ℚ, (if r < (r' : ℝ).toNNReal ∧ (r' : ℝ).toNNReal ≤ q then
            {s | (((r' : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s} else ∅) := by
          ext s
          simp only [mem_ofPred_eq, mem_iUnion]
          constructor
          · intro h
            have hc : (r : ℝ≥0∞) < min (q : ℝ≥0∞) (ζ s) := lt_min (by exact_mod_cast hrlt) h
            have hcfin : min (q : ℝ≥0∞) (ζ s) ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top (min_le_left _ _)
            have hcr : (r : ℝ) < (min (q : ℝ≥0∞) (ζ s)).toReal := by
              have := (ENNReal.toReal_lt_toReal ENNReal.coe_ne_top hcfin).2 hc
              simpa using this
            obtain ⟨r', h1, h2⟩ := exists_rat_btwn hcr
            have hr'0 : (0 : ℝ) ≤ r' := r.coe_nonneg.trans h1.le
            have hr'lt : (((r' : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < min (q : ℝ≥0∞) (ζ s) := by
              rw [← ENNReal.ofReal_toReal hcfin, ENNReal.ofReal]
              exact ENNReal.coe_lt_coe.2 ((Real.toNNReal_lt_toNNReal_iff' ).2 ⟨h2, lt_of_le_of_lt hr'0 h2⟩)
            have hr1 : r < (r' : ℝ).toNNReal := by
              rw [← NNReal.coe_lt_coe, Real.coe_toNNReal _ hr'0]; exact h1
            have hr2 : (r' : ℝ).toNNReal ≤ q := by
              exact_mod_cast (hr'lt.le.trans (min_le_left _ _))
            refine ⟨r', ?_⟩
            simp only [hr1, hr2, and_self, ↓reduceIte, mem_ofPred_eq]
            exact lt_of_lt_of_le hr'lt (min_le_right _ _)
          · rintro ⟨r', hs⟩
            by_cases hc : r < (r' : ℝ).toNNReal ∧ (r' : ℝ).toNNReal ≤ q
            · simp only [hc, and_self, ↓reduceIte, mem_ofPred_eq] at hs
              exact lt_trans (by exact_mod_cast hc.1) hs
            · simp only [hc, ↓reduceIte, mem_empty_iff_false] at hs
        rw [e]
        refine MeasurableSet.iUnion fun r' => ?_
        split_ifs with hc
        · exact measurableSet_lt_ratTime W ζ r' hc.2
        · exact MeasurableSet.empty
    have hval : Measurable[ratSigma W ζ q] (killedVal W ζ r) := by
      rcases eq_or_lt_of_le hrq with hreq | hrlt
      · rw [hreq]; exact measurable_killedVal_rat W ζ q₀ le_rfl
      · -- rational times decreasing to `r`
        have hpos : ∀ n : ℕ, (0 : ℝ) < 1 / ((n : ℝ) + 1) := fun n => by positivity
        have hex : ∀ n : ℕ, ∃ r' : ℚ, (r : ℝ) < r' ∧ (r' : ℝ) < min (q : ℝ) ((r : ℝ) + 1 / ((n : ℝ) + 1)) :=
          fun n => exists_rat_btwn (lt_min (by exact_mod_cast hrlt) (by linarith [hpos n]))
        choose rs hrs1 hrs2 using hex
        have hrs0 : ∀ n, (0 : ℝ) ≤ rs n := fun n => r.coe_nonneg.trans (hrs1 n).le
        have hrsq : ∀ n, (rs n : ℝ).toNNReal ≤ q := fun n => by
          rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ (hrs0 n)]
          exact ((hrs2 n).trans_le (min_le_left _ _)).le
        have hrsgt : ∀ n, r < (rs n : ℝ).toNNReal := fun n => by
          rw [← NNReal.coe_lt_coe, Real.coe_toNNReal _ (hrs0 n)]; exact hrs1 n
        have hlim : Tendsto (fun n => (rs n : ℝ).toNNReal) atTop (𝓝 r) := by
          rw [← NNReal.tendsto_coe]
          have hup : Tendsto (fun n : ℕ => (r : ℝ) + 1 / ((n : ℝ) + 1)) atTop (𝓝 (r : ℝ)) := by
            simpa using (tendsto_const_nhds (x := (r : ℝ))).add tendsto_one_div_add_atTop_nhds_zero_nat
          refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hup (fun n => ?_) (fun n => ?_)
          · show (r : ℝ) ≤ ((rs n : ℝ).toNNReal : ℝ)
            exact_mod_cast (hrsgt n).le
          · show ((rs n : ℝ).toNNReal : ℝ) ≤ (r : ℝ) + 1 / ((n : ℝ) + 1)
            rw [Real.coe_toNNReal _ (hrs0 n)]; exact ((hrs2 n).trans_le (min_le_right _ _)).le
        refine measurable_of_tendsto_metrizable (fun n => measurable_killedVal_rat W ζ (rs n) (hrsq n)) ?_
        refine tendsto_pi_nhds.2 fun s => ?_
        by_cases hζ : (r : ℝ≥0∞) < ζ s
        · have hev : ∀ᶠ n in atTop, (((rs n : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s := by
            have h1 : Tendsto (fun n => (((rs n : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞)) atTop (𝓝 (r : ℝ≥0∞)) :=
              (ENNReal.continuous_coe.tendsto r).comp hlim
            exact h1.eventually (eventually_lt_nhds hζ)
          have hW : Tendsto (fun n => W (rs n : ℝ).toNNReal s) atTop (𝓝 (W r s)) := ((hWc s).tendsto r).comp hlim
          simp only [killedVal, hζ, ↓reduceIte]
          exact hW.congr' (hev.mono fun n hn => by simp only [hn, ↓reduceIte])
        · simp only [killedVal, hζ, ↓reduceIte]
          refine tendsto_const_nhds.congr fun n => ?_
          have : ¬ (((rs n : ℝ).toNNReal : ℝ≥0) : ℝ≥0∞) < ζ s := fun h =>
            hζ (lt_trans (ENNReal.coe_lt_coe.2 (hrsgt n)) h)
          simp only [this, ↓reduceIte]
    -- the event
    set A₁ : Set ℝ := (fun x : ℝ => (x, (fun i => (0 : ℝ) : Fin 0 → ℝ), (fun i => (0 : ℝ) : Fin 0 → ℝ))) ⁻¹' A
      with hA₁
    have hA₁m : MeasurableSet A₁ := (measurable_id.prodMk measurable_const) hA
    have e : {s | (r : ℝ≥0∞) < ζ s ∧ (W r s, fun i => noMarks (S := S) i r s, fun i => noMarks (S := S) i r s) ∈ A} =
        {s | (r : ℝ≥0∞) < ζ s} ∩ killedVal W ζ r ⁻¹' A₁ := by
      ext s
      simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage, hA₁, killedVal]
      constructor
      · rintro ⟨h1, h2⟩
        refine ⟨h1, ?_⟩
        rw [ite_eq_left h1]
        convert h2 using 2
      · rintro ⟨h1, h2⟩
        rw [ite_eq_left h1] at h2
        exact ⟨h1, by convert h2 using 2⟩
    rw [e]
    exact hlt.inter (hval hA₁m)

end Gen

end InteractingSLE.Sec5.Aux61FibK
