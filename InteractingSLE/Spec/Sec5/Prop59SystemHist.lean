import InteractingSLE.Spec.Sec5.Prop59SystemMeas

/-!
# Proposition 5.9's alternating construction along the countable tree of switching histories

Packet PROVE-PROP59T4. Specification §5.2, proof of Proposition 5.9 (pp. 145–146): "Although the selected indices
depend on the revealed history, the set of all possible finite lists is countable. […] the realized prefix is one of
the trajectories used to define the prescribed light cone"; "Choose the least suitable index from a fixed
enumeration. […] it is chosen before the next piece is explored."

The realized construction is built from a **candidate family** `cand j t`: for every depth `j` and every finite list
`t : Fin j → ℝ≥0` of original switching times, the constant-angle piece (in the joint chart, relative to its start)
launched after switching at the times `t` — a fixed (non-adaptive) process for each list. Under the rule `r` (the grid
index used at each stage), the realized history at depth `j` is the random list of grid indices of the switches so far
(`HState.hist`), and the stage-`j` piece is the candidate at the realized list of original times (a countable mixture,
`mixPiece`). The start, the reached event and the revealed history are built recursively (`hstate`):

* the next start is PROVE-PROP59T2's `nextStart` at the switch;
* the next stage is reached iff this one is and succeeds (`succSet`);
* the next past is generated by the current past, the success events, the new history and the new start.

The stage system is `histSys` (`HState` read as `StageData`). Its structural facts (`IsStageSystem`, the coherence in
the rule, the monotone pasts, the reached events, the next starts, the measurability of the switching decisions) are
proved in `Prop59SystemStage` from per-candidate regularity (`IsRegFam`) and per-candidate chain data.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.Prop59System

open Prop59Stage

/-! ### Candidate pieces -/

/-- **A candidate piece** relative to its start: driver, left and right marks, driving Brownian motion, lifetime and
original clock. -/
structure Piece (Ω : Type*) (nL nR : ℕ) where
  /-- The relative driver. -/
  W : ℝ≥0 → Ω → ℝ
  /-- The relative left marks. -/
  VL : Fin nL → ℝ≥0 → Ω → ℝ
  /-- The relative right marks. -/
  VR : Fin nR → ℝ≥0 → Ω → ℝ
  /-- The driving Brownian motion. -/
  B : ℝ≥0 → Ω → ℝ
  /-- The lifetime. -/
  ζ : Ω → ℝ≥0∞
  /-- The original clock. -/
  clk : Ω → ℝ≥0 → ℝ≥0

/-- **A candidate family**: the piece launched after switching at the original times `t`, for every depth `j`. -/
abbrev CandFam (Ω : Type*) (nL₀ nR₀ : ℕ) := (j : ℕ) → (Fin j → ℝ≥0) → Piece Ω (nL₀ + j) (nR₀ + j)

variable {Ω : Type*} {nL₀ nR₀ : ℕ}

/-- **The mixture of candidates along a random index** `h`: at `ω` the piece `F (h ω)`. -/
def mixPiece {ι : Type*} {nL nR : ℕ} (F : ι → Piece Ω nL nR) (h : Ω → ι) : Piece Ω nL nR where
  W u ω := (F (h ω)).W u ω
  VL i u ω := (F (h ω)).VL i u ω
  VR k u ω := (F (h ω)).VR k u ω
  B u ω := (F (h ω)).B u ω
  ζ ω := (F (h ω)).ζ ω
  clk ω := (F (h ω)).clk ω

/-- A piece with a past, a reached event and a start. -/
def Piece.toStage {nL nR : ℕ} (p : Piece Ω nL nR) (past : MeasurableSpace Ω) (R : Set Ω) (y : Ω → Start nL nR) :
    StageData Ω nL nR :=
  ⟨past, R, y, p.W, p.VL, p.VR, p.B, p.ζ, p.clk⟩

/-- The far gap of a candidate piece at depth `j` (PROVE-PROP59T2's `farGap`; it does not see the start). -/
def pGap (hnL : 0 < nL₀) (hnR : 0 < nR₀) (j : ℕ) (p : Piece Ω (nL₀ + j) (nR₀ + j)) (ω : Ω) (u : ℝ≥0) : ℝ :=
  farGap hnL hnR j (p.toStage ⊥ ∅ fun _ => 0) ω u

/-! ### The recursive state -/

/-- **The realized state at the start of stage `j`**: the grid indices of the switches so far, the start, the event
that the stage is reached and the revealed history. -/
structure HState (Ω : Type*) (nL₀ nR₀ j : ℕ) where
  /-- The grid indices of the `j` switches so far. -/
  hist : Ω → Fin j → ℕ
  /-- The stage start. -/
  y : Ω → Start (nL₀ + j) (nR₀ + j)
  /-- The stage is reached. -/
  R : Set Ω
  /-- The revealed history. -/
  past : MeasurableSpace Ω

/-- The original switching times of a list of grid indices under the rule `r`. -/
def times (G : ℕ → ℕ → ℝ≥0) (r : ℕ → ℕ) {j : ℕ} (k : Fin j → ℕ) : Fin j → ℝ≥0 := fun i => G (r i) (k i)

/-- **The stage data at a state**: the candidate at the realized original switching times. -/
def stageOf (cand : CandFam Ω nL₀ nR₀) (G : ℕ → ℕ → ℝ≥0) (r : ℕ → ℕ) (j : ℕ) (st : HState Ω nL₀ nR₀ j) :
    StageData Ω (nL₀ + j) (nR₀ + j) :=
  (mixPiece (fun k : Fin j → ℕ => cand j (times G r k)) st.hist).toStage st.past st.R st.y

/-- The realized history after the switch of stage `j`. -/
def nextHist (G : ℕ → ℕ → ℝ≥0) (hnL : 0 < nL₀) (hnR : 0 < nR₀) (j : ℕ) (d : StageData Ω (nL₀ + j) (nR₀ + j))
    (n : ℕ) (hist : Ω → Fin j → ℕ) (ω : Ω) : Fin (j + 1) → ℕ :=
  Fin.snoc (α := fun _ => ℕ) (hist ω) (swIdx G hnL hnR j d n ω)

/-- **The information revealed by stage `j`**: its success events, the new history and the new start. -/
@[instance_reducible]
def stepSigma (G : ℕ → ℕ → ℝ≥0) (hnL : 0 < nL₀) (hnR : 0 < nR₀) (j : ℕ) (d : StageData Ω (nL₀ + j) (nR₀ + j))
    (n : ℕ) (hist : Ω → Fin j → ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {succSet G hnL hnR j d n,
      {ω | ω ∈ succSet G hnL hnR j d n ∧ (1 : ℝ≥0) ≤ swT G hnL hnR j d n ω}} ⊔
    MeasurableSpace.comap (fun ω => (nextHist G hnL hnR j d n hist ω, nextStart G hnL hnR j d n ω)) inferInstance

/-- **One step of the construction.** -/
def HState.next (cand : CandFam Ω nL₀ nR₀) (G : ℕ → ℕ → ℝ≥0) (hnL : 0 < nL₀) (hnR : 0 < nR₀) (r : ℕ → ℕ)
    (j : ℕ) (st : HState Ω nL₀ nR₀ j) : HState Ω nL₀ nR₀ (j + 1) where
  hist := nextHist G hnL hnR j (stageOf cand G r j st) (r j) st.hist
  y := nextStart G hnL hnR j (stageOf cand G r j st) (r j)
  R := st.R ∩ succSet G hnL hnR j (stageOf cand G r j st) (r j)
  past := st.past ⊔ stepSigma G hnL hnR j (stageOf cand G r j st) (r j) st.hist

/-- **The realized states** under the rule `r`, from the initial start `y₀`, reached event `R₀` and past `𝓑`. -/
def hstate (cand : CandFam Ω nL₀ nR₀) (G : ℕ → ℕ → ℝ≥0) (hnL : 0 < nL₀) (hnR : 0 < nR₀)
    (y₀ : Ω → Start (nL₀ + 0) (nR₀ + 0)) (R₀ : Set Ω) (𝓑 : MeasurableSpace Ω) (r : ℕ → ℕ) :
    (j : ℕ) → HState Ω nL₀ nR₀ j
  | 0 => ⟨fun _ => Fin.elim0, y₀, R₀, 𝓑⟩
  | j + 1 => (hstate cand G hnL hnR y₀ R₀ 𝓑 r j).next cand G hnL hnR r j

/-- **The stage system of the alternating construction along the tree of switching histories.** -/
def histSys (cand : CandFam Ω nL₀ nR₀) (G : ℕ → ℕ → ℝ≥0) (hnL : 0 < nL₀) (hnR : 0 < nR₀)
    (y₀ : Ω → Start (nL₀ + 0) (nR₀ + 0)) (R₀ : Set Ω) (𝓑 : MeasurableSpace Ω) : StageSys Ω nL₀ nR₀ :=
  fun r j => stageOf cand G r j (hstate cand G hnL hnR y₀ R₀ 𝓑 r j)

section Basic

variable {cand : CandFam Ω nL₀ nR₀} {G : ℕ → ℕ → ℝ≥0} {hnL : 0 < nL₀} {hnR : 0 < nR₀}
  {y₀ : Ω → Start (nL₀ + 0) (nR₀ + 0)} {R₀ : Set Ω} {𝓑 : MeasurableSpace Ω}

theorem histSys_apply (r : ℕ → ℕ) (j : ℕ) :
    histSys cand G hnL hnR y₀ R₀ 𝓑 r j = stageOf cand G r j (hstate cand G hnL hnR y₀ R₀ 𝓑 r j) := rfl

theorem hstate_succ (r : ℕ → ℕ) (j : ℕ) :
    hstate cand G hnL hnR y₀ R₀ 𝓑 r (j + 1) = (hstate cand G hnL hnR y₀ R₀ 𝓑 r j).next cand G hnL hnR r j := rfl

theorem histSys_R_succ (r : ℕ → ℕ) (j : ℕ) :
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r (j + 1)).R =
      (histSys cand G hnL hnR y₀ R₀ 𝓑 r j).R ∩ succSet G hnL hnR j (histSys cand G hnL hnR y₀ R₀ 𝓑 r j) (r j) :=
  rfl

theorem histSys_y_succ (r : ℕ → ℕ) (j : ℕ) :
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r (j + 1)).y =
      nextStart G hnL hnR j (histSys cand G hnL hnR y₀ R₀ 𝓑 r j) (r j) := rfl

theorem histSys_past_succ (r : ℕ → ℕ) (j : ℕ) :
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r (j + 1)).past = (histSys cand G hnL hnR y₀ R₀ 𝓑 r j).past ⊔
      stepSigma G hnL hnR j (histSys cand G hnL hnR y₀ R₀ 𝓑 r j) (r j)
        (hstate cand G hnL hnR y₀ R₀ 𝓑 r j).hist := rfl

theorem histSys_zero (r : ℕ → ℕ) :
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r 0).y = y₀ ∧ (histSys cand G hnL hnR y₀ R₀ 𝓑 r 0).R = R₀ ∧
      (histSys cand G hnL hnR y₀ R₀ 𝓑 r 0).past = 𝓑 := ⟨rfl, rfl, rfl⟩

/-- The stage piece is the candidate at the realized original switching times. -/
theorem histSys_piece (r : ℕ → ℕ) (j : ℕ) (ω : Ω) :
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r j).W = (fun u ω' =>
      (cand j (times G r ((hstate cand G hnL hnR y₀ R₀ 𝓑 r j).hist ω'))).W u ω') ∧
    (histSys cand G hnL hnR y₀ R₀ 𝓑 r j).ζ ω =
      (cand j (times G r ((hstate cand G hnL hnR y₀ R₀ 𝓑 r j).hist ω))).ζ ω := ⟨rfl, rfl⟩

/-- **Coherence in the rule**: stage `j` depends only on the grid indices of the earlier stages. -/
theorem hstate_congr {r r' : ℕ → ℕ} : ∀ j, (∀ i < j, r i = r' i) →
    hstate cand G hnL hnR y₀ R₀ 𝓑 r j = hstate cand G hnL hnR y₀ R₀ 𝓑 r' j
  | 0, _ => rfl
  | j + 1, h => by
    rw [hstate_succ, hstate_succ, hstate_congr j fun i hi => h i (Nat.lt_succ_of_lt hi)]
    have ht : (fun k : Fin j → ℕ => times G r k) = fun k => times G r' k := by
      funext k i
      simp only [times, h i (Nat.lt_succ_of_lt i.2)]
    have hj : r j = r' j := h j (Nat.lt_succ_self j)
    simp only [HState.next, stageOf, ht, hj]

theorem histSys_congr {r r' : ℕ → ℕ} (j : ℕ) (h : ∀ i < j, r i = r' i) :
    histSys cand G hnL hnR y₀ R₀ 𝓑 r j = histSys cand G hnL hnR y₀ R₀ 𝓑 r' j := by
  rw [histSys_apply, histSys_apply, hstate_congr j h]
  have ht : (fun k : Fin j → ℕ => times G r k) = fun k => times G r' k := by
    funext k i
    simp only [times, h i i.2]
  simp only [stageOf, ht]

/-- The farGap of the stage is the candidate's far gap at the realized history. -/
theorem farGap_histSys (r : ℕ → ℕ) (j : ℕ) (ω : Ω) (u : ℝ≥0) :
    farGap hnL hnR j (histSys cand G hnL hnR y₀ R₀ 𝓑 r j) ω u =
      pGap hnL hnR j (cand j (times G r ((hstate cand G hnL hnR y₀ R₀ 𝓑 r j).hist ω))) ω u := rfl

/-- The realized history after `j + 1` stages extends the one after `j` stages by the grid index of the switch. -/
theorem times_hist_succ (r : ℕ → ℕ) (j : ℕ) (ω : Ω) :
    times G r ((hstate cand G hnL hnR y₀ R₀ 𝓑 r (j + 1)).hist ω) =
      Fin.snoc (α := fun _ => ℝ≥0) (times G r ((hstate cand G hnL hnR y₀ R₀ 𝓑 r j).hist ω))
        (G (r j) (swIdx G hnL hnR j (histSys cand G hnL hnR y₀ R₀ 𝓑 r j) (r j) ω)) := by
  funext i
  refine Fin.lastCases ?_ (fun i' => ?_) i
  · simp only [times, hstate_succ, HState.next, nextHist, Fin.snoc_last, Fin.val_last, histSys_apply]
  · simp only [times, hstate_succ, HState.next, nextHist, Fin.snoc_castSucc, Fin.val_castSucc]

end Basic

end InteractingSLE.Sec5.Prop59System
