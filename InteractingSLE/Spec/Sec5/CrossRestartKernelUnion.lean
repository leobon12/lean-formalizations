/-!
# Lemma 4.7's direction, item (A): the flow segment and the counterflow hull, with both stopped records

Packet PROVE-CFRESTART, field side. Proposition 3.7 with both stopped records retained, in the strip, from the strip
hypothesis `CondIndep (σ(h)) (⨆ σ(η t)) (⨆ σ(W′ t))` alone (the trace `η` and the driver path `W′` need not be
measurable: they are arbitrary after their lifetimes).

* **`condIndep_aeSigma_inf`**: kernel-form conditional independence passes to the measurable events almost surely
  equal to events of the given σ-algebras (outer-measure congruence under the conditional kernel; no measurability of
  the given σ-algebras);
* **`condIndepEv_of_isAeGen`** (generic): if the σ-algebras `ℋ_i ≤ mΩ` are almost surely generated by `G_i`
  (`Coupling.IsAeGen`), `σ(G_i) ≤ M_i` and `M₁ ⟂ M₂ | σ(f)`, then `ℋ₁ ⟂ ℋ₂ | σ(f)` (event form);
* **`condIndepEv_stopped_strip`**: the stopped σ-algebras of the flow line's and the counterflow's driving filtrations
  are conditionally independent given the strip field;
* **`isHistoryAvoidanceLocal_union_strip`**: the flow hull `K_{τ₁}` (translated by the seed `x`) with the marks
  `𝓕_{τ₁}` of the flow line's driving filtration, and the counterflow hull `M_q⁻¹(K′_{τ₂})` with the marks `𝓕′_{τ₂}`
  of the counterflow's: their union satisfies the history-marked avoidance criterion for the centred strip field with
  the marks `𝓕_{τ₁} ∨ 𝓕′_{τ₂}` — the input of `WholeField.exists_condExp_germSigma_history` and Proposition 3.8. Each
  record is almost surely a function of what the strip hypothesis sees (`isAeGen_drivingFiltration_trace`,
  `isAeGen_drivingFiltration_drv`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

open QuantumZipper (H fwdHull)
open LQGMetric (DistOn IsZeroBoundaryGFF CondIndepEv)
open SupercriticalConformalCovariance.GM24 (smoothDist)

namespace InteractingSLE.Sec5.CrossRestart

open Coupling LocalSets

section Generic

variable {Ω : Type*} {M₁ M₂ ℋ₁ ℋ₂ F : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- **Kernel-form conditional independence passes to almost-sure events**, with no measurability of the given
σ-algebras: if `s =ᵐ s₀`, the conditional kernel gives `s` and `s₀` the same mass almost surely. -/
theorem condIndep_aeSigma_inf [StandardBorelSpace Ω] [IsFiniteMeasure P] (hF : F ≤ mΩ)
    (h : CondIndep F M₁ M₂ hF P) :
    CondIndep F (WangWu.aeSigma M₁ P ⊓ mΩ) (WangWu.aeSigma M₂ P ⊓ mΩ) hF P := by
  unfold CondIndep Kernel.Indep Kernel.IndepSets at h ⊢
  intro s t hs ht
  obtain ⟨⟨s₀, hs₀, hss⟩, -⟩ := MeasurableSpace.measurableSet_inf.1 hs
  obtain ⟨⟨t₀, ht₀, htt⟩, -⟩ := MeasurableSpace.measurableSet_inf.1 ht
  have hk : ∀ {u v : Set Ω}, u =ᵐ[P] v →
      ∀ᵐ a ∂(P.trim hF), condExpKernel P F a u = condExpKernel P F a v := by
    intro u v huv
    have h' : u =ᵐ[condExpKernel P F ∘ₘ P.trim hF] v := by
      rw [condExpKernel_comp_trim hF]
      exact huv
    filter_upwards [Measure.ae_ae_of_ae_comp h'] with a ha
    exact measure_congr ha
  filter_upwards [hk (hss.inter htt), hk hss, hk htt, h s₀ t₀ hs₀ ht₀] with a h1 h2 h3 h4
  rw [h1, h2, h3]
  exact h4

theorem condIndepEv_mono {G A B A' B' : MeasurableSpace Ω} (h : CondIndepEv G A B P) (hA : A' ≤ A) (hB : B' ≤ B) :
    CondIndepEv G A' B' P := fun a b ha hb => h a b (hA a ha) (hB b hb)

/-- **Conditional independence of almost surely generated σ-algebras**: if `ℋ_i` is almost surely generated by
`G_i`, `σ(G_i) ≤ M_i` and `M₁ ⟂ M₂ | σ(f)` (kernel form; `M_i` need not be measurable), then `ℋ₁ ⟂ ℋ₂ | σ(f)`. -/
theorem condIndepEv_of_isAeGen [StandardBorelSpace Ω] [IsFiniteMeasure P]
    {Z₁ Z₂ : Type*} [MeasurableSpace Z₁] [MeasurableSpace Z₂] {G₁ : Ω → Z₁} {G₂ : Ω → Z₂}
    {f : Ω → DistOn upperHalfPlaneOpens} (hf : Measurable f)
    (hG₁ : MeasurableSpace.comap G₁ inferInstance ≤ M₁) (hG₂ : MeasurableSpace.comap G₂ inferInstance ≤ M₂)
    (hci : CondIndep (MeasurableSpace.comap f inferInstance) M₁ M₂ hf.comap_le P)
    (hℋ₁ : ℋ₁ ≤ mΩ) (hℋ₂ : ℋ₂ ≤ mΩ) (hgen₁ : IsAeGen P G₁ ℋ₁) (hgen₂ : IsAeGen P G₂ ℋ₂) :
    CondIndepEv (MeasurableSpace.comap f inferInstance) ℋ₁ ℋ₂ P := by
  have hle₁ : ℋ₁ ≤ WangWu.aeSigma M₁ P ⊓ mΩ := fun s hs => by
    obtain ⟨C, hC, hsC⟩ := hgen₁ s hs
    exact MeasurableSpace.measurableSet_inf.2 ⟨⟨G₁ ⁻¹' C, hG₁ _ ⟨C, hC, rfl⟩, hsC⟩, hℋ₁ s hs⟩
  have hle₂ : ℋ₂ ≤ WangWu.aeSigma M₂ P ⊓ mΩ := fun s hs => by
    obtain ⟨C, hC, hsC⟩ := hgen₂ s hs
    exact MeasurableSpace.measurableSet_inf.2 ⟨⟨G₂ ⁻¹' C, hG₂ _ ⟨C, hC, rfl⟩, hsC⟩, hℋ₂ s hs⟩
  exact condIndepEv_mono ((LQGMetric.condIndep_iff_condIndepEv hf.comap_le inf_le_right inf_le_right).1
    (condIndep_aeSigma_inf hf.comap_le hci)) hle₁ hle₂

end Generic

/-! ### The strip -/

section Strip

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- **The two stopped records are conditionally independent given the strip field.** Flow line: an optional hull
coupling `(W, VL, VR, B, ζ)` (parameter `κ`) with generating trace `η − x`; counterflow: an optional hull coupling
`(W′, …, ζ′)` (parameter `κ′`). From the strip hypothesis `CondIndep (σ(h)) (⨆ σ(η t)) (⨆ σ(W′ t))`, the stopped
σ-algebras `𝓕_{τ₁}`, `𝓕′_{τ₂}` of the two driving filtrations (any stopping times) are conditionally independent given
`σ(h)`: each is almost surely generated by what the hypothesis sees (`isAeGen_drivingFiltration_trace`,
`isAeGen_drivingFiltration_drv`). -/
theorem condIndepEv_stopped_strip {κ κ' x : ℝ} (hκ : 0 < κ) (hκ' : 0 < κ')
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h)
    {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
    {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
    {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {h₁ : Ω → DistOn upperHalfPlaneOpens}
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h₁) (hX : IsMeasurableKilledDriving W VL VR ζ)
    {η : Ω → ℝ≥0 → ℂ} (htr : ∀ᵐ ω ∂P, IsGeneratingTrace (fun t => W t ω) (ζ ω) (fun t => η ω t - x))
    {τ₁ : Ω → WithTop ℝ≥0} (hτ₁ : IsStoppingTime (drivingFiltration P hX) τ₁)
    {mL mR : ℕ} {yL : Fin mL → ℝ} {yR : Fin mR → ℝ} {σL : Fin mL → ℝ} {σR : Fin mR → ℝ}
    {𝓕' : Filtration ℝ≥0 mΩ} {W' : ℝ≥0 → Ω → ℝ} {VL' : Fin mL → ℝ≥0 → Ω → ℝ} {VR' : Fin mR → ℝ≥0 → Ω → ℝ}
    {B' : ℝ≥0 → Ω → ℝ} {ζ' : Ω → ℝ≥0∞} {h₂ : Ω → DistOn upperHalfPlaneOpens}
    (hC' : IsOptionalHullCoupling κ' yL yR σL σR P 𝓕' W' VL' VR' B' ζ' h₂)
    (hX' : IsMeasurableKilledDriving W' VL' VR' ζ')
    {τ₂ : Ω → WithTop ℝ≥0} (hτ₂ : IsStoppingTime (drivingFiltration P hX') τ₂)
    (hci : CondIndep (MeasurableSpace.comap h inferInstance)
      (⨆ t : ℝ≥0, MeasurableSpace.comap (fun ω => η ω t) inferInstance)
      (⨆ t : ℝ≥0, MeasurableSpace.comap (W' t) inferInstance) hhm.comap_le P) :
    CondIndepEv (MeasurableSpace.comap h inferInstance) hτ₁.measurableSpace hτ₂.measurableSpace P := by
  have hgen₁ : IsAeGen P (fun ω t => η ω t - x) hτ₁.measurableSpace :=
    isAeGen_stopped (isAeGen_drivingFiltration_trace hκ hX hC.1.2.2.2.2 htr) hτ₁
  have hgen₂ : IsAeGen P (fun ω t => W' t ω) hτ₂.measurableSpace :=
    isAeGen_stopped (isAeGen_drivingFiltration_drv hκ' hX' hC'.1.2.2.2.2) hτ₂
  have hG₁ : MeasurableSpace.comap (fun ω t => η ω t - x) inferInstance ≤
      ⨆ t : ℝ≥0, MeasurableSpace.comap (fun ω => η ω t) inferInstance := by
    refine Measurable.comap_le ?_
    let _ : MeasurableSpace Ω := ⨆ t : ℝ≥0, MeasurableSpace.comap (fun ω => η ω t) inferInstance
    refine measurable_pi_iff.2 fun t => ?_
    exact ((comap_measurable (fun ω => η ω t)).mono (le_iSup (fun t : ℝ≥0 =>
      MeasurableSpace.comap (fun ω => η ω t) inferInstance) t) le_rfl).sub_const _
  have hG₂ : MeasurableSpace.comap (fun ω t => W' t ω) inferInstance ≤
      ⨆ t : ℝ≥0, MeasurableSpace.comap (W' t) inferInstance := by
    refine Measurable.comap_le ?_
    let _ : MeasurableSpace Ω := ⨆ t : ℝ≥0, MeasurableSpace.comap (W' t) inferInstance
    refine measurable_pi_iff.2 fun t => ?_
    exact (comap_measurable (W' t)).mono (le_iSup (fun t : ℝ≥0 => MeasurableSpace.comap (W' t) inferInstance) t)
      le_rfl
  exact condIndepEv_of_isAeGen hhm hG₁ hG₂ hci hτ₁.measurableSpace_le hτ₂.measurableSpace_le hgen₁ hgen₂

/-- **The flow segment and the counterflow hull with both stopped records (Proposition 3.7, retained histories).**
Flow line: an optional hull coupling `(h₁, W, VL, VR, B, ζ)` (parameter `κ`) of the translate `h₁` of the strip field
`h` by the seed `x`, with generating trace `η − x`; counterflow: an optional hull coupling `(h₂, W′, …, ζ′)`
(parameter `κ′`) of the `M_q`-chart transport `h₂` of `h`. Given the strip hypothesis
`CondIndep (σ(h)) (⨆ σ(η t)) (⨆ σ(W′ t))`, stopping times `τ₁ < ζ`, `τ₂ < ζ′` of the two driving filtrations, and
versions `A₁ = x + K_{τ₁}`, `A₂ = M_q⁻¹(K′_{τ₂})` measurable for the stopped σ-algebras, the union `A₁ ∪ A₂` satisfies
the history-marked avoidance criterion for the centred strip field `h − u₀` with the marks `𝓕_{τ₁} ∨ 𝓕′_{τ₂}`. -/
theorem isHistoryAvoidanceLocal_union_strip {κ κ' q x c a k : ℝ} (hκ : 0 < κ) (hκ' : 0 < κ') (hq : 0 < q)
    {h : Ω → DistOn upperHalfPlaneOpens} (hhm : Measurable h) {u₀ u₀' : ℂ → ℝ}
    (hh0 : IsZeroBoundaryGFF upperHalfPlaneOpens (WholeField.centredField h u₀) P)
    (hu₀ : InnerProductSpace.HarmonicOnNhd u₀ H)
    -- the flow line
    {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
    {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
    {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {h₁ : Ω → DistOn upperHalfPlaneOpens}
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h₁)
    (htrans : ∀ ω, IsTranslateAddConst x c (h ω) (h₁ ω))
    (hu₀' : IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR) (forceJumpSet xL xR) u₀')
    (hrel : EqOn u₀' (fun z => u₀ (z + x) + c) H) (hX : IsMeasurableKilledDriving W VL VR ζ)
    {η : Ω → ℝ≥0 → ℂ} (htr : ∀ᵐ ω ∂P, IsGeneratingTrace (fun t => W t ω) (ζ ω) (fun t => η ω t - x))
    {τ₁ : Ω → WithTop ℝ≥0} (hτ₁ : IsStoppingTime (drivingFiltration P hX) τ₁)
    (hτ₁ζ : ∀ᵐ ω ∂P, (τ₁ ω : ℝ≥0∞) < ζ ω) {A₁ : Ω → Set ℂ} (hA₁ : Measurable[hτ₁.measurableSpace, hittingSigma] A₁)
    (hAK₁ : ∀ᵐ ω ∂P, A₁ ω =
      (fun z : ℂ => z + x) '' fwdHull (fun s : ℝ => W s.toNNReal ω) ((τ₁ ω).untopD 0 : ℝ≥0))
    -- the counterflow
    {mL mR : ℕ} {yL : Fin mL → ℝ} {yR : Fin mR → ℝ} {σL : Fin mL → ℝ} {σR : Fin mR → ℝ}
    {𝓕' : Filtration ℝ≥0 mΩ} {W' : ℝ≥0 → Ω → ℝ} {VL' : Fin mL → ℝ≥0 → Ω → ℝ} {VR' : Fin mR → ℝ≥0 → Ω → ℝ}
    {B' : ℝ≥0 → Ω → ℝ} {ζ' : Ω → ℝ≥0∞} {h₂ : Ω → DistOn upperHalfPlaneOpens}
    (hC' : IsOptionalHullCoupling κ' yL yR σL σR P 𝓕' W' VL' VR' B' ζ' h₂)
    (htr' : ∀ ω, IsChartTransport (Sec4.stripCounterflowChart q) (-1) a k (h ω) (h₂ ω))
    (hX' : IsMeasurableKilledDriving W' VL' VR' ζ')
    {τ₂ : Ω → WithTop ℝ≥0} (hτ₂ : IsStoppingTime (drivingFiltration P hX') τ₂)
    (hτ₂ζ : ∀ᵐ ω ∂P, (τ₂ ω : ℝ≥0∞) < ζ' ω) {A₂ : Ω → Set ℂ}
    (hA₂ : Measurable[hτ₂.measurableSpace, hittingSigma] A₂)
    (hAK₂ : ∀ᵐ ω ∂P, A₂ ω = (Sec4.stripCounterflowChart q).2.1 ''
      fwdHull (fun s : ℝ => W' s.toNNReal ω) ((τ₂ ω).untopD 0 : ℝ≥0))
    -- the strip hypothesis
    (hci : CondIndep (MeasurableSpace.comap h inferInstance)
      (⨆ t : ℝ≥0, MeasurableSpace.comap (fun ω => η ω t) inferInstance)
      (⨆ t : ℝ≥0, MeasurableSpace.comap (W' t) inferInstance) hhm.comap_le P) :
    WholeField.IsHistoryAvoidanceLocal (hτ₁.measurableSpace ⊔ hτ₂.measurableSpace) (fun ω => A₁ ω ∪ A₂ ω)
      (WholeField.centredField h u₀) P := by
  have h₁loc := Sec7.SideHeight.isHistoryAvoidanceLocal_flowHull hC hκ htrans hh0 hu₀ hu₀' hrel hX hτ₁ hτ₁ζ
    (hA₁.mono hτ₁.measurableSpace_le le_rfl) hAK₁
  have h₂loc := isHistoryAvoidanceLocal_stripInv_hull hq hκ' hC' htr' hu₀ hh0 hX' hτ₂ hτ₂ζ
    (hA₂.mono hτ₂.measurableSpace_le le_rfl) hAK₂
  have hci' := condIndepEv_stopped_strip hκ hκ' hhm hC hX htr hτ₁ hC' hX' hτ₂ hci
  rw [← WholeField.comap_sub_dist h (smoothDist upperHalfPlaneOpens u₀)] at hci'
  exact WangWu.isHistoryAvoidanceLocal_union hτ₁.measurableSpace_le hτ₂.measurableSpace_le le_rfl le_rfl hA₁ hA₂
    hci' h₁loc h₂loc

end Strip

