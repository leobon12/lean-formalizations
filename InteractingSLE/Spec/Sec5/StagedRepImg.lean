/-! ### The named deterministic input -/

/-- **Loewner swallowing at the first contact of a killed arc** (deterministic; a named input, not proved here). Let
`γ` be a killed arc on `P` with finite terminal capacity `T`, and ordered marks `xL ≤ 0 ≤ xR` (the last index of each
side is the outermost mark). If the killed trace converges at `T` from the left to a real point `x₀` strictly beyond
the outermost mark of one side, then the killed driver and every killed mark have left limits at `T`, and the driver's
limit is that outermost mark's limit (the mark is swallowed at `T`). This is the classical fact that a Loewner chain
generated by a curve which is continuous up to a first real contact `x₀` has a continuous driver up to that time and
swallows every real point between the seed and `x₀`. -/
def KilledArcSwallowStatement : Prop :=
  ∀ (γ : ℝ → ℂ) (P : Set ℝ), IsKilledArc γ P → ∀ {n m : ℕ} (xL : Fin (n + 1) → ℝ) (xR : Fin (m + 1) → ℝ),
    (∀ i, xL i ≤ 0) → Antitone xL → (∀ j, 0 ≤ xR j) → Monotone xR → ∀ (T : ℝ≥0) (x₀ : ℝ),
    (T : WithTop ℝ≥0) = kLife γ P → (x₀ < xL (Fin.last n) ∨ xR (Fin.last m) < x₀) →
    Tendsto (kTrace γ P) (𝓝[<] T) (𝓝 (x₀ : ℂ)) →
    ∃ (w₀ : ℝ) (vL₀ : Fin (n + 1) → ℝ) (vR₀ : Fin (m + 1) → ℝ), Tendsto (kW γ P) (𝓝[<] T) (𝓝 w₀) ∧
      (∀ i, Tendsto (kVL γ P xL i) (𝓝[<] T) (𝓝 (vL₀ i))) ∧ (∀ j, Tendsto (kVR γ P xR j) (𝓝[<] T) (𝓝 (vR₀ j))) ∧
      (x₀ < xL (Fin.last n) → w₀ = vL₀ (Fin.last n)) ∧ (xR (Fin.last m) < x₀ → w₀ = vR₀ (Fin.last m))

/-! ### The limit of the killed image trace is not in `ℍ` -/

section NotH

variable {w : ℝ → ℝ} {s : ℝ} {η : ℝ → ℂ}

/-- **The killed image trace does not end in `ℍ`.** For the image `Ψ ∘ η` of a proper arc in the chart
`Ψ = revChart w s`, killed at its first contact with the reflected hull `G = R(K_s)`, a left limit of the killed trace
at a finite terminal capacity is not a point of `ℍ`: otherwise `η = Ψ⁻¹ ∘ (Ψ ∘ η)` would converge to a point of
`ℍ \ G`, while it ends on `G` (first contact) or tends to infinity (no contact). -/
theorem notMem_H_of_tendsto_kTrace (hw : Continuous w) (hw0 : w 0 = 0) (hs : 0 ≤ s)
    (hG : IsClosed (negInv '' fwdHull w s)) (hη : IsProperArc η) {T' : ℝ≥0}
    (hT' : (T' : WithTop ℝ≥0) = kLife (imgCurve w s η) (preContact η (negInv '' fwdHull w s))) {z : ℂ}
    (hz : Tendsto (kTrace (imgCurve w s η) (preContact η (negInv '' fwdHull w s))) (𝓝[<] T') (𝓝 z)) :
    z ∉ H := by
  intro hzH
  set G := negInv '' fwdHull w s with hGdef
  set γ := imgCurve w s η with hγdef
  set P := preContact η G with hPdef
  have hK : IsKilledArc γ P := isKilledArc_imgCurve hw hw0 hs hG hη
  have hPmem : ∀ u ∈ P, 0 < u → η u ∈ H \ G := fun u hu hu0 => ⟨hη.mem_H u hu0, hu.2 u ⟨hu.1, le_rfl⟩⟩
  have hlimγ : ∀ L : Filter ℝ, (∀ᶠ u in L, u ∈ P) → (∀ S ∈ P, ∀ᶠ u in L, S ≤ u) → Tendsto γ L (𝓝 z) := by
    intro L hLP hLS
    refine (hz.comp (tendsto_capClock_kLife hK hT' hLP hLS)).congr' ?_
    filter_upwards [hLP] with u hu
    exact kTrace_capClock hK hu
  have hcinv : ContinuousAt (revChartInv w s) z :=
    (continuousOn_revChartInv hw hw0 hs).continuousAt (QuantumZipper.isOpen_H.mem_nhds hzH)
  by_cases hbdd : BddAbove P
  · set τ := sSup P with hτdef
    have hPne : P.Nonempty := ⟨0, hK.zero_mem⟩
    obtain ⟨S₁, hS₁, hS₁0⟩ := hK.exists_gt 0 hK.zero_mem
    have hτ0 : 0 < τ := lt_of_lt_of_le hS₁0 (le_csSup hbdd hS₁)
    have hτP : τ ∉ P := fun h => by
      obtain ⟨S', hS', hτS'⟩ := hK.exists_gt τ h
      exact absurd (le_csSup hbdd hS') (not_le.2 hτS')
    have hIco : ∀ t, 0 ≤ t → t < τ → t ∈ P := fun t ht htτ => by
      obtain ⟨S, hS, htS⟩ := exists_lt_of_lt_csSup hPne htτ
      exact hK.icc S hS ⟨ht, htS.le⟩
    have hητG : η τ ∈ G := by
      by_contra hn
      refine hτP ⟨hτ0.le, fun u hu => ?_⟩
      rcases hu.2.lt_or_eq with hlt | rfl
      · exact (hIco u hu.1 hlt).2 u ⟨hu.1, le_rfl⟩
      · exact hn
    have hLP : ∀ᶠ u in 𝓝[<] τ, u ∈ P ∧ 0 < u := by
      filter_upwards [Ioo_mem_nhdsLT hτ0] with u hu
      exact ⟨hIco u hu.1.le hu.2, hu.1⟩
    have hLS : ∀ S ∈ P, ∀ᶠ u in 𝓝[<] τ, S ≤ u := fun S hS => by
      have hSτ : S < τ := lt_of_le_of_ne (le_csSup hbdd hS) fun h => hτP (h ▸ hS)
      filter_upwards [Ioo_mem_nhdsLT hSτ] with u hu
      exact hu.1.le
    have hγz := hlimγ _ (hLP.mono fun u hu => hu.1) hLS
    have hηc : Tendsto η (𝓝[<] τ) (𝓝 (η τ)) :=
      ((hη.cont.continuousAt (Ici_mem_nhds hτ0)).tendsto).mono_left nhdsWithin_le_nhds
    have hγΨ : ∀ᶠ u in 𝓝[<] τ, γ u = revChart w s (η u) := by
      filter_upwards [hLP] with u hu
      exact imgCurve_of_pos hu.2
    have hinv' : Tendsto η (𝓝[<] τ) (𝓝 (revChartInv w s z)) := by
      refine (hcinv.tendsto.comp hγz).congr' ?_
      filter_upwards [hLP, hγΨ] with u hu he
      simp only [Function.comp_apply]
      rw [he, revChartInv_revChart hw hw0 hs (hPmem u hu.1 hu.2)]
    have heq := tendsto_nhds_unique hηc hinv'
    exact (revChartInv_mem hw hw0 hs hzH).2 (heq ▸ hητG)
  · have hPall : ∀ t, 0 ≤ t → t ∈ P := fun t ht => by
      rw [not_bddAbove_iff] at hbdd
      obtain ⟨S, hS, htS⟩ := hbdd t
      exact hK.icc S hS ⟨ht, htS.le⟩
    have hLP : ∀ᶠ u in (atTop : Filter ℝ), u ∈ P ∧ 0 < u := by
      filter_upwards [eventually_gt_atTop 0] with u hu
      exact ⟨hPall u hu.le, hu⟩
    have hγz := hlimγ atTop (hLP.mono fun u hu => hu.1) fun S _ => eventually_ge_atTop S
    have hγΨ : ∀ᶠ u in (atTop : Filter ℝ), γ u = revChart w s (η u) := by
      filter_upwards [hLP] with u hu
      exact imgCurve_of_pos hu.2
    have hinv' : Tendsto η atTop (𝓝 (revChartInv w s z)) := by
      refine (hcinv.tendsto.comp hγz).congr' ?_
      filter_upwards [hLP, hγΨ] with u hu he
      simp only [Function.comp_apply]
      rw [he, revChartInv_revChart hw hw0 hs (hPmem u hu.1 hu.2)]
    exact not_tendsto_nhds_of_tendsto_atTop hη.tendsto _ ((continuous_norm.tendsto _).comp hinv')

end NotH

/-! ### A trace up to the killing time -/

section Trace

/-- **A trace up to the killing time** from traces of every closed initial segment before it and a left limit at a
finite killing time: the trace frozen at its left limit from the killing time on. -/
theorem exists_isGeneratingTrace_of_Icc {w : ℝ≥0 → ℝ} {T : ℝ≥0∞} {γ : ℝ≥0 → ℂ} (hT0 : 0 < T)
    (hI : ∀ t : ℝ≥0, (t : ℝ≥0∞) < T → Sec7.IsGeneratingTraceIcc w t γ)
    (hlim : ∀ T' : ℝ≥0, (T' : ℝ≥0∞) = T → ∃ z, Tendsto γ (𝓝[<] T') (𝓝 z)) :
    ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w T η := by
  -- continuity of `γ` at every time before `T`
  have hcont : ∀ u : ℝ≥0, (u : ℝ≥0∞) < T → ContinuousAt γ u := by
    intro u hu
    obtain ⟨t', hut', ht'T⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hu
    have hc := (hI t' ht'T).1.2.1
    have hmem : {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (t' : ℝ≥0∞)} ∈ 𝓝 u := by
      have : Iic t' ∈ 𝓝 u := Iic_mem_nhds (ENNReal.coe_lt_coe.1 hut')
      refine Filter.mem_of_superset this fun t ht => ?_
      exact ENNReal.coe_le_coe.2 ht
    exact hc.continuousAt hmem
  have h0 : γ 0 = 0 := (hI 0 (by simpa using hT0)).1.1
  induction T using ENNReal.recTopCoe with
  | top =>
    refine ⟨γ, h0, fun u _ => (hcont u ENNReal.coe_lt_top).continuousWithinAt, fun t ht => (hI t ht).2.1⟩
  | coe T' =>
    obtain ⟨z, hz⟩ := hlim T' rfl
    classical
    set η : ℝ≥0 → ℂ := fun t => if t < T' then γ t else z with hηdef
    have hT'0 : 0 < T' := by exact_mod_cast hT0
    have hηγ : ∀ t, t < T' → η t = γ t := fun t ht => by simp only [hηdef, ht, ↓reduceIte]
    refine ⟨η, by rw [hηγ 0 hT'0, h0], ?_, fun t ht => ?_⟩
    · intro u hu
      have hu' : u ≤ T' := ENNReal.coe_le_coe.1 hu
      have hset : {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (T' : ℝ≥0∞)} = Iic T' := by
        ext t; simp only [mem_ofPred_eq, mem_Iic, ENNReal.coe_le_coe]
      rw [hset]
      rcases hu'.lt_or_eq with hlt | rfl
      · have hev : η =ᶠ[𝓝 u] γ := by
          filter_upwards [Iio_mem_nhds hlt] with t ht
          exact hηγ t ht
        exact ((hcont u (ENNReal.coe_lt_coe.2 hlt)).congr_of_eventuallyEq hev).continuousWithinAt
      · rw [← continuousWithinAt_Iio_iff_Iic]
        have hηu : η u = z := by simp only [hηdef, lt_irrefl, ↓reduceIte]
        show Tendsto η (𝓝[<] u) (𝓝 (η u))
        rw [hηu]
        refine hz.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with t ht
        exact (hηγ t ht).symm
    · have ht' : t < T' := ENNReal.coe_lt_coe.1 ht
      have himg : η '' Icc 0 t = γ '' Icc 0 t :=
        image_congr fun r hr => hηγ r (lt_of_le_of_lt hr.2 ht')
      rw [himg]
      exact (hI t ht).2.1

end Trace

/-! ### The image word on the glued space -/

section Img

variable {κ : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {Ω : Type u} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
  {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
  {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {h : Ω → DistOn upperHalfPlaneOpens}
  {Ω₂ : Type u} {_mΩ₂ : MeasurableSpace Ω₂} {P₂ : Measure Ω₂} [IsProbabilityMeasure P₂]
  {h₂ : Ω₂ → DistOn upperHalfPlaneOpens} {W₂ : ℝ≥0 → Ω₂ → ℝ} {ζ₂ : Ω₂ → ℝ≥0∞}

/-- **The killed image word ends at a real point left of the left junction**, almost surely on the glued space:
its killing time is finite and its trace converges there to a real point strictly left of the last left mark. -/
theorem ae_imgFar (hκ : 0 < κ) (hκ4 : κ < 4) (hF : IsOrderedForceWord xL xR) (h44 : Sec4.Cond44 κ ρL ρR)
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hcf : IsCenteredCounterflowDriver κ P₂ h₂ W₂ ζ₂) (hlaw : P.map (fun ω => cfField κ (h ω)) = P₂.map h₂)
    (k : Kernel (DistOn upperHalfPlaneOpens) (HistorySpace 0 0)) [IsMarkovKernel k]
    (hk : P₂.map (fun ω => (h₂ ω, cfHistory W₂ ζ₂ ω)) = P₂.map h₂ ⊗ₘ k) {s : ℝ≥0} (hs : 0 < s) :
    ∀ᵐ p ∂(glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)),
      p ∈ glueGood (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) s ζ W ∧
      ∃ (T : ℝ≥0) (x₀ : ℝ), (T : WithTop ℝ≥0) = imgT s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
          ((measurable_cfField κ).comp hC.2.1)) s ζ W) p ∧
        x₀ < gXL xL s (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
          ((measurable_cfField κ).comp hC.2.1)) s ζ W) p (Fin.last nL) ∧
        Tendsto (imgTr s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
          ((measurable_cfField κ).comp hC.2.1)) s ζ W) p) (𝓝[<] T) (𝓝 (x₀ : ℂ)) := by
  set μ := glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1) with hμ
  set E := glueGood μ s ζ W with hEdef
  have hEg : ∀ p ∈ E, IsGood49 s ζ W p := isGood49_of_mem_glueGood
  have hae : ∀ᵐ p ∂μ, IsGood49 s ζ W p := by
    filter_upwards [cfGlueAE_isGood49 s hs κ hκ hκ4 xL xR ρL ρR hF h44 P 𝓕 W VL VR B ζ h hC P₂ h₂ W₂ ζ₂ hcf
      hlaw k hk] with p hp
    exact isGood49_of_mem hp.1 hp.2
  filter_upwards [ae_imgExit hκ hκ4 hF h44 hC hcf hlaw k hk hs, ae_mem_glueGood hae] with p hp hpE
  obtain ⟨hTne, z, hz, hzalt⟩ := hp
  refine ⟨hpE, ?_⟩
  obtain ⟨T, hT⟩ : ∃ T : ℝ≥0, (T : WithTop ℝ≥0) = imgT s ζ W E p := WithTop.ne_top_iff_exists.1 hTne
  have hTn : ENNReal.toNNReal (imgT s ζ W E p : ℝ≥0∞) = T := by
    rw [← hT]; rfl
  rw [hTn] at hz
  obtain ⟨hα, hG, -, -, hQ⟩ := hEg p hpE
  have hzH : z ∉ H := by
    have hT' : (T : WithTop ℝ≥0) = kLife (imgCurve (cfDrv0 s p.2) s (seedLine ζ W p.1))
        (preContact (seedLine ζ W p.1) (negInv '' fwdHull (cfDrv0 s p.2) s)) := by
      rw [hT]
      simp only [Word49.imgT]; rw [Word49.gCurve_of_mem hpE, Word49.gPre_of_mem hpE, hQ]
    have hz' : Tendsto (kTrace (imgCurve (cfDrv0 s p.2) s (seedLine ζ W p.1))
        (preContact (seedLine ζ W p.1) (negInv '' fwdHull (cfDrv0 s p.2) s))) (𝓝[<] T) (𝓝 z) := by
      have e : imgTr s ζ W E p = kTrace (imgCurve (cfDrv0 s p.2) s (seedLine ζ W p.1))
          (preContact (seedLine ζ W p.1) (negInv '' fwdHull (cfDrv0 s p.2) s)) := by
        simp only [Word49.imgTr]; rw [Word49.gCurve_of_mem hpE, Word49.gPre_of_mem hpE, hQ]
      rw [← e]; exact hz
    exact notMem_H_of_tendsto_kTrace (continuous_cfDrv0 s p.2) (cfDrv0_zero s p.2) s.coe_nonneg hG hα hT' hz'
  rcases hzalt with hzH' | ⟨x₀, hx₀, rfl⟩
  · exact absurd hzH' hzH
  · exact ⟨T, x₀, hT, hx₀, hz⟩

/-- **The past of the root stage** on the extended glued space: the counterflow history stopped at `s`. -/
abbrev cfPast (s : ℝ≥0) (Ω' : Type*) : MeasurableSpace ((Ω × HistorySpace 0 0) × Ω') :=
  MeasurableSpace.comap (fun p => GlueCond.cfStop s p.1.2) inferInstance

/-- **The stopped representation of Proposition 5.9's root stage on the glued space** (the image word of
Proposition 4.9, conditionally on the counterflow stopped at `s`). In the setting of `Prop411Q.CfGlueAE`, for every
counterflow time `s > 0`, there is an auxiliary Brownian factor `(Ω₀, P₀)` such that on the glued space `μ ⊗ P₀` the
killed image word — driver `imgW`, marks `imgVL`, `imgVR` (flow marks and the two junctions, far marks `Fin.last`),
killing time `imgT`, weights `(jwL cL6 κ ρL; jwR cR6 κ ρR)` (R57) — has the stopped representation
`IsKilledStageRep` with respect to the stopped counterflow history `cfPast s`, its noise being the Brownian motion
`Bi` of the image filtration (extended by `Ω₀`). Inputs: the named deterministic `KilledArcSwallowStatement`, and the
strict order of the image start almost surely (`hstr`). -/
theorem exists_isKilledStageRep_img (hsw : KilledArcSwallowStatement) (hκ : 0 < κ) (hκ4 : κ < 4)
    (hF : IsOrderedForceWord xL xR) (h44 : Sec4.Cond44 κ ρL ρR)
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hcf : IsCenteredCounterflowDriver κ P₂ h₂ W₂ ζ₂) (hlaw : P.map (fun ω => cfField κ (h ω)) = P₂.map h₂)
    (k : Kernel (DistOn upperHalfPlaneOpens) (HistorySpace 0 0)) [IsMarkovKernel k]
    (hk : P₂.map (fun ω => (h₂ ω, cfHistory W₂ ζ₂ ω)) = P₂.map h₂ ⊗ₘ k) {s : ℝ≥0} (hs : 0 < s)
    (hstr : ∀ᵐ p ∂(glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)),
      StrictAnti (fun i => imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
        ((measurable_cfField κ).comp hC.2.1)) s ζ W) i 0 p) ∧
      StrictMono (fun j => imgVR xR s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
        ((measurable_cfField κ).comp hC.2.1)) s ζ W) j 0 p)) :
    ∃ (Ω₀ : Type) (m₀ : MeasurableSpace Ω₀) (P₀ : Measure Ω₀) (_ : IsProbabilityMeasure P₀)
      (𝓦 : Filtration ℝ≥0 m₀) (Bi : ℝ≥0 → (Ω × HistorySpace 0 0) × Ω₀ → ℝ),
      IsKilledStageRep κ ((glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)).prod P₀)
        (cfPast s Ω₀) univ (jwL cL6 κ ρL) (jwR cR6 κ ρR) (Fin.last nL) (Fin.last nR)
        (fun p => ((0 : ℝ), fun i => imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) i 0 p.1,
          fun j => imgVR xR s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) j 0 p.1))
        (fun t p => imgW s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
          ((measurable_cfField κ).comp hC.2.1)) s ζ W) t p.1)
        (fun i t p => imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
