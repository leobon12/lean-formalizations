/-!
# The flow line given the counterflow prefix: the image word is a killed integrated `SLE_κ(ρ′)` word, given the
martingale clause

Packet PROVE-GLUECOND5, G4 for Proposition 4.9's direction at general `κ` (the general-`κ` form of WangWu's
`ReverseContactMartFilt`, PROVE-WW-B17, and of its use of Lemma 2.11). Astra's Part E.7: "The algebraic
characterization in Theorem 2.4 … has the same proof in this given filtration: its semimartingale extraction and drift
and quadratic variation identification use precisely the continuous local martingales just established … It identifies
the integrated SLE equations and constructs their Brownian motion in that filtration."

* `imgGen`, `imgRaw`, `imgFilt`: the filtration of the image word (generated by the killed image word, the killing and
  announcing events, and at time `0` the counterflow history stopped at `s`, which carries the chart `Ψ`), and its
  usual augmentation under the glued measure;
* `glueGood μ s ζ W`: a measurable set of good glued samples, of full measure in the setting of `Prop411Q.CfGlueAE`
  (`ae_mem_glueGood`, from `Word49.cfGlueAE_isGood49`);
* **`ImageWord49FiltStatement`** (named input, the field side of G4 in this direction): the explicit coupling means of
  the killed image word, with the weights `imgρL κ ρL`, `imgρR ρR`, are local martingales in `imgFilt`;
* **`exists_isWordEntrance_of_filt`**: given it, on `μ ⊗ P₀` there is a Brownian motion of the product filtration
  driving, almost surely, the integrated `SLE_κ(ρ′)` equations of the image word on `[0, imgT)` (WangWu's
  `IsKilledWord.exists_isWordEntrance`, Lemma 2.11 for a killed word). This is the conditional law of the flow line
  given the counterflow prefix, killed at the first contact, in the form Theorem 2.4 produces.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Metric Filter Topology Complex
open QuantumZipper (H fwdHull fwdMap)
open LQGMetric (DistOn TestOn)
open scoped NNReal ENNReal

universe u

namespace InteractingSLE.Sec5.CrossCond

open WangWu hiding ratPt exists_ratPt_dist_lt
open WangWu.ImgWord LawUnique GlueCond Cond44Ref CfRegQ Prop411Q
open ImgDrv MartChar Sec7.PhaseSelFull Sec7.Aux117

namespace Word49

section Def

variable {Ω : Type*} [MeasurableSpace Ω] {nL nR : ℕ}

/-- The generating events of the raw filtration of the image word at time `r`: the word, the killing and announcing
events up to `r`, and (at time `0`) the counterflow history stopped at `s`. -/
def imgGen (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (s : ℝ≥0) (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ)
    (E : Set (Ω × HistorySpace 0 0)) (r : ℝ≥0) : Set (Set (Ω × HistorySpace 0 0)) :=
  {A | ∃ r' : ℝ≥0, r' ≤ r ∧ ((∃ B : Set ℝ, MeasurableSet B ∧ (A = imgW s ζ W E r' ⁻¹' B ∨
    (∃ i, A = imgVL xL s ζ W E i r' ⁻¹' B) ∨ ∃ j, A = imgVR xR s ζ W E j r' ⁻¹' B)) ∨
    A = {p | (r' : WithTop ℝ≥0) < imgT s ζ W E p} ∨ (∃ n, A = {p | imgAnn s ζ W E n p ≤ r'}) ∨
    ∃ B : Set (HistorySpace 0 0), MeasurableSet B ∧ A = (fun p => cfStop s p.2) ⁻¹' B)}

/-- **The raw filtration of the image word** (intersected with the ambient σ-algebra). -/
def imgRaw (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (s : ℝ≥0) (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ)
    (E : Set (Ω × HistorySpace 0 0)) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Ω × HistorySpace 0 0)) where
  seq r := MeasurableSpace.generateFrom (imgGen xL xR s ζ W E r) ⊓ inferInstance
  mono' r r' hrr' := by
    refine inf_le_inf_right _ (MeasurableSpace.generateFrom_mono ?_)
    rintro A ⟨r'', hr'', h⟩
    exact ⟨r'', hr''.trans hrr', h⟩
  le' _ := inf_le_right

/-- **The filtration of the image word**: the usual augmentation of `imgRaw` under `μ`. -/
def imgFilt (μ : Measure (Ω × HistorySpace 0 0)) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (s : ℝ≥0)
    (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ) (E : Set (Ω × HistorySpace 0 0)) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Ω × HistorySpace 0 0)) :=
  usualAugmentation (imgRaw xL xR s ζ W E) μ

/-- **A measurable set of good glued samples** of full `μ`-measure (when good samples have full measure). -/
def glueGood (μ : Measure (Ω × HistorySpace 0 0)) (s : ℝ≥0) (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ) :
    Set (Ω × HistorySpace 0 0) :=
  (toMeasurable μ {p | ¬ IsGood49 s ζ W p})ᶜ

end Def

section Filt

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {𝓕 : Filtration ℝ≥0 mΩ} {s : ℝ≥0} {ζ : Ω → ℝ≥0∞}
  {W : ℝ≥0 → Ω → ℝ} {E : Set (Ω × HistorySpace 0 0)} {μ : Measure (Ω × HistorySpace 0 0)} {nL nR : ℕ}
  {xL : Fin nL → ℝ} {xR : Fin nR → ℝ}

theorem measurableSet_glueGood : MeasurableSet (glueGood μ s ζ W) := (measurableSet_toMeasurable _ _).compl

theorem isGood49_of_mem_glueGood : ∀ p ∈ glueGood μ s ζ W, IsGood49 s ζ W p := fun p hp => by
  by_contra h
  exact hp (subset_toMeasurable _ _ h)

theorem ae_mem_glueGood (hae : ∀ᵐ p ∂μ, IsGood49 s ζ W p) : ∀ᵐ p ∂μ, p ∈ glueGood μ s ζ W := by
  rw [ae_iff]
  have : {a | ¬ a ∈ glueGood μ s ζ W} = toMeasurable μ {p | ¬ IsGood49 s ζ W p} := by
    ext p; simp [glueGood]
  rw [this, measure_toMeasurable]
  exact ae_iff.1 hae

theorem measurableSet_imgRaw_of_gen {r : ℝ≥0} {A : Set (Ω × HistorySpace 0 0)}
    (hA : A ∈ imgGen xL xR s ζ W E r) (hAm : MeasurableSet A) : MeasurableSet[imgRaw xL xR s ζ W E r] A :=
  ⟨MeasurableSpace.measurableSet_generateFrom hA, hAm⟩

theorem measurableSet_imgFilt_of_gen {r : ℝ≥0} {A : Set (Ω × HistorySpace 0 0)}
    (hA : A ∈ imgGen xL xR s ζ W E r) (hAm : MeasurableSet A) : MeasurableSet[imgFilt μ xL xR s ζ W E r] A :=
  Ito.le_usualAugmentation (imgRaw xL xR s ζ W E) μ r _ (measurableSet_imgRaw_of_gen hA hAm)

/-- A process whose preimages at time `r` are generators is adapted to the filtration of the image word. -/
theorem stronglyAdapted_imgFilt_of {X : ℝ≥0 → Ω × HistorySpace 0 0 → ℝ} (hX : ∀ r, Measurable (X r))
    (hgen : ∀ r (B : Set ℝ), MeasurableSet B → X r ⁻¹' B ∈ imgGen xL xR s ζ W E r) :
    StronglyAdapted (imgFilt μ xL xR s ζ W E) X := fun r => by
  have hm : Measurable[imgFilt μ xL xR s ζ W E r] (X r) := fun B hB =>
    measurableSet_imgFilt_of_gen (hgen r B hB) (hX r hB)
  exact hm.stronglyMeasurable

/-- The counterflow history stopped at `s` (which carries the chart `Ψ`) is known at time `0`. -/
theorem measurable_cfStop_imgFilt (r : ℝ≥0) :
    Measurable[imgFilt μ xL xR s ζ W E r] fun p : Ω × HistorySpace 0 0 => cfStop s p.2 := fun B hB =>
  measurableSet_imgFilt_of_gen ⟨0, zero_le, Or.inr (Or.inr (Or.inr ⟨B, hB, rfl⟩))⟩
    ((measurable_cfStop s).comp measurable_snd hB)

/-- **The filtration clauses of the image word** (WangWu's `imageWordMartStatement_of_imageWordFilt` at general `κ`):
the filtration contains the null sets at time `0`, the word is adapted, the announcing times are stopping times below
the killing time, increasing and (almost surely) exhausting it, and `{q < imgT} ∈ 𝓖_q`. -/
theorem filtClauses (hW : AdaptedBefore 𝓕 ζ W) (hF : IsOrderedForceWord xL xR)
    (hae : ∀ᵐ p ∂μ, IsGood49 s ζ W p) :
    (∀ A, MeasurableSet A → μ A = 0 → MeasurableSet[imgFilt μ xL xR s ζ W (glueGood μ s ζ W) 0] A) ∧
    IsKilledWord (imgW s ζ W (glueGood μ s ζ W)) (imgVL xL s ζ W (glueGood μ s ζ W))
      (imgVR xR s ζ W (glueGood μ s ζ W)) (imgT s ζ W (glueGood μ s ζ W)) ∧
    StronglyAdapted (imgFilt μ xL xR s ζ W (glueGood μ s ζ W)) (imgW s ζ W (glueGood μ s ζ W)) ∧
    (∀ i, StronglyAdapted (imgFilt μ xL xR s ζ W (glueGood μ s ζ W)) (imgVL xL s ζ W (glueGood μ s ζ W) i)) ∧
    (∀ j, StronglyAdapted (imgFilt μ xL xR s ζ W (glueGood μ s ζ W)) (imgVR xR s ζ W (glueGood μ s ζ W) j)) ∧
    (∀ n, IsStoppingTime (imgFilt μ xL xR s ζ W (glueGood μ s ζ W))
      fun p => (imgAnn s ζ W (glueGood μ s ζ W) n p : WithTop ℝ≥0)) ∧
    (∀ p, Monotone (imgAnn s ζ W (glueGood μ s ζ W) · p)) ∧
    (∀ n p, (imgAnn s ζ W (glueGood μ s ζ W) n p : WithTop ℝ≥0) < imgT s ζ W (glueGood μ s ζ W) p) ∧
    (∀ᵐ p ∂μ, ∀ u : ℝ≥0, (u : WithTop ℝ≥0) < imgT s ζ W (glueGood μ s ζ W) p →
      ∃ n, u ≤ imgAnn s ζ W (glueGood μ s ζ W) n p) ∧
    ∀ q : ℝ≥0, MeasurableSet[imgFilt μ xL xR s ζ W (glueGood μ s ζ W) q]
      {p | (q : WithTop ℝ≥0) < imgT s ζ W (glueGood μ s ζ W) p} := by
  set E := glueGood μ s ζ W with hEdef
  have hE : MeasurableSet E := measurableSet_glueGood
  have hEg : ∀ p ∈ E, IsGood49 s ζ W p := isGood49_of_mem_glueGood
  refine ⟨fun A hA h0 => Ito.measurableSet_usualAugmentation_of_null hA h0 0, isKilledWord_img hF hEg, ?_,
    fun i => ?_, fun j => ?_, fun n => ?_, monotone_imgAnn hEg, fun n p => imgAnn_lt_imgT hEg n p, ?_,
    fun q => ?_⟩
  · exact stronglyAdapted_imgFilt_of (measurable_imgW hW hE hEg) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inl rfl⟩⟩
  · exact stronglyAdapted_imgFilt_of (measurable_imgVL xL hW hE hEg i) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inr (Or.inl ⟨i, rfl⟩)⟩⟩
  · exact stronglyAdapted_imgFilt_of (measurable_imgVR xR hW hE hEg j) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inr (Or.inr ⟨j, rfl⟩)⟩⟩
  · intro r
    have e : {p : Ω × HistorySpace 0 0 | ((imgAnn s ζ W E n p : ℝ≥0) : WithTop ℝ≥0) ≤ r} =
        {p | imgAnn s ζ W E n p ≤ r} := by
      ext p
      simp only [mem_ofPred_eq, WithTop.coe_le_coe]
    rw [e]
    exact measurableSet_imgFilt_of_gen ⟨r, le_rfl, Or.inr (Or.inr (Or.inl ⟨n, rfl⟩))⟩
      (measurableSet_le (measurable_imgAnn hW hE hEg n) measurable_const)
  · filter_upwards [ae_mem_glueGood hae] with p hp
    exact fun u hu => exists_le_imgAnn hEg hp hu
  · exact measurableSet_imgFilt_of_gen ⟨q, le_rfl, Or.inr (Or.inl rfl)⟩
      (measurableSet_lt_imgT hW hE hEg q)

end Filt

/-! ### The named martingale clause and the word entrance -/

/-- **Named input: the field side of G4 in Proposition 4.9's direction** (Astra's E.2–E.7 at general `κ`: the
history-marked union law, PROVE-GLUECOND4's identification of the union mean in the chart `Ψ`, the optional passage of
the conditional characteristic functions and the random chart). In the setting of `Prop411Q.CfGlueAE`, for every
counterflow time `s > 0` and every `z ∈ ℍ`, the explicit coupling mean (parameter `κ`, weights `imgρL κ ρL`,
`imgρR ρR`) of the killed image word of the flow line in the counterflow chart is a local martingale before
`min (swallowTime z) imgT` in the filtration of the image word, under the glued measure. -/
def ImageWord49FiltStatement : Prop :=
  ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ {nL nR : ℕ} (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ)
    (ρR : Fin nR → ℝ), IsOrderedForceWord xL xR → Sec4.Cond44 κ ρL ρR →
    ∀ {Ω : Type u} {mΩ : MeasurableSpace Ω} (P : Measure Ω) [IsProbabilityMeasure P]
      (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ)
      (B : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (h : Ω → DistOn upperHalfPlaneOpens)
      (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
      {Ω₂ : Type u} {_mΩ₂ : MeasurableSpace Ω₂} (P₂ : Measure Ω₂) [IsProbabilityMeasure P₂]
      (h₂ : Ω₂ → DistOn upperHalfPlaneOpens) (W₂ : ℝ≥0 → Ω₂ → ℝ) (ζ₂ : Ω₂ → ℝ≥0∞),
      IsCenteredCounterflowDriver κ P₂ h₂ W₂ ζ₂ →
      P.map (fun ω => cfField κ (h ω)) = P₂.map h₂ →
      ∀ (k : Kernel (DistOn upperHalfPlaneOpens) (HistorySpace 0 0)) [IsMarkovKernel k],
        P₂.map (fun ω => (h₂ ω, cfHistory W₂ ζ₂ ω)) = P₂.map h₂ ⊗ₘ k →
        ∀ s : ℝ≥0, 0 < s → ∀ z ∈ H,
          IsLocalMartingaleBefore
            (imgFilt (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) xL xR s ζ W
              (glueGood (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) s ζ W))
            (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1))
            (fun p => min (QuantumZipper.swallowTime (wpath (imgW s ζ W
                (glueGood (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) s ζ W))
                p) z : WithTop ℝ≥0)
              (imgT s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
                ((measurable_cfField κ).comp hC.2.1)) s ζ W) p))
            (coupProc κ (imgρL κ ρL) (imgρR ρR)
              (imgW s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
                ((measurable_cfField κ).comp hC.2.1)) s ζ W))
              (imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
                ((measurable_cfField κ).comp hC.2.1)) s ζ W))
              (imgVR xR s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
                ((measurable_cfField κ).comp hC.2.1)) s ζ W)) z)

/-- **G4 in Proposition 4.9's direction, from the martingale clause: the flow line given the counterflow prefix is a
killed integrated `SLE_κ(ρ′)` word in the counterflow chart** (conditional helper; Theorem 2.4's characterization in the
enlarged filtration, through Lemma 2.11 for a killed word). In the setting of `Prop411Q.CfGlueAE`, for each `s > 0`:
on `μ ⊗ P₀` there is a Brownian motion `B` of the product filtration with continuous paths such that, almost surely,
the integrated driving and force equations of the image word (initial marks `gXL`, `gXR`, weights `imgρL κ ρL`,
`imgρR ρR`) hold on `[0, imgT)` driven by `B`. -/
theorem exists_isWordEntrance_of_filt (hI : ImageWord49FiltStatement.{u}) {κ : ℝ} (hκ : 0 < κ) (hκ4 : κ < 4)
    {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
    (hF : IsOrderedForceWord xL xR) (h44 : Sec4.Cond44 κ ρL ρR)
    {Ω : Type u} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
    {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {h : Ω → DistOn upperHalfPlaneOpens}
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    {Ω₂ : Type u} {_mΩ₂ : MeasurableSpace Ω₂} {P₂ : Measure Ω₂} [IsProbabilityMeasure P₂]
    {h₂ : Ω₂ → DistOn upperHalfPlaneOpens} {W₂ : ℝ≥0 → Ω₂ → ℝ} {ζ₂ : Ω₂ → ℝ≥0∞}
    (hcf : IsCenteredCounterflowDriver κ P₂ h₂ W₂ ζ₂) (hlaw : P.map (fun ω => cfField κ (h ω)) = P₂.map h₂)
    (k : Kernel (DistOn upperHalfPlaneOpens) (HistorySpace 0 0)) [IsMarkovKernel k]
    (hk : P₂.map (fun ω => (h₂ ω, cfHistory W₂ ζ₂ ω)) = P₂.map h₂ ⊗ₘ k) {s : ℝ≥0} (hs : 0 < s) :
    ∃ (Ω₀ : Type) (m₀ : MeasurableSpace Ω₀) (P₀ : Measure Ω₀) (_ : IsProbabilityMeasure P₀)
      (𝓦 : Filtration ℝ≥0 m₀) (Bi : ℝ≥0 → (Ω × HistorySpace 0 0) × Ω₀ → ℝ),
      IsFilteredBrownianReal (WholeField.prodFiltration
        (imgFilt (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) xL xR s ζ W
          (glueGood (glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)) s ζ W)) 𝓦)
        Bi ((glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)).prod P₀) ∧
      (∀ p, Continuous fun t => Bi t p) ∧
      ∀ᵐ p ∂((glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1)).prod P₀),
        IsWordEntrance κ
          (fun i => imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) i 0 p.1)
          (fun j => imgVR xR s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) j 0 p.1)
          (imgρL κ ρL) (imgρR ρR)
          (fun t => imgW s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) t p.1)
          (fun i t => imgVL xL s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) i t p.1)
          (fun j t => imgVR xR s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) j t p.1)
          (fun t => Bi t p)
          (imgT s ζ W (glueGood (glueMeasure P k (fun ω => cfField κ (h ω))
            ((measurable_cfField κ).comp hC.2.1)) s ζ W) p.1 : ℝ≥0∞) := by
  set μ := glueMeasure P k (fun ω => cfField κ (h ω)) ((measurable_cfField κ).comp hC.2.1) with hμ
  have hW : AdaptedBefore 𝓕 ζ W := hC.1.2.1
  have hae : ∀ᵐ p ∂μ, IsGood49 s ζ W p := by
    filter_upwards [cfGlueAE_isGood49 s hs κ hκ hκ4 xL xR ρL ρR hF h44 P 𝓕 W VL VR B ζ h hC P₂ h₂ W₂ ζ₂ hcf
      hlaw k hk] with p hp
    exact isGood49_of_mem hp.1 hp.2
  obtain ⟨hnull, hK, hWa, hVLa, hVRa, hσ, hσm, hσT, hσlim, -⟩ := filtClauses (xL := xL) (xR := xR) hW hF hae
  exact hK.exists_isWordEntrance hκ hnull hWa hVLa hVRa hσ hσm hσT hσlim
    (hI κ hκ hκ4 xL xR ρL ρR hF h44 P 𝓕 W VL VR B ζ h hC P₂ h₂ W₂ ζ₂ hcf hlaw k hk s hs)

end Word49

end InteractingSLE.Sec5.CrossCond
