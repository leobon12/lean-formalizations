/-!
# Lemma 4.7 in the chart `Q`: the filtration of the counterflow's killed image word

Packet PROVE-CFRESTART4, item D1′ (the Lemma 4.7 mirror of GLUECOND5's `CrossCondWordFilt`). The filtration of the
image word is generated by the killed image word, the killing and announcing events, and at time `0` the **flow**
history stopped at the flow time `s` (which carries the chart `Ψ = revChart Wf s`), augmented under the glued measure.

* `qGen`, `qRaw`, `qFilt`;
* **`filtClauses47`**: the clauses of WangWu's `ImgDrv.IsKilledWord.exists_isWordEntrance` other than the martingale
  clause — null sets at time `0`, the killed word, adaptedness of driver and marks, announcing stopping times below the
  killing time, increasing and almost surely exhausting it, and `{r < qT} ∈ 𝓖_r`;
* **`exists_isWordEntrance_of_mart47`** (conditional helper, item D4): given the martingale clause of the image word
  (item D3, its explicit hypothesis `hmart`), on `μ ⊗ P₀` there is a Brownian motion of the product filtration driving,
  almost surely, the integrated `SLE_a(ρ)` equations of the image word on `[0, qT)`.

R48: nothing here uses Theorem 1.2/1.3, `Theorem12ParamStatement`, `Theorem13Statement` or any `*_of_param`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.CrossRestart.KernelQ

open WangWu hiding ratPt exists_ratPt_dist_lt
open LawUnique GlueCond Cond44Ref CfRegQ Prop411Q
open WangWu.ImgDrv MartChar Sec7.PhaseSelFull Sec7.Aux117

namespace Kill47

section Def

variable {Ω : Type*} [MeasurableSpace Ω] {nL nR mL mR : ℕ}

/-- The flow history stopped at the flow time `s` (it carries the chart `Ψ`). -/
def flowStop (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞)
    (s : ℝ≥0) (p : Ω × HistorySpace 0 0) : HistorySpace nL nR :=
  Sec4.stopHistory (Aux50Hit.cstop s) (killedHistory W VL VR ζ p.1)

/-- The generating events of the raw filtration of the image word at time `r`. -/
def qGen (xL : Fin mL → ℝ) (xR : Fin mR → ℝ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (s : ℝ≥0) (E : Set (Ω × HistorySpace 0 0)) (r : ℝ≥0) :
    Set (Set (Ω × HistorySpace 0 0)) :=
  {A | ∃ r' : ℝ≥0, r' ≤ r ∧ ((∃ B : Set ℝ, MeasurableSet B ∧ (A = qW W VL VR ζ s E r' ⁻¹' B ∨
    (∃ i, A = qVL xL W VL VR ζ s E i r' ⁻¹' B) ∨ ∃ j, A = qVR xR W VL VR ζ s E j r' ⁻¹' B)) ∨
    A = {p | (r' : WithTop ℝ≥0) < qT W VL VR ζ s E p} ∨ (∃ n, A = {p | qAnn W VL VR ζ s E n p ≤ r'}) ∨
    ∃ B : Set (HistorySpace nL nR), MeasurableSet B ∧ A = flowStop W VL VR ζ s ⁻¹' B)}

/-- **The raw filtration of the image word** (intersected with the ambient σ-algebra). -/
def qRaw (xL : Fin mL → ℝ) (xR : Fin mR → ℝ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (s : ℝ≥0) (E : Set (Ω × HistorySpace 0 0)) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Ω × HistorySpace 0 0)) where
  seq r := MeasurableSpace.generateFrom (qGen xL xR W VL VR ζ s E r) ⊓ inferInstance
  mono' r r' hrr' := by
    refine inf_le_inf_right _ (MeasurableSpace.generateFrom_mono ?_)
    rintro A ⟨r'', hr'', h⟩
    exact ⟨r'', hr''.trans hrr', h⟩
  le' _ := inf_le_right

/-- **The filtration of the image word**: the usual augmentation of `qRaw` under `μ`. -/
def qFilt (μ : Measure (Ω × HistorySpace 0 0)) (xL : Fin mL → ℝ) (xR : Fin mR → ℝ) (W : ℝ≥0 → Ω → ℝ)
    (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) (s : ℝ≥0)
    (E : Set (Ω × HistorySpace 0 0)) : Filtration ℝ≥0 (inferInstance : MeasurableSpace (Ω × HistorySpace 0 0)) :=
  usualAugmentation (qRaw xL xR W VL VR ζ s E) μ

end Def

section Filt

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {nL nR mL mR : ℕ} {W : ℝ≥0 → Ω → ℝ}
  {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {s : ℝ≥0}
  {E : Set (Ω × HistorySpace 0 0)} {μ : Measure (Ω × HistorySpace 0 0)} {xL : Fin mL → ℝ} {xR : Fin mR → ℝ}

theorem measurableSet_qRaw_of_gen {r : ℝ≥0} {A : Set (Ω × HistorySpace 0 0)}
    (hA : A ∈ qGen xL xR W VL VR ζ s E r) (hAm : MeasurableSet A) :
    MeasurableSet[qRaw xL xR W VL VR ζ s E r] A :=
  ⟨MeasurableSpace.measurableSet_generateFrom hA, hAm⟩

theorem measurableSet_qFilt_of_gen {r : ℝ≥0} {A : Set (Ω × HistorySpace 0 0)}
    (hA : A ∈ qGen xL xR W VL VR ζ s E r) (hAm : MeasurableSet A) :
    MeasurableSet[qFilt μ xL xR W VL VR ζ s E r] A :=
  Ito.le_usualAugmentation (qRaw xL xR W VL VR ζ s E) μ r _ (measurableSet_qRaw_of_gen hA hAm)

/-- A process whose preimages at time `r` are generators is adapted to the filtration of the image word. -/
theorem stronglyAdapted_qFilt_of {X : ℝ≥0 → Ω × HistorySpace 0 0 → ℝ} (hX : ∀ r, Measurable (X r))
    (hgen : ∀ r (B : Set ℝ), MeasurableSet B → X r ⁻¹' B ∈ qGen xL xR W VL VR ζ s E r) :
    StronglyAdapted (qFilt μ xL xR W VL VR ζ s E) X := fun r => by
  have hm : Measurable[qFilt μ xL xR W VL VR ζ s E r] (X r) := fun B hB =>
    measurableSet_qFilt_of_gen (hgen r B hB) (hX r hB)
  exact hm.stronglyMeasurable

/-- The flow history stopped at `s` (which carries the chart `Ψ`) is known at time `0`. -/
theorem measurable_flowStop_qFilt (hX : IsMeasurableKilledDriving W VL VR ζ) (r : ℝ≥0) :
    Measurable[qFilt μ xL xR W VL VR ζ s E r] (flowStop W VL VR ζ s) := fun B hB =>
  measurableSet_qFilt_of_gen ⟨0, zero_le, Or.inr (Or.inr (Or.inr ⟨B, hB, rfl⟩))⟩
    ((measurable_stopFlow hX s) hB)

/-- **The filtration clauses of the counterflow's image word**: the filtration contains the null sets at time `0`,
the word is a killed word and adapted, the announcing times are stopping times below the killing time, increasing and
(almost surely) exhausting it, and `{r < qT} ∈ 𝓖_r`. -/
theorem filtClauses47 (hX : IsMeasurableKilledDriving W VL VR ζ) (hxL : ∀ i, xL i ≤ 0) (hxLa : Antitone xL)
    (hxR : ∀ j, 0 ≤ xR j) (hxRm : Monotone xR) (hs : 0 < s) (hae : ∀ᵐ p ∂μ, IsGood47 W VL VR ζ p) :
    (∀ A, MeasurableSet A → μ A = 0 →
      MeasurableSet[qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ) 0] A) ∧
    IsKilledWord (qW W VL VR ζ s (glueGood47 μ W VL VR ζ)) (qVL xL W VL VR ζ s (glueGood47 μ W VL VR ζ))
      (qVR xR W VL VR ζ s (glueGood47 μ W VL VR ζ)) (qT W VL VR ζ s (glueGood47 μ W VL VR ζ)) ∧
    StronglyAdapted (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ)) (qW W VL VR ζ s (glueGood47 μ W VL VR ζ)) ∧
    (∀ i, StronglyAdapted (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ))
      (qVL xL W VL VR ζ s (glueGood47 μ W VL VR ζ) i)) ∧
    (∀ j, StronglyAdapted (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ))
      (qVR xR W VL VR ζ s (glueGood47 μ W VL VR ζ) j)) ∧
    (∀ n, IsStoppingTime (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ))
      fun p => (qAnn W VL VR ζ s (glueGood47 μ W VL VR ζ) n p : WithTop ℝ≥0)) ∧
    (∀ p, Monotone (qAnn W VL VR ζ s (glueGood47 μ W VL VR ζ) · p)) ∧
    (∀ n p, (qAnn W VL VR ζ s (glueGood47 μ W VL VR ζ) n p : WithTop ℝ≥0) <
      qT W VL VR ζ s (glueGood47 μ W VL VR ζ) p) ∧
    (∀ᵐ p ∂μ, ∀ u : ℝ≥0, (u : WithTop ℝ≥0) < qT W VL VR ζ s (glueGood47 μ W VL VR ζ) p →
      ∃ n, u ≤ qAnn W VL VR ζ s (glueGood47 μ W VL VR ζ) n p) ∧
    ∀ r : ℝ≥0, MeasurableSet[qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ) r]
      {p | (r : WithTop ℝ≥0) < qT W VL VR ζ s (glueGood47 μ W VL VR ζ) p} := by
  set E := glueGood47 μ W VL VR ζ with hEdef
  have hE : MeasurableSet E := measurableSet_glueGood47
  have hEg : ∀ p ∈ E, IsGood47 W VL VR ζ p := isGood47_of_mem_glueGood47
  refine ⟨fun A hA h0 => Ito.measurableSet_usualAugmentation_of_null hA h0 0,
    isKilledWord_q hxL hxLa hxR hxRm hEg hs, ?_, fun i => ?_, fun j => ?_, fun n => ?_, monotone_qAnn hEg,
    fun n p => qAnn_lt_qT hEg n p, ?_, fun r => ?_⟩
  · exact stronglyAdapted_qFilt_of (measurable_qW hX hE hEg) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inl rfl⟩⟩
  · exact stronglyAdapted_qFilt_of (measurable_qVL xL hX hE hEg i) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inr (Or.inl ⟨i, rfl⟩)⟩⟩
  · exact stronglyAdapted_qFilt_of (measurable_qVR xR hX hE hEg j) fun r B hB =>
      ⟨r, le_rfl, Or.inl ⟨B, hB, Or.inr (Or.inr ⟨j, rfl⟩)⟩⟩
  · intro r
    have e : {p : Ω × HistorySpace 0 0 | ((qAnn W VL VR ζ s E n p : ℝ≥0) : WithTop ℝ≥0) ≤ r} =
        {p | qAnn W VL VR ζ s E n p ≤ r} := by
      ext p
      simp only [mem_ofPred_eq, WithTop.coe_le_coe]
    rw [e]
    exact measurableSet_qFilt_of_gen ⟨r, le_rfl, Or.inr (Or.inr (Or.inl ⟨n, rfl⟩))⟩
      (measurableSet_le (measurable_qAnn hX hE hEg n) measurable_const)
  · filter_upwards [ae_mem_glueGood47 hae] with p hp
    exact fun u hu => exists_le_qAnn hEg hp hu
  · exact measurableSet_qFilt_of_gen ⟨r, le_rfl, Or.inr (Or.inl rfl)⟩
      (measurableSet_lt_qT hX hE hEg r)

/-- **The word entrance of the counterflow's image word, given its martingale clause** (conditional helper, item D4 of
PROVE-CFRESTART3's route; the hypothesis `hmart` is item D3, the Lemma 4.7 mirror of GLUECOND7's
`ImageWord49FiltCStatement`). On `μ ⊗ P₀` there is a Brownian motion of the product filtration driving, almost surely,
the integrated `SLE_a(ρ_L; ρ_R)` equations of the killed image word on `[0, qT)` (WangWu's
`ImgDrv.IsKilledWord.exists_isWordEntrance`, Lemma 2.11 for a killed word). -/
theorem exists_isWordEntrance_of_mart47 (hX : IsMeasurableKilledDriving W VL VR ζ) (hxL : ∀ i, xL i ≤ 0)
    (hxLa : Antitone xL) (hxR : ∀ j, 0 ≤ xR j) (hxRm : Monotone xR) (hs : 0 < s) [IsProbabilityMeasure μ]
    (hae : ∀ᵐ p ∂μ, IsGood47 W VL VR ζ p) {a : ℝ} (ha : 0 < a) {ρL : Fin (mL + 1) → ℝ}
    {ρR : Fin (mR + 1) → ℝ}
    (hmart : ∀ z ∈ QuantumZipper.H, IsLocalMartingaleBefore (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ)) μ
      (fun p => min (QuantumZipper.swallowTime (wpath (qW W VL VR ζ s (glueGood47 μ W VL VR ζ)) p) z : WithTop ℝ≥0)
        (qT W VL VR ζ s (glueGood47 μ W VL VR ζ) p))
      (coupProc a ρL ρR (qW W VL VR ζ s (glueGood47 μ W VL VR ζ)) (qVL xL W VL VR ζ s (glueGood47 μ W VL VR ζ))
        (qVR xR W VL VR ζ s (glueGood47 μ W VL VR ζ)) z)) :
    ∃ (Ω₀ : Type) (m₀ : MeasurableSpace Ω₀) (P₀ : Measure Ω₀) (_ : IsProbabilityMeasure P₀)
      (𝓦 : Filtration ℝ≥0 m₀) (Bi : ℝ≥0 → (Ω × HistorySpace 0 0) × Ω₀ → ℝ),
      IsFilteredBrownianReal (WholeField.prodFiltration (qFilt μ xL xR W VL VR ζ s (glueGood47 μ W VL VR ζ)) 𝓦)
        Bi (μ.prod P₀) ∧
      (∀ p, Continuous fun t => Bi t p) ∧
      ∀ᵐ p ∂(μ.prod P₀), IsWordEntrance a
        (fun i => qVL xL W VL VR ζ s (glueGood47 μ W VL VR ζ) i 0 p.1)
        (fun j => qVR xR W VL VR ζ s (glueGood47 μ W VL VR ζ) j 0 p.1) ρL ρR
        (fun t => qW W VL VR ζ s (glueGood47 μ W VL VR ζ) t p.1)
        (fun i t => qVL xL W VL VR ζ s (glueGood47 μ W VL VR ζ) i t p.1)
        (fun j t => qVR xR W VL VR ζ s (glueGood47 μ W VL VR ζ) j t p.1) (fun t => Bi t p)
        (qT W VL VR ζ s (glueGood47 μ W VL VR ζ) p.1 : ℝ≥0∞) := by
  obtain ⟨hnull, hK, hWa, hVLa, hVRa, hσ, hσm, hσT, hσlim, -⟩ := filtClauses47 hX hxL hxLa hxR hxRm hs hae
  exact hK.exists_isWordEntrance ha hnull hWa hVLa hVRa hσ hσm hσT hσlim hmart

end Filt

end Kill47

end InteractingSLE.Sec5.CrossRestart.KernelQ
