theorem isChartCouplingCharFunConst_q_E (hκ : 0 < κ) (hκ4 : κ < 4) (hF : IsOrderedForceWord xL xR)
    (h44 : Sec4.Cond44 κ ρL ρR) (hθb : CfThetaBounds κ θ ρL ρR xL xR)
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h)
    (hcf : IsCenteredCounterflowDriver κ P₂ h₂ W₂ ζ₂) (hlaw : P.map (fun ω => cfFieldT κ θ (h ω)) = P₂.map h₂)
    (k : Kernel (DistOn upperHalfPlaneOpens) (HistorySpace 0 0)) [IsMarkovKernel k]
    (hk : P₂.map (fun ω => (h₂ ω, cfHistory W₂ ζ₂ ω)) = P₂.map h₂ ⊗ₘ k)
    (E : Set (Ω × HistorySpace 0 0)) (hE : MeasurableSet E) (hEg : ∀ p ∈ E, IsGood47 W VL VR ζ p)
    (hEae : ∀ᵐ p ∂(glueMeasure P k (fun ω => cfFieldT κ θ (h ω)) ((measurable_cfFieldT κ θ).comp hC.2.1)), p ∈ E)
    {s : ℝ≥0} (hs : 0 < s)
    (hM1 : ∀ (r : ℝ≥0) (t' t : ℚ), (0 : ℝ) ≤ t' → t' ≤ t → 0 < t → ∀ A : Set (Ω × HistorySpace 0 0),
