  have hkw := isKilledWord_q_of_ordered (isOrderedForceWord_qx_angle κ θ ρL ρR xL xR) hEg hs
  intro r u hu φ
  filter_upwards [ae_condExp_qRaw_eq_qF_E hκ hκ4 hF h44 hθb hC hcf hlaw k hk E hE hEg hEae hs hM1 hM3 r φ]
