          qAv W VL VR ζ s (E) φ (t : ℝ).toNNReal) :
    Sec7.Lemma71D.IsChartCouplingCharFunConst (16 / κ) (iwLT κ θ ρL ρR xL xR) (iwRT κ θ ρL ρR xL xR)
      (glueMeasure P k (fun ω => cfFieldT κ θ (h ω)) ((measurable_cfFieldT κ θ).comp hC.2.1))
      (qRaw (qxLT κ θ ρL ρR xL xR) (qxRT κ θ ρL ρR xL xR) W VL VR ζ s (E))
      (qW W VL VR ζ s (E))
      (qVL (qxLT κ θ ρL ρR xL xR) W VL VR ζ s (E))
      (qVR (qxRT κ θ ρL ρR xL xR) W VL VR ζ s (E))
      (fun p => (qT W VL VR ζ s (E) p : ℝ≥0∞))
