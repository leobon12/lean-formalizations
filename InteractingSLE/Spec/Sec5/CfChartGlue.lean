      ∃ B', MeasurableSet[cfGlueMarks W VL VR ζ s (t : ℝ).toNNReal] B' ∧
        B' =ᵐ[glueMeasure P k (fun ω => cfFieldT κ θ (h ω)) ((measurable_cfFieldT κ θ).comp hC.2.1)]
