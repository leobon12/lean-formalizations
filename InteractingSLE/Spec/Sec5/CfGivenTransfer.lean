/-!
# Moving the fixed-time chart coupling clause between filtrations and spaces

Packet PROVE-CFGIVEN. The remaining input `CfGivenChartStatement` asks for the fixed-time chart coupling clause
(`Sec7.Lemma71D.IsChartCouplingCharFunConst`) of the image counterflow on the given space `Ω`, for a filtration
generated by the image data. The cross-conditioning chain proves it on the glued space, for its own raw filtration.
This file provides the two generic moves between them:

* **canonical extensions** (`isChartCouplingCharFunConst_iff_canon`): the clause quantifies over all bounded harmonic
  extensions `u`; by uniqueness on `ℍ` (the frozen companion
  `existsUnique_isBoundedHarmonicExtension_forceBoundaryData`) and because the chart mean only reads `u` at points of
  `ℍ`, it is equivalent to its instance at the canonical extensions `bheProc` (`IsChartCanon`);
* **smaller filtrations** (`IsChartCanon.of_le`, tower property): the clause passes to a filtration `𝓑 ≤ 𝓐` for which
  the events and the (indicator of the) right-hand side are measurable;
* **equal laws** (`IsChartCanon.of_map_eq`): if the data are functions `X ∘ g₁`, `X ∘ g₂` of a datum on a space `Z`
  with `P₁.map g₁ = P₂.map g₂`, the clause for the pulled-back filtration passes from `(Ω₁, P₁)` to `(Ω₂, P₂)`
  (`WangWu.condExp_comap_comp`), given the measurability of the event and of the right-hand side on `Z`.

R48: nothing here uses Theorem 1.2/1.3, `Theorem12ParamStatement`, `Theorem13Statement` or any `*_of_param`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open QuantumZipper (H fwdHull zeroGFFTestCov)
open LQGMetric (TestOn DistOn)
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.CfGiven

open Restart Restart.DomainMarkov

/-! ### The event and the right-hand side -/

section Defs

variable {Ω : Type*} {nL nR : ℕ}

/-- The event of the chart clause at a fixed time: `t < ζ` and `supp φ ⊆ inv(ℍ ∖ K_t)`. -/
def chartEv (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ) (c : Ω → Chart) (t : ℝ≥0) (φ : TestOn upperHalfPlaneOpens) :
    Set Ω :=
  {ω | (t : ℝ≥0∞) < ζ ω ∧ tsupport φ ⊆ (c ω).2.1 '' (H \ fwdHull (fun s : ℝ => W s.toNNReal ω) (t : ℝ))}

/-- The right-hand side of the chart clause at a fixed time, for the extensions `u`. -/
def chartRhs (κ : ℝ) (W : ℝ≥0 → Ω → ℝ) (c : Ω → Chart) (a k : ℝ) (u : Ω → ℂ → ℝ) (t : ℝ≥0)
    (φ : TestOn upperHalfPlaneOpens) (ω : Ω) : ℂ :=
  Complex.exp (Complex.I * ((∫ z, (couplingMean κ (fun s : ℝ => W s.toNNReal ω) (t : ℝ) (u ω)
      ((c ω).1 z) - a - k * (c ω).2.2 z) * φ z : ℝ) : ℂ) -
    (((1 / 2 : ℝ) * zeroGFFTestCov ((c ω).2.1 '' (H \ fwdHull (fun s : ℝ => W s.toNNReal ω) (t : ℝ))) φ φ :
      ℝ) : ℂ))

/-- The canonical extensions at time `t`. -/
def canonU (κ : ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (t : ℝ≥0) : Ω → ℂ → ℝ := fun ω => bheProc κ ρL ρR W VL VR ω t

/-- **The chart clause at the canonical extensions** (fixed times). -/
def IsChartCanon (κ : ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (𝓐 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ)
    (ζ : Ω → ℝ≥0∞) (c : Ω → Chart) (a k : ℝ) (h : Ω → DistOn upperHalfPlaneOpens) : Prop :=
  ∀ (t : ℝ≥0) (φ : TestOn upperHalfPlaneOpens), ∀ᵐ ω ∂P, ω ∈ chartEv ζ W c t φ →
    condExp (𝓐 t) P (fun ω' => Complex.exp (Complex.I * (h ω' φ : ℂ))) ω =
      chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ ω

end Defs

/-! ### Canonical extensions -/

section Canon

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} {nL nR : ℕ} {κ : ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {𝓐 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {c : Ω → Chart} {a k : ℝ} {h : Ω → DistOn upperHalfPlaneOpens}

omit mΩ in
/-- **The chart mean only reads the extension on `ℍ`**: two bounded harmonic extensions of the same data give the
same right-hand side on the event. -/
theorem chartRhs_congr (hc : ∀ ω, (c ω).IsConformal) (hWc : ∀ ω, Continuous fun s : ℝ => W s.toNNReal ω)
    {u v : Ω → ℂ → ℝ} {t : ℝ≥0} {φ : TestOn upperHalfPlaneOpens} {ω : Ω} (huv : EqOn (u ω) (v ω) H)
    (hω : ω ∈ chartEv ζ W c t φ) : chartRhs κ W c a k u t φ ω = chartRhs κ W c a k v t φ ω := by
  unfold chartRhs
  congr 4
  refine integral_congr_ae (ae_of_all _ fun z => ?_)
  by_cases hz : z ∈ tsupport φ
  · obtain ⟨w, ⟨hwH, hwK⟩, hwz⟩ := hω.2 hz
    have hcz : (c ω).1 z = w := by rw [← hwz]; exact (hc ω).2.2 w hwH
    have hfH : QuantumZipper.fwdMap (fun s : ℝ => W s.toNNReal ω) (t : ℝ) w ∈ H :=
      QuantumZipper.FwdHolo.mapsTo_fwdMap (hWc ω) t.coe_nonneg ⟨hwH, hwK⟩
    simp only [couplingMean, hcz, huv hfH]
  · simp only [image_eq_zero_of_notMem_tsupport hz, mul_zero]

/-- **The chart clause is its instance at the canonical extensions** (conformal charts, continuous driving paths). -/
theorem isChartCouplingCharFunConst_iff_canon (hc : ∀ ω, (c ω).IsConformal)
    (hWc : ∀ ω, Continuous fun s : ℝ => W s.toNNReal ω) :
    Sec7.Lemma71D.IsChartCouplingCharFunConst κ ρL ρR P 𝓐 W VL VR ζ c a k h ↔
      IsChartCanon κ ρL ρR P 𝓐 W VL VR ζ c a k h := by
  constructor
  · intro hcf t φ
    filter_upwards [hcf t (canonU κ ρL ρR W VL VR t) (fun ω => isBoundedHarmonicExtension_bheProc ω t) φ]
      with ω hω hωE
    exact hω hωE.1 hωE.2
  · intro hcan t u hu φ
    filter_upwards [hcan t φ] with ω hω hlt hsupp
    have hE : ω ∈ chartEv ζ W c t φ := ⟨hlt, hsupp⟩
    rw [hω hE]
    obtain ⟨u₀, -, huniq⟩ := Spec.Provider.existsUnique_isBoundedHarmonicExtension_forceBoundaryData (κ := κ)
      (ρL := ρL) (ρR := ρR) (vL := fun i => VL i t ω - W t ω) (vR := fun i => VR i t ω - W t ω)
    have heq : EqOn (canonU κ ρL ρR W VL VR t ω) (u ω) H := fun z hz =>
      (huniq _ (isBoundedHarmonicExtension_bheProc ω t) hz).trans (huniq _ (hu ω) hz).symm
    exact chartRhs_congr hc hWc heq hE

end Canon

/-! ### Smaller filtrations -/

section Tower

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {nL nR : ℕ} {κ : ℝ}
  {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} {c : Ω → Chart} {a k : ℝ} {h : Ω → DistOn upperHalfPlaneOpens}

theorem integrable_cexp_apply (hh : Measurable h) (φ : TestOn upperHalfPlaneOpens) :
    Integrable (fun ω => Complex.exp (Complex.I * (h ω φ : ℂ))) P :=
  GFF.integrable_exp_I_mul ((LQGMetric.measurable_distOn_apply φ).comp hh)

/-- **The chart clause passes to a smaller filtration** for which the events and the right-hand sides (on the events)
are measurable (tower property). -/
theorem IsChartCanon.of_le {𝓐 𝓑 : Filtration ℝ≥0 mΩ} (hcan : IsChartCanon κ ρL ρR P 𝓐 W VL VR ζ c a k h)
    (hh : Measurable h) (h𝓑 : ∀ t, 𝓑 t ≤ 𝓐 t)
    (hEm : ∀ t φ, MeasurableSet[𝓑 t] (chartEv ζ W c t φ))
    (hRm : ∀ t φ, StronglyMeasurable[𝓑 t]
      ((chartEv ζ W c t φ).indicator (chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ))) :
    IsChartCanon κ ρL ρR P 𝓑 W VL VR ζ c a k h := by
  intro t φ
  set E := chartEv ζ W c t φ
  set F : Ω → ℂ := fun ω' => Complex.exp (Complex.I * (h ω' φ : ℂ))
  set G := chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ
  have hF : Integrable F P := integrable_cexp_apply hh φ
  have h𝓐 : 𝓐 t ≤ mΩ := 𝓐.le t
  -- the indicator of the clause
  have h1 : E.indicator (condExp (𝓐 t) P F) =ᵐ[P] E.indicator G := by
    filter_upwards [hcan t φ] with ω hω
    by_cases hωE : ω ∈ E
    · rw [indicator_of_mem hωE, indicator_of_mem hωE, hω hωE]
    · rw [indicator_of_notMem hωE, indicator_of_notMem hωE]
  have hGint : Integrable (E.indicator G) P :=
    (integrable_condExp.indicator ((𝓑.le t) _ (hEm t φ))).congr h1
  have h2 : condExp (𝓑 t) P (E.indicator (condExp (𝓐 t) P F)) =ᵐ[P] E.indicator G :=
    (condExp_congr_ae h1).trans (condExp_of_stronglyMeasurable (𝓑.le t) (hRm t φ) hGint).eventuallyEq
  have h3 : condExp (𝓑 t) P (E.indicator (condExp (𝓐 t) P F)) =ᵐ[P]
      E.indicator (condExp (𝓑 t) P (condExp (𝓐 t) P F)) :=
    condExp_indicator integrable_condExp (hEm t φ)
  have h4 : condExp (𝓑 t) P (condExp (𝓐 t) P F) =ᵐ[P] condExp (𝓑 t) P F :=
    condExp_condExp_of_le (h𝓑 t) h𝓐
  filter_upwards [h2, h3, h4] with ω e2 e3 e4 hωE
  have := e3.symm.trans e2
  rw [indicator_of_mem hωE, indicator_of_mem hωE, e4] at this
  exact this

omit [IsProbabilityMeasure P] in
/-- **The stopping-time chart clause gives the fixed-time one** (constant stopping times), when the lifetime is
almost surely infinite. -/
theorem IsChartCanon.of_chartCouplingCharFun {𝓖 : Filtration ℝ≥0 mΩ}
    (hcf : Coupling.MartMeans2.IsChartCouplingCharFun κ ρL ρR P 𝓖 W VL VR ζ c a k h) (hζ : ∀ᵐ ω ∂P, ζ ω = ⊤) :
    IsChartCanon κ ρL ρR P 𝓖 W VL VR ζ c a k h := by
  intro t φ
  have hτ := isStoppingTime_const 𝓖 t
  have h1 := hcf (fun _ => (t : WithTop ℝ≥0)) hτ
    (hζ.mono fun ω hω => by rw [hω]; exact ENNReal.coe_lt_top) (canonU κ ρL ρR W VL VR t)
    (fun ω => isBoundedHarmonicExtension_bheProc ω t) φ
  rw [IsStoppingTime.measurableSpace_const] at h1
  filter_upwards [h1] with ω hω hE
  exact hω hE.2

end Tower

/-! ### Equal laws -/

section Law

variable {Z : Type*} [mZ : MeasurableSpace Z] {nL nR : ℕ} {κ : ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ}
  {𝓩 : Filtration ℝ≥0 mZ} {W : ℝ≥0 → Z → ℝ} {VL : Fin nL → ℝ≥0 → Z → ℝ} {VR : Fin nR → ℝ≥0 → Z → ℝ}
  {ζ : Z → ℝ≥0∞} {c : Z → Chart} {a k : ℝ} {h : Z → DistOn upperHalfPlaneOpens}

/-- **The chart clause moves along equal laws.** Let the data on `Ω₁`, `Ω₂` be read from a datum on `Z` through
measurable maps `g₁`, `g₂` with `P₁.map g₁ = P₂.map g₂`, and let the filtrations be pulled back from a filtration `𝓩`
of `Z`. If the events and the right-hand sides (on the events) are measurable on `Z`, the chart clause at the canonical
extensions passes from `(Ω₁, P₁)` to `(Ω₂, P₂)`. -/
theorem IsChartCanon.of_map_eq {Ω₁ : Type*} [m₁ : MeasurableSpace Ω₁] {P₁ : Measure Ω₁} [IsProbabilityMeasure P₁]
    {g₁ : Ω₁ → Z} (hg₁ : Measurable g₁) {Ω₂ : Type*} [m₂ : MeasurableSpace Ω₂] {P₂ : Measure Ω₂}
    [IsProbabilityMeasure P₂] {g₂ : Ω₂ → Z} (hg₂ : Measurable g₂) (hlaw : P₁.map g₁ = P₂.map g₂)
    (hh : Measurable h) (hEm : ∀ t φ, MeasurableSet (chartEv ζ W c t φ))
    (hRm : ∀ t φ, Measurable ((chartEv ζ W c t φ).indicator (chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ)))
    (h₁ : IsChartCanon κ ρL ρR P₁ (Coupling.filtrationComap 𝓩 hg₁) (fun t ω => W t (g₁ ω))
      (fun i t ω => VL i t (g₁ ω)) (fun j t ω => VR j t (g₁ ω)) (fun ω => ζ (g₁ ω)) (fun ω => c (g₁ ω)) a k
      (fun ω => h (g₁ ω))) :
    IsChartCanon κ ρL ρR P₂ (Coupling.filtrationComap 𝓩 hg₂) (fun t ω => W t (g₂ ω))
      (fun i t ω => VL i t (g₂ ω)) (fun j t ω => VR j t (g₂ ω)) (fun ω => ζ (g₂ ω)) (fun ω => c (g₂ ω)) a k
      (fun ω => h (g₂ ω)) := by
  intro t φ
  have : IsProbabilityMeasure (P₁.map g₁) := (Measure.isProbabilityMeasure_map_iff hg₁.aemeasurable).2 ‹_›
  have hF : Integrable (fun z => Complex.exp (Complex.I * (h z φ : ℂ))) (P₁.map g₁) := integrable_cexp_apply hh φ
  have hCm : Measurable (condExp (𝓩 t) (P₁.map g₁) fun z => Complex.exp (Complex.I * (h z φ : ℂ))) :=
    (stronglyMeasurable_condExp.mono (𝓩.le t)).measurable
  -- the predicate on `Z`
  have hQ : MeasurableSet {z | z ∈ chartEv ζ W c t φ →
      condExp (𝓩 t) (P₁.map g₁) (fun z => Complex.exp (Complex.I * (h z φ : ℂ))) z =
        chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ z} := by
    have e : {z | z ∈ chartEv ζ W c t φ →
        condExp (𝓩 t) (P₁.map g₁) (fun z => Complex.exp (Complex.I * (h z φ : ℂ))) z =
          chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ z} =
        (chartEv ζ W c t φ)ᶜ ∪ {z | (chartEv ζ W c t φ).indicator
          (condExp (𝓩 t) (P₁.map g₁) fun z => Complex.exp (Complex.I * (h z φ : ℂ))) z =
          (chartEv ζ W c t φ).indicator (chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ) z} := by
      ext z
      simp only [mem_ofPred_eq, mem_union, mem_compl_iff]
      by_cases hz : z ∈ chartEv ζ W c t φ
      · simp only [hz, indicator_of_mem, true_implies, not_true_eq_false, false_or]
      · simp only [hz, not_false_eq_true, true_or, false_implies]
    rw [e]
    exact (hEm t φ).compl.union (measurableSet_eq_fun (hCm.indicator (hEm t φ)) (hRm t φ))
  -- on `Ω₁` the predicate holds along `g₁`
  have hc₁ := WangWu.condExp_comap_comp (P := P₁) (μ := P₁.map g₁) hg₁ rfl (𝓩.le t) hF
  have hQ₁ : ∀ᵐ ω ∂P₁, g₁ ω ∈ {z | z ∈ chartEv ζ W c t φ →
      condExp (𝓩 t) (P₁.map g₁) (fun z => Complex.exp (Complex.I * (h z φ : ℂ))) z =
        chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ z} := by
    filter_upwards [h₁ t φ, hc₁] with ω hω hcω hE
    exact hcω.symm.trans (hω hE)
  have hQν := (ae_map_iff hg₁.aemeasurable hQ).2 hQ₁
  have hQν' : ∀ᵐ z ∂(P₂.map g₂), z ∈ {z | z ∈ chartEv ζ W c t φ →
      condExp (𝓩 t) (P₁.map g₁) (fun z => Complex.exp (Complex.I * (h z φ : ℂ))) z =
        chartRhs κ W c a k (canonU κ ρL ρR W VL VR t) t φ z} := by
    rw [← hlaw]; exact hQν
  have hQ₂ := (ae_map_iff hg₂.aemeasurable hQ).1 hQν'
  have hc₂ := WangWu.condExp_comap_comp (P := P₂) (μ := P₁.map g₁) hg₂ hlaw.symm (𝓩.le t) hF
  filter_upwards [hQ₂, hc₂] with ω hω hcω hE
  exact hcω.trans (hω hE)

end Law

end InteractingSLE.Sec5.CfGiven
