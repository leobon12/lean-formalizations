import InteractingSLE.Spec.Sec5.Aux61WinFibre

/-!
# The restart fibre and its tilted reference kernel at a stop

Packet PROVE-AUX61-WIN. Astra's follow-up 4 §§1.1–1.3 (L68–L262, ruling R71); specification Aux. lemmas 61–62.

* **`RestartFibre`** — R2's per-fibre output: a probability space carrying the field `h` read in the restart chart
  (current tip at `0`) and the restarted driver `W`, with a clock `e` (first new contact, exit from a buffer), such
  that at every stop `τ < e` of the fibre's filtration the field's conditional characteristic functional is Gaussian
  with the Green energy of `ℍ ∖ K_τ` and the explicit (PC1) mean `meanF κ u₀ q Fq` of Aux. lemma 61: `u₀` the basic
  mean `−λ | λ`, `q` the (fixed, otherwise arbitrary) harmonic difference of the old mean, `Fq` a cutoff of `q` on a
  neighbourhood of the buffer. The hull stays in the buffer before `e`, and is generated by a trace.
* `RestartFibre.Comparison` — the comparison data of Aux. lemma 62: a finite-word reference `b̂` agreeing with the
  basic word on the real window `O ∋ 0`, the bounded harmonic extension `q̂` of `b̂ − (−λ | λ)`, a cutoff `F` of
  `v = q̂ − q` on an open `N` containing the buffer (with real points in `O`), approximations `s_n → F.src`, the field
  pairing limit `Λ` with `e^{−Λ}` integrable, and `k > 0`; `tilt = k e^{−Λ} · P`, `chartField = h + (v − F.f)`.
* **`RestartFibre.Comparison.ae_condExp_tilt`** (R3 at a stop): under the tilt, at every stop `τ < e`, the shifted
  field has the reference word's kernel at the geometric images of `W`.

Conditional helpers with distinct names; they replace no source theorem. R48: nothing here uses Theorem 1.2/1.3,
`Theorem12ParamStatement`, `Theorem13Statement` or any `*_of_param` result.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology Metric
open scoped NNReal ENNReal ComplexConjugate

namespace InteractingSLE.Sec5.Aux61Win

open QuantumZipper (H Hbar fwdMap fwdHull greenH)
open LQGMetric (TestOn DistOn)
open LocalExt (IsGreenTest greenCross cfVal)
open Restart.FlowStopIdentCMI (CMCut geomL geomR)
open SupercriticalConformalCovariance.GM24 (smoothDist)

universe u

/-- **A restart fibre** (the per-fibre output of piece R2): see the module docstring. -/
structure RestartFibre (S : Type u) [m : MeasurableSpace S] where
  κ : ℝ
  κ_pos : 0 < κ
  P : Measure S
  prob : IsProbabilityMeasure P
  field : S → DistOn upperHalfPlaneOpens
  measurable_field : Measurable field
  u₀ : ℂ → ℝ
  u₀_ext : IsBoundedHarmonicExtension (basicData κ) {0} u₀
  q : ℂ → ℝ
  q_cont : ContinuousOn q H
  O₀ : Set ℝ
  Fq : CMCut
  Nq : Set ℂ
  cut : IsCutoffOn Fq q Nq O₀
  buffer : Set ℂ
  buffer_open : IsOpen buffer
  zero_mem : (0 : ℂ) ∈ buffer
  buffer_sub : buffer ⊆ Nq
  W : ℝ≥0 → S → ℝ
  zero : ∀ ω, W 0 ω = 0
  continuous : ∀ ω, Continuous (W · ω)
  filt : Filtration ℝ≥0 m
  e : S → ℝ≥0∞
  hull_buffer : ∀ᵐ ω ∂P, ∀ t : ℝ≥0, (t : ℝ≥0∞) < e ω → closure (fwdHull (Ito.rpath (W · ω)) t) ⊆ buffer
  trace : ∀ᵐ ω ∂P, ∀ t : ℝ≥0, (t : ℝ≥0∞) < e ω → 0 < t → ∃ η : ℝ → ℂ, ContinuousOn η (Icc 0 (t : ℝ)) ∧
    ∀ r ∈ Ioc (0 : ℝ) t, fwdHull (Ito.rpath (W · ω)) r = fillH (η '' Icc 0 r)
  kernel : ∀ (τ : S → WithTop ℝ≥0) (hτ : IsStoppingTime filt τ), (∀ᵐ ω ∂P, (τ ω : ℝ≥0∞) < e ω) →
    ∀ ψ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P,
      Disjoint (tsupport ψ) (fwdHull (Ito.rpath (W · ω)) ((τ ω).untopD 0 : ℝ≥0)) →
      P[fun ω' => Complex.exp (Complex.I * (field ω' ψ : ℂ)) | hτ.measurableSpace] ω =
        cfVal (∫ z, meanF κ u₀ q Fq (Ito.rpath (W · ω)) ((τ ω).untopD 0 : ℝ≥0) z * ψ z)
          (loewnerGreenEnergy (Ito.rpath (W · ω)) ((τ ω).untopD 0 : ℝ≥0) ψ)

namespace RestartFibre

variable {S : Type u} [mS : MeasurableSpace S] (D : RestartFibre S)

/-- **The comparison data of Aux. lemma 62** for a fibre: see the module docstring. -/
structure Comparison where
  bR : ℝ → ℝ
  JR : Finset ℝ
  bR_pc : IsPiecewiseConstantBoundaryData bR JR
  O : Set ℝ
  O_open : IsOpen O
  agree : ∀ x ∈ O, basicData D.κ x = bR x
  zero_mem : (0 : ℝ) ∈ O
  qR : ℂ → ℝ
  qR_ext : IsBoundedHarmonicExtension (fun x => bR x - basicData D.κ x) ((({0} : Finset ℝ) ∪ JR : Finset ℝ) : Set ℝ) qR
  F : CMCut
  N : Set ℂ
  cut : IsCutoffOn F (fun z => qR z - D.q z) N O
  buffer_sub : D.buffer ⊆ N
  Cq : ℝ
  q_bdd : ∀ z, F.src z ≠ 0 → |D.q z| ≤ Cq
  s : ℕ → TestOn upperHalfPlaneOpens
  s_bound : ∀ n z, |s n z| ≤ |F.src z|
  s_limit : ∀ z, Tendsto (fun n => s n z) atTop (𝓝 (F.src z))
  Λ : S → ℝ
  Λ_measurable : Measurable Λ
  pairing_limit : ∀ᵐ ω ∂D.P, Tendsto (fun n => D.field ω (s n)) atTop (𝓝 (Λ ω))
  integrable_exp : Integrable (fun ω => Real.exp (-Λ ω)) D.P
  k : ℝ
  k_pos : 0 < k

variable {D}

namespace Comparison

variable (C : D.Comparison)

/-- The Cameron–Martin weighted law `k e^{−Λ} · P`. -/
def tilt : Measure S := D.P.withDensity fun ω => ENNReal.ofReal (C.k * Real.exp (-C.Λ ω))

/-- The shifted field `h + (v − F.f)`, `v = q̂ − q`. -/
def chartField : S → DistOn upperHalfPlaneOpens :=
  fun ω => D.field ω + smoothDist upperHalfPlaneOpens (fun z => (C.qR z - D.q z) - C.F.f z)

/-- **R3 at one stop**: under the tilt, at a stop `τ < e` of the fibre's filtration, the shifted field has the reference
word's kernel at the geometric images of the fibre's driver. -/
theorem ae_condExp_tilt (τ : S → WithTop ℝ≥0) (hτ : IsStoppingTime D.filt τ)
    (hτe : ∀ᵐ ω ∂D.P, (τ ω : ℝ≥0∞) < D.e ω) {uR : S → ℂ → ℝ}
    (huR : ∀ ω, IsBoundedHarmonicExtension
      (forceBoundaryData D.κ (flowLineRhoL D.κ C.bR C.JR 0 0) (flowLineRhoR D.κ C.bR C.JR 0 0)
        (fun i => geomL (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXL C.bR C.JR 0 i))
        (fun j => geomR (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXR C.bR C.JR 0 j)))
      (forceJumpSet (fun i => geomL (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXL C.bR C.JR 0 i))
        (fun j => geomR (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXR C.bR C.JR 0 j))) (uR ω))
    (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂C.tilt, Disjoint (tsupport φ) (fwdHull (Ito.rpath (D.W · ω)) ((τ ω).untopD 0 : ℝ≥0)) →
      C.tilt[fun ω' => Complex.exp (Complex.I * (C.chartField ω' φ : ℂ)) | hτ.measurableSpace] ω =
        cfVal (∫ z, couplingMean D.κ (Ito.rpath (D.W · ω)) ((τ ω).untopD 0 : ℝ≥0) (uR ω) z * φ z)
          (loewnerGreenEnergy (Ito.rpath (D.W · ω)) ((τ ω).untopD 0 : ℝ≥0) φ) := by
  let _ := D.prob
  set κ := D.κ with hκdef
  set Wd : S → ℝ → ℝ := fun ω => Ito.rpath (D.W · ω) with hWd
  set t : S → ℝ := fun ω => (((τ ω).untopD 0 : ℝ≥0) : ℝ) with ht
  have hWc : ∀ ω, Continuous (Wd ω) := fun ω => (D.continuous ω).comp continuous_real_toNNReal
  -- the hull lies in the buffer, and the buffer where both cutoffs are harmonic
  have hKb : ∀ᵐ ω ∂D.P, closure (fwdHull (Wd ω) (t ω)) ⊆ D.buffer := by
    filter_upwards [D.hull_buffer, hτe] with ω hb hτω
    exact hb _ (Restart.FlowStopIdentCM.coe_untopD_lt hτω)
  have hΔq : ∀ z ∈ D.buffer, QuantumZipper.K3.greenDensity D.Fq.f z = 0 := fun z hz =>
    D.cut.harmonic z (D.buffer_sub hz)
  have hΔ : ∀ z ∈ D.buffer, QuantumZipper.K3.greenDensity C.F.f z = 0 := fun z hz =>
    C.cut.harmonic z (C.buffer_sub hz)
  have hFq' : IsCutoffOn D.Fq (fun z => D.Fq.f z) D.buffer univ :=
    ⟨D.buffer_open, fun _ _ _ => trivial, fun _ _ _ => rfl, hΔq⟩
  have hF' : IsCutoffOn C.F (fun z => C.F.f z) D.buffer univ :=
    ⟨D.buffer_open, fun _ _ _ => trivial, fun _ _ _ => rfl, hΔ⟩
  -- the inputs of the tilt
  have hu₀h := D.u₀_ext.1
  obtain ⟨Cu, hCu⟩ := D.u₀_ext.2.1
  have hMint : ∀ᵐ ω ∂D.P, ∀ ψ : TestOn upperHalfPlaneOpens, Disjoint (tsupport ψ) (fwdHull (Wd ω) (t ω)) →
      Integrable fun z => meanF κ D.u₀ D.q D.Fq (Wd ω) (t ω) z * ψ z := by
    filter_upwards [hKb] with ω hK ψ hψ
    exact integrable_meanF_mul hu₀h D.q_cont (D.continuous ω) (hFq'.isGreenTest_src hK) ψ hψ
  have hsd : ∀ᵐ ω ∂D.P, ∀ n, Disjoint (tsupport (C.s n)) (fwdHull (Wd ω) (t ω)) := by
    filter_upwards [hKb] with ω hK n
    exact disjoint_tsupport_of_abs_le_src hF' (C.s_bound n) fun z hz => hK (subset_closure hz)
  have hμ₂ : ∀ᵐ ω ∂D.P, Tendsto (fun n => ∫ z, meanF κ D.u₀ D.q D.Fq (Wd ω) (t ω) z * C.s n z) atTop
      (𝓝 ((∫ z, couplingMean κ (Wd ω) (t ω) D.u₀ z * C.F.src z) - greenCross (Wd ω) (t ω) C.F.src D.Fq.src +
        ∫ z, (D.q z - D.Fq.f z) * C.F.src z)) := by
    filter_upwards [hKb] with ω hK
    exact tendsto_integral_meanF_mul hu₀h hCu D.q_cont D.buffer_open D.zero_mem hΔq hΔ C.q_bdd (D.continuous ω)
      (D.zero ω) hK C.s_bound C.s_limit
  have hs₂₂ : ∀ᵐ ω ∂D.P, Tendsto (fun n => loewnerGreenEnergy (Wd ω) (t ω) (C.s n)) atTop
      (𝓝 (loewnerGreenEnergy (Wd ω) (t ω) C.F.src)) := by
    filter_upwards [hKb] with ω hK
    exact tendsto_energy_of_abs_le_src hF' (hWc ω) (NNReal.coe_nonneg _) hK C.s_bound C.s_limit
  have hs₁₂ : ∀ᵐ ω ∂D.P, Disjoint (tsupport φ) (fwdHull (Wd ω) (t ω)) →
      Tendsto (fun n => greenCross (Wd ω) (t ω) φ (C.s n)) atTop (𝓝 (greenCross (Wd ω) (t ω) φ C.F.src)) := by
    filter_upwards [hKb, hsd] with ω hK hd hφ
    have hG := hF'.isGreenTest_src hK
    exact LocalExt.tendsto_greenCross (hWc ω) (NNReal.coe_nonneg _) (LocalExt.isGreenTest_of_testOn φ hφ) hG
      (fun n => LocalExt.isGreenTest_of_testOn (C.s n) (hd n)) hG C.s_bound C.s_limit
  have hpath : ∀ᵐ ω ∂D.P, 0 ≤ t ω ∧ ∃ t₂, t ω < t₂ ∧ ContinuousOn (Wd ω) (Icc 0 t₂) :=
    ae_of_all _ fun ω => ⟨NNReal.coe_nonneg _, t ω + 1, by linarith, (hWc ω).continuousOn⟩
  set T : DistOn upperHalfPlaneOpens := smoothDist upperHalfPlaneOpens (fun z => (C.qR z - D.q z) - C.F.f z) with hT
  have htilt := Restart.FlowStopIdentCM.ae_condExp_withDensity_add_of_kernel hτ.measurableSpace_le
    D.measurable_field (D.kernel τ hτ hτe) hpath hMint C.Λ_measurable C.pairing_limit C.integrable_exp hsd hμ₂ hs₂₂
    C.k_pos T φ hs₁₂
  -- the mean identity, pathwise
  have hqR : ContinuousOn C.qR H := fun z hz => ((C.qR_ext.1 z hz).1.continuousAt).continuousWithinAt
  have hc : ContinuousOn (fun z => (C.qR z - D.q z) - C.F.f z) H :=
    (hqR.sub D.q_cont).sub C.F.smooth.continuous.continuousOn
  have hTφ : T φ = ∫ z, ((C.qR z - D.q z) - C.F.f z) * φ z := by
    rw [hT, SupercriticalConformalCovariance.GM24.smoothDist_apply hc φ]
    exact integral_congr_ae (ae_of_all _ fun z => mul_comm _ _)
  have hQP : C.tilt ≪ D.P := withDensity_absolutelyContinuous _ _
  filter_upwards [htilt, hQP.ae_le hKb, hQP.ae_le D.trace, hQP.ae_le hτe] with ω h1 hK htr hτω hφ
  have hφ' : Disjoint (tsupport φ) (fwdHull (Wd ω) (t ω)) := hφ
  change (D.P.withDensity fun ω => ENNReal.ofReal (C.k * Real.exp (-C.Λ ω)))[fun ω' =>
    Complex.exp (Complex.I * ((D.field ω' + T) φ : ℂ)) | hτ.measurableSpace] ω = _
  rw [h1 hφ', hTφ]
  congr 1
  -- the reference (PC1) at this stop, with the basic mean `u₀`
  have hMR : IsPC1 κ D.u₀ (Wd ω) (t ω) C.qR C.O (couplingMean κ (Wd ω) (t ω) (uR ω)) :=
    isPC1_ref_basic D.κ_pos D.u₀_ext C.bR_pc C.O_open C.agree C.zero_mem C.qR_ext (D.continuous ω) (D.zero ω)
      (fun hpos => htr _ (Restart.FlowStopIdentCM.coe_untopD_lt hτω) hpos) (huR ω)
  exact integral_meanF_shift_eq hu₀h (D.continuous ω) D.q_cont hqR hMR D.cut
    (D.buffer_sub D.zero_mem) (hK.trans D.buffer_sub) C.cut (C.buffer_sub D.zero_mem) (hK.trans C.buffer_sub) φ hφ'

/-- The weighted law is equivalent to the fibre's law. -/
theorem tilt_equivalent : C.tilt ≪ D.P ∧ D.P ≪ C.tilt :=
  ⟨withDensity_absolutelyContinuous _ _,
    Restart.FlowStopIdentCMI.absolutelyContinuous_withDensity_exp C.Λ_measurable C.k_pos⟩

open Sec7.PocketTraversal in
/-- **R3 at every stop: the tilted fibre has the reference word's kernel** (the `kernel` field of
`Aux61R45.ReferenceSetting`, PROVE-AUX61-R45): under `k e^{−Λ} · P`, the shifted field `h + (v − F.f)` has, at every
stop `τ < e` of the fibre's filtration, the Gaussian conditional law of the reference word `b̂` from `0` (angle `0`)
with its marks at the geometric images of the fibre's driver. -/
theorem isCouplingCharFun_tilt : Coupling.MartMeans.IsCouplingCharFun D.κ (flowLineRhoL D.κ C.bR C.JR 0 0)
    (flowLineRhoR D.κ C.bR C.JR 0 0) C.tilt D.filt D.W (geomLW D.W fun _ => flowLineXL C.bR C.JR 0)
    (geomRW D.W fun _ => flowLineXR C.bR C.JR 0) D.e C.chartField := by
  intro τ hτ hτe uR huR φ
  have hτe₀ : ∀ᵐ ω ∂D.P, (τ ω : ℝ≥0∞) < D.e ω := C.tilt_equivalent.2.ae_le hτe
  have hu : ∀ ω, IsBoundedHarmonicExtension
      (forceBoundaryData D.κ (flowLineRhoL D.κ C.bR C.JR 0 0) (flowLineRhoR D.κ C.bR C.JR 0 0)
        (fun i => geomL (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXL C.bR C.JR 0 i))
        (fun j => geomR (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXR C.bR C.JR 0 j)))
      (forceJumpSet (fun i => geomL (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXL C.bR C.JR 0 i))
        (fun j => geomR (Ito.rpath (D.W · ω)) (((τ ω).untopD 0 : ℝ≥0) : ℝ) (flowLineXR C.bR C.JR 0 j))) (uR ω) := by
    intro ω
    have hr : Bessel.realPath D.W ω = Ito.rpath (D.W · ω) := rfl
    have hl : Bessel.realPath (fun t ω => -D.W t ω) ω = (fun s => -Ito.rpath (D.W · ω) s) := rfl
    simpa only [geomLW, geomRW, geomL, geomR, hr, hl, Ito.rpath, Real.toNNReal_coe] using huR ω
  filter_upwards [C.ae_condExp_tilt τ hτ hτe₀ hu φ] with ω hω hφ
  exact hω hφ

end Comparison

end RestartFibre

end InteractingSLE.Sec5.Aux61Win
