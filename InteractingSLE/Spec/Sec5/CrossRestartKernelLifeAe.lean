/-!
# Each curve's record is almost surely a function of what the strip hypothesis sees

Packet PROVE-CFRESTART, the σ-algebra bridge of (A). Proposition 3.7 with both stopped records retained
(`WangWu.isHistoryAvoidanceLocal_union`) asks for conditional independence, given the field, of σ-algebras containing
each curve's hull and its own stopped driving record; the strip hypothesis gives it for the flow line's **trace** and
the counterflow's **driver path**. This file closes the gap.

* `aeGenSigma P G`: the measurable events almost surely equal to events of `G`; **`condIndepEv_aeGenSigma`**:
  conditional independence of `σ(G₁)`, `σ(G₂)` passes to `aeGenSigma P G₁`, `aeGenSigma P G₂`;
  `le_aeGenSigma_of_isAeGen`.
* `isAeGen_generateFrom`, `isAeGen_iSup`, `isAeGen_stopped` (the stopped σ-algebras of an almost surely
  `G`-generated filtration).
* **`isAeGen_drivingFiltration_trace`**: if almost surely `(W, VL, VR, B, ζ)` is an integrated `SLE_a(ρ)` path
  (`a > 0`) with generating trace `η`, every event of the driving filtration is almost surely an event of `η`
  (`mem_recSet_iff`: lifetime and state are read from the trace; junk after `ζ` does not matter).
* **`isAeGen_drivingFiltration_drv`**: the same for the driver path `t ↦ W_t` (`mem_recSetD_iff`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.CrossRestart

open Sec2.Assembly Exist Exist.Staged Coupling

/-! ### σ-algebras generated up to null sets -/

section AeGen

variable {Ω Y : Type*} {m F A₀ B₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [MeasurableSpace Y] {P : Measure Ω}
  {G : Ω → Y}

/-- **A σ-algebra generated by almost-`G` events is almost surely `G`-generated.** -/
theorem isAeGen_generateFrom {S : Set (Set Ω)} (h : ∀ s ∈ S, ∃ C : Set Y, MeasurableSet C ∧ s =ᵐ[P] G ⁻¹' C) :
    IsAeGen P G (MeasurableSpace.generateFrom S) := by
  intro A hA
  induction hA with
  | basic s hs => exact h s hs
  | empty => exact ⟨∅, MeasurableSet.empty, by rw [preimage_empty]⟩
  | compl s _ ih =>
    obtain ⟨C, hC, hsC⟩ := ih
    exact ⟨Cᶜ, hC.compl, by rw [preimage_compl]; exact hsC.compl⟩
  | iUnion f _ ih =>
    choose C hC hfC using ih
    exact ⟨⋃ n, C n, MeasurableSet.iUnion hC, by rw [preimage_iUnion]; exact EventuallyEqSet.countable_iUnion hfC⟩

/-- **A supremum of almost surely `G`-generated σ-algebras is almost surely `G`-generated.** -/
theorem isAeGen_iSup {ι : Sort*} {m : ι → MeasurableSpace Ω} (h : ∀ i, IsAeGen P G (m i)) :
    IsAeGen P G (⨆ i, m i) := by
  intro A hA
  rw [MeasurableSpace.measurableSet_iSup] at hA
  exact isAeGen_generateFrom (S := {s | ∃ i, MeasurableSet[m i] s}) (fun s ⟨i, hs⟩ => h i s hs) A hA

/-- **Stopped σ-algebras of an almost surely `G`-generated filtration are almost surely `G`-generated** (any
stopping time: the stopped σ-algebra lies in `⨆ t, 𝓖 t`). -/
theorem isAeGen_stopped {𝓖 : Filtration ℝ≥0 mΩ} (h : ∀ t, IsAeGen P G (𝓖 t)) {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime 𝓖 τ) : IsAeGen P G hτ.measurableSpace :=
  (isAeGen_iSup h).mono hτ.measurableSpace_le'

/-- **The measurable events almost surely equal to events of `G`.** -/
@[instance_reducible]
def aeGenSigma (P : Measure Ω) (G : Ω → Y) : MeasurableSpace Ω :=
  WangWu.aeSigma (MeasurableSpace.comap G inferInstance) P ⊓ mΩ

theorem aeGenSigma_le : aeGenSigma P G ≤ mΩ := inf_le_right

theorem le_aeGenSigma_of_isAeGen (hm : m ≤ mΩ) (h : IsAeGen P G m) :
    m ≤ aeGenSigma P G := fun s hs => by
  obtain ⟨C, hC, hsC⟩ := h s hs
  exact MeasurableSpace.measurableSet_inf.2 ⟨⟨G ⁻¹' C, ⟨C, hC, rfl⟩, hsC⟩, hm s hs⟩

theorem comap_le_aeGenSigma (hG : Measurable G) : MeasurableSpace.comap G inferInstance ≤ aeGenSigma P G :=
  le_aeGenSigma_of_isAeGen hG.comap_le isAeGen_comap

/-- **Conditional independence passes to almost-sure events.** -/
theorem condIndepEv_aeSigma [IsFiniteMeasure P]
    (h : LQGMetric.CondIndepEv F A₀ B₀ P) :
    LQGMetric.CondIndepEv F (WangWu.aeSigma A₀ P) (WangWu.aeSigma B₀ P) P := by
  intro s t hs ht
  obtain ⟨s₀, hs₀, hss⟩ := hs
  obtain ⟨t₀, ht₀, htt⟩ := ht
  have e1 : P⟦s ∩ t | F⟧ =ᵐ[P] P⟦s₀ ∩ t₀ | F⟧ :=
    condExp_congr_ae (indicator_ae_eq_of_ae_eq_set (hss.inter htt))
  have e2 : P⟦s | F⟧ =ᵐ[P] P⟦s₀ | F⟧ := condExp_congr_ae (indicator_ae_eq_of_ae_eq_set hss)
  have e3 : P⟦t | F⟧ =ᵐ[P] P⟦t₀ | F⟧ := condExp_congr_ae (indicator_ae_eq_of_ae_eq_set htt)
  filter_upwards [e1, e2, e3, h s₀ t₀ hs₀ ht₀] with ω h1 h2 h3 h4
  rw [h1, h4, Pi.mul_apply, Pi.mul_apply, h2, h3]

/-- **Conditional independence of `σ(G₁)`, `σ(G₂)` passes to their almost-sure σ-algebras.** -/
theorem condIndepEv_aeGenSigma [IsFiniteMeasure P] {Z₁ Z₂ : Type*} [MeasurableSpace Z₁] [MeasurableSpace Z₂]
    {G₁ : Ω → Z₁} {G₂ : Ω → Z₂}
    (h : LQGMetric.CondIndepEv F (MeasurableSpace.comap G₁ inferInstance) (MeasurableSpace.comap G₂ inferInstance)
      P) :
    LQGMetric.CondIndepEv F (aeGenSigma P G₁) (aeGenSigma P G₂) P := fun s t hs ht =>
  condIndepEv_aeSigma h s t (MeasurableSpace.measurableSet_inf.1 hs).1 (MeasurableSpace.measurableSet_inf.1 ht).1

end AeGen

/-! ### The driving filtration from the trace and from the driver path -/

section Driving

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} {nL nR : ℕ} {a : ℝ} {xL : Fin nL → ℝ}
  {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

/-- **Every event of the driving filtration is almost surely an event of the trace.** -/
theorem isAeGen_drivingFiltration_trace (ha : 0 < a) (hX : IsMeasurableKilledDriving W VL VR ζ)
    {η : Ω → ℝ≥0 → ℂ}
    (hp : ∀ᵐ ω ∂P, IsIntegratedSLEPath a xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω) (fun i t => VR i t ω)
      (fun t => B t ω) (ζ ω))
    (hη : ∀ᵐ ω ∂P, IsGeneratingTrace (fun t => W t ω) (ζ ω) (η ω)) (t : ℝ≥0) :
    IsAeGen P η (drivingFiltration P hX t) := by
  refine IsAeGen.usualAugmentation (fun s => ?_) t
  refine isAeGen_generateFrom fun E hE => ?_
  obtain ⟨r, -, A, hA, rfl⟩ := hE
  refine ⟨RecSet a xL xR ρL ρR r A, measurableSet_recSet ha xL xR ρL ρR r hA, ?_⟩
  filter_upwards [hp, hη] with ω hpω hηω
  exact propext (mem_recSet_iff ha hpω hηω r A).symm

/-- **Every event of the driving filtration is almost surely an event of the driver path.** -/
theorem isAeGen_drivingFiltration_drv (ha : 0 < a) (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hp : ∀ᵐ ω ∂P, IsIntegratedSLEPath a xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω) (fun i t => VR i t ω)
      (fun t => B t ω) (ζ ω)) (t : ℝ≥0) :
    IsAeGen P (fun ω t => W t ω) (drivingFiltration P hX t) := by
  refine IsAeGen.usualAugmentation (fun s => ?_) t
  refine isAeGen_generateFrom fun E hE => ?_
  obtain ⟨r, -, A, hA, rfl⟩ := hE
  refine ⟨RecSetD a xL xR ρL ρR r A, measurableSet_recSetD ha xL xR ρL ρR r hA, ?_⟩
  filter_upwards [hp] with ω hpω
  exact propext (mem_recSetD_iff ha hpω r A).symm

end Driving

end InteractingSLE.Sec5.CrossRestart
