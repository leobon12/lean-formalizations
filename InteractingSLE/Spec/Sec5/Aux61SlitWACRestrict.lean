import InteractingSLE.Spec.Sec5.Aux61SlitWACStable
import InteractingSLE.Spec.Sec5.Aux61SlitWACNormalization

/-! # Initial-record restrictions preserve the fixed restart family

Restriction changes only selection. The literal weak chart, the fully
normalized witness, the physical contact, and the windows are preserved.
On the restricted event the whole selected path and exit time agree.
-/

set_option autoImplicit false
noncomputable section
open MeasureTheory Set Filter Topology
open scoped NNReal ENNReal

namespace InteractingSLE.Sec5.Aux61SlitWAC
open Aux61SlitW Aux61SlitWX Aux61R1C Aux61Asm2 Aux61FibData LawUnique
universe u
variable {S : SourceSetting.{u}} (C : RestartChoices S)

/-- Refine selection by a fixed initial-record predicate, keeping the
same index, chart model, physical stopping rule and window data. -/
def restrictChoices (A : C.ι → Set (SourceRecord S.nL S.nR)) : RestartChoices S :=
  { C with selected := fun i => C.selected i ∩ A i }

variable (A : C.ι → Set (SourceRecord S.nL S.nR))

/-- A Borel restriction retains the exact selection-measurability field. -/
theorem selected_measurable_restrict (hsel : ∀ i, MeasurableSet (C.selected i))
    (hA : ∀ i, MeasurableSet (A i)) : ∀ i, MeasurableSet ((restrictChoices C A).selected i) :=
  fun i => (hsel i).inter (hA i)

/-- The weak selector is literally unchanged by record restriction. -/
theorem chart_restrict_eq (i : C.Idx) :
    (restrictChoices C A).toR1Restart.chart (restrictChoices C A).hasChart i =
      C.toR1Restart.chart C.hasChart i := rfl

/-- The complete normalized selector is also unchanged, by equality of
its full certificate predicate rather than by forgetting normalization. -/
theorem normalized_chart_restrict_eq (i : C.Idx) :
    Aux61SlitWX.chart (restrictChoices C A).toR1Restart (restrictChoices C A).hasChart i =
      Aux61SlitWX.chart C.toR1Restart C.hasChart i :=
  normalized_chart_eq_of_time_eq (restrictChoices C A) C i i rfl

/-- The refinement is an event determined by the initial record alone. -/
theorem event_restrict_eq (i : C.Idx) :
    (restrictChoices C A).fam.event i = C.fam.event i ∩
      (sourceRecord C.fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i) ⁻¹' A i.1 := by
  ext p
  change ((C.record i.1 p ∈ C.selected i.1 ∧ C.record i.1 p ∈ A i.1) ∧
    C.record i.1 p ∈ C.good i.1) ↔
    (C.record i.1 p ∈ C.selected i.1 ∧ C.record i.1 p ∈ C.good i.1) ∧ C.record i.1 p ∈ A i.1
  exact ⟨fun h => ⟨⟨h.1.1, h.2⟩, h.1.2⟩, fun h => ⟨⟨h.1.1, h.2⟩, h.1.2⟩⟩

/-- No selected sample is added by the refinement. -/
theorem event_restrict_subset (i : C.Idx) : (restrictChoices C A).fam.event i ⊆ C.fam.event i := by
  rw [event_restrict_eq]
  exact inter_subset_left

/-- With Borel record predicates, the refined event is measurable in
the sigma algebra generated by precisely the original retained record. -/
theorem measurableSet_event_restrict_initial (hsel : ∀ i, MeasurableSet (C.selected i))
    (hA : ∀ i, MeasurableSet (A i)) (i : C.Idx) :
    MeasurableSet[(inferInstance : MeasurableSpace (SourceRecord S.nL S.nR)).comap
      (sourceRecord C.fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)]
      ((restrictChoices C A).fam.event i) :=
  MeasurableSpace.measurableSet_comap.2 ⟨(restrictChoices C A).toR1Restart.selected i,
    (restrictChoices C A).selected_measurable (selected_measurable_restrict C A hsel hA) i, rfl⟩

/-- At each admitted sample, restriction leaves the entire selected
chart path unchanged, including its total values at and after contact. -/
theorem inPath_restrict_eq (i : C.Idx) {p : S.Ω × HistorySpace 0 0}
    (hp : p ∈ (restrictChoices C A).fam.event i) :
    inPath ((restrictChoices C A).fam.event i)
      (sourceChart (restrictChoices C A).fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
      ((withRecordPath S (restrictChoices C A).fam).path i) ((restrictChoices C A).fam.contact i) p =
    inPath (C.fam.event i)
      (sourceChart C.fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
      ((withRecordPath S C.fam).path i) (C.fam.contact i) p := by
  funext v
  have hc := event_restrict_subset C A i hp
  simp only [inPath, hp, hc, true_and]
  rfl

/-- The actual fixed-window exit time is preserved at an admitted
sample. This uses equality of all path values, with no stopping input. -/
theorem exitTime_restrict_eq (i : C.Idx) {p : S.Ω × HistorySpace 0 0}
    (hp : p ∈ (restrictChoices C A).fam.event i) :
    Aux61FibData.exitTime ((restrictChoices C A).fam.event i)
      (sourceChart (restrictChoices C A).fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
      ((withRecordPath S (restrictChoices C A).fam).path i) ((restrictChoices C A).fam.contact i)
      ((restrictChoices C A).data i.1).V p =
    Aux61FibData.exitTime (C.fam.event i)
      (sourceChart C.fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
      ((withRecordPath S C.fam).path i) (C.fam.contact i) (C.data i.1).V p := by
  have hc := event_restrict_subset C A i hp
  unfold Aux61FibData.exitTime
  apply iSup_congr
  intro a
  congr 1
  change (p ∈ (restrictChoices C A).fam.event i ∧
    ((a : ℝ≥0) : ℝ≥0∞) < C.fam.contact i p ∧ ∀ v ≤ (a : ℝ≥0),
      inPath ((restrictChoices C A).fam.event i)
        (sourceChart (restrictChoices C A).fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
        ((withRecordPath S (restrictChoices C A).fam).path i) ((restrictChoices C A).fam.contact i) p v ∈
          (C.data i.1).V) =
    (p ∈ C.fam.event i ∧ ((a : ℝ≥0) : ℝ≥0∞) < C.fam.contact i p ∧ ∀ v ≤ (a : ℝ≥0),
      inPath (C.fam.event i)
        (sourceChart C.fam (rationalTime S.s) S.own.W S.own.VL S.own.VR S.life i)
        ((withRecordPath S C.fam).path i) (C.fam.contact i) p v ∈ (C.data i.1).V)
  rw [inPath_restrict_eq C A i hp]
  simp only [hp, hc, true_and]

end InteractingSLE.Sec5.Aux61SlitWAC
