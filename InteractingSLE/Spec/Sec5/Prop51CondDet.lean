import Mathlib.Probability.Independence.Conditional

/-!
# A process determined by the field is conditionally independent of everything given the field

Packet PROVE-SEC5-K. Proposition 5.1, Lemma 5.4 and Lemma 5.7 are stated for couplings in which the flow line `η_θ`
and the counterflow line `η′` are conditionally independent given the field `h` (`Prop51CondIndepStatement`,
PROVE-SEC5-J). Once a flow line is known to be almost surely a Borel function of `h` (Theorem 1.2 in §4.2's regime:
`Lemma75Bridge.exists_flowLineMap_of_admissible` from the §4.2 reference), this hypothesis holds for **every** process
`W′` on the same space. PROVE-SEC5-J recorded this lemma as absent.

* `aeCompletion m' mΩ μ`: the σ-algebra of the measurable sets that are `μ`-almost everywhere equal to a set of `m'`;
* `condIndep_aeCompletion`: it is conditionally independent of every sub-σ-algebra given `m'` (the indicator of such
  a set is almost surely `m'`-measurable, so it factors out of the conditional expectation);
* `condIndep_of_ae_eq_comp`, `condIndep_iSup_of_ae_eq_comp`: the same for the σ-algebra generated by a family of
  random variables `X t` that are almost surely `Φ t ∘ h` with `Φ t` measurable.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set

namespace InteractingSLE

namespace Sec5

namespace CondDet

variable {Ω : Type*}

/-- The σ-algebra of the `mΩ`-measurable sets that are `μ`-almost everywhere equal to an `m'`-measurable set. -/
@[reducible] def aeCompletion (m' : MeasurableSpace Ω) (mΩ : MeasurableSpace Ω) (μ : @Measure Ω mΩ) :
    MeasurableSpace Ω where
  MeasurableSet' s := MeasurableSet[mΩ] s ∧ ∃ s', MeasurableSet[m'] s' ∧ s =ᵐ[μ] s'
  measurableSet_empty := ⟨@MeasurableSet.empty Ω mΩ, ∅, @MeasurableSet.empty Ω m', EventuallyEq.rfl⟩
  measurableSet_compl s hs := by
    obtain ⟨hs, s', hs', hss'⟩ := hs
    exact ⟨hs.compl, s'ᶜ, hs'.compl, ae_eq_set_compl_compl.2 hss'⟩
  measurableSet_iUnion f hf := by
    choose hfm g hg hfg using hf
    exact ⟨MeasurableSet.iUnion hfm, ⋃ i, g i, MeasurableSet.iUnion hg, EventuallyEqSet.countable_iUnion hfg⟩

theorem aeCompletion_le (m' : MeasurableSpace Ω) {mΩ : MeasurableSpace Ω} (μ : Measure Ω) :
    aeCompletion m' mΩ μ ≤ mΩ :=
  fun _ hs => hs.1

/-- The indicator of a set times a function. -/
theorem indicator_eq_indicator_one_mul (s : Set Ω) (f : Ω → ℝ) :
    s.indicator f = s.indicator (fun _ => (1 : ℝ)) * f := by
  funext x
  by_cases hx : x ∈ s <;> simp [hx]

/-- **The almost-sure completion of `m'` is conditionally independent of everything given `m'`.** -/
theorem condIndep_aeCompletion {m' m₂ : MeasurableSpace Ω} {mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] (hm' : m' ≤ mΩ) (hm₂ : m₂ ≤ mΩ) :
    CondIndep m' (aeCompletion m' mΩ μ) m₂ hm' μ := by
  rw [condIndep_iff m' _ m₂ hm' (aeCompletion_le m' μ) hm₂ μ]
  rintro t1 t2 ⟨ht1, s', hs', hts⟩ ht2
  set g : Ω → ℝ := t2.indicator fun _ => (1 : ℝ) with hg
  have hgi : Integrable g μ := (integrable_const (1 : ℝ)).indicator (hm₂ _ ht2)
  have h1i : Integrable (s'.indicator fun _ => (1 : ℝ)) μ := (integrable_const (1 : ℝ)).indicator (hm' _ hs')
  -- the left side
  have eL : (t1 ∩ t2).indicator (fun _ => (1 : ℝ)) =ᵐ[μ] s'.indicator g := by
    rw [← Set.indicator_indicator]
    exact indicator_ae_eq_of_ae_eq_set hts
  have hL : μ[(t1 ∩ t2).indicator (fun _ => (1 : ℝ)) | m'] =ᵐ[μ] s'.indicator (μ[g | m']) :=
    (condExp_congr_ae eL).trans (condExp_indicator hgi hs')
  -- the first factor
  have hsm : StronglyMeasurable[m'] (s'.indicator fun _ => (1 : ℝ)) :=
    stronglyMeasurable_const.indicator hs'
  have hR1 : μ[t1.indicator (fun _ => (1 : ℝ)) | m'] =ᵐ[μ] s'.indicator (fun _ => (1 : ℝ)) := by
    refine (condExp_congr_ae (indicator_ae_eq_of_ae_eq_set hts)).trans ?_
    rw [condExp_of_stronglyMeasurable hm' hsm h1i]
  filter_upwards [hL, hR1] with ω hω1 hω2
  rw [hω1, Pi.mul_apply, hω2, indicator_eq_indicator_one_mul s' (μ[g | m'])]
  rfl

/-- **A σ-algebra whose sets are almost surely sets of the field is conditionally independent of everything given
the field.** -/
theorem condIndep_of_ae_eq_comp {m₁ m₂ : MeasurableSpace Ω} {mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] {F : Type*} [MeasurableSpace F] {h : Ω → F} (hh : Measurable h)
    (hm₁ : m₁ ≤ mΩ) (hm₂ : m₂ ≤ mΩ)
    (hdet : ∀ s, MeasurableSet[m₁] s →
      ∃ s', MeasurableSet[MeasurableSpace.comap h inferInstance] s' ∧ s =ᵐ[μ] s') :
    CondIndep (MeasurableSpace.comap h inferInstance) m₁ m₂ hh.comap_le μ :=
  condIndep_of_condIndep_of_le_left (condIndep_aeCompletion hh.comap_le hm₂)
    fun s hs => ⟨hm₁ s hs, hdet s hs⟩

/-- **A process that is almost surely a measurable function of the field is conditionally independent of every
sub-σ-algebra given the field** (each `X t` almost surely equal to `Φ t ∘ h`, with `Φ t` measurable). -/
theorem condIndep_iSup_of_ae_eq_comp {m₂ : MeasurableSpace Ω} {mΩ : MeasurableSpace Ω} [StandardBorelSpace Ω]
    {μ : Measure Ω} [IsFiniteMeasure μ] {F : Type*} [MeasurableSpace F] {h : Ω → F} (hh : Measurable h)
    {T E : Type*} [MeasurableSpace E] {X : T → Ω → E} (hX : ∀ t, Measurable (X t)) {Φ : T → F → E}
    (hΦ : ∀ t, Measurable (Φ t)) (hae : ∀ t, X t =ᵐ[μ] fun ω => Φ t (h ω)) (hm₂ : m₂ ≤ mΩ) :
    CondIndep (MeasurableSpace.comap h inferInstance) (⨆ t, MeasurableSpace.comap (X t) inferInstance) m₂
      hh.comap_le μ := by
  refine condIndep_of_condIndep_of_le_left (condIndep_aeCompletion hh.comap_le hm₂) (iSup_le fun t => ?_)
  rintro _ ⟨B, hB, rfl⟩
  refine ⟨hX t hB, h ⁻¹' (Φ t ⁻¹' B), ⟨Φ t ⁻¹' B, hΦ t hB, rfl⟩, ?_⟩
  exact (hae t).preimage B

end CondDet

end Sec5

end InteractingSLE
