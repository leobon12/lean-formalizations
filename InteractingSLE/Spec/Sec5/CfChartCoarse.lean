import InteractingSLE.Spec.Sec5.CfChartGlue

/-!
# The coarse σ-algebra: where the glued measure is the law of the given space

Packet PROVE-CFCHART (PROVE-CFGIVEN §3, step 4). On the given space `Ω` the flow line `D` and the counterflow `W′` of
the same field `h` are coupled arbitrarily; the glued space `Ω × 𝓗` instead carries the counterflow history drawn from
its conditional law given the field. The two agree in law on every σ-algebra of `Ω` whose sets are, up to `P`-null
sets, events of the field (`fieldNullSigma P X`): there `P(A ∩ {Y ∈ t}) = ∫_A k(X)(t) dP`. The flow data are
almost surely Borel functions of the field (the §4.2 reference), so the σ-algebra generated by the field, the killed
flow data and one null set has this property (`coarseSigma`).

To use it with instance search the coarse σ-algebra is carried by a type synonym `Coarse m` of `Ω`.

## Main results

* `Coarse`, `toCoarse`, `measurable_toCoarse`;
* **`map_glue_coarse_eq`**: the glued measure and the law of `(ω, Y ω)` agree on `Coarse m × β`;
* `fieldNullSigma`, `comap_le_fieldNullSigma`, `mem_fieldNullSigma_of_ae`, `mem_fieldNullSigma_of_null`;
* `coarseSigma` (field, killed flow data, a null set) with `coarseSigma_le`, `coarseSigma_le_fieldNullSigma`,
  `isMeasurableKilledDriving_coarse`, `measurable_field_coarse`, `measurableSet_null_coarse`.

R48: nothing here uses Theorem 1.2/1.3, `Theorem12ParamStatement`, `Theorem13Statement` or any `*_of_param`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal

universe u

namespace InteractingSLE.Sec5.CfChart

/-! ### The coarse copy of `Ω` -/

section Coarse

variable {Ω : Type u}

/-- **`Ω` carrying the σ-algebra `m`** (a type synonym, so that products such as `Coarse m × β` get the coarse
product σ-algebra by instance search). -/
def Coarse (_m : MeasurableSpace Ω) : Type u := Ω

instance instMeasurableSpaceCoarse (m : MeasurableSpace Ω) : MeasurableSpace (Coarse m) := m

/-- The identity of `Ω`, read into the coarse copy. -/
def toCoarse (m : MeasurableSpace Ω) (ω : Ω) : Coarse m := ω

theorem measurable_toCoarse {m : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] (hm : m ≤ mΩ) :
    Measurable (toCoarse m) := fun _ hs => hm _ hs

end Coarse

/-! ### Events of a variable up to null sets -/

section FieldNull

variable {Ω : Type u} {α : Type*} [MeasurableSpace α]

/-- **The events of `X` up to `P`-null sets**: the sets that agree almost surely with `X ⁻¹' C`, `C` Borel. -/
@[instance_reducible]
def fieldNullSigma [MeasurableSpace Ω] (P : Measure Ω) (X : Ω → α) : MeasurableSpace Ω where
  MeasurableSet' s := ∃ C, MeasurableSet C ∧ s =ᵐ[P] X ⁻¹' C
  measurableSet_empty := ⟨∅, MeasurableSet.empty, ae_eq_refl _⟩
  measurableSet_compl s := by
    rintro ⟨C, hC, h⟩
    exact ⟨Cᶜ, hC.compl, h.compl⟩
  measurableSet_iUnion f := by
    intro hf
    choose C hC h using hf
    refine ⟨⋃ i, C i, MeasurableSet.iUnion hC, ?_⟩
    rw [preimage_iUnion]
    exact EventuallyEqSet.countable_iUnion h

end FieldNull

/-! ### The law of the given space on the coarse product -/

section Law

variable {Ω : Type u} {m : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {α β : Type*} [MeasurableSpace α]
  [MeasurableSpace β]

/-- **The glued measure is the law of the given space on the coarse product.** Let `k` be a conditional law of `Y`
given `X` and let every `m`-measurable set differ from an event of `X` by a `P`-null set. Then the glued measure
`P ⊗ k(X)` and the law of `ω ↦ (ω, Y ω)` agree on `Coarse m × β`. -/
theorem map_glue_coarse_eq {P : Measure Ω} [IsProbabilityMeasure P] {X : Ω → α} (hX : Measurable X) {Y : Ω → β}
    (hY : Measurable Y) (k : Kernel α β) [IsMarkovKernel k] (hk : P.map (fun ω => (X ω, Y ω)) = P.map X ⊗ₘ k)
    (hm : m ≤ mΩ) (hmX : m ≤ fieldNullSigma P X) :
    (WangWu.glueMeasure P k X hX).map (fun p => (toCoarse m p.1, p.2)) =
      P.map (fun ω => (toCoarse m ω, Y ω)) := by
  have hg₁ : Measurable fun p : Ω × β => (toCoarse m p.1, p.2) :=
    ((measurable_toCoarse hm).comp measurable_fst).prodMk measurable_snd
  have hg₂ : Measurable fun ω => (toCoarse m ω, Y ω) := (measurable_toCoarse hm).prodMk hY
  have : IsFiniteMeasure ((WangWu.glueMeasure P k X hX).map fun p => (toCoarse m p.1, p.2)) :=
    Measure.isFiniteMeasure_map _ _
  refine Measure.ext_prod fun {s t} hs ht => ?_
  rw [Measure.map_apply hg₁ (hs.prod ht), Measure.map_apply hg₂ (hs.prod ht)]
  obtain ⟨C, hC, hss'⟩ := hmX s hs
  have hs' : MeasurableSet[mΩ] (show Set Ω from s) := hm s hs
  have e1 : (fun p : Ω × β => (toCoarse m p.1, p.2)) ⁻¹' (s ×ˢ t) = (show Set Ω from s) ×ˢ t := rfl
  have e2 : (fun ω => (toCoarse m ω, Y ω)) ⁻¹' (s ×ˢ t) = (show Set Ω from s) ∩ Y ⁻¹' t := rfl
  rw [e1, e2, WangWu.glueMeasure_apply_prod k hX hs' ht]
  rw [setLIntegral_congr hss', ← setLIntegral_map hC (k.measurable_coe ht) hX,
    ← Measure.compProd_apply_prod hC ht, ← hk, Measure.map_apply (hX.prodMk hY) (hC.prod ht)]
  refine measure_congr ?_
  have e3 : (fun ω => (X ω, Y ω)) ⁻¹' (C ×ˢ t) = X ⁻¹' C ∩ Y ⁻¹' t := rfl
  rw [e3]
  exact hss'.symm.inter (ae_eq_refl _)

end Law

/-! ### Sets that are events of the field up to null sets -/

section Null

variable {Ω : Type u} [mΩ : MeasurableSpace Ω] {α γ : Type*} [MeasurableSpace α] [MeasurableSpace γ]
  {P : Measure Ω} {X : Ω → α}

/-- A variable that is almost surely a Borel function of `X` generates events of `X` up to null sets. -/
theorem comap_le_fieldNullSigma {f : Ω → γ} {g : α → γ} (hg : Measurable g) (hfg : ∀ᵐ ω ∂P, f ω = g (X ω)) :
    MeasurableSpace.comap f inferInstance ≤ fieldNullSigma P X := by
  rintro s ⟨B, hB, rfl⟩
  refine ⟨g ⁻¹' B, hg hB, ?_⟩
  filter_upwards [hfg] with ω hω
  simp only [mem_preimage, hω]

/-- A set that agrees almost surely with an event of `X` is in `nullApproxSigma`. -/
theorem mem_fieldNullSigma_of_ae {S : Set Ω} {C : Set α} (hC : MeasurableSet C)
    (hS : ∀ᵐ ω ∂P, (ω ∈ S ↔ X ω ∈ C)) : MeasurableSet[fieldNullSigma P X] S := by
  refine ⟨C, hC, ?_⟩
  filter_upwards [hS] with ω hω
  simp only [mem_preimage, hω]

/-- A null set is in `nullApproxSigma`. -/
theorem mem_fieldNullSigma_of_null {N : Set Ω} (hN : P N = 0) : MeasurableSet[fieldNullSigma P X] N := by
  refine ⟨∅, MeasurableSet.empty, ?_⟩
  rw [preimage_empty]
  exact ae_eq_empty.2 hN

end Null

/-! ### The coarse σ-algebra of the flow data -/

section CoarseSigma

variable {Ω : Type u} {nL nR : ℕ} {α : Type*} [MeasurableSpace α]

/-- The generating events of the killed flow data (`IsMeasurableKilledDriving`). -/
def killedGen (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞) :
    Set (Set Ω) :=
  {S | ∃ (r : ℝ≥0) (A : Set (ℝ × (Fin nL → ℝ) × (Fin nR → ℝ))), MeasurableSet A ∧
    S = {ω | (r : ℝ≥0∞) < ζ ω ∧ (W r ω, fun i => VL i r ω, fun i => VR i r ω) ∈ A}}

/-- **The coarse σ-algebra**: generated by the field `f`, the killed flow data and the set `N`. -/
@[instance_reducible]
def coarseSigma (f : Ω → α) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ) (VR : Fin nR → ℝ≥0 → Ω → ℝ)
    (ζ : Ω → ℝ≥0∞) (N : Set Ω) : MeasurableSpace Ω :=
  MeasurableSpace.comap f inferInstance ⊔ MeasurableSpace.generateFrom (insert N (killedGen W VL VR ζ))

variable {f : Ω → α} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ}
  {ζ : Ω → ℝ≥0∞} {N : Set Ω}

theorem measurable_field_coarse : Measurable[coarseSigma f W VL VR ζ N] f :=
  fun _ hs => le_sup_left (a := MeasurableSpace.comap f inferInstance) _ ⟨_, hs, rfl⟩

theorem measurableSet_null_coarse : MeasurableSet[coarseSigma f W VL VR ζ N] N :=
  le_sup_right (a := MeasurableSpace.comap f inferInstance) _
    (MeasurableSpace.measurableSet_generateFrom (mem_insert _ _))

theorem isMeasurableKilledDriving_coarse :
    @IsMeasurableKilledDriving Ω (coarseSigma f W VL VR ζ N) nL nR W VL VR ζ := fun r A hA =>
  le_sup_right (a := MeasurableSpace.comap f inferInstance) _
    (MeasurableSpace.measurableSet_generateFrom (mem_insert_of_mem _ ⟨r, A, hA, rfl⟩))

theorem coarseSigma_le [mΩ : MeasurableSpace Ω] (hf : Measurable f) (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hN : MeasurableSet N) : coarseSigma f W VL VR ζ N ≤ mΩ := by
  refine sup_le hf.comap_le (MeasurableSpace.generateFrom_le ?_)
  rintro S (rfl | ⟨r, A, hA, rfl⟩)
  · exact hN
  · exact hX r A hA

/-- **The coarse σ-algebra consists of events of `X` up to null sets** when the field is a Borel function of `X`,
the killed flow data are almost surely a Borel function of `X` (before the lifetime) and `N` is null. -/
theorem coarseSigma_le_fieldNullSigma [MeasurableSpace Ω] {β : Type*} [MeasurableSpace β] {P : Measure Ω}
    {X : Ω → β} {g : β → α} (hg : Measurable g) (hfX : ∀ᵐ ω ∂P, f ω = g (X ω)) (hN : P N = 0)
    {Ψ : β → ℝ≥0∞ × (ℝ≥0 → ℝ) × (Fin nL → ℝ≥0 → ℝ) × (Fin nR → ℝ≥0 → ℝ)} (hΨ : Measurable Ψ)
    (hdet : ∀ᵐ ω ∂P, (Ψ (X ω)).1 = ζ ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) < ζ ω →
      (Ψ (X ω)).2.1 t = W t ω ∧ (∀ i, (Ψ (X ω)).2.2.1 i t = VL i t ω) ∧ ∀ i, (Ψ (X ω)).2.2.2 i t = VR i t ω) :
    coarseSigma f W VL VR ζ N ≤ fieldNullSigma P X := by
  refine sup_le (comap_le_fieldNullSigma hg hfX) (MeasurableSpace.generateFrom_le ?_)
  rintro S (rfl | ⟨r, A, hA, rfl⟩)
  · exact mem_fieldNullSigma_of_null hN
  · have hΨ1 : Measurable fun x => (Ψ x).1 := measurable_fst.comp hΨ
    have hΨW : Measurable fun x => (Ψ x).2.1 r := (measurable_pi_apply r).comp (measurable_fst.comp
      (measurable_snd.comp hΨ))
    have hΨL : Measurable fun x => fun i => (Ψ x).2.2.1 i r := measurable_pi_iff.2 fun i =>
      (measurable_pi_apply r).comp ((measurable_pi_apply i).comp (measurable_fst.comp (measurable_snd.comp
        (measurable_snd.comp hΨ))))
    have hΨR : Measurable fun x => fun i => (Ψ x).2.2.2 i r := measurable_pi_iff.2 fun i =>
      (measurable_pi_apply r).comp ((measurable_pi_apply i).comp (measurable_snd.comp (measurable_snd.comp
        (measurable_snd.comp hΨ))))
    refine mem_fieldNullSigma_of_ae (C := {x | (r : ℝ≥0∞) < (Ψ x).1 ∧
      ((Ψ x).2.1 r, fun i => (Ψ x).2.2.1 i r, fun i => (Ψ x).2.2.2 i r) ∈ A})
      ((measurableSet_lt measurable_const hΨ1).inter (hΨW.prodMk (hΨL.prodMk hΨR) hA)) ?_
    filter_upwards [hdet] with ω ⟨h1, h2⟩
    simp only [h1]
    constructor
    · rintro ⟨hr, hA'⟩
      obtain ⟨e1, e2, e3⟩ := h2 r hr
      refine ⟨hr, ?_⟩
      have e2' : (fun i => (Ψ (X ω)).2.2.1 i r) = fun i => VL i r ω := funext e2
      have e3' : (fun i => (Ψ (X ω)).2.2.2 i r) = fun i => VR i r ω := funext e3
      rw [e1, e2', e3']
      exact hA'
    · rintro ⟨hr, hA'⟩
      obtain ⟨e1, e2, e3⟩ := h2 r hr
      refine ⟨hr, ?_⟩
      have e2' : (fun i => (Ψ (X ω)).2.2.1 i r) = fun i => VL i r ω := funext e2
      have e3' : (fun i => (Ψ (X ω)).2.2.2 i r) = fun i => VR i r ω := funext e3
      rw [e1, e2', e3'] at hA'
      exact hA'

end CoarseSigma

end InteractingSLE.Sec5.CfChart
