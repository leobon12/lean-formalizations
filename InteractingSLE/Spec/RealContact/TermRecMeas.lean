/-!
# The driver record is an observable of the killed path history

Packet PROVE-RC-TERM, second run (ruling R124). The chart of the completed second path, its word, the seed position
and the stop set are functions of the driver record `recOf N (E ω)`; the landed physical filtration
`Sec7.Lemma76F.retSigma76` is generated by killed **path** histories. This module is the bridge:

* `recOf_coe_eq_top`: a record at an own time after the lifetime is the record through the lifetime;
* **`ae_eq_measurable_recOf`**: for a regular measurable driver `E` of a flow line, a capped version of the line (cap
  `m > N`) and any σ-algebra `𝒦` measuring the capped coordinates up to `N` and the survival event `{N < ζ}`, the
  record `ω ↦ recOf N (E ω)` is almost surely equal to a `𝒦`-measurable map;
* **`measurable_recOf_retSigma76`**: hence, for the second flow line, `ω ↦ recOf N (E ω)` is measurable for
  `retSigma76 P η₁ η₂ ζ₁ ζ₂ u N`. On `{N < ζ₂}` the record is read
  from the path frozen at `N` (`Theorem14.WalkInf.capRead_pathCoord_frozen`); on `{ζ₂ ≤ N}` the whole record is read
  from the path frozen at its lifetime (`Theorem14.WalkLeaf.readRec_pathCoord`).

R48-neutral.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Filter Topology MeasureTheory
open scoped NNReal ENNReal
open LQGMetric (DistOn)

universe u

namespace InteractingSLE.RealContact

namespace Term

open Restart Restart.RetAux79 Exist.Staged Exist.StagedLaw Sec2.Assembly Sec7.Lemma76F

/-- A record at an own time after the lifetime is the record through the lifetime. -/
theorem recOf_coe_eq_top {e : (ℝ≥0 → ℝ) × ℝ≥0∞} {N : ℝ≥0} (h : e.2 ≤ N) : recOf (N : ℝ≥0∞) e = recOf ⊤ e := by
  unfold recOf retOf
  rw [min_eq_right h, min_eq_right (le_top : e.2 ≤ ⊤)]
  simp only [h, le_top, decide_true]

variable {Ω : Type u} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- **The driver record of a flow line at an own time is almost surely a measurable function of any information
that measures the capped path up to that time and the survival event** (see the module docstring). -/
theorem ae_eq_measurable_recOf {κ : ℝ} (hκ : 0 < κ) {c : BoundaryWord} {θ : ℝ}
    {g : Ω → DistOn upperHalfPlaneOpens} {E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞}
    (hreg : ∀ ω, IsRegularDriver (E ω))
    (hfl : IsFlowLineDriver κ c.fn c.jumps θ P g (fun s ω => (E ω).1 s) (fun ω => (E ω).2))
    {x : ℝ} {η : Ω → ℝ≥0 → ℂ}
    (htrace : ∀ᵐ ω ∂P, IsGeneratingTrace (E ω).1 (E ω).2 (fun t => η ω t - x))
    {N m : ℝ≥0} (hNm : N < m) {ηc : Ω → ℝ≥0 → ℂ}
    (ha : ∀ᵐ ω ∂P, ∀ s, ηc ω s = η ω (capTime m (E ω).2 s))
    {𝒦 : MeasurableSpace Ω} (hcoord : ∀ s ≤ N, Measurable[𝒦] fun ω => ηc ω s)
    (hlife : MeasurableSet[𝒦] {ω | lifeRec (E ω).2 N = ⊤}) :
    ∃ G : Ω → RecData, Measurable[𝒦] G ∧ (fun ω => recOf (N : ℝ≥0∞) (E ω)) =ᵐ[P] G := by
  classical
  let _ : MeasurableSpace Ω := mΩ
  have hgood : ∀ᵐ ω ∂P, min ⊤ (E ω).2 ≠ ⊤ → LocalExt.IsDrvGood (recHist (recOf ⊤ (E ω))) :=
    ae_isDrvGood_of_isFlowLineDriver hκ ⊤ hreg hfl
  have hwc : ∀ᵐ ω ∂P, ContinuousOn (E ω).1 {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (E ω).2} := by
    filter_upwards [hgood] with ω hg
    by_cases htop : (E ω).2 = ⊤
    · refine (hreg ω).1.mono fun t _ => ?_
      show (t : ℝ≥0∞) < (E ω).2
      rw [htop]
      exact ENNReal.coe_lt_top
    · have hcont := continuous_retOf (hreg ω) (hg (by rwa [min_eq_right le_top]))
      refine hcont.continuousOn.congr fun t ht => ?_
      show (E ω).1 t = (E ω).1 (min (t : ℝ≥0∞) (min ⊤ (E ω).2)).toNNReal
      rw [min_eq_right le_top, min_eq_left ht, ENNReal.toNNReal_coe]
  obtain ⟨h', 𝓕, VL, VR, B, -, hC⟩ := hfl
  have hpath := hC.1.ae_isIntegratedSLEPath
  -- the coordinates read from the information
  set coords : Ω → ℚ≥0 → ℂ := fun ω q => ηc ω (min (q : ℝ≥0) N) - (x : ℂ) with hcoords
  have hcm : Measurable[𝒦] coords := by
    refine (@measurable_pi_iff Ω ℚ≥0 (fun _ => ℂ) 𝒦 _ _).2 fun q => ?_
    exact (hcoord _ (min_le_right _ _)).sub measurable_const
  set G : Ω → RecData := fun ω => if lifeRec (E ω).2 N = ⊤ then Theorem14.WalkInf.capRead N (coords ω)
    else Theorem14.WalkLeaf.readRec κ (flowLineXL c.fn c.jumps 0) (flowLineXR c.fn c.jumps 0)
      (flowLineRhoL κ c.fn c.jumps 0 θ) (flowLineRhoR κ c.fn c.jumps 0 θ) (coords ω) with hG
  have hGm : Measurable[𝒦] G :=
    Measurable.ite hlife ((Theorem14.WalkInf.measurable_capRead N).comp hcm)
      ((Theorem14.WalkLeaf.measurable_readRec _ _ _ _ hκ).comp hcm)
  refine ⟨G, hGm, ?_⟩
  filter_upwards [hwc, hpath, htrace, ha] with ω hwcω hpω hη haω
  have hw0 : (E ω).1 0 = 0 := (hreg ω).2.1
  by_cases hlv : (N : ℝ≥0∞) < (E ω).2
  · -- the line is alive at `N`
    have hif : lifeRec (E ω).2 N = ⊤ := (lifeRec_eq_top_iff_of_ne_top ENNReal.coe_ne_top).2 hlv
    have hco : coords ω = Sec6.pathCoord (StagedEntrance.frozenPath (fun t => η ω t - (x : ℂ)) N) := by
      funext q
      simp only [hcoords, Sec6.pathCoord, StagedEntrance.frozenPath]
      rw [haω, capTime_of_le]
      exact (ENNReal.coe_le_coe.2 (min_le_right _ _)).trans
        (le_min hlv.le (ENNReal.coe_le_coe.2 hNm.le))
    show recOf (N : ℝ≥0∞) (E ω) = G ω
    simp only [hG, hif, ↓reduceIte]
    rw [hco]
    exact (Theorem14.WalkInf.capRead_pathCoord_frozen hwcω hw0 hη hlv).symm
  · -- the line died by `N`
    have hle : (E ω).2 ≤ N := not_lt.1 hlv
    have hfin : (E ω).2 ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top hle
    have hif : lifeRec (E ω).2 N ≠ ⊤ := fun h => hlv ((lifeRec_eq_top_iff_of_ne_top ENNReal.coe_ne_top).1 h)
    set T := ((E ω).2).toNNReal with hT
    have hTζ : (T : ℝ≥0∞) = (E ω).2 := ENNReal.coe_toNNReal hfin
    have hTN : T ≤ N := by
      have : (T : ℝ≥0∞) ≤ N := hTζ ▸ hle
      exact_mod_cast this
    have hco : coords ω = Sec6.pathCoord (fun t => η ω (min t T) - (x : ℂ)) := by
      funext q
      simp only [hcoords, Sec6.pathCoord]
      rw [haω]
      congr 2
      unfold capTime
      rw [min_eq_left (hle.trans (ENNReal.coe_le_coe.2 hNm.le)), ← hT, min_assoc,
        min_eq_right hTN]
    have hη' : IsGeneratingTrace (E ω).1 (E ω).2 (fun t => η ω (min t T) - (x : ℂ)) :=
      isGeneratingTrace_congr_le hη fun t ht => by
        have htT : t ≤ T := by
          have : (t : ℝ≥0∞) ≤ (T : ℝ≥0∞) := by rw [hTζ]; exact ht
          exact_mod_cast this
        show η ω (min t T) - (x : ℂ) = η ω t - (x : ℂ)
        rw [min_eq_left htT]
    have hrd := Theorem14.WalkLeaf.readRec_pathCoord hκ hpω hη' hwcω
    show recOf (N : ℝ≥0∞) (E ω) = G ω
    simp only [hG, hif, ↓reduceIte]
    rw [hco, hrd, recOf_coe_eq_top hle]

variable {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞}

/-- **The driver record of the second flow line is an observable of the killed histories** (see the module
docstring). -/
theorem measurable_recOf_retSigma76 {κ : ℝ} (hκ : 0 < κ) {c : BoundaryWord} {θ : ℝ}
    {g : Ω → DistOn upperHalfPlaneOpens} {E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞} (hEm : Measurable E)
    (hreg : ∀ ω, IsRegularDriver (E ω)) (hE2 : ∀ ω, (E ω).2 = ζ₂ ω)
    (hfl : IsFlowLineDriver κ c.fn c.jumps θ P g (fun s ω => (E ω).1 s) (fun ω => (E ω).2))
    {x₂ : ℝ} (htrace : ∀ᵐ ω ∂P, IsGeneratingTrace (E ω).1 (ζ₂ ω) (fun t => η₂ ω t - x₂))
    (hζ₂ : Measurable ζ₂) {u N : ℝ≥0} {ηc : Ω → ℝ≥0 → ℂ} (hc : ∀ ω, Continuous (ηc ω))
    (hm : ∀ s, Measurable fun ω => ηc ω s)
    (ha : ∀ᵐ ω ∂P, ∀ s, ηc ω s = η₂ ω (capTime (capR u N) (ζ₂ ω) s)) :
    Measurable[retSigma76 P η₁ η₂ ζ₁ ζ₂ u N] fun ω => recOf (N : ℝ≥0∞) (E ω) := by
  have hE2' : (fun ω => (E ω).2) = ζ₂ := funext hE2
  have htrace' : ∀ᵐ ω ∂P, IsGeneratingTrace (E ω).1 (E ω).2 (fun t => η₂ ω t - x₂) := by
    filter_upwards [htrace] with ω hω
    rw [hE2]
    exact hω
  have ha' : ∀ᵐ ω ∂P, ∀ s, ηc ω s = η₂ ω (capTime (capR u N) (E ω).2 s) := by
    filter_upwards [ha] with ω hω s
    rw [hE2]
    exact hω s
  have hlive : MeasurableSet[retSigma76 P η₁ η₂ ζ₁ ζ₂ u N] {ω | lifeRec (E ω).2 N = ⊤} := by
    simp only [hE2]
    exact measurable_lifeRec_retSigma76_right P η₁ η₂ ζ₁ ζ₂ hζ₂ u N (measurableSet_singleton ⊤)
  obtain ⟨G, hGm, hae⟩ := ae_eq_measurable_recOf hκ hreg hfl htrace' (lt_capR_right u N) ha'
    (𝒦 := retSigma76 P η₁ η₂ ζ₁ ζ₂ u N)
    (fun s hs => measurable_capped_right_retSigma76 hc hm ha hs) hlive
  exact measurable_retSigma76_congr (measurable_recOf hEm hreg _) hGm hae

end Term

end InteractingSLE.RealContact
