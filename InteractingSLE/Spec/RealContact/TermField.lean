/-!
# The terminal retained pair: the conditional field given the completed second path (R1)

Packet PROVE-RC-TERM (ruling R124). The named input `TerminalRetainedCondDetStatement` (`PocketCondDet.lean`, Lemma G7
at the retained pair `(0, ζ₂)`) has two clauses: (R1), the conditional law of the chart field given the completed
second path, and (Det), the determination of the first path as the canonical flow of the chart field. This file proves
(R1) and reduces the input to (Det) alone, for explicit data.

## The data

Let `η₂` be the angle-`θ₂` flow line from `x₂`. Its driver has a measurable version `E`, regular at every sample
(`exists_regular_driver`: the recentred coupling `Supp9.IsFlowLine.recenter`, a sorted word of the recentred datum,
and the regularization `Theorem14.StagedReg.regularize`). Then

* `termRec e = recOf ⊤ e` is the record of the driver through its lifetime (the driver at rational times, the lifetime
  and the threshold flag), and the conditioning σ-algebra is the one generated by the record;
* `termField κ x₂ r f` is the field `f`, recentred at `x₂`, read in the record chart (the centred Loewner chart at the
  lifetime, `Exist.StagedLaw.recChart_eq_loewner`);
* `termWord κ θ₂ c r = stopWord κ (c, θ₂, r)` is the force word of the second path at its lifetime, shifted by
  `−θ₂χ` (the heights of the chart field);
* `termSeed x₁ x₂ r` is the chart position of the first seed (the right boundary value of the centred Loewner map at
  `x₁ − x₂`).

## Main results

* **`ae_condExp_termField`** (R1): conditionally on the record of a finite lifetime, the chart field has the Gaussian
  characteristic functional of `termWord`. This is the landed single-stage law
  (`Exist.StagedLaw.ae_condExp_recField_of_admissible`, `…_of_inadmissible`) at the own time `⊤`; it holds on any
  probability space.
* `TerminalRetainedDetStatement` (**named input, not proved in Lean**): the clause (Det) for the explicit data.
* **`terminalRetainedCondDet_of_det`**: `TerminalRetainedCondDetStatement` from (Det) alone.

R48/R123: no theorem takes Theorems 1.2–1.3 as hypotheses here, and none is declared.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE.RealContact

open Restart LQGMetric Sec2.Assembly Exist.Staged Exist.StagedLaw

namespace Term

/-! ### The data -/

/-- The record of a driver through its lifetime. -/
def termRec (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : RecData := recOf ⊤ e

/-- The chart field of the completed path: the field recentred at `x₂`, read in the record chart. -/
def termField (κ x₂ : ℝ) (r : RecData) (f : DistOn upperHalfPlaneOpens) : DistOn upperHalfPlaneOpens :=
  recField κ r (Exist.flowField x₂ 0 f)

/-- The word of the chart field: the force word of the angle-`θ₂` flow line at the lifetime, shifted by `−θ₂χ`. -/
def termWord (κ θ₂ : ℝ) (c : BoundaryWord) (r : RecData) : BoundaryWord := stopWord κ (c, θ₂, r)

/-- The chart position of the first seed `x₁ ≥ x₂`. -/
def termSeed (x₁ x₂ : ℝ) (r : RecData) : ℝ := markPos (rdrv r) (rtime r) (x₁ - x₂)

theorem termRec_stop (e : (ℝ≥0 → ℝ) × ℝ≥0∞) : (termRec e).2.1 = e.2 := by
  change min ⊤ e.2 = e.2
  exact min_eq_right le_top

theorem isSorted_termWord (κ θ₂ : ℝ) (c : BoundaryWord) (r : RecData) : (termWord κ θ₂ c r).IsSorted :=
  isSorted_stopWord κ _

theorem measurable_termWord (κ θ₂ : ℝ) (c : BoundaryWord) : Measurable (termWord κ θ₂ c) :=
  (measurable_stopWord κ).comp (measurable_const.prodMk (measurable_const.prodMk measurable_id))

theorem measurable_termSeed (x₁ x₂ : ℝ) : Measurable (termSeed x₁ x₂) := by
  change Measurable fun r : RecData => markPos (rdrv r) (rtime r) (x₁ - x₂)
  exact measurable_markPos (W := rdrv) (τ := rtime) (x := fun _ => x₁ - x₂) (fun r => continuous_rdrv r)
    (fun t => measurable_rdrv_apply t) (fun r => rdrv_zero r) measurable_rtime (fun r => rtime_nonneg r)
    measurable_const

theorem measurable_termField (κ x₂ : ℝ) :
    Measurable fun p : RecData × DistOn upperHalfPlaneOpens => termField κ x₂ p.1 p.2 := by
  have h1 : Measurable fun p : RecData × DistOn upperHalfPlaneOpens => (p.1, Exist.flowField x₂ 0 p.2) :=
    measurable_fst.prodMk ((Exist.measurable_flowField x₂ 0).comp measurable_snd)
  change Measurable ((fun p : RecData × DistOn upperHalfPlaneOpens => recField κ p.1 p.2) ∘
    fun p : RecData × DistOn upperHalfPlaneOpens => (p.1, Exist.flowField x₂ 0 p.2))
  exact (measurable_recField κ).comp h1

/-! ### A regular measurable driver of a flow line -/

/-- **A flow line has a measurable driver, regular at every sample, of a sorted word of the recentred datum.** The
driver of the recentred coupling, set to `0` from the lifetime on, is regularized
(`Theorem14.StagedReg.regularize`): the lifetime is unchanged, and almost surely the driver is unchanged before the
lifetime, so the regular driver still drives the recentred flow line and generates `η − x`. -/
theorem exists_regular_driver {κ θ x : ℝ} {b : ℝ → ℝ} {J : Finset ℝ} (hb : IsPiecewiseConstantBoundaryData b J)
    {Ω : Type u} [mΩ : MeasurableSpace Ω] {P : Measure Ω} {h : Ω → DistOn upperHalfPlaneOpens}
    {η : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞} (hη : IsFlowLine κ b J x θ P h η ζ) :
    ∃ (c : BoundaryWord) (E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞), c.IsSorted ∧ c.jumps = J.image (· - x) ∧
      (∀ y ∉ J.image (· - x), c.fn y = b (y + x)) ∧ Measurable E ∧ (∀ ω, IsRegularDriver (E ω)) ∧
      (∀ ω, (E ω).2 = ζ ω) ∧
      IsFlowLineDriver κ c.fn c.jumps θ P (fun ω => Exist.flowField x 0 (h ω)) (fun s ω => (E ω).1 s)
        (fun ω => (E ω).2) ∧
      ∀ᵐ ω ∂P, IsGeneratingTrace (E ω).1 (ζ ω) (fun t => η ω t - x) := by
  classical
  have hζ := measurable_lifetime_of_isFlowLine hη
  obtain ⟨h', 𝓕, W, VL, VR, B, htr, hcoup, htrace⟩ := Supp9.IsFlowLine.recenter hη
  have hb' := Exist.isPiecewiseConstant_comp_add hb x
  obtain ⟨c, hcs, hcJ, hcb⟩ := Supp8.HullDetGen.exists_sorted_fn_eq hb'
  have hFL : IsFlowLineDriver κ (fun y => b (y + x)) (J.image (· - x)) θ P
      (fun ω => Exist.flowField x 0 (h ω)) W ζ := ⟨h', 𝓕, VL, VR, B, htr, hcoup⟩
  have hFLc := Supp8.HullDetGen.isFlowLineDriver_word hcJ hcb hFL
  have hWa := hcoup.1.2.1
  set W' : ℝ≥0 → Ω → ℝ := fun t ω => if (t : ℝ≥0∞) < ζ ω then W t ω else 0 with hW'
  have hW'm : ∀ t, Measurable (W' t) := fun t => measurable_ite_of_adaptedBefore hWa t
  set E₀ : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞ := fun ω => (fun t => W' t ω, ζ ω) with hE₀
  have hE₀m : Measurable E₀ := (measurable_pi_iff.2 fun t => hW'm t).prodMk hζ
  set E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞ := fun ω => Theorem14.StagedReg.regularize ⊤ (E₀ ω) with hE
  have hEm : Measurable E := (Theorem14.StagedReg.measurable_regularize ⊤).comp hE₀m
  have hE2 : ∀ ω, (E ω).2 = ζ ω := fun ω => Theorem14.StagedReg.regularize_snd ⊤ (E₀ ω)
  have hreg : ∀ ω, IsRegularDriver (E ω) := fun ω => Theorem14.StagedReg.isRegularDriver_regularize ⊤ (E₀ ω)
  have hagree : ∀ᵐ ω ∂P, (E ω).1 0 = W 0 ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) < ζ ω → (E ω).1 t = W t ω := by
    filter_upwards [hcoup.1.2.2.2.2] with ω hp
    have hw0 : W 0 ω = 0 := hp.1
    have hcw : ContinuousOn (fun t => W t ω) {t | (t : ℝ≥0∞) < ζ ω} := hp.2.2.2.1
    have h0 : (E₀ ω).1 0 = 0 := by
      change (if ((0 : ℝ≥0) : ℝ≥0∞) < ζ ω then W 0 ω else 0) = 0
      split_ifs
      · exact hw0
      · rfl
    have hc : ContinuousOn (E₀ ω).1 {s | (s : ℝ≥0∞) < (E₀ ω).2} := by
      refine hcw.congr fun s hs => ?_
      have hs' : (s : ℝ≥0∞) < ζ ω := hs
      change (if (s : ℝ≥0∞) < ζ ω then W s ω else 0) = W s ω
      exact ite_eq_left hs'
    refine ⟨((hreg ω).2.1).trans hw0.symm, fun t ht => ?_⟩
    have h1 : (E ω).1 t = (E₀ ω).1 t := Theorem14.StagedReg.regularize_eq_of_lt ⊤ h0 hc ht
    rw [h1]
    change (if (t : ℝ≥0∞) < ζ ω then W t ω else 0) = W t ω
    exact ite_eq_left ht
  have hfl' := Theorem14.StagedReg.isFlowLineDriver_congr_ae hFLc
    (W' := fun s ω => (E ω).1 s) (fun t => (measurable_pi_apply t).comp (measurable_fst.comp hEm)) hagree
  have hlife : (fun ω => (E ω).2) = ζ := funext hE2
  refine ⟨c, E, hcs, hcJ, hcb, hEm, hreg, hE2, by rw [hlife]; exact hfl', ?_⟩
  filter_upwards [htrace, hagree] with ω hω ha
  have h1 : IsGeneratingTrace (fun t => W t ω) (ζ ω) (fun t => η ω t - x) := by
    simpa only [Complex.ofReal_zero, sub_zero] using hω
  exact StoppedK2.isGeneratingTrace_congr (fun t ht => (ha.2 t ht).symm) h1

/-! ### (R1): the conditional field given the record of the completed path -/

/-- **(R1) for one flow line through its lifetime.** For a flow-line driver of a word `c`, regular at every sample,
on any probability space: conditionally on the record of the driver through a finite lifetime, the field read in the
record chart has the Gaussian characteristic functional of the stop word. This is the landed single-stage law at the
own time `⊤`. -/
theorem ae_condExp_termField {κ : ℝ} (hκ : 0 < κ) (c : BoundaryWord) (θ : ℝ) {Ω : Type u}
    [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (g : Ω → DistOn upperHalfPlaneOpens)
    (E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (hE : Measurable E) (hreg : ∀ ω, IsRegularDriver (E ω))
    (hfl : IsFlowLineDriver κ c.fn c.jumps θ P g (fun s ω => (E ω).1 s) (fun ω => (E ω).2))
    (φ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂P, (E ω).2 ≠ ⊤ →
      P[fun ω' => Complex.exp (Complex.I * (recField κ (termRec (E ω')) (g ω') φ : ℂ)) |
          MeasurableSpace.comap (fun ω' => termRec (E ω')) inferInstance] ω =
        gaussCF (termWord κ θ c (termRec (E ω))) φ := by
  by_cases hseed : ForceWord.ThresholdCondition (flowLineRhoL κ c.fn c.jumps 0 θ)
      (flowLineRhoR κ c.fn c.jumps 0 θ) 0 (flowLineXL c.fn c.jumps 0) (flowLineXR c.fn c.jumps 0)
  · filter_upwards [ae_condExp_recField_of_inadmissible hκ c θ ⊤ P g E hE hreg hfl hseed φ] with ω hω _
    exact hω
  · filter_upwards [ae_condExp_recField_of_admissible hκ c θ ⊤ P g E hE hreg hfl hseed φ] with ω hω hne
    exact hω (by rw [min_eq_right le_top]; exact hne)

end Term

open Term

/-! ### The reduction of the named input to (Det) -/

/-- **Named input: (Det) at the terminal retained pair, for the explicit data** (Lemma G7's conclusion, supplement
pp. 497–498, at the retained pair `(0, ζ₂)`: "it is the canonical stopped flow of the conditional field"). Setting of
`TerminalRetainedCondDetStatement`, a canonical flow code `F` of the angle `θ₁`, and any measurable driver `E` of the
second path, regular at every sample, for a sorted word `c` of the recentred datum (`Term.exists_regular_driver`).
Almost surely on the trigger event (`η₂` ends at a real point `e < x₂`, and `η₁` visits a real point `y ≤ e` before
its lifetime): the chart position `Term.termSeed` of the first seed is positive, and
`IsTerminalRetainedContinuation` holds for the chart field `Term.termField`, the word `Term.termWord` and the decoded
canonical flow code of the chart field from the seed position. **Not proved in Lean.** -/
def TerminalRetainedDetStatement : Prop :=
  ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ (b : ℝ → ℝ) (jumps : Finset ℝ), IsPiecewiseConstantBoundaryData b jumps →
    ∀ x₁ x₂ θ₁ θ₂ : ℝ, x₂ ≤ x₁ →
    κ / 2 - 2 ≤
      Sec4.cumWeightRight κ ((-sleLambda κ - θ₁ * QuantumZipper.chiC κ) + θ₂ * QuantumZipper.chiC κ) →
    ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (h : Ω → DistOn upperHalfPlaneOpens), IsGFFWithBoundaryData P h b jumps →
    ∀ (η₁ η₂ : Ω → ℝ≥0 → ℂ) (ζ₁ ζ₂ : Ω → ℝ≥0∞),
      IsFlowLine κ b jumps x₁ θ₁ P h η₁ ζ₁ → IsFlowLine κ b jumps x₂ θ₂ P h η₂ ζ₂ →
    ∀ F : (BoundaryWord × ℝ) × DistOn upperHalfPlaneOpens → (PCode × PCode) × ℝ≥0∞,
      IsCanonicalFlowCode κ θ₁ F →
    ∀ (c : BoundaryWord) (E : Ω → (ℝ≥0 → ℝ) × ℝ≥0∞), c.IsSorted → c.jumps = jumps.image (· - x₂) →
      (∀ y ∉ jumps.image (· - x₂), c.fn y = b (y + x₂)) → Measurable E → (∀ ω, IsRegularDriver (E ω)) →
      (∀ ω, (E ω).2 = ζ₂ ω) →
      IsFlowLineDriver κ c.fn c.jumps θ₂ P (fun ω => Exist.flowField x₂ 0 (h ω)) (fun s ω => (E ω).1 s)
        (fun ω => (E ω).2) →
      (∀ᵐ ω ∂P, IsGeneratingTrace (E ω).1 (ζ₂ ω) (fun t => η₂ ω t - x₂)) →
      ∀ᵐ ω ∂P, ∀ (T : ℝ≥0) (e : ℝ), (T : ℝ≥0∞) = ζ₂ ω → η₂ ω T = e → e < x₂ →
        (∃ (s : ℝ≥0) (y : ℝ), (s : ℝ≥0∞) < ζ₁ ω ∧ η₁ ω s = y ∧ y ≤ e) →
        0 < termSeed x₁ x₂ (termRec (E ω)) ∧
        IsTerminalRetainedContinuation κ b (h ω) (termField κ x₂ (termRec (E ω)) (h ω)) (η₁ ω) (ζ₁ ω) (η₂ ω) T
          (termWord κ θ₂ c (termRec (E ω)))
          (decPath (F ((termWord κ θ₂ c (termRec (E ω)), termSeed x₁ x₂ (termRec (E ω))),
            termField κ x₂ (termRec (E ω)) (h ω))))
          (F ((termWord κ θ₂ c (termRec (E ω)), termSeed x₁ x₂ (termRec (E ω))),
            termField κ x₂ (termRec (E ω)) (h ω))).2

/-- **The named input `TerminalRetainedCondDetStatement` from (Det) alone.** The conditioning σ-algebra is generated
by the record of the second path through its lifetime; `M` is the event "finite lifetime and positive seed position";
the datum is `(Term.termWord, Term.termSeed)` and the chart field is `Term.termField`. (R1) is
`Term.ae_condExp_termField`. -/
theorem terminalRetainedCondDet_of_det (hD : TerminalRetainedDetStatement.{u}) :
    TerminalRetainedCondDetStatement.{u} := by
  intro κ hκ hκ4 b jumps hb x₁ x₂ θ₁ θ₂ hx hwt Ω mΩ P _ h hh η₁ η₂ ζ₁ ζ₂ hη₁ hη₂ F hF
  obtain ⟨c, E, hcs, hcJ, hcb, hEm, hreg, hE2, hfl, htrace⟩ := exists_regular_driver hb hη₂
  have hRm : Measurable fun ω => termRec (E ω) := measurable_recOf hEm hreg ⊤
  have hdet := hD κ hκ hκ4 b jumps hb x₁ x₂ θ₁ θ₂ hx hwt P h hh η₁ η₂ ζ₁ ζ₂ hη₁ hη₂ F hF c E hcs hcJ hcb hEm
    hreg hE2 hfl htrace
  have hβm : Measurable fun r : RecData => (termWord κ θ₂ c r, termSeed x₁ x₂ r) :=
    (measurable_termWord κ θ₂ c).prodMk (measurable_termSeed x₁ x₂)
  have hMr : MeasurableSet {r : RecData | r.2.1 ≠ ⊤ ∧ 0 < termSeed x₁ x₂ r} :=
    (((measurable_fst.comp measurable_snd) (measurableSet_singleton ⊤)).compl).inter
      (measurableSet_lt measurable_const (measurable_termSeed x₁ x₂))
  have hR1 : ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, (E ω).2 ≠ ⊤ →
      P[fun ω' => Complex.exp (Complex.I * (termField κ x₂ (termRec (E ω')) (h ω') φ : ℂ)) |
          MeasurableSpace.comap (fun ω' => termRec (E ω')) inferInstance] ω =
        gaussCF (termWord κ θ₂ c (termRec (E ω))) φ := fun φ =>
    ae_condExp_termField hκ c θ₂ P (fun ω => Exist.flowField x₂ 0 (h ω)) E hEm hreg hfl φ
  let 𝒢 : {m : MeasurableSpace Ω // m ≤ mΩ} :=
    ⟨MeasurableSpace.comap (fun ω => termRec (E ω)) inferInstance, hRm.comap_le⟩
  let M : Set Ω := (fun ω => termRec (E ω)) ⁻¹' {r : RecData | r.2.1 ≠ ⊤ ∧ 0 < termSeed x₁ x₂ r}
  let β : Ω → BoundaryWord × ℝ := fun ω => (termWord κ θ₂ c (termRec (E ω)), termSeed x₁ x₂ (termRec (E ω)))
  let Hc : Ω → DistOn upperHalfPlaneOpens := fun ω => termField κ x₂ (termRec (E ω)) (h ω)
  have h1 : MeasurableSet[𝒢.1] M := ⟨_, hMr, rfl⟩
  have h2 : Measurable[𝒢.1] β := by
    change Measurable[MeasurableSpace.comap (fun ω => termRec (E ω)) inferInstance]
      ((fun r : RecData => (termWord κ θ₂ c r, termSeed x₁ x₂ r)) ∘ fun ω => termRec (E ω))
    exact hβm.comp (comap_measurable _)
  have h3 : Measurable Hc := by
    have hp : Measurable fun ω => (termRec (E ω), h ω) := hRm.prodMk hh.1
    change Measurable ((fun p : RecData × DistOn upperHalfPlaneOpens => termField κ x₂ p.1 p.2) ∘
      fun ω => (termRec (E ω), h ω))
    exact (measurable_termField κ x₂).comp hp
  have h4 : ∀ᵐ ω ∂P, ω ∈ M → (β ω).1.IsSorted ∧ 0 < (β ω).2 :=
    Eventually.of_forall fun ω hω => ⟨isSorted_termWord κ θ₂ c _, hω.2⟩
  have h5 : ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ω ∈ M →
      P[fun ω' => Complex.exp (Complex.I * (Hc ω' φ : ℂ)) | 𝒢.1] ω = gaussCF (β ω).1 φ := by
    intro φ
    filter_upwards [hR1 φ] with ω hω hωM
    exact hω (by rw [← termRec_stop]; exact hωM.1)
  have h6 : ∀ᵐ ω ∂P, ∀ (T : ℝ≥0) (e : ℝ), (T : ℝ≥0∞) = ζ₂ ω → η₂ ω T = e → e < x₂ →
      (∃ (s : ℝ≥0) (y : ℝ), (s : ℝ≥0∞) < ζ₁ ω ∧ η₁ ω s = y ∧ y ≤ e) →
      ω ∈ M ∧ IsTerminalRetainedContinuation κ b (h ω) (Hc ω) (η₁ ω) (ζ₁ ω) (η₂ ω) T (β ω).1
        (decPath (F (β ω, Hc ω))) (F (β ω, Hc ω)).2 := by
    filter_upwards [hdet] with ω hω T e hT he hex hvis
    obtain ⟨hpos, hcont⟩ := hω T e hT he hex hvis
    refine ⟨⟨?_, hpos⟩, hcont⟩
    change (termRec (E ω)).2.1 ≠ ⊤
    rw [termRec_stop, hE2, ← hT]
    exact ENNReal.coe_ne_top
  exact ⟨𝒢, M, β, Hc, h1, h2, h3, h4, h5, h6⟩

end InteractingSLE.RealContact
