import InteractingSLE.Spec.RealContact.TermK2
import InteractingSLE.Spec.Supplement.W5CommonSeedShift

/-!
# The pathwise hypotheses of the chart path from the facts of the two paths

Packet PROVE-RC-TERM, second run (ruling R124). **`isKSample_of_facts`** (deterministic): the hypotheses
`Term.IsKSample` of the chart-path package hold for a pair of paths with

* the second path `η₂` from `x₂`: a regular driver with a good record, generated through its finite lifetime `T`,
  injective, ending at a real point `e < x₂`, with no real point right of the first seed `x₁ ≥ x₂` and never at `x₁`
  after time `0`;
* the first path `η₁` from `x₁`: generated by a driver continuous before the positive lifetime, injective, in `ℍ̄`;
* ordered proper completions (W0) of all pairs of prefixes strictly before the lifetimes;
* the contact rule: a contact `η₁ x = η₂ t` with `x` before the first lifetime and `t > 0` has `t = T`;
* (distinct seeds) `η₁` never visits `x₂`.

`real_of_trigger` (deterministic): on the trigger of the path statement (`η₁` visits a real point `y ≤ e` before its
lifetime) the second path has no real point right of `x₁` (`Term.real_le_seed_of_order`).

Deterministic; R48-neutral.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Filter Topology Complex
open scoped NNReal ENNReal
open QuantumZipper (H Hbar)

namespace InteractingSLE.RealContact

namespace Term

open LP (reflectC)
open Restart Supp7 Exist.Staged Exist.StagedLaw Sec2.Assembly

variable {e₂ : (ℝ≥0 → ℝ) × ℝ≥0∞} {η₁ η₂ : ℝ≥0 → ℂ} {x₁ x₂ : ℝ} {T : ℝ≥0} {e : ℝ} {w : ℝ≥0 → ℝ} {ζ : ℝ≥0∞}

/-- The reflected recentred second path, shifted to the first seed, is the reflection of `η₂ − x₁`. -/
theorem refl_shift_eq (η₂ : ℝ≥0 → ℂ) (x₁ x₂ : ℝ) :
    (fun t : ℝ≥0 => reflectC (η₂ (t : ℝ).toNNReal - (x₂ : ℂ)) + ((x₁ - x₂ : ℝ) : ℂ)) =
      Supp9B.reflectCurve fun t => η₂ t - (x₁ : ℂ) := by
  funext t
  rw [Real.toNNReal_coe]
  apply Complex.ext
  · simp [Supp9B.reflectCurve, Supp9B.refl, reflectC]
  · simp [Supp9B.reflectCurve, Supp9B.refl, reflectC]

theorem refl_exp_eq (η₁ : ℝ≥0 → ℂ) (x₁ : ℝ) :
    (fun t : ℝ≥0 => reflectC (η₁ t - (x₁ : ℂ))) = Supp9B.reflectCurve fun t => η₁ t - (x₁ : ℂ) := by
  funext t
  apply Complex.ext <;> simp [Supp9B.reflectCurve, Supp9B.refl, reflectC]

/-- **The reflected recentred second path meets the reflected recentred first path exactly at the contacts.** -/
theorem mem_retSet_iff (η₁ η₂ : ℝ≥0 → ℂ) (x₁ x₂ : ℝ) (T t' : ℝ≥0) :
    reflectC (η₁ t' - (x₁ : ℂ)) ∈
        retSet (fun s : ℝ => reflectC (η₂ s.toNNReal - (x₂ : ℂ))) T (x₁ - x₂) ↔
      η₁ t' ∈ η₂ '' Icc 0 T := by
  have key : ∀ t : ℝ≥0, reflectC (η₂ (t : ℝ).toNNReal - (x₂ : ℂ)) + ((x₁ - x₂ : ℝ) : ℂ) =
      reflectC (η₁ t' - (x₁ : ℂ)) ↔ η₂ t = η₁ t' := by
    intro t
    rw [Real.toNNReal_coe]
    constructor
    · intro he
      have h1 : reflectC (η₂ t - (x₁ : ℂ)) = reflectC (η₁ t' - (x₁ : ℂ)) := by
        rw [← he]
        apply Complex.ext
        · simp [reflectC]
        · simp [reflectC]
      have h2 := congrArg reflectC h1
      rw [LP.reflectC_reflectC, LP.reflectC_reflectC] at h2
      exact sub_left_injective h2
    · intro he
      rw [← he]
      apply Complex.ext
      · simp [reflectC]
      · simp [reflectC]
  constructor
  · rintro ⟨t, ht, hte⟩
    exact ⟨t, ht, (key t).1 hte⟩
  · rintro ⟨t, ht, hte⟩
    exact ⟨t, ht, (key t).2 hte⟩

/-- **The pathwise hypotheses of the chart path** (see the module docstring). -/
theorem isKSample_of_facts (hx : x₂ ≤ x₁) (he₂ : IsRegularDriver e₂)
    (hg₂ : LocalExt.IsDrvGood (recHist (termRec e₂))) (hT : (T : ℝ≥0∞) = e₂.2)
    (hη₂ : IsGeneratingTrace e₂.1 e₂.2 (fun t => η₂ t - x₂)) (hinj₂ : InjOn η₂ {t | (t : ℝ≥0∞) ≤ e₂.2})
    (htip : η₂ T = e) (hex : e < x₂) (hreal : ∀ t ≤ T, (η₂ t).im = 0 → (η₂ t).re ≤ x₁)
    (hne : ∀ t : ℝ≥0, 0 < t → t ≤ T → η₂ t ≠ x₁)
    (hη₁ : IsGeneratingTrace w ζ (fun t => η₁ t - x₁)) (hwc : ContinuousOn w {s : ℝ≥0 | (s : ℝ≥0∞) < ζ})
    (hw0 : w 0 = 0) (hinj₁ : InjOn η₁ {t | (t : ℝ≥0∞) ≤ ζ}) (hbar₁ : ∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ ζ → 0 ≤ (η₁ t).im)
    (hord : ∀ a : ℝ≥0, (a : ℝ≥0∞) < ζ → ∀ c : ℝ≥0, c < T → HasOrderedProperCompletions η₁ a η₂ c)
    (hζ : 0 < ζ)
    (hcont : ∀ x t : ℝ≥0, (x : ℝ≥0∞) < ζ → t ≤ T → 0 < t → η₁ x = η₂ t → t = T)
    (hseed : x₂ < x₁ → ∀ s : ℝ≥0, (s : ℝ≥0∞) ≤ ζ → η₁ s ≠ x₂) :
    IsKSample (rdrv (termRec e₂)) T (fun s : ℝ => η₂ s.toNNReal - x₂) (e - x₂) (x₁ - x₂) w ζ
      (fun t => η₁ t - x₁) := by
  have h₁0 : η₁ 0 = x₁ := sub_eq_zero.1 hη₁.1
  have h₂0 : η₂ 0 = x₂ := sub_eq_zero.1 hη₂.1
  have hfresh := isFreshRealTip_of_trace he₂ hg₂ hT hη₂ hinj₂ htip (ne_of_lt hex)
  have hγH := mapsTo_trace_Hbar (x := x₂) he₂ hg₂ hT hη₂
  rw [rtime_termRec hT] at hfresh hγH
  have hmem : ∀ s : ℝ, s ∈ Icc (0 : ℝ) T → s.toNNReal ≤ T := fun s hs =>
    Real.toNNReal_le_iff_le_coe.2 hs.2
  have hmemE : ∀ s : ℝ, s ∈ Icc (0 : ℝ) T → ((s.toNNReal : ℝ≥0) : ℝ≥0∞) ≤ e₂.2 := fun s hs =>
    hT ▸ ENNReal.coe_le_coe.2 (hmem s hs)
  refine ⟨⟨by simpa using hfresh.reflect, fun s hs => ?_, fun s hs s' hs' hss' => ?_, sub_nonneg.2 hx,
    fun s hs him => ?_⟩, by linarith, fun s hs0 hsT => ?_, LP.isGeneratingTrace_reflect hη₁, hwc.neg,
    by simp [hw0], fun a ha b hb hab => ?_, fun t ht => ?_, fun a ha c hc => ?_, ?_⟩
  · -- the second path is in the closed half-plane
    show 0 ≤ (reflectC (η₂ s.toNNReal - (x₂ : ℂ))).im
    rw [LP.im_reflectC]
    exact hγH hs
  · -- injectivity of the second path
    have h1 := congrArg reflectC hss'
    simp only [LP.reflectC_reflectC] at h1
    have h2 : η₂ s.toNNReal = η₂ s'.toNNReal := sub_left_injective h1
    have h3 := hinj₂ (hmemE s hs) (hmemE s' hs') h2
    rw [← Real.coe_toNNReal s hs.1, ← Real.coe_toNNReal s' hs'.1, h3]
  · -- real points
    have him' : (η₂ s.toNNReal).im = 0 := by
      have : (reflectC (η₂ s.toNNReal - (x₂ : ℂ))).im = 0 := him
      rw [LP.im_reflectC] at this
      simpa using this
    have hre := hreal _ (hmem s hs) him'
    show -(x₁ - x₂) ≤ (reflectC (η₂ s.toNNReal - (x₂ : ℂ))).re
    simp only [reflectC, neg_re, conj_re, sub_re, ofReal_re]
    linarith
  · -- the second path is off the first seed after time `0`
    intro h0
    have hpos : 0 < s.toNNReal := Real.toNNReal_pos.2 hs0
    refine hne _ hpos (Real.toNNReal_le_iff_le_coe.2 hsT) ?_
    have h1 : reflectC (η₂ s.toNNReal - (x₁ : ℂ)) = 0 := by
      rw [← h0]
      apply Complex.ext
      · simp [reflectC]
      · simp [reflectC]
    have h2 := congrArg reflectC h1
    rw [LP.reflectC_reflectC] at h2
    have h3 : η₂ s.toNNReal - (x₁ : ℂ) = 0 := by rw [h2]; simp [reflectC]
    exact sub_eq_zero.1 h3
  · -- injectivity of the first path
    have h1 := congrArg reflectC hab
    simp only [LP.reflectC_reflectC] at h1
    exact hinj₁ ha hb (sub_left_injective h1)
  · show 0 ≤ (reflectC (η₁ t - (x₁ : ℂ))).im
    rw [LP.im_reflectC]
    simpa using hbar₁ t ht
  · -- the order
    have h1 : HasOrderedProperCompletions (fun t => η₁ t - (x₁ : ℂ)) a (fun t => η₂ t - (x₁ : ℂ)) c := by
      refine Supp9.HasOrderedProperCompletions.of_sub_real (-x₁) ?_
      have e1 : (fun t => (fun t => η₁ t - (x₁ : ℂ)) t - ((-x₁ : ℝ) : ℂ)) = η₁ := by
        funext t; push_cast; ring
      have e2 : (fun t => (fun t => η₂ t - (x₁ : ℂ)) t - ((-x₁ : ℝ) : ℂ)) = η₂ := by
        funext t; push_cast; ring
      rw [e1, e2]
      exact hord a ha c hc
    have h2 := Supp9B.hasOrderedProperCompletions_reflect h1 (by simp [h₁0]) (by simp [h₂0])
      (by simp [h₁0, h₂0, hx])
    rw [← refl_shift_eq η₂ x₁ x₂, ← refl_exp_eq η₁ x₁] at h2
    exact h2
  · -- the stop is positive
    obtain ⟨ζ', hζ'0, hζ'⟩ : ∃ ζ' : ℝ≥0, 0 < ζ' ∧ (ζ' : ℝ≥0∞) ≤ ζ := by
      by_cases htop : ζ = ⊤
      · exact ⟨1, one_pos, by rw [htop]; exact le_top⟩
      · exact ⟨ζ.toNNReal, ENNReal.toNNReal_pos hζ.ne' htop, by rw [ENNReal.coe_toNNReal htop]⟩
    have hc₁ : ContinuousOn η₁ (Icc 0 ζ') := by
      have h1 : ContinuousOn (fun t => η₁ t - (x₁ : ℂ)) (Icc 0 ζ') :=
        hη₁.2.1.mono fun t ht => (ENNReal.coe_le_coe.2 ht.2).trans hζ'
      refine (h1.add (continuousOn_const (c := (x₁ : ℂ)))).congr fun t _ => ?_
      exact (sub_add_cancel (η₁ t) (x₁ : ℂ)).symm
    have hne0 : η₁ 0 ≠ (e : ℂ) := by
      rw [h₁0]
      intro h
      have : x₁ = e := by exact_mod_cast h
      linarith
    have hev := (hc₁ 0 ⟨le_rfl, zero_le⟩).eventually_ne hne0
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhdsWithin_iff.1 hev
    set δ : ℝ≥0 := min ⟨ε / 2, by positivity⟩ ζ' with hδ
    have hδ0 : 0 < δ := lt_min (by
      show (0 : ℝ) < ε / 2
      positivity) hζ'0
    have hδin : ∀ t' : ℝ≥0, t' < δ → η₁ t' ≠ (e : ℂ) := by
      intro t' ht'
      refine hball ⟨?_, ⟨zero_le, (ht'.le.trans (min_le_right _ _))⟩⟩
      rw [Metric.mem_ball, NNReal.dist_eq, NNReal.coe_zero, sub_zero, abs_of_nonneg t'.coe_nonneg]
      have h1 : (t' : ℝ) < ε / 2 := by
        have := lt_of_lt_of_le ht' (min_le_left _ _)
        exact this
      linarith
    have hmemC : δ ∈ contSet (fun t => reflectC (η₁ t - (x₁ : ℂ))) ζ 0
        (retSet (fun s : ℝ => reflectC (η₂ s.toNNReal - (x₂ : ℂ))) T (x₁ - x₂)) := by
      refine ⟨zero_le, (ENNReal.coe_le_coe.2 (min_le_right _ _)).trans hζ', fun t' ht'0 ht'δ hmem' => ?_⟩
      obtain ⟨t, ht, hte⟩ := (mem_retSet_iff η₁ η₂ x₁ x₂ T t').1 hmem'
      have ht'ζ : (t' : ℝ≥0∞) < ζ := lt_of_lt_of_le (ENNReal.coe_lt_coe.2 ht'δ)
        ((ENNReal.coe_le_coe.2 (min_le_right _ _)).trans hζ')
      rcases eq_or_lt_of_le (zero_le : (0 : ℝ≥0) ≤ t) with ht0 | ht0
      · -- a visit of the second seed
        rw [← ht0, h₂0] at hte
        rcases hx.lt_or_eq with hlt | heq
        · exact hseed hlt t' ht'ζ.le hte.symm
        · have h2 : η₁ t' = η₁ 0 := by rw [← hte, h₁0, heq]
          have h3 := hinj₁ ht'ζ.le (show ((0 : ℝ≥0) : ℝ≥0∞) ≤ ζ from zero_le) h2
          exact ht'0.ne' h3
      · have htT := hcont t' t ht'ζ ht.2 ht0 hte.symm
        rw [htT, htip] at hte
        exact hδin t' ht'δ hte.symm
    exact lt_of_lt_of_le (ENNReal.coe_pos.2 hδ0) (le_contStop hmemC)

/-- **On the trigger of the path statement the second path has no real point right of the first seed.** -/
theorem real_of_trigger (hx : x₂ ≤ x₁) (h₁0 : η₁ 0 = x₁) (h₂0 : η₂ 0 = x₂) (htip : η₂ T = e) (hex : e < x₂)
    (hord : ∀ a : ℝ≥0, (a : ℝ≥0∞) < ζ → ∀ c : ℝ≥0, c < T → HasOrderedProperCompletions η₁ a η₂ c)
    (hcont : ∀ x t : ℝ≥0, (x : ℝ≥0∞) < ζ → t ≤ T → 0 < t → η₁ x = η₂ t → t = T)
    {s : ℝ≥0} {y : ℝ} (hs : (s : ℝ≥0∞) < ζ) (hy : η₁ s = y) (hye : y ≤ e) :
    ∀ t ≤ T, (η₂ t).im = 0 → (η₂ t).re ≤ x₁ := by
  intro t ht him
  rcases ht.lt_or_eq with hlt | heq
  · rcases eq_or_lt_of_le (zero_le : (0 : ℝ≥0) ≤ t) with ht0 | ht0
    · rw [← ht0, h₂0, ofReal_re]
      exact hx
    · have hq : η₂ t = (((η₂ t).re : ℝ) : ℂ) := Complex.ext (by simp) (by simp [him])
      refine real_le_seed_of_order hx h₁0 h₂0 (hord s hs t hlt) hy (lt_of_le_of_lt hye hex)
        (fun u hu he => ?_) (fun t' ht' he => ?_) hq
      · exact hlt.ne (hcont u t (lt_of_le_of_lt (ENNReal.coe_le_coe.2 hu) hs) ht ht0 he)
      · rcases eq_or_lt_of_le (zero_le : (0 : ℝ≥0) ≤ t') with h0 | h0
        · rw [← h0, h₂0, hy] at he
          have : x₂ = y := by exact_mod_cast he
          linarith
        · have := hcont s t' hs (ht'.trans ht) h0 he.symm
          exact (lt_of_le_of_lt ht' hlt).ne this
  · rw [heq, htip, ofReal_re]
    linarith

end Term

end InteractingSLE.RealContact
