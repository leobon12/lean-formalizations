import InteractingSLE.Spec.Sec2.JacobiMoments
import Mathlib.MeasureTheory.Measure.FiniteMeasureExt

/-!
# Uniqueness of the law of the stationary Jacobi process

Packet PROVE-SEC2-JAC. Two solutions of the Jacobi martingale problem on all of `ℝ`
(`IsJacobiMP`, `JacobiMoments.lean`) with the same parameters have the same finite-dimensional
laws (`IsJacobiMP.map_eq`): their mixed moments agree (`IsJacobiMP.integral_prodPow_eq`), the
values lie in the cube `[0, 1]^m`, and on the cube the polynomial functions form a point-separating
subalgebra of bounded continuous functions, which determines finite measures (Mathlib's
`ext_of_forall_mem_subalgebra_integral_eq_of_pseudoEMetric_complete_countable`).

This is the step "Its law must be stationary … The Markov transition kernels then force all its
finite-dimensional laws to agree with those of the two-sided stationary diffusion" of the
uniqueness argument in the proof of Theorem 2.2 (Specification p. 24, `source/spec/p001-048.md`
L546), proved for every process solving the martingale problem on `ℝ`, without transition kernels.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology BoundedContinuousFunction

namespace InteractingSLE

namespace Sec2

namespace Jacobi

/-- The unit cube `[0, 1]^m`. -/
def cube (m : ℕ) : Set (Fin m → ℝ) := {x | ∀ i, x i ∈ Icc (0 : ℝ) 1}

theorem isClosed_cube (m : ℕ) : IsClosed (cube m) := by
  simp only [cube, ofPred_forall]
  exact isClosed_iInter fun i => isClosed_Icc.preimage (continuous_apply i)

instance (m : ℕ) : CompleteSpace (cube m) := (isClosed_cube m).completeSpace_coe

/-- The coordinate functions on the cube, as bounded continuous functions. -/
def coordB {m : ℕ} (i : Fin m) : cube m →ᵇ ℝ :=
  mkOfBound ⟨fun x => (x : Fin m → ℝ) i, (continuous_apply i).comp continuous_subtype_val⟩ 1
    fun x y => by
      have hx := x.2 i
      have hy := y.2 i
      simp only [ContinuousMap.coe_mk, Real.dist_eq, abs_le]
      constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

theorem coordB_apply {m : ℕ} (i : Fin m) (x : cube m) : coordB i x = (x : Fin m → ℝ) i := rfl

theorem star_coordB {m : ℕ} (i : Fin m) : star (coordB i) = coordB i := by
  ext x
  simp [coordB_apply]

/-- Every element of the monoid generated by the coordinates is a monomial `∏ x_i^{k_i}`. -/
theorem exists_monomial_of_mem_closure {m : ℕ} {g : cube m →ᵇ ℝ}
    (hg : g ∈ Submonoid.closure (range (coordB (m := m)))) :
    ∃ k : Fin m → ℕ, ∀ x : cube m, g x = ∏ i, (x : Fin m → ℝ) i ^ k i := by
  induction hg using Submonoid.closure_induction with
  | mem g hg =>
    obtain ⟨j, rfl⟩ := hg
    refine ⟨Pi.single j 1, fun x => ?_⟩
    simp only [coordB_apply, Pi.single_apply, pow_ite, pow_one, pow_zero]
    rw [Finset.prod_ite_eq' Finset.univ j]
    simp
  | one => exact ⟨0, fun x => by simp⟩
  | mul g h _ _ hg hh =>
    obtain ⟨k, hk⟩ := hg
    obtain ⟨l, hl⟩ := hh
    refine ⟨k + l, fun x => ?_⟩
    simp only [BoundedContinuousFunction.coe_mul, Pi.mul_apply, hk, hl, Pi.add_apply, pow_add,
      Finset.prod_mul_distrib]

variable {Ω : Type*} [MeasurableSpace Ω] {Ω' : Type*} [MeasurableSpace Ω'] {κ a b : ℝ}
  {P : Measure Ω} [IsProbabilityMeasure P] {U : ℝ → Ω → ℝ}
  {P' : Measure Ω'} [IsProbabilityMeasure P'] {U' : ℝ → Ω' → ℝ}

/-- **Uniqueness in law of the stationary Jacobi process**: two solutions of the Jacobi martingale
problem on `ℝ` with the same parameters (`κ ≥ 0`, `a + b > 0`), on any probability spaces, have the
same finite-dimensional laws. -/
theorem IsJacobiMP.map_eq (hU : IsJacobiMP κ a b P U) (hU' : IsJacobiMP κ a b P' U')
    (hκ : 0 ≤ κ) (hab : 0 < a + b) {m : ℕ} (t : Fin m → ℝ) :
    P.map (fun ω i => U (t i) ω) = P'.map (fun ω i => U' (t i) ω) := by
  set V : Ω → cube m := fun ω => ⟨fun i => U (t i) ω, fun i => hU.mem_Icc _ _⟩ with hVdef
  set V' : Ω' → cube m := fun ω => ⟨fun i => U' (t i) ω, fun i => hU'.mem_Icc _ _⟩ with hV'def
  have hV : Measurable V := (Measurable.of_eval fun i => hU.measurable (t i)).subtype_mk
  have hV' : Measurable V' := (Measurable.of_eval fun i => hU'.measurable (t i)).subtype_mk
  have hμ : P.map V = P'.map V' := by
    refine ext_of_forall_mem_subalgebra_integral_eq_of_pseudoEMetric_complete_countable (𝕜 := ℝ)
      (A := StarAlgebra.adjoin ℝ (range (coordB (m := m)))) ?_ ?_
    · intro x y hxy
      obtain ⟨i, hi⟩ : ∃ i, (x : Fin m → ℝ) i ≠ (y : Fin m → ℝ) i := by
        by_contra h
        exact hxy (Subtype.ext (funext fun i => not_not.1 fun hi => h ⟨i, hi⟩))
      refine ⟨coordB i, ?_, hi⟩
      simp only [StarSubalgebra.coe_toSubalgebra, StarSubalgebra.coe_map, mem_image,
        SetLike.mem_coe, exists_exists_and_eq_and]
      exact ⟨coordB i, StarAlgebra.subset_adjoin ℝ _ ⟨i, rfl⟩, rfl⟩
    · intro g hg
      have hs : star (range (coordB (m := m))) = range coordB := by
        ext f
        simp only [mem_star, mem_range]
        constructor
        · rintro ⟨i, hi⟩
          exact ⟨i, by rw [← star_coordB, hi, star_star]⟩
        · rintro ⟨i, rfl⟩
          exact ⟨i, star_coordB i⟩
      have hg' : g ∈ Subalgebra.toSubmodule (Algebra.adjoin ℝ (range (coordB (m := m)))) := by
        have : g ∈ (StarAlgebra.adjoin ℝ (range (coordB (m := m)))).toSubalgebra := hg
        rwa [StarAlgebra.adjoin_toSubalgebra, hs, union_self] at this
      rw [Algebra.adjoin_eq_span] at hg'
      clear hg
      induction hg' using Submodule.span_induction with
      | mem g hg =>
        obtain ⟨k, hk⟩ := exists_monomial_of_mem_closure hg
        rw [integral_map hV.aemeasurable g.continuous.aestronglyMeasurable,
          integral_map hV'.aemeasurable g.continuous.aestronglyMeasurable]
        simp only [hk, hVdef, hV'def]
        exact hU.integral_prodPow_eq hU' hκ hab m t k
      | zero => simp
      | add f g _ _ hf hg =>
        simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
        rw [integral_add (f.integrable _) (g.integrable _), integral_add (f.integrable _)
          (g.integrable _), hf, hg]
      | smul c f _ hf =>
        simp only [BoundedContinuousFunction.coe_smul, smul_eq_mul]
        rw [integral_const_mul, integral_const_mul, hf]
  have e : (fun ω i => U (t i) ω) = Subtype.val ∘ V := rfl
  have e' : (fun ω i => U' (t i) ω) = Subtype.val ∘ V' := rfl
  rw [e, e', ← Measure.map_map measurable_subtype_coe hV, ← Measure.map_map measurable_subtype_coe hV',
    hμ]

end Jacobi

end Sec2

end InteractingSLE
