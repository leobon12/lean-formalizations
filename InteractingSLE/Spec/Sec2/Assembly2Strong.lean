namespace IsIntegratedSLEPath

variable {a : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {w w' : ℝ≥0 → ℝ} {vL vL' : Fin nL → ℝ≥0 → ℝ} {vR vR' : Fin nR → ℝ≥0 → ℝ}
  {b b' : ℝ≥0 → ℝ} {ζ ζ' : ℝ≥0∞}

/-- **Solutions only see the past of the driving path.** For a separated word, two solutions
driven by paths that agree on `[0, s]` have, at every `r ≤ s`, the same aliveness and the same
state. -/
theorem killed_agree_of_eqOn (hsep : ∀ i j, xL i < xR j)
    (h : IsIntegratedSLEPath a xL xR ρL ρR w vL vR b ζ)
    (h' : IsIntegratedSLEPath a xL xR ρL ρR w' vL' vR' b' ζ') {s : ℝ≥0}
    (hb : ∀ r ≤ s, b r = b' r) {r : ℝ≥0} (hr : r ≤ s) :
    ((r : ℝ≥0∞) < ζ ↔ (r : ℝ≥0∞) < ζ') ∧ ((r : ℝ≥0∞) < ζ →
      w r = w' r ∧ (∀ i, vL i r = vL' i r) ∧ ∀ j, vR j r = vR' j r) := by
  have hp := h.isForcePath
  have hp' := h'.isForcePath
  have hu : IsSLEPathUpTo a xL xR ρL ρR w vL vR b (min ζ s) := h.isSLEPathUpTo (min_le_left _ _)
  have hu' : IsSLEPathUpTo a xL xR ρL ρR w' vL' vR' b (min ζ' s) :=
    (h'.isSLEPathUpTo (min_le_left _ _)).congr_b fun t ht =>
      hb t (by exact_mod_cast (lt_of_lt_of_le ht (min_le_right _ _)).le)
  have hag : ∀ t : ℝ≥0, (t : ℝ≥0∞) < min ζ (min ζ' s) →
      w t = w' t ∧ (∀ i, vL i t = vL' i t) ∧ ∀ j, vR j t = vR' j t := by
    intro t ht
    have ht' : (t : ℝ≥0∞) < min (min ζ s) (min ζ' s) := by
      refine lt_min (lt_min (lt_of_lt_of_le ht (min_le_left _ _)) ?_) (lt_of_lt_of_le ht
        (min_le_right _ _))
      exact lt_of_lt_of_le ht ((min_le_right _ _).trans (min_le_right _ _))
    exact UpTo.agree_of_lt_min hsep hu hu.driverEq hu' hu'.driverEq ht'
  have hrs : (r : ℝ≥0∞) ≤ s := by exact_mod_cast hr
  have hlife : (r : ℝ≥0∞) < ζ ↔ (r : ℝ≥0∞) < ζ' := by
    constructor
    · intro hrζ
      by_contra hn
      rw [not_lt] at hn
      refine hp.not_lt_of_agree hp' (lt_of_le_of_lt hn hrζ) fun t ht => hag t ?_
      exact lt_min (lt_trans ht (lt_of_le_of_lt hn hrζ)) (lt_min ht (lt_of_lt_of_le ht
        (hn.trans hrs)))
    · intro hrζ'
      by_contra hn
      rw [not_lt] at hn
      refine hp'.not_lt_of_agree hp (lt_of_le_of_lt hn hrζ') fun t ht => ?_
      obtain ⟨e1, e2, e3⟩ := hag t (lt_min ht (lt_min (lt_trans ht (lt_of_le_of_lt hn hrζ'))
        (lt_of_lt_of_le ht (hn.trans hrs))))
      exact ⟨e1.symm, fun i => (e2 i).symm, fun j => (e3 j).symm⟩
  refine ⟨hlife, fun hrζ => ?_⟩
  have hrζ' := hlife.1 hrζ
  rcases lt_or_eq_of_le hr with hlt | heq
  · exact hag r (lt_min hrζ (lt_min hrζ' (by exact_mod_cast hlt)))
  · subst heq
    rcases eq_or_lt_of_le (zero_le : (0 : ℝ≥0) ≤ r) with h0 | h0
    · rw [← h0]
      exact ⟨by rw [hp.w_zero, hp'.w_zero], fun i => by rw [hp.vL_zero, hp'.vL_zero],
        fun j => by rw [hp.vR_zero, hp'.vR_zero]⟩
    · have hsub : ∀ {ξ : ℝ≥0∞}, (r : ℝ≥0∞) < ξ → Iic r ⊆ {t : ℝ≥0 | (t : ℝ≥0∞) < ξ} :=
        fun hξ t ht => lt_of_le_of_lt (by exact_mod_cast ht) hξ
      have hbef : ∀ t < r, w t = w' t ∧ (∀ i, vL i t = vL' i t) ∧ ∀ j, vR j t = vR' j t :=
        fun t ht => hag t (lt_min (lt_trans (by exact_mod_cast ht) hrζ)
          (lt_min (lt_trans (by exact_mod_cast ht) hrζ') (by exact_mod_cast ht)))
      refine ⟨Assembly.eq_of_eqOn_Iio h0 (hp.continuousOn_w.mono (hsub hrζ))
          (hp'.continuousOn_w.mono (hsub hrζ')) fun t ht => (hbef t ht).1, fun i => ?_,
        fun j => ?_⟩
      · exact Assembly.eq_of_eqOn_Iio h0 ((hp.continuousOn_vL i).mono (hsub hrζ))
          ((hp'.continuousOn_vL i).mono (hsub hrζ')) fun t ht => (hbef t ht).2.1 i
      · exact Assembly.eq_of_eqOn_Iio h0 ((hp.continuousOn_vR j).mono (hsub hrζ))
          ((hp'.continuousOn_vR j).mono (hsub hrζ')) fun t ht => (hbef t ht).2.2 j

end IsIntegratedSLEPath

namespace Sec2

namespace Assembly2

open Assembly QuantumZipper.RS

variable {nL nR : ℕ} {a : ℝ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ}

/-! ### The solution map -/

/-- The driving-code projection on canonical solution codes. -/
def solProj (a : ℝ) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) :
    CRel a xL xR ρL ρR → PCode := fun c => c.1.1

/-- **Lusin–Souslin**: for a separated word the projection is a measurable embedding. -/
theorem measurableEmbedding_solProj (hsep : ∀ i j, xL i < xR j) :
    MeasurableEmbedding (solProj a xL xR ρL ρR) := by
  have := (measurableSet_cRel a xL xR ρL ρR).standardBorel
  exact Measurable.measurableEmbedding (measurable_fst.comp measurable_subtype_coe)
    fun c c' h => Subtype.ext (injOn_fst_cRel hsep c.2 c'.2 h)

/-- The canonical solution code of a driving code (`0` if there is none). -/
def solCode (a : ℝ) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) :
    PCode → XCode nL nR :=
  Function.extend (solProj a xL xR ρL ρR) Subtype.val fun _ => 0

theorem measurable_solCode (hsep : ∀ i j, xL i < xR j) :
    Measurable (solCode a xL xR ρL ρR) :=
  (measurableEmbedding_solProj hsep).measurable_extend measurable_subtype_coe measurable_const

theorem solCode_of_mem (hsep : ∀ i j, xL i < xR j) {c : XCode nL nR}
    (hc : c ∈ CRel a xL xR ρL ρR) : solCode a xL xR ρL ρR c.1 = c :=
  (measurableEmbedding_solProj hsep).injective.extend_apply _ _ ⟨c, hc⟩

theorem measurableSet_image_fst_cRel (hsep : ∀ i j, xL i < xR j) :
    MeasurableSet (Prod.fst '' CRel a xL xR ρL ρR) :=
  (measurableSet_cRel a xL xR ρL ρR).image_of_measurable_injOn measurable_fst (injOn_fst_cRel hsep)

/-- The solution code of a continuous path. -/
def cOf (a : ℝ) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ)
    (f : CPath) : XCode nL nR :=
  solCode a xL xR ρL ρR (encC f)

/-- The paths that drive a solution. -/
def solGood (a : ℝ) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) :
    Set CPath :=
  encC ⁻¹' (Prod.fst '' CRel a xL xR ρL ρR)

theorem measurableSet_solGood (hsep : ∀ i j, xL i < xR j) :
    MeasurableSet (solGood a xL xR ρL ρR) :=
  (measurableSet_image_fst_cRel hsep).preimage measurable_encC

theorem cOf_mem (hsep : ∀ i j, xL i < xR j) {f : CPath} (hf : f ∈ solGood a xL xR ρL ρR) :
    cOf a xL xR ρL ρR f ∈ CRel a xL xR ρL ρR ∧ (cOf a xL xR ρL ρR f).1 = encC f := by
  obtain ⟨c, hc, hc1⟩ := hf
  have e : cOf a xL xR ρL ρR f = c := by
    unfold cOf; rw [← hc1]; exact solCode_of_mem hsep hc
  rw [e]; exact ⟨hc, hc1⟩

theorem cb_cOf (hsep : ∀ i j, xL i < xR j) {f : CPath} (hf : f ∈ solGood a xL xR ρL ρR) :
    cb (cOf a xL xR ρL ρR f) = f.1 := by
  funext t
  show dec (cOf a xL xR ρL ρR f).1 t = f.1 t
  rw [(cOf_mem hsep hf).2]
  exact dec_enc f.2.continuousWithinAt

theorem isIntegratedSLEPath_cOf (hsep : ∀ i j, xL i < xR j) {f : CPath}
    (hf : f ∈ solGood a xL xR ρL ρR) :
    IsIntegratedSLEPath a xL xR ρL ρR (cw (cOf a xL xR ρL ρR f)) (cvL (cOf a xL xR ρL ρR f))
      (cvR (cOf a xL xR ρL ρR f)) (fun t => canonBM t f) (cζ (cOf a xL xR ρL ρR f)) := by
  have h := (cOf_mem hsep hf).1.1.2.2
  rw [cb_cOf hsep hf] at h
  exact h

/-! ### The filtration generated by the solution -/

/-- The observation at time `r`: the driving path, aliveness and the killed state. -/
def solObs (a : ℝ) (xL : Fin nL → ℝ) (xR : Fin nR → ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ)
    (r : ℝ≥0) (f : CPath) : ℝ × ℝ × (ℝ × (Fin nL → ℝ) × (Fin nR → ℝ)) :=
  (canonBM r f, if (r : ℝ≥0∞) < cζ (cOf a xL xR ρL ρR f) then
    ((1 : ℝ), (cw (cOf a xL xR ρL ρR f) r, fun i => cvL (cOf a xL xR ρL ρR f) i r,
      fun j => cvR (cOf a xL xR ρL ρR f) j r)) else (0, (0, 0, 0)))

theorem measurable_solObs (hsep : ∀ i j, xL i < xR j) (r : ℝ≥0) :
    Measurable (solObs a xL xR ρL ρR r) := by
  have hc := (measurable_solCode (a := a) (xL := xL) (xR := xR) (ρL := ρL) (ρR := ρR) hsep).comp
    measurable_encC
  refine (measurable_canonBM r).prodMk (Measurable.ite ?_ ?_ measurable_const)
  · exact measurableSet_lt measurable_const (measurable_cζ.comp hc)
  · exact measurable_const.prodMk (((measurable_cw_at r).comp hc).prodMk
      ((measurable_pi_iff.2 fun i => (measurable_cvL_at i r).comp hc).prodMk
        (measurable_pi_iff.2 fun j => (measurable_cvR_at j r).comp hc)))

/-- The filtration generated by the driving path and the killed solution. -/
def solFiltration (hsep : ∀ i j, xL i < xR j) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace CPath) where
  seq t := ⨆ (r : ℝ≥0) (_ : r ≤ t),
    MeasurableSpace.comap (solObs a xL xR ρL ρR r) inferInstance
  mono' _ _ hst := iSup₂_mono' fun r hr => ⟨r, hr.trans hst, le_rfl⟩
  le' _ := iSup₂_le fun r _ => (measurable_solObs hsep r).comap_le

theorem comap_solObs_le (hsep : ∀ i j, xL i < xR j) {r t : ℝ≥0} (hrt : r ≤ t) :
    MeasurableSpace.comap (solObs a xL xR ρL ρR r) inferInstance ≤
      solFiltration (a := a) (ρL := ρL) (ρR := ρR) hsep t :=
  le_iSup₂ (f := fun (r : ℝ≥0) (_ : r ≤ t) =>
    MeasurableSpace.comap (solObs a xL xR ρL ρR r) inferInstance) r hrt

/-- **Every event of the solution filtration at `s` is saturated at `s` on the good paths.** -/
theorem solFiltration_le_satSpace (hsep : ∀ i j, xL i < xR j) (s : ℝ≥0) :
    solFiltration (a := a) (ρL := ρL) (ρR := ρR) hsep s ≤ satSpace s (solGood a xL xR ρL ρR) := by
  refine iSup₂_le fun r hr => ?_
  rw [MeasurableSpace.comap_le_iff_le_map]
  intro S hS
  refine ⟨measurable_solObs hsep r hS, fun f hf f' hf' hag hfS => ?_⟩
  have key := (isIntegratedSLEPath_cOf hsep hf).killed_agree_of_eqOn hsep
    (isIntegratedSLEPath_cOf hsep hf') (s := s) (fun t ht => hag t ht) hr
  have e : solObs a xL xR ρL ρR r f = solObs a xL xR ρL ρR r f' := by
    unfold solObs
    rw [show canonBM r f = canonBM r f' from hag r hr]
    by_cases hlt : (r : ℝ≥0∞) < cζ (cOf a xL xR ρL ρR f)
    · have hlt' := key.1.1 hlt
      obtain ⟨e1, e2, e3⟩ := key.2 hlt
      simp only [hlt, hlt', ↓reduceIte, e1, e2, e3]
    · have hlt' : ¬ (r : ℝ≥0∞) < cζ (cOf a xL xR ρL ρR f') := fun h => hlt (key.1.2 h)
      simp only [hlt, hlt', ↓reduceIte]
  show solObs a xL xR ρL ρR r f' ∈ S
  rw [← e]; exact hfS

end Assembly2

end Sec2

open Sec2 Sec2.Assembly Sec2.Assembly2 QuantumZipper.RS

/-- **Theorem 2.2, existence, from almost-sure solvability (Yamada–Watanabe).** For a separated
force word, if Wiener-almost every continuous path drives a solution of Definition 2.1, then an
integrated `SLE_a(ρ)` evolution exists (the frozen conclusion of `exists_isIntegratedSLEEvolution`):
on `CPath` with the Wiener measure, driven by the coordinate process, with the strong solution and
the filtration it generates. -/
theorem exists_isIntegratedSLEEvolution_of_ae_mem {a : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ}
    {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} (hsep : ∀ i j, xL i < xR j)
    {μ : Measure CPath} [IsProbabilityMeasure μ] (hμ : IsBrownianReal canonBM μ)
    (hae : ∀ᵐ f ∂μ, encC f ∈ Prod.fst '' CRel a xL xR ρL ρR) :
    ∃ (Ω : Type) (mΩ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
      (VR : Fin nR → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞),
      IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ := by
  set G := solGood a xL xR ρL ρR
  have hGm : MeasurableSet G := measurableSet_solGood hsep
  have hGμ : μ Gᶜ = 0 := by rw [← ae_iff.1 hae]; rfl
  set 𝓕 := solFiltration (a := a) (ρL := ρL) (ρR := ρR) hsep
  set c := cOf a xL xR ρL ρR
  refine ⟨CPath, inferInstance, μ, inferInstance, 𝓕, fun t f => cw (c f) t,
    fun i t f => cvL (c f) i t, fun j t f => cvR (c f) j t, canonBM, fun f => cζ (c f),
    ⟨hμ, fun t => ?_, fun s t hst => ?_⟩, ?_, fun i => ?_, fun j => ?_, ?_⟩
  · -- `B` is adapted
    have : Measurable[MeasurableSpace.comap (solObs a xL xR ρL ρR t) inferInstance]
        (canonBM t) := measurable_fst.comp (Measurable.of_comap_le le_rfl)
    exact this.mono (comap_solObs_le hsep le_rfl) le_rfl
  · -- independent increments
    exact indep_increment_of_le_satSpace hμ.toIsPreBrownianReal hst hGm hGμ
      (solFiltration_le_satSpace hsep s)
  · intro t A hA
    refine comap_solObs_le hsep le_rfl _ ⟨{y | y.2.1 = 1 ∧ y.2.2.1 ∈ A}, ?_, ?_⟩
    · exact (measurableSet_eq_fun (measurable_fst.comp measurable_snd) measurable_const).inter
        (hA.preimage (measurable_fst.comp (measurable_snd.comp measurable_snd)))
    · ext f
      simp only [solObs, mem_preimage, mem_ofPred_eq]
      split_ifs with h <;> simp [c, h]
  · intro t A hA
    refine comap_solObs_le hsep le_rfl _ ⟨{y | y.2.1 = 1 ∧ y.2.2.2.1 i ∈ A}, ?_, ?_⟩
    · exact (measurableSet_eq_fun (measurable_fst.comp measurable_snd) measurable_const).inter
        (hA.preimage ((measurable_pi_apply i).comp
          (measurable_fst.comp (measurable_snd.comp (measurable_snd.comp measurable_snd)))))
    · ext f
      simp only [solObs, mem_preimage, mem_ofPred_eq]
      split_ifs with h <;> simp [c, h]
  · intro t A hA
    refine comap_solObs_le hsep le_rfl _ ⟨{y | y.2.1 = 1 ∧ y.2.2.2.2 j ∈ A}, ?_, ?_⟩
    · exact (measurableSet_eq_fun (measurable_fst.comp measurable_snd) measurable_const).inter
        (hA.preimage ((measurable_pi_apply j).comp
          (measurable_snd.comp (measurable_snd.comp (measurable_snd.comp measurable_snd)))))
    · ext f
      simp only [solObs, mem_preimage, mem_ofPred_eq]
      split_ifs with h <;> simp [c, h]
  · filter_upwards [hae] with f hf
    exact isIntegratedSLEPath_cOf hsep hf

end InteractingSLE
