namespace IsSLEPathUpTo

variable {a : ℝ} {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {w : ℝ≥0 → ℝ} {vL : Fin nL → ℝ≥0 → ℝ} {vR : Fin nR → ℝ≥0 → ℝ}
  {b b' : ℝ≥0 → ℝ} {τ : ℝ≥0∞}

/-- A local solution only sees the driving path before its horizon. -/
theorem congr_b (h : IsSLEPathUpTo a xL xR ρL ρR w vL vR b' τ)
    (hb : ∀ t : ℝ≥0, (t : ℝ≥0∞) < τ → b t = b' t) : IsSLEPathUpTo a xL xR ρL ρR w vL vR b τ :=
  { h with w_eq := fun {t} ht => by rw [h.w_eq ht, hb t ht] }

end IsSLEPathUpTo

namespace IsForcePath

variable {nL nR : ℕ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {w w' : ℝ≥0 → ℝ} {vL vL' : Fin nL → ℝ≥0 → ℝ} {vR vR' : Fin nR → ℝ≥0 → ℝ}
  {ζ ζ' : ℝ≥0∞}

/-- A solution cannot die before another one that agrees with it up to its lifetime. -/
theorem not_lt_of_agree (hp : IsForcePath xL xR ρL ρR w vL vR ζ)
    (hp' : IsForcePath xL xR ρL ρR w' vL' vR' ζ') (hlt : ζ' < ζ)
    (hag : ∀ t : ℝ≥0, (t : ℝ≥0∞) < ζ' →
      w t = w' t ∧ (∀ i, vL i t = vL' i t) ∧ ∀ j, vR j t = vR' j t) : False := by
  have hfin : ζ' ≠ ⊤ := ne_top_of_lt hlt
  set T := ζ'.toNNReal with hTdef
  have hT : (T : ℝ≥0∞) = ζ' := ENNReal.coe_toNNReal hfin
  have hTζ : (T : ℝ≥0∞) < ζ := by rw [hT]; exact hlt
  rcases eq_or_lt_of_le (zero_le : (0 : ℝ≥0) ≤ T) with h0 | h0
  · have hz : ζ' = 0 := by rw [← hT, ← h0]; rfl
    have hthr := hp'.threshold_of_eq_zero hz
    have hnt := hp.not_threshold (t := 0) (by rw [← h0] at hTζ; exact_mod_cast hTζ)
    rw [hp.w_zero] at hnt
    have e1 : (fun i => vL i 0) = xL := funext hp.vL_zero
    have e2 : (fun j => vR j 0) = xR := funext hp.vR_zero
    rw [e1, e2] at hnt
    exact hnt hthr
  · have hopen : IsOpen {t : ℝ≥0 | (t : ℝ≥0∞) < ζ} := isOpen_lt ENNReal.continuous_coe
      continuous_const
    have hca : ∀ {f : ℝ≥0 → ℝ}, ContinuousOn f {t | (t : ℝ≥0∞) < ζ} → ContinuousAt f T :=
      fun hf => hf.continuousAt (hopen.mem_nhds hTζ)
    have hcont : ContinuousAt (fun t => (w t, fun i => vL i t, fun j => vR j t)) T :=
      (hca hp.continuousOn_w).prodMk ((continuousAt_pi.2 fun i => hca (hp.continuousOn_vL i)).prodMk
        (continuousAt_pi.2 fun j => hca (hp.continuousOn_vR j)))
    have hlim : Tendsto (fun t => (w' t, fun i => vL' i t, fun j => vR' j t)) (𝓝[<] T)
        (𝓝 (w T, fun i => vL i T, fun j => vR j T)) := by
      refine (hcont.tendsto.mono_left nhdsWithin_le_nhds).congr' ?_
      filter_upwards [self_mem_nhdsWithin] with t ht
      obtain ⟨e1, e2, e3⟩ := hag t (by rw [← hT]; exact_mod_cast ht)
      simp only [e1, e2, e3]
    exact hp.not_threshold hTζ (hp'.threshold_of_tendsto h0 hT hlim)

end IsForcePath

end Sec2

