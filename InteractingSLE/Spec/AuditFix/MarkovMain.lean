import InteractingSLE.Spec.AuditFix.MarkovRestart
import InteractingSLE.Spec.AuditFix.MarkovZero

/-!
# Theorem 2.2, the Markov sentence: the strong Markov property at every finite stopping time

Packet PROVE-AF-MARKOV. Split an event `A ∈ 𝓕_T` inside `{T < ζ}` along `{T = 0}`:

* on `A ∩ {T > 0}` the state at `T` is separated, and the restart identity for the full state
  (`measure_restart_state`) applies, with `Q = shiftKer` there (`markovKer_of_sep`);
* `A ∩ {T = 0}` belongs to `𝓕₀`; there the future is the evolution itself, which is independent of `𝓕₀`
  (`measure_inter_killedState`), and `Q` at the initial state `(0, xL, xR, 0)` is its law (`markovKer_eq`).

Results:

* **`measure_markov`**: the strong Markov property of the state `X = (W, V^L, V^R, B)`, for every finite stopping
  time and every `A ∈ 𝓕_T` with `T < ζ` on `A`, with no restriction to `T > 0` or separated words;
* `measure_markov_of_pos`: for `n ≥ 1`, every `A ∈ 𝓕_T` (the integral over `A ∩ {T < ζ}`; `{T < ζ} ∈ 𝓕_T`,
  `measurableSet_lt_lifetime`);
* **`measure_markov_increment`**: the same for the increments `(W_{T+·} − W_T, V_{T+·} − W_T, B_{T+·} − B_T)`, with
  the kernel `incrKer` of the relative word `V_T − W_T` (the landed restart law, extended to `T = 0`);
* `naturalSigma_le`: the σ-algebra generated by the killed state up to time `s` is contained in `𝓕_s`;
* `ae_continuousOn_state`: the state paths are continuous before the lifetime.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace AuditFix

namespace Markov

open Sec2 Sec2.Assembly Sec2.Restart

variable {nL nR : ℕ} {a : ℝ} {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ}
  {ρR : Fin nR → ℝ} {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
  {𝓕 : Filtration ℝ≥0 mΩ} {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ}
  {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}

/-! ### The event `{T = 0}` -/

theorem setOf_le_zero_eq {T : Ω → ℝ≥0} :
    {ω | (T ω : WithTop ℝ≥0) ≤ ((0 : ℝ≥0) : WithTop ℝ≥0)} = {ω | T ω = 0} := by
  ext ω
  simp only [mem_ofPred_eq, WithTop.coe_le_coe, nonpos_iff_eq_zero]

theorem measurableSet_eq_zero {T : Ω → ℝ≥0}
    (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) :
    MeasurableSet[hT.measurableSpace] {ω | T ω = 0} := by
  have h := hT.measurableSet_le' 0
  rwa [setOf_le_zero_eq] at h

theorem measurableSet_inter_eq_zero {T : Ω → ℝ≥0}
    (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) {A : Set Ω}
    (hA : MeasurableSet[hT.measurableSpace] A) : MeasurableSet[𝓕 0] (A ∩ {ω | T ω = 0}) := by
  have h := ((hT.measurableSet A).1 hA).2 0
  rwa [setOf_le_zero_eq] at h

/-- On `A ∩ {T = 0}` with `A ⊆ {T < ζ}` of positive probability, the word is ordered. -/
theorem isOrderedForceWord_of_measure_ne_zero
    (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) {T : Ω → ℝ≥0} {A : Set Ω}
    (hAT : ∀ ω ∈ A, (T ω : ℝ≥0∞) < ζ ω) (hP0 : P (A ∩ {ω | T ω = 0}) ≠ 0) :
    IsOrderedForceWord xL xR := by
  by_contra hno
  apply hP0
  have hnull : P {ω | ¬ IsIntegratedSLEPath a xL xR ρL ρR (fun t => W t ω) (fun i t => VL i t ω)
      (fun j t => VR j t ω) (fun t => B t ω) (ζ ω)} = 0 := ae_iff.1 hE.2.2.2.2
  refine measure_mono_null ?_ hnull
  intro ω hω hp
  apply hno
  have h0 := hAT ω hω.1
  rw [show T ω = 0 from hω.2] at h0
  exact isOrderedForceWord_of_path hp h0

/-! ### The strong Markov property of the full state -/

/-- **The strong Markov property of the state `(W, V^L, V^R, B)`.** For an integrated evolution, every finite
stopping time `T` of its filtration and every `A ∈ 𝓕_T` with `T < ζ` on `A`,
`P(A ∩ {t_j < ζ − T, X_{T+t_j} ∈ K_j for all j}) = ∫_A Q(X_T) dP`. -/
theorem measure_markov (ha : 0 < a) (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ)
    {T : Ω → ℝ≥0} (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) {A : Set Ω}
    (hA : MeasurableSet[hT.measurableSpace] A) (hAT : ∀ ω ∈ A, (T ω : ℝ≥0∞) < ζ ω)
    {n : ℕ} (ts : Fin n → ℝ≥0) {K : Fin n → Set (State nL nR)} (hK : ∀ j, MeasurableSet (K j)) :
    P (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
        (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
          B (T ω + ts j) ω) ∈ K j}) =
      ∫⁻ ω in A, markovKer a ρL ρR n ts K (W (T ω) ω, (fun i => VL i (T ω) ω),
        (fun i => VR i (T ω) ω), B (T ω) ω) ∂P := by
  have hP : IsProbabilityMeasure P := hE.1.isProbabilityMeasure'
  have hAm : MeasurableSet A := hT.measurableSpace_le _ hA
  have hZT := measurableSet_eq_zero hT
  have hZ : MeasurableSet {ω | T ω = 0} := hT.measurableSpace_le _ hZT
  rw [← measure_inter_add_sdiff _ hZ, ← lintegral_inter_add_sdiff _ A hZ]
  congr 1
  · -- `T = 0`: the future is the evolution itself, independent of `𝓕₀`
    have hA0 := measurableSet_inter_eq_zero hT hA
    have hset : (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
            B (T ω + ts j) ω) ∈ K j}) ∩ {ω | T ω = 0} =
        (A ∩ {ω | T ω = 0}) ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω ∧
          (W (ts j) ω, (fun i => VL i (ts j) ω), (fun i => VR i (ts j) ω), B (ts j) ω) ∈ K j} := by
      ext ω
      simp only [mem_inter_iff, mem_ofPred_eq]
      constructor
      · rintro ⟨⟨hωA, hω⟩, hT0⟩
        refine ⟨⟨hωA, hT0⟩, fun j => ?_⟩
        simpa only [hT0, ENNReal.coe_zero, tsub_zero, zero_add] using hω j
      · rintro ⟨⟨hωA, hT0⟩, hω⟩
        refine ⟨⟨hωA, fun j => ?_⟩, hT0⟩
        simpa only [hT0, ENNReal.coe_zero, tsub_zero, zero_add] using hω j
    rw [hset]
    by_cases hP0 : P (A ∩ {ω | T ω = 0}) = 0
    · rw [measure_mono_null inter_subset_left hP0, setLIntegral_measure_zero _ _ hP0]
    have hF := isOrderedForceWord_of_measure_ne_zero hE hAT hP0
    have hlaw := markovKer_eq ha (x := ((0 : ℝ), xL, xR, (0 : ℝ))) (relWord_zero xL xR) hF hE ts hK
    simp only [shiftState, zero_add] at hlaw
    have hconst : ∫⁻ ω in A ∩ {ω | T ω = 0}, markovKer a ρL ρR n ts K (W (T ω) ω,
        (fun i => VL i (T ω) ω), (fun i => VR i (T ω) ω), B (T ω) ω) ∂P =
        ∫⁻ _ in A ∩ {ω | T ω = 0}, markovKer a ρL ρR n ts K ((0 : ℝ), xL, xR, (0 : ℝ)) ∂P := by
      refine setLIntegral_congr_fun_ae (hAm.inter hZ) ?_
      filter_upwards [hE.2.2.2.2, hE.1.1.toIsPreBrownianReal.eval_zero_ae_eq_zero] with ω hp hb0 hω
      have hw0 : W 0 ω = 0 := hp.isForcePath.w_zero
      have hl0 : ∀ i, VL i 0 ω = xL i := hp.isForcePath.vL_zero
      have hr0 : ∀ j, VR j 0 ω = xR j := hp.isForcePath.vR_zero
      rw [show T ω = 0 from hω.2]
      simp only [hw0, hl0, hr0, hb0]
    rw [hconst, setLIntegral_const, hlaw, measure_inter_killedState ha hF hE hA0 ts hK, mul_comm]
  · -- `T > 0`: the state at `T` is separated; the restart identity for the full state
    have hAp : MeasurableSet[hT.measurableSpace] (A \ {ω | T ω = 0}) := hA.diff hZT
    have hATp : ∀ ω ∈ A \ {ω | T ω = 0}, (T ω : ℝ≥0∞) < ζ ω ∧ (0 < T ω ∨ ∀ i j, xL i < xR j) :=
      fun ω hω => ⟨hAT ω hω.1, Or.inl (pos_iff_ne_zero.2 hω.2)⟩
    have h := measure_restart_state ha hE hT hAp hATp ts hK
    have hset : (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
            B (T ω + ts j) ω) ∈ K j}) \ {ω | T ω = 0} =
        (A \ {ω | T ω = 0}) ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
            B (T ω + ts j) ω) ∈ K j} := by
      ext ω
      simp only [Set.mem_sdiff, mem_inter_iff]
      tauto
    rw [hset, h]
    refine setLIntegral_congr_fun_ae (hAm.diff hZ) ?_
    filter_upwards [hE.2.2.2.2] with ω hp hω
    have hsep : SepStart (relWord ((W (T ω) ω, (fun i => VL i (T ω) ω), (fun i => VR i (T ω) ω),
        B (T ω) ω) : State nL nR)) :=
      sepStart_restart hp (pos_iff_ne_zero.2 hω.2) (hAT ω hω.1)
    exact (markovKer_of_sep ts K hsep).symm

/-- `{T < ζ}` belongs to `𝓕_T` (the lifetime is a stopping time). -/
theorem measurableSet_lt_lifetime (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ)
    {T : Ω → ℝ≥0} (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) :
    MeasurableSet[hT.measurableSpace] {ω | (T ω : ℝ≥0∞) < ζ ω} := by
  have hζ := Ito.isStoppingTime_lifetime hE.2.1
  have h := (IsStoppingTime.measurableSet_stopping_time_le hζ hT).compl
  have e : {ω | (T ω : ℝ≥0∞) < ζ ω} =
      {ω | (ζ ω : WithTop ℝ≥0) ≤ (T ω : WithTop ℝ≥0)}ᶜ := by
    ext ω
    exact (not_le (α := ℝ≥0∞)).symm
  rw [e]
  exact h

/-- **The strong Markov property for every event of `𝓕_T`** (the killed-state convention): for `n ≥ 1` a future
event of the killed state is contained in `{T < ζ}`, so for every `A ∈ 𝓕_T`,
`P(A ∩ {t_j < ζ − T, X_{T+t_j} ∈ K_j for all j}) = ∫_{A ∩ {T < ζ}} Q(X_T) dP`. -/
theorem measure_markov_of_pos (ha : 0 < a)
    (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) {T : Ω → ℝ≥0}
    (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) {A : Set Ω}
    (hA : MeasurableSet[hT.measurableSpace] A) {n : ℕ} (hn : 0 < n) (ts : Fin n → ℝ≥0)
    {K : Fin n → Set (State nL nR)} (hK : ∀ j, MeasurableSet (K j)) :
    P (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
        (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
          B (T ω + ts j) ω) ∈ K j}) =
      ∫⁻ ω in A ∩ {ω | (T ω : ℝ≥0∞) < ζ ω}, markovKer a ρL ρR n ts K (W (T ω) ω,
        (fun i => VL i (T ω) ω), (fun i => VR i (T ω) ω), B (T ω) ω) ∂P := by
  have hA' : MeasurableSet[hT.measurableSpace] (A ∩ {ω | (T ω : ℝ≥0∞) < ζ ω}) :=
    hA.inter (measurableSet_lt_lifetime hE hT)
  have hset : (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
        (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
          B (T ω + ts j) ω) ∈ K j}) =
      (A ∩ {ω | (T ω : ℝ≥0∞) < ζ ω}) ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
        (W (T ω + ts j) ω, (fun i => VL i (T ω + ts j) ω), (fun i => VR i (T ω + ts j) ω),
          B (T ω + ts j) ω) ∈ K j} := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨⟨h1, ?_⟩, h2⟩
      exact tsub_pos_iff_lt.1 (lt_of_le_of_lt zero_le (h2 ⟨0, hn⟩).1)
    · rintro ⟨⟨h1, -⟩, h2⟩
      exact ⟨h1, h2⟩
  rw [hset]
  exact measure_markov ha hE hT hA' (fun ω hω => hω.2) ts hK

/-! ### The increments -/

open Classical in
/-- **The kernel of the increments**, a function of the relative word: on separated words the landed canonical
kernel `restartLaw`, elsewhere the reference law at the state `(0, xL, xR, 0)`. -/
def incrKer (a : ℝ) (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) (n : ℕ) (ts : Fin n → ℝ≥0)
    (K : Fin n → Set (State nL nR)) (s : (Fin nL → ℝ) × (Fin nR → ℝ)) : ℝ≥0∞ :=
  if SepStart s then restartLaw a ρL ρR ts K s else markovKer a ρL ρR n ts K ((0 : ℝ), s.1, s.2, (0 : ℝ))

/-- **`incrKer` is the killed-state law of every evolution from an ordered word.** -/
theorem incrKer_eq (ha : 0 < a) (hF : IsOrderedForceWord xL xR)
    (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) {n : ℕ} (ts : Fin n → ℝ≥0)
    {K : Fin n → Set (State nL nR)} (hK : ∀ j, MeasurableSet (K j)) :
    incrKer a ρL ρR n ts K (xL, xR) = P {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω ∧
      (W (ts j) ω, (fun i => VL i (ts j) ω), (fun i => VR i (ts j) ω), B (ts j) ω) ∈ K j} := by
  have := hE.1.isProbabilityMeasure'
  unfold incrKer
  split_ifs with hs
  · have hsep : ∀ i j, xL i < xR j := hs
    exact (measure_killedState_eq_restartLaw ha hsep hE ts hK).symm
  · have h := markovKer_eq ha (x := ((0 : ℝ), xL, xR, (0 : ℝ))) (relWord_zero xL xR) hF hE ts hK
    simp only [shiftState, zero_add] at h
    exact h

theorem measurable_incrKer_sep {n : ℕ} (ts : Fin n → ℝ≥0) {K : Fin n → Set (State nL nR)}
    (hK : ∀ j, MeasurableSet (K j)) :
    Measurable fun s : {s : (Fin nL → ℝ) × (Fin nR → ℝ) // ∀ i j, s.1 i < s.2 j} =>
      incrKer a ρL ρR n ts K s.1 := by
  have e : (fun s : {s : (Fin nL → ℝ) × (Fin nR → ℝ) // ∀ i j, s.1 i < s.2 j} =>
      incrKer a ρL ρR n ts K s.1) = fun s => restartLaw a ρL ρR ts K s.1 := by
    funext s
    have hs : SepStart s.1 := s.2
    rw [incrKer, ite_eq_left hs]
  rw [e]
  exact (measurable_restartLaw ts hK).comp measurable_subtype_coe

/-- **The strong Markov property of the increments**: the conditional law of
`(W_{T+·} − W_T, V_{T+·} − W_T, B_{T+·} − B_T)` given `𝓕_T` on `{T < ζ}` is the law from the relative word
`V_T − W_T`; the landed restart law, extended to `T = 0` for every word. -/
theorem measure_markov_increment (ha : 0 < a)
    (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) {T : Ω → ℝ≥0}
    (hT : IsStoppingTime 𝓕 fun ω => (T ω : WithTop ℝ≥0)) {A : Set Ω}
    (hA : MeasurableSet[hT.measurableSpace] A) (hAT : ∀ ω ∈ A, (T ω : ℝ≥0∞) < ζ ω)
    {n : ℕ} (ts : Fin n → ℝ≥0) {K : Fin n → Set (State nL nR)} (hK : ∀ j, MeasurableSet (K j)) :
    P (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
        (W (T ω + ts j) ω - W (T ω) ω, (fun i => VL i (T ω + ts j) ω - W (T ω) ω),
          (fun i => VR i (T ω + ts j) ω - W (T ω) ω), B (T ω + ts j) ω - B (T ω) ω) ∈ K j}) =
      ∫⁻ ω in A, incrKer a ρL ρR n ts K ((fun i => VL i (T ω) ω - W (T ω) ω),
        fun j => VR j (T ω) ω - W (T ω) ω) ∂P := by
  have hP : IsProbabilityMeasure P := hE.1.isProbabilityMeasure'
  have hAm : MeasurableSet A := hT.measurableSpace_le _ hA
  have hZT := measurableSet_eq_zero hT
  have hZ : MeasurableSet {ω | T ω = 0} := hT.measurableSpace_le _ hZT
  rw [← measure_inter_add_sdiff _ hZ, ← lintegral_inter_add_sdiff _ A hZ]
  congr 1
  · -- `T = 0`
    have hA0 := measurableSet_inter_eq_zero hT hA
    have hset : ((A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω - W (T ω) ω, (fun i => VL i (T ω + ts j) ω - W (T ω) ω),
            (fun i => VR i (T ω + ts j) ω - W (T ω) ω), B (T ω + ts j) ω - B (T ω) ω) ∈ K j}) ∩
            {ω | T ω = 0} : Set Ω) =ᵐ[P]
        (A ∩ {ω | T ω = 0}) ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω ∧
          (W (ts j) ω, (fun i => VL i (ts j) ω), (fun i => VR i (ts j) ω), B (ts j) ω) ∈ K j} := by
      filter_upwards [hE.2.2.2.2, hE.1.1.toIsPreBrownianReal.eval_zero_ae_eq_zero] with ω hp hb0
      have hw0 : W 0 ω = 0 := hp.isForcePath.w_zero
      refine propext ⟨?_, ?_⟩
      · rintro ⟨⟨hωA, hω⟩, hT0⟩
        refine ⟨⟨hωA, hT0⟩, fun j => ?_⟩
        have hT0' : T ω = 0 := hT0
        simpa only [hT0', ENNReal.coe_zero, tsub_zero, zero_add, hw0, hb0, sub_zero] using hω j
      · rintro ⟨⟨hωA, hT0⟩, hω⟩
        have hT0' : T ω = 0 := hT0
        refine ⟨⟨hωA, fun j => ?_⟩, hT0⟩
        simpa only [hT0', ENNReal.coe_zero, tsub_zero, zero_add, hw0, hb0, sub_zero] using hω j
    rw [measure_congr hset]
    by_cases hP0 : P (A ∩ {ω | T ω = 0}) = 0
    · rw [measure_mono_null inter_subset_left hP0, setLIntegral_measure_zero _ _ hP0]
    have hF := isOrderedForceWord_of_measure_ne_zero hE hAT hP0
    have hconst : ∫⁻ ω in A ∩ {ω | T ω = 0}, incrKer a ρL ρR n ts K
        ((fun i => VL i (T ω) ω - W (T ω) ω), fun j => VR j (T ω) ω - W (T ω) ω) ∂P =
        ∫⁻ _ in A ∩ {ω | T ω = 0}, incrKer a ρL ρR n ts K (xL, xR) ∂P := by
      refine setLIntegral_congr_fun_ae (hAm.inter hZ) ?_
      filter_upwards [hE.2.2.2.2] with ω hp hω
      have hw0 : W 0 ω = 0 := hp.isForcePath.w_zero
      have hl0 : ∀ i, VL i 0 ω = xL i := hp.isForcePath.vL_zero
      have hr0 : ∀ j, VR j 0 ω = xR j := hp.isForcePath.vR_zero
      rw [show T ω = 0 from hω.2]
      simp only [hw0, hl0, hr0, sub_zero]
    rw [hconst, setLIntegral_const, incrKer_eq ha hF hE ts hK,
      measure_inter_killedState ha hF hE hA0 ts hK, mul_comm]
  · -- `T > 0`: the landed restart law
    have hAp : MeasurableSet[hT.measurableSpace] (A \ {ω | T ω = 0}) := hA.diff hZT
    have hATp : ∀ ω ∈ A \ {ω | T ω = 0}, (T ω : ℝ≥0∞) < ζ ω ∧ (0 < T ω ∨ ∀ i j, xL i < xR j) :=
      fun ω hω => ⟨hAT ω hω.1, Or.inl (pos_iff_ne_zero.2 hω.2)⟩
    have h := measure_restart_killedState ha hE hT hAp hATp ts hK
    have hset : (A ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω - W (T ω) ω, (fun i => VL i (T ω + ts j) ω - W (T ω) ω),
            (fun i => VR i (T ω + ts j) ω - W (T ω) ω), B (T ω + ts j) ω - B (T ω) ω) ∈ K j}) \
            {ω | T ω = 0} =
        (A \ {ω | T ω = 0}) ∩ {ω | ∀ j, (ts j : ℝ≥0∞) < ζ ω - T ω ∧
          (W (T ω + ts j) ω - W (T ω) ω, (fun i => VL i (T ω + ts j) ω - W (T ω) ω),
            (fun i => VR i (T ω + ts j) ω - W (T ω) ω), B (T ω + ts j) ω - B (T ω) ω) ∈ K j} := by
      ext ω
      simp only [Set.mem_sdiff, mem_inter_iff]
      tauto
    rw [hset, h]
    refine setLIntegral_congr_fun_ae (hAm.diff hZ) ?_
    filter_upwards [hE.2.2.2.2] with ω hp hω
    have hsep : SepStart ((fun i => VL i (T ω) ω - W (T ω) ω), fun j => VR j (T ω) ω - W (T ω) ω) :=
      sepStart_restart hp (pos_iff_ne_zero.2 hω.2) (hAT ω hω.1)
    rw [incrKer, ite_eq_left hsep]

/-! ### The natural filtration and continuity -/

/-- Measurability of a state built from coordinates (over a general measurable space, to be used with the
σ-algebras of a filtration). -/
theorem measurable_state_aux {Ω' : Type*} [MeasurableSpace Ω'] {f : Ω' → ℝ} {gL : Fin nL → Ω' → ℝ}
    {gR : Fin nR → Ω' → ℝ} {h : Ω' → ℝ} (hf : Measurable f) (hL : ∀ i, Measurable (gL i))
    (hR : ∀ j, Measurable (gR j)) (hh : Measurable h) :
    Measurable fun ω => (f ω, (fun i => gL i ω), (fun j => gR j ω), h ω) :=
  hf.prodMk ((measurable_pi_iff.2 hL).prodMk ((measurable_pi_iff.2 hR).prodMk hh))

/-- The σ-algebra generated by the killed state `(W, V^L, V^R, B)` up to time `s` is contained in `𝓕_s`. -/
theorem naturalSigma_le (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) (s : ℝ≥0) :
    MeasurableSpace.generateFrom {E : Set Ω | ∃ r : ℝ≥0, r ≤ s ∧
      ∃ D : Set (ℝ × (Fin nL → ℝ) × (Fin nR → ℝ) × ℝ), MeasurableSet D ∧
        E = {ω | (r : ℝ≥0∞) < ζ ω ∧
          (W r ω, (fun i => VL i r ω), (fun i => VR i r ω), B r ω) ∈ D}} ≤ 𝓕 s := by
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨r, hr, D, hD, rfl⟩
  refine 𝓕.mono hr _ ?_
  have hlt : MeasurableSet[𝓕 r] {ω | (r : ℝ≥0∞) < ζ ω} := by
    simpa using hE.2.1 r univ MeasurableSet.univ
  have hY : Measurable[𝓕 r] fun ω => (Girsanov.killed ζ W r ω,
      (fun i => Girsanov.killed ζ (VL i) r ω), (fun j => Girsanov.killed ζ (VR j) r ω), B r ω) :=
    @measurable_state_aux nL nR Ω (𝓕 r) _ _ _ _ (Girsanov.measurable_killed hE.2.1 r)
      (fun i => Girsanov.measurable_killed (hE.2.2.1 i) r)
      (fun j => Girsanov.measurable_killed (hE.2.2.2.1 j) r) (hE.1.2.1 r)
  have e : {ω | (r : ℝ≥0∞) < ζ ω ∧
      (W r ω, (fun i => VL i r ω), (fun i => VR i r ω), B r ω) ∈ D} =
      {ω | (r : ℝ≥0∞) < ζ ω} ∩ (fun ω => (Girsanov.killed ζ W r ω,
        (fun i => Girsanov.killed ζ (VL i) r ω), (fun j => Girsanov.killed ζ (VR j) r ω),
        B r ω)) ⁻¹' D := by
    ext ω
    simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      simpa only [Girsanov.killed_of_lt h1] using h2
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      simpa only [Girsanov.killed_of_lt h1] using h2
  rw [e]
  exact hlt.inter (hY hD)

/-- The state paths `t ↦ (W_t, V_t, B_t)` are almost surely continuous before the lifetime. -/
theorem ae_continuousOn_state (hE : IsIntegratedSLEEvolution a xL xR ρL ρR P 𝓕 W VL VR B ζ) :
    ∀ᵐ ω ∂P, ContinuousOn (fun t => (W t ω, (fun i => VL i t ω), (fun i => VR i t ω), B t ω))
      {t | (t : ℝ≥0∞) < ζ ω} := by
  filter_upwards [hE.2.2.2.2, hE.1.1.cont] with ω hp hc
  have hfp := hp.isForcePath
  exact hfp.continuousOn_w.prodMk ((continuousOn_pi.2 hfp.continuousOn_vL).prodMk
    ((continuousOn_pi.2 hfp.continuousOn_vR).prodMk hc.continuousOn))

