/-!
# Conditional expectations at the stopping times of a usual augmentation from fixed times

Packet PROVE-LEMMA71D, item (2) (PROVE-LEMMA71C, "What remains" B). Lemma 7.1's coupling clause is obtained from
Lemma 6.2's history locality at fixed (path-functional) times of the raw filtration `𝓐` generated by the revealed
curves, while the named input `Lemma71C.Lemma71PocketCurveStatement` asks for it at every stopping time of a
right-continuous filtration. This file proves the generic transfer.

**Setting.** `𝓐` a filtration, `𝓖 = usualAugmentation 𝓐 P` (right-continuous, contains the null sets), `X ∈ L²`, a
predicted value `F t ω` and a validity event `E t` for each fixed time `t`. Suppose

* (fixed times) `E[X | 𝓐_t] = F t` almost surely on `E t`, for every `t`;
* (right-continuity) whenever `ω ∈ E t` and `sᵢ ↓ t` strictly, `ω ∈ E sᵢ` eventually and `F sᵢ ω → F t ω`.

Then for every stopping time `τ` of `𝓖`, almost surely on `{τ = t} ∩ E t`, `E[X | 𝓖_τ] = F t`
(`ae_condExp_stopping_eq_of_forall_const`, and `…_complex` for complex `X`).

**Proof.** The dyadic upper approximations `τₙ = (⌈2ⁿτ⌉ + 1)/2ⁿ` (`dyUp`) are stopping times of the null-augmented
filtration `𝓐⁰` (`{τₙ ≤ r} = ⋃_{(k+1)/2ⁿ ≤ r} {τ ≤ k/2ⁿ}` and `𝓖_{k/2ⁿ} ⊆ 𝓐⁰_{(k+1)/2ⁿ}`), decrease to `τ`
strictly from above, and their stopped σ-algebras `𝓗ₙ = 𝓐⁰_{τₙ}` decrease with `⋂ₙ 𝓗ₙ = 𝓖_τ` (right-continuity of `𝓖`;
`iInf_stoppedSigma_eq`). On `{τₙ = q}`, `E[X | 𝓗ₙ] = E[X | 𝓐⁰_q] = E[X | 𝓐_q] = F q` (Mathlib's localization of
conditional expectations; null sets do not change conditional expectations). By Lévy's downward theorem
(`Martingale.exists_seq_ae_tendsto_condExp_iInf`) `E[X | 𝓗ₙ] → E[X | 𝓖_τ]` almost surely along a subsequence, while
`F τₙ → F τ` by right-continuity. No measurability of `F` is needed: the limit identifies it.

## Main results

* `dyR`, `dyUp`: dyadic upper approximations; `isStoppingTime_dyUp`;
* `iInf_stoppedSigma_eq`: `⋂ₙ 𝓐⁰_{τₙ} = 𝓖_τ`;
* `condExp_nullAugmented_ae_eq`: `E[X | 𝓐_t ∨ 𝒩] = E[X | 𝓐_t]` almost surely;
* **`ae_condExp_stopping_eq_of_forall_const`** (real) and **`ae_condExp_stopping_eq_of_forall_const_complex`**.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

namespace Lemma71D

open Ito

/-! ### Dyadic upper approximations -/

section Dyadic

/-- The dyadic upper approximation `(⌈2ⁿ t⌉ + 1)/2ⁿ` of `t` at level `n`, strictly above `t`. -/
def dyR (n : ℕ) (t : ℝ≥0) : ℝ≥0 := ((⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 1) / 2 ^ n

theorem two_pow_pos_nnreal (n : ℕ) : (0 : ℝ≥0) < 2 ^ n := pow_pos two_pos n

theorem lt_dyR (n : ℕ) (t : ℝ≥0) : t < dyR n t := by
  rw [dyR, lt_div_iff₀ (two_pow_pos_nnreal n), mul_comm]
  exact (Nat.le_ceil _).trans_lt (lt_add_one _)

theorem dyR_le (n : ℕ) (t : ℝ≥0) : dyR n t ≤ t + 2 / 2 ^ n := by
  have hp := two_pow_pos_nnreal n
  rw [dyR, div_le_iff₀ hp, add_mul, div_mul_cancel₀ _ hp.ne', mul_comm t]
  have h : ((⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℕ) : ℝ≥0) < 2 ^ n * t + 1 := Nat.ceil_lt_add_one (by positivity)
  calc ((⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 1) ≤ (2 ^ n * t + 1) + 1 := add_le_add_left h.le 1
    _ = 2 ^ n * t + 2 := by rw [add_assoc, one_add_one_eq_two]

theorem dyR_succ_le (n : ℕ) (t : ℝ≥0) : dyR (n + 1) t ≤ dyR n t := by
  have hp := two_pow_pos_nnreal n
  have hp' := two_pow_pos_nnreal (n + 1)
  rw [dyR, dyR, div_le_div_iff₀ hp' hp, pow_succ]
  have hc : ⌈(2 : ℝ≥0) ^ n * 2 * t⌉₊ ≤ 2 * ⌈(2 : ℝ≥0) ^ n * t⌉₊ := by
    rw [Nat.ceil_le]
    push_cast
    rw [mul_right_comm, mul_comm _ (2 : ℝ≥0)]
    exact mul_le_mul_of_nonneg_left (Nat.le_ceil _) (by positivity)
  have hc' : ((⌈(2 : ℝ≥0) ^ n * 2 * t⌉₊ : ℕ) : ℝ≥0) ≤ 2 * (⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) := by
    exact_mod_cast hc
  have hle : ((⌈(2 : ℝ≥0) ^ n * 2 * t⌉₊ : ℝ≥0) + 1) ≤ 2 * (⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 2 :=
    calc ((⌈(2 : ℝ≥0) ^ n * 2 * t⌉₊ : ℝ≥0) + 1) ≤ 2 * (⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 1 :=
          add_le_add_left hc' 1
      _ ≤ 2 * (⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 2 := add_le_add_right one_le_two _
  calc ((⌈(2 : ℝ≥0) ^ n * 2 * t⌉₊ : ℝ≥0) + 1) * 2 ^ n
      ≤ (2 * (⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 2) * 2 ^ n := mul_le_mul_of_nonneg_right hle (by positivity)
    _ = ((⌈(2 : ℝ≥0) ^ n * t⌉₊ : ℝ≥0) + 1) * (2 ^ n * 2) := by ring

theorem antitone_dyR (t : ℝ≥0) : Antitone fun n => dyR n t :=
  antitone_nat_of_succ_le fun n => dyR_succ_le n t

theorem tendsto_two_div_two_pow : Tendsto (fun n : ℕ => (2 : ℝ≥0) / 2 ^ n) atTop (𝓝 0) := by
  have h : Tendsto (fun n : ℕ => (2 : ℝ≥0) * (1 / 2) ^ n) atTop (𝓝 (2 * 0)) :=
    (NNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num)).const_mul 2
  rw [mul_zero] at h
  refine h.congr fun n => ?_
  rw [one_div, inv_pow, div_eq_mul_inv]

theorem tendsto_dyR (t : ℝ≥0) : Tendsto (fun n => dyR n t) atTop (𝓝 t) := by
  have hu : Tendsto (fun n : ℕ => t + 2 / 2 ^ n) atTop (𝓝 t) := by
    simpa only [add_zero] using tendsto_const_nhds.add tendsto_two_div_two_pow
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hu (fun n => (lt_dyR n t).le)
    fun n => dyR_le n t

/-- `dyR n t ≤ r` iff some dyadic `k/2ⁿ ≥ t` has `(k+1)/2ⁿ ≤ r`. -/
theorem dyR_le_iff {n : ℕ} {t r : ℝ≥0} :
    dyR n t ≤ r ↔ ∃ k : ℕ, ((k : ℝ≥0) + 1) / 2 ^ n ≤ r ∧ t ≤ (k : ℝ≥0) / 2 ^ n := by
  have hp := two_pow_pos_nnreal n
  constructor
  · intro h
    refine ⟨⌈(2 : ℝ≥0) ^ n * t⌉₊, h, ?_⟩
    rw [le_div_iff₀ hp, mul_comm]
    exact Nat.le_ceil _
  · rintro ⟨k, hk, htk⟩
    refine le_trans ?_ hk
    rw [dyR]
    gcongr
    rw [le_div_iff₀ hp, mul_comm] at htk
    exact_mod_cast Nat.ceil_le.2 htk

/-- The dyadic upper approximation of a random time (`⊤` stays `⊤`). -/
def dyUp {Ω : Type*} (n : ℕ) (τ : Ω → WithTop ℝ≥0) (ω : Ω) : WithTop ℝ≥0 := (τ ω).map (dyR n)

theorem dyUp_coe {Ω : Type*} {n : ℕ} {τ : Ω → WithTop ℝ≥0} {ω : Ω} {t : ℝ≥0} (ht : τ ω = t) :
    dyUp n τ ω = dyR n t := by
  rw [dyUp, ht, WithTop.map_coe]

theorem dyUp_le_coe_iff {Ω : Type*} {n : ℕ} {τ : Ω → WithTop ℝ≥0} {ω : Ω} {r : ℝ≥0} :
    dyUp n τ ω ≤ r ↔ ∃ k : ℕ, ((k : ℝ≥0) + 1) / 2 ^ n ≤ r ∧ τ ω ≤ ((k : ℝ≥0) / 2 ^ n : ℝ≥0) := by
  cases h : τ ω using WithTop.recTopCoe with
  | top => simp only [dyUp, h, WithTop.map_top, WithTop.not_top_le_coe, and_false, exists_false]
  | coe t =>
    rw [dyUp_coe h, WithTop.coe_le_coe, dyR_le_iff]
    simp only [WithTop.coe_le_coe]

theorem dyUp_anti {Ω : Type*} (τ : Ω → WithTop ℝ≥0) (ω : Ω) {a b : ℕ} (hab : a ≤ b) :
    dyUp b τ ω ≤ dyUp a τ ω := by
  cases h : τ ω using WithTop.recTopCoe with
  | top => simp [dyUp, h]
  | coe t =>
    rw [dyUp_coe h, dyUp_coe h, WithTop.coe_le_coe]
    exact antitone_dyR t hab

end Dyadic

/-! ### The approximations are stopping times of the null-augmented filtration -/

section Stopping

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {𝓐 : Filtration ℝ≥0 mΩ}

/-- `𝓖_s ⊆ 𝓐⁰_u` for `s < u`. -/
theorem usualAugmentation_le_nullAugmented {s u : ℝ≥0} (hsu : s < u) :
    usualAugmentation 𝓐 P s ≤ nullAugmented 𝓐 P u := by
  rw [usualAugmentation_apply]
  exact iInf₂_le (κ := fun v => v > s) (f := fun v _ => nullAugmented 𝓐 P v) u hsu

theorem iSup_usualAugmentation_le :
    (⨆ t, usualAugmentation 𝓐 P t) ≤ ⨆ t, nullAugmented 𝓐 P t :=
  iSup_le fun t => (usualAugmentation_le_nullAugmented (lt_add_one t)).trans (le_iSup _ (t + 1))

theorem iSup_nullAugmented_le :
    (⨆ t, nullAugmented 𝓐 P t) ≤ ⨆ t, usualAugmentation 𝓐 P t :=
  iSup_mono fun t => nullAugmented_le_usualAugmentation 𝓐 P t

/-- If `A ∩ {τ ≤ s} ∈ 𝓖_s` for all `s`, then `A ∩ {τₙ ≤ r} ∈ 𝓐⁰_r` for all `r`. -/
theorem measurableSet_inter_dyUp_le {τ : Ω → WithTop ℝ≥0} {A : Set Ω}
    (hA : ∀ s : ℝ≥0, MeasurableSet[usualAugmentation 𝓐 P s] (A ∩ {ω | τ ω ≤ s})) (n : ℕ) (r : ℝ≥0) :
    MeasurableSet[nullAugmented 𝓐 P r] (A ∩ {ω | dyUp n τ ω ≤ r}) := by
  have hp := two_pow_pos_nnreal n
  have e : A ∩ {ω | dyUp n τ ω ≤ r} = ⋃ k : ℕ, ⋃ (_ : ((k : ℝ≥0) + 1) / 2 ^ n ≤ r),
      A ∩ {ω | τ ω ≤ ((k : ℝ≥0) / 2 ^ n : ℝ≥0)} := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq, dyUp_le_coe_iff, mem_iUnion]
    constructor
    · rintro ⟨hω, k, hk, hτk⟩
      exact ⟨k, hk, hω, hτk⟩
    · rintro ⟨k, hk, hω, hτk⟩
      exact ⟨hω, k, hk, hτk⟩
  rw [e]
  refine MeasurableSet.iUnion fun k => MeasurableSet.iUnion fun hkr => ?_
  have hlt : (k : ℝ≥0) / 2 ^ n < ((k : ℝ≥0) + 1) / 2 ^ n :=
    div_lt_div_of_pos_right (lt_add_one _) hp
  exact (nullAugmented 𝓐 P).mono hkr _ (usualAugmentation_le_nullAugmented hlt _ (hA _))

/-- The dyadic upper approximations of a stopping time of the usual augmentation are stopping times of the
null-augmented filtration. -/
theorem isStoppingTime_dyUp {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (usualAugmentation 𝓐 P) τ)
    (n : ℕ) : IsStoppingTime (nullAugmented 𝓐 P) (dyUp n τ) := fun r => by
  have h := measurableSet_inter_dyUp_le (A := univ) (fun s => by rw [univ_inter]; exact hτ s) n r
  rwa [univ_inter] at h

variable {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (usualAugmentation 𝓐 P) τ)

/-- The stopped σ-algebras `𝓐⁰_{τₙ}` of the approximations. -/
abbrev stoppedSigma (n : ℕ) : MeasurableSpace Ω := (isStoppingTime_dyUp hτ n).measurableSpace

theorem antitone_stoppedSigma : Antitone (stoppedSigma hτ) := fun _ _ hab =>
  IsStoppingTime.measurableSpace_mono _ _ fun ω => dyUp_anti τ ω hab

theorem le_stoppedSigma (n : ℕ) : hτ.measurableSpace ≤ stoppedSigma hτ n := fun _ hA =>
  ⟨iSup_usualAugmentation_le _ hA.1, measurableSet_inter_dyUp_le hA.2 n⟩

theorem iInf_stoppedSigma_le : (⨅ n, stoppedSigma hτ n) ≤ hτ.measurableSpace := by
  intro A hA
  have hAn : ∀ n, MeasurableSet[stoppedSigma hτ n] A := fun n => MeasurableSpace.measurableSet_iInf.1 hA n
  refine ⟨iSup_nullAugmented_le _ (hAn 0).1, fun t => ?_⟩
  rw [usualAugmentation_apply]
  refine MeasurableSpace.measurableSet_iInf.2 fun u => MeasurableSpace.measurableSet_iInf.2 fun hu => ?_
  -- a level `N` with `t + 2/2ᴺ < u`
  have hut : (0 : ℝ≥0) < u - t := tsub_pos_of_lt hu
  obtain ⟨N, hN⟩ := (tendsto_order.1 tendsto_two_div_two_pow).2 _ hut |>.exists_forall_of_atTop
  have hle : ∀ m ≥ N, t + 2 / 2 ^ m ≤ u := fun m hm =>
    (add_le_add_right (hN m hm).le t).trans (add_tsub_cancel_of_le hu.le).le
  have e : A ∩ {ω | τ ω ≤ t} = ⋂ m : ℕ, (A ∩ {ω | dyUp (N + m) τ ω ≤ (t + 2 / 2 ^ (N + m) : ℝ≥0)}) := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq, mem_iInter]
    constructor
    · rintro ⟨hω, hτt⟩
      refine fun m => ⟨hω, ?_⟩
      obtain ⟨s, hs⟩ := WithTop.ne_top_iff_exists.1 (ne_top_of_le_ne_top WithTop.coe_ne_top hτt)
      rw [dyUp_coe hs.symm, WithTop.coe_le_coe]
      rw [← hs, WithTop.coe_le_coe] at hτt
      exact (dyR_le _ s).trans (add_le_add_left hτt _)
    · intro h
      refine ⟨(h 0).1, ?_⟩
      cases hs : τ ω using WithTop.recTopCoe with
      | top =>
        have h0 := (h 0).2
        simp only [dyUp, hs, WithTop.map_top, WithTop.not_top_le_coe] at h0
      | coe s =>
        rw [WithTop.coe_le_coe]
        have hb : ∀ m, s ≤ t + 2 / 2 ^ (N + m) := fun m => by
          have hm := (h m).2
          rw [dyUp_coe hs, WithTop.coe_le_coe] at hm
          exact (lt_dyR _ s).le.trans hm
        have hlim : Tendsto (fun m => t + 2 / 2 ^ (N + m)) atTop (𝓝 t) := by
          have h2 : Tendsto (fun m : ℕ => (2 : ℝ≥0) / 2 ^ (N + m)) atTop (𝓝 0) :=
            tendsto_two_div_two_pow.comp (tendsto_atTop_atTop_of_monotone
              (fun _ _ hab => Nat.add_le_add_left hab N) fun b => ⟨b, Nat.le_add_left b N⟩)
          have h3 := (tendsto_const_nhds (x := t)).add h2
          rwa [add_zero] at h3
        exact ge_of_tendsto hlim (Eventually.of_forall hb)
  rw [e]
  refine MeasurableSet.iInter fun m => ?_
  exact (nullAugmented 𝓐 P).mono (hle (N + m) (Nat.le_add_right N m)) _ ((hAn (N + m)).2 _)

/-- **`⋂ₙ 𝓐⁰_{τₙ} = 𝓖_τ`** (right-continuity of the usual augmentation). -/
theorem iInf_stoppedSigma_eq : (⨅ n, stoppedSigma hτ n) = hτ.measurableSpace :=
  le_antisymm (iInf_stoppedSigma_le hτ) (le_iInf (le_stoppedSigma hτ))

end Stopping

/-! ### Conditional expectations on the level sets of the approximations -/

section CondExp

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {𝓐 : Filtration ℝ≥0 mΩ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Null sets do not change conditional expectations: `E[X | 𝓐_t ∨ 𝒩] = E[X | 𝓐_t]` almost surely. -/
theorem condExp_nullAugmented_ae_eq {X : Ω → E} (hX : Integrable X P) (t : ℝ≥0) :
    P[X | nullAugmented 𝓐 P t] =ᵐ[P] P[X | 𝓐 t] := by
  refine (ae_eq_condExp_of_forall_setIntegral_eq ((nullAugmented 𝓐 P).le t) hX
    (fun s _ _ => integrable_condExp.integrableOn) (fun s hs _ => ?_) ?_).symm
  · obtain ⟨s', hs', hss'⟩ := exists_ae_eq_of_measurableSet_nullAugmented hs
    rw [setIntegral_congr_set hss', setIntegral_congr_set hss', setIntegral_condExp (𝓐.le t) hX hs']
  · exact (stronglyMeasurable_condExp.mono (le_nullAugmented 𝓐 P t)).aestronglyMeasurable

variable {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (usualAugmentation 𝓐 P) τ)

/-- On `{τₙ = q}`, `E[X | 𝓐⁰_{τₙ}] = E[X | 𝓐_q]`. -/
theorem condExp_stoppedSigma_ae_eq_restrict {X : Ω → E} (hX : Integrable X P) (n : ℕ) (q : ℝ≥0) :
    P[X | stoppedSigma hτ n] =ᵐ[P.restrict {ω | dyUp n τ ω = q}] P[X | 𝓐 q] := by
  have hn := isStoppingTime_dyUp hτ n
  refine Filter.EventuallyEq.trans ?_ (ae_restrict_of_ae (condExp_nullAugmented_ae_eq hX q))
  exact condExp_ae_eq_restrict_of_measurableSpace_eq_on hn.measurableSpace_le ((nullAugmented 𝓐 P).le q)
    (hn.measurableSet_eq' q) fun t => by rw [inter_comm _ t, IsStoppingTime.measurableSet_inter_eq_iff]

end CondExp

/-! ### The transfer theorem -/

section Transfer

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {𝓐 : Filtration ℝ≥0 mΩ}

/-- **From fixed times of `𝓐` to every stopping time of its usual augmentation** (real form). If almost surely on
`E q` the conditional expectation `E[X | 𝓐_q]` is `F q`, for every fixed `q`, and `E`, `F` are right-continuous
along decreasing sequences, then for every stopping time `τ` of `usualAugmentation 𝓐 P`, almost surely on
`{τ = t} ∩ E t`, `E[X | 𝓖_τ] = F t`. -/
theorem ae_condExp_stopping_eq_of_forall_const {X : Ω → ℝ} (hX : MemLp X 2 P) {F : ℝ≥0 → Ω → ℝ}
    {E : ℝ≥0 → Set Ω} (hdet : ∀ q : ℝ≥0, ∀ᵐ ω ∂P, ω ∈ E q → P[X | 𝓐 q] ω = F q ω)
    (hright : ∀ ω t, ω ∈ E t → ∀ s : ℕ → ℝ≥0, Antitone s → (∀ i, t < s i) → Tendsto s atTop (𝓝 t) →
      (∀ᶠ i in atTop, ω ∈ E (s i)) ∧ Tendsto (fun i => F (s i) ω) atTop (𝓝 (F t ω)))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (usualAugmentation 𝓐 P) τ) :
    ∀ᵐ ω ∂P, ∀ t : ℝ≥0, τ ω = t → ω ∈ E t → P[X | hτ.measurableSpace] ω = F t ω := by
  have hXi : Integrable X P := hX.integrable one_le_two
  obtain ⟨ns, hns, hconv⟩ := Martingale.exists_seq_ae_tendsto_condExp_iInf
    (fun n => (isStoppingTime_dyUp hτ n).measurableSpace_le) (antitone_stoppedSigma hτ) hX
  rw [iInf_stoppedSigma_eq hτ] at hconv
  -- the identity on every level set of every approximation
  have hlev : ∀ᵐ ω ∂P, ∀ n k : ℕ, dyUp n τ ω = (((k : ℝ≥0) / 2 ^ n : ℝ≥0) : WithTop ℝ≥0) →
      ω ∈ E ((k : ℝ≥0) / 2 ^ n) → P[X | stoppedSigma hτ n] ω = F ((k : ℝ≥0) / 2 ^ n) ω := by
    refine ae_all_iff.2 fun n => ae_all_iff.2 fun k => ?_
    have hn := isStoppingTime_dyUp hτ n
    have hmeas : MeasurableSet {ω | dyUp n τ ω = ((((k : ℝ≥0) / 2 ^ n : ℝ≥0)) : WithTop ℝ≥0)} :=
      hn.measurableSpace_le _ (hn.measurableSet_eq' _)
    have h1 := (ae_restrict_iff' hmeas).1 (condExp_stoppedSigma_ae_eq_restrict hτ hXi n ((k : ℝ≥0) / 2 ^ n))
    filter_upwards [h1, hdet ((k : ℝ≥0) / 2 ^ n)] with ω hω1 hω2 hq hE
    rw [hω1 hq, hω2 hE]
  filter_upwards [hconv, hlev] with ω hω hlevω t ht hE
  set s : ℕ → ℝ≥0 := fun i => dyR (ns i) t with hs_def
  have hsanti : Antitone s := fun a b hab => antitone_dyR t (hns.monotone hab)
  have hst : ∀ i, t < s i := fun i => lt_dyR _ t
  have hslim : Tendsto s atTop (𝓝 t) := (tendsto_dyR t).comp hns.tendsto_atTop
  obtain ⟨hEv, hF⟩ := hright ω t hE s hsanti hst hslim
  have heq : ∀ᶠ i in atTop, P[X | stoppedSigma hτ (ns i)] ω = F (s i) ω := by
    filter_upwards [hEv] with i hi
    have hsi : s i = (((⌈(2 : ℝ≥0) ^ ns i * t⌉₊ + 1 : ℕ) : ℝ≥0)) / 2 ^ ns i := by
      show dyR (ns i) t = _
      rw [dyR]
      push_cast
      rfl
    rw [hsi] at hi ⊢
    exact hlevω (ns i) _ (by rw [dyUp_coe ht, ← hsi]) hi
  exact tendsto_nhds_unique (hω.congr' heq) hF

/-- **From fixed times of `𝓐` to every stopping time of its usual augmentation** (complex form, e.g. for conditional
characteristic functions). -/
theorem ae_condExp_stopping_eq_of_forall_const_complex {X : Ω → ℂ} (hX : MemLp X 2 P)
    {F : ℝ≥0 → Ω → ℂ} {E : ℝ≥0 → Set Ω} (hdet : ∀ q : ℝ≥0, ∀ᵐ ω ∂P, ω ∈ E q → P[X | 𝓐 q] ω = F q ω)
    (hright : ∀ ω t, ω ∈ E t → ∀ s : ℕ → ℝ≥0, Antitone s → (∀ i, t < s i) → Tendsto s atTop (𝓝 t) →
      (∀ᶠ i in atTop, ω ∈ E (s i)) ∧ Tendsto (fun i => F (s i) ω) atTop (𝓝 (F t ω)))
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime (usualAugmentation 𝓐 P) τ) :
    ∀ᵐ ω ∂P, ∀ t : ℝ≥0, τ ω = t → ω ∈ E t → P[X | hτ.measurableSpace] ω = F t ω := by
  have hXi : Integrable X P := hX.integrable one_le_two
  have hcomm : ∀ (m : MeasurableSpace Ω) (L : ℂ →L[ℝ] ℝ),
      (fun ω => L (P[X | m] ω)) =ᵐ[P] P[fun ω => L (X ω) | m] := fun _ L => L.comp_condExp_comm hXi
  have hpart : ∀ L : ℂ →L[ℝ] ℝ, ∀ᵐ ω ∂P, ∀ t : ℝ≥0, τ ω = t → ω ∈ E t →
      L (P[X | hτ.measurableSpace] ω) = L (F t ω) := by
    intro L
    have hXL : MemLp (fun ω => L (X ω)) 2 P := L.comp_memLp' hX
    have hdet' : ∀ q : ℝ≥0, ∀ᵐ ω ∂P, ω ∈ E q → P[fun ω => L (X ω) | 𝓐 q] ω = L (F q ω) := fun q => by
      filter_upwards [hdet q, hcomm (𝓐 q) L] with ω hω hc hE
      rw [← hc, hω hE]
    have hright' : ∀ ω t, ω ∈ E t → ∀ s : ℕ → ℝ≥0, Antitone s → (∀ i, t < s i) →
        Tendsto s atTop (𝓝 t) →
        (∀ᶠ i in atTop, ω ∈ E (s i)) ∧ Tendsto (fun i => L (F (s i) ω)) atTop (𝓝 (L (F t ω))) :=
      fun ω t hE s ha hs hl => by
        obtain ⟨h1, h2⟩ := hright ω t hE s ha hs hl
        exact ⟨h1, (L.continuous.tendsto _).comp h2⟩
    have h := ae_condExp_stopping_eq_of_forall_const hXL hdet' hright' hτ
    filter_upwards [h, hcomm hτ.measurableSpace L] with ω hω hc t ht hE
    rw [hc]
    exact hω t ht hE
  filter_upwards [hpart Complex.reCLM, hpart Complex.imCLM] with ω hre him t ht hE
  apply Complex.ext
  · simpa only [Complex.reCLM_apply] using hre t ht hE
  · simpa only [Complex.imCLM_apply] using him t ht hE

end Transfer

