/-!
# (S): side heights of an angle-varying path after its change time, through the restart chart

Packet PROVE-STRIPSYS15. Specification §7.4, proof of Aux. lemma 130, (RS13.3) (`source/spec/p385-432.md` L440–L456,
p. 411: "In each own chart the right-side height is `λ − θχ`, with its inherited derivative-logarithm lift"), for the
angle-varying path `α = η^{1,∞}_{−π/2,θ₁}` of (RS13.1) after its change time `1`; PROVE-STRIPSYS12 §5 item 4: "This is
the time-1 domain-Markov transfer of `Aux70.SinglePathSideHeightStatement` […] The chain rule `g_q = g̃_{q−1} ∘ g_1`
must carry the lift."

The continuation of `α` after time `T` is, in the chart `f_T(· − x)`, a path `α'` generated by the restarted driver
`s ↦ W(T + s) − W(T)`; in the staged history it is the flow line of the transported field (rule (1.4), lift
`arg f_T′`). This file proves the deterministic transfer of side heights from `α'` back to `α`:

* `restart_flow`: the flow property `f_{T+r} = f'_r ∘ f_T` with the additive inherited lift, for drivers continuous
  only before their lifetime (the form of the frozen generating traces);
* `continuousAt_fwdMap_rpath`: the chart `f_T` is continuous off `K_T`;
* **`hasSideHeights_of_restart`**: if the continuation has the side heights `±λ − θχ` (`StripGeom.HasSideHeights`) at
  the chart image of `z₀` and the means are related by the transport rule
  `v + u₀ = (v' + u₀') ∘ f_T(· − x) − χ arg f_T′(· − x)`, then `α` has the side heights `±λ − θχ` at `z₀` at the stop
  `T + r` (the derivative-correction terms of the two charts telescope by the chain rule);
* `sub_mem_H_diff_fwdHull_of_lt`: a later trace point lies off the earlier hull;
* **`hasSideHeights_of_restart_of_lt`**: the transfer at the trace points `α(t₀)`, `T < t₀`.

The probabilistic inputs of (S) — the single-path side heights of the continuation under the regular conditional law
given the past at time `T` (`Aux70.SinglePathSideHeightStatement` applied to the stage-`1` flow line of the staged
history) and the transport identity of the two local-set means — are not proved here.
-/

set_option autoImplicit false

noncomputable section

open Set Filter Topology
open QuantumZipper (H fwdMap fwdMapInv fwdHull logDerivFwd chiC)
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

namespace StripSideHeight

/-! ### The flow property for a driver continuous before its lifetime -/

/-- The restarted driver `s ↦ w(T + s) − w(T)` (the driver of the continuation after time `T`). -/
def restartDrv (w : ℝ≥0 → ℝ) (T : ℝ≥0) : ℝ≥0 → ℝ := fun s => w (T + s) - w T

/-- **The flow property along a driver continuous before its lifetime** (QuantumZipper's `fwdMap_add` and
`Sec5.Markov.logDerivFwd_add` for a globally continuous driver, transferred by clamping at a time in `(T + r, ζ)`):
for `T + r < ζ` and `z ∈ ℍ ∖ K_{T+r}`, the chart point `f_T(z)` lies in `ℍ ∖ K'_r` (`K'` the hulls of the restarted
driver), `f_{T+r}(z) = f'_r(f_T(z))` and `log f_{T+r}′(z) = log f_T′(z) + log f'_r′(f_T(z))` (inherited branches). -/
theorem restart_flow {w : ℝ≥0 → ℝ} {ζ : ℝ≥0∞} (hw : ContinuousOn w {t | (t : ℝ≥0∞) < ζ}) (hw0 : w 0 = 0)
    {T r : ℝ≥0} (hr : ((T + r : ℝ≥0) : ℝ≥0∞) < ζ) {z : ℂ}
    (hz : z ∈ H \ fwdHull (fun s : ℝ => w s.toNNReal) ((T + r : ℝ≥0) : ℝ)) :
    fwdMap (fun s : ℝ => w s.toNNReal) T z ∈ H \ fwdHull (fun s : ℝ => restartDrv w T s.toNNReal) r ∧
    fwdMap (fun s : ℝ => w s.toNNReal) ((T + r : ℝ≥0) : ℝ) z =
      fwdMap (fun s : ℝ => restartDrv w T s.toNNReal) r (fwdMap (fun s : ℝ => w s.toNNReal) T z) ∧
    logDerivFwd (fun s : ℝ => w s.toNNReal) ((T + r : ℝ≥0) : ℝ) z =
      logDerivFwd (fun s : ℝ => w s.toNNReal) T z +
        logDerivFwd (fun s : ℝ => restartDrv w T s.toNNReal) r (fwdMap (fun s : ℝ => w s.toNNReal) T z) := by
  obtain ⟨t₂, hTr₂, ht₂ζ⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hr
  have hTr₂' : ((T + r : ℝ≥0) : ℝ) < t₂ := by exact_mod_cast hTr₂
  have hT₂ : (T : ℝ) < t₂ := lt_of_le_of_lt (by push_cast; linarith [r.coe_nonneg]) hTr₂'
  have hr₂ : (r : ℝ) < t₂ - T := by push_cast at hTr₂'; linarith
  set v : ℝ → ℝ := fun s => w s.toNNReal with hv
  set v' : ℝ → ℝ := Ito.clampDrv v t₂ with hv'
  have hvc : Continuous v' := Ito.continuous_clampDrv t₂.coe_nonneg (Ito.continuousOn_rpath hw ht₂ζ)
  have heq : EqOn v' v (Icc 0 t₂) := Ito.clampDrv_eqOn
  have hv0 : v' 0 = 0 := by rw [heq ⟨le_rfl, t₂.coe_nonneg⟩]; simp [hv, hw0]
  have heq' : ∀ x ∈ Icc (0 : ℝ) t₂, v x = v' x := fun x hx => (heq hx).symm
  set u₁ : ℝ → ℝ := fun s => restartDrv w T s.toNNReal with hu₁
  set u₂ : ℝ → ℝ := fun s => v' (T + s) - v' T with hu₂
  have hTmem : (T : ℝ) ∈ Icc (0 : ℝ) t₂ := ⟨T.coe_nonneg, hT₂.le⟩
  have hu : ∀ x ∈ Icc (0 : ℝ) (t₂ - T), u₁ x = u₂ x := fun x hx => by
    have hx2 : (T : ℝ) + x ∈ Icc (0 : ℝ) t₂ := ⟨by linarith [hx.1, T.coe_nonneg], by linarith [hx.2]⟩
    simp only [hu₁, hu₂, restartDrv]
    rw [heq hx2, heq hTmem]
    simp only [hv, Real.toNNReal_coe, Sec2.Restart.toNNReal_add_of_nonneg T hx.1]
  have huEq : EqOn u₁ u₂ (Icc 0 (t₂ - T)) := fun x hx => hu x hx
  have hK' : fwdHull u₁ r = fwdHull u₂ r := fwdHull_eq_of_eqOn r.coe_nonneg hr₂ hu
  have hK : fwdHull v ((T + r : ℝ≥0) : ℝ) = fwdHull v' ((T + r : ℝ≥0) : ℝ) :=
    fwdHull_eq_of_eqOn (T + r).coe_nonneg hTr₂' heq'
  have hcast : ((T + r : ℝ≥0) : ℝ) = (T : ℝ) + r := NNReal.coe_add T r
  have hfwd : ∀ z, fwdMap v T z = fwdMap v' T z := fun z =>
    fwdMap_eq_of_eqOn T.coe_nonneg fun x hx => heq' x ⟨hx.1, hx.2.trans hT₂.le⟩
  have hfwdq : ∀ z, fwdMap v ((T + r : ℝ≥0) : ℝ) z = fwdMap v' ((T + r : ℝ≥0) : ℝ) z := fun z =>
    fwdMap_eq_of_eqOn (T + r).coe_nonneg fun x hx => heq' x ⟨hx.1, hx.2.trans hTr₂'.le⟩
  have hfwdr : ∀ y, fwdMap u₁ r y = fwdMap u₂ r y := fun y =>
    fwdMap_eq_of_eqOn r.coe_nonneg fun x hx => hu x ⟨hx.1, hx.2.trans hr₂.le⟩
  have hlog : ∀ z, logDerivFwd v T z = logDerivFwd v' T z := fun z =>
    Ito.logDerivFwd_congr_of_eqOn (EqOn.symm heq) T.coe_nonneg hT₂.le
  have hlogq : ∀ z, logDerivFwd v ((T + r : ℝ≥0) : ℝ) z = logDerivFwd v' ((T + r : ℝ≥0) : ℝ) z := fun z =>
    Ito.logDerivFwd_congr_of_eqOn (EqOn.symm heq) (T + r).coe_nonneg hTr₂'.le
  have hlogr : ∀ y, logDerivFwd u₁ r y = logDerivFwd u₂ r y := fun y =>
    Ito.logDerivFwd_congr_of_eqOn huEq r.coe_nonneg hr₂.le
  have hz' : z ∈ H \ fwdHull v' ((T : ℝ) + r) := by rw [← hcast, ← hK]; exact hz
  have himg := Sec5.Markov.image_fwdMapInv_diff_fwdHull hvc hv0 T.coe_nonneg r.coe_nonneg
  rw [← himg] at hz'
  obtain ⟨y, hy, hyz⟩ := hz'
  have hfy : fwdMap v' T z = y := by rw [← hyz]; exact QuantumZipper.RS.fwdMap_fwdMapInv hvc hv0 T.coe_nonneg hy.1
  have hzq : z ∈ H \ fwdHull v' ((T : ℝ) + r) := by rw [← hcast, ← hK]; exact hz
  refine ⟨?_, ?_, ?_⟩
  · rw [hfwd, hfy, hK']; exact hy
  · rw [hfwdq, hcast, QuantumZipper.fwdMap_add hvc hzq.1 T.coe_nonneg r.coe_nonneg (Ito.exists_isForwardSol_of_mem
      (add_nonneg T.coe_nonneg r.coe_nonneg) hzq), hfwdr, hfwd]
  · rw [hlogq, hlog, hlogr, hfwd, hcast]
    exact Sec5.Markov.logDerivFwd_add hvc T.coe_nonneg r.coe_nonneg hzq


/-- The chart `f_T` of a driver continuous before `ζ > T` is continuous at every point of `ℍ ∖ K_T`. -/
theorem continuousAt_fwdMap_rpath {w : ℝ≥0 → ℝ} {ζ : ℝ≥0∞} (hw : ContinuousOn w {t | (t : ℝ≥0∞) < ζ})
    {T : ℝ≥0} (hT : (T : ℝ≥0∞) < ζ) {z : ℂ} (hz : z ∈ H \ fwdHull (fun s : ℝ => w s.toNNReal) T) :
    ContinuousAt (fwdMap (fun s : ℝ => w s.toNNReal) T) z := by
  obtain ⟨t₂, hT₂, ht₂ζ⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hT
  have hT₂' : (T : ℝ) < t₂ := by exact_mod_cast hT₂
  set v : ℝ → ℝ := fun s => w s.toNNReal with hv
  have hvc : Continuous (Ito.clampDrv v t₂) :=
    Ito.continuous_clampDrv t₂.coe_nonneg (Ito.continuousOn_rpath hw ht₂ζ)
  have heq' : ∀ x ∈ Icc (0 : ℝ) t₂, v x = Ito.clampDrv v t₂ x := fun x hx => (Ito.clampDrv_eqOn hx).symm
  have hK : fwdHull v T = fwdHull (Ito.clampDrv v t₂) T := fwdHull_eq_of_eqOn T.coe_nonneg hT₂' heq'
  have hf : fwdMap v T = fwdMap (Ito.clampDrv v t₂) T := funext fun z =>
    fwdMap_eq_of_eqOn T.coe_nonneg fun x hx => heq' x ⟨hx.1, hx.2.trans hT₂'.le⟩
  rw [hf]
  rw [hK] at hz
  exact WangWu.continuousAt_fwdMap hvc T.coe_nonneg hz

/-! ### Side heights through the restart chart -/

open StripGeom in
/-- **Side heights through the restart chart** (the chain rule `g_{T+r} = g'_r ∘ g_T` carrying the lift). Let `α` be a
path from `x` with generating driver `W` (continuous before `ζ`, `W 0 = 0`), `T + r < ζ`, and `α'` a generating trace
of the restarted driver `s ↦ W(T + s) − W(T)` with `r < ζ'` (the continuation after time `T` in the chart
`f_T(· − x)`). Let `z₀ − x ∈ ℍ ∖ K_T`. If near `z₀`, on the unbounded domain of `α([0, T + r])`, the mean `v + u₀` is
the continuation's mean `v' + u₀'` read through the chart minus the chart's lift,
`v + u₀ = (v' + u₀') ∘ f_T(· − x) − χ arg f_T′(· − x)` (rule (1.4)), and the continuation has the side heights
`±λ − θχ` at `f_T(z₀ − x)`, then `α` has the side heights `±λ − θχ` at `z₀` at the stop `T + r`. -/
theorem hasSideHeights_of_restart {κ θ : ℝ} {α : ℝ≥0 → ℂ} {x : ℝ} {W : ℝ≥0 → ℝ} {ζ : ℝ≥0∞}
    (hg : IsGeneratingTrace W ζ (fun t => α t - x)) (hWc : ContinuousOn W {s | (s : ℝ≥0∞) < ζ}) (hW0 : W 0 = 0)
    {T r : ℝ≥0} (hTr : ((T + r : ℝ≥0) : ℝ≥0∞) < ζ) {α' : ℝ≥0 → ℂ} {ζ' : ℝ≥0∞}
    (hg' : IsGeneratingTrace (restartDrv W T) ζ' α') (hr : (r : ℝ≥0∞) < ζ') {z₀ : ℂ}
    (hz₀ : z₀ - x ∈ H \ fwdHull (fun s : ℝ => W s.toNNReal) T) {v u₀ v' u₀' : ℂ → ℝ}
    (hmean : ∀ᶠ z in 𝓝[H \ fillH (α '' Icc 0 (T + r))] z₀,
      v z + u₀ z = v' (fwdMap (fun s : ℝ => W s.toNNReal) T (z - x)) +
        u₀' (fwdMap (fun s : ℝ => W s.toNNReal) T (z - x)) -
          chiC κ * (logDerivFwd (fun s : ℝ => W s.toNNReal) T (z - x)).im)
    (hside : HasSideHeights κ θ α' 0 (restartDrv W T) r (fwdMap (fun s : ℝ => W s.toNNReal) T (z₀ - x)) v' u₀') :
    HasSideHeights κ θ α x W (T + r) z₀ v u₀ := by
  set φ : ℂ → ℂ := fun z => fwdMap (fun s : ℝ => W s.toNNReal) T (z - x) with hφ
  have hTζ : (T : ℝ≥0∞) < ζ := lt_of_le_of_lt (ENNReal.coe_le_coe.2 le_self_add) hTr
  -- the unbounded domain at `T + r` in the chart at `T`
  have hdom : ∀ z ∈ H \ fillH (α '' Icc 0 (T + r)),
      z - x ∈ H \ fwdHull (fun s : ℝ => W s.toNNReal) ((T + r : ℝ≥0) : ℝ) := by
    intro z hz
    rw [ReverseArc.mem_H_diff_fillH_phys_iff x (T + r) z] at hz
    rwa [SideHeight.fwdHull_eq_fillH_of_isGeneratingTrace hg hTr]
  have hmaps : ∀ z ∈ H \ fillH (α '' Icc 0 (T + r)), φ z ∈ H \ fillH (α' '' Icc 0 r) := by
    intro z hz
    rw [← SideHeight.fwdHull_eq_fillH_of_isGeneratingTrace hg' hr]
    exact (restart_flow hWc hW0 hTr (hdom z hz)).1
  have hcont : ContinuousAt φ z₀ :=
    ContinuousAt.comp (x := z₀) (f := fun z : ℂ => z - (x : ℂ)) (continuousAt_fwdMap_rpath hWc hTζ hz₀)
      (continuous_sub_right (x : ℂ)).continuousAt
  intro F hF hFle y hy
  have hFS : ∀ᶠ z in F, z ∈ H \ fillH (α '' Icc 0 (T + r)) := hFle (self_mem_nhdsWithin)
  have hmF : Tendsto φ F (𝓝[H \ fillH (α' '' Icc 0 r)] (φ z₀)) :=
    tendsto_nhdsWithin_iff.2 ⟨(hcont.tendsto.mono_left (hFle.trans nhdsWithin_le_nhds)),
      hFS.mono fun z hz => hmaps z hz⟩
  have hF' : (F.map φ).NeBot := Filter.map_neBot
  have hy' : Tendsto (fun w => fwdMap (fun s : ℝ => restartDrv W T s.toNNReal) r (w - ((0 : ℝ) : ℂ)))
      (F.map φ) (𝓝 (y : ℂ)) := by
    rw [tendsto_map'_iff]
    refine hy.congr' (hFS.mono fun z hz => ?_)
    simp only [Function.comp_apply, Complex.ofReal_zero, sub_zero, hφ]
    exact (restart_flow hWc hW0 hTr (hdom z hz)).2.1
  obtain ⟨hpos, hneg⟩ := hside (F.map φ) hF' hmF y hy'
  have hcongr : ∀ᶠ z in F, v z + u₀ z + chiC κ * (logDerivFwd (fun s : ℝ => W s.toNNReal) (T + r : ℝ≥0) (z - x)).im =
      (fun w => v' w + u₀' w + chiC κ * (logDerivFwd (fun s : ℝ => restartDrv W T s.toNNReal) r
        (w - ((0 : ℝ) : ℂ))).im) (φ z) := by
    filter_upwards [hFS, hFle hmean] with z hz hm
    rw [hm, (restart_flow hWc hW0 hTr (hdom z hz)).2.2]
    simp only [Complex.ofReal_zero, sub_zero, Complex.add_im, hφ]
    ring
  refine ⟨fun hy0 => ?_, fun hy0 => ?_⟩
  · exact ((hpos hy0).comp tendsto_map).congr' (hcongr.mono fun z hz => hz.symm)
  · exact ((hneg hy0).comp tendsto_map).congr' (hcongr.mono fun z hz => hz.symm)


/-- **A later trace point lies off the earlier hull**: for an injective generating trace and `T < t₀ < ζ`, a point
`α(t₀) ∈ ℍ` satisfies `α(t₀) − x ∈ ℍ ∖ K_T`. The tip `α(t₀)` is adherent to `ℍ ∖ fill(α([0, t₀])) ⊆ ℍ ∖ fill(α([0, T]))`
(`ReverseArc.isChart`), so membership in `fill(α([0, T])) = K_T + x` would put it in the compact `α([0, T])`. -/
theorem sub_mem_H_diff_fwdHull_of_lt {α : ℝ≥0 → ℂ} {x : ℝ} {W : ℝ≥0 → ℝ} {ζ : ℝ≥0∞}
    (hg : IsGeneratingTrace W ζ (fun t => α t - x)) (hWc : ContinuousOn W {s | (s : ℝ≥0∞) < ζ}) (hW0 : W 0 = 0)
    (hinj : InjOn (fun t => α t - x) {t | (t : ℝ≥0∞) ≤ ζ}) {T t₀ : ℝ≥0} (hTt : T < t₀) (ht₀ : (t₀ : ℝ≥0∞) < ζ)
    (hH : α t₀ ∈ H) : α t₀ - x ∈ H \ fwdHull (fun s : ℝ => W s.toNNReal) T := by
  set η : ℝ≥0 → ℂ := fun t => α t - x with hη
  have ht₀0 : 0 < t₀ := lt_of_le_of_lt (zero_le (a := T)) hTt
  have hc := ReverseArc.isChart hg hWc hW0 hinj ht₀ ht₀0
  have hηH : η t₀ ∈ H := by
    show 0 < (α t₀ - x).im
    simpa using (show 0 < (α t₀).im from hH)
  -- the tip is adherent to the unbounded domain at `t₀`
  have hcl : η t₀ ∈ closure (H \ fillH (η '' Icc 0 t₀)) := by
    rw [← hc.tip]
    have h0 : (0 : ℂ) ∈ closure H := by
      rw [QuantumZipper.CA.Car.closure_H_eq_Hbar]; simp [QuantumZipper.Hbar]
    have h0' : (0 : ℂ) ∈ QuantumZipper.Hbar := by simp [QuantumZipper.Hbar]
    have hcw : ContinuousWithinAt _ H 0 :=
      (hc.inv_cont 0 h0').mono fun z hz => le_of_lt (show 0 < z.im from hz)
    exact closure_mono (image_subset_iff.2 hc.inv_mem) (hcw.mem_closure_image h0)
  have hsub : H \ fillH (η '' Icc 0 t₀) ⊆ H \ fillH (η '' Icc 0 T) :=
    sdiff_subset_sdiff_right (fillH_mono (image_mono (Icc_subset_Icc_right hTt.le)))
  have hTζ : (T : ℝ≥0∞) < ζ := lt_trans (ENNReal.coe_lt_coe.2 hTt) ht₀
  rw [SideHeight.fwdHull_eq_fillH_of_isGeneratingTrace hg hTζ]
  refine ⟨hηH, fun hK => ?_⟩
  have hmem := mem_closure_of_mem_fillH_of_mem_closure hK (closure_mono hsub hcl)
  have hcpt : IsCompact (η '' Icc 0 T) := isCompact_Icc.image_of_continuousOn
    (hg.2.1.mono fun r hr => (ENNReal.coe_le_coe.2 hr.2).trans hTζ.le)
  rw [hcpt.isClosed.closure_eq] at hmem
  obtain ⟨s, hs, hse⟩ := hmem
  have hsζ : (s : ℝ≥0∞) ≤ ζ := (ENNReal.coe_le_coe.2 hs.2).trans hTζ.le
  have := hinj hsζ ht₀.le hse
  exact absurd (this ▸ hs.2) (not_le.2 hTt)


open StripGeom in
/-- **Side heights through the restart chart at a later trace point** (`hasSideHeights_of_restart` with the hull
condition supplied by `sub_mem_H_diff_fwdHull_of_lt`): for an injective generating trace, `T < t₀ < ζ` and
`α(t₀) ∈ ℍ`, the side heights of the continuation at `f_T(α(t₀) − x)` and the mean transport identity give the side
heights of `α` at `α(t₀)` at the stop `T + r`. This is the form (S) needs for the angle-varying path
`η^{1,∞}_{−π/2,θ₁}` (`T = 1`, `T + r = q₁`, `1 < t₀ < q₁`). -/
theorem hasSideHeights_of_restart_of_lt {κ θ : ℝ} {α : ℝ≥0 → ℂ} {x : ℝ} {W : ℝ≥0 → ℝ} {ζ : ℝ≥0∞}
    (hg : IsGeneratingTrace W ζ (fun t => α t - x)) (hWc : ContinuousOn W {s | (s : ℝ≥0∞) < ζ}) (hW0 : W 0 = 0)
    (hinj : InjOn (fun t => α t - x) {t | (t : ℝ≥0∞) ≤ ζ}) {T r t₀ : ℝ≥0} (hTr : ((T + r : ℝ≥0) : ℝ≥0∞) < ζ)
    (hTt : T < t₀) (ht₀ : (t₀ : ℝ≥0∞) < ζ) (hH : α t₀ ∈ H) {α' : ℝ≥0 → ℂ} {ζ' : ℝ≥0∞}
    (hg' : IsGeneratingTrace (restartDrv W T) ζ' α') (hr : (r : ℝ≥0∞) < ζ') {v u₀ v' u₀' : ℂ → ℝ}
    (hmean : ∀ᶠ z in 𝓝[H \ fillH (α '' Icc 0 (T + r))] α t₀,
      v z + u₀ z = v' (fwdMap (fun s : ℝ => W s.toNNReal) T (z - x)) +
        u₀' (fwdMap (fun s : ℝ => W s.toNNReal) T (z - x)) -
          chiC κ * (logDerivFwd (fun s : ℝ => W s.toNNReal) T (z - x)).im)
    (hside : HasSideHeights κ θ α' 0 (restartDrv W T) r
      (fwdMap (fun s : ℝ => W s.toNNReal) T (α t₀ - x)) v' u₀') :
    HasSideHeights κ θ α x W (T + r) (α t₀) v u₀ :=
  hasSideHeights_of_restart hg hWc hW0 hTr hg' hr (sub_mem_H_diff_fwdHull_of_lt hg hWc hW0 hinj hTt ht₀ hH)
    hmean hside

end StripSideHeight

end Sec7

end InteractingSLE
