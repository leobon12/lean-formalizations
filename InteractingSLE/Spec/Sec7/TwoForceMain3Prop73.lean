/-! ### Named inputs -/

/-- **Named input (§7.1): the embedded reference of Lemma 7.1** (Specification p. 223, `source/spec/p193-240.md`
L576–L581: "The conditional law of `η_ψ` is `SLE_κ(ρ^L; ρ^R)` with seed weights (CPF2). It is a continuous simple path
in `ℍ̄` and tends to `∞` at the end of its capacity lifetime"; p. 227, L642: "As `θ₁ < 0 < θ₂` vary, (CPF2) ranges over
every pair `ρ^L, ρ^R > −2` […] The embedded construction therefore covers every admissible two-seed pair"). For
`0 < κ < 4` and seed weights `> −2` there is one integrated two-seed evolution (the Loewner driver of the mapped middle
curve, with its force points and the Brownian motion of the martingale characterization, Theorem 2.4) whose driver
almost surely has a continuous generating trace tending to infinity. -/
def Lemma71TraceReferenceStatement : Prop :=
  ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ rL rR : ℝ, -2 < rL → -2 < rR →
    ∃ (Ω : Type v) (mΩ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin 1 → ℝ≥0 → Ω → ℝ)
      (VR : Fin 1 → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞),
      IsIntegratedSLEEvolution κ LP.twoSeedXL LP.twoSeedXR (fun _ => rL) (fun _ => rR) P 𝓕 W VL VR B ζ ∧
        LP.HasTransientGeneratingTrace P W ζ

/-- **Named input (deterministic): the measurable coding of the transient-trace event** (Corollary LP11's proof,
"measurable reconstruction of the entire trace", pp. 488–489, `source/spec/p481-528.md` L196–L211; Aux. lemma 126's
proof, pp. 399–400: "Existence of a continuous extension is a countable uniform continuity condition, and equality of
its filled hulls with the driving hulls can be checked at rational times by their complements and a countable
rational planar basis"). There is a measurable set of rational-time values whose members are exactly the restrictions
of the continuous drivers vanishing at `0` that have a continuous generating trace on `[0, ∞)` tending to infinity.
This is the `T = ∞` analogue of PROVE-SEC7-D2's `StoppedTraceCodingStatement`. -/
def TransientTraceCodingStatement : Prop :=
  ∃ G : Set (ℚ≥0 → ℝ), MeasurableSet G ∧
    ∀ w : ℝ≥0 → ℝ, Continuous w → w 0 = 0 →
      ((fun q : ℚ≥0 => w q) ∈ G ↔
        ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w ⊤ η ∧ Tendsto (fun t => ‖η t‖) atTop atTop)

/-- The driver event of `LP.HasTransientGeneratingTrace` on an infinite lifetime. -/
def IsTransientDriver (w : ℝ≥0 → ℝ) : Prop :=
  ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w ⊤ η ∧ Tendsto (fun t => ‖η t‖) atTop atTop

/-- On an almost surely infinite lifetime, `LP.HasTransientGeneratingTrace` is the driver event `IsTransientDriver`. -/
theorem hasTransientGeneratingTrace_iff_of_top {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
    {W : ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞} (hζ : ∀ᵐ ω ∂P, ζ ω = ⊤) :
    LP.HasTransientGeneratingTrace P W ζ ↔ ∀ᵐ ω ∂P, IsTransientDriver fun t => W t ω := by
  constructor
  · intro h
    filter_upwards [h, hζ] with ω ⟨η, hη, htr⟩ hω
    rw [hω] at hη
    exact ⟨η, hη, htr hω⟩
  · intro h
    filter_upwards [h, hζ] with ω ⟨η, hη, htr⟩ hω
    exact ⟨η, by rw [hω]; exact hη, fun _ => htr⟩

/-! ### The transience part of the coding is proved -/

/-- **Named input (deterministic): the measurable coding of the trace event on `[0, ∞)`** (the same sources as
`TransientTraceCodingStatement`): a measurable set of rational-time values whose members are exactly the restrictions
of the continuous drivers vanishing at `0` that have a continuous generating trace on `[0, ∞)`. This is exactly
PROVE-SEC7-D2's `StoppedTraceCodingStatement` with the stop `∞`. -/
def TopTraceCodingStatement : Prop :=
  ∃ G : Set (ℚ≥0 → ℝ), MeasurableSet G ∧
    ∀ w : ℝ≥0 → ℝ, Continuous w → w 0 = 0 →
      ((fun q : ℚ≥0 => w q) ∈ G ↔ ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w ⊤ η)

/-- The rational time `⌈(n + 1) t⌉ / (n + 1) ≥ t`. -/
def ratAbove (t : ℝ≥0) (n : ℕ) : ℚ≥0 := (⌈((n : ℝ≥0) + 1) * t⌉₊ : ℚ≥0) / ((n : ℚ≥0) + 1)

theorem coe_ratAbove (t : ℝ≥0) (n : ℕ) :
    ((ratAbove t n : ℚ≥0) : ℝ≥0) = (⌈((n : ℝ≥0) + 1) * t⌉₊ : ℝ≥0) / ((n : ℝ≥0) + 1) := by
  unfold ratAbove
  push_cast
  rfl

theorem le_ratAbove (t : ℝ≥0) (n : ℕ) : t ≤ ((ratAbove t n : ℚ≥0) : ℝ≥0) := by
  rw [coe_ratAbove, le_div_iff₀ (by positivity), mul_comm]
  exact Nat.le_ceil _

theorem ratAbove_le (t : ℝ≥0) (n : ℕ) : ((ratAbove t n : ℚ≥0) : ℝ≥0) ≤ t + 1 / ((n : ℝ≥0) + 1) := by
  have hpos : (0 : ℝ≥0) < (n : ℝ≥0) + 1 := by positivity
  rw [coe_ratAbove, div_le_iff₀ hpos]
  have h1 : (t + 1 / ((n : ℝ≥0) + 1)) * ((n : ℝ≥0) + 1) = ((n : ℝ≥0) + 1) * t + 1 := by
    rw [add_mul, one_div, inv_mul_cancel₀ hpos.ne', mul_comm]
  rw [h1]
  exact (Nat.ceil_lt_add_one zero_le).le

theorem tendsto_ratAbove (t : ℝ≥0) :
    Tendsto (fun n => ((ratAbove t n : ℚ≥0) : ℝ≥0)) atTop (𝓝 t) := by
  have h : Tendsto (fun n : ℕ => t + 1 / ((n : ℝ≥0) + 1)) atTop (𝓝 (t + 0)) :=
    tendsto_const_nhds.add tendsto_one_div_add_atTop_nhds_zero_nat
  rw [add_zero] at h
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h (le_ratAbove t)
    (ratAbove_le t)

/-- The extension of rational-time values to all times (`limsup` along the rational times `ratAbove t n ↓ t`): it is
measurable and recovers every continuous path from its rational values. -/
def extendRat (v : ℚ≥0 → ℝ) (t : ℝ≥0) : ℝ := limsup (fun n => v (ratAbove t n)) atTop

theorem measurable_extendRat : Measurable extendRat :=
  measurable_pi_iff.2 fun _ => Measurable.limsup fun _ => measurable_pi_apply _

theorem extendRat_eq {w : ℝ≥0 → ℝ} (hw : Continuous w) : extendRat (fun q : ℚ≥0 => w q) = w :=
  funext fun t => ((hw.tendsto t).comp (tendsto_ratAbove t)).limsup_eq

/-- The rational-time transience condition on the measurable trace evaluations. -/
def ratTransientSet : Set (ℚ≥0 → ℝ) :=
  ⋂ M : ℕ, ⋃ N : ℕ, ⋂ q : ℚ≥0, {v | (N : ℚ≥0) ≤ q → (M : ℝ) ≤ ‖LP.traceAt q (extendRat v)‖}

theorem measurableSet_ratTransientSet : MeasurableSet ratTransientSet := by
  refine MeasurableSet.iInter fun M => MeasurableSet.iUnion fun N => MeasurableSet.iInter fun q => ?_
  by_cases hq : (N : ℚ≥0) ≤ q
  · simp only [hq, forall_const]
    exact measurableSet_le measurable_const
      ((LP.measurable_traceAt (q : ℝ≥0)).comp measurable_extendRat).norm
  · simp only [hq, IsEmpty.forall_iff, ofPred_true, MeasurableSet.univ]

/-- **The transient-trace coding from the trace coding**: transience of a continuous trace is a countable condition on
its rational-time values, which are measurable functions of the driver (`LP.traceAt`). -/
theorem transientTraceCodingStatement_of_top (h : TopTraceCodingStatement) :
    TransientTraceCodingStatement := by
  obtain ⟨G, hG, hGp⟩ := h
  refine ⟨G ∩ ratTransientSet, hG.inter measurableSet_ratTransientSet, fun w hw hw0 => ?_⟩
  rw [mem_inter_iff, hGp w hw hw0]
  have hmem : (fun q : ℚ≥0 => w q) ∈ ratTransientSet ↔
      ∀ M : ℕ, ∃ N : ℕ, ∀ q : ℚ≥0, (N : ℚ≥0) ≤ q → (M : ℝ) ≤ ‖LP.traceAt q w‖ := by
    simp only [ratTransientSet, mem_iInter, mem_iUnion, mem_ofPred_eq, extendRat_eq hw]
  rw [hmem]
  constructor
  · rintro ⟨⟨η, hη⟩, hrat⟩
    have htr : ∀ q : ℚ≥0, LP.traceAt q w = η q := fun q =>
      LP.traceAt_eq_of_isGeneratingTrace hη hw.continuousOn hw0 ENNReal.coe_lt_top
    refine ⟨η, hη, tendsto_atTop_atTop.2 fun b => ?_⟩
    obtain ⟨M, hM⟩ := exists_nat_ge b
    obtain ⟨N, hN⟩ := hrat M
    refine ⟨N, fun t ht => hM.trans ?_⟩
    have hηc : Continuous η := continuousOn_univ.1 (by simpa using hη.2.1)
    have hlim := ((hηc.norm.tendsto t).comp (tendsto_ratAbove t))
    refine ge_of_tendsto hlim (Eventually.of_forall fun n => ?_)
    have hq : (N : ℚ≥0) ≤ ratAbove t n := by
      rw [← NNRat.cast_le (K := ℝ≥0), NNRat.cast_natCast]
      exact ht.trans (le_ratAbove t n)
    have := hN _ hq
    rwa [htr] at this
  · rintro ⟨η, hη, htend⟩
    refine ⟨⟨η, hη⟩, fun M => ?_⟩
    obtain ⟨N₀, hN₀⟩ := tendsto_atTop_atTop.1 htend M
    obtain ⟨N, hN⟩ := exists_nat_ge N₀
    refine ⟨N, fun q hq => ?_⟩
    rw [LP.traceAt_eq_of_isGeneratingTrace hη hw.continuousOn hw0 ENNReal.coe_lt_top]
    refine hN₀ q (hN.trans ?_)
    rw [← NNRat.cast_natCast (α := ℝ≥0)]
    exact NNRat.cast_le.2 hq

/-! ### Proposition 7.3, trace part -/

/-- **Proposition 7.3, trace part** (p. 242), in the form `Prop73TraceStatement` used by the κ < 4 induction: "The
embedded construction has produced one pair […] Integrated driving uniqueness transfers its continuous simple trace
and transience to the stated two-seed driving law. Since both seed weights exceed `−2`, that evolution has infinite
lifetime." Conditional helper: the embedded reference (Lemma 7.1), the coding of the trace event and the Jacobi
diffusion are its inputs; the transfer through Theorem 2.2's two-seed uniqueness is proved. -/
theorem prop73TraceStatement_of_inputs (hJ : JacobiDiffusionExistsStatement)
    (hcode : TransientTraceCodingStatement) (href : Lemma71TraceReferenceStatement.{v}) :
    Prop73TraceStatement.{u} := by
  intro κ hκ hκ4 xL xR ρL ρR hxL hxR hρL hρR Ω mΩ P _ 𝓕 W VL VR B ζ hE
  obtain rfl : xL = fun _ => 0 := funext hxL
  obtain rfl : xR = fun _ => 0 := funext hxR
  have hρL' : ρL = fun _ => ρL 0 := funext fun i => by rw [Subsingleton.elim i 0]
  have hρR' : ρR = fun _ => ρR 0 := funext fun i => by rw [Subsingleton.elim i 0]
  obtain ⟨Ω₀, m₀, P₀, hP₀, 𝓕₀, W₀, VL₀, VR₀, B₀, ζ₀, hE₀, htr₀⟩ :=
    href κ hκ hκ4 (ρL 0) (ρR 0) (hρL 0) (hρR 0)
  obtain ⟨G, hG, hGp⟩ := hcode
  rw [← hρL', ← hρR'] at hE₀
  have hζ₀ := ae_lifetime_eq_top_twoSeed hκ (hρL 0) (hρR 0) hJ hE₀
  have hζ := ae_lifetime_eq_top_twoSeed hκ (hρL 0) (hρR 0) hJ hE
  rw [hasTransientGeneratingTrace_iff_of_top hζ]
  exact ae_transfer_of_coding hκ (hρL 0) (hρR 0) hJ hG hGp hE₀
    ((hasTransientGeneratingTrace_iff_of_top hζ₀).1 htr₀) hE

/-! ### The one-force seed case -/

/-- **The one-force seed case on the right, from Proposition 7.3** (p. 378: "The one-force seed case is part of that
theorem"): for `0 < κ < 4`, one mark at `0⁺` with weight `ρ > −2` gives a complete force word. A two-seed evolution
with weights `(0; ρ)` exists (Theorem 2.2), has a transient trace (Proposition 7.3) and infinite lifetime; forgetting
its zero-weight left mark gives a one-mark evolution, and Theorem 2.2's one-force uniqueness transfers the trace. -/
theorem isCompleteForceWord_seedRight (hJ : JacobiDiffusionExistsStatement)
    (hcode : TransientTraceCodingStatement) (h73 : Prop73TraceStatement.{0}) {κ : ℝ} (hκ : 0 < κ)
    (hκ4 : κ < 4) (xL : Fin 0 → ℝ) (xR : Fin 1 → ℝ) (ρL : Fin 0 → ℝ) (ρR : Fin 1 → ℝ)
    (hxR : ∀ i, xR i = 0) (hρR : ∀ i, -2 < ρR i) : LP.IsCompleteForceWord.{u} κ xL xR ρL ρR := by
  intro Ω mΩ P _ 𝓕 W VL VR B ζ hE
  obtain rfl : xR = fun _ => 0 := funext hxR
  -- a two-seed evolution with left weight `0` (Theorem 2.2's existence)
  obtain ⟨Ω₀, m₀, P₀, hP₀, 𝓕₀, W₀, VL₀, VR₀, B₀, ζ₀, hE₀⟩ :=
    Sec2.exists_isIntegratedSLEEvolution_twoSeed_of_jacobiExists hκ (hJ κ · · hκ)
      (xL := fun _ => 0) (xR := fun _ => 0) (fun _ => rfl) (fun _ => rfl) (fun _ => 0) ρR
  -- its trace (Proposition 7.3) and its infinite lifetime
  have htr₀ := h73 κ hκ hκ4 (fun _ => 0) (fun _ => 0) (fun _ => 0) ρR (fun _ => rfl) (fun _ => rfl)
    (fun _ => by norm_num) hρR P₀ 𝓕₀ W₀ VL₀ VR₀ B₀ ζ₀ hE₀
  have hζ₀ : ∀ᵐ ω ∂P₀, ζ₀ ω = ⊤ :=
    ae_lifetime_eq_top_twoSeed (ρL := fun _ => 0) hκ (by norm_num) (hρR 0) hJ hE₀
  -- forgetting the zero-weight mark gives a one-mark evolution
  have hE₁ := IsIntegratedSLEEvolution.forgetLeft_of_top (fun _ => rfl) hE₀ hζ₀ xL ρL
    (fun i => i.elim0)
  have hζ : ∀ᵐ ω ∂P, ζ ω = ⊤ := ae_lifetime_eq_top_oneForceRight hκ le_rfl (hρR 0) hE
  have hF : IsOrderedForceWord xL (fun _ : Fin 1 => (0 : ℝ)) :=
    ⟨fun i => i.elim0, fun i => i.elim0, fun _ _ _ => le_rfl, fun _ => le_rfl⟩
  have hK : KilledStateLawEq P₀ W₀ (fun i => i.elim0) VR₀ B₀ ζ₀ P W VL VR B ζ :=
    fun n ts A hA => OneForce.measure_killedState_eq_right hκ hF hE₁ hE n ts A hA
  obtain ⟨G, hG, hGp⟩ := hcode
  rw [hasTransientGeneratingTrace_iff_of_top hζ]
  exact ae_transfer_of_killedState (p := IsTransientDriver) hG hGp hE₁ hζ₀
    ((hasTransientGeneratingTrace_iff_of_top hζ₀).1 htr₀) hE hζ hK

/-- **The one-force seed case** in the form `SeedOneForceTraceStatement` used by the κ < 4 induction, from
Proposition 7.3 (at universe `0`, where Theorem 2.2's existence produces the two-seed evolution), the coding of the
trace event and the Jacobi diffusion. The left seed is the reflection of the right one (`isCompleteForceWord_reflect_iff`).
-/
theorem seedOneForceTraceStatement_of_prop73 (hJ : JacobiDiffusionExistsStatement)
    (hcode : TransientTraceCodingStatement) (h73 : Prop73TraceStatement.{0}) :
    SeedOneForceTraceStatement.{u} := by
  intro κ hκ hκ4 nL nR xL xR ρL ρR hN hxL hxR hρL hρR
  rcases (by omega : (nL = 0 ∧ nR = 1) ∨ (nL = 1 ∧ nR = 0)) with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact isCompleteForceWord_seedRight hJ hcode h73 hκ hκ4 xL xR ρL ρR hxR hρR
  · refine LP.isCompleteForceWord_reflect_iff.1 ?_
    exact isCompleteForceWord_seedRight hJ hcode h73 hκ hκ4 (-xR) (-xL) ρR ρL
      (fun i => by simp [hxL i]) hρL

/-- **The one-force seed case from the embedded reference** (Proposition 7.3 at universe `0`, then
`seedOneForceTraceStatement_of_prop73`). -/
theorem seedOneForceTraceStatement_of_inputs (hJ : JacobiDiffusionExistsStatement)
    (hcode : TransientTraceCodingStatement) (href : Lemma71TraceReferenceStatement.{v}) :
    SeedOneForceTraceStatement.{u} :=
  seedOneForceTraceStatement_of_prop73 hJ hcode (prop73TraceStatement_of_inputs hJ hcode href : Prop73TraceStatement.{0})

/-- **Proposition 7.3, trace part, from the embedded reference** with the trace-only coding (`TopTraceCodingStatement`;
its transience part is `transientTraceCodingStatement_of_top`). -/
theorem prop73TraceStatement_of_lemma71 (hJ : JacobiDiffusionExistsStatement)
    (hcode : TopTraceCodingStatement) (href : Lemma71TraceReferenceStatement.{v}) :
    Prop73TraceStatement.{u} :=
  prop73TraceStatement_of_inputs hJ (transientTraceCodingStatement_of_top hcode) href

/-- **The one-force seed case from the embedded reference** with the trace-only coding. -/
theorem seedOneForceTraceStatement_of_lemma71 (hJ : JacobiDiffusionExistsStatement)
    (hcode : TopTraceCodingStatement) (href : Lemma71TraceReferenceStatement.{v}) :
    SeedOneForceTraceStatement.{u} :=
  seedOneForceTraceStatement_of_inputs hJ (transientTraceCodingStatement_of_top hcode) href

