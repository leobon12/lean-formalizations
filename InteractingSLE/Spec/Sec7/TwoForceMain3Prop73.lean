theorem revisedInductionLtFourStatement_of_lemma71 (hJ : JacobiDiffusionExistsStatement)
    (hcode : TopTraceCodingStatement) (href : Lemma71TraceReferenceStatement.{v})
    (h99 : Aux99Statement.{u}) (h106 : Aux106Statement.{u}) (h113 : Aux113Statement.{u})
