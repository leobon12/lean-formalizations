import InteractingSLE.Spec.Sec7.LocalExtNCode

/-!
# Aux. lemma 54, (Loc) after the stop: two measure-theoretic tools

Packet PROVE-LOCEXT-N.

* `ae_preimage_eq_of_coord` / `map_eq_of_ae_coord`: two maps into `β × (ι → ℝ)` (product σ-algebra, `ι` arbitrary)
  whose first components agree almost surely and whose coordinates agree almost surely one at a time have the same law
  (a measurable set of `ι → ℝ` is generated by cylinders, which read finitely many coordinates). Used for the record
  `(history, field off the hull)`, whose field part is a.s. equal only test function by test function.
* `integral_mul_eq_of_indepFun_condExp`: if `Z` is independent of `W`, a conditional expectation `ã(v(W))` of
  `a(W)` given `v(W)` may replace `a(W)` in `E[a(W) Φ(Z, v(W))]` (Fubini over the product law, and the pull-out
  property for each fixed value of `Z`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology

namespace InteractingSLE

namespace LocalExt

/-! ### Laws from coordinatewise almost sure equality -/

section Coord

variable {α β ι : Type*} [MeasurableSpace α] [MeasurableSpace β] {μ : Measure α}

theorem ae_preimage_eq_of_coord {g₁ g₂ : α → ι → ℝ} (h2 : ∀ i, ∀ᵐ a ∂μ, g₁ a i = g₂ a i) {t : Set (ι → ℝ)}
    (ht : MeasurableSet t) : g₁ ⁻¹' t =ᵐ[μ] g₂ ⁻¹' t := by
  classical
  have hgen : (MeasurableSpace.pi : MeasurableSpace (ι → ℝ)) =
      MeasurableSpace.generateFrom (measurableCylinders fun _ : ι => ℝ) := generateFrom_measurableCylinders.symm
  refine MeasurableSpace.induction_on_inter (m := MeasurableSpace.pi)
    (C := fun t _ => g₁ ⁻¹' t =ᵐ[μ] g₂ ⁻¹' t) hgen isPiSystem_measurableCylinders (by simp) ?_ ?_ ?_ t ht
  · intro c hc
    obtain ⟨I, S, -, rfl⟩ := (mem_measurableCylinders c).1 hc
    have hall : ∀ᵐ a ∂μ, ∀ i ∈ I, g₁ a i = g₂ a i := (I.eventually_all).2 fun i _ => h2 i
    filter_upwards [hall] with a ha
    have e : (fun i : I => g₁ a i) = fun i : I => g₂ a i := funext fun i => ha i i.2
    change (g₁ a ∈ cylinder I S) = (g₂ a ∈ cylinder I S)
    simp only [mem_cylinder]
    rw [show I.restrict (g₁ a) = I.restrict (g₂ a) from e]
  · intro t _ ht'
    rw [preimage_compl, preimage_compl]
    exact ht'.compl
  · intro f _ _ hf
    rw [preimage_iUnion, preimage_iUnion]
    exact EventuallyEqSet.countable_iUnion hf

/-- **Coordinatewise almost sure equality gives equality of laws.** -/
theorem map_eq_of_ae_coord [IsFiniteMeasure μ] {f₁ f₂ : α → β × (ι → ℝ)} (hf₁ : Measurable f₁)
    (hf₂ : Measurable f₂) (h1 : ∀ᵐ a ∂μ, (f₁ a).1 = (f₂ a).1) (h2 : ∀ i, ∀ᵐ a ∂μ, (f₁ a).2 i = (f₂ a).2 i) :
    μ.map f₁ = μ.map f₂ := by
  refine ext_of_generate_finite _ generateFrom_prod.symm isPiSystem_prod ?_ ?_
  · rintro _ ⟨s, hs, t, ht, rfl⟩
    rw [Measure.map_apply hf₁ (hs.prod ht), Measure.map_apply hf₂ (hs.prod ht)]
    refine measure_congr ?_
    have ht' := ae_preimage_eq_of_coord (g₁ := fun a => (f₁ a).2) (g₂ := fun a => (f₂ a).2) h2 ht
    have hs' : (fun a => (f₁ a).1) ⁻¹' s =ᵐ[μ] (fun a => (f₂ a).1) ⁻¹' s := by
      filter_upwards [h1] with a ha
      change ((f₁ a).1 ∈ s) = ((f₂ a).1 ∈ s)
      rw [ha]
    have e : ∀ f : α → β × (ι → ℝ), f ⁻¹' (s ×ˢ t) = (fun a => (f a).1) ⁻¹' s ∩ (fun a => (f a).2) ⁻¹' t :=
      fun f => rfl
    rw [e, e]
    exact hs'.inter ht'
  · rw [Measure.map_apply hf₁ MeasurableSet.univ, Measure.map_apply hf₂ MeasurableSet.univ, preimage_univ,
      preimage_univ]

end Coord

/-! ### Conditional expectations inside an independent product -/

section Cond

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- The pull-out property for a bounded complex weight. -/
theorem integral_mul_condExp_eq {m : MeasurableSpace Ω} (hm : m ≤ mΩ) {B A : Ω → ℂ}
    (hB : StronglyMeasurable[m] B) (hBb : ∀ ω, ‖B ω‖ ≤ 1) (hA : Integrable A P) :
    ∫ ω, B ω * A ω ∂P = ∫ ω, B ω * (P[A | m]) ω ∂P := by
  set L : ℂ →L[ℝ] ℂ →L[ℝ] ℂ := ContinuousLinearMap.mul ℝ ℂ
  have hL : ∀ x y : ℂ, L x y = x * y := fun _ _ => rfl
  have hint : Integrable (fun ω => L (B ω) (A ω)) P := by
    simp only [hL]
    exact hA.bdd_mul (c := 1) (hB.mono hm).aestronglyMeasurable (Eventually.of_forall hBb)
  have hpull := condExp_bilin_of_stronglyMeasurable_left L hB hint hA
  rw [← integral_condExp hm (f := fun ω => B ω * A ω)]
  refine integral_congr_ae ?_
  filter_upwards [hpull] with ω hω
  rw [← hL]
  exact hω

/-- **A conditional expectation may replace a factor inside an independent product.** If `Z ⫫ W`, `a` is bounded
and `ã(v(W))` is a version of `E[a(W) | v(W)]`, then `E[a(W) Φ(Z, v(W))] = E[ã(v(W)) Φ(Z, v(W))]` for every bounded
measurable `Φ`. -/
theorem integral_mul_eq_of_indepFun_condExp {β γ δ : Type*} [MeasurableSpace β] [MeasurableSpace γ]
    [MeasurableSpace δ] {Z : Ω → β} {W : Ω → γ} (hZ : Measurable Z) (hW : Measurable W) (hind : IndepFun Z W P)
    {a : γ → ℂ} (ha : Measurable a) (hab : ∀ w, ‖a w‖ ≤ 1) {v : γ → δ} (hv : Measurable v) {ã : δ → ℂ}
    (hã : Measurable ã) (hãb : ∀ x, ‖ã x‖ ≤ 1)
    (hãe : P[fun ω => a (W ω) | MeasurableSpace.comap (fun ω => v (W ω)) inferInstance] =ᵐ[P]
      fun ω => ã (v (W ω)))
    {Φ : β × δ → ℂ} (hΦ : Measurable Φ) (hΦb : ∀ x, ‖Φ x‖ ≤ 1) :
    ∫ ω, a (W ω) * Φ (Z ω, v (W ω)) ∂P = ∫ ω, ã (v (W ω)) * Φ (Z ω, v (W ω)) ∂P := by
  have hprod := (indepFun_iff_map_prod_eq_prod_map_map hZ.aemeasurable hW.aemeasurable).1 hind
  have key : ∀ F : β × γ → ℂ, Measurable F → (∀ x, ‖F x‖ ≤ 1) →
      ∫ ω, F (Z ω, W ω) ∂P = ∫ z, (∫ ω, F (z, W ω) ∂P) ∂(P.map Z) := by
    intro F hF hFb
    have hint : Integrable F ((P.map Z).prod (P.map W)) :=
      Integrable.of_bound hF.aestronglyMeasurable 1 (Eventually.of_forall hFb)
    rw [← integral_map (hZ.prodMk hW).aemeasurable hF.aestronglyMeasurable, hprod, integral_prod F hint]
    refine integral_congr_ae (Eventually.of_forall fun z => ?_)
    exact integral_map hW.aemeasurable (hF.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable
  have hF₁ : Measurable fun x : β × γ => a x.2 * Φ (x.1, v x.2) :=
    (ha.comp measurable_snd).mul (hΦ.comp (measurable_fst.prodMk (hv.comp measurable_snd)))
  have hF₂ : Measurable fun x : β × γ => ã (v x.2) * Φ (x.1, v x.2) :=
    (hã.comp (hv.comp measurable_snd)).mul (hΦ.comp (measurable_fst.prodMk (hv.comp measurable_snd)))
  have hb : ∀ (c d : ℂ), ‖c‖ ≤ 1 → ‖d‖ ≤ 1 → ‖c * d‖ ≤ 1 := fun c d hc hd => by
    rw [norm_mul]; exact (mul_le_mul hc hd (norm_nonneg _) zero_le_one).trans (by norm_num)
  rw [key _ hF₁ fun x => hb _ _ (hab _) (hΦb _), key _ hF₂ fun x => hb _ _ (hãb _) (hΦb _)]
  refine integral_congr_ae (Eventually.of_forall fun z => ?_)
  simp only
  have hm : MeasurableSpace.comap (fun ω => v (W ω)) inferInstance ≤ mΩ := (hv.comp hW).comap_le
  have hBm : StronglyMeasurable[MeasurableSpace.comap (fun ω => v (W ω)) inferInstance]
      (fun ω => Φ (z, v (W ω))) :=
    ((hΦ.comp (measurable_const.prodMk measurable_id)).comp (comap_measurable _)).stronglyMeasurable
  have hA : Integrable (fun ω => a (W ω)) P :=
    Integrable.of_bound (ha.comp hW).aestronglyMeasurable 1 (Eventually.of_forall fun ω => hab _)
  have := integral_mul_condExp_eq hm hBm (fun ω => hΦb _) hA
  rw [show (fun ω => a (W ω) * Φ (z, v (W ω))) = fun ω => Φ (z, v (W ω)) * a (W ω) from
    funext fun ω => mul_comm _ _, this]
  refine integral_congr_ae ?_
  filter_upwards [hãe] with ω hω
  rw [hω, mul_comm]

end Cond

end LocalExt

end InteractingSLE
