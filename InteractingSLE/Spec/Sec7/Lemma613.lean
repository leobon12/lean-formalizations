import InteractingSLE.Spec.Sec7.Lemma613Side
import InteractingSLE.Spec.Sec7.Lemma613Geom
import InteractingSLE.Spec.Sec7.Lemma71HInputs

/-!
# Lemma 6.13: two ordered flow lines share no arc ((MD1) excluded)

Packet PROVE-LEMMA71J (specification §6.3, Lemma 6.13 and its proof, pp. 215–217,
`source/spec/p193-240.md#lem-6.13-proof`): "If it had nonempty interior with positive probability, some fixed
rational `0 < a < b < ∞` would satisfy `P[η_{θ₁}([a, b]) ⊆ η_{θ₂}] > 0` (MD1). […] The common-component case of
Proposition 3.8 therefore gives `𝒞_{η_{θ₁} ∪ η_{θ₂}}(z) − 𝒞_{η_{θᵢ}}(z) → 0` (MD2) […] the conditional mean of the
union has continuous boundary value both `λ − θ₁χ` and `λ − θ₂χ` on the corresponding real interval. Since `χ > 0` and
`θ₁ < θ₂`, these values differ, a contradiction."

This proves the named input `Lemma71I.Lemma613ContactStatement` (`lemma613ContactStatement_of_prop55`) from the two
inputs already used by the three-curve space of Lemma 7.1: the §4.2 reference `Lemma71H.Cond44ReferenceStatement`
(through `Lemma75Bridge.exists_flowLineMap_of_admissible`, the determination of each flow line; ruling R43: the
all-words Lemma 7.5 is not used) and Proposition 5.5 in `ℍ` (`Lemma71H.Prop55HalfPlaneStatement`, the order of the two
flow lines, which the source's proof uses as "the full, simple, ordered […] curves of this subsection").

## The proof (`ae_noCommonArc_of_maps`)

On a probability-one event (all caps `m`, all rational stops):
1. both flow lines are simple proper curves from `0` with infinite lifetime (`IsFlowLine.ae_isSimpleProper_angle`),
   generated by continuous drivers, ordered;
2. for capped versions with Lemma 6.2's hypotheses (`exists_twoHist_versions_of_maps`), every stopped prefix has its
   single-path side heights (`sideHeight_of_map`) and every pair of stopped prefixes Proposition 3.8
   (`Sec7.ae_tendsto_sub_explored_const`).

Pathwise: a common arc gives the collar (`exists_sameArc_of_not`); the right side of `η_{θ₁}` approaches the common
point from the joint unbounded domain with both charts positive and the lifts agreeing (`sameArc_chart`); Proposition
3.8 twice makes the two single means agree there (`Sec7.tendsto_sub_of_union_means`), so `λ − θ₁χ = λ − θ₂χ`
(`Sec7.eq_of_side_limits`), contradicting `θ₁ < θ₂`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set TopologicalSpace Topology Metric
open scoped NNReal ENNReal Real

universe u

namespace InteractingSLE.Sec7.Lemma613

open QuantumZipper (H chiC)
open LQGMetric (DistOn TestOn)
open LocalSets Sec6 Lemma71I

/-- The stops of the first prefix alone. -/
abbrev stopA (r : ℚ≥0) : Fin 2 → ℝ≥0∞ := ![(((r : ℝ≥0)) : ℝ≥0∞), 0]

/-- The stops of the second prefix alone. -/
abbrev stopB (r : ℚ≥0) : Fin 2 → ℝ≥0∞ := ![0, (((r : ℝ≥0)) : ℝ≥0∞)]

section Main

variable {κ a b θ : ℝ} {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens} {η : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞}

/-- **The determination map of one flow line of Figure 7.1 from the §4.2 reference** (Lemma 7.5 for this flow-line
word, in the non-boundary regime (4.4): `Lemma75Bridge.exists_flowLineMap_of_admissible`). -/
theorem exists_map_of_cond44 (href : Lemma71H.Cond44ReferenceStatement.{u}) (hκ : 0 < κ) (hκ4 : κ < 4)
    (ha : sleLambda κ - π * chiC κ + θ * chiC κ ≤ a) (hb : sleLambda κ - θ * chiC κ ≤ b)
    (hh : IsGFFWithBoundaryData P h (prop74Data a b) ((({0} : Finset ℝ)) : Set ℝ))
    (hη : IsFlowLine κ (prop74Data a b) {0} 0 θ P h η ζ) :
    ∃ Φ : DistOn upperHalfPlaneOpens → ℝ≥0∞ × (ℝ≥0 → ℂ), Measurable Φ ∧
      ∀ᵐ ω ∂P, (Φ (h ω)).1 = ζ ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ ζ ω → (Φ (h ω)).2 t = η ω t := by
  have hF := Theorem15.isOrderedForceWord_flowLine (prop74Data a b) {0} 0
  have h44 := Lemma71H.cond44_flowLine_prop74Data (θ := θ) hκ (a := a) (b := b) ha hb
  have hadm := Sec4.hasAdmissiblePartialSums_of_cond44 hκ4 hF h44
  obtain ⟨Φ, hΦm, hΦ⟩ := Lemma75Bridge.exists_flowLineMap_of_admissible hκ hκ4.le hadm
    (href κ hκ hκ4 _ _ _ _ hF h44)
  exact ⟨Φ, hΦm, hΦ P h hh η ζ hη⟩

end Main

section Contact

variable {κ a b θ₁ θ₂ : ℝ} {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞}

/-- **Lemma 6.13's exclusion of (MD1) for two ordered flow lines with determination maps.** For `0 < κ < 4`, the data
of Figure 7.1 with Proposition 5.5's bounds (5.2), two flow lines `η₁`, `η₂` from `0` of angles `θ₁ < θ₂`, each read
off the field by a Borel map, and almost surely ordered (`η₂` in the closed left side of `η₁`): almost surely they
share no nondegenerate parameter arc, in either parametrization. -/
theorem ae_noCommonArc_of_maps (hκ : 0 < κ) (hκ4 : κ < 4) (hθ : θ₁ < θ₂)
    (hb : sleLambda κ - θ₁ * chiC κ ≤ b) (ha : sleLambda κ - π * chiC κ + θ₂ * chiC κ ≤ a)
    (hh : IsGFFWithBoundaryData P h (prop74Data a b) ((({0} : Finset ℝ)) : Set ℝ))
    (hη₁ : IsFlowLine κ (prop74Data a b) {0} 0 θ₁ P h η₁ ζ₁)
    (hη₂ : IsFlowLine κ (prop74Data a b) {0} 0 θ₂ P h η₂ ζ₂)
    (hΦ₁ : ∃ Φ : DistOn upperHalfPlaneOpens → ℝ≥0∞ × (ℝ≥0 → ℂ), Measurable Φ ∧
      ∀ᵐ ω ∂P, (Φ (h ω)).1 = ζ₁ ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ ζ₁ ω → (Φ (h ω)).2 t = η₁ ω t)
    (hΦ₂ : ∃ Φ : DistOn upperHalfPlaneOpens → ℝ≥0∞ × (ℝ≥0 → ℂ), Measurable Φ ∧
      ∀ᵐ ω ∂P, (Φ (h ω)).1 = ζ₂ ω ∧ ∀ t : ℝ≥0, (t : ℝ≥0∞) ≤ ζ₂ ω → (Φ (h ω)).2 t = η₂ ω t)
    (hord : ∀ᵐ ω ∂P, ζ₁ ω = ⊤ → ζ₂ ω = ⊤ → range (η₂ ω) ⊆ closedLeftSide (η₁ ω)) :
    ∀ᵐ ω ∂P, NoCommonArc (η₁ ω) (η₂ ω) ∧ NoCommonArc (η₂ ω) (η₁ ω) := by
  classical
  set χ := chiC κ with hχ
  have hχpos : 0 < χ := Sec4.chiC_pos hκ hκ4
  have hbpc := isPiecewiseConstant_prop74Data a b
  obtain ⟨u₀, hu₀, -⟩ := PiecewiseConstant.existsUnique_isBoundedHarmonicExtension hbpc
  have hh0 := Restart.isZeroBoundaryGFF_centredField_of_isGFFWithBoundaryData hh hu₀
  set hc' := WholeField.centredField h u₀ with hc'def
  -- simplicity and infinite lifetimes
  have hπχ : 0 ≤ π * χ := mul_nonneg Real.pi_pos.le hχpos.le
  have hb41 : sleLambda κ - π * χ - θ₁ * χ ≤ b := by linarith
  obtain ⟨hL₁, hR₁⟩ := Lemma71G.prop74Data_remark41 hκ hκ4 le_rfl hθ.le ha hb41
  obtain ⟨hL₂, hR₂⟩ := Lemma71G.prop74Data_remark41 hκ hκ4 hθ.le le_rfl ha hb41
  have hsp₁ := IsFlowLine.ae_isSimpleProper_angle hκ hκ4.le hbpc hL₁ hR₁ hη₁
  have hsp₂ := IsFlowLine.ae_isSimpleProper_angle hκ hκ4.le hbpc hL₂ hR₂ hη₂
  -- the drivers
  obtain ⟨_, _, W₁, _, _, _, -, hcoup₁, htr₁⟩ := id hη₁
  obtain ⟨_, _, W₂, _, _, _, -, hcoup₂, htr₂⟩ := id hη₂
  -- capped versions with Lemma 6.2's hypotheses, for every cap
  choose ηs hc h0 hηm hdet hloc hfr him hv₁ hv₂ using fun m : ℕ =>
    exists_twoHist_versions_of_maps hκ hκ4 hbpc hh hη₁ hη₂ hΦ₁ hΦ₂ hu₀ (m : ℝ≥0)
  have hx0 : ∀ i, ((![((0 : ℝ) : ℂ), ((0 : ℝ) : ℂ)] : Fin 2 → ℂ) i).im = 0 := by
    intro i; fin_cases i <;> simp
  have hηs0 : ∀ m i ω, (ηs m i ω 0).im = 0 := fun m i ω => by rw [h0 m i ω]; exact hx0 i
  -- the local-set means at every pair of deterministic stops
  have hmean : ∀ (m : ℕ) (s : Fin 2 → ℝ≥0∞), ∃ g, IsLocalSetMean (explored (ηs m) fun i _ => s i) hc' P g :=
    fun m s => IsLocalSet.exists_isLocalSetMean hh0 (measurable_explored_const (hc m) (hηm m) s)
      (isLocalSet_explored_const hh0 (hc m) (h0 m) (hηm m) (hdet m) (hloc m) (hfr m) s)
  choose G hG using hmean
  have hA₁ : ∀ (m : ℕ) (r : ℚ≥0) ω, explored (ηs m) (fun i _ => stopA r i) ω =
      ηs m 0 ω '' {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H := fun m r ω =>
    explored_pair_left (ηs m) _ (hηs0 m 1 ω)
  have hA₂ : ∀ (m : ℕ) (r : ℚ≥0) ω, explored (ηs m) (fun i _ => stopB r i) ω =
      ηs m 1 ω '' {t : ℝ≥0 | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H := fun m r ω =>
    explored_pair_right (ηs m) _ (hηs0 m 0 ω)
  have hgA : ∀ (m : ℕ) (r : ℚ≥0), IsLocalSetMean (fun ω => ηs m 0 ω '' {t | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H) hc' P
      (G m (stopA r)) := fun m r => by
    have e : (fun ω => ηs m 0 ω '' {t | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H) = explored (ηs m) (fun i _ => stopA r i) :=
      funext fun ω => (hA₁ m r ω).symm
    rw [e]
    exact hG m _
  have hgB : ∀ (m : ℕ) (r : ℚ≥0), IsLocalSetMean (fun ω => ηs m 1 ω '' {t | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H) hc' P
      (G m (stopB r)) := fun m r => by
    have e : (fun ω => ηs m 1 ω '' {t | (t : ℝ≥0∞) ≤ (r : ℝ≥0)} ∩ H) = explored (ηs m) (fun i _ => stopB r i) :=
      funext fun ω => (hA₂ m r ω).symm
    rw [e]
    exact hG m _
  -- the single-path side heights at every cap and rational stop
  have hN₁ := fun (m : ℕ) (r : ℚ≥0) (hrm : (r : ℝ≥0) ≤ (m : ℝ≥0)) =>
    sideHeight_of_map hκ hκ4 hbpc hh hη₁ hΦ₁ W₁ htr₁ hu₀ (m : ℝ≥0) (r : ℝ≥0) hrm (ηs m 0) (hc m 0) (hηm m 0)
      (hv₁ m) (G m (stopA r)) (hgA m r)
  have hN₂ := fun (m : ℕ) (r : ℚ≥0) (hrm : (r : ℝ≥0) ≤ (m : ℝ≥0)) =>
    sideHeight_of_map hκ hκ4 hbpc hh hη₂ hΦ₂ W₂ htr₂ hu₀ (m : ℝ≥0) (r : ℝ≥0) hrm (ηs m 1) (hc m 1) (hηm m 1)
      (hv₂ m) (G m (stopB r)) (hgB m r)
  have hN₁' := ae_all_iff.2 fun m => ae_all_iff.2 fun r => Filter.eventually_imp_distrib_left.2 (hN₁ m r)
  have hN₂' := ae_all_iff.2 fun m => ae_all_iff.2 fun r => Filter.eventually_imp_distrib_left.2 (hN₂ m r)
  -- Proposition 3.8 at every cap and pair of rational stops
  have hmc : ∀ r₁ r₂ : ℚ≥0, (fun (i : Fin 2) (_ : Ω) => max (stopB r₂ i) (stopA r₁ i)) =
      fun i _ => max (stopA r₁ i) (stopB r₂ i) := fun _ _ => by
    funext i _
    exact max_comm _ _
  have hPa := fun (m : ℕ) (r₁ r₂ : ℚ≥0) =>
    ae_tendsto_sub_explored_const hh0 (hc m) (h0 m) hx0 (hηm m) (hdet m) (hloc m) (hfr m) (him m) (stopB r₂)
      (stopA r₁) (g := G m (fun i => max (stopA r₁ i) (stopB r₂ i))) (by rw [hmc]; exact hG m _) (hG m _)
  have hPb := fun (m : ℕ) (r₁ r₂ : ℚ≥0) =>
    ae_tendsto_sub_explored_const hh0 (hc m) (h0 m) hx0 (hηm m) (hdet m) (hloc m) (hfr m) (him m) (stopA r₁)
      (stopB r₂) (hG m (fun i => max (stopA r₁ i) (stopB r₂ i))) (hG m _)
  have hPa' := ae_all_iff.2 fun m => ae_all_iff.2 fun r₁ => ae_all_iff.2 fun r₂ => hPa m r₁ r₂
  have hPb' := ae_all_iff.2 fun m => ae_all_iff.2 fun r₁ => ae_all_iff.2 fun r₂ => hPb m r₁ r₂
  have hR₁' := ae_all_iff.2 fun m => ae_all_iff.2 fun r => (hG m (stopA r)).2.1
  have hR₂' := ae_all_iff.2 fun m => ae_all_iff.2 fun r => (hG m (stopB r)).2.1
  -- the probability-one event
  filter_upwards [hsp₁, hsp₂, htr₁, htr₂, hcoup₁.1.2.2.2.2, hcoup₂.1.2.2.2.2, hord, ae_all_iff.2 hv₁,
    ae_all_iff.2 hv₂, hN₁', hN₂', hPa', hPb', hR₁', hR₂'] with ω hs₁ hs₂ ht₁ ht₂ hp₁ hp₂ hordω hve₁ hve₂ hn₁ hn₂
    hpa hpb hr₁ hr₂
  obtain ⟨hζ₁, hsi₁⟩ := hs₁
  obtain ⟨hζ₂, hsi₂⟩ := hs₂
  by_contra hcon
  obtain ⟨q₁, q₂, s₁, s₂, hs₁0, hs₁q, hs₂0, hs₂q, hpt, ρ, hρ, hagree⟩ := exists_sameArc_of_not hsi₁ hsi₂ hcon
  -- a cap above both stops
  obtain ⟨m, hm⟩ := exists_nat_ge (max (q₁ : ℝ≥0) (q₂ : ℝ≥0))
  have hq₁m : (q₁ : ℝ≥0) ≤ (m : ℝ≥0) := (le_max_left _ _).trans hm
  have hq₂m : (q₂ : ℝ≥0) ≤ (m : ℝ≥0) := (le_max_right _ _).trans hm
  have hq₁min : ((q₁ : ℝ≥0) : ℝ≥0∞) ≤ min (ζ₁ ω) (((m : ℝ≥0)) : ℝ≥0∞) :=
    le_min (hζ₁ ▸ le_top) (ENNReal.coe_le_coe.2 hq₁m)
  have hq₂min : ((q₂ : ℝ≥0) : ℝ≥0∞) ≤ min (ζ₂ ω) (((m : ℝ≥0)) : ℝ≥0∞) :=
    le_min (hζ₂ ▸ le_top) (ENNReal.coe_le_coe.2 hq₂m)
  have hq₁ζ : ((q₁ : ℝ≥0) : ℝ≥0∞) < ζ₁ ω := by rw [hζ₁]; exact ENNReal.coe_lt_top
  have hq₂ζ : ((q₂ : ℝ≥0) : ℝ≥0∞) < ζ₂ ω := by rw [hζ₂]; exact ENNReal.coe_lt_top
  -- the drivers on the event
  obtain ⟨hw₁0, -, -, hcw₁, -⟩ := hp₁
  obtain ⟨hw₂0, -, -, hcw₂, -⟩ := hp₂
  rw [hζ₁] at hcw₁ ht₁
  rw [hζ₂] at hcw₂ ht₂
  have hW₁c : Continuous fun t => W₁ t ω :=
    continuousOn_univ.1 (hcw₁.mono fun t _ => show (t : ℝ≥0∞) < ⊤ from ENNReal.coe_lt_top)
  have hW₂c : Continuous fun t => W₂ t ω :=
    continuousOn_univ.1 (hcw₂.mono fun t _ => show (t : ℝ≥0∞) < ⊤ from ENNReal.coe_lt_top)
  have htr₁' : IsGeneratingTrace (fun t => W₁ t ω) ⊤ (η₁ ω) := by
    simpa only [Complex.ofReal_zero, sub_zero] using ht₁
  have htr₂' : IsGeneratingTrace (fun t => W₂ t ω) ⊤ (η₂ ω) := by
    simpa only [Complex.ofReal_zero, sub_zero] using ht₂
  -- the chart geometry of the common arc
  obtain ⟨F, hFne, hF, y₁, y₂, hy₁, hy₂, hf₁, hf₂, hL⟩ := sameArc_chart hsi₁ hsi₂ (hordω hζ₁ hζ₂) hW₁c hw₁0
    hW₂c hw₂0 htr₁' htr₂' hs₁0 hs₁q hs₂0 hs₂q hpt hρ hagree
  have := hFne
  -- the pathwise sets
  have hA₁ω : explored (ηs m) (fun i _ => stopA q₁ i) ω = η₁ ω '' Icc 0 q₁ ∩ H := by
    rw [hA₁, image_capped_eq (hve₁ m) hq₁min]
  have hA₂ω : explored (ηs m) (fun i _ => stopB q₂ i) ω = η₂ ω '' Icc 0 q₂ ∩ H := by
    rw [hA₂, image_capped_eq (hve₂ m) hq₂min]
  have hUω : explored (ηs m) (fun i _ => max (stopA q₁ i) (stopB q₂ i)) ω =
      (η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H) := by
    rw [← explored_const_union (stopA q₁) (stopB q₂) ω, hA₁ω, hA₂ω]
  have hUω' : explored (ηs m) (fun i _ => max (stopB q₂ i) (stopA q₁ i)) ω =
      (η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H) := by
    rw [← explored_const_union (stopB q₂) (stopA q₁) ω, hA₁ω, hA₂ω, union_comm]
  have hpH : η₁ ω s₁ ∈ H := hsi₁.2.2.2.1 s₁ hs₁0
  have hz₀₁ : η₁ ω s₁ ∈ η₁ ω '' Icc 0 q₁ ∩ H := ⟨⟨s₁, ⟨zero_le, hs₁q.le⟩, rfl⟩, hpH⟩
  have hz₀₂ : η₁ ω s₁ ∈ η₂ ω '' Icc 0 q₂ ∩ H := ⟨⟨s₂, ⟨zero_le, hs₂q.le⟩, hpt.symm⟩, hpH⟩
  have hsub₂₁ : (η₂ ω '' Icc 0 q₂ ∩ H) ∩ ball (η₁ ω s₁) ρ ⊆ η₁ ω '' Icc 0 q₁ ∩ H := by
    rintro z ⟨⟨hz, hzH⟩, hzb⟩
    have : z ∈ η₂ ω '' Icc 0 q₂ ∩ ball (η₁ ω s₁) ρ := ⟨hz, hzb⟩
    rw [← hagree] at this
    exact ⟨this.1, hzH⟩
  have hsub₁₂ : (η₁ ω '' Icc 0 q₁ ∩ H) ∩ ball (η₁ ω s₁) ρ ⊆ η₂ ω '' Icc 0 q₂ ∩ H := by
    rintro z ⟨⟨hz, hzH⟩, hzb⟩
    have : z ∈ η₁ ω '' Icc 0 q₁ ∩ ball (η₁ ω s₁) ρ := ⟨hz, hzb⟩
    rw [hagree] at this
    exact ⟨this.1, hzH⟩
  -- Proposition 3.8 at the common point, twice
  obtain ⟨ua, hua, huar, hual⟩ := hpa m q₁ q₂
  obtain ⟨ub, hub, hubr, hubl⟩ := hpb m q₁ q₂
  rw [hUω'] at hua huar hual
  rw [hA₁ω, hA₂ω] at hual
  rw [hUω] at hub hubr hubl
  rw [hA₁ω, hA₂ω] at hubl
  have hla := hual (η₁ ω s₁) (Or.inl hz₀₁) ⟨ρ, hρ, hsub₂₁⟩
  have hlb := hubl (η₁ ω s₁) (Or.inl hz₀₂) ⟨ρ, hρ, hsub₁₂⟩
  -- harmonic representatives of the two single-prefix means
  obtain ⟨v₁, hv₁, hv₁r⟩ := hr₁ m q₁
  obtain ⟨v₂, hv₂, hv₂r⟩ := hr₂ m q₂
  have hO : IsOpen (H \ ((η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H))) := by
    rw [← hUω]
    exact isOpen_H_diff_explored_of_frozen (fun i => hc m i ω) (fun i => hfr m i ω)
  have hO₁ : H \ ((η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H)) ⊆
      H \ explored (ηs m) (fun i _ => stopA q₁ i) ω := by
    rw [hA₁ω]; exact sdiff_subset_sdiff_right subset_union_left
  have hO₂ : H \ ((η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H)) ⊆
      H \ explored (ηs m) (fun i _ => stopB q₂ i) ω := by
    rw [hA₂ω]; exact sdiff_subset_sdiff_right subset_union_right
  have h12 := tendsto_sub_of_union_means hO hO₁ hO₂ hv₁ hv₁r hv₂ hv₂r hua huar hub hubr hla hlb
  -- the approach lies off the union and off each filling
  have hfillsub : ∀ {K : Set ℂ}, H \ fillH K ⊆ H \ (K ∩ H) := fun {K} z hz =>
    ⟨hz.1, fun hzK => hz.2 ⟨hzK.2, Or.inl (subset_closure hzK.1)⟩⟩
  have hFO : F ≤ 𝓝[H \ ((η₁ ω '' Icc 0 q₁ ∩ H) ∪ (η₂ ω '' Icc 0 q₂ ∩ H))] (η₁ ω s₁) := by
    refine hF.trans (nhdsWithin_mono _ ?_)
    rw [← union_inter_distrib_right]
    exact hfillsub
  have hF₁ : F ≤ 𝓝[H \ fillH (η₁ ω '' Icc 0 q₁)] (η₁ ω s₁) :=
    hF.trans (nhdsWithin_mono _ (sdiff_subset_sdiff_right (fillH_mono subset_union_left)))
  have hF₂ : F ≤ 𝓝[H \ fillH (η₂ ω '' Icc 0 q₂)] (η₂ ω s₂) := by
    rw [← hpt]
    exact hF.trans (nhdsWithin_mono _ (sdiff_subset_sdiff_right (fillH_mono subset_union_right)))
  -- the single-path side heights on the right side of both curves
  rw [hA₁ m q₁ ω] at hv₁ hv₁r
  rw [hA₂ m q₂ ω] at hv₂ hv₂r
  have h₁ := (hn₁ m q₁ hq₁m hq₁ζ v₁ hv₁ hv₁r s₁ hs₁q hpH F hFne hF₁ y₁ hf₁).1 hy₁
  have h₂ := (hn₂ m q₂ hq₂m hq₂ζ v₂ hv₂ hv₂r s₂ hs₂q (hpt ▸ hpH) F hFne hF₂ y₂ hf₂).1 hy₂
  have heq := eq_of_side_limits (h12.mono_left hFO) hL h₁ h₂
  have hθχ : θ₁ * χ = θ₂ * χ := by linarith
  exact hθ.ne (mul_right_cancel₀ hχpos.ne' hθχ)

/-- **Lemma 6.13's exclusion of (MD1)** (the named input `Lemma71I.Lemma613ContactStatement`) from the §4.2 reference
(the determination of each flow line, `exists_map_of_cond44`) and Proposition 5.5 in `ℍ` (the order of the two flow
lines). Both are inputs of Lemma 7.1's three-curve space already (`Lemma71H.exists_threeCurveSpace_ordered`); neither
uses Lemma 7.1 (ruling R43). Conditional helper. -/
theorem lemma613ContactStatement_of_prop55 (href : Lemma71H.Cond44ReferenceStatement.{u})
    (h55 : Lemma71H.Prop55HalfPlaneStatement.{u}) : Lemma613ContactStatement.{u} := by
  intro κ hκ hκ4 a b θ₁ θ₂ hθ hb ha Ω _ P _ h hh η₁ η₂ ζ₁ ζ₂ hη₁ hη₂
  have hχ := Sec4.chiC_pos hκ hκ4
  have hθχ : θ₁ * chiC κ ≤ θ₂ * chiC κ := mul_le_mul_of_nonneg_right hθ.le hχ.le
  have hπχ : 0 ≤ π * chiC κ := mul_nonneg Real.pi_pos.le hχ.le
  have hΦ₁ := exists_map_of_cond44 href hκ hκ4 (θ := θ₁) (by linarith) hb hh hη₁
  have hΦ₂ := exists_map_of_cond44 href hκ hκ4 (θ := θ₂) ha (by linarith) hh hη₂
  have hord := h55 κ hκ hκ4 a b θ₁ θ₂ hθ hb ha P h hh η₁ η₂ ζ₁ ζ₂ hη₁ hη₂
  filter_upwards [ae_noCommonArc_of_maps hκ hκ4 hθ hb ha hh hη₁ hη₂ hΦ₁ hΦ₂ hord] with ω hω _ _
  exact hω

end Contact

