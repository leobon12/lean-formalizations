import Mathlib.Probability.Process.Stopping
import Mathlib.MeasureTheory.Constructions.BorelSpace.Metrizable

/-!
# The optional σ-algebra and the optional section theorem (input of Aux. lemma 136)

Packet PROVE-SEC7-E (specification §7.5, proof of Aux. lemma 136, `source/spec/p433-480.md` L159–L201,
p. 441: "We use the classical optional section theorem in its following precise form: an optional set
whose projection on the sample space has positive probability contains the graph, on an event of
positive probability, of an original stopping time. The filtration satisfies the usual conditions;
this is a named general-process input, as in [RY99].").

* `optionalSigma 𝓕`: the optional σ-algebra on `ℝ≥0 × Ω`, generated by the stochastic intervals
  `[[S, ∞[[ = {(t, ω) | S ω ≤ t}` of the `𝓕`-stopping times `S` (Dellacherie–Meyer IV.64; it contains
  `[[S, T[[` for all stopping times `S, T`).
* `IsUsualFiltration 𝓕 P`: right continuity and completeness (every `P`-null set, measurable or not,
  is in `𝓕₀`).
* `OptionalSectionStatement`: the optional section theorem in the specification's form (named external
  input, EXT-INV `EXT-OPTSECTION`; not formalized).
* `measurable_optionalSigma_of_continuous`: a process with continuous paths and `𝓕`-adapted values is
  optional ("adapted and continuous … It is therefore optional", p. 441). Proof: the right-continuous
  dyadic step processes `X_{⌊2^k t⌋ / 2^k}` are optional (each piece is `[j 2^{-k}, (j+1) 2^{-k}) × F`
  with `F ∈ 𝓕_{j 2^{-k}}`, a difference of two stochastic intervals) and converge pointwise.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

universe u

variable {Ω : Type u} {mΩ : MeasurableSpace Ω}

/-! ### Definitions -/

/-- The **optional σ-algebra** of the filtration `𝓕` on `ℝ≥0 × Ω`: generated by the stochastic
intervals `[[S, ∞[[ = {(t, ω) | S ω ≤ t}` of all `𝓕`-stopping times `S`. -/
@[instance_reducible]
def optionalSigma (𝓕 : Filtration ℝ≥0 mΩ) : MeasurableSpace (ℝ≥0 × Ω) :=
  MeasurableSpace.generateFrom
    {A | ∃ S : Ω → WithTop ℝ≥0, IsStoppingTime 𝓕 S ∧ A = {p | S p.2 ≤ (p.1 : WithTop ℝ≥0)}}

/-- The **usual conditions**: `𝓕` is right continuous, `𝓕_t = ⋂_{s > t} 𝓕_s`, and complete: every
`P`-null set (for the outer measure, so also every subset of a null set) belongs to `𝓕₀`. -/
def IsUsualFiltration (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) : Prop :=
  (∀ t : ℝ≥0, ⨅ s > t, 𝓕 s ≤ 𝓕 t) ∧ ∀ s : Set Ω, P s = 0 → MeasurableSet[𝓕 0] s

/-- **The optional section theorem** ([RY99]; Dellacherie–Meyer IV.84), in the form used by the
specification (named external input; not formalized): for a filtration satisfying the usual
conditions, an optional set `A ⊆ ℝ≥0 × Ω` whose projection on `Ω` has positive (outer) probability
contains, on an event of positive probability, the graph of a stopping time `S`:
`P(S < ∞) > 0` and `(S ω, ω) ∈ A` whenever `S ω < ∞`. -/
def OptionalSectionStatement : Prop :=
  ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (𝓕 : Filtration ℝ≥0 mΩ), IsUsualFiltration 𝓕 P →
    ∀ A : Set (ℝ≥0 × Ω), MeasurableSet[optionalSigma 𝓕] A → P (Prod.snd '' A) ≠ 0 →
      ∃ S : Ω → WithTop ℝ≥0, IsStoppingTime 𝓕 S ∧ P {ω | S ω ≠ ⊤} ≠ 0 ∧
        ∀ ω (t : ℝ≥0), S ω = t → (t, ω) ∈ A

variable {𝓕 : Filtration ℝ≥0 mΩ}

/-! ### Basic optional sets -/

/-- A stochastic interval `[[S, ∞[[` is optional. -/
theorem measurableSet_optionalSigma_stochInterval {S : Ω → WithTop ℝ≥0}
    (hS : IsStoppingTime 𝓕 S) :
    MeasurableSet[optionalSigma 𝓕] {p : ℝ≥0 × Ω | S p.2 ≤ (p.1 : WithTop ℝ≥0)} :=
  MeasurableSpace.measurableSet_generateFrom ⟨S, hS, rfl⟩

/-- `[s, ∞) × F` is optional for `F ∈ 𝓕_s`. -/
theorem measurableSet_optionalSigma_Ici_prod {s : ℝ≥0} {F : Set Ω} (hF : MeasurableSet[𝓕 s] F) :
    MeasurableSet[optionalSigma 𝓕] (Ici s ×ˢ F) := by
  classical
  let S : Ω → WithTop ℝ≥0 := fun ω => if ω ∈ F then (s : WithTop ℝ≥0) else ⊤
  have hS : IsStoppingTime 𝓕 S := by
    intro t
    by_cases hst : s ≤ t
    · have h : {ω | S ω ≤ (t : WithTop ℝ≥0)} = F := by
        ext ω
        by_cases hω : ω ∈ F
        · simp only [S, hω, ite_true, Set.mem_ofPred_eq, iff_true]
          exact_mod_cast hst
        · simp only [S, hω, ite_false, Set.mem_ofPred_eq, iff_false]
          exact not_le.2 (WithTop.coe_lt_top t)
      rw [h]; exact 𝓕.mono hst F hF
    · have h : {ω | S ω ≤ (t : WithTop ℝ≥0)} = ∅ := by
        ext ω
        simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
        by_cases hω : ω ∈ F
        · simp only [S, hω, ite_true]
          exact fun h => hst (by exact_mod_cast h)
        · simp only [S, hω, ite_false]
          exact not_le.2 (WithTop.coe_lt_top t)
      rw [h]; exact @MeasurableSet.empty Ω (𝓕 t)
  have h : Ici s ×ˢ F = {p : ℝ≥0 × Ω | S p.2 ≤ (p.1 : WithTop ℝ≥0)} := by
    ext ⟨t, ω⟩
    simp only [mem_prod, mem_Ici, Set.mem_ofPred_eq]
    by_cases hω : ω ∈ F
    · simp only [S, hω, ite_true, and_true]
      exact WithTop.coe_le_coe.symm
    · simp only [S, hω, ite_false, and_false, false_iff]
      exact not_le.2 (WithTop.coe_lt_top t)
  rw [h]; exact measurableSet_optionalSigma_stochInterval hS

/-- `[s, s') × F` is optional for `F ∈ 𝓕_s`, `s ≤ s'`. -/
theorem measurableSet_optionalSigma_Ico_prod {s s' : ℝ≥0} (hss' : s ≤ s') {F : Set Ω}
    (hF : MeasurableSet[𝓕 s] F) : MeasurableSet[optionalSigma 𝓕] (Ico s s' ×ˢ F) := by
  have h : Ico s s' ×ˢ F = Ici s ×ˢ F \ Ici s' ×ˢ F := by
    ext ⟨t, ω⟩
    simp only [mem_prod, mem_Ico, mem_Ici, Set.mem_sdiff, not_and]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨⟨h1, h3⟩, fun h4 => absurd h2 (not_lt.2 h4)⟩
    · rintro ⟨⟨h1, h3⟩, h2⟩; exact ⟨⟨h1, lt_of_not_ge fun h4 => h2 h4 h3⟩, h3⟩
  rw [h]
  exact (measurableSet_optionalSigma_Ici_prod hF).diff
    (measurableSet_optionalSigma_Ici_prod (𝓕.mono hss' F hF))

/-! ### Continuous adapted processes are optional -/

/-- The dyadic lower approximation `⌊2^k t⌋ / 2^k`. -/
def dyadicFloor (k : ℕ) (t : ℝ≥0) : ℝ≥0 := (⌊t * 2 ^ k⌋₊ : ℝ≥0) / 2 ^ k

theorem floor_mul_two_pow_eq_iff (k j : ℕ) (t : ℝ≥0) :
    ⌊t * 2 ^ k⌋₊ = j ↔ t ∈ Ico ((j : ℝ≥0) / 2 ^ k) (((j : ℝ≥0) + 1) / 2 ^ k) := by
  have hk : (0 : ℝ≥0) < 2 ^ k := pow_pos two_pos k
  rw [Nat.floor_eq_iff (by positivity), mem_Ico, div_le_iff₀ hk, lt_div_iff₀ hk]

theorem dyadicFloor_le (k : ℕ) (t : ℝ≥0) : dyadicFloor k t ≤ t := by
  have hk : (0 : ℝ≥0) < 2 ^ k := pow_pos two_pos k
  exact ((floor_mul_two_pow_eq_iff k _ t).1 rfl).1

theorem lt_dyadicFloor_add (k : ℕ) (t : ℝ≥0) : t < dyadicFloor k t + (1 / 2) ^ k := by
  have h := ((floor_mul_two_pow_eq_iff k _ t).1 rfl).2
  rw [dyadicFloor, one_div_pow, ← add_div]
  exact h

theorem tendsto_dyadicFloor (t : ℝ≥0) : Tendsto (fun k => dyadicFloor k t) atTop (𝓝 t) := by
  have h0 : Tendsto (fun k : ℕ => t - (1 / 2 : ℝ≥0) ^ k) atTop (𝓝 t) := by
    have h := (NNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (r := 1 / 2) (by norm_num)).const_sub t
    simpa using h
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le h0 tendsto_const_nhds (fun k => ?_)
    (fun k => dyadicFloor_le k t)
  exact tsub_le_iff_right.2 (lt_dyadicFloor_add k t).le

/-- **A continuous adapted process is optional** (proof of Aux. 136, p. 441: "is adapted and
continuous … It is therefore optional"). -/
theorem measurable_optionalSigma_of_continuous {E : Type*} [TopologicalSpace E]
    [TopologicalSpace.PseudoMetrizableSpace E] [MeasurableSpace E] [BorelSpace E] {X : ℝ≥0 → Ω → E}
    (hX : ∀ t, Measurable[𝓕 t] (X t)) (hc : ∀ ω, Continuous fun t => X t ω) :
    Measurable[optionalSigma 𝓕] fun p : ℝ≥0 × Ω => X p.1 p.2 := by
  let _ : MeasurableSpace (ℝ≥0 × Ω) := optionalSigma 𝓕
  have hk : ∀ k : ℕ, Measurable fun p : ℝ≥0 × Ω => X (dyadicFloor k p.1) p.2 := by
    intro k B hB
    have h : (fun p : ℝ≥0 × Ω => X (dyadicFloor k p.1) p.2) ⁻¹' B =
        ⋃ j : ℕ, Ico ((j : ℝ≥0) / 2 ^ k) (((j : ℝ≥0) + 1) / 2 ^ k) ×ˢ
          (X ((j : ℝ≥0) / 2 ^ k) ⁻¹' B) := by
      ext ⟨t, ω⟩
      simp only [mem_preimage, mem_iUnion, mem_prod]
      constructor
      · intro h; exact ⟨⌊t * 2 ^ k⌋₊, (floor_mul_two_pow_eq_iff k _ t).1 rfl, h⟩
      · rintro ⟨j, hj, h⟩
        rwa [dyadicFloor, (floor_mul_two_pow_eq_iff k j t).2 hj]
    rw [h]
    refine MeasurableSet.iUnion fun j => measurableSet_optionalSigma_Ico_prod ?_ (hX _ hB)
    gcongr
    exact le_add_of_nonneg_right zero_le_one
  exact measurable_of_tendsto_metrizable hk (tendsto_pi_nhds.2 fun p =>
    ((hc p.2).tendsto p.1).comp (tendsto_dyadicFloor p.1))

end Sec7

end InteractingSLE
