/-!
# Lemma 6.13: the chart geometry of a common arc of two ordered flow lines

Packet PROVE-LEMMA71J (specification §6.3, proof of Lemma 6.13, p. 216, `source/spec/p193-240.md#lem-6.13-proof`:
"Work on this event […] For each curve, the portion outside the larger open arc `η_{θ₁}((a, b))` is compact in the
sphere and disjoint from `J₀`. […] This supplies a common collar of `J₀` in which no other portion of either curve
occurs. The inclusion `C₁ ⊆ C₂` forces the two designated right sides to agree in this collar").

Deterministic. Two simple proper curves `η₁`, `η₂` from `0` (`IsSimpleProper`), with `η₂` in the closed left side of
`η₁` (the W0 order), generated by continuous drivers `W₁`, `W₂`:

* **`exists_sameArc`** (the collar): if `η₁([a, b]) ⊆ η₂` for rationals `0 < a < b`, there are rational stops
  `q₁`, `q₂` and times `0 < s₁ < q₁`, `s₂ < q₂` with `η₁(s₁) = η₂(s₂)` near which the two stopped ranges coincide;
* `rightSideOf_subset_rightSideOf` (the inclusion `C₁ ⊆ C₂` of the right sides) and `mem_closure_rightSideOf`
  (every point of a proper arc is adherent to its right side);
* `exists_pos_tendsto_of_rightSideOf`: along an approach from the right side of the complete curve, the centred
  Loewner map of a stopped prefix tends to a **positive** real (WangWu's `exists_real_tendsto_fwdMap` with the side
  argument of `tendsto_comp_fwdMap_rightSideOf`);
* `tendsto_lift_sub_of_agree`: Aux. lemma 57 for a stopped prefix and the joint hull, along any approach from the
  joint unbounded domain near which the joint hull is the prefix (the lift step of
  `ReverseArc.reverseArcChart_of_mem_H`);
* **`sameArc_chart`**: at the common point, an approach from the joint unbounded domain along which both stopped charts
  tend to positive reals and the two derivative-argument lifts differ by a quantity tending to `0`.

The right side of `η₁` replaces the source's normalized right domains `C₁ ⊆ C₂`: both charts see it as their right
side, so the two single-curve heights are `λ − θ₁χ` and `λ − θ₂χ` on the same approach.
-/

set_option autoImplicit false

noncomputable section

open Set Metric Filter Topology Bornology Complex Function
open scoped NNReal ENNReal

open QuantumZipper (H Hbar)

namespace InteractingSLE.Sec7.Lemma613

open HalfPlaneSep Restart ReverseArc Lemma71I

/-! ### The collar of a common arc -/

section Collar

/-- A compact set avoiding `p` misses a ball about `p`. -/
theorem exists_ball_notMem {S : Set ℂ} (hS : IsCompact S) {p : ℂ} (hp : p ∉ S) :
    ∃ d > 0, ∀ z ∈ S, z ∉ ball p d := by
  obtain ⟨d, hd, h⟩ := Metric.isOpen_iff.1 hS.isClosed.isOpen_compl p hp
  exact ⟨d, hd, fun z hz hzb => h hzb hz⟩

/-- **The inverse of an injective curve on a compact interval is continuous along a continuous curve in its image**
(a continuous injective map of a compact space into a Hausdorff space is an embedding). -/
theorem continuousOn_of_comp_eq {a b T : ℝ≥0} {α β : ℝ≥0 → ℂ} (hα : ContinuousOn α (Icc a b))
    (hβ : ContinuousOn β (Icc 0 T)) (hβi : InjOn β (Icc 0 T)) {g : ℝ≥0 → ℝ≥0}
    (hg : ∀ u ∈ Icc a b, g u ∈ Icc 0 T) (hgeq : ∀ u ∈ Icc a b, β (g u) = α u) : ContinuousOn g (Icc a b) := by
  rw [continuousOn_iff_continuous_domRestrict]
  set f : Icc (0 : ℝ≥0) T → ℂ := (Icc 0 T).domRestrict β with hf
  have hfc : Continuous f := hβ.domRestrict
  have hfi : Injective f := fun x y hxy => Subtype.ext (hβi x.2 y.2 hxy)
  have hemb := (hfc.isClosedEmbedding hfi).isEmbedding
  set g' : Icc a b → Icc (0 : ℝ≥0) T := fun u => ⟨g u, hg u u.2⟩ with hg'
  have hg'c : Continuous g' := by
    rw [hemb.continuous_iff]
    have : f ∘ g' = (Icc a b).domRestrict α := funext fun u => hgeq u u.2
    rw [this]
    exact hα.domRestrict
  exact continuous_subtype_val.comp hg'c

/-- An open interval about `t₀` in the image of a continuous injective map of `[a, b]` with `t₀ = g c`, `a < c < b`. -/
theorem exists_Ioo_subset_image {a b c : ℝ≥0} (hac : a < c) (hcb : c < b) {g : ℝ≥0 → ℝ≥0}
    (hgc : ContinuousOn g (Icc a b)) (hgi : InjOn g (Icc a b)) :
    ∃ lo hi : ℝ≥0, lo < g c ∧ g c < hi ∧ Ioo lo hi ⊆ g '' Icc a b := by
  have hab : a ≤ b := (hac.trans hcb).le
  have hcI : c ∈ Icc a b := ⟨hac.le, hcb.le⟩
  have haI : a ∈ Icc a b := ⟨le_rfl, hab⟩
  have hbI : b ∈ Icc a b := ⟨hab, le_rfl⟩
  rcases hgc.strictMonoOn_of_injOn_Icc' hab hgi with hm | hm
  · exact ⟨g a, g b, hm haI hcI hac, hm hcI hbI hcb,
      Ioo_subset_Icc_self.trans (intermediate_value_Icc hab hgc)⟩
  · exact ⟨g b, g a, hm hcI hbI hcb, hm haI hcI hac,
      Ioo_subset_Icc_self.trans (intermediate_value_Icc' hab hgc)⟩

/-- **The collar of a common arc** (proof of Lemma 6.13, p. 216). Let `α`, `β` be continuous injective curves, `β`
tending to `∞`, and `α([a, b]) ⊆ β` for rationals `0 < a < b`. Then there are rational stops `q₁`, `q₂` and times
`0 < s₁ < q₁`, `s₂ < q₂` with `α(s₁) = β(s₂)`, near which the stopped ranges `α([0, q₁])` and `β([0, q₂])` coincide. -/
theorem exists_sameArc {α β : ℝ≥0 → ℂ} (hα : Continuous α) (hβ : Continuous β) (hαi : Injective α)
    (hβi : Injective β) (hβinf : Tendsto (fun t => ‖β t‖) atTop atTop) {a b : ℚ} (ha : 0 < a) (hab : a < b)
    (hsub : ∀ t : ℝ≥0, (a : ℝ) ≤ t → (t : ℝ) ≤ b → α t ∈ range β) :
    ∃ (q₁ q₂ : ℚ≥0) (s₁ s₂ : ℝ≥0), 0 < s₁ ∧ s₁ < q₁ ∧ s₂ < q₂ ∧ α s₁ = β s₂ ∧
      ∃ ρ > 0, α '' Icc 0 q₁ ∩ ball (α s₁) ρ = β '' Icc 0 q₂ ∩ ball (α s₁) ρ := by
  classical
  set a' : ℝ≥0 := (a : ℝ).toNNReal with ha'
  set b' : ℝ≥0 := (b : ℝ).toNNReal with hb'
  have ha0 : (0 : ℝ) < a := by exact_mod_cast ha
  have ha'r : (a' : ℝ) = a := Real.coe_toNNReal _ ha0.le
  have hb'r : (b' : ℝ) = b := Real.coe_toNNReal _ (ha0.trans (by exact_mod_cast hab)).le
  have hab' : a' < b' := by rw [← NNReal.coe_lt_coe, ha'r, hb'r]; exact_mod_cast hab
  have ha'0 : 0 < a' := by rw [← NNReal.coe_pos, ha'r]; exact ha0
  have hsub' : ∀ u ∈ Icc a' b', α u ∈ range β := fun u hu =>
    hsub u (by rw [← ha'r]; exact_mod_cast hu.1) (by rw [← hb'r]; exact_mod_cast hu.2)
  -- the common arc is bounded, so its `β`-times are bounded
  set K := α '' Icc a' b' with hK
  have hKc : IsCompact K := isCompact_Icc.image hα
  obtain ⟨R, hR⟩ := hKc.isBounded.exists_norm_le
  obtain ⟨T₀, hT₀⟩ := eventually_atTop.1 (tendsto_atTop.1 hβinf (R + 1))
  have hβK : ∀ t, β t ∈ K → t < T₀ := fun t ht => by
    by_contra hle
    have h1 := hT₀ t (not_lt.1 hle)
    have h2 := hR _ ht
    linarith
  -- the stops
  set q₁ : ℚ≥0 := (⌈(b : ℝ)⌉₊ : ℚ≥0) with hq₁
  set q₂ : ℚ≥0 := (⌈(T₀ : ℝ)⌉₊ : ℚ≥0) with hq₂
  have hq₁r : ((q₁ : ℝ≥0) : ℝ) = ⌈(b : ℝ)⌉₊ := by simp [hq₁]
  have hq₂r : ((q₂ : ℝ≥0) : ℝ) = ⌈(T₀ : ℝ)⌉₊ := by simp [hq₂]
  have hbq₁ : b' ≤ q₁ := by rw [← NNReal.coe_le_coe, hb'r, hq₁r]; exact Nat.le_ceil _
  have hTq₂ : T₀ ≤ q₂ := by rw [← NNReal.coe_le_coe, hq₂r]; exact Nat.le_ceil _
  -- the `β`-time of the arc
  have hgex : ∀ u, ∃ t : ℝ≥0, u ∈ Icc a' b' → β t = α u := fun u => by
    by_cases hu : u ∈ Icc a' b'
    · obtain ⟨t, ht⟩ := hsub' u hu
      exact ⟨t, fun _ => ht⟩
    · exact ⟨0, fun h => absurd h hu⟩
  choose g hg using hgex
  have hgT : ∀ u ∈ Icc a' b', g u ∈ Icc 0 T₀ := fun u hu =>
    ⟨zero_le, (hβK _ (by rw [hg u hu]; exact mem_image_of_mem _ hu)).le⟩
  have hgc : ContinuousOn g (Icc a' b') :=
    continuousOn_of_comp_eq hα.continuousOn hβ.continuousOn hβi.injOn hgT fun u hu => hg u hu
  have hgi : InjOn g (Icc a' b') := fun u hu v hv huv => hαi (by rw [← hg u hu, ← hg v hv, huv])
  -- the common point
  set c : ℝ≥0 := (a' + b') / 2 with hc
  have hab'r : (a' : ℝ) < b' := hab'
  have hac : a' < c := by rw [← NNReal.coe_lt_coe, hc]; push_cast; linarith
  have hcb : c < b' := by rw [← NNReal.coe_lt_coe, hc]; push_cast; linarith
  have hcI : c ∈ Icc a' b' := ⟨hac.le, hcb.le⟩
  obtain ⟨lo, hi, hlo, hhi, hIoo⟩ := exists_Ioo_subset_image hac hcb hgc hgi
  set t₀ := g c with ht₀
  have hβt₀ : β t₀ = α c := hg c hcI
  -- the two compact remainders
  set S₁ := α '' (Icc 0 (q₁ : ℝ≥0) \ Ioo a' b') with hS₁
  set S₂ := β '' (Icc 0 (q₂ : ℝ≥0) \ Ioo lo hi) with hS₂
  have hS₁c : IsCompact S₁ := (isCompact_Icc.diff isOpen_Ioo).image hα
  have hS₂c : IsCompact S₂ := (isCompact_Icc.diff isOpen_Ioo).image hβ
  have hpS₁ : α c ∉ S₁ := by
    rintro ⟨u, hu, hue⟩
    exact hu.2 (hαi hue ▸ ⟨hac, hcb⟩)
  have hpS₂ : α c ∉ S₂ := by
    rintro ⟨u, hu, hue⟩
    rw [← hβt₀] at hue
    exact hu.2 (hβi hue ▸ ⟨hlo, hhi⟩)
  obtain ⟨d₁, hd₁, hd₁S⟩ := exists_ball_notMem hS₁c hpS₁
  obtain ⟨d₂, hd₂, hd₂S⟩ := exists_ball_notMem hS₂c hpS₂
  refine ⟨q₁, q₂, c, t₀, ha'0.trans hac, hcb.trans_le hbq₁,
    (hβK t₀ (by rw [hβt₀]; exact mem_image_of_mem _ hcI)).trans_le hTq₂, hβt₀.symm, min d₁ d₂, lt_min hd₁ hd₂, ?_⟩
  ext z
  constructor
  · rintro ⟨⟨u, hu, rfl⟩, hzb⟩
    have huI : u ∈ Ioo a' b' := by
      by_contra hno
      exact hd₁S _ ⟨u, ⟨hu, hno⟩, rfl⟩ (ball_subset_ball (min_le_left _ _) hzb)
    obtain ⟨t, ht⟩ := hsub' u (Ioo_subset_Icc_self huI)
    refine ⟨⟨t, ⟨zero_le, ((hβK t (ht ▸ mem_image_of_mem _ (Ioo_subset_Icc_self huI))).le.trans hTq₂)⟩, ht⟩, hzb⟩
  · rintro ⟨⟨t, ht, rfl⟩, hzb⟩
    have htI : t ∈ Ioo lo hi := by
      by_contra hno
      exact hd₂S _ ⟨t, ⟨ht, hno⟩, rfl⟩ (ball_subset_ball (min_le_right _ _) hzb)
    obtain ⟨u, hu, hut⟩ := hIoo htI
    refine ⟨⟨u, ⟨zero_le, hu.2.trans hbq₁⟩, ?_⟩, hzb⟩
    rw [← hg u hu, hut]

/-- **A common arc in either parametrization gives the collar** (`exists_sameArc` applied to `(η₁, η₂)` or to
`(η₂, η₁)`), for two simple proper curves. -/
theorem exists_sameArc_of_not {η₁ η₂ : ℝ≥0 → ℂ} (h₁ : IsSimpleProper η₁) (h₂ : IsSimpleProper η₂)
    (hcon : ¬ (NoCommonArc η₁ η₂ ∧ NoCommonArc η₂ η₁)) :
    ∃ (q₁ q₂ : ℚ≥0) (s₁ s₂ : ℝ≥0), 0 < s₁ ∧ s₁ < q₁ ∧ 0 < s₂ ∧ s₂ < q₂ ∧ η₁ s₁ = η₂ s₂ ∧
      ∃ ρ > 0, η₁ '' Icc 0 q₁ ∩ ball (η₁ s₁) ρ = η₂ '' Icc 0 q₂ ∩ ball (η₁ s₁) ρ := by
  have hpos : ∀ {γ δ : ℝ≥0 → ℂ}, IsSimpleProper γ → IsSimpleProper δ → ∀ {s t : ℝ≥0}, 0 < s → γ s = δ t →
      0 < t := fun {γ δ} hγ hδ {s t} hs hst => by
    refine pos_iff_ne_zero.2 fun ht => ?_
    have h1 : (0 : ℝ) < (γ s).im := hγ.2.2.2.1 s hs
    rw [hst, ht, hδ.2.2.1, zero_im] at h1
    exact lt_irrefl _ h1
  rw [not_and_or] at hcon
  rcases hcon with hc | hc
  · unfold NoCommonArc at hc
    push Not at hc
    obtain ⟨a, b, ha, hab, hsub⟩ := hc
    obtain ⟨q₁, q₂, s₁, s₂, hs₁, hs₁q, hs₂q, hpt, ρ, hρ, hag⟩ :=
      exists_sameArc h₁.1 h₂.1 h₁.2.1 h₂.2.1 h₂.2.2.2.2 ha hab hsub
    exact ⟨q₁, q₂, s₁, s₂, hs₁, hs₁q, hpos h₁ h₂ hs₁ hpt, hs₂q, hpt, ρ, hρ, hag⟩
  · unfold NoCommonArc at hc
    push Not at hc
    obtain ⟨a, b, ha, hab, hsub⟩ := hc
    obtain ⟨q₂, q₁, s₂, s₁, hs₂, hs₂q, hs₁q, hpt, ρ, hρ, hag⟩ :=
      exists_sameArc h₂.1 h₁.1 h₂.2.1 h₁.2.1 h₁.2.2.2.2 ha hab hsub
    refine ⟨q₁, q₂, s₁, s₂, hpos h₂ h₁ hs₂ hpt, hs₁q, hs₂, hs₂q, hpt.symm, ρ, hρ, ?_⟩
    rw [← hpt]
    exact hag.symm

end Collar

/-! ### The right sides -/

section Sides

variable {η η₁ η₂ : ℝ≥0 → ℂ}

/-- **Every point of a proper arc is adherent to its right side** (the crosscut is on the frontier of both of its
sides, `WangWu.crossRange_subset_closure_crossSide`, pulled back by the Cayley map). -/
theorem mem_closure_rightSideOf (hη : IsSimpleProper η) (s : ℝ≥0) : η s ∈ closure (rightSideOf (range η)) := by
  have hA := hη.isProperArc
  have hs : (0 : ℝ) ≤ s := s.2
  set γ := Lemma71I.realPath η with hγ
  have hγs : γ s = η s := Lemma71I.realPath_coe η s
  have hdisc := WangWu.discTime_mem_Ico hs
  have hmem : WangWu.toDisc γ (WangWu.discTime s) = QuantumZipper.CA.cayley (η s) := by
    rw [WangWu.toDisc_of_lt hdisc.2, WangWu.arcTime_discTime hs, hγs]
  have hcr : QuantumZipper.CA.cayley (η s) ∈ WangWu.crossRange (WangWu.toDisc γ) :=
    ⟨_, Ico_subset_Icc_self hdisc, hmem⟩
  have hcl := WangWu.IsDiscCrosscut.crossRange_subset_closure_crossSide hA.isDiscCrosscut_toDisc (Or.inr rfl) hcr
  have hHbar : η s ∈ Hbar := hγs ▸ hA.mem_Hbar hs
  have h := mem_closure_image (WangWu.continuousAt_cayleyInv (WangWu.cayley_ne_one_of_Hbar hHbar)) hcl
  rw [WangWu.cayleyInv_cayley_of_mem_Hbar hHbar, ← WangWu.IsProperArc.rightSideOf_eq_image hA,
    Lemma71I.arcRange_realPath] at h
  exact h

/-- A point of a proper arc off its seed is in `ℍ`; a positive real point is off the arc. -/
theorem ofReal_notMem_range (hη : IsSimpleProper η) {x : ℝ} (hx : x ≠ 0) : (x : ℂ) ∉ range η := by
  rintro ⟨t, ht⟩
  rcases eq_zero_or_pos t with h0 | hpos
  · rw [h0, hη.2.2.1] at ht
    exact hx (by exact_mod_cast ht.symm)
  · have h1 : (0 : ℝ) < (η t).im := hη.2.2.2.1 t hpos
    rw [ht, ofReal_im] at h1
    exact lt_irrefl _ h1

/-- **The inclusion of the right sides** (Lemma 6.13: "the inclusion `C₁ ⊆ C₂`"): if `η₂` lies in the closed left side
of `η₁`, the right side of `η₁` lies in the right side of `η₂`. -/
theorem rightSideOf_subset_rightSideOf (h₁ : IsSimpleProper η₁) (h₂ : IsSimpleProper η₂)
    (hord : range η₂ ⊆ closedLeftSide η₁) : rightSideOf (range η₁) ⊆ rightSideOf (range η₂) := by
  have hdisj := disjoint_rightSideOf_of_subset_closedLeftSide h₁.isProperCurve h₁.2.2.1 hord
  intro z hz
  have hcomp : connectedComponentIn (H \ range η₁) z ⊆ H \ range η₂ := fun w hw =>
    ⟨(connectedComponentIn_subset _ _ hw).1,
      fun hw2 => Set.disjoint_left.1 hdisj hw2 (WangWu.mem_rightSideOf_of_mem_connectedComponentIn hz hw)⟩
  have hzC : z ∈ connectedComponentIn (H \ range η₁) z := mem_connectedComponentIn hz.1
  have hsub : connectedComponentIn (H \ range η₁) z ⊆ connectedComponentIn (H \ range η₂) z :=
    isPreconnected_connectedComponentIn.subset_connectedComponentIn hzC hcomp
  obtain ⟨-, x, hx, -, hxcl⟩ := hz
  exact ⟨hcomp hzC, x, hx, ofReal_notMem_range h₂ hx.ne', closure_mono hsub hxcl⟩

/-- **The right side of a proper arc is unbounded** (it contains a half-disc at every positive real point). -/
theorem not_isBounded_rightSideOf (hη : IsSimpleProper η) : ¬ IsBounded (rightSideOf (range η)) := by
  intro hb
  obtain ⟨C, hC⟩ := hb.exists_norm_le
  set x : ℝ := |C| + 1 with hx
  have hx0 : 0 < x := by rw [hx]; positivity
  obtain ⟨r, hr, hsub⟩ := hη.isProperArc.exists_ball_inter_H_subset_rightSideOf hx0
  rw [Lemma71I.arcRange_realPath] at hsub
  set z : ℂ := (x : ℂ) + ((r / 2 : ℝ) : ℂ) * I with hz
  have hzb : z ∈ ball (x : ℂ) r ∩ H := by
    refine ⟨?_, ?_⟩
    · rw [mem_ball, dist_eq_norm, hz, add_sub_cancel_left, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos (by positivity)]
      linarith
    · show 0 < z.im
      simp [hz]
      positivity
  have h1 := hC z (hsub hzb)
  have h2 : x ≤ ‖z‖ := by
    have := Complex.abs_re_le_norm z
    simp only [hz, add_re, ofReal_re, mul_re, ofReal_im, I_re, mul_zero, I_im, mul_one, sub_zero,
      add_zero] at this
    exact (le_abs_self x).trans this
  have h3 : C < x := by rw [hx]; linarith [le_abs_self C]
  linarith

end Sides

/-! ### The charts along the right side -/

section Chart

variable {η : ℝ≥0 → ℂ} {W : ℝ≥0 → ℝ}

/-- **Along an approach from the right side of the complete curve, the centred Loewner map of a stopped prefix tends
to a positive real** (WangWu's cluster lemma `exists_real_tendsto_fwdMap`; the limit is positive because `f_q` maps
the right side of the curve into the right side of its mapped future, `fwdMap_mem_rightSideOf_futureArc`). -/
theorem exists_pos_tendsto_of_rightSideOf (hη : IsSimpleProper η) (hW : Continuous W) (hW0 : W 0 = 0)
    (htr : IsGeneratingTrace W ⊤ η) {s q : ℝ≥0} (hs : 0 < s) (hsq : s < q) (U : Ultrafilter ℂ)
    (hU : (U : Filter ℂ) ≤ 𝓝[rightSideOf (range η)] (η s)) :
    ∃ y : ℝ, 0 < y ∧ Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W r.toNNReal) q z) U (𝓝 (y : ℂ)) := by
  set W' : ℝ → ℝ := fun r => W r.toNNReal with hW'
  have hW'c : Continuous W' := hW.comp continuous_real_toNNReal
  have hW'0 : W' 0 = 0 := by simp [hW', hW0]
  have hL : IsLoewnerTrace W' (Lemma71I.realPath η) := isLoewnerTrace_of_isGeneratingTrace htr
  have hA := hη.isProperArc
  have hq0 : (0 : ℝ) ≤ q := q.2
  have hS : rightSideOf (range η) = rightSideOf (WangWu.arcRange (Lemma71I.realPath η)) := by
    rw [Lemma71I.arcRange_realPath]
  have hSK : rightSideOf (range η) ⊆ H \ QuantumZipper.fwdHull W' q := fun w hw =>
    ⟨hw.1.1, fun hK => hw.1.2 (by
      have := WangWu.fwdHull_subset_arcRange hL hA hq0 hK
      rwa [Lemma71I.arcRange_realPath] at this)⟩
  have hU' : (U : Filter ℂ) ≤ 𝓝[rightSideOf (range η)] (Lemma71I.realPath η s) := by
    rw [Lemma71I.realPath_coe]; exact hU
  obtain ⟨x, hx0, -, hlim, hcl⟩ := WangWu.exists_real_tendsto_fwdMap hL hA hW'c hW'0 (s := (s : ℝ)) (t := (q : ℝ))
    (by exact_mod_cast hs) (by exact_mod_cast hsq) hSK U hU'
  refine ⟨x, lt_of_le_of_ne (not_lt.1 fun hneg => ?_) hx0.symm, hlim.mono_right nhdsWithin_le_nhds⟩
  refine (WangWu.isProperArc_futureArc hL hA hW'c hW'0 hq0).notMem_closure_rightSideOf_of_neg hneg ?_
  have hsub : QuantumZipper.fwdMap W' q '' rightSideOf (range η) ⊆
      rightSideOf (WangWu.arcRange (WangWu.futureArc W' q)) := by
    rw [hS]
    exact image_subset_iff.2 fun w hw => WangWu.fwdMap_mem_rightSideOf_futureArc hL hA hW'c hW'0 hq0 hw
  exact closure_mono hsub hcl

/-- **Aux. lemma 57 for a stopped prefix and a joint hull** (the lift step of `ReverseArc.reverseArcChart_of_mem_H`):
let `Γ ⊇ γ([0, q])` be compact with `fill Γ` a compact `ℍ`-hull, mapped out by `g_K` with canonical lift `L_K`, and
let the approach `U` to `p` come from the unbounded domain of `Γ`, near `p` the set `Γ` being contained in the prefix.
If the centred chart of the prefix tends to a real `y` along `U`, the canonical lifts of the prefix chart and of `g_K`
have the same limit of their imaginary parts. -/
theorem tendsto_lift_sub_of_agree {Γ : Set ℂ} (hΓc : IsCompact Γ) (hKΓ : IsHPHull (fillH Γ)) {gK LK : ℂ → ℂ}
    (hgK : IsMapOut (fillH Γ) gK) (hLK : IsCanonicalDerivLog (fillH Γ) gK LK) {p : ℂ} {ρ : ℝ} (hρ : 0 < ρ)
    (U : Ultrafilter ℂ) (hU : (U : Filter ℂ) ≤ 𝓝[H \ fillH Γ] p) {γ : ℝ≥0 → ℂ} {ζ : ℝ≥0∞} {x : ℝ}
    {W : ℝ≥0 → ℝ} {q : ℝ≥0} {y : ℝ} (hg : IsGeneratingTrace W ζ (fun t => γ t - x))
    (hWc : ContinuousOn W {s | (s : ℝ≥0∞) < ζ}) (hW0 : W 0 = 0) (hi : InjOn γ {t | (t : ℝ≥0∞) ≤ ζ})
    (hq : (q : ℝ≥0∞) < ζ) (hq0 : 0 < q) (hsub : γ '' Icc 0 q ⊆ Γ) (hloc : Γ ∩ ball p ρ ⊆ γ '' Icc 0 q)
    (hfy : Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W r.toNNReal) q (z - x)) U (𝓝 (y : ℂ))) :
    Tendsto (fun z => (LK z).im - (QuantumZipper.logDerivFwd (fun r : ℝ => W r.toNNReal) q (z - x)).im) U
      (𝓝 0) := by
  have hF : (U : Filter ℂ) ≤ 𝓟 (H \ fillH Γ) := hU.trans inf_le_right
  obtain ⟨κ, hK, hgm, hL⟩ := exists_physChart hg hWc hW0 hq
  obtain ⟨Φ, hΦc, hΦH, -, hinv, hmaps⟩ := exists_physInv hg hWc hW0 hi hq hq0
  obtain ⟨ε, hε, hno⟩ := exists_ball_notMem_of_approach hΓc.isClosed hsub hmaps hΦc hΦH hinv hρ hloc U hU hfy
  have hd : Disjoint (ball (((y + κ : ℝ)) : ℂ) ε)
      ((fun z => QuantumZipper.fwdMap (fun r : ℝ => W r.toNNReal) q (z - x) + κ) '' (fillH Γ \
        fillH (γ '' Icc 0 q))) := by
    rw [Set.disjoint_left]
    rintro w hwb ⟨z, ⟨hzK, hzA⟩, rfl⟩
    refine hno z ⟨hzK.1, hzA⟩ hzK ?_
    rw [mem_ball, dist_eq_norm] at hwb ⊢
    convert hwb using 2
    push_cast; ring
  have hq' : Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W r.toNNReal) q (z - x) + κ) U
      (𝓝[H] (((y + κ : ℝ)) : ℂ)) := by
    refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
    · have := hfy.add_const (κ : ℂ)
      convert this using 2
      push_cast; ring
    · filter_upwards [hF (mem_principal_self _)] with z hz
      exact hgm.1.2.mapsTo ⟨hz.1, fun h => hz.2 (fillH_mono hsub h)⟩
  exact tendsto_im_sub_of_le hK hKΓ (fillH_mono hsub) hgm hgK hL hLK hF hε hd hq'

end Chart

/-! ### The chart geometry of a common arc -/

/-- **The chart geometry of a common arc of two ordered curves** (proof of Lemma 6.13, p. 216: "This supplies a common
collar of `J₀` in which no other portion of either curve occurs. The inclusion `C₁ ⊆ C₂` forces the two designated
right sides to agree in this collar"). Let `η₁`, `η₂` be simple proper curves from `0` generated by continuous drivers,
`η₂` in the closed left side of `η₁`, stopped at `q₁`, `q₂`, and let the stopped ranges coincide near the common point
`η₁(s₁) = η₂(s₂)` (`0 < sᵢ < qᵢ`). Then this point is approached from the joint unbounded domain (from the right side of
`η₁`) along a nontrivial filter on which both centred charts tend to positive reals and the two canonical
derivative-argument lifts differ by a quantity tending to `0`. -/
theorem sameArc_chart {η₁ η₂ : ℝ≥0 → ℂ} (h₁ : IsSimpleProper η₁) (h₂ : IsSimpleProper η₂)
    (hord : range η₂ ⊆ closedLeftSide η₁) {W₁ W₂ : ℝ≥0 → ℝ} (hW₁ : Continuous W₁) (hW₁0 : W₁ 0 = 0)
    (hW₂ : Continuous W₂) (hW₂0 : W₂ 0 = 0) (htr₁ : IsGeneratingTrace W₁ ⊤ η₁) (htr₂ : IsGeneratingTrace W₂ ⊤ η₂)
    {q₁ q₂ s₁ s₂ : ℝ≥0} (hs₁ : 0 < s₁) (hs₁q : s₁ < q₁) (hs₂ : 0 < s₂) (hs₂q : s₂ < q₂) (hp : η₁ s₁ = η₂ s₂)
    {ρ : ℝ} (hρ : 0 < ρ) (hagree : η₁ '' Icc 0 q₁ ∩ ball (η₁ s₁) ρ = η₂ '' Icc 0 q₂ ∩ ball (η₁ s₁) ρ) :
    ∃ F : Filter ℂ, F.NeBot ∧ F ≤ 𝓝[H \ fillH (η₁ '' Icc 0 q₁ ∪ η₂ '' Icc 0 q₂)] (η₁ s₁) ∧
      ∃ y₁ y₂ : ℝ, 0 < y₁ ∧ 0 < y₂ ∧
      Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W₁ r.toNNReal) q₁ (z - ((0 : ℝ) : ℂ))) F
        (𝓝 (y₁ : ℂ)) ∧
      Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W₂ r.toNNReal) q₂ (z - ((0 : ℝ) : ℂ))) F
        (𝓝 (y₂ : ℂ)) ∧
      Tendsto (fun z => (QuantumZipper.logDerivFwd (fun r : ℝ => W₁ r.toNNReal) q₁ (z - ((0 : ℝ) : ℂ))).im -
        (QuantumZipper.logDerivFwd (fun r : ℝ => W₂ r.toNNReal) q₂ (z - ((0 : ℝ) : ℂ))).im) F (𝓝 0) := by
  set A := η₁ '' Icc 0 q₁ with hA
  set B := η₂ '' Icc 0 q₂ with hB
  set p := η₁ s₁ with hpdef
  set S := rightSideOf (range η₁) with hSdef
  have hAc : IsCompact A := isCompact_Icc.image h₁.1
  have hBc : IsCompact B := isCompact_Icc.image h₂.1
  have hABc : IsCompact (A ∪ B) := hAc.union hBc
  -- the right side of `η₁` lies in the joint unbounded domain
  have hdisj := disjoint_rightSideOf_of_subset_closedLeftSide h₁.isProperCurve h₁.2.2.1 hord
  have hSAB : S ⊆ H \ (A ∪ B) := fun w hw => ⟨hw.1.1, by
    rintro (⟨t, -, rfl⟩ | ⟨t, -, rfl⟩)
    · exact hw.1.2 ⟨t, rfl⟩
    · exact Set.disjoint_left.1 hdisj ⟨t, rfl⟩ hw⟩
  have hSpc : IsPreconnected S := by
    have := h₁.isProperArc.isPreconnected_rightSideOf
    rwa [Lemma71I.arcRange_realPath] at this
  have hSD : S ⊆ H \ fillH (A ∪ B) :=
    subset_H_diff_fillH_of_not_isBounded hABc.isClosed hSpc (not_isBounded_rightSideOf h₁) hSAB
  -- the approach
  have hneb : (𝓝[S] p).NeBot := mem_closure_iff_nhdsWithin_neBot.1 (mem_closure_rightSideOf h₁ s₁)
  set U := Ultrafilter.of (𝓝[S] p) with hUdef
  have hU : (U : Filter ℂ) ≤ 𝓝[S] p := Ultrafilter.of_le _
  have hUD : (U : Filter ℂ) ≤ 𝓝[H \ fillH (A ∪ B)] p := hU.trans (nhdsWithin_mono _ hSD)
  -- the two charts
  have hz0 : ∀ z : ℂ, z - ((0 : ℝ) : ℂ) = z := fun z => by rw [ofReal_zero, sub_zero]
  obtain ⟨y₁, hy₁, hf₁⟩ := exists_pos_tendsto_of_rightSideOf h₁ hW₁ hW₁0 htr₁ hs₁ hs₁q U hU
  have hU₂ : (U : Filter ℂ) ≤ 𝓝[rightSideOf (range η₂)] (η₂ s₂) := by
    rw [← hp]
    exact hU.trans (nhdsWithin_mono _ (rightSideOf_subset_rightSideOf h₁ h₂ hord))
  obtain ⟨y₂, hy₂, hf₂⟩ := exists_pos_tendsto_of_rightSideOf h₂ hW₂ hW₂0 htr₂ hs₂ hs₂q U hU₂
  replace hf₁ : Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W₁ r.toNNReal) q₁ (z - ((0 : ℝ) : ℂ))) U
      (𝓝 (y₁ : ℂ)) := by simpa only [hz0] using hf₁
  replace hf₂ : Tendsto (fun z => QuantumZipper.fwdMap (fun r : ℝ => W₂ r.toNNReal) q₂ (z - ((0 : ℝ) : ℂ))) U
      (𝓝 (y₂ : ℂ)) := by simpa only [hz0] using hf₂
  -- the joint hull and its lift
  have hKΓ : IsHPHull (fillH (A ∪ B)) := by
    refine isHPHull_fillH_of_isPreconnected hABc.isBounded ?_
    have hApc : IsPreconnected A := isPreconnected_Icc.image _ h₁.1.continuousOn
    have hBpc : IsPreconnected B := isPreconnected_Icc.image _ h₂.1.continuousOn
    have hlow : IsPreconnected {z : ℂ | z.im ≤ 0} := isPreconnected_lowerHalf
    have h0A : (0 : ℂ) ∈ A := ⟨0, ⟨le_rfl, zero_le⟩, h₁.2.2.1⟩
    have h0B : (0 : ℂ) ∈ B := ⟨0, ⟨le_rfl, zero_le⟩, h₂.2.2.1⟩
    have h0l : (0 : ℂ) ∈ {z : ℂ | z.im ≤ 0} := by simp
    have h1 := hApc.union (0 : ℂ) h0A h0l hlow
    have h2 := h1.union (0 : ℂ) (Or.inr h0l) h0B hBpc
    rwa [union_right_comm] at h2
  set gK := ConformalImage.mapOut (fillH (A ∪ B)) with hgKdef
  have hgK : IsMapOut (fillH (A ∪ B)) gK := ConformalImage.isMapOut_mapOut hKΓ
  obtain ⟨LK, hLK⟩ := exists_isCanonicalDerivLog hKΓ hgK
  have hloc₁ : (A ∪ B) ∩ ball p ρ ⊆ A := by
    rintro z ⟨hz | hz, hzb⟩
    · exact hz
    · have : z ∈ B ∩ ball p ρ := ⟨hz, hzb⟩
      rw [← hagree] at this
      exact this.1
  have hloc₂ : (A ∪ B) ∩ ball p ρ ⊆ B := by
    rintro z ⟨hz | hz, hzb⟩
    · have : z ∈ A ∩ ball p ρ := ⟨hz, hzb⟩
      rw [hagree] at this
      exact this.1
    · exact hz
  have hg₁ : IsGeneratingTrace W₁ ⊤ (fun t => η₁ t - ((0 : ℝ) : ℂ)) := by simpa only [hz0] using htr₁
  have hg₂ : IsGeneratingTrace W₂ ⊤ (fun t => η₂ t - ((0 : ℝ) : ℂ)) := by simpa only [hz0] using htr₂
  have hl₁ := tendsto_lift_sub_of_agree hABc hKΓ hgK hLK hρ U hUD hg₁ hW₁.continuousOn hW₁0 h₁.2.1.injOn
    ENNReal.coe_lt_top (hs₁.trans hs₁q) subset_union_left hloc₁ hf₁
  have hl₂ := tendsto_lift_sub_of_agree hABc hKΓ hgK hLK hρ U hUD hg₂ hW₂.continuousOn hW₂0 h₂.2.1.injOn
    ENNReal.coe_lt_top (hs₂.trans hs₂q) subset_union_right hloc₂ hf₂
  refine ⟨U, inferInstance, hUD, y₁, y₂, hy₁, hy₂, hf₁, hf₂, ?_⟩
  have := hl₂.sub hl₁
  rw [sub_zero] at this
  refine this.congr fun z => ?_
  ring

end InteractingSLE.Sec7.Lemma613
