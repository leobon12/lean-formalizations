import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
import Mathlib.MeasureTheory.PiSystem

/-!
# Future freezing: the conditional-expectation steps of Aux. lemma 47

Packet PROVE-SEC7-A (specification §7.1, `source/spec/p193-240.md` L644–L691, pp. 227–229). Aux. lemma 47
proves that, after the hull germ is retained (`𝒢_τ ⊇ 𝓕_τ`), the conditional law of the future driving
history given `𝒢_τ` is the restarted driving law from the current state, hence depends only on `𝓕_τ`.
Its last two steps are abstract and are proved here.

* **(GB1)** (`condExp_mul_eq_mul_condExp_of_condExp_eq`): if `𝓕 ≤ 𝒢`, `Y` is `𝒢`-measurable and bounded, and
  the conditional expectation of `F` given `𝒢` equals the one given `𝓕`, then
  `E[Y F | 𝓕] = E[Y | 𝓕] E[F | 𝓕]`. ("Taking conditional expectations proves (GB1)"; the same tower
  calculation applies with `𝓕` replaced by the recorded stopped-history `σ`-algebra, which is the same
  lemma with a different `𝓕`.)
* **(GB5)**, the freezing consequence (`condExp_eq_of_le_sup_comap`): if, in addition, the whole
  conditional law of the future history `Z` given `𝒢` only depends on `𝓕` (the hypothesis of (GB1) for
  every indicator `1_B(Z)`), then for every `σ`-algebra `𝓕'` with `𝓕 ≤ 𝓕' ≤ 𝓕 ∨ σ(Z)` (for
  `𝓕' = 𝓕_σ`, `σ ≥ τ`: the own filtration at the later time is generated by the earlier one and the future
  driving history) one has `E[Y | 𝓕'] = E[Y | 𝓕]`: "future driving information cannot change an already
  revealed pocket-field law".

The proof of (GB5): (GB1) gives `∫_{A ∩ Z⁻¹B} Y = ∫_{A ∩ Z⁻¹B} E[Y | 𝓕]` for `A ∈ 𝓕`; these sets form a
π-system generating `𝓕 ∨ σ(Z)`, the sets on which the two integrals agree form a Dynkin system, so
`E[Y | 𝓕]` is a version of `E[Y | 𝓕 ∨ σ(Z)]`; the tower property passes to `𝓕'`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Set

namespace InteractingSLE

namespace Sec7

variable {Ω : Type*} {m₀ : MeasurableSpace Ω} {μ : Measure Ω} [IsFiniteMeasure μ]

/-- **(GB1)** (Aux. lemma 47, specification p. 227): if `𝓕 ≤ 𝒢`, `Y` is `𝒢`-measurable and bounded, `F`
is integrable and `E[F | 𝒢] = E[F | 𝓕]`, then `E[Y F | 𝓕] = E[Y | 𝓕] E[F | 𝓕]`. -/
theorem condExp_mul_eq_mul_condExp_of_condExp_eq {𝓕 𝒢 : MeasurableSpace Ω} (h𝓕𝒢 : 𝓕 ≤ 𝒢)
    (h𝒢 : 𝒢 ≤ m₀) {Y F : Ω → ℝ} (hY : StronglyMeasurable[𝒢] Y) {C : ℝ}
    (hYb : ∀ᵐ ω ∂μ, ‖Y ω‖ ≤ C) (hF : Integrable F μ) (hGF : μ[F | 𝒢] =ᵐ[μ] μ[F | 𝓕]) :
    μ[Y * F | 𝓕] =ᵐ[μ] μ[Y | 𝓕] * μ[F | 𝓕] := by
  have hYm : AEStronglyMeasurable[m₀] Y μ := (hY.mono h𝒢).aestronglyMeasurable
  have hYF : Integrable (Y * F) μ := hF.bdd_mul hYm hYb
  have hYi : Integrable Y μ := Integrable.of_bound hYm C hYb
  have hYc : Integrable (Y * μ[F | 𝓕]) μ := integrable_condExp.bdd_mul hYm hYb
  calc μ[Y * F | 𝓕] =ᵐ[μ] μ[μ[Y * F | 𝒢] | 𝓕] := (condExp_condExp_of_le h𝓕𝒢 h𝒢).symm
    _ =ᵐ[μ] μ[Y * μ[F | 𝓕] | 𝓕] := by
        refine condExp_congr_ae ?_
        filter_upwards [condExp_mul_of_stronglyMeasurable_left hY hYF hF, hGF] with ω h1 h2
        rw [h1, Pi.mul_apply, Pi.mul_apply, h2]
    _ =ᵐ[μ] μ[Y | 𝓕] * μ[F | 𝓕] :=
        condExp_mul_of_stronglyMeasurable_right stronglyMeasurable_condExp hYc hYi

/-- The sets `A ∩ Z⁻¹ B` (`A ∈ 𝓕`, `B` measurable) generate `𝓕 ∨ σ(Z)`. -/
theorem sup_comap_eq_generateFrom {β : Type*} [mβ : MeasurableSpace β] (𝓕 : MeasurableSpace Ω)
    (Z : Ω → β) :
    𝓕 ⊔ mβ.comap Z =
      MeasurableSpace.generateFrom
        {s | ∃ A B, MeasurableSet[𝓕] A ∧ MeasurableSet B ∧ s = A ∩ Z ⁻¹' B} := by
  apply le_antisymm
  · refine sup_le (fun A hA => ?_) (fun s hs => ?_)
    · exact MeasurableSpace.measurableSet_generateFrom ⟨A, univ, hA, MeasurableSet.univ, by simp⟩
    · obtain ⟨B, hB, rfl⟩ := hs
      exact MeasurableSpace.measurableSet_generateFrom
        ⟨univ, B, MeasurableSet.univ, hB, by simp⟩
  · refine MeasurableSpace.generateFrom_le fun s hs => ?_
    obtain ⟨A, B, hA, hB, rfl⟩ := hs
    exact (le_sup_left (a := 𝓕) (b := mβ.comap Z) A hA).inter
      (le_sup_right (a := 𝓕) (b := mβ.comap Z) _ ⟨B, hB, rfl⟩)

theorem isPiSystem_inter_preimage {β : Type*} [MeasurableSpace β] (𝓕 : MeasurableSpace Ω)
    (Z : Ω → β) :
    IsPiSystem {s | ∃ A B, MeasurableSet[𝓕] A ∧ MeasurableSet B ∧ s = A ∩ Z ⁻¹' B} := by
  rintro _ ⟨A₁, B₁, hA₁, hB₁, rfl⟩ _ ⟨A₂, B₂, hA₂, hB₂, rfl⟩ -
  refine ⟨A₁ ∩ A₂, B₁ ∩ B₂, hA₁.inter hA₂, hB₁.inter hB₂, ?_⟩
  ext ω
  simp only [mem_inter_iff, mem_preimage]
  tauto

/-- **(GB5)**, the freezing consequence of Aux. lemma 47 (specification p. 229). Let `𝓕 ≤ 𝒢`, let `Z` be
a random element (the future driving history) whose conditional law given `𝒢` only depends on `𝓕`
(`E[1_B(Z) | 𝒢] = E[1_B(Z) | 𝓕]` for every measurable `B`), and let `Y` be bounded and `𝒢`-measurable.
Then for every `σ`-algebra `𝓕'` with `𝓕 ≤ 𝓕' ≤ 𝓕 ∨ σ(Z)`, `E[Y | 𝓕'] = E[Y | 𝓕]`. -/
theorem condExp_eq_of_le_sup_comap {β : Type*} [mβ : MeasurableSpace β] {𝓕 𝒢 𝓕' : MeasurableSpace Ω}
    {Z : Ω → β} (h𝓕𝒢 : 𝓕 ≤ 𝒢) (h𝒢 : 𝒢 ≤ m₀) (h𝓕𝓕' : 𝓕 ≤ 𝓕') (h𝓕'Z : 𝓕' ≤ 𝓕 ⊔ mβ.comap Z)
    (hZ : @Measurable Ω β m₀ mβ Z) {Y : Ω → ℝ} (hY : StronglyMeasurable[𝒢] Y) {C : ℝ}
    (hYb : ∀ᵐ ω ∂μ, ‖Y ω‖ ≤ C)
    (hlaw : ∀ B : Set β, MeasurableSet B →
      μ[(Z ⁻¹' B).indicator (fun _ => (1 : ℝ)) | 𝒢] =ᵐ[μ]
        μ[(Z ⁻¹' B).indicator (fun _ => (1 : ℝ)) | 𝓕]) :
    μ[Y | 𝓕'] =ᵐ[μ] μ[Y | 𝓕] := by
  have h𝓕 : 𝓕 ≤ m₀ := h𝓕𝒢.trans h𝒢
  have hYm : AEStronglyMeasurable[m₀] Y μ := (hY.mono h𝒢).aestronglyMeasurable
  have hYi : Integrable Y μ := Integrable.of_bound hYm C hYb
  have h𝓗 : 𝓕 ⊔ mβ.comap Z ≤ m₀ := sup_le h𝓕 hZ.comap_le
  -- the identity on the generators `A ∩ Z⁻¹ B`
  have hgen : ∀ A B, MeasurableSet[𝓕] A → MeasurableSet B →
      ∫ ω in A ∩ Z ⁻¹' B, Y ω ∂μ = ∫ ω in A ∩ Z ⁻¹' B, (μ[Y | 𝓕]) ω ∂μ := by
    intro A B hA hB
    have hZB : MeasurableSet[m₀] (Z ⁻¹' B) := hZ hB
    set I : Ω → ℝ := (Z ⁻¹' B).indicator fun _ => (1 : ℝ) with hIdef
    have hI : Integrable I μ := (integrable_const 1).indicator hZB
    have hmulI : ∀ f : Ω → ℝ, f * I = (Z ⁻¹' B).indicator f := fun f => by
      funext ω
      by_cases hω : ω ∈ Z ⁻¹' B
      · simp [hIdef, indicator_of_mem hω]
      · simp [hIdef, indicator_of_notMem hω]
    have hGB1 := condExp_mul_eq_mul_condExp_of_condExp_eq h𝓕𝒢 h𝒢 hY hYb hI (hlaw B hB)
    have hgI : Integrable (μ[Y | 𝓕] * I) μ := by
      rw [hmulI]; exact integrable_condExp.indicator hZB
    have hYI : Integrable (Y * I) μ := by
      rw [hmulI]; exact hYi.indicator hZB
    have hpull := condExp_mul_of_stronglyMeasurable_left
      (stronglyMeasurable_condExp (m := 𝓕) (μ := μ) (f := Y)) hgI hI
    calc ∫ ω in A ∩ Z ⁻¹' B, Y ω ∂μ = ∫ ω in A, (Y * I) ω ∂μ := by
          rw [hmulI, setIntegral_indicator hZB]
      _ = ∫ ω in A, (μ[Y * I | 𝓕]) ω ∂μ := (setIntegral_condExp h𝓕 hYI hA).symm
      _ = ∫ ω in A, (μ[μ[Y | 𝓕] * I | 𝓕]) ω ∂μ :=
          setIntegral_congr_ae (h𝓕 A hA) (by
            filter_upwards [hGB1, hpull] with ω h1 h2 _
            rw [h1, h2])
      _ = ∫ ω in A, (μ[Y | 𝓕] * I) ω ∂μ := setIntegral_condExp h𝓕 hgI hA
      _ = ∫ ω in A ∩ Z ⁻¹' B, (μ[Y | 𝓕]) ω ∂μ := by
          rw [hmulI, setIntegral_indicator hZB]
  -- Dynkin's π-λ theorem on `𝓕 ∨ σ(Z)`
  have hall : ∀ t, MeasurableSet[𝓕 ⊔ mβ.comap Z] t →
      ∫ ω in t, Y ω ∂μ = ∫ ω in t, (μ[Y | 𝓕]) ω ∂μ := by
    intro t ht
    refine MeasurableSpace.induction_on_inter (m := 𝓕 ⊔ mβ.comap Z)
      (C := fun t _ => ∫ ω in t, Y ω ∂μ = ∫ ω in t, (μ[Y | 𝓕]) ω ∂μ)
      (sup_comap_eq_generateFrom 𝓕 Z) (isPiSystem_inter_preimage 𝓕 Z) ?_ ?_ ?_ ?_ t ht
    · simp
    · rintro _ ⟨A, B, hA, hB, rfl⟩
      exact hgen A B hA hB
    · intro t htm hEq
      have htm' : MeasurableSet[m₀] t := h𝓗 t htm
      rw [setIntegral_compl htm' hYi, setIntegral_compl htm' integrable_condExp, hEq,
        integral_condExp h𝓕]
    · intro f hdisj hfm hEq
      have hfm' : ∀ i, MeasurableSet[m₀] (f i) := fun i => h𝓗 _ (hfm i)
      rw [integral_iUnion hfm' hdisj hYi.integrableOn,
        integral_iUnion hfm' hdisj integrable_condExp.integrableOn]
      exact tsum_congr hEq
  have hver : μ[Y | 𝓕] =ᵐ[μ] μ[Y | 𝓕 ⊔ mβ.comap Z] :=
    ae_eq_condExp_of_forall_setIntegral_eq h𝓗 hYi
      (fun _ _ _ => integrable_condExp.integrableOn)
      (fun t ht _ => (hall t ht).symm)
      (StronglyMeasurable.aestronglyMeasurable
        ((stronglyMeasurable_condExp (m := 𝓕) (μ := μ) (f := Y)).mono
          (le_sup_left : 𝓕 ≤ 𝓕 ⊔ mβ.comap Z)))
  calc μ[Y | 𝓕'] =ᵐ[μ] μ[μ[Y | 𝓕 ⊔ mβ.comap Z] | 𝓕'] := (condExp_condExp_of_le h𝓕'Z h𝓗).symm
    _ =ᵐ[μ] μ[μ[Y | 𝓕] | 𝓕'] := condExp_congr_ae hver.symm
    _ = μ[Y | 𝓕] := condExp_of_stronglyMeasurable (h𝓕'Z.trans h𝓗)
        (stronglyMeasurable_condExp.mono h𝓕𝓕') integrable_condExp

end Sec7

end InteractingSLE
