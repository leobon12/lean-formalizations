import InteractingSLE.Spec.Sec7.PocketStopMarkedMeas

/-!
# The marks of a marked stop, and the records at `T` and `T ∨ s` on `{s ≤ T}`

Packet PROVE-R5-ENLARGED. Aux. 35's proof (`source/spec/p193-240.md` L22–L28, p. 194): "For each deterministic
rational `q`, let `q* = q ∧ H` and set `T_q = T ∨ q*`. The assumed marked law at `T_q` retains the entire stopped
counterflow history … On `{q < T}`, one has `q* = q` and `T_q = T`. … on this event the retained stopped information
and the marked harmonic mean for `A_{T_q}` are exactly those for `A_T`. This is an equality of the restricted stopped
sigma-algebras."

In the Galmarino form `PocketStopWallsFin.IsMarkedStop ℳ 𝓕 X T` (every mark `M` has `{T ≤ σ} ∩ M ∈ σ(X) ∨ 𝓕_σ` at
every stopping time `σ`), the stopped information of `T` is the σ-algebra generated by all admissible marks:

* `stopMarks 𝓕 X T`, `markedStopSigma 𝓕 X T`;
* `isMarkedStop_markedStopSigma` — it is a mark σ-algebra of `T` (the largest one: `le_markedStopSigma`);
* `le_markedStopSigma_max` — the stop `T ∨ s` (a constant `s`) retains the original information `𝓕_s` and `σ(X)`;
* `mem_stopMarks_le` — the event `{s ≤ T}` is a mark of `T` and of `T ∨ s`;
* **`comap_val_markedStopSigma_eq`** — on an event `E` that is a mark of two stops agreeing on `E`, the two stopped
  σ-algebras have the same trace; in particular (**`comap_val_markedStopSigma_max_eq`**) the stopped information at
  `T` and at `T ∨ s` agree on `{s ≤ T}`.

These feed `hmarks` of `hasOldChartIncrementLawOn_of_enlarged_marked`. Conditional helpers with distinct names;
nothing here uses Theorem 1.2/1.3 or any `*_of_param` (R43, R48).
-/

set_option autoImplicit false
noncomputable section

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal

namespace InteractingSLE.Sec7.R5Enl

open PocketStopWallsFin

section Stop

variable {Ω 𝒳 : Type*} [MeasurableSpace 𝒳] {mΩ : MeasurableSpace Ω} {𝓕 : Filtration ℝ≥0 mΩ} {X : Ω → 𝒳}

/-- The admissible marks of a stop `T`: events `M` of `σ(X) ∨ 𝓕_∞` with `{T ≤ σ} ∩ M ∈ σ(X) ∨ 𝓕_σ` at every
`ℝ≥0`-valued stopping time `σ`. -/
def stopMarks (𝓕 : Filtration ℝ≥0 mΩ) (X : Ω → 𝒳) (T : Ω → ℝ≥0∞) : Set (Set Ω) :=
  {M | MeasurableSet[MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t] M ∧
    ∀ (σ : Ω → ℝ≥0) (hσ : IsStoppingTime 𝓕 fun ω => ((σ ω : ℝ≥0) : WithTop ℝ≥0)),
    MeasurableSet[MeasurableSpace.comap X inferInstance ⊔ hσ.measurableSpace] ({ω | T ω ≤ (σ ω : ℝ≥0∞)} ∩ M)}

/-- **The stopped information of a marked stop**: the σ-algebra generated by its admissible marks. -/
@[instance_reducible]
def markedStopSigma (𝓕 : Filtration ℝ≥0 mΩ) (X : Ω → 𝒳) (T : Ω → ℝ≥0∞) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom (stopMarks 𝓕 X T)

/-- Every mark σ-algebra of `T` is contained in its stopped information. -/
theorem le_markedStopSigma {ℳ : MeasurableSpace Ω} {T : Ω → ℝ≥0∞} (h : IsMarkedStop ℳ 𝓕 X T)
    (h0 : ℳ ≤ MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t) : ℳ ≤ markedStopSigma 𝓕 X T :=
  fun M hM => MeasurableSpace.measurableSet_generateFrom ⟨h0 M hM, fun σ hσ => h σ hσ M hM⟩

/-- The stopped information is contained in `σ(X) ∨ 𝓕_∞` (the `hS0` input of the walls laws). -/
theorem markedStopSigma_le (T : Ω → ℝ≥0∞) :
    markedStopSigma 𝓕 X T ≤ MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t :=
  MeasurableSpace.generateFrom_le fun _ hN => hN.1

/-- **The stopped information is a mark σ-algebra of `T`** (for a stop with `{T ≤ σ} ∈ σ(X) ∨ 𝓕_σ`). -/
theorem isMarkedStop_markedStopSigma {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) :
    IsMarkedStop (markedStopSigma 𝓕 X T) 𝓕 X T := by
  intro σ hσ M hM
  set 𝒮 : MeasurableSpace Ω := MeasurableSpace.comap X inferInstance ⊔ hσ.measurableSpace
  have hD : MeasurableSet[𝒮] {ω | T ω ≤ (σ ω : ℝ≥0∞)} := by
    simpa only [inter_univ] using hT σ hσ univ (@MeasurableSet.univ _ ⊥)
  have hle : markedStopSigma 𝓕 X T ≤ PocketStopMarked.traceSigma 𝒮 _ hD :=
    MeasurableSpace.generateFrom_le fun N hN => hN.2 σ hσ
  exact hle M hM

/-- The stop `T ∨ s` retains `σ(X)`-free original information `𝓕_s`: every event of `𝓕_s` is a mark of it. -/
theorem le_markedStopSigma_max {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) (s : ℝ≥0) :
    𝓕 s ≤ markedStopSigma 𝓕 X (fun ω => max (T ω) (s : ℝ≥0∞)) := by
  have h := PocketStopSide.isMarkedStop_max_ordinary hT (isStoppingTime_const 𝓕 s)
  rw [IsStoppingTime.measurableSpace_const] at h
  refine le_sup_right.trans (le_markedStopSigma h (sup_le ?_ ?_))
  · intro M hM
    exact (@MeasurableSpace.measurableSet_bot_iff Ω M).1 hM |>.elim
      (fun e => e ▸ @MeasurableSet.empty _ (MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t))
      (fun e => e ▸ @MeasurableSet.univ _ (MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t))
  · exact (le_iSup (fun t => 𝓕 t) s).trans le_sup_right

/-- **`{s ≤ T}` is a mark of `T`.** -/
theorem mem_stopMarks_le {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) (s : ℝ≥0) :
    {ω | (s : ℝ≥0∞) ≤ T ω} ∈ stopMarks 𝓕 X T := by
  refine ⟨?_, fun σ hσ => ?_⟩
  · have h := measurableSet_lt_inter_of_isMarkedStop hT (@MeasurableSet.univ _ ⊥) s
    rw [inter_univ] at h
    have h' : MeasurableSet[MeasurableSpace.comap X inferInstance ⊔ ⨆ t, 𝓕 t] {ω | T ω < (s : ℝ≥0∞)} :=
      (sup_le_sup_left (le_iSup (fun t => 𝓕 t) s) _) _ h
    have e : {ω | (s : ℝ≥0∞) ≤ T ω} = {ω | T ω < (s : ℝ≥0∞)}ᶜ := by
      ext ω
      simp only [mem_ofPred_eq, mem_compl_iff, not_lt]
    rw [e]
    exact h'.compl
  set 𝒮 : MeasurableSpace Ω := MeasurableSpace.comap X inferInstance ⊔ hσ.measurableSpace
  have hD : MeasurableSet[𝒮] {ω | T ω ≤ (σ ω : ℝ≥0∞)} := by
    simpa only [inter_univ] using hT σ hσ univ (@MeasurableSet.univ _ ⊥)
  -- `{T < s} ∩ {T ≤ σ} = ⋃_{q < s} {T ≤ min q σ}`
  have hlt : MeasurableSet[𝒮] ({ω | T ω < (s : ℝ≥0∞)} ∩ {ω | T ω ≤ (σ ω : ℝ≥0∞)}) := by
    have e : {ω | T ω < (s : ℝ≥0∞)} ∩ {ω | T ω ≤ (σ ω : ℝ≥0∞)} =
        ⋃ q : ℚ, ⋃ (_ : ((Real.toNNReal q : ℝ≥0) : ℝ≥0∞) < s),
          {ω | T ω ≤ ((min (Real.toNNReal q) (σ ω) : ℝ≥0) : ℝ≥0∞)} := by
      ext ω
      simp only [mem_inter_iff, mem_ofPred_eq, mem_iUnion, exists_prop, ENNReal.coe_min, le_min_iff]
      constructor
      · rintro ⟨hlt, hσω⟩
        obtain ⟨q, -, h1, h2⟩ := ENNReal.lt_iff_exists_rat_btwn.1 hlt
        exact ⟨q, h2, h1.le, hσω⟩
      · rintro ⟨q, hq, h1, h2⟩
        exact ⟨h1.trans_lt hq, h2⟩
    rw [e]
    refine MeasurableSet.iUnion fun q => MeasurableSet.iUnion fun _ => ?_
    have hστ : IsStoppingTime 𝓕 fun ω => ((min (Real.toNNReal q) (σ ω) : ℝ≥0) : WithTop ℝ≥0) := by
      have h := (isStoppingTime_const 𝓕 (Real.toNNReal q)).min hσ
      simpa only [WithTop.coe_min] using h
    have hmono : hστ.measurableSpace ≤ hσ.measurableSpace :=
      IsStoppingTime.measurableSpace_mono hστ hσ fun ω => WithTop.coe_le_coe.2 (min_le_right _ _)
    have h := hT (fun ω => min (Real.toNNReal q) (σ ω)) hστ univ (@MeasurableSet.univ _ ⊥)
    rw [inter_univ] at h
    exact (sup_le_sup_left hmono _) _ h
  have e : {ω | T ω ≤ (σ ω : ℝ≥0∞)} ∩ {ω | (s : ℝ≥0∞) ≤ T ω} =
      {ω | T ω ≤ (σ ω : ℝ≥0∞)} \ ({ω | T ω < (s : ℝ≥0∞)} ∩ {ω | T ω ≤ (σ ω : ℝ≥0∞)}) := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq, Set.mem_sdiff, not_and]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨h1, fun h3 => absurd h2 (not_le.2 h3)⟩
    · rintro ⟨h1, h2⟩
      exact ⟨h1, not_lt.1 fun h3 => h2 h3 h1⟩
  rw [e]
  exact hD.diff hlt

/-- An event of a stop's marks on which two stops agree is a mark of the other stop. -/
theorem mem_stopMarks_of_eqOn {T T' : Ω → ℝ≥0∞} {E : Set Ω} (hE : E ∈ stopMarks 𝓕 X T)
    (hTT : ∀ ω ∈ E, T ω = T' ω) : E ∈ stopMarks 𝓕 X T' := by
  refine ⟨hE.1, fun σ hσ => ?_⟩
  have e : {ω | T' ω ≤ (σ ω : ℝ≥0∞)} ∩ E = {ω | T ω ≤ (σ ω : ℝ≥0∞)} ∩ E := by
    ext ω
    simp only [mem_inter_iff, mem_ofPred_eq]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨(hTT ω h2).symm ▸ h1, h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨hTT ω h2 ▸ h1, h2⟩
  rw [e]
  exact hE.2 σ hσ

/-- **Two stops agreeing on a common mark `E` have the same stopped information on `E`.** -/
theorem comap_val_markedStopSigma_eq {T T' : Ω → ℝ≥0∞} {E : Set Ω} (hE : E ∈ stopMarks 𝓕 X T)
    (hTT : ∀ ω ∈ E, T ω = T' ω) :
    MeasurableSpace.comap ((↑) : E → Ω) (markedStopSigma 𝓕 X T) =
      MeasurableSpace.comap ((↑) : E → Ω) (markedStopSigma 𝓕 X T') := by
  have hE' : E ∈ stopMarks 𝓕 X T' := mem_stopMarks_of_eqOn hE hTT
  -- marks of one stop, cut to `E`, are marks of the other
  have hcut : ∀ {T₁ T₂ : Ω → ℝ≥0∞}, E ∈ stopMarks 𝓕 X T₁ → (∀ ω ∈ E, T₁ ω = T₂ ω) →
      ∀ M ∈ stopMarks 𝓕 X T₁, E ∩ M ∈ stopMarks 𝓕 X T₂ := by
    intro T₁ T₂ hE₁ h12 M hM
    refine ⟨hE₁.1.inter hM.1, fun σ hσ => ?_⟩
    have e : {ω | T₂ ω ≤ (σ ω : ℝ≥0∞)} ∩ (E ∩ M) =
        ({ω | T₁ ω ≤ (σ ω : ℝ≥0∞)} ∩ E) ∩ ({ω | T₁ ω ≤ (σ ω : ℝ≥0∞)} ∩ M) := by
      ext ω
      simp only [mem_inter_iff, mem_ofPred_eq]
      constructor
      · rintro ⟨h1, h2, h3⟩
        have h1' : T₁ ω ≤ (σ ω : ℝ≥0∞) := (h12 ω h2).symm ▸ h1
        exact ⟨⟨h1', h2⟩, h1', h3⟩
      · rintro ⟨⟨h1, h2⟩, -, h3⟩
        exact ⟨h12 ω h2 ▸ h1, h2, h3⟩
    rw [e]
    exact (hE₁.2 σ hσ).inter (hM.2 σ hσ)
  have hval : ∀ M : Set Ω, ((↑) : E → Ω) ⁻¹' (E ∩ M) = ((↑) : E → Ω) ⁻¹' M := fun M => by
    ext x
    simp only [mem_preimage, mem_inter_iff, x.2, true_and]
  have hside : ∀ {T₁ T₂ : Ω → ℝ≥0∞}, E ∈ stopMarks 𝓕 X T₁ → (∀ ω ∈ E, T₁ ω = T₂ ω) →
      MeasurableSpace.comap ((↑) : E → Ω) (markedStopSigma 𝓕 X T₁) ≤
        MeasurableSpace.comap ((↑) : E → Ω) (markedStopSigma 𝓕 X T₂) := by
    intro T₁ T₂ hE₁ h12
    rw [markedStopSigma, markedStopSigma, MeasurableSpace.comap_generateFrom, MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨M, hM, rfl⟩
    rw [← hval M]
    exact MeasurableSpace.measurableSet_generateFrom ⟨E ∩ M, hcut hE₁ h12 M hM, rfl⟩
  exact le_antisymm (hside hE hTT) (hside hE' fun ω hω => (hTT ω hω).symm)

/-- **The stopped information at `T` and at `T ∨ s` agree on `{s ≤ T}`** (Aux. 35's "equality of the restricted
stopped sigma-algebras"). -/
theorem comap_val_markedStopSigma_max_eq {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) (s : ℝ≥0) :
    MeasurableSpace.comap ((↑) : {ω | (s : ℝ≥0∞) ≤ T ω} → Ω) (markedStopSigma 𝓕 X T) =
      MeasurableSpace.comap ((↑) : {ω | (s : ℝ≥0∞) ≤ T ω} → Ω)
        (markedStopSigma 𝓕 X fun ω => max (T ω) (s : ℝ≥0∞)) :=
  comap_val_markedStopSigma_eq (mem_stopMarks_le hT s) fun _ω hω => (max_eq_left hω).symm

/-- `{s ≤ T}` is an event of the stopped information at `T` and at `T ∨ s`. -/
theorem measurableSet_le_markedStopSigma {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) (s : ℝ≥0) :
    MeasurableSet[markedStopSigma 𝓕 X T] {ω | (s : ℝ≥0∞) ≤ T ω} ∧
      MeasurableSet[markedStopSigma 𝓕 X fun ω => max (T ω) (s : ℝ≥0∞)] {ω | (s : ℝ≥0∞) ≤ T ω} :=
  ⟨MeasurableSpace.measurableSet_generateFrom (mem_stopMarks_le hT s),
    MeasurableSpace.measurableSet_generateFrom
      (mem_stopMarks_of_eqOn (mem_stopMarks_le hT s) fun _ω hω => (max_eq_left hω).symm)⟩

/-- The information `σ(X)` is retained by every marked stop. -/
theorem comap_le_markedStopSigma {T : Ω → ℝ≥0∞} (hT : IsMarkedStop ⊥ 𝓕 X T) :
    MeasurableSpace.comap X inferInstance ≤ markedStopSigma 𝓕 X T := by
  rintro _ ⟨B, hB, rfl⟩
  refine MeasurableSpace.measurableSet_generateFrom ⟨le_sup_left (b := ⨆ t, 𝓕 t) _ ⟨B, hB, rfl⟩, fun σ hσ => ?_⟩
  have hD := hT σ hσ univ (@MeasurableSet.univ _ ⊥)
  rw [inter_univ] at hD
  exact hD.inter (le_sup_left (b := hσ.measurableSpace) _ ⟨B, hB, rfl⟩)

/-- **Common marks joined with the stopped information at `T` and at `T ∨ s` agree on `{s ≤ T}`** (the `hmarks`
input of `hasOldChartIncrementLawOn_of_enlarged_marked`). -/
theorem comap_val_sup_markedStopSigma_max_eq (ℳ : MeasurableSpace Ω) {T : Ω → ℝ≥0∞}
    (hT : IsMarkedStop ⊥ 𝓕 X T) (s : ℝ≥0) :
    MeasurableSpace.comap ((↑) : {ω | (s : ℝ≥0∞) ≤ T ω} → Ω) (ℳ ⊔ markedStopSigma 𝓕 X T) =
      MeasurableSpace.comap ((↑) : {ω | (s : ℝ≥0∞) ≤ T ω} → Ω)
        (ℳ ⊔ markedStopSigma 𝓕 X fun ω => max (T ω) (s : ℝ≥0∞)) := by
  rw [MeasurableSpace.comap_sup, MeasurableSpace.comap_sup, comap_val_markedStopSigma_max_eq hT s]

end Stop

end InteractingSLE.Sec7.R5Enl
