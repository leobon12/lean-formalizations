import InteractingSLE.Spec.Sec7.Aux122Disint

/-!
# §7.4, Aux. lemma 122: a countably generated filtration for the disintegration

Packet PROVE-AUX119-130. Specification §7.4.1, Aux. lemma 122, last paragraph of its proof
(`source/spec/p385-432.md` L111–L139, p. 391).

To disintegrate an evolution over its initial information (`Aux122DisintEvol.lean`) the Brownian property must be
checked under almost every conditional law simultaneously for all events of the filtration; this needs a filtration
generated by countably many events at each time. This file constructs it from one null set `N` off which the paths
are continuous:

* `zeroOn N X` (the process set to `0` on `N`) and `killAt ζ X q` (the value at `q`, or `0` when `q ≥ ζ`);
* `ratApprox n t ≤ t`, rational left approximants of `t` (`tendsto_ratApprox`);
* `dataGens N ζ B X t`: the event `N`, the event `{t < ζ}` and, at every rational `q ≤ t`, the events `{q < ζ}`,
  `{B̂_q < a}` and `{killAt ζ X̂ᵢ q < a}` (`a ∈ ℚ`); `dataFilt` the generated filtration (`dataFilt_apply`);
* the modified processes are adapted (`measurable_zeroOn_dataFilt`, `adaptedBefore_zeroOn_dataFilt`), using
  continuity off `N` and the rational left approximants;
* every event of `dataFilt t` agrees off `N` with an event of the original filtration at time `t`
  (`exists_eq_diff_of_measurableSet_dataFilt`).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

namespace Aux122Disint

/-! ### Rational times and rational left approximants -/

/-- The time of a rational, `max q 0`. -/
def rt (q : ℚ) : ℝ≥0 := (q : ℝ).toNNReal

theorem coe_rt {q : ℚ} (hq : 0 ≤ q) : ((rt q : ℝ≥0) : ℝ) = q :=
  Real.coe_toNNReal _ (by exact_mod_cast hq)

/-- A rational time strictly between two times. -/
theorem exists_rt_btwn {x y : ℝ≥0} (h : x < y) : ∃ q : ℚ, 0 ≤ q ∧ x < rt q ∧ rt q < y := by
  obtain ⟨r, h1, h2⟩ := exists_rat_btwn (show (x : ℝ) < y from h)
  have hr : (0 : ℚ) ≤ r := by exact_mod_cast (x.2.trans h1.le)
  refine ⟨r, hr, ?_, ?_⟩
  · rw [← NNReal.coe_lt_coe, coe_rt hr]; exact h1
  · rw [← NNReal.coe_lt_coe, coe_rt hr]; exact h2

/-- `⌊t (n + 1)⌋ / (n + 1)`, a rational in `[t − 1/(n+1), t]`. -/
def ratApprox (n : ℕ) (t : ℝ≥0) : ℚ := (⌊t * (n + 1)⌋₊ : ℚ) / (n + 1)

theorem ratApprox_nonneg (n : ℕ) (t : ℝ≥0) : 0 ≤ ratApprox n t := by
  unfold ratApprox; positivity

theorem coe_rt_ratApprox (n : ℕ) (t : ℝ≥0) :
    ((rt (ratApprox n t) : ℝ≥0) : ℝ) = (⌊t * (n + 1)⌋₊ : ℝ) / ((n : ℝ) + 1) := by
  rw [coe_rt (ratApprox_nonneg n t)]
  unfold ratApprox
  push_cast
  rfl

theorem rt_ratApprox_le (n : ℕ) (t : ℝ≥0) : rt (ratApprox n t) ≤ t := by
  rw [← NNReal.coe_le_coe, coe_rt_ratApprox, div_le_iff₀ (by positivity)]
  have := Nat.floor_le (show (0 : ℝ≥0) ≤ t * (n + 1) by positivity)
  exact_mod_cast this

theorem tendsto_rt_ratApprox (t : ℝ≥0) : Tendsto (fun n => rt (ratApprox n t)) atTop (𝓝 t) := by
  rw [← NNReal.tendsto_coe]
  have hlow : ∀ n : ℕ, (t : ℝ) - 1 / ((n : ℝ) + 1) ≤ ((rt (ratApprox n t) : ℝ≥0) : ℝ) := fun n => by
    rw [coe_rt_ratApprox]
    have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have hfl : (t : ℝ) * ((n : ℝ) + 1) < (⌊t * (n + 1)⌋₊ : ℝ) + 1 := by
      have := Nat.lt_floor_add_one (t * (n + 1))
      exact_mod_cast this
    rw [le_div_iff₀ hn, sub_mul, div_mul_cancel₀ _ hn.ne']
    linarith
  have hup : ∀ n : ℕ, ((rt (ratApprox n t) : ℝ≥0) : ℝ) ≤ t := fun n => by
    exact_mod_cast rt_ratApprox_le n t
  have hl : Tendsto (fun n : ℕ => (t : ℝ) - 1 / ((n : ℝ) + 1)) atTop (𝓝 t) := by
    simpa using (tendsto_one_div_add_atTop_nhds_zero_nat).const_sub (t : ℝ)
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le hl tendsto_const_nhds hlow hup

/-! ### The modified processes -/

section Modify

variable {Ω : Type*}

open scoped Classical in
/-- The process `X` set to `0` on `N`. -/
def zeroOn (N : Set Ω) (X : ℝ≥0 → Ω → ℝ) : ℝ≥0 → Ω → ℝ := fun t ω => if ω ∈ N then 0 else X t ω

open scoped Classical in
/-- The value of `X` at `q` before the lifetime `ζ`, and `0` from `ζ` on. -/
def killAt (ζ : Ω → ℝ≥0∞) (X : ℝ≥0 → Ω → ℝ) (q : ℝ≥0) : Ω → ℝ :=
  fun ω => if (q : ℝ≥0∞) < ζ ω then X q ω else 0

theorem zeroOn_of_notMem {N : Set Ω} {X : ℝ≥0 → Ω → ℝ} {ω : Ω} (h : ω ∉ N) (t : ℝ≥0) :
    zeroOn N X t ω = X t ω := by
  simp [zeroOn, h]

theorem zeroOn_of_mem {N : Set Ω} {X : ℝ≥0 → Ω → ℝ} {ω : Ω} (h : ω ∈ N) (t : ℝ≥0) : zeroOn N X t ω = 0 := by
  simp [zeroOn, h]

/-- A real function is measurable once its rational strict sublevel sets are. -/
theorem measurable_of_rat_Iio [MeasurableSpace Ω] {f : Ω → ℝ} (h : ∀ a : ℚ, MeasurableSet (f ⁻¹' Iio a)) :
    Measurable f := by
  refine measurable_of_Iio fun x => ?_
  have e : f ⁻¹' Iio x = ⋃ a : {a : ℚ // (a : ℝ) < x}, f ⁻¹' Iio (a : ℝ) := by
    ext ω
    simp only [mem_preimage, mem_Iio, mem_iUnion, Subtype.exists, exists_prop]
    refine ⟨fun hω => ?_, fun ⟨a, hax, hωa⟩ => hωa.trans hax⟩
    obtain ⟨a, h1, h2⟩ := exists_rat_btwn hω
    exact ⟨a, h2, h1⟩
  rw [e]
  exact MeasurableSet.iUnion fun a => h a

end Modify

/-! ### The generating events and the filtration -/

section Filt

variable {Ω : Type*} {ι : Type*}

/-- The generating events at time `t`: `N`, `{t < ζ}`, and at every rational `q ≤ t` the events `{q < ζ}`,
`{B̂_q < a}` and `{killAt ζ X̂ᵢ q < a}` for rational `a`. -/
def dataGens (N : Set Ω) (ζ : Ω → ℝ≥0∞) (B : ℝ≥0 → Ω → ℝ) (X : ι → ℝ≥0 → Ω → ℝ) (t : ℝ≥0) :
    Set (Set Ω) :=
  {N} ∪ {{ω | (t : ℝ≥0∞) < ζ ω}} ∪
    ⋃ (q : ℚ) (_ : rt q ≤ t),
      ({{ω | (rt q : ℝ≥0∞) < ζ ω}} ∪ range (fun a : ℚ => zeroOn N B (rt q) ⁻¹' Iio (a : ℝ)) ∪
        ⋃ i, range (fun a : ℚ => killAt ζ (zeroOn N (X i)) (rt q) ⁻¹' Iio (a : ℝ)))

/-- `{s < ζ}` is a countable union of generating events at a later time `t`. -/
theorem setOf_lt_eq_iUnion (ζ : Ω → ℝ≥0∞) {s t : ℝ≥0} (hst : s ≤ t) :
    {ω | (s : ℝ≥0∞) < ζ ω} =
      {ω | (t : ℝ≥0∞) < ζ ω} ∪ ⋃ (q : ℚ) (_ : s < rt q ∧ rt q ≤ t), {ω | (rt q : ℝ≥0∞) < ζ ω} := by
  ext ω
  simp only [mem_ofPred_eq, mem_union, mem_iUnion, exists_prop]
  constructor
  · intro hs
    by_cases ht : (t : ℝ≥0∞) < ζ ω
    · exact Or.inl ht
    · right
      push Not at ht
      have hfin : ζ ω ≠ ⊤ := ne_top_of_le_ne_top ENNReal.coe_ne_top ht
      have hs' : s < (ζ ω).toNNReal := by
        rw [← ENNReal.coe_lt_coe, ENNReal.coe_toNNReal hfin]; exact hs
      obtain ⟨q, -, hq1, hq2⟩ := exists_rt_btwn hs'
      have hq2' : (rt q : ℝ≥0∞) < ζ ω := by
        rw [← ENNReal.coe_toNNReal hfin]; exact ENNReal.coe_lt_coe.2 hq2
      exact ⟨q, ⟨hq1, ENNReal.coe_le_coe.1 (hq2'.le.trans ht)⟩, hq2'⟩
  · rintro (h | ⟨q, ⟨hq1, -⟩, hq⟩)
    · exact lt_of_le_of_lt (ENNReal.coe_le_coe.2 hst) h
    · exact lt_trans (ENNReal.coe_lt_coe.2 hq1) hq

end Filt

section Gens

variable {Ω : Type*} {ι : Type*} {N : Set Ω} {ζ : Ω → ℝ≥0∞} {B : ℝ≥0 → Ω → ℝ} {X : ι → ℝ≥0 → Ω → ℝ}

theorem N_mem_dataGens (t : ℝ≥0) : N ∈ dataGens N ζ B X t := Or.inl (Or.inl rfl)

theorem lt_mem_dataGens (t : ℝ≥0) : {ω | (t : ℝ≥0∞) < ζ ω} ∈ dataGens N ζ B X t := Or.inl (Or.inr rfl)

theorem rt_lt_mem_dataGens {t : ℝ≥0} {q : ℚ} (hq : rt q ≤ t) :
    {ω | (rt q : ℝ≥0∞) < ζ ω} ∈ dataGens N ζ B X t :=
  Or.inr (mem_iUnion₂.2 ⟨q, hq, Or.inl (Or.inl rfl)⟩)

theorem B_mem_dataGens {t : ℝ≥0} {q : ℚ} (hq : rt q ≤ t) (a : ℚ) :
    zeroOn N B (rt q) ⁻¹' Iio (a : ℝ) ∈ dataGens N ζ B X t :=
  Or.inr (mem_iUnion₂.2 ⟨q, hq, Or.inl (Or.inr ⟨a, rfl⟩)⟩)

theorem X_mem_dataGens {t : ℝ≥0} {q : ℚ} (hq : rt q ≤ t) (i : ι) (a : ℚ) :
    killAt ζ (zeroOn N (X i)) (rt q) ⁻¹' Iio (a : ℝ) ∈ dataGens N ζ B X t :=
  Or.inr (mem_iUnion₂.2 ⟨q, hq, Or.inr (mem_iUnion.2 ⟨i, a, rfl⟩)⟩)

/-- Every generating event at time `s` is measurable for the events generated at a later time `t`. -/
theorem measurableSet_generateFrom_dataGens {s t : ℝ≥0} (hst : s ≤ t) {A : Set Ω}
    (hA : A ∈ dataGens N ζ B X s) : MeasurableSet[MeasurableSpace.generateFrom (dataGens N ζ B X t)] A := by
  rcases hA with (rfl | rfl) | hA
  · exact MeasurableSpace.measurableSet_generateFrom (N_mem_dataGens t)
  · rw [setOf_lt_eq_iUnion ζ hst]
    refine (MeasurableSpace.measurableSet_generateFrom (lt_mem_dataGens t)).union
      (MeasurableSet.iUnion fun q => MeasurableSet.iUnion fun hq => ?_)
    exact MeasurableSpace.measurableSet_generateFrom (rt_lt_mem_dataGens hq.2)
  · obtain ⟨q, hq, hA⟩ := mem_iUnion₂.1 hA
    have hqt : rt q ≤ t := hq.trans hst
    rcases hA with (rfl | ⟨a, rfl⟩) | hA
    · exact MeasurableSpace.measurableSet_generateFrom (rt_lt_mem_dataGens hqt)
    · exact MeasurableSpace.measurableSet_generateFrom (B_mem_dataGens hqt a)
    · obtain ⟨i, a, rfl⟩ := mem_iUnion.1 hA
      exact MeasurableSpace.measurableSet_generateFrom (X_mem_dataGens hqt i a)

theorem generateFrom_dataGens_mono {s t : ℝ≥0} (hst : s ≤ t) :
    MeasurableSpace.generateFrom (dataGens N ζ B X s) ≤ MeasurableSpace.generateFrom (dataGens N ζ B X t) :=
  MeasurableSpace.generateFrom_le fun _ hA => measurableSet_generateFrom_dataGens hst hA

open scoped Classical in
theorem killAt_zeroOn (q : ℝ≥0) (Y : ℝ≥0 → Ω → ℝ) :
    killAt ζ (zeroOn N Y) q = fun ω => if ω ∈ N then 0 else killAt ζ Y q ω := by
  funext ω
  by_cases hω : ω ∈ N <;> by_cases hq : (q : ℝ≥0∞) < ζ ω <;> simp [killAt, zeroOn, hω, hq]

end Gens

section DataFilt

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {ι : Type*}

/-- **The data filtration**: at time `t`, the events generated by `dataGens N ζ B X t` (intersected with `mΩ`). -/
def dataFilt (N : Set Ω) (ζ : Ω → ℝ≥0∞) (B : ℝ≥0 → Ω → ℝ) (X : ι → ℝ≥0 → Ω → ℝ) : Filtration ℝ≥0 mΩ where
  seq t := MeasurableSpace.generateFrom (dataGens N ζ B X t) ⊓ mΩ
  mono' _ _ hst := inf_le_inf_right _ (generateFrom_dataGens_mono hst)
  le' _ := inf_le_right

variable {N : Set Ω} {ζ : Ω → ℝ≥0∞} {B : ℝ≥0 → Ω → ℝ} {X : ι → ℝ≥0 → Ω → ℝ}

/-- The standing measurability of the data: `N`, `{t < ζ}`, `B_t` and the killed values of the `Xᵢ`. -/
structure DataMeas (N : Set Ω) (ζ : Ω → ℝ≥0∞) (B : ℝ≥0 → Ω → ℝ) (X : ι → ℝ≥0 → Ω → ℝ) : Prop where
  N : MeasurableSet N
  lt : ∀ t : ℝ≥0, MeasurableSet {ω | (t : ℝ≥0∞) < ζ ω}
  B : ∀ t, Measurable (B t)
  X : ∀ i t, Measurable (killAt ζ (X i) t)

open scoped Classical in
theorem DataMeas.measurableSet_of_mem (h : DataMeas N ζ B X) {t : ℝ≥0} {A : Set Ω}
    (hA : A ∈ dataGens N ζ B X t) : MeasurableSet A := by
  rcases hA with (rfl | rfl) | hA
  · exact h.N
  · exact h.lt t
  · obtain ⟨q, -, hA⟩ := mem_iUnion₂.1 hA
    rcases hA with (rfl | ⟨a, rfl⟩) | hA
    · exact h.lt _
    · exact (Measurable.ite h.N measurable_const (h.B _)) measurableSet_Iio
    · obtain ⟨i, a, rfl⟩ := mem_iUnion.1 hA
      rw [killAt_zeroOn]
      exact (Measurable.ite h.N measurable_const (h.X i _)) measurableSet_Iio

theorem DataMeas.measurableSet_dataFilt (h : DataMeas N ζ B X) {t : ℝ≥0} {A : Set Ω}
    (hA : A ∈ dataGens N ζ B X t) : MeasurableSet[dataFilt N ζ B X t] A :=
  MeasurableSpace.measurableSet_inf.2 ⟨MeasurableSpace.measurableSet_generateFrom hA, h.measurableSet_of_mem hA⟩

/-- The modified `B` at a rational time `q ≤ t` is `dataFilt t`-measurable. -/
theorem DataMeas.measurable_zeroOn_rt (h : DataMeas N ζ B X) {t : ℝ≥0} {q : ℚ} (hq : rt q ≤ t) :
    Measurable[dataFilt N ζ B X t] (zeroOn N B (rt q)) :=
  @measurable_of_rat_Iio Ω (dataFilt N ζ B X t) _ fun a => h.measurableSet_dataFilt (B_mem_dataGens hq a)

/-- The killed modified `Xᵢ` at a rational time `q ≤ t` is `dataFilt t`-measurable. -/
theorem DataMeas.measurable_killAt_rt (h : DataMeas N ζ B X) {t : ℝ≥0} {q : ℚ} (hq : rt q ≤ t) (i : ι) :
    Measurable[dataFilt N ζ B X t] (killAt ζ (zeroOn N (X i)) (rt q)) :=
  @measurable_of_rat_Iio Ω (dataFilt N ζ B X t) _ fun a => h.measurableSet_dataFilt (X_mem_dataGens hq i a)

/-- **The modified Brownian motion is adapted to the data filtration** (it is continuous off `N`, `0` on `N`, hence
the limit of its values at the rational left approximants). -/
theorem DataMeas.measurable_zeroOn (h : DataMeas N ζ B X) (hBc : ∀ ω, ω ∉ N → Continuous fun t => B t ω)
    (t : ℝ≥0) : Measurable[dataFilt N ζ B X t] (zeroOn N B t) := by
  refine @measurable_of_tendsto_metrizable Ω ℝ (dataFilt N ζ B X t) _ _ _ _
    (fun n => zeroOn N B (rt (ratApprox n t))) _ (fun n => h.measurable_zeroOn_rt (rt_ratApprox_le n t)) ?_
  rw [tendsto_pi_nhds]
  intro ω
  by_cases hω : ω ∈ N
  · simp only [zeroOn_of_mem hω]
    exact tendsto_const_nhds
  · simp only [zeroOn_of_notMem hω]
    exact ((hBc ω hω).tendsto t).comp (tendsto_rt_ratApprox t)

open scoped Classical in
/-- **The modified data processes are adapted before `ζ` to the data filtration.** -/
theorem DataMeas.adaptedBefore_zeroOn (h : DataMeas N ζ B X)
    (hXc : ∀ ω, ω ∉ N → ∀ i, ContinuousOn (fun t => X i t ω) {t | (t : ℝ≥0∞) < ζ ω}) (i : ι) :
    AdaptedBefore (dataFilt N ζ B X) ζ (zeroOn N (X i)) := by
  intro t A hA
  set g : Ω → ℝ := fun ω => if (t : ℝ≥0∞) < ζ ω then zeroOn N (X i) t ω else 0 with hg
  have hlt : MeasurableSet[dataFilt N ζ B X t] {ω | (t : ℝ≥0∞) < ζ ω} :=
    h.measurableSet_dataFilt (lt_mem_dataGens t)
  have hgm : Measurable[dataFilt N ζ B X t] g := by
    refine @measurable_of_tendsto_metrizable Ω ℝ (dataFilt N ζ B X t) _ _ _ _
      (fun n ω => if (t : ℝ≥0∞) < ζ ω then killAt ζ (zeroOn N (X i)) (rt (ratApprox n t)) ω else 0) _
      (fun n => Measurable.ite hlt (h.measurable_killAt_rt (rt_ratApprox_le n t) i) measurable_const) ?_
    rw [tendsto_pi_nhds]
    intro ω
    by_cases ht : (t : ℝ≥0∞) < ζ ω
    · have hq : ∀ n, ((rt (ratApprox n t) : ℝ≥0) : ℝ≥0∞) < ζ ω := fun n =>
        lt_of_le_of_lt (ENNReal.coe_le_coe.2 (rt_ratApprox_le n t)) ht
      simp only [hg, ht, ite_true, killAt, hq]
      by_cases hω : ω ∈ N
      · simp only [zeroOn_of_mem hω]
        exact tendsto_const_nhds
      · simp only [zeroOn_of_notMem hω]
        have hcw := (hXc ω hω i t ht).tendsto
        refine hcw.comp (tendsto_nhdsWithin_iff.2 ⟨tendsto_rt_ratApprox t, Eventually.of_forall hq⟩)
    · simp only [hg, ht, ite_false]
      exact tendsto_const_nhds
  have e : {ω | (t : ℝ≥0∞) < ζ ω ∧ zeroOn N (X i) t ω ∈ A} = {ω | (t : ℝ≥0∞) < ζ ω} ∩ g ⁻¹' A := by
    ext ω
    simp only [mem_ofPred_eq, mem_inter_iff, mem_preimage, hg]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨h1, by simpa only [h1, ite_true] using h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨h1, by simpa only [h1, ite_true] using h2⟩
  rw [e]
  exact hlt.inter (hgm hA)

omit mΩ in
theorem diff_eq_diff_iff {A A' : Set Ω} : A \ N = A' \ N ↔ ∀ ω, ω ∉ N → (ω ∈ A ↔ ω ∈ A') := by
  constructor
  · intro h ω hω
    have := congrArg (ω ∈ ·) h
    simpa [hω] using this
  · intro h
    ext ω
    by_cases hω : ω ∈ N
    · simp [hω]
    · simp [hω, h ω hω]

/-- **Every event of the data filtration agrees off `N` with an event of the original filtration** `𝓕` (in which
`{t < ζ}`, `B_t` and the killed `Xᵢ` are adapted). -/
theorem exists_eq_diff_of_measurableSet_dataFilt {𝓕 : Filtration ℝ≥0 mΩ}
    (hζ : ∀ t : ℝ≥0, MeasurableSet[𝓕 t] {ω | (t : ℝ≥0∞) < ζ ω}) (hB : ∀ t, Measurable[𝓕 t] (B t))
    (hX : ∀ i t, Measurable[𝓕 t] (killAt ζ (X i) t)) {t : ℝ≥0} {A : Set Ω}
    (hA : MeasurableSet[dataFilt N ζ B X t] A) : ∃ A', MeasurableSet[𝓕 t] A' ∧ A \ N = A' \ N := by
  have hA' := (MeasurableSpace.measurableSet_inf.1 hA).1
  refine MeasurableSpace.generateFrom_induction _ (fun A _ => ∃ A', MeasurableSet[𝓕 t] A' ∧ A \ N = A' \ N)
    ?_ ⟨∅, MeasurableSpace.measurableSet_empty (𝓕 t), rfl⟩ ?_ ?_ A hA'
  · intro C hC _
    rcases hC with (rfl | rfl) | hC
    · exact ⟨∅, MeasurableSpace.measurableSet_empty (𝓕 t), by rw [sdiff_self, empty_sdiff]⟩
    · exact ⟨_, hζ t, rfl⟩
    · obtain ⟨q, hq, hC⟩ := mem_iUnion₂.1 hC
      rcases hC with (rfl | ⟨a, rfl⟩) | hC
      · exact ⟨_, 𝓕.mono hq _ (hζ (rt q)), rfl⟩
      · refine ⟨B (rt q) ⁻¹' Iio (a : ℝ), 𝓕.mono hq _ ((hB _) measurableSet_Iio), ?_⟩
        rw [diff_eq_diff_iff]
        intro ω hω
        simp only [mem_preimage, zeroOn_of_notMem hω]
      · obtain ⟨i, a, rfl⟩ := mem_iUnion.1 hC
        refine ⟨killAt ζ (X i) (rt q) ⁻¹' Iio (a : ℝ), 𝓕.mono hq _ ((hX i _) measurableSet_Iio), ?_⟩
        rw [diff_eq_diff_iff]
        intro ω hω
        simp only [mem_preimage, killAt_zeroOn, hω, ite_false]
  · rintro C - ⟨C', hC', hCC'⟩
    refine ⟨C'ᶜ, hC'.compl, ?_⟩
    rw [diff_eq_diff_iff] at hCC' ⊢
    intro ω hω
    simp only [mem_compl_iff, hCC' ω hω]
  · rintro C - hC
    choose C' hC' hCC' using hC
    refine ⟨⋃ n, C' n, MeasurableSet.iUnion hC', ?_⟩
    rw [diff_eq_diff_iff]
    intro ω hω
    simp only [mem_iUnion]
