/-!
# Lemma 7.6: marked locality of two stopped flow-line prefixes with their killing records

Packet PROVE-T15-CLOSE1 (2), the conditional law behind (R1) of `Lemma76CondDetHeightsStatement` (specification
§7.2, proof of Lemma 7.6, p. 267–268, `source/spec/p241-288.md#lem-7.6-proof`: "Retain the two labelled histories and
their canonical germs … The stopping-time local-set theorem gives their joint Gaussian conditional law in each
complementary component"; Lemma 7.7's proof, p. 282: "Let `𝒢_{s,t}` be the sigma-algebra generated by these two
stopped, labelled histories, including whether each terminal time has occurred").

PROVE-LEMMA76's `Sec7.ae_condExp_exp_eq_explored_const` gives the joint conditional law at deterministic stops given
the germs and the two stopped path histories, **without** the killing records; PROVE-RESTART-CPL6's
`Restart.ae_condExp_exp_eq_fcUnion` keeps the killing records, at the first-contact stopping line. Lemma 7.6 needs the
deterministic stops `(u, r)` **with** the killing records (whether `u < ζ₁`, `r < ζ₂`: the event of a disjoint pair is
read off the retained histories). This file is CPL6's argument at a constant stopping line (no first-contact
reconstruction: the union avoids `U` iff `u ≤ T₁` and `r ≤ T₂`, `Tᵢ` the first entrance times into `U`):

* `cstLine`, `cstUnion`, `cstHist`: the constant stopping line `(u, r)`, the stopped union and the two killed stopped
  histories;
* **`le_aeSigma_cstUnion`**: the avoidance event and, on it, both killed histories are almost surely
  `h_{U^c}`-determined;
* `isLocalSet_cstUnion`, `isHistoryAvoidanceLocal_cstUnion`;
* **`ae_condExp_exp_eq_cstUnion`**: given the germs of the union and the two killed histories, on every complementary
  component the field is its local-set mean plus a zero-boundary GFF of the component;
* **`exists_cstUnion_marked_of_isFlowLine`**: the same for two flow lines (capped versions, Lemma 7.5 for field
  determination, Aux. lemma 56 at first entrances for history locality).
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set TopologicalSpace Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

namespace Lemma76F

open QuantumZipper (H)
open LQGMetric (DistOn TestOn CondIndepEv)
open LocalSets Sec6 Restart

/-! ### The constant stopping line -/

section Defs

variable {Ω : Type*}

/-- The constant stopping line `(u, r)`. -/
def cstLine (u r : ℝ≥0) : Fin 2 → Ω → ℝ≥0∞ := ![fun _ => (u : ℝ≥0∞), fun _ => (r : ℝ≥0∞)]

/-- **The stopped union** `η₁([0, u]) ∪ η₂([0, r])` (its `ℍ`-part). -/
def cstUnion (η₁ η₂ : Ω → ℝ≥0 → ℂ) (u r : ℝ≥0) : Ω → Set ℂ := explored (pairPath η₁ η₂) (cstLine u r)

/-- **The retained histories**: the two killed histories stopped at `u` and `r`. -/
def cstHist (η₁ η₂ : Ω → ℝ≥0 → ℂ) (ζ₁ ζ₂ : Ω → ℝ≥0∞) (u r : ℝ≥0) (ω : Ω) : KHist × KHist :=
  (khistOf (pathCoord (η₁ ω)) (ζ₁ ω) u, khistOf (pathCoord (η₂ ω)) (ζ₂ ω) r)

theorem cstUnion_eq (η₁ η₂ : Ω → ℝ≥0 → ℂ) (u r : ℝ≥0) (ω : Ω) :
    cstUnion η₁ η₂ u r ω = (η₁ ω '' Icc 0 u ∪ η₂ ω '' Icc 0 r) ∩ H := by
  ext z
  simp only [cstUnion, explored, pairPath, cstLine, mem_inter_iff, mem_iUnion, Fin.exists_fin_two,
    Matrix.cons_val_zero, Matrix.cons_val_one, mem_union, mem_image, mem_ofPred_eq, mem_Icc, zero_le, true_and,
    ENNReal.coe_le_coe]

variable [MeasurableSpace Ω]

theorem measurable_cstHist {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞} (hηm₁ : ∀ t, Measurable fun ω => η₁ ω t)
    (hηm₂ : ∀ t, Measurable fun ω => η₂ ω t) (hζm₁ : Measurable ζ₁) (hζm₂ : Measurable ζ₂) (u r : ℝ≥0) :
    Measurable (cstHist η₁ η₂ ζ₁ ζ₂ u r) := by
  have h₁ : Measurable fun ω => pathCoord (η₁ ω) := Measurable.of_eval fun q => hηm₁ q
  have h₂ : Measurable fun ω => pathCoord (η₂ ω) := Measurable.of_eval fun q => hηm₂ q
  have hk : Measurable fun p : (ℚ≥0 → ℂ) × ℝ≥0∞ × ℝ≥0∞ => khistOf p.1 p.2.1 p.2.2 :=
    (measurable_histOf.comp ((measurable_snd.comp measurable_snd).prodMk measurable_fst)).prodMk
      (measurable_lifeRec.comp ((measurable_fst.comp measurable_snd).prodMk (measurable_snd.comp measurable_snd)))
  have e₁ := hk.comp (h₁.prodMk (hζm₁.prodMk (measurable_const (a := ((u : ℝ≥0) : ℝ≥0∞)))))
  have e₂ := hk.comp (h₂.prodMk (hζm₂.prodMk (measurable_const (a := ((r : ℝ≥0) : ℝ≥0∞)))))
  dsimp only [Function.comp_def] at e₁ e₂
  exact e₁.prodMk e₂

theorem measurable_cstUnion {η₁ η₂ : Ω → ℝ≥0 → ℂ} (hc₁ : ∀ ω, Continuous (η₁ ω))
    (hc₂ : ∀ ω, Continuous (η₂ ω)) (hηm₁ : ∀ t, Measurable fun ω => η₁ ω t)
    (hηm₂ : ∀ t, Measurable fun ω => η₂ ω t) (u r : ℝ≥0) : Measurable[_, hittingSigma] (cstUnion η₁ η₂ u r) := by
  refine measurable_explored (continuous_pairPath hc₁ hc₂) (fun i t => ?_) (fun i => ?_)
  · fin_cases i
    · exact hηm₁ t
    · exact hηm₂ t
  · fin_cases i
    · exact measurable_const
    · exact measurable_const

end Defs

/-! ### The avoidance event and the recorded union -/

section Avoid

variable {Ω : Type*} {η₁ η₂ : Ω → ℝ≥0 → ℂ} {u r : ℝ≥0}

/-- **The stopped union avoids `U` iff both stopped paths do.** -/
theorem disjoint_cstUnion_iff {U : Set ℂ} (hUH : U ⊆ H) (ω : Ω) :
    Disjoint (cstUnion η₁ η₂ u r ω) U ↔ AvoidsUpTo (η₁ ω) u U ∧ AvoidsUpTo (η₂ ω) r U := by
  rw [cstUnion, disjoint_explored_iff hUH ω, Fin.forall_fin_two]
  simp only [pairPath, cstLine, Matrix.cons_val_zero, Matrix.cons_val_one]

variable {ζ₁ ζ₂ : Ω → ℝ≥0∞}

/-- **The recorded union is read from the retained histories** (Lemma 3.6 (ii)'s σ-algebra of the union is contained
in that of the avoidance event and the retained killed histories recorded on it). -/
theorem markedSigma_cstUnion_le (hc₁ : ∀ ω, Continuous (η₁ ω)) (hc₂ : ∀ ω, Continuous (η₂ ω)) (U : Set ℂ) :
    markedSigma (cstUnion η₁ η₂ u r) U ≤
      markedHistSigma {ω | Disjoint (cstUnion η₁ η₂ u r ω) U} (cstHist η₁ η₂ ζ₁ ζ₂ u r) := by
  refine sup_le ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ rfl
    exact MeasurableSpace.measurableSet_generateFrom ⟨univ, MeasurableSet.univ, by rw [preimage_univ, inter_univ]⟩
  · unfold hittingSigma
    rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨_, ⟨V, hVo, hVH, rfl⟩, rfl⟩
    set Ψ : Set (KHist × KHist) :=
      {y | ∃ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞)) ≤ y.1.1.1 ∧ y.1.1.2 q ∈ V} ∪
        {y | ∃ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞)) ≤ y.2.1.1 ∧ y.2.1.2 q ∈ V} with hΨdef
    have hΨ : MeasurableSet Ψ := by
      refine MeasurableSet.union ?_ ?_
      · simp only [ofPred_exists, ofPred_and]
        exact MeasurableSet.iUnion fun q => (measurableSet_le measurable_const
          (measurable_fst.comp (measurable_fst.comp measurable_fst))).inter
          (((measurable_pi_apply q).comp (measurable_snd.comp (measurable_fst.comp measurable_fst)))
            hVo.measurableSet)
      · simp only [ofPred_exists, ofPred_and]
        exact MeasurableSet.iUnion fun q => (measurableSet_le measurable_const
          (measurable_fst.comp (measurable_fst.comp measurable_snd))).inter
          (((measurable_pi_apply q).comp (measurable_snd.comp (measurable_fst.comp measurable_snd)))
            hVo.measurableSet)
    have e : (fun ω => markedSet U (cstUnion η₁ η₂ u r ω)) ⁻¹' {A | (A ∩ V).Nonempty} =
        {ω | Disjoint (cstUnion η₁ η₂ u r ω) U} ∩ cstHist η₁ η₂ ζ₁ ζ₂ u r ⁻¹' Ψ := by
      ext ω
      simp only [mem_preimage, mem_ofPred_eq, markedSet_inter_nonempty_iff, mem_inter_iff]
      refine and_congr_right fun _ => ?_
      rw [cstUnion, explored_inter_nonempty_iff (continuous_pairPath hc₁ hc₂) hVo hVH ω, Fin.exists_fin_two]
      simp only [pairPath, cstLine, Matrix.cons_val_zero, Matrix.cons_val_one, hΨdef, mem_union, mem_ofPred_eq,
        cstHist, khistOf, histOf]
      refine or_congr (exists_congr fun q => and_congr_right fun hq => ?_)
        (exists_congr fun q => and_congr_right fun hq => ?_)
      · rw [stopCoord_of_le hq]; rfl
      · rw [stopCoord_of_le hq]; rfl
    rw [e]
    exact MeasurableSpace.measurableSet_generateFrom ⟨Ψ, hΨ, rfl⟩

end Avoid

/-! ### Marked locality at the constant stopping line -/

section Main

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞} {x₁ x₂ : ℂ} {u r : ℝ≥0}

/-- **The core of the marked locality**: for every open `U ⊆ ℍ` and Borel version `G` of the projection onto `H(U)`,
the avoidance event of the stopped union and, on it, the two retained killed histories are almost surely determined by
`h_{U^c}`. With `Tᵢ` the first entrance times into `U`, the union avoids `U` iff `u ≤ T₁` and `r ≤ T₂`, and then the
killed histories through `u`, `r` are restrictions of those through `Tᵢ` (`h_{U^c}`-determined,
`measurable_entranceKHist`). -/
theorem le_aeSigma_cstUnion (hhm : Measurable h) (hc₁ : ∀ ω, Continuous (η₁ ω))
    (hc₂ : ∀ ω, Continuous (η₂ ω)) (h0₁ : ∀ ω, η₁ ω 0 = x₁) (h0₂ : ∀ ω, η₂ ω 0 = x₂)
    (hηm₁ : ∀ t, Measurable fun ω => η₁ ω t) (hηm₂ : ∀ t, Measurable fun ω => η₂ ω t)
    (hζm₁ : Measurable ζ₁) (hζm₂ : Measurable ζ₂)
    (hdet₁ : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η₁ ω t) =ᵐ[P] fun ω => f (h ω))
    (hdet₂ : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η₂ ω t) =ᵐ[P] fun ω => f (h ω))
    (hdetζ₁ : ∃ f : DistOn upperHalfPlaneOpens → ℝ≥0∞, Measurable f ∧ ζ₁ =ᵐ[P] fun ω => f (h ω))
    (hdetζ₂ : ∃ f : DistOn upperHalfPlaneOpens → ℝ≥0∞, Measurable f ∧ ζ₂ =ᵐ[P] fun ω => f (h ω))
    (hloc₁ : IsEntranceKilledHistoryLocal η₁ ζ₁ h P) (hloc₂ : IsEntranceKilledHistoryLocal η₂ ζ₂ h P)
    (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens)
    (hUH : (U : Set ℂ) ⊆ H) (hG : Measurable G)
    (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P) :
    markedHistSigma {ω | Disjoint (cstUnion η₁ η₂ u r ω) U} (cstHist η₁ η₂ ζ₁ ζ₂ u r) ≤
      aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P := by
  classical
  set N := aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P with hNdef
  let _ : MeasurableSpace Ω := mΩ
  by_cases hx : x₁ ∈ (U : Set ℂ) ∨ x₂ ∈ (U : Set ℂ)
  · -- a starting point lies in `U`: the union always meets `U`
    have hE : {ω | Disjoint (cstUnion η₁ η₂ u r ω) U} = ∅ := by
      refine eq_empty_iff_forall_notMem.2 fun ω hω => ?_
      have hω' : Disjoint (cstUnion η₁ η₂ u r ω) U := hω
      rw [disjoint_cstUnion_iff hUH ω] at hω'
      rcases hx with hx | hx
      · exact hω'.1 0 (by simp) (by rw [h0₁]; exact hx)
      · exact hω'.2 0 (by simp) (by rw [h0₂]; exact hx)
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨B, -, rfl⟩
    rw [hE, empty_inter]
    exact @MeasurableSet.empty _ N
  push Not at hx
  have h0₁' : ∀ ω, η₁ ω 0 ∉ (U : Set ℂ) := fun ω => by rw [h0₁]; exact hx.1
  have h0₂' : ∀ ω, η₂ ω 0 ∉ (U : Set ℂ) := fun ω => by rw [h0₂]; exact hx.2
  -- the killed histories through the first entrance times are determined by `h_{U^c}`
  have hHtm := (measurable_entranceKHist hhm hc₁ hηm₁ hζm₁ hdet₁ hdetζ₁ hloc₁ U G hUH hG hd h0₁').prodMk
    (measurable_entranceKHist hhm hc₂ hηm₂ hζm₂ hdet₂ hdetζ₂ hloc₂ U G hUH hG hd h0₂')
  set ΨE : Set (KHist × KHist) := {y | (u : ℝ≥0∞) ≤ y.1.1.1 ∧ (r : ℝ≥0∞) ≤ y.2.1.1} with hΨEdef
  have hΨE : MeasurableSet ΨE :=
    (measurableSet_le measurable_const (measurable_fst.comp (measurable_fst.comp measurable_fst))).inter
      (measurableSet_le measurable_const (measurable_fst.comp (measurable_fst.comp measurable_snd)))
  have hΦm : Measurable fun y : KHist × KHist => (khistRestrict y.1 u, khistRestrict y.2 r) :=
    (measurable_khistRestrict.comp (measurable_fst.prodMk measurable_const)).prodMk
      (measurable_khistRestrict.comp (measurable_snd.prodMk measurable_const))
  -- pointwise identification
  have hpt : ∀ ω, (Disjoint (cstUnion η₁ η₂ u r ω) U ↔
        (khistOf (pathCoord (η₁ ω)) (ζ₁ ω) (firstEntrance U (pathCoord (η₁ ω))),
          khistOf (pathCoord (η₂ ω)) (ζ₂ ω) (firstEntrance U (pathCoord (η₂ ω)))) ∈ ΨE) ∧
      (Disjoint (cstUnion η₁ η₂ u r ω) U →
        (khistRestrict (khistOf (pathCoord (η₁ ω)) (ζ₁ ω) (firstEntrance U (pathCoord (η₁ ω)))) u,
          khistRestrict (khistOf (pathCoord (η₂ ω)) (ζ₂ ω) (firstEntrance U (pathCoord (η₂ ω)))) r) =
          cstHist η₁ η₂ ζ₁ ζ₂ u r ω) := by
    intro ω
    have hav : Disjoint (cstUnion η₁ η₂ u r ω) U ↔
        (u : ℝ≥0∞) ≤ firstEntrance U (pathCoord (η₁ ω)) ∧ (r : ℝ≥0∞) ≤ firstEntrance U (pathCoord (η₂ ω)) := by
      rw [disjoint_cstUnion_iff hUH ω]
      exact and_congr (disjoint_range_iff_le_firstEntrance U.isOpen (hc₁ ω) (h0₁' ω) u)
        (disjoint_range_iff_le_firstEntrance U.isOpen (hc₂ ω) (h0₂' ω) r)
    refine ⟨hav.trans (by simp only [hΨEdef, mem_ofPred_eq, khistOf, histOf]), fun hω => ?_⟩
    obtain ⟨h₁, h₂⟩ := hav.1 hω
    rw [khistRestrict_khistOf h₁, khistRestrict_khistOf h₂]
    rfl
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨B, hB, rfl⟩
  refine measurableSet_aeSigma_of_ae_eq ?_ (hHtm (hΨE.inter (hΦm hB)))
  refine Eventually.of_forall fun ω => ?_
  have hp := hpt ω
  refine propext ⟨fun hωEB => ⟨hp.1.1 hωEB.1, ?_⟩, fun hωΨB => ⟨hp.1.2 hωΨB.1, ?_⟩⟩
  · have key : cstHist η₁ η₂ ζ₁ ζ₂ u r ω ∈ B := hωEB.2
    rw [← hp.2 hωEB.1] at key
    exact key
  · show cstHist η₁ η₂ ζ₁ ζ₂ u r ω ∈ B
    rw [← hp.2 (hp.1.2 hωΨB.1)]
    exact hωΨB.2

end Main

/-! ### Consequences: locality, history marking, the conditional law off the union -/

section Consequences

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ} {ζ₁ ζ₂ : Ω → ℝ≥0∞} {x₁ x₂ : ℂ} {u r : ℝ≥0}
  (hhm : Measurable h) (hc₁ : ∀ ω, Continuous (η₁ ω)) (hc₂ : ∀ ω, Continuous (η₂ ω))
  (h0₁ : ∀ ω, η₁ ω 0 = x₁) (h0₂ : ∀ ω, η₂ ω 0 = x₂)
  (hηm₁ : ∀ t, Measurable fun ω => η₁ ω t) (hηm₂ : ∀ t, Measurable fun ω => η₂ ω t)
  (hζm₁ : Measurable ζ₁) (hζm₂ : Measurable ζ₂)
  (hdet₁ : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
    (fun ω => η₁ ω t) =ᵐ[P] fun ω => f (h ω))
  (hdet₂ : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
    (fun ω => η₂ ω t) =ᵐ[P] fun ω => f (h ω))
  (hdetζ₁ : ∃ f : DistOn upperHalfPlaneOpens → ℝ≥0∞, Measurable f ∧ ζ₁ =ᵐ[P] fun ω => f (h ω))
  (hdetζ₂ : ∃ f : DistOn upperHalfPlaneOpens → ℝ≥0∞, Measurable f ∧ ζ₂ =ᵐ[P] fun ω => f (h ω))
  (hloc₁ : IsEntranceKilledHistoryLocal η₁ ζ₁ h P) (hloc₂ : IsEntranceKilledHistoryLocal η₂ ζ₂ h P)
include hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁ hdetζ₂ hloc₁ hloc₂

/-- **The stopped union satisfies Lemma 3.6 (ii).** -/
theorem isMarkedAvoidanceLocal_cstUnion : IsMarkedAvoidanceLocal (cstUnion η₁ η₂ u r) h P :=
  fun U G hUH hG hd =>
  condIndepEv_of_le_aeSigma ((measurable_markovCompl hG).comp hhm).comap_le (hG.comp hhm).comap_le
    ((markedSigma_cstUnion_le (ζ₁ := ζ₁) (ζ₂ := ζ₂) hc₁ hc₂ U).trans
      (le_aeSigma_cstUnion hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁ hdetζ₂ hloc₁ hloc₂
        U G hUH hG hd))

/-- **The stopped union is a local set** of a zero-boundary GFF (Lemma 3.6, (ii) ⇒ (iv)). -/
theorem isLocalSet_cstUnion (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P) :
    IsLocalSet (cstUnion η₁ η₂ u r) h P := by
  have hA := measurable_cstUnion hc₁ hc₂ hηm₁ hηm₂ u r
  have hAc : ∀ᵐ ω ∂P, cstUnion η₁ η₂ u r ω ⊆ H ∧ IsOpen (H \ cstUnion η₁ η₂ u r ω) := by
    refine Eventually.of_forall fun ω => ⟨inter_subset_right, ?_⟩
    have hK : IsCompact (η₁ ω '' Icc 0 u ∪ η₂ ω '' Icc 0 r) :=
      (isCompact_Icc.image (hc₁ ω)).union (isCompact_Icc.image (hc₂ ω))
    have e : H \ cstUnion η₁ η₂ u r ω = H \ (η₁ ω '' Icc 0 u ∪ η₂ ω '' Icc 0 r) := by
      rw [cstUnion_eq]
      ext z
      simp only [Set.mem_sdiff, mem_inter_iff, not_and]
      exact ⟨fun ⟨hz, hn⟩ => ⟨hz, fun hu => hn hu hz⟩, fun ⟨hz, hn⟩ => ⟨hz, fun hu _ => hn hu⟩⟩
    rw [e]
    exact QuantumZipper.isOpen_H.sdiff hK.isClosed
  exact ((isLocalSet_tfae hh hA hAc).out 2 4).1
    (isMarkedAvoidanceLocal_cstUnion hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁ hdetζ₂ hloc₁
      hloc₂)

/-- **History marking** (Aux. lemma 18's criterion for the stopped union with the retained killed histories as
marks). -/
theorem isHistoryAvoidanceLocal_cstUnion :
    WholeField.IsHistoryAvoidanceLocal (MeasurableSpace.comap (cstHist η₁ η₂ ζ₁ ζ₂ u r) inferInstance)
      (cstUnion η₁ η₂ u r) h P := by
  intro U G hUH hG hd F hF
  obtain ⟨B, hB, rfl⟩ := hF
  have hmem := le_aeSigma_cstUnion (u := u) (r := r) hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁
    hdetζ₂ hloc₁ hloc₂
    U G hUH hG hd _ (MeasurableSpace.measurableSet_generateFrom ⟨B, hB, rfl⟩)
  obtain ⟨G', hG', he⟩ := hmem
  obtain ⟨B', hB', rfl⟩ := hG'
  refine ⟨B'.indicator fun _ => (1 : ℝ), measurable_const.indicator hB', ?_⟩
  have hsub : MeasurableSet[MeasurableSpace.comap h inferInstance]
      ((fun ω => markovCompl G (h ω)) ⁻¹' B') :=
    ⟨(markovCompl G) ⁻¹' B', measurable_markovCompl hG hB', rfl⟩
  have hle : MeasurableSpace.comap h inferInstance ≤ mΩ := hhm.comap_le
  refine (condExp_congr_ae (indicator_ae_eq_of_ae_eq_set he)).trans ?_
  rw [condExp_of_stronglyMeasurable hle (stronglyMeasurable_const.indicator hsub)
    ((integrable_const (1 : ℝ)).indicator (hle _ hsub))]
  refine Eventually.of_forall fun ω => ?_
  rfl

/-- **Marked locality off the stopped union**: there is a version `g` of the local-set mean of the stopped union
`A = η₁([0, u]) ∪ η₂([0, r])`, and given the germs of `A` together with the two retained killed histories, the field
paired with a test function supported in a complementary component `C` of `A` is Gaussian with mean `g(φ)` and the
zero-boundary variance of `C`. -/
theorem ae_condExp_exp_eq_cstUnion (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P) :
    ∃ g : Ω → DistOn upperHalfPlaneOpens, IsLocalSetMean (cstUnion η₁ η₂ u r) h P g ∧
      ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ∀ z₀ ∈ H \ cstUnion η₁ η₂ u r ω,
        tsupport φ ⊆ connectedComponentIn (H \ cstUnion η₁ η₂ u r ω) z₀ →
        P[fun ω' => Complex.exp (Complex.I * (h ω' φ : ℂ)) |
            germSigma (cstUnion η₁ η₂ u r) h ⊔ MeasurableSpace.comap (cstHist η₁ η₂ ζ₁ ζ₂ u r) inferInstance] ω =
          Complex.exp (Complex.I * (g ω φ : ℂ)) *
            ((Real.exp (-(1 / 2) *
              QuantumZipper.zeroGFFTestCov (connectedComponentIn (H \ cstUnion η₁ η₂ u r ω) z₀) φ φ) : ℝ) : ℂ) := by
  have hA := measurable_cstUnion hc₁ hc₂ hηm₁ hηm₂ u r
  have hloc := isLocalSet_cstUnion (u := u) (r := r) hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁
    hdetζ₂ hloc₁ hloc₂
    hh
  obtain ⟨g, hg⟩ := IsLocalSet.exists_isLocalSetMean hh hA hloc
  refine ⟨g, hg, fun φ => ?_⟩
  exact ae_condExp_exp_eq_of_component_marked hh hA hloc
    (measurable_cstHist hηm₁ hηm₂ hζm₁ hζm₂ u r).comap_le
    (isHistoryAvoidanceLocal_cstUnion (u := u) (r := r) hhm hc₁ hc₂ h0₁ h0₂ hηm₁ hηm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁
      hdetζ₂ hloc₁
      hloc₂) hg φ

end Consequences

/-! ### Two flow lines -/

section Flow

universe v

variable {κ : ℝ} {b : ℝ → ℝ} {jumps : Finset ℝ} {x₁ x₂ θ₁ θ₂ : ℝ} {Ω : Type v} [mΩ : MeasurableSpace Ω]
  {P : Measure Ω} [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens} {η₁ η₂ : Ω → ℝ≥0 → ℂ}
  {ζ₁ ζ₂ : Ω → ℝ≥0∞}

/-- **Marked locality of two stopped flow-line prefixes with their killing records.** For two flow lines, a cap `m`
and deterministic stops `s, t`, there are capped versions `ηcᵢ` (continuous, measurable, almost surely
`ηᵢ(· ∧ ζᵢ ∧ m)`) and a version `g` of the local-set mean of the centred field `h − 𝔥₀` for the stopped union
`ηc₁([0, s]) ∪ ηc₂([0, t])`, such that given the germs of the union and the two killed histories (killing records
`cutLife ζᵢ m`), on every complementary component the centred field is `g` plus a zero-boundary GFF of the component.
Inputs: Lemma 7.5 (field determination) and Aux. lemma 56 at first entrance times. -/
theorem exists_cstUnion_marked_of_isFlowLine (hL75 : Theorem15.Lemma75Statement.{v})
    (hA56 : RetainedRangeEntranceStatement.{v}) (hκ : 0 < κ) (hκ4 : κ < 4)
    (hb : IsPiecewiseConstantBoundaryData b jumps) (hh : IsGFFWithBoundaryData P h b jumps)
    (hη₁ : IsFlowLine κ b jumps x₁ θ₁ P h η₁ ζ₁) (hη₂ : IsFlowLine κ b jumps x₂ θ₂ P h η₂ ζ₂)
    {u₀ : ℂ → ℝ} (hu₀ : IsBoundedHarmonicExtension b jumps u₀) (m s t : ℝ≥0) :
    ∃ ηc₁ ηc₂ : Ω → ℝ≥0 → ℂ, (∀ ω, Continuous (ηc₁ ω)) ∧ (∀ ω, Continuous (ηc₂ ω)) ∧
      (∀ t, Measurable fun ω => ηc₁ ω t) ∧ (∀ t, Measurable fun ω => ηc₂ ω t) ∧
      (∀ ω, ηc₁ ω 0 = x₁) ∧ (∀ ω, ηc₂ ω 0 = x₂) ∧
      (∀ᵐ ω ∂P, ∀ t, ηc₁ ω t = η₁ ω (capTime m (ζ₁ ω) t)) ∧
      (∀ᵐ ω ∂P, ∀ t, ηc₂ ω t = η₂ ω (capTime m (ζ₂ ω) t)) ∧
      ∃ g : Ω → DistOn upperHalfPlaneOpens,
        IsLocalSetMean (cstUnion ηc₁ ηc₂ s t) (WholeField.centredField h u₀) P g ∧
        ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ∀ z₀ ∈ H \ cstUnion ηc₁ ηc₂ s t ω,
          tsupport φ ⊆ connectedComponentIn (H \ cstUnion ηc₁ ηc₂ s t ω) z₀ →
          P[fun ω' => Complex.exp (Complex.I * (WholeField.centredField h u₀ ω' φ : ℂ)) |
              germSigma (cstUnion ηc₁ ηc₂ s t) (WholeField.centredField h u₀) ⊔
                MeasurableSpace.comap
                  (cstHist ηc₁ ηc₂ (fun ω => cutLife (ζ₁ ω) m) (fun ω => cutLife (ζ₂ ω) m) s t) inferInstance] ω =
            Complex.exp (Complex.I * (g ω φ : ℂ)) *
              ((Real.exp (-(1 / 2) *
                QuantumZipper.zeroGFFTestCov (connectedComponentIn (H \ cstUnion ηc₁ ηc₂ s t ω) z₀) φ φ) : ℝ) :
                  ℂ) := by
  obtain ⟨ηc₁, hc₁, hm₁, h0₁, -, hag₁, hdet₁, hdetζ₁⟩ := exists_capped_version hL75 hκ hκ4 hb hh hη₁ u₀ m
  obtain ⟨ηc₂, hc₂, hm₂, h0₂, -, hag₂, hdet₂, hdetζ₂⟩ := exists_capped_version hL75 hκ hκ4 hb hh hη₂ u₀ m
  have hloc₁ := hA56 κ hκ hκ4 b jumps hb x₁ θ₁ P h hh η₁ ζ₁ hη₁ u₀ hu₀ m ηc₁ hc₁ hm₁ hag₁
  have hloc₂ := hA56 κ hκ hκ4 b jumps hb x₂ θ₂ P h hh η₂ ζ₂ hη₂ u₀ hu₀ m ηc₂ hc₂ hm₂ hag₂
  have hζm₁ := (measurable_cutLife m).comp (measurable_lifetime_of_isFlowLine hη₁)
  have hζm₂ := (measurable_cutLife m).comp (measurable_lifetime_of_isFlowLine hη₂)
  have hh0 := isZeroBoundaryGFF_centredField_of_isGFFWithBoundaryData hh hu₀
  refine ⟨ηc₁, ηc₂, hc₁, hc₂, hm₁, hm₂, h0₁, h0₂, hag₁, hag₂, ?_⟩
  exact ae_condExp_exp_eq_cstUnion (x₁ := (x₁ : ℂ)) (x₂ := (x₂ : ℂ)) (u := s) (r := t) hh0.measurable hc₁ hc₂
    (fun ω => by rw [h0₁ ω]) (fun ω => by rw [h0₂ ω]) hm₁ hm₂ hζm₁ hζm₂ hdet₁ hdet₂ hdetζ₁ hdetζ₂ hloc₁ hloc₂ hh0

end Flow

end Lemma76F

end Sec7

