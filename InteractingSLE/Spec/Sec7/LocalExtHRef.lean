/-!
# A standard reference from a two-seed evolution on a standard Borel space

Packet PROVE-LOCEXT-H. Theorem 1.1's construction (`Coupling.exists_locCoupling_of_evolution`, with the finite-family
step `Coupling.finiteFamilyProjStatement`) applied to a two-seed integrated evolution on a **standard Borel** space,
read in the usual augmentation of its rational-time coordinates, is a standard reference (`IsStdReference`): the
coupling lives on the standard Borel `Ω₀ × 𝒟'(ℍ)`, satisfies the frozen optional hull specification (locality from
`Coupling.isLocalSet_hull_of_isFamilyLocal`), is family-sampled, and its usual augmentation is generated by the driving
coordinates up to null sets.

* `isStdReference_of_stdBorel`;
* **`stdTwoSeedReferenceStatement_of_thm22StdBorel`**: the named input `StdTwoSeedReferenceStatement κ` from Theorem 2.2's
  existence on a standard Borel space for the two-seed words (`Coupling.Thm22StdBorelStatement`, the existing named
  input of the Theorem 1.1 assembly);
* **`stoppedSeedExtensionStatement_of_thm22StdBorel`**: `StoppedSeedExtensionStatement κ` from that existence statement,
  (U), (K-pre) and (Loc).
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology QuantumZipper TopologicalSpace
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

namespace LocalExt

open Coupling Ito LQGMetric LocalSets
open SupercriticalConformalCovariance.GM24 (smoothDist)

/-- **Theorem 1.1's construction on a standard Borel driving space is a standard reference.** -/
theorem isStdReference_of_stdBorel {κ rL rR : ℝ} (hκ : 0 < κ) {Ω₀ : Type u} [mΩ₀ : MeasurableSpace Ω₀]
    [hSB : StandardBorelSpace Ω₀] {P₀ : Measure Ω₀} [IsProbabilityMeasure P₀] {𝓕₀ : Filtration ℝ≥0 mΩ₀}
    {W : ℝ≥0 → Ω₀ → ℝ} {VL VR : Fin 1 → ℝ≥0 → Ω₀ → ℝ} {B : ℝ≥0 → Ω₀ → ℝ} {ζ : Ω₀ → ℝ≥0∞}
    (hE : IsIntegratedSLEEvolution κ LP.twoSeedXL LP.twoSeedXR (fun _ => rL) (fun _ => rR) P₀ 𝓕₀ W VL VR B ζ) :
    ∃ (Pr : Measure (Ω₀ × DistOn upperHalfPlaneOpens))
      (𝓕r : Filtration ℝ≥0 (inferInstance : MeasurableSpace (Ω₀ × DistOn upperHalfPlaneOpens))),
      IsStdReference κ rL rR Pr 𝓕r (fun t p => W t p.1) (fun i t p => VL i t p.1) (fun i t p => VR i t p.1)
        (fun t p => B t p.1) (fun p => ζ p.1) (fun p => p.2) := by
  have hc := measurable_coordVal hE
  have hE₁ := isIntegratedSLEEvolution_coordFiltration hE
  have hgen := IsAeGen.usualAugmentation (IsAeGen.usualAugmentation (P₀ := P₀)
    (isAeGen_coordFiltration (P₀ := P₀) hc))
  obtain ⟨α, μ, -, hμp, hμ1, hμ2, hαG, hfamS, hfamL⟩ :=
    exists_locCoupling_of_evolution hκ hE₁ (measurable_coordMap hc) hgen
      (finiteFamilyProjStatement hκ LP.twoSeedXL LP.twoSeedXR (fun _ => rL) (fun _ => rR))
  set u₀ : ℂ → ℝ := Impl.forceExt κ (weightWord (fun _ : Fin 1 => rL) (fun _ : Fin 1 => rR))
    LP.twoSeedXL LP.twoSeedXR with hu₀def
  have hu₀ : IsBoundedHarmonicExtension (forceBoundaryData κ (fun _ : Fin 1 => rL) (fun _ : Fin 1 => rR)
      LP.twoSeedXL LP.twoSeedXR) (forceJumpSet LP.twoSeedXL LP.twoSeedXR) u₀ :=
    Impl.isBoundedHarmonicExtension_forceExt κ (weightWord (fun _ : Fin 1 => rL) (fun _ : Fin 1 => rR)) _ _
  have hu₀c : ContinuousOn u₀ H := fun z hz => (hu₀.1 z hz).1.continuousAt.continuousWithinAt
  have hEμ := IsIntegratedSLEEvolution.fst (X := DistOn upperHalfPlaneOpens) hμ1 hE₁
  have hZμ : IsZeroBoundaryGFF upperHalfPlaneOpens
      (fun p : Ω₀ × DistOn upperHalfPlaneOpens => p.2 - smoothDist upperHalfPlaneOpens u₀) μ :=
    isZeroBoundaryGFF_sub_smoothDist measurable_snd hu₀c (isZBGFFProcess_comp_snd hμ2 (hαG u₀ hu₀))
  have hharm : IsHarmonicDistOn (smoothDist upperHalfPlaneOpens u₀) H := isHarmonicDistOn_smoothDist_of hu₀
  have hC := isOptionalHullCoupling_of_isFamilySampled hEμ hκ measurable_snd
    (fun u₀' hu₀' => isZBGFFProcess_comp_snd hμ2 (hαG u₀' hu₀')) hfamS fun hX τ hτ hτζ => by
      have hl := isLocalSet_hull_of_isFamilyLocal hEμ hX hZμ (hfamL u₀ hu₀) hτ hτζ
      have hl' := IsLocalSet.add_dist hl hharm
      have e : (fun p : Ω₀ × DistOn upperHalfPlaneOpens =>
          p.2 - smoothDist upperHalfPlaneOpens u₀ + smoothDist upperHalfPlaneOpens u₀) = fun p => p.2 :=
        funext fun p => sub_add_cancel _ _
      rw [e] at hl'
      exact hl'
  refine ⟨μ, filtrationFst (usualAugmentation (coordFiltration hc) P₀) (DistOn upperHalfPlaneOpens),
    inferInstance, hμp, hC, hfamS, fun t A hA => ?_, fun u₀' hu₀' => hfamL u₀' hu₀'⟩
  obtain ⟨A₀, hA₀, hAA₀⟩ := exists_fst_ae_eq_of_measurableSet_usualAugmentation hμ1 hA
  obtain ⟨C, hC', hA₀C⟩ := hgen t A₀ hA₀
  exact ⟨C, hC', hAA₀.trans (preimage_fst_ae_eq hμ1 hA₀C)⟩

/-- **A standard reference exists** for every admissible seed pair, from Theorem 2.2's existence on a standard Borel
space for the two-seed words (`Coupling.Thm22StdBorelStatement`). -/
theorem stdTwoSeedReferenceStatement_of_thm22StdBorel {κ : ℝ} (hκ : 0 < κ)
    (h22 : ∀ rL rR : ℝ, -2 < rL → -2 < rR →
      Thm22StdBorelStatement.{u} κ LP.twoSeedXL LP.twoSeedXR (fun _ => rL) (fun _ => rR)) :
    StdTwoSeedReferenceStatement.{u} κ := by
  intro rL rR hL hR
  obtain ⟨Ω₀, mΩ₀, hSB, P₀, hP₀, 𝓕₀, W, VL, VR, B, ζ, hE⟩ := h22 rL rR hL hR
  obtain ⟨Pr, 𝓕r, href⟩ := isStdReference_of_stdBorel hκ hE
  exact ⟨Ω₀ × DistOn upperHalfPlaneOpens, inferInstance, Pr, 𝓕r, _, _, _, _, _, _, href⟩

/-- **Aux. lemma 54 for stopped seed couplings** from Theorem 2.2's existence on a standard Borel space for the two-seed
words, (U), (K-pre) and (Loc). -/
theorem stoppedSeedExtensionStatement_of_thm22StdBorel {κ : ℝ} (hκ : 0 < κ)
    (h22 : ∀ rL rR : ℝ, -2 < rL → -2 < rR →
      Thm22StdBorelStatement.{u} κ LP.twoSeedXL LP.twoSeedXR (fun _ => rL) (fun _ => rR))
    (hU : StoppedTwoSeedLawStatement.{u} κ) (hPre : ExtPreStopStatement.{u} κ) (hLoc : ExtLocalityStatement.{u} κ) :
    StoppedSeedExtensionStatement.{u} κ :=
  stoppedSeedExtensionStatement_of_inputs hκ (stdTwoSeedReferenceStatement_of_thm22StdBorel hκ h22) hU hPre hLoc

end LocalExt

