/-! ### The Schwarz reflection at an untouched real point -/

/-- `G` is the **Schwarz reflection of the mapping-out function `g` at the untouched real point `x`** on the ball
`B(x, r)`: `B(x, 2r)` avoids the hull, `G` is holomorphic on `B(x, r)`, equals `g` on the upper half-ball, commutes
with conjugation, and is real on the real diameter. -/
structure IsBdryReflection (A : Set ℂ) (g G : ℂ → ℂ) (x r : ℝ) : Prop where
  pos : 0 < r
  disj : Disjoint (ball (x : ℂ) (2 * r)) A
  diff : DifferentiableOn ℂ G (ball (x : ℂ) r)
  eqOn : EqOn G g (ball (x : ℂ) r ∩ H)
  map_conj : ∀ z ∈ ball (x : ℂ) r, G (conj z) = conj (G z)
  real_of_im : ∀ z ∈ ball (x : ℂ) r, z.im = 0 → (G z).im = 0

variable {A : Set ℂ} {g G : ℂ → ℂ} {x r : ℝ}

/-- The upper half-ball lies in `ℍ \ A`. -/
theorem IsBdryReflection.subset (hG : IsBdryReflection A g G x r) : ball (x : ℂ) r ∩ H ⊆ H \ A := by
  have := ball_half_inter_H_subset (y := x) hG.disj
  rwa [mul_div_cancel_left₀ r two_ne_zero] at this

theorem exists_isBdryReflection (hA : IsHPHull A) (hg : IsMapOut A g) {ρ : ℝ} (hρ : 0 < ρ)
    (hd : Disjoint (ball (x : ℂ) ρ) A) : ∃ G, IsBdryReflection A g G x (ρ / 2) := by
  obtain ⟨G, hGd, hGeq, hGc, hGr, -, -⟩ := hg.exists_reflection hA hd
  exact ⟨G, ⟨half_pos hρ, by rwa [mul_div_cancel₀ ρ two_ne_zero], hGd, hGeq, hGc, hGr⟩⟩

theorem IsBdryReflection.im_pos (hG : IsBdryReflection A g G x r) (hg : IsMapOut A g) {z : ℂ}
    (hz : z ∈ ball (x : ℂ) r) (hzH : 0 < z.im) : 0 < (G z).im := by
  rw [hG.eqOn ⟨hz, hzH⟩]
  exact hg.1.2.mapsTo (hG.subset ⟨hz, hzH⟩)

theorem IsBdryReflection.im_neg (hG : IsBdryReflection A g G x r) (hg : IsMapOut A g) {z : ℂ}
    (hz : z ∈ ball (x : ℂ) r) (hzH : z.im < 0) : (G z).im < 0 := by
  have hcz : conj z ∈ ball (x : ℂ) r := QuantumZipper.CA.conj_mem_ball_ofReal hz
  have h1 := hG.im_pos hg hcz (by simpa using hzH)
  have h2 := hG.map_conj (conj z) hcz
  rw [conj_conj] at h2
  rw [h2, conj_im]
  linarith

/-- **The reflection is injective** near an untouched real point. Off the real line the sign of `Im` separates the
upper and lower halves, where `g` and its conjugate are injective. Two real points with the same value would, by the
open mapping theorem, give two distinct preimages in `ℍ` of a point of `ℍ` close to that value. -/
theorem IsBdryReflection.injOn (hG : IsBdryReflection A g G x r) (hg : IsMapOut A g) :
    InjOn G (ball (x : ℂ) r) := by
  have hinj : InjOn g (H \ A) := hg.1.2.injOn
  -- the sign of `Im G` is the sign of `Im`
  have hpos : ∀ z ∈ ball (x : ℂ) r, 0 < (G z).im → 0 < z.im := fun z hz h => by
    rcases lt_trichotomy z.im 0 with h' | h' | h'
    · linarith [hG.im_neg hg hz h']
    · rw [hG.real_of_im z hz h'] at h; exact absurd h (lt_irrefl _)
    · exact h'
  have hupper : ∀ z ∈ ball (x : ℂ) r, ∀ w ∈ ball (x : ℂ) r, 0 < z.im → 0 < w.im → G z = G w → z = w :=
    fun z hz w hw hzi hwi hzw => by
      rw [hG.eqOn ⟨hz, hzi⟩, hG.eqOn ⟨hw, hwi⟩] at hzw
      exact hinj (hG.subset ⟨hz, hzi⟩) (hG.subset ⟨hw, hwi⟩) hzw
  intro z hz w hw hzw
  rcases lt_trichotomy z.im 0 with hzi | hzi | hzi
  · -- lower half: conjugate
    have hwi : w.im < 0 := by
      rcases lt_trichotomy w.im 0 with h | h | h
      · exact h
      · have := hG.im_neg hg hz hzi; rw [hzw, hG.real_of_im w hw h] at this; exact absurd this (lt_irrefl _)
      · have := hG.im_neg hg hz hzi; rw [hzw] at this; linarith [hG.im_pos hg hw h]
    have hcz := QuantumZipper.CA.conj_mem_ball_ofReal hz
    have hcw := QuantumZipper.CA.conj_mem_ball_ofReal hw
    have := hupper (conj z) hcz (conj w) hcw (by simpa using hzi) (by simpa using hwi)
      (by rw [hG.map_conj z hz, hG.map_conj w hw, hzw])
    simpa using congrArg conj this
  · -- real point: open mapping
    have hwi : w.im = 0 := by
      rcases lt_trichotomy w.im 0 with h | h | h
      · have := hG.im_neg hg hw h; rw [← hzw, hG.real_of_im z hz hzi] at this; exact absurd this (lt_irrefl _)
      · exact h
      · have := hG.im_pos hg hw h; rw [← hzw, hG.real_of_im z hz hzi] at this; exact absurd this (lt_irrefl _)
    by_contra hne
    -- `G` is not locally constant at a point of the ball (identity theorem: it would be constant on the ball)
    have hnc : ∀ u ∈ ball (x : ℂ) r, ¬ ∀ᶠ v in 𝓝 u, G v = G u := by
      intro u hu hev
      have hc := (hG.diff.analyticOnNhd isOpen_ball).eqOn_of_preconnected_of_eventuallyEq
        (analyticOnNhd_const (v := G u)) (convex_ball _ _).isPreconnected hu hev
      have hr := hG.pos
      have hm : ∀ c : ℝ, 0 < c → c < r → (x : ℂ) + (c : ℂ) * I ∈ ball (x : ℂ) r := fun c hc0 hcr => by
        rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_mul, norm_I, mul_one, Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos hc0]
        exact hcr
      have h1 := hm (r / 2) (by positivity) (by linarith)
      have h2 := hm (r / 4) (by positivity) (by linarith)
      have heq := hupper _ h1 _ h2 (by simp; positivity) (by simp; positivity) ((hc h1).trans (hc h2).symm)
      have : ((x : ℂ) + ((r / 2 : ℝ) : ℂ) * I).im = ((x : ℂ) + ((r / 4 : ℝ) : ℂ) * I).im := by rw [heq]
      simp at this
      linarith
    have hopen : ∀ u ∈ ball (x : ℂ) r, ∀ N ∈ 𝓝 u, G '' N ∈ 𝓝 (G u) := fun u hu N hN => by
      have han : AnalyticAt ℂ G u := hG.diff.analyticAt (isOpen_ball.mem_nhds hu)
      rcases han.eventually_constant_or_nhds_le_map_nhds with h | h
      · exact absurd h (hnc u hu)
      · exact h (image_mem_map hN)
    -- disjoint neighbourhoods of `z` and `w`
    set δ := dist z w / 2 with hδ
    have hδpos : 0 < δ := half_pos (dist_pos.2 hne)
    have hNz : ball z δ ∩ ball (x : ℂ) r ∈ 𝓝 z := inter_mem (ball_mem_nhds z hδpos) (isOpen_ball.mem_nhds hz)
    have hNw : ball w δ ∩ ball (x : ℂ) r ∈ 𝓝 w := inter_mem (ball_mem_nhds w hδpos) (isOpen_ball.mem_nhds hw)
    have hi := inter_mem (hopen z hz _ hNz) (hzw ▸ hopen w hw _ hNw : G '' (ball w δ ∩ ball (x : ℂ) r) ∈ 𝓝 (G z))
    obtain ⟨ε, hε, hεs⟩ := Metric.mem_nhds_iff.1 hi
    set c : ℂ := G z + ((ε / 2 : ℝ) : ℂ) * I
    have hc : c ∈ ball (G z) ε := by
      rw [mem_ball, dist_eq_norm, show c - G z = ((ε / 2 : ℝ) : ℂ) * I by simp [c], norm_mul, norm_I, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos (half_pos hε)]
      exact half_lt_self hε
    obtain ⟨⟨z', ⟨hz'z, hz'b⟩, hz'c⟩, ⟨w', ⟨hw'w, hw'b⟩, hw'c⟩⟩ := hεs hc
    have hci : 0 < c.im := by simp [c, hG.real_of_im z hz hzi]; positivity
    have hz'i : 0 < z'.im := hpos z' hz'b (hz'c ▸ hci)
    have hw'i : 0 < w'.im := hpos w' hw'b (hw'c ▸ hci)
    have heq := hupper z' hz'b w' hw'b hz'i hw'i (hz'c.trans hw'c.symm)
    have h1 : dist z' z < δ := hz'z
    have h2 : dist w' w < δ := hw'w
    rw [heq] at h1
    have : dist z w < 2 * δ := (dist_triangle_left z w w').trans_lt (by linarith)
    rw [hδ] at this
    linarith
  · -- upper half
    have hwi : 0 < w.im := by
      rcases lt_trichotomy w.im 0 with h | h | h
      · have := hG.im_neg hg hw h; rw [← hzw] at this; linarith [hG.im_pos hg hz hzi]
      · have := hG.im_pos hg hz hzi; rw [hzw, hG.real_of_im w hw h] at this; exact absurd this (lt_irrefl _)
      · exact h
    exact hupper z hz w hw hzi hwi hzw

/-- **The boundary derivative is real and positive**: `G′(x) ≠ 0` (the reflection is injective), `G′(x)` is real (`G`
is real on the real diameter), and `Re G′(x) ≥ 0` (`Re((G(x + it) − G(x))/(it)) = Im g(x + it)/t > 0`). -/
theorem IsBdryReflection.deriv_im_eq_zero_and_re_pos (hG : IsBdryReflection A g G x r) (hg : IsMapOut A g) :
    (deriv G x).im = 0 ∧ 0 < (deriv G x).re := by
  have hr := hG.pos
  have hxB : (x : ℂ) ∈ ball (x : ℂ) r := mem_ball_self hr
  have hne : deriv G x ≠ 0 :=
    QuantumZipper.CA.deriv_ne_zero_of_injOn isOpen_ball hG.diff (hG.injOn hg) hxB
  have hdx : DifferentiableAt ℂ G x := hG.diff.differentiableAt (isOpen_ball.mem_nhds hxB)
  -- the derivative is real
  have him : (deriv G x).im = 0 := by
    have h1 : DifferentiableAt ℂ (fun u => G (u + x)) 0 := by
      have : DifferentiableAt ℂ G (0 + (x : ℂ)) := by rwa [zero_add]
      exact this.comp (0 : ℂ) (differentiableAt_id.add_const _)
    have h2 := im_deriv_eq_zero_of_im_eq_zero hr h1 fun t ht => by
      refine hG.real_of_im _ ?_ (by simp)
      rw [mem_ball, dist_eq_norm, add_sub_cancel_right, Complex.norm_real, Real.norm_eq_abs]
      exact ht
    rwa [deriv_comp_add_const, zero_add] at h2
  -- its real part is nonnegative
  have hre : 0 ≤ (deriv G x).re := by
    have hs := (hasDerivAt_iff_tendsto_slope.1 hdx.hasDerivAt)
    set φ : ℝ → ℂ := fun t => (x : ℂ) + (t : ℂ) * I with hφ
    have hφc : Continuous φ := by fun_prop
    have hφt : Tendsto φ (𝓝[>] 0) (𝓝[≠] (x : ℂ)) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · have := (hφc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
        simpa [hφ] using this
      · filter_upwards [self_mem_nhdsWithin] with t ht
        simp only [hφ, mem_compl_iff, mem_singleton_iff, add_eq_left, mul_eq_zero, ofReal_eq_zero, I_ne_zero,
          or_false]
        exact ne_of_gt ht
    have hlim := ((continuous_re.tendsto _).comp (hs.comp hφt))
    refine ge_of_tendsto hlim ?_
    have hφ0 : φ 0 = x := by simp [hφ]
    have hball : ∀ᶠ t in 𝓝[>] (0 : ℝ), φ t ∈ ball (x : ℂ) r :=
      ((hφc.tendsto 0).mono_left nhdsWithin_le_nhds).eventually
        (show ball (x : ℂ) r ∈ 𝓝 (φ 0) by rw [hφ0]; exact isOpen_ball.mem_nhds hxB)
    filter_upwards [hball, self_mem_nhdsWithin] with t ht htpos
    have htpos' : (0 : ℝ) < t := htpos
    have hGx : (G x).im = 0 := hG.real_of_im _ hxB (by simp)
    have hφi : 0 < (φ t).im := by simp [hφ, htpos']
    have hpos := hG.im_pos hg ht hφi
    show 0 ≤ (slope G x (φ t)).re
    have e : slope G x (φ t) = (G (φ t) - G x) / ((t : ℂ) * I) := by
      rw [slope_def_field]; simp [hφ]
    rw [e, div_re]
    have h1 : ((t : ℂ) * I).re = 0 := by simp
    have h2 : ((t : ℂ) * I).im = t := by simp
    rw [h1, h2, mul_zero, zero_div, zero_add, sub_im, hGx, sub_zero]
    exact div_nonneg (mul_nonneg hpos.le htpos'.le) (normSq_nonneg _)
  refine ⟨him, lt_of_le_of_ne hre fun h => hne ?_⟩
  exact Complex.ext h.symm him

/-- **The boundary value of the reflection is within the hull bound of the identity**: if `|g − id| ≤ M` on
`ℍ \ A`, then `|G(x) − x| ≤ M` (limit along `x + it`). -/
theorem IsBdryReflection.norm_sub_le (hG : IsBdryReflection A g G x r) {M : ℝ}
    (hM : ∀ z ∈ H \ A, ‖g z - z‖ ≤ M) : ‖G x - x‖ ≤ M := by
  have hr := hG.pos
  have hxB : (x : ℂ) ∈ ball (x : ℂ) r := mem_ball_self hr
  have hGc : ContinuousAt G x := (hG.diff.differentiableAt (isOpen_ball.mem_nhds hxB)).continuousAt
  set φ : ℝ → ℂ := fun t => (x : ℂ) + (t : ℂ) * I with hφ
  have hφc : Continuous φ := by fun_prop
  have hφ0 : φ 0 = x := by simp [hφ]
  have hlim : Tendsto (fun t => ‖G (φ t) - φ t‖) (𝓝[>] 0) (𝓝 ‖G x - x‖) := by
    have h1 : Tendsto φ (𝓝[>] 0) (𝓝 (x : ℂ)) := by
      have := (hφc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
      rwa [hφ0] at this
    exact ((hGc.tendsto.comp h1).sub h1).norm
  refine le_of_tendsto hlim ?_
  have hball : ∀ᶠ t in 𝓝[>] (0 : ℝ), φ t ∈ ball (x : ℂ) r :=
    ((hφc.tendsto 0).mono_left nhdsWithin_le_nhds).eventually
      (show ball (x : ℂ) r ∈ 𝓝 (φ 0) by rw [hφ0]; exact isOpen_ball.mem_nhds hxB)
  filter_upwards [hball, self_mem_nhdsWithin] with t ht htpos
  have htpos' : (0 : ℝ) < t := htpos
  have hH : φ t ∈ ball (x : ℂ) r ∩ H := ⟨ht, show 0 < (φ t).im by simp [hφ, htpos']⟩
  rw [hG.eqOn hH]
  exact hM _ (hG.subset hH)

/-- `deriv G = deriv g` on the upper half-ball. -/
theorem IsBdryReflection.deriv_eq (hG : IsBdryReflection A g G x r) {z : ℂ} (hz : z ∈ ball (x : ℂ) r ∩ H) :
    deriv G z = deriv g z := by
  have ho : IsOpen (ball (x : ℂ) r ∩ H) := isOpen_ball.inter QuantumZipper.isOpen_H
  exact Filter.EventuallyEq.deriv_eq (Filter.eventuallyEq_of_mem (ho.mem_nhds hz) hG.eqOn)

/-! ### The canonical logarithm near an untouched real point -/

variable {L : ℂ → ℂ}

/-- **Near an untouched real point the canonical logarithm is `Log G′ + 2πin`** for one integer `n`, so it has the
limit `log G′(x) + 2πin` at `x` along `ℍ`. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.exists_int_tendsto
    (hL : IsCanonicalDerivLog A g L) (hg : IsMapOut A g)
    (hG : IsBdryReflection A g G x r) :
    ∃ n : ℤ, Tendsto L (𝓝[H] (x : ℂ)) (𝓝 (log (deriv G x) + n * (2 * π * I))) := by
  have hr := hG.pos
  have hxB : (x : ℂ) ∈ ball (x : ℂ) r := mem_ball_self hr
  have hGa : DifferentiableOn ℂ (deriv G) (ball (x : ℂ) r) := hG.diff.deriv isOpen_ball
  have hdc : ContinuousAt (deriv G) x := (hGa.differentiableAt (isOpen_ball.mem_nhds hxB)).continuousAt
  obtain ⟨him, hre⟩ := hG.deriv_im_eq_zero_and_re_pos hg
  have hsl : deriv G x ∈ slitPlane := Or.inl hre
  -- a ball where `G′` stays in the slit plane
  obtain ⟨δ, hδ, hδs⟩ := Metric.mem_nhds_iff.1 ((hdc.preimage_mem_nhds (isOpen_slitPlane.mem_nhds hsl)))
  set δ' := min δ r with hδ'
  have hδ'pos : 0 < δ' := lt_min hδ hr
  set U := ball (x : ℂ) δ' ∩ H with hU
  have hUB : U ⊆ ball (x : ℂ) r ∩ H := fun z hz => ⟨ball_subset_ball (min_le_right _ _) hz.1, hz.2⟩
  have hUs : ∀ z ∈ U, deriv G z ∈ slitPlane := fun z hz => hδs (ball_subset_ball (min_le_left _ _) hz.1)
  have hUc : IsPreconnected U :=
    ((convex_ball _ _).inter (convex_halfSpace_im_gt (r := 0))).isPreconnected
  have hLc : ContinuousOn L U := hL.1.1.continuousOn.mono fun z hz => hG.subset (hUB hz)
  have hdGc : ContinuousOn (deriv G) U := hGa.continuousOn.mono fun z hz => (hUB hz).1
  obtain ⟨n, hn⟩ := exists_int_eqOn_log hUc hLc hdGc hUs fun z hz => by
    rw [hL.1.2 z (hG.subset (hUB hz)), hG.deriv_eq (hUB hz)]
  refine ⟨n, ?_⟩
  have hcont : ContinuousAt (fun z => log (deriv G z) + n * (2 * π * I)) x :=
    (hdc.clog hsl).add continuousAt_const
  refine (hcont.tendsto.mono_left nhdsWithin_le_nhds).congr' ?_
  have hmem : U ∈ 𝓝[H] (x : ℂ) := by
    rw [hU, inter_comm]; exact inter_mem_nhdsWithin H (ball_mem_nhds _ hδ'pos)
  filter_upwards [hmem] with z hz
  exact (hn z hz).symm

/-! ### Gluing reflections and paths -/

/-- A reflection on a smaller ball. -/
theorem IsBdryReflection.mono (hG : IsBdryReflection A g G x r) {r' : ℝ} (hr' : 0 < r') (hrr : r' ≤ r) :
    IsBdryReflection A g G x r' where
  pos := hr'
  disj := hG.disj.mono_left (ball_subset_ball (by linarith))
  diff := hG.diff.mono (ball_subset_ball hrr)
  eqOn := fun z hz => hG.eqOn ⟨ball_subset_ball hrr hz.1, hz.2⟩
  map_conj := fun z hz => hG.map_conj z (ball_subset_ball hrr hz)
  real_of_im := fun z hz => hG.real_of_im z (ball_subset_ball hrr hz)

/-- **Gluing a holomorphic function on a ball**: if `f` is holomorphic on an open `Ω`, `G` on `B(c, r)`, and they
agree on `Ω ∩ B(c, r)`, the function equal to `G` on the ball and to `f` elsewhere is holomorphic on `Ω ∪ B(c, r)`
and equals `f` on `Ω`. -/
theorem differentiableOn_piecewise_ball {f G' : ℂ → ℂ} {Ω : Set ℂ} {c : ℂ} {ρ : ℝ} (hΩ : IsOpen Ω)
    (hf : DifferentiableOn ℂ f Ω) (hG : DifferentiableOn ℂ G' (ball c ρ)) (hfG : EqOn f G' (Ω ∩ ball c ρ)) :
    DifferentiableOn ℂ (fun z => open scoped Classical in if z ∈ ball c ρ then G' z else f z) (Ω ∪ ball c ρ) ∧
      EqOn (fun z => open scoped Classical in if z ∈ ball c ρ then G' z else f z) f Ω := by
  classical
  have heq : EqOn (fun z => if z ∈ ball c ρ then G' z else f z) f Ω := fun z hz => by
    by_cases h : z ∈ ball c ρ
    · simp only [h, ↓reduceIte]; exact (hfG ⟨hz, h⟩).symm
    · simp only [h, ↓reduceIte]
  refine ⟨fun z hz => ?_, heq⟩
  rcases hz with hz | hz
  · refine ((hf z hz).differentiableAt (hΩ.mem_nhds hz)).congr_of_eventuallyEq ?_ |>.differentiableWithinAt
    exact Filter.eventuallyEq_of_mem (hΩ.mem_nhds hz) heq
  · refine ((hG z hz).differentiableAt (isOpen_ball.mem_nhds hz)).congr_of_eventuallyEq ?_
      |>.differentiableWithinAt
    filter_upwards [isOpen_ball.mem_nhds hz] with w hw
    simp [hw]

/-- The upward vertical segment `t ↦ u + t c i` as a path. -/
def vertPath (u : ℂ) (c : ℝ) : Path u (u + (c : ℂ) * I) where
  toFun t := u + (((t : ℝ) * c : ℝ) : ℂ) * I
  continuous_toFun := by fun_prop
  source' := by simp
  target' := by simp

theorem vertPath_apply (u : ℂ) (c : ℝ) (t : unitInterval) :
    vertPath u c t = u + (((t : ℝ) * c : ℝ) : ℂ) * I := rfl

/-- The points of a concatenation at times in `(0, 1)` come from the two pieces at times in `(0, 1]` and
`[0, 1)`. -/
theorem Path.trans_mem_of_mem {X : Type*} [TopologicalSpace X] {a b c : X} (γ₁ : Path a b) (γ₂ : Path b c)
    {S : Set X} (h₁ : ∀ t : unitInterval, 0 < (t : ℝ) → γ₁ t ∈ S) (h₂ : ∀ t : unitInterval, (t : ℝ) < 1 → γ₂ t ∈ S)
    (t : unitInterval) (ht0 : 0 < (t : ℝ)) (ht1 : (t : ℝ) < 1) : γ₁.trans γ₂ t ∈ S := by
  rw [Path.trans_apply]
  split_ifs with h
  · exact h₁ _ (by simp only; linarith)
  · exact h₂ _ (by simp only; linarith)

/-- **A path between two untouched real points through `ℍ \ A`**: if `u + si ∈ D` for `s ∈ (0, c]` at both real
points `x`, `y`, and `D` is path connected, there is a continuous `γ : ℝ → ℂ` with `γ 0 = y`, `γ 1 = x` and
`γ t ∈ D` for `t ∈ (0, 1)`. -/
theorem exists_path_of_vert {D : Set ℂ} (hD : IsPathConnected D) {x y c : ℝ}
    (hx : ∀ s : ℝ, 0 < s → s ≤ c → (x : ℂ) + (s : ℂ) * I ∈ D)
    (hy : ∀ s : ℝ, 0 < s → s ≤ c → (y : ℂ) + (s : ℂ) * I ∈ D) (hc : 0 < c) :
    ∃ γ : ℝ → ℂ, Continuous γ ∧ γ 0 = y ∧ γ 1 = x ∧ ∀ t ∈ Ioo (0 : ℝ) 1, γ t ∈ D := by
  obtain ⟨p, hp⟩ := hD.joinedIn _ (hy c hc le_rfl) _ (hx c hc le_rfl)
  set Γ := (vertPath (y : ℂ) c).trans (p.trans (vertPath (x : ℂ) c).symm) with hΓ
  refine ⟨Γ.extend, Γ.continuous_extend, Γ.extend_zero, Γ.extend_one, fun t ht => ?_⟩
  rw [Γ.extend_extends' ⟨t, Ioo_subset_Icc_self ht⟩]
  refine Path.trans_mem_of_mem _ _ (fun s hs => ?_) (fun s hs => ?_) _ ht.1 ht.2
  · rw [vertPath_apply]
    exact hy _ (mul_pos hs hc) (by nlinarith [s.2.2])
  · rw [Path.trans_apply]
    split_ifs with hs2
    · exact hp _
    · rw [Path.symm_apply, Function.comp_apply, vertPath_apply, unitInterval.coe_symm_eq]
      have hs2' : (1 : ℝ) / 2 < s := not_le.1 hs2
      refine hx _ (mul_pos ?_ hc) ?_
      · simp only; linarith
      · simp only
        nlinarith

/-! ### Secant facts -/

/-- For `z ∈ ℍ` and a real `u` with `f z ∈ ℍ`, `f u ∈ ℝ`, the secant `dslope f u z = dslope f z u` lies in the
slit plane. -/
theorem dslope_mem_slitPlane {f : ℂ → ℂ} {z u : ℂ} (hz : 0 < z.im) (hu : u.im = 0) (hfz : 0 < (f z).im)
    (hfu : (f u).im = 0) : dslope f u z ∈ slitPlane ∧ dslope f z u ∈ slitPlane := by
  have hne : z ≠ u := fun h => by rw [h, hu] at hz; exact lt_irrefl _ hz
  have h1 : dslope f u z ∈ slitPlane := by
    rw [dslope_of_ne _ hne, slope_def_field]
    exact div_mem_slitPlane_of_mem_H (by rw [sub_im, hfu, sub_zero]; exact hfz)
      (by rw [sub_im, hu, sub_zero]; exact hz)
  refine ⟨h1, ?_⟩
  rwa [dslope_of_ne _ (Ne.symm hne), slope_comm, ← dslope_of_ne _ hne]

/-- A quotient of two negative reals lies in the slit plane. -/
theorem div_mem_slitPlane_of_re_neg {a b : ℂ} (ha : a.im = 0) (hb : b.im = 0) (ha' : a.re < 0) (hb' : b.re < 0) :
    a / b ∈ slitPlane := by
  have ea : a = (a.re : ℂ) := Complex.ext (by simp) (by simp [ha])
  have eb : b = (b.re : ℂ) := Complex.ext (by simp) (by simp [hb])
  rw [ea, eb, ← ofReal_div]
  exact Or.inl (by rw [ofReal_re]; exact div_pos_of_neg_of_neg ha' hb')

/-- The secant of `f` does not vanish when `f` is injective on a set containing both points and `f′ ≠ 0` there. -/
theorem dslope_ne_zero {f : ℂ → ℂ} {a b : ℂ} (hd : a = b → deriv f a ≠ 0) (hi : a ≠ b → f a ≠ f b) :
    dslope f a b ≠ 0 := by
  rcases eq_or_ne a b with rfl | hab
  · rw [dslope_same]; exact hd rfl
  · rw [dslope_of_ne _ (Ne.symm hab), slope_def_field]
    exact div_ne_zero (sub_ne_zero.2 (Ne.symm (hi hab))) (sub_ne_zero.2 (Ne.symm hab))

/-! ### The path lemma -/

/-- **The path lemma.** Let `f` be holomorphic on an open `Ω`, injective with `f′ ≠ 0` on `P ⊆ Ω`, and `L` a
continuous logarithm of `f′` on an open `D`. Let `γ : [0, 1] → P` be continuous with `γ((0, 1)) ⊆ D`, such that the
secants `S(γ t, γ 0)` and `S(γ 1, γ s)` lie in the slit plane. If `L ∘ γ → ℓ₀` at `0` and `→ ℓ₁` at `1`, then
`ℓ₁ − ℓ₀ = Log f′(γ 1) − Log f′(γ 0)` (square lemma for `(t, s) ↦ S(γ t, γ s)`; on the diagonal `L ∘ γ` and the
logarithm of the square differ by one constant). -/
theorem sub_eq_log_sub_log_of_path {f L : ℂ → ℂ} {Ω D P : Set ℂ} (hΩ : IsOpen Ω) (hf : DifferentiableOn ℂ f Ω)
    (hLc : ContinuousOn L D) (hLe : ∀ z ∈ D, exp (L z) = deriv f z) {γ : ℝ → ℂ} (hγc : Continuous γ)
    (hγP : ∀ t ∈ Icc (0 : ℝ) 1, γ t ∈ P) (hPΩ : P ⊆ Ω) (hγD : ∀ t ∈ Ioo (0 : ℝ) 1, γ t ∈ D)
    (hinj : ∀ a ∈ P, ∀ b ∈ P, a ≠ b → f a ≠ f b) (hder : ∀ a ∈ P, deriv f a ≠ 0)
    (hbot : ∀ t ∈ Icc (0 : ℝ) 1, dslope f (γ 0) (γ t) ∈ slitPlane)
    (hright : ∀ s ∈ Icc (0 : ℝ) 1, dslope f (γ s) (γ 1) ∈ slitPlane) {ℓ₀ ℓ₁ : ℂ}
    (h₀ : Tendsto (fun t => L (γ t)) (𝓝[>] 0) (𝓝 ℓ₀)) (h₁ : Tendsto (fun t => L (γ t)) (𝓝[<] 1) (𝓝 ℓ₁)) :
    ℓ₁ - ℓ₀ = log (deriv f (γ 1)) - log (deriv f (γ 0)) := by
  have hmaps : MapsTo (fun p : ℝ × ℝ => (γ p.1, γ p.2)) (Icc 0 1 ×ˢ Icc 0 1) (Ω ×ˢ Ω) :=
    fun p hp => ⟨hPΩ (hγP _ hp.1), hPΩ (hγP _ hp.2)⟩
  have hcomp : ContinuousOn ((fun q : ℂ × ℂ => dslope f q.2 q.1) ∘ fun p : ℝ × ℝ => (γ p.1, γ p.2))
      (Icc 0 1 ×ˢ Icc 0 1) :=
    (continuousOn_dslope_prod hΩ hf).comp
      ((hγc.comp continuous_fst).prodMk (hγc.comp continuous_snd)).continuousOn hmaps
  have hF0 : ∀ t ∈ Icc (0 : ℝ) 1, ∀ s ∈ Icc (0 : ℝ) 1, dslope f (γ s) (γ t) ≠ 0 := fun t ht s hs =>
    dslope_ne_zero (fun _ => hder _ (hγP s hs)) fun h => hinj _ (hγP s hs) _ (hγP t ht) h
  obtain ⟨Λ, hΛc, hΛ, hsq⟩ := exists_log_square (F := fun t s => dslope f (γ s) (γ t)) hcomp hF0 hbot hright
  have hdc : Continuous fun t : ℝ => Λ t t := hΛc.comp (continuous_id.prodMk continuous_id)
  have hLγ : ContinuousOn (fun t => L (γ t)) (Ioo 0 1) :=
    hLc.comp hγc.continuousOn fun t ht => hγD t ht
  obtain ⟨k, hk⟩ := exists_int_eqOn_of_exp_eq isPreconnected_Ioo hLγ hdc.continuousOn fun t ht => by
    rw [hLe _ (hγD t ht), hΛ t (Ioo_subset_Icc_self ht) t (Ioo_subset_Icc_self ht), dslope_same]
  have hlim1 : Tendsto (fun t => L (γ t)) (𝓝[<] (1 : ℝ)) (𝓝 (Λ 1 1 + k * (2 * π * I))) := by
    refine (((hdc.tendsto 1).add tendsto_const_nhds).mono_left nhdsWithin_le_nhds).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with t ht
    exact (hk t ht).symm
  have hlim0 : Tendsto (fun t => L (γ t)) (𝓝[>] (0 : ℝ)) (𝓝 (Λ 0 0 + k * (2 * π * I))) := by
    refine (((hdc.tendsto 0).add tendsto_const_nhds).mono_left nhdsWithin_le_nhds).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < 1 by norm_num)] with t ht
    exact (hk t ht).symm
  rw [tendsto_nhds_unique h₁ hlim1, tendsto_nhds_unique h₀ hlim0]
  rw [← dslope_same f (γ 1), ← dslope_same f (γ 0), ← hsq]
  ring

/-! ### Gluing the reflections at two untouched real points -/

variable {Gx Gy : ℂ → ℂ} {y : ℝ}

/-- **The mapping-out function extended by reflection at two untouched real points** `x`, `y` with disjoint balls:
holomorphic on an open `Ω ⊇ (ℍ \ A) ∪ B(x, r) ∪ B(y, r)`, equal to `g`, `G_x`, `G_y` there. -/
theorem exists_glued (hA : IsHPHull A) (hg : IsMapOut A g) (hx : IsBdryReflection A g Gx x r)
    (hy : IsBdryReflection A g Gy y r) (hdisj : Disjoint (ball (x : ℂ) r) (ball (y : ℂ) r)) :
    ∃ (f : ℂ → ℂ) (Ω : Set ℂ), IsOpen Ω ∧ DifferentiableOn ℂ f Ω ∧ H \ A ⊆ Ω ∧ ball (x : ℂ) r ⊆ Ω ∧
      ball (y : ℂ) r ⊆ Ω ∧ EqOn f g (H \ A) ∧ EqOn f Gx (ball (x : ℂ) r) ∧ EqOn f Gy (ball (y : ℂ) r) := by
  classical
  have hDo : IsOpen (H \ A) := hA.isOpen
  obtain ⟨hd₁, he₁⟩ := differentiableOn_piecewise_ball (c := (y : ℂ)) (ρ := r) hDo hg.1.1 hy.diff
    fun z hz => (hy.eqOn ⟨hz.2, hz.1.1⟩).symm
  set g₁ : ℂ → ℂ := fun z => if z ∈ ball (y : ℂ) r then Gy z else g z with hg₁
  have hΩ₁o : IsOpen (H \ A ∪ ball (y : ℂ) r) := hDo.union isOpen_ball
  obtain ⟨hd, he⟩ := differentiableOn_piecewise_ball (c := (x : ℂ)) (ρ := r) hΩ₁o hd₁ hx.diff fun z hz => by
    rcases hz.1 with hzD | hzy
    · rw [he₁ hzD]; exact (hx.eqOn ⟨hz.2, hzD.1⟩).symm
    · exact absurd hzy (Set.disjoint_left.1 hdisj hz.2)
  refine ⟨_, _, hΩ₁o.union isOpen_ball, hd, fun z hz => Or.inl (Or.inl hz), fun z hz => Or.inr hz,
    fun z hz => Or.inl (Or.inr hz), fun z hz => (he (Or.inl hz)).trans (he₁ hz), fun z hz => ?_, fun z hz => ?_⟩
  · simp only [hz, ↓reduceIte]
  · rw [he (Or.inr hz)]; simp only [hg₁, hz, ↓reduceIte]

/-- `deriv f = deriv h` at points of an open set on which `f = h`. -/
theorem deriv_eq_of_eqOn {f h : ℂ → ℂ} {U : Set ℂ} (hU : IsOpen U) (he : EqOn f h U) {z : ℂ} (hz : z ∈ U) :
    deriv f z = deriv h z :=
  Filter.EventuallyEq.deriv_eq (Filter.eventuallyEq_of_mem (hU.mem_nhds hz) he)

/-- Approaching a point `u` along a path that lies in `ℍ` for `t ∈ (0, 1)`. -/
theorem tendsto_path_nhdsWithin_one {γ : ℝ → ℂ} (hγc : Continuous γ) {S : Set ℂ}
    (hγS : ∀ t ∈ Ioo (0 : ℝ) 1, γ t ∈ S) : Tendsto γ (𝓝[<] (1 : ℝ)) (𝓝[S] (γ 1)) := by
  refine tendsto_nhdsWithin_iff.2 ⟨(hγc.tendsto 1).mono_left nhdsWithin_le_nhds, ?_⟩
  filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with t ht
  exact hγS t ht

theorem tendsto_path_nhdsWithin_zero {γ : ℝ → ℂ} (hγc : Continuous γ) {S : Set ℂ}
    (hγS : ∀ t ∈ Ioo (0 : ℝ) 1, γ t ∈ S) : Tendsto γ (𝓝[>] (0 : ℝ)) (𝓝[S] (γ 0)) := by
  refine tendsto_nhdsWithin_iff.2 ⟨(hγc.tendsto 0).mono_left nhdsWithin_le_nhds, ?_⟩
  filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < 1 by norm_num)] with t ht
  exact hγS t ht

/-- The real boundary value `G(x)` of a reflection at an untouched point. -/
theorem IsBdryReflection.im_center (hG : IsBdryReflection A g G x r) : (G x).im = 0 :=
  hG.real_of_im _ (mem_ball_self hG.pos) (by simp)

/-! ### Step 1: the same integer at any two untouched real points -/

/-- **Step 1.** The integers of `IsCanonicalDerivLog.exists_int_tendsto` at two untouched real points `x < y` agree,
provided `y − x > 2M` (`|g − id| ≤ M`) and the two reflection balls are disjoint. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.int_eq_of_two
    (hA : IsHPHull A) (hL : IsCanonicalDerivLog A g L) (hg : IsMapOut A g)
    (hx : IsBdryReflection A g Gx x r) (hy : IsBdryReflection A g Gy y r) {M : ℝ}
    (hM : ∀ z ∈ H \ A, ‖g z - z‖ ≤ M) (hxy : x + 2 * M < y) (hr : 2 * r ≤ y - x) {nx ny : ℤ}
    (hnx : Tendsto L (𝓝[H] (x : ℂ)) (𝓝 (log (deriv Gx x) + nx * (2 * π * I))))
    (hny : Tendsto L (𝓝[H] (y : ℂ)) (𝓝 (log (deriv Gy y) + ny * (2 * π * I)))) : nx = ny := by
  have hDo : IsOpen (H \ A) := hA.isOpen
  have hrpos := hx.pos
  have hxB : (x : ℂ) ∈ ball (x : ℂ) r := mem_ball_self hrpos
  have hyB : (y : ℂ) ∈ ball (y : ℂ) r := mem_ball_self hrpos
  have hdisj : Disjoint (ball (x : ℂ) r) (ball (y : ℂ) r) := by
    refine ball_disjoint_ball ?_
    rw [dist_eq_norm, ← ofReal_sub, Complex.norm_real, Real.norm_eq_abs, abs_sub_comm, abs_of_pos (by linarith)]
    linarith
  obtain ⟨f, Ω, hΩo, hfd, hDΩ, hxΩ, hyΩ, heD, hex, hey⟩ := exists_glued hA hg hx hy hdisj
  have hdx : deriv f x = deriv Gx x := deriv_eq_of_eqOn isOpen_ball hex hxB
  have hdy : deriv f y = deriv Gy y := deriv_eq_of_eqOn isOpen_ball hey hyB
  obtain ⟨-, hGx're⟩ := hx.deriv_im_eq_zero_and_re_pos hg
  obtain ⟨-, hGy're⟩ := hy.deriv_im_eq_zero_and_re_pos hg
  have hfxi : (f x).im = 0 := by rw [hex hxB]; exact hx.im_center
  have hfyi : (f y).im = 0 := by rw [hey hyB]; exact hy.im_center
  have hfxle : (f x).re ≤ x + M := by
    have h1 := hx.norm_sub_le hM
    have h2 : |(Gx x - x).re| ≤ ‖Gx x - x‖ := abs_re_le_norm _
    rw [hex hxB]; rw [sub_re, ofReal_re] at h2
    linarith [le_abs_self ((Gx x).re - x)]
  have hfyge : y - M ≤ (f y).re := by
    have h1 := hy.norm_sub_le hM
    have h2 : |(Gy y - y).re| ≤ ‖Gy y - y‖ := abs_re_le_norm _
    rw [hey hyB]; rw [sub_re, ofReal_re] at h2
    linarith [neg_abs_le ((Gy y).re - y)]
  have hxy' : (x : ℂ) ≠ y := fun h => by have := ofReal_injective h; linarith
  have hSxy : dslope f y x ∈ slitPlane := by
    rw [dslope_of_ne _ hxy', slope_def_field]
    refine div_mem_slitPlane_of_re_neg (by rw [sub_im, hfxi, hfyi, sub_zero]) (by simp)
      (by rw [sub_re]; linarith) (by simp; linarith)
  have hupper : ∀ a ∈ H \ A, 0 < (f a).im := fun a ha => by rw [heD ha]; exact hg.1.2.mapsTo ha
  -- injectivity and nonvanishing derivative on `P = (ℍ \ A) ∪ {x, y}`
  set P : Set ℂ := H \ A ∪ {(x : ℂ), (y : ℂ)} with hP
  have hPΩ : P ⊆ Ω := by
    rintro z (hz | hz | hz)
    · exact hDΩ hz
    · rw [hz]; exact hxΩ hxB
    · rw [mem_singleton_iff.1 hz]; exact hyΩ hyB
  have hreal : ∀ u ∈ ({(x : ℂ), (y : ℂ)} : Set ℂ), (f u).im = 0 := by
    rintro u (rfl | hu)
    · exact hfxi
    · rw [mem_singleton_iff.1 hu]; exact hfyi
  have hinj : ∀ a ∈ P, ∀ b ∈ P, a ≠ b → f a ≠ f b := by
    rintro a (ha | ha) b (hb | hb) hab heq
    · rw [heD ha, heD hb] at heq; exact hab (hg.1.2.injOn ha hb heq)
    · have := hupper a ha; rw [heq, hreal b hb] at this; exact lt_irrefl _ this
    · have := hupper b hb; rw [← heq, hreal a ha] at this; exact lt_irrefl _ this
    · rcases ha with rfl | ha <;> rcases hb with rfl | hb
      · exact hab rfl
      · rw [mem_singleton_iff.1 hb] at heq
        have := congrArg re heq; linarith
      · rw [mem_singleton_iff.1 ha] at heq
        have := congrArg re heq; linarith
      · exact hab ((mem_singleton_iff.1 ha).trans (mem_singleton_iff.1 hb).symm)
  have hder : ∀ a ∈ P, deriv f a ≠ 0 := by
    rintro a (ha | ha | ha)
    · rw [deriv_eq_of_eqOn hDo heD ha]
      exact QuantumZipper.CA.deriv_ne_zero_of_injOn hDo hg.1.1 hg.1.2.injOn ha
    · rw [ha, hdx]; intro h; rw [h, zero_re] at hGx're; exact lt_irrefl _ hGx're
    · rw [mem_singleton_iff.1 ha, hdy]; intro h; rw [h, zero_re] at hGy're; exact lt_irrefl _ hGy're
  -- the path from `y` to `x`
  have hvert : ∀ (u : ℝ) (G' : ℂ → ℂ), IsBdryReflection A g G' u r →
      ∀ s : ℝ, 0 < s → s ≤ r / 2 → (u : ℂ) + (s : ℂ) * I ∈ H \ A := fun u G' hu s hs hsr => by
    refine hu.subset ⟨?_, show 0 < ((u : ℂ) + (s : ℂ) * I).im by simp [hs]⟩
    rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_mul, norm_I, mul_one, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hs]
    linarith
  obtain ⟨γ, hγc, hγ0, hγ1, hγD⟩ := exists_path_of_vert hA.2.2.2.isPathConnected
    (hvert x Gx hx) (hvert y Gy hy) (half_pos hrpos)
  have hγP : ∀ t ∈ Icc (0 : ℝ) 1, γ t ∈ P := fun t ht => by
    rcases eq_endpoints_or_mem_Ioo_of_mem_Icc ht with rfl | rfl | ht'
    · rw [hγ0]; exact Or.inr (Or.inr rfl)
    · rw [hγ1]; exact Or.inr (Or.inl rfl)
    · exact Or.inl (hγD t ht')
  have hbot : ∀ t ∈ Icc (0 : ℝ) 1, dslope f (γ 0) (γ t) ∈ slitPlane := fun t ht => by
    rw [hγ0]
    rcases eq_endpoints_or_mem_Ioo_of_mem_Icc ht with rfl | rfl | ht'
    · rw [hγ0, dslope_same, hdy]; exact Or.inl hGy're
    · rw [hγ1]; exact hSxy
    · exact (dslope_mem_slitPlane (hγD t ht').1 (by simp) (hupper _ (hγD t ht')) hfyi).1
  have hright : ∀ s ∈ Icc (0 : ℝ) 1, dslope f (γ s) (γ 1) ∈ slitPlane := fun s hs => by
    rw [hγ1]
    rcases eq_endpoints_or_mem_Ioo_of_mem_Icc hs with rfl | rfl | hs'
    · rw [hγ0]; exact hSxy
    · rw [hγ1, dslope_same, hdx]; exact Or.inl hGx're
    · exact (dslope_mem_slitPlane (hγD s hs').1 (by simp) (hupper _ (hγD s hs')) hfxi).2
  have hlim0 := hny.comp (hγ0 ▸ tendsto_path_nhdsWithin_zero hγc fun t ht => (hγD t ht).1)
  have hlim1 := hnx.comp (hγ1 ▸ tendsto_path_nhdsWithin_one hγc fun t ht => (hγD t ht).1)
  have key := sub_eq_log_sub_log_of_path hΩo hfd hL.1.1.continuousOn
    (fun z hz => by rw [hL.1.2 z hz, deriv_eq_of_eqOn hDo heD hz]) hγc hγP hPΩ hγD hinj hder hbot hright
    hlim0 hlim1
  rw [hγ0, hγ1, hdx, hdy] at key
  have hpi : (2 * π * I : ℂ) ≠ 0 := by simp [Real.pi_ne_zero, I_ne_zero]
  have : ((nx : ℂ) - ny) * (2 * π * I) = 0 := by linear_combination key
  have h2 : (nx : ℂ) - ny = 0 := (mul_eq_zero.1 this).resolve_right hpi
  exact_mod_cast sub_eq_zero.1 h2

/-! ### Step 2: the integer is zero at a real point far to the right -/

/-- **Step 2.** At an untouched real point `y > R` (`A ⊆ B̄(0, R)`) the integer of
`IsCanonicalDerivLog.exists_int_tendsto` is `0`: apply the path lemma to the vertical segment from `y` to
`p = y + Ti`, `T = 8R + 4M + 1`, where `L(p) = Log g′(p)`; the secants `S(σ s, p)` lie in `B(1, 1/2)`. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.int_eq_zero_of_far
    (hA : IsHPHull A) (hL : IsCanonicalDerivLog A g L)
    (hg : IsMapOut A g) (hy : IsBdryReflection A g Gy y r) {R M : ℝ} (hR : 0 < R) (hAR : A ⊆ closedBall 0 R)
    (hyR : R < y) (hM0 : 0 < M) (hM : ∀ z ∈ H \ A, ‖g z - z‖ ≤ M) {ny : ℤ}
    (hny : Tendsto L (𝓝[H] (y : ℂ)) (𝓝 (log (deriv Gy y) + ny * (2 * π * I)))) : ny = 0 := by
  classical
  have hDo : IsOpen (H \ A) := hA.isOpen
  have hrpos := hy.pos
  have hyB : (y : ℂ) ∈ ball (y : ℂ) r := mem_ball_self hrpos
  obtain ⟨hfd, heD⟩ := differentiableOn_piecewise_ball (c := (y : ℂ)) (ρ := r) hDo hg.1.1 hy.diff
    fun z hz => (hy.eqOn ⟨hz.2, hz.1.1⟩).symm
  set f : ℂ → ℂ := fun z => if z ∈ ball (y : ℂ) r then Gy z else g z with hf
  have hey : EqOn f Gy (ball (y : ℂ) r) := fun z hz => by simp only [hf, hz, ↓reduceIte]
  have hΩo : IsOpen (H \ A ∪ ball (y : ℂ) r) := hDo.union isOpen_ball
  have hdy : deriv f y = deriv Gy y := deriv_eq_of_eqOn isOpen_ball hey hyB
  obtain ⟨-, hGy're⟩ := hy.deriv_im_eq_zero_and_re_pos hg
  have hfyi : (f y).im = 0 := by rw [hey hyB]; exact hy.im_center
  have hupper : ∀ a ∈ H \ A, 0 < (f a).im := fun a ha => by rw [heD ha]; exact hg.1.2.mapsTo ha
  -- the vertical segment
  set T : ℝ := 8 * R + 4 * M + 1 with hT
  have hTpos : 0 < T := by positivity
  set σ : ℝ → ℂ := fun t => (y : ℂ) + ((t * T : ℝ) : ℂ) * I with hσ
  have hσc : Continuous σ := by fun_prop
  have hσ0 : σ 0 = y := by simp [hσ]
  have hσim : ∀ t, (σ t).im = t * T := fun t => by simp [hσ]
  have hσD : ∀ t, 0 < t → σ t ∈ H \ A := fun t ht => by
    refine ⟨show 0 < (σ t).im by rw [hσim]; positivity, fun hA' => ?_⟩
    have h1 := mem_closedBall_zero_iff.1 (hAR hA')
    have h2 : |(σ t).re| ≤ ‖σ t‖ := abs_re_le_norm _
    have h3 : (σ t).re = y := by simp [hσ]
    rw [h3, abs_of_pos (hR.trans hyR)] at h2
    linarith
  set P : Set ℂ := H \ A ∪ {(y : ℂ)} with hP
  have hPΩ : P ⊆ H \ A ∪ ball (y : ℂ) r := by
    rintro z (hz | hz)
    · exact Or.inl hz
    · rw [mem_singleton_iff.1 hz]; exact Or.inr hyB
  have hσP : ∀ t ∈ Icc (0 : ℝ) 1, σ t ∈ P := fun t ht => by
    rcases ht.1.eq_or_lt with rfl | ht0
    · rw [hσ0]; exact Or.inr rfl
    · exact Or.inl (hσD t ht0)
  have hinj : ∀ a ∈ P, ∀ b ∈ P, a ≠ b → f a ≠ f b := by
    rintro a (ha | ha) b (hb | hb) hab heq
    · rw [heD ha, heD hb] at heq; exact hab (hg.1.2.injOn ha hb heq)
    · have := hupper a ha; rw [heq, mem_singleton_iff.1 hb, hfyi] at this; exact lt_irrefl _ this
    · have := hupper b hb; rw [← heq, mem_singleton_iff.1 ha, hfyi] at this; exact lt_irrefl _ this
    · exact hab ((mem_singleton_iff.1 ha).trans (mem_singleton_iff.1 hb).symm)
  have hder : ∀ a ∈ P, deriv f a ≠ 0 := by
    rintro a (ha | ha)
    · rw [deriv_eq_of_eqOn hDo heD ha]
      exact QuantumZipper.CA.deriv_ne_zero_of_injOn hDo hg.1.1 hg.1.2.injOn ha
    · rw [mem_singleton_iff.1 ha, hdy]; intro h; rw [h, zero_re] at hGy're; exact lt_irrefl _ hGy're
  have hbot : ∀ t ∈ Icc (0 : ℝ) 1, dslope f (σ 0) (σ t) ∈ slitPlane := fun t ht => by
    rw [hσ0]
    rcases ht.1.eq_or_lt with rfl | ht0
    · rw [hσ0, dslope_same, hdy]; exact Or.inl hGy're
    · exact (dslope_mem_slitPlane (hσD t ht0).1 (by simp) (hupper _ (hσD t ht0)) hfyi).1
  -- high up, `f = g` and `|g′ − 1| ≤ 1/4`
  set U : Set ℂ := {w : ℂ | 8 * R < w.im} with hU
  have hUD : U ⊆ H \ A := fun w hw => by
    have hw' : 8 * R < w.im := hw
    refine ⟨show 0 < w.im by linarith, fun h => ?_⟩
    have h1 := mem_closedBall_zero_iff.1 (hAR h)
    have h2 : w.im ≤ ‖w‖ := (le_abs_self _).trans (abs_im_le_norm w)
    linarith
  have hUo : IsOpen U := isOpen_lt continuous_const continuous_im
  have hUc : Convex ℝ U := convex_halfSpace_im_gt (8 * R)
  have hfU : DifferentiableOn ℂ f U := hfd.mono fun w hw => Or.inl (hUD hw)
  have hdU : ∀ u ∈ U, ‖deriv f u - 1‖ ≤ 1 / 4 := fun u hu => by
    rw [deriv_eq_of_eqOn hDo heD (hUD hu)]
    exact norm_deriv_sub_one_le_quarter_of_isMapOut hA hg hR hAR hu
  have hσ1U : σ 1 ∈ U := by show 8 * R < (σ 1).im; rw [hσim]; linarith
  have hright : ∀ s ∈ Icc (0 : ℝ) 1, dslope f (σ s) (σ 1) ∈ slitPlane := fun s hs => by
    refine mem_slitPlane_of_norm_sub_one_le ?_
    by_cases hfar : 4 * M ≤ (1 - s) * T
    · -- far from `p`: `|f − id| ≤ M` at both points
      have hs1 : s < 1 := by
        by_contra h; push Not at h
        have : (1 - s) * T ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (by linarith) hTpos.le
        linarith
      have hne : σ 1 ≠ σ s := fun h => by
        have := congrArg im h; rw [hσim, hσim] at this
        have : s * T = 1 * T := this.symm
        have := mul_right_cancel₀ hTpos.ne' this; linarith
      have hdist : ‖σ 1 - σ s‖ = (1 - s) * T := by
        have : σ 1 - σ s = (((1 - s) * T : ℝ) : ℂ) * I := by simp only [hσ]; push_cast; ring
        rw [this, norm_mul, norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg (by linarith) hTpos.le)]
      have hM1 : ‖f (σ 1) - σ 1‖ ≤ M := by rw [heD (hUD hσ1U)]; exact hM _ (hUD hσ1U)
      have hMs : ‖f (σ s) - σ s‖ ≤ M := by
        rcases hs.1.eq_or_lt with rfl | hs0
        · rw [hσ0, hey hyB]; exact hy.norm_sub_le hM
        · rw [heD (hσD s hs0)]; exact hM _ (hσD s hs0)
      have hpos : 0 < ‖σ 1 - σ s‖ := norm_pos_iff.2 (sub_ne_zero.2 hne)
      rw [dslope_of_ne _ hne, slope_def_field]
      have e : (f (σ 1) - f (σ s)) / (σ 1 - σ s) - 1 =
          ((f (σ 1) - σ 1) - (f (σ s) - σ s)) / (σ 1 - σ s) := by
        field_simp [sub_ne_zero.2 hne]
        ring
      rw [e, norm_div, div_le_iff₀ hpos]
      calc ‖(f (σ 1) - σ 1) - (f (σ s) - σ s)‖ ≤ ‖f (σ 1) - σ 1‖ + ‖f (σ s) - σ s‖ := norm_sub_le _ _
        _ ≤ M + M := add_le_add hM1 hMs
        _ ≤ 1 / 2 * ‖σ 1 - σ s‖ := by rw [hdist]; linarith
    · -- close to `p`: the segment is high up
      push Not at hfar
      have hsU : σ s ∈ U := by
        show 8 * R < (σ s).im
        rw [hσim]
        nlinarith
      exact le_trans (norm_dslope_sub_le hUo hUc hfU hdU hσ1U hsU) (by norm_num)
  have hσIoo : ∀ t ∈ Ioo (0 : ℝ) 1, σ t ∈ H \ A := fun t ht => hσD t ht.1
  have hlim0 := hny.comp (hσ0 ▸ tendsto_path_nhdsWithin_zero hσc fun t ht => (hσIoo t ht).1)
  have hp : σ 1 ∈ H \ A := hUD hσ1U
  have hlim1 : Tendsto (fun t => L (σ t)) (𝓝[<] (1 : ℝ)) (𝓝 (L (σ 1))) :=
    (((hL.1.1.continuousOn.continuousAt (hDo.mem_nhds hp)).tendsto.comp (hσc.tendsto 1))).mono_left
      nhdsWithin_le_nhds
  have key := sub_eq_log_sub_log_of_path hΩo hfd hL.1.1.continuousOn
    (fun z hz => by rw [hL.1.2 z hz, deriv_eq_of_eqOn hDo heD hz]) hσc hσP hPΩ hσIoo hinj hder hbot hright
    hlim0 hlim1
  rw [hσ0, hdy, deriv_eq_of_eqOn hDo heD hp, ← hL.eq_log hA hg hR hAR hσ1U] at key
  have hpi : (2 * π * I : ℂ) ≠ 0 := by simp [Real.pi_ne_zero, I_ne_zero]
  have : (ny : ℂ) * (2 * π * I) = 0 := by linear_combination -key
  exact_mod_cast (mul_eq_zero.1 this).resolve_right hpi

/-! ### Aux. 57 -/

/-- **Aux. lemma 57 (HP1).** At an untouched real point `x` (with Schwarz reflection `G` of `g` there), the canonical
logarithm of `g′` tends to the real number `log G′(x)` along `ℍ`: the derivative argument has lift zero. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.tendsto_log_deriv
    (hA : IsHPHull A) (hL : IsCanonicalDerivLog A g L) (hg : IsMapOut A g)
    (hG : IsBdryReflection A g G x r) : Tendsto L (𝓝[H] (x : ℂ)) (𝓝 (log (deriv G x))) := by
  obtain ⟨nx, hnx⟩ := hL.exists_int_tendsto hg hG
  obtain ⟨R, hR, hAR⟩ := hA.exists_subset_ball
  have hARc : A ⊆ closedBall 0 R := hAR.trans ball_subset_closedBall
  obtain ⟨M₀, hM₀⟩ := hg.exists_norm_sub_le hA
  set M := |M₀| + 1 with hMdef
  have hM0 : 0 < M := by positivity
  have hM : ∀ z ∈ H \ A, ‖g z - z‖ ≤ M := fun z hz => (hM₀ z hz).trans (by linarith [le_abs_self M₀])
  have hrpos := hG.pos
  set y : ℝ := |x| + R + 2 * M + 2 * r + 1 with hy
  have hyR : R < y := by have := abs_nonneg x; linarith
  have hxy : x + 2 * M < y := by have := le_abs_self x; linarith
  -- the reflection at `y`
  have hdy : Disjoint (ball (y : ℂ) (y - R)) A := by
    rw [Set.disjoint_left]
    intro w hw hwA
    have h1 := mem_ball_zero_iff.1 (hAR hwA)
    have h2 : dist w y < y - R := hw
    have h3 : ‖(y : ℂ)‖ ≤ ‖w‖ + dist w y := by
      rw [dist_eq_norm]
      calc ‖(y : ℂ)‖ = ‖w - (w - y)‖ := by ring_nf
        _ ≤ ‖w‖ + ‖w - y‖ := norm_sub_le _ _
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hR.trans hyR)] at h3
    linarith
  obtain ⟨Gy, hGy⟩ := exists_isBdryReflection hA hg (sub_pos.2 hyR) hdy
  set r' := min r ((y - R) / 2) with hr'
  have hr'pos : 0 < r' := lt_min hrpos (half_pos (sub_pos.2 hyR))
  have hx' := hG.mono hr'pos (min_le_left _ _)
  have hy' := hGy.mono hr'pos (min_le_right _ _)
  obtain ⟨ny, hny⟩ := hL.exists_int_tendsto hg hy'
  have hny0 := hL.int_eq_zero_of_far hA hg hy' hR hARc hyR hM0 hM hny
  have hxy' : 2 * r' ≤ y - x := by
    have := min_le_left r ((y - R) / 2); have := le_abs_self x; linarith
  have hnxy := hL.int_eq_of_two hA hg hx' hy' hM hxy hxy' hnx hny
  rw [hnxy, hny0] at hnx
  simpa using hnx

/-- **Aux. lemma 57 (HP1), argument form.** If a ball `B(x, ρ)` around a real point `x` avoids the hull `A`, the
imaginary part of the canonical logarithm of `g′` (the derivative argument normalized at `∞`) tends to `0` at `x`
along `ℍ`. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.tendsto_im_nhdsWithin_zero
    (hA : IsHPHull A) (hL : IsCanonicalDerivLog A g L)
    (hg : IsMapOut A g) {ρ : ℝ} (hρ : 0 < ρ) (hd : Disjoint (ball (x : ℂ) ρ) A) :
    Tendsto (fun z => (L z).im) (𝓝[H] (x : ℂ)) (𝓝 0) := by
  obtain ⟨G, hG⟩ := exists_isBdryReflection hA hg hρ hd
  have h := (continuous_im.tendsto _).comp (hL.tendsto_log_deriv hA hg hG)
  obtain ⟨him, hre⟩ := hG.deriv_im_eq_zero_and_re_pos hg
  have : (log (deriv G x)).im = 0 := by
    rw [log_im, arg_eq_zero_iff]; exact ⟨hre.le, him⟩
  rwa [this] at h

/-- **Aux. lemma 57 (HP1), value form**: at an untouched real point the canonical logarithm of `g′` tends to the real
logarithm of a positive number (the boundary derivative). -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.exists_tendsto_log
    (hA : IsHPHull A) (hL : IsCanonicalDerivLog A g L)
    (hg : IsMapOut A g) {ρ : ℝ} (hρ : 0 < ρ) (hd : Disjoint (ball (x : ℂ) ρ) A) :
    ∃ c : ℝ, 0 < c ∧ Tendsto L (𝓝[H] (x : ℂ)) (𝓝 (Real.log c : ℂ)) := by
  obtain ⟨G, hG⟩ := exists_isBdryReflection hA hg hρ hd
  obtain ⟨him, hre⟩ := hG.deriv_im_eq_zero_and_re_pos hg
  refine ⟨(deriv G x).re, hre, ?_⟩
  have e : deriv G x = ((deriv G x).re : ℂ) := Complex.ext (by simp) (by simp [him])
  have h := hL.tendsto_log_deriv hA hg hG
  rwa [e, ← ofReal_log hre.le] at h

/-! ### Chart transitions -/

/-- Canonical logarithms only see `g` on `ℍ \ A`. -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.congr {g₁ g₂ : ℂ → ℂ} (hA : IsHPHull A)
    (hL : IsCanonicalDerivLog A g₁ L) (he : EqOn g₁ g₂ (H \ A)) : IsCanonicalDerivLog A g₂ L := by
  obtain ⟨R, hR, hAR⟩ := hA.exists_subset_ball
  have hd : ∀ z ∈ H \ A, deriv g₁ z = deriv g₂ z := fun z hz => deriv_eq_of_eqOn hA.isOpen he hz
  obtain ⟨Y, hY⟩ := hL.2
  refine ⟨⟨hL.1.1, fun z hz => by rw [hL.1.2 z hz, hd z hz]⟩, max Y R, fun w hw => ?_⟩
  have hwY : Y < w.im := (le_max_left _ _).trans_lt hw
  have hwR : R < w.im := (le_max_right _ _).trans_lt hw
  have hwD : w ∈ H \ A := by
    refine ⟨show 0 < w.im by linarith, fun h => ?_⟩
    have h1 := mem_ball_zero_iff.1 (hAR h)
    have h2 : w.im ≤ ‖w‖ := (le_abs_self _).trans (abs_im_le_norm w)
    linarith
  rw [hY w hwY, hd w hwD]

/-- A complex number within `1/4` of `1` has argument in `(−π/2, π/2)`. -/
theorem abs_arg_lt_of_norm_sub_one_le {a : ℂ} (ha : ‖a - 1‖ ≤ 1 / 4) : |arg a| < π / 2 := by
  refine abs_arg_lt_pi_div_two_iff.2 (Or.inl ?_)
  have h1 : |(a - 1).re| ≤ ‖a - 1‖ := abs_re_le_norm _
  rw [sub_re, one_re] at h1
  linarith [neg_abs_le (a.re - 1)]

/-- **The chain rule for canonical logarithms** (the transition between the chart of `A` and that of `B ⊇ A`): with
`C = g_A(B \ A)`, the canonical logarithm of `(g_C ∘ g_A)′` on `ℍ \ B` is `L_C ∘ g_A + L_A` (both are logarithms of
the derivative; high up both summands are principal logarithms of numbers within `1/4` of `1`). -/
theorem _root_.InteractingSLE.Restart.IsCanonicalDerivLog.comp {B : Set ℂ} (hA : IsHPHull A) (hB : IsHPHull B)
    (hAB : A ⊆ B) (hg : IsMapOut A g) {gC LA LC : ℂ → ℂ} (hgC : IsMapOut (g '' (B \ A)) gC)
    (hLA : IsCanonicalDerivLog A g LA) (hLC : IsCanonicalDerivLog (g '' (B \ A)) gC LC) :
    IsCanonicalDerivLog B (gC ∘ g) (fun z => LC (g z) + LA z) := by
  set C := g '' (B \ A) with hCdef
  have hC : IsHPHull C := hg.isHPHull_image hA hB hAB
  have hHB : H \ B ⊆ H \ A := fun z hz => ⟨hz.1, fun h => hz.2 (hAB h)⟩
  have hmaps : MapsTo g (H \ B) (H \ C) := fun z hz => by
    rw [hg.H_diff_image hAB hB.1]; exact ⟨z, hz, rfl⟩
  refine ⟨IsDerivLog.comp hB.isOpen hC.isOpen hgC.1.1 (hg.1.1.mono hHB) hmaps hLC.1 (hLA.1.mono hHB), ?_⟩
  obtain ⟨RA, hRA, hAR⟩ := hA.exists_subset_ball
  obtain ⟨RB, hRB, hBR⟩ := hB.exists_subset_ball
  obtain ⟨RC, hRC, hCR⟩ := hC.exists_subset_ball
  obtain ⟨M, hM⟩ := hg.exists_norm_sub_le hA
  set R := RA + RB + RC with hR
  have hRpos : 0 < R := by positivity
  have hsub : ∀ {E : Set ℂ} {R' : ℝ}, E ⊆ ball 0 R' → R' ≤ R → E ⊆ closedBall 0 R := fun hE hR' =>
    hE.trans ((ball_subset_closedBall).trans (closedBall_subset_closedBall hR'))
  have hARc := hsub hAR (by linarith)
  have hBRc := hsub hBR (by linarith)
  have hCRc := hsub hCR (by linarith)
  refine ⟨8 * R + |M|, fun w hw => ?_⟩
  have hwR : 8 * R < w.im := lt_of_le_of_lt (le_add_of_nonneg_right (abs_nonneg M)) hw
  have hwB : w ∈ H \ B := by
    refine ⟨show 0 < w.im by linarith, fun h => ?_⟩
    have h1 := mem_closedBall_zero_iff.1 (hBRc h)
    have h2 : w.im ≤ ‖w‖ := (le_abs_self _).trans (abs_im_le_norm w)
    linarith
  have hwA := hHB hwB
  -- `Im g(w) ≥ Im w − M > 8R`
  have hgw : 8 * R < (g w).im := by
    have h1 := hM w hwA
    have h2 : |(g w - w).im| ≤ ‖g w - w‖ := abs_im_le_norm _
    rw [sub_im] at h2
    have := neg_abs_le ((g w).im - w.im)
    linarith [le_abs_self M]
  have hA1 := norm_deriv_sub_one_le_quarter_of_isMapOut hA hg hRpos hARc hwR
  have hC1 := norm_deriv_sub_one_le_quarter_of_isMapOut hC hgC hRpos hCRc hgw
  have hne : ∀ {a : ℂ}, ‖a - 1‖ ≤ 1 / 4 → a ≠ 0 := fun ha h => by
    rw [h, zero_sub, norm_neg, norm_one] at ha; norm_num at ha
  have hgwC : g w ∈ H \ C := hmaps hwB
  show LC (g w) + LA w = log (deriv (gC ∘ g) w)
  rw [hLC.eq_log hC hgC hRpos hCRc hgw, hLA.eq_log hA hg hRpos hARc hwR,
    deriv_comp w (hgC.1.1.differentiableAt (hC.isOpen.mem_nhds hgwC))
      (hg.1.1.differentiableAt (hA.isOpen.mem_nhds hwA)),
    Complex.log_mul (hne hC1) (hne hA1)]
  have h1 := abs_arg_lt_of_norm_sub_one_le hC1
  have h2 := abs_arg_lt_of_norm_sub_one_le hA1
  constructor
  · linarith [neg_abs_le (arg (deriv gC (g w))), neg_abs_le (arg (deriv g w))]
  · linarith [le_abs_self (arg (deriv gC (g w))), le_abs_self (arg (deriv g w))]

/-- **Aux. lemma 57 for chart transitions** (Lemma 7.8, p. 293: "Aux. lemma 57 fixes the argument lift … on the
transition from each ordinary single-prefix chart to the joint chart"). Let `A ⊆ B` be hulls with canonical
logarithms `L_A`, `L_B` (of any mapping-out functions), and `C = g_A(B \ A)`. At a point `q` near which `g_A` tends
to a real point `u` whose ball `B(u, ρ)` avoids `C` (the transition hull), the two lifts agree in the limit:
`Im L_B − Im L_A → 0` at `q` along `ℍ \ B`. -/
theorem tendsto_im_sub_canonDerivLog {B : Set ℂ} (hA : IsHPHull A) (hB : IsHPHull B) (hAB : A ⊆ B)
    (hg : IsMapOut A g) {gB LA LB : ℂ → ℂ} (hgB : IsMapOut B gB) (hLA : IsCanonicalDerivLog A g LA)
    (hLB : IsCanonicalDerivLog B gB LB) {q : ℂ} {u ρ : ℝ} (hρ : 0 < ρ)
    (hd : Disjoint (ball (u : ℂ) ρ) (g '' (B \ A))) (hq : Tendsto g (𝓝[H \ B] q) (𝓝[H] (u : ℂ))) :
    Tendsto (fun z => (LB z).im - (LA z).im) (𝓝[H \ B] q) (𝓝 0) := by
  set C := g '' (B \ A) with hCdef
  have hC : IsHPHull C := hg.isHPHull_image hA hB hAB
  set gC := ConformalImage.mapOut C with hgCdef
  have hgC : IsMapOut C gC := ConformalImage.isMapOut_mapOut hC
  obtain ⟨LC, hLC⟩ := exists_isCanonicalDerivLog hC hgC
  have hcomp := IsCanonicalDerivLog.comp hA hB hAB hg hgC hLA hLC
  have hgB' : IsMapOut B (gC ∘ g) := hg.comp hA hB hAB hgC
  have heq : EqOn LB (fun z => LC (g z) + LA z) (H \ B) :=
    IsCanonicalDerivLog.eqOn (hLB.congr hB (hgB.eqOn hB hgB')) hcomp hB hgB'
  have hlim := (IsCanonicalDerivLog.tendsto_im_nhdsWithin_zero hC hLC hgC hρ hd).comp hq
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with z hz
  simp only [Function.comp_apply, heq hz, add_im, add_sub_cancel_right]

end Sec7

end InteractingSLE
