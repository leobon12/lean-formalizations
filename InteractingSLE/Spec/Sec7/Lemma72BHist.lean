import InteractingSLE.Spec.Sec7.Lemma72
import InteractingSLE.Spec.Sec7.Lemma71HInputs

/-!
# Lemma 7.2, ingredient (ii): the pocket history is determined by the field

Packet PROVE-LEMMA72B. Specification §7.1, proof of Lemma 7.2 (`source/spec/p193-240.md` L626–L640, p. 227): "The
outer curves determine `C`, `ψ`, and its inherited argument branch […] The already proved non-boundary
field-determination theorem recovers `γ` from `h`".

PROVE-LEMMA72 reduced ingredient (ii) to a filtration condition (`Lemma72.isAEDeterminedBy_killedHistory_of_le`:
if every `𝓖_t` lies in `σ(h) ∨ 𝒩`, the killed driving history is a Borel function of `h`). On the three-curve space
the pocket filtration is generated by the two complete outer curves and the middle curve (Remark 6.7's filtration
`𝓕_t = σ(η(s) : s ≤ t, η_{θ₁}, η_{θ₂})`, mapped through the `σ(η_{θ₁}, η_{θ₂})`-measurable pocket chart). Each of
the three curves is, at every time, almost surely a Borel function of the field (`Lemma71G.IsLemma62Curve`, the
non-boundary field determination of §4.2). This file closes the step:

* `measurable_sup_nullSets_of_ae_eq`: a measurable variable almost surely equal to a Borel function of `H` is
  measurable for `σ(H) ∨ 𝒩`;
* `comap_le_sup_nullSets_of_forall_ae_eq`: a path-valued variable each of whose coordinates is almost surely a Borel
  function of `H` generates a σ-algebra inside `σ(H) ∨ 𝒩`;
* `IsLemma62Curve.comap_le_sup_nullSets`: the same for a curve with Lemma 6.2's hypotheses for the centred field
  `h − 𝔥₀` (a measurable function of `h`);
* **`isAEDeterminedBy_killedHistory_of_le_curves`**: if every `𝓖_t ⊆ σ(β) ∨ σ(α) ∨ σ(γ) ∨ 𝒩` for three such curves,
  the killed driving history of `(W, T)` is a Borel function of `(h, Q)` for every record `Q` — Lemma 7.2's
  ingredient (ii) in the form of `Lemma72.Lemma71JointStatement`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open LQGMetric (DistOn TestOn)
open scoped NNReal ENNReal

namespace InteractingSLE.Sec7.Lemma72B

open LawUnique

section Hist

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- **Up to null sets, a function of `H` is `σ(H) ∨ 𝒩`-measurable.** A measurable `Y` almost surely equal to `f ∘ H`
for a measurable `f` is measurable for `σ(H) ∨ 𝒩`: off a measurable null set `N` its preimages are those of `f ∘ H`,
and on `N` they are null sets. -/
theorem measurable_sup_nullSets_of_ae_eq {γ β : Type*} [mγ : MeasurableSpace γ] [MeasurableSpace β] {H : Ω → γ}
    {Y : Ω → β} (hY : Measurable Y) {f : γ → β} (hf : Measurable f)
    (he : Y =ᵐ[P] fun ω => f (H ω)) : Measurable[MeasurableSpace.comap H mγ ⊔ Ito.nullSets P] Y := by
  intro s hs
  set N : Set Ω := toMeasurable P {ω | Y ω ≠ f (H ω)} with hN
  have hNm : MeasurableSet N := measurableSet_toMeasurable _ _
  have hN0 : P N = 0 := by rw [hN, measure_toMeasurable]; exact he
  have hsub : {ω | Y ω ≠ f (H ω)} ⊆ N := subset_toMeasurable _ _
  have hnull : ∀ t : Set Ω, MeasurableSet t → t ⊆ N → MeasurableSet[Ito.nullSets P] t := fun t ht htN =>
    MeasurableSpace.measurableSet_generateFrom ⟨ht, measure_mono_null htN hN0⟩
  have hNn : MeasurableSet[Ito.nullSets P] N := hnull N hNm le_rfl
  have hH' : MeasurableSet[MeasurableSpace.comap H mγ] ((fun ω => f (H ω)) ⁻¹' s) :=
    ⟨f ⁻¹' s, hf hs, rfl⟩
  have e : Y ⁻¹' s = ((fun ω => f (H ω)) ⁻¹' s ∩ Nᶜ) ∪ (Y ⁻¹' s ∩ N) := by
    ext ω
    by_cases hω : ω ∈ N
    · simp only [mem_preimage, mem_union, mem_inter_iff, mem_compl_iff, hω, not_true_eq_false, and_false,
        and_true, false_or]
    · have hYω : Y ω = f (H ω) := by
        by_contra hne
        exact hω (hsub hne)
      simp only [mem_preimage, mem_union, mem_inter_iff, mem_compl_iff, hω, not_false_eq_true, and_true,
        and_false, or_false, hYω]
  rw [e]
  refine MeasurableSet.union (MeasurableSet.inter ?_ ?_) ?_
  · exact (le_sup_left : MeasurableSpace.comap H mγ ≤ _) _ hH'
  · exact (le_sup_right : Ito.nullSets P ≤ _) _ hNn.compl
  · exact (le_sup_right : Ito.nullSets P ≤ _) _ (hnull _ ((hY hs).inter hNm) inter_subset_right)

/-- **A path whose coordinates are field-determined generates a σ-algebra inside `σ(H) ∨ 𝒩`.** If every coordinate
`η(t)` is measurable and almost surely a Borel function of `H`, then `σ(η) ≤ σ(H) ∨ 𝒩` (for the product σ-algebra on
paths). -/
theorem comap_le_sup_nullSets_of_forall_ae_eq {γ ι E : Type*} [mγ : MeasurableSpace γ] [MeasurableSpace E]
    {H : Ω → γ} {η : Ω → ι → E} (hηm : ∀ t, Measurable fun ω => η ω t)
    (hdet : ∀ t, ∃ f : γ → E, Measurable f ∧ (fun ω => η ω t) =ᵐ[P] fun ω => f (H ω)) :
    MeasurableSpace.comap η MeasurableSpace.pi ≤ MeasurableSpace.comap H mγ ⊔ Ito.nullSets P := by
  refine Measurable.comap_le ?_
  refine @measurable_pi_iff Ω ι (fun _ => E) (MeasurableSpace.comap H mγ ⊔ Ito.nullSets P) _ η |>.2 fun t => ?_
  obtain ⟨f, hf, he⟩ := hdet t
  exact measurable_sup_nullSets_of_ae_eq (hηm t) hf he

/-- **A Lemma 6.2 curve of the centred field is field-determined up to null sets**: for a curve with Lemma 6.2's
hypotheses for `h − 𝔥₀` (`𝔥₀` deterministic), `σ(η) ≤ σ(h) ∨ 𝒩`. -/
theorem _root_.InteractingSLE.Sec7.Lemma71G.IsLemma62Curve.comap_le_sup_nullSets {η : Ω → ℝ≥0 → ℂ}
    {h : Ω → DistOn upperHalfPlaneOpens} {u₀ : ℂ → ℝ}
    (hη : Lemma71G.IsLemma62Curve η (WholeField.centredField h u₀) P) :
    MeasurableSpace.comap η MeasurableSpace.pi ≤ MeasurableSpace.comap h inferInstance ⊔ Ito.nullSets P := by
  obtain ⟨-, -, -, hηm, hdet, -, -⟩ := hη
  refine comap_le_sup_nullSets_of_forall_ae_eq hηm fun t => ?_
  obtain ⟨f, hf, he⟩ := hdet t
  exact ⟨fun T => f (T - SupercriticalConformalCovariance.GM24.smoothDist upperHalfPlaneOpens u₀),
    hf.comp (WholeField.measurable_sub_dist _), he⟩

/-- **Lemma 7.2's ingredient (ii) on the three-curve space** (p. 227). Let `β`, `α`, `γ` be three curves with Lemma
6.2's hypotheses for the centred field `h − 𝔥₀`, and let the filtration `𝓖` of the pocket coupling be generated by
them up to null sets (`𝓖_t ⊆ σ(β) ∨ σ(α) ∨ σ(γ) ∨ 𝒩`). If the driver `W` is adapted and continuous before `T`, the
killed driving history of `W` with its geometric force points is almost surely a Borel function of `(h, Q)`, for every
record `Q`. -/
theorem isAEDeterminedBy_killedHistory_of_le_curves [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens}
    (hh : Measurable h) {u₀ : ℂ → ℝ} {β α γ : Ω → ℝ≥0 → ℂ}
    (hβ : Lemma71G.IsLemma62Curve β (WholeField.centredField h u₀) P)
    (hα : Lemma71G.IsLemma62Curve α (WholeField.centredField h u₀) P)
    (hγ : Lemma71G.IsLemma62Curve γ (WholeField.centredField h u₀) P)
    {𝓖 : Filtration ℝ≥0 mΩ}
    (hle : ∀ t, 𝓖 t ≤ MeasurableSpace.comap β MeasurableSpace.pi ⊔ MeasurableSpace.comap α MeasurableSpace.pi ⊔
      MeasurableSpace.comap γ MeasurableSpace.pi ⊔ Ito.nullSets P)
    {W : ℝ≥0 → Ω → ℝ} {T : Ω → ℝ≥0∞} (hWa : AdaptedBefore 𝓖 T W)
    (hc : ∀ ω, ContinuousOn (fun t => W t ω) {t : ℝ≥0 | (t : ℝ≥0∞) < T ω})
    {δ : Type*} [MeasurableSpace δ] (Q : Ω → δ) :
    Sec7.IsAEDeterminedBy P (fun ω => (h ω, Q ω))
      (killedHistory W (MartChar.geomL W LP.twoSeedXL) (MartChar.geomR W LP.twoSeedXR) T) := by
  have hB := hβ.comap_le_sup_nullSets
  have hA := hα.comap_le_sup_nullSets
  have hG := hγ.comap_le_sup_nullSets
  have hle' : ∀ t, 𝓖 t ≤ MeasurableSpace.comap h inferInstance ⊔ Ito.nullSets P := fun t =>
    (hle t).trans (sup_le (sup_le (sup_le hB hA) hG) le_sup_right)
  exact Lemma72.isAEDeterminedBy_prod_of_isAEDeterminedBy
    (Lemma72.isAEDeterminedBy_killedHistory_of_le hh hle' hWa hc)

end Hist

end InteractingSLE.Sec7.Lemma72B
