/-- **`Lemma72.Lemma71JointStatement` from Lemma 7.1 on the three-curve space.** The three-curve space
(`exists_isThreeCurveSpace`, with `a, b` the least values allowed by Proposition 5.5), the pocket data with (L) and
(iii) on it (`PocketJointStatement`), the exterior record `Q = ((β, α), h|_{ℍ ∖ C̄})` (lifted to the universe of the
space); ingredient (i) is `isAEDeterminedBy_field_of_pocket`, ingredient (ii) is
`isAEDeterminedBy_killedHistory_of_le_curves`. Conditional helper. -/
theorem lemma71JointStatement_of_pocketJoint (href : Lemma71H.Cond44ReferenceStatement.{u})
    (h55 : Lemma71H.Prop55HalfPlaneStatement.{u}) (hMD : Lemma71I.Lemma613ContactStatement.{u})
    (hPJ : PocketJointStatement.{u}) : Lemma72.Lemma71JointStatement.{u} := by
  intro κ hκ hκ4 θ₁ θ₂ hθ₁ hθ₂
  obtain ⟨Ω, mΩ, P, hP, h, u₀, β, α, γ, ζβ, ζα, ζγ, h3⟩ :=
    exists_isThreeCurveSpace href h55 hMD hκ hκ4 hθ₁ hθ₂ le_rfl le_rfl
  obtain ⟨𝓖, γ', W, T, c, a', k, hψ, hpd, ht, hloc, hind⟩ :=
    hPJ κ hκ hκ4 θ₁ θ₂ _ _ hθ₁ hθ₂ le_rfl le_rfl P h u₀ β α γ ζβ ζα ζγ h3
  obtain ⟨-, -, -, hβf, hαf, hγf, hβ, hα, hγ, hae⟩ := h3
  obtain ⟨h𝓖, hnull, hγ', hW0, hc, hWa, hK, hh, hcc, hdom, hfwd, hliftm, hliftc, hcf, hCm', hfwd', hliftm', hfr,
    hle⟩ := hpd
  have hsp : ∀ᵐ ω ∂P, ζβ ω = ⊤ ∧ ζα ω = ⊤ ∧ Lemma71I.IsSimpleProper (β ω) ∧ Lemma71I.IsSimpleProper (α ω) :=
    hae.mono fun ω hω => ⟨hω.1, hω.2.1, hω.2.2.2.2.2.2.2.1, hω.2.2.2.2.2.2.2.2.1⟩
  have hrec := isAEDeterminedBy_field_of_pocket hκ (by linarith) hh hβf hαf hγf hβ.2.2.2.1 hα.2.2.2.1 hsp hcc hCm'
    hfwd' hliftm' hliftc hfr ht
  set Q := pocketRecord β α (fun ω => ((c ω).dom : Set ℂ)) h with hQdef
  have hQm : Measurable Q := by
    have hβα : Measurable fun ω => (β ω, α ω) :=
      (measurable_pi_iff.2 hβ.2.2.2.1).prodMk (measurable_pi_iff.2 hα.2.2.2.1)
    have hmem0 := @Lemma71E.measurableSet_mem_of_closedBall Ω
      (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance) (fun ω => ((c ω).dom : Set ℂ))
      (fun ω => (c ω).dom.isOpen) hCm'
    refine measurable_pocketRecord hβ.2.2.2.1 hα.2.2.2.1 hh fun φ => hβα.comap_le _ ?_
    exact @measurableSet_disjoint_closure_of_mem Ω (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance)
      (fun ω => ((c ω).dom : Set ℂ)) (fun ω => (c ω).dom.isOpen) hmem0 _ φ.hasCompactSupport
  refine ⟨Ω, mΩ, P, hP, 𝓖, h𝓖, γ', W, T, h, hψ, c, a', k,
    ULift.{u} (((ℝ≥0 → ℂ) × (ℝ≥0 → ℂ)) × (TestOn upperHalfPlaneOpens → ℝ)), inferInstance,
    fun ω => ULift.up (Q ω), hnull, hγ', hW0, hc, hWa, hK, hh, hcc, hdom, hfwd, hliftm, hliftc, hcf, ht, hloc,
    measurable_up.comp hQm, ?_, ?_, ?_⟩
  · obtain ⟨g, hg, hhg⟩ := hrec
    exact ⟨fun p => g (ULift.down p.1, p.2), hg.comp (measurable_down.comp measurable_fst |>.prodMk measurable_snd),
      hhg⟩
  · exact isAEDeterminedBy_killedHistory_of_le_curves hh hβ hα hγ hle hWa hc _
  · exact hind.comp measurable_id measurable_up

