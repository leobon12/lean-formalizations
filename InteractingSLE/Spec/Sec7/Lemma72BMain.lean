/-! ### The three-curve space -/

/-- **The three-curve space of §7.1** (the conclusion of `Lemma71I.exists_threeCurveSpace_planar`): a GFF `h` on `ℍ`
with the boundary data of Figure 7.1, its bounded harmonic extension `u₀`, and its flow lines `β = η_{θ₂}`,
`α = η_{θ₁}`, `γ = η_0` from `0`, each with Lemma 6.2's hypotheses for the centred field; almost surely they have
infinite lifetimes, avoid `ℝ ∖ {0}`, are simple proper arcs in the closed-side order `β ≤ γ ≤ α`, are ordered arcs in
WangWu's sense, and the middle curve shares no arc with either outer curve. -/
def IsThreeCurveSpace (κ θ₁ θ₂ a b : ℝ) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (h : Ω → DistOn upperHalfPlaneOpens) (u₀ : ℂ → ℝ) (β α γ : Ω → ℝ≥0 → ℂ) (ζβ ζα ζγ : Ω → ℝ≥0∞) : Prop :=
  IsGFFWithBoundaryData P h (prop74Data a b) ((({0} : Finset ℝ)) : Set ℝ) ∧
    IsBoundedHarmonicExtension (prop74Data a b) ((({0} : Finset ℝ)) : Set ℝ) u₀ ∧
    LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens (WholeField.centredField h u₀) P ∧
    IsFlowLine κ (prop74Data a b) {0} 0 θ₂ P h β ζβ ∧ IsFlowLine κ (prop74Data a b) {0} 0 θ₁ P h α ζα ∧
    IsFlowLine κ (prop74Data a b) {0} 0 0 P h γ ζγ ∧
    Lemma71G.IsLemma62Curve β (WholeField.centredField h u₀) P ∧
    Lemma71G.IsLemma62Curve α (WholeField.centredField h u₀) P ∧
    Lemma71G.IsLemma62Curve γ (WholeField.centredField h u₀) P ∧
    ∀ᵐ ω ∂P, ζβ ω = ⊤ ∧ ζα ω = ⊤ ∧ ζγ ω = ⊤ ∧
      (∀ i (t : ℝ≥0) (x : ℝ), x ≠ 0 → Sec6.Three.threeCurves β α γ i ω t ≠ x) ∧
      range (β ω) ⊆ closedLeftSide (γ ω) ∧ range (γ ω) ⊆ closedLeftSide (α ω) ∧
      range (β ω) ⊆ closedLeftSide (α ω) ∧
      Lemma71I.IsSimpleProper (β ω) ∧ Lemma71I.IsSimpleProper (α ω) ∧ Lemma71I.IsSimpleProper (γ ω) ∧
      WangWu.IsOrderedArcs (Lemma71I.realPath (α ω)) (Lemma71I.realPath (γ ω)) (Lemma71I.realPath (β ω)) ∧
      Lemma71I.NoCommonArc (γ ω) (α ω) ∧ Lemma71I.NoCommonArc (γ ω) (β ω)

/-- **The three-curve space exists** (`Lemma71I.exists_threeCurveSpace_planar`, with Aux. lemma 56 at first entrance
times proved: `WholeField.retainedRangeEntranceStatement`). Named inputs: the §4.2 reference, Proposition 5.5 in `ℍ`
and Lemma 6.13's (MD1) exclusion (none of them uses Lemma 7.1). -/
theorem exists_isThreeCurveSpace (href : Lemma71H.Cond44ReferenceStatement.{u})
    (h55 : Lemma71H.Prop55HalfPlaneStatement.{u}) (hMD : Lemma71I.Lemma613ContactStatement.{u})
    {κ : ℝ} (hκ : 0 < κ) (hκ4 : κ < 4) {θ₁ θ₂ a b : ℝ} (hθ₁ : θ₁ < 0) (hθ₂ : 0 < θ₂)
    (ha : sleLambda κ - π * chiC κ + θ₂ * chiC κ ≤ a) (hb : sleLambda κ - θ₁ * chiC κ ≤ b) :
    ∃ (Ω : Type u) (_ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (h : Ω → DistOn upperHalfPlaneOpens) (u₀ : ℂ → ℝ) (β α γ : Ω → ℝ≥0 → ℂ) (ζβ ζα ζγ : Ω → ℝ≥0∞),
      IsThreeCurveSpace κ θ₁ θ₂ a b P h u₀ β α γ ζβ ζα ζγ :=
  Lemma71I.exists_threeCurveSpace_planar href WholeField.retainedRangeEntranceStatement h55 hMD hκ hκ4 hθ₁ hθ₂
    ha hb

/-! ### The exterior record `Q = (A, h')` -/

section Record

variable {Ω : Type*}

/-- **The field off the closed pocket**, as a function of the test: `h φ` for tests supported off `C̄`, `0` for the
others. -/
def outField (C : Ω → Set ℂ) (h : Ω → DistOn upperHalfPlaneOpens) (ω : Ω) : TestOn upperHalfPlaneOpens → ℝ :=
  open Classical in fun φ => if Disjoint (tsupport φ) (closure (C ω)) then h ω φ else 0

/-- **The exterior record** `Q = (A, h')` of Lemma 7.2's proof: the two complete outer curves and the field off the
closed pocket. -/
def pocketRecord (β α : Ω → ℝ≥0 → ℂ) (C : Ω → Set ℂ) (h : Ω → DistOn upperHalfPlaneOpens) (ω : Ω) :
    ((ℝ≥0 → ℂ) × (ℝ≥0 → ℂ)) × (TestOn upperHalfPlaneOpens → ℝ) :=
  ((β ω, α ω), outField C h ω)

theorem outField_of_disjoint {C : Ω → Set ℂ} (h : Ω → DistOn upperHalfPlaneOpens) {ω : Ω}
    {φ : TestOn upperHalfPlaneOpens} (hφ : Disjoint (tsupport φ) (closure (C ω))) : outField C h ω φ = h ω φ := by
  classical
  simp only [outField, hφ, ↓reduceIte]

theorem outField_eq_indicator (C : Ω → Set ℂ) (h : Ω → DistOn upperHalfPlaneOpens) (φ : TestOn upperHalfPlaneOpens) :
    (fun ω => outField C h ω φ) = {ω | Disjoint (tsupport φ) (closure (C ω))}.indicator fun ω => h ω φ := by
  classical
  funext ω
  by_cases hω : Disjoint (tsupport φ) (closure (C ω))
  · rw [outField_of_disjoint h hω, indicator_of_mem (show ω ∈ {ω | Disjoint (tsupport φ) (closure (C ω))} from hω)]
  · rw [indicator_of_notMem (show ω ∉ {ω | Disjoint (tsupport φ) (closure (C ω))} from hω)]
    simp only [outField, hω, ↓reduceIte]

/-- The exterior record is measurable when the curves are pointwise measurable, the field is measurable and the
events `{supp φ ∩ C̄ = ∅}` are measurable. -/
theorem measurable_pocketRecord [MeasurableSpace Ω] {β α : Ω → ℝ≥0 → ℂ} (hβ : ∀ t, Measurable fun ω => β ω t)
    (hα : ∀ t, Measurable fun ω => α ω t) {C : Ω → Set ℂ} {h : Ω → DistOn upperHalfPlaneOpens} (hh : Measurable h)
    (hS : ∀ φ : TestOn upperHalfPlaneOpens, MeasurableSet {ω | Disjoint (tsupport φ) (closure (C ω))}) :
    Measurable (pocketRecord β α C h) := by
  refine ((measurable_pi_iff.2 hβ).prodMk (measurable_pi_iff.2 hα)).prodMk (measurable_pi_iff.2 fun φ => ?_)
  change Measurable fun ω => outField C h ω φ
  rw [outField_eq_indicator]
  exact ((LQGMetric.measurable_distOn_apply φ).comp hh).indicator (hS φ)

end Record

/-! ### The pocket data and the named input -/

/-- **The pocket construction of Lemma 7.1 on a given space**, in chart form (specification p. 222; the form of
`Lemma71C.Lemma71PocketChartStatement`, whose clauses are copied verbatim, with the mapped middle-curve segment `γ'`),
together with the structure Lemma 7.2's proof uses:
* the chart is a function of the two complete outer curves `(β, α)` ("The outer curves determine `C`, `ψ`, and its
  inherited argument branch", p. 226): closed-ball events of the domain, masked forward maps and lifts are
  `σ(β, α)`-measurable;
* the pocket boundary lies on the outer curves: `∂C ∩ ℍ ⊆ β ∪ α` almost surely;
* the filtration is generated by the three curves up to null sets (the outer curves and the middle prefix, Remark 6.7's
  filtration `σ(η(s) : s ≤ t, η_{θ₁}, η_{θ₂})`, mapped through the chart): `𝓖_t ⊆ σ(β) ∨ σ(α) ∨ σ(γ) ∨ 𝒩`. -/
def IsPocketChartData (κ θ₁ θ₂ : ℝ) {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (β α γ : Ω → ℝ≥0 → ℂ) (h : Ω → DistOn upperHalfPlaneOpens) (𝓖 : Filtration ℝ≥0 mΩ) (γ' : Ω → ℝ → ℂ)
    (W : ℝ≥0 → Ω → ℝ) (T : Ω → ℝ≥0∞) (c : Ω → Chart) (a k : ℝ) : Prop :=
  𝓖.IsRightContinuous ∧
    (∀ s, MeasurableSet s → P s = 0 → MeasurableSet[𝓖 0] s) ∧
    (∀ᵐ ω ∂P, ContinuousOn (γ' ω) (Ici 0) ∧ InjOn (γ' ω) (Ici 0) ∧ MapsTo (γ' ω) (Ici 0) Hbar ∧
      γ' ω 0 = 0 ∧ Tendsto (fun t => ‖γ' ω t‖) atTop atTop ∧
      interior {u ∈ Ici (0 : ℝ) | 0 < u ∧ (γ' ω u).im = 0} = ∅) ∧
    (∀ ω, W 0 ω = 0) ∧ (∀ ω, ContinuousOn (fun t => W t ω) {t : ℝ≥0 | (t : ℝ≥0∞) < T ω}) ∧
    AdaptedBefore 𝓖 T W ∧
    (∀ᵐ ω ∂P, ∀ t, 0 ≤ t → ∃ s : ℝ≥0, (s : ℝ≥0∞) < T ω ∧
      fwdHull (fun s : ℝ => W s.toNNReal ω) s = fillH (γ' ω '' Icc 0 t)) ∧
    Measurable h ∧ (∀ ω, (c ω).IsConformal) ∧
    (∀ z, MeasurableSet[𝓖 0] {ω | z ∈ (c ω).dom}) ∧
    (∀ z, Measurable[𝓖 0] ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z)) ∧
    (∀ z, Measurable[𝓖 0] ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).2.2 z)) ∧
    (∀ ω, ContinuousOn (c ω).2.2 (c ω).dom) ∧
    Coupling.MartMeans2.IsChartCouplingCharFun κ (fun _ : Fin 1 => cpf2RhoL κ θ₂)
      (fun _ : Fin 1 => cpf2RhoR κ θ₁) P 𝓖 W (MartChar.geomL W LP.twoSeedXL) (MartChar.geomR W LP.twoSeedXR)
      T c a k h ∧
    (∀ (z : ℂ) (r : ℝ), MeasurableSet[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      {ω | Metric.closedBall z r ⊆ (c ω).dom}) ∧
    (∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z)) ∧
    (∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).2.2 z)) ∧
    (∀ᵐ ω ∂P, frontier ((c ω).dom : Set ℂ) ∩ H ⊆ range (β ω) ∪ range (α ω)) ∧
    ∀ t, 𝓖 t ≤ MeasurableSpace.comap β MeasurableSpace.pi ⊔ MeasurableSpace.comap α MeasurableSpace.pi ⊔
      MeasurableSpace.comap γ MeasurableSpace.pi ⊔ Ito.nullSets P

/-- **Named input: Lemma 7.1 on the three-curve space** (specification §7.1, pp. 221–226). For `0 < κ < 4`,
`θ₁ < 0 < θ₂` and boundary values `a, b` large enough for Proposition 5.5, on **every** three-curve space there are
* the pocket construction (`IsPocketChartData`: the chart-form coupling of the mapped middle-curve segment in a pocket
  `C` between the outer curves, with the chart a function of the outer curves) — PROVE-LEMMA71J's
  `Lemma71PocketPinStatement`, on the given space;
* the pulled-back field `h_ψ = h ∘ ψ⁻¹ − χ arg (ψ⁻¹)′` (`IsChartTransport`, `σ = 1`);
* **(L)** the locality of the mapped hulls `K_τ` for `h_ψ` at the stopping times `τ < T` of the pocket filtration
  (p. 224–225: "the history-locality statement of Lemma 6.2 applies to the revealed outer curves and the middle
  prefix […] the optional history marking of the original coupling supplies the required history locality");
* **(iii)** the independence of `(killed history, h_ψ)` from the exterior record `Q = ((β, α), h|_{ℍ ∖ C̄})`
  (pp. 225–227: the component-pair factorization, Aux. lemma 46, "In particular, its full joint law is independent of
  the two outer curves"; "The component-pair factorization in the preceding proof says that `(η_ψ, h_ψ)` is
  independent of `Q`"). -/
def PocketJointStatement : Prop :=
  ∀ κ : ℝ, 0 < κ → κ < 4 → ∀ θ₁ θ₂ a b : ℝ, θ₁ < 0 → 0 < θ₂ →
    sleLambda κ - π * chiC κ + θ₂ * chiC κ ≤ a → sleLambda κ - θ₁ * chiC κ ≤ b →
    ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (h : Ω → DistOn upperHalfPlaneOpens) (u₀ : ℂ → ℝ) (β α γ : Ω → ℝ≥0 → ℂ) (ζβ ζα ζγ : Ω → ℝ≥0∞),
      IsThreeCurveSpace κ θ₁ θ₂ a b P h u₀ β α γ ζβ ζα ζγ →
    ∃ (𝓖 : Filtration ℝ≥0 mΩ) (γ' : Ω → ℝ → ℂ) (W : ℝ≥0 → Ω → ℝ) (T : Ω → ℝ≥0∞) (c : Ω → Chart) (a' k : ℝ)
      (hψ : Ω → DistOn upperHalfPlaneOpens),
      IsPocketChartData κ θ₁ θ₂ P β α γ h 𝓖 γ' W T c a' k ∧
      (∀ ω, IsChartTransport (c ω) 1 a' k (h ω) (hψ ω)) ∧
      (∀ τ : Ω → WithTop ℝ≥0, IsStoppingTime 𝓖 τ → (∀ᵐ ω ∂P, (τ ω : ℝ≥0∞) < T ω) →
        IsLocalSet (fun ω => fwdHull (fun s : ℝ => W s.toNNReal ω) ((τ ω).untopD 0 : ℝ≥0)) hψ P) ∧
      IndepFun (fun ω => (killedHistory W (MartChar.geomL W LP.twoSeedXL) (MartChar.geomR W LP.twoSeedXR) T ω,
        hψ ω)) (pocketRecord β α (fun ω => ((c ω).dom : Set ℂ)) h) P

/-! ### Ingredient (i) on the three-curve space -/

section Field

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- **(SR1) and integrability for the field** from the zero-angle flow line (`h' = h` when `x = θ = 0`). -/
theorem sr1_of_isFlowLine_zero {κ : ℝ} {b : ℝ → ℝ} {J : Finset ℝ} {h : Ω → DistOn upperHalfPlaneOpens}
    {γ : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞} (hfl : IsFlowLine κ b J 0 0 P h γ ζ) :
    (∀ φ : TestOn upperHalfPlaneOpens, Integrable (fun ω => h ω φ) P) ∧
      ∀ {ε : ℝ}, 0 < ε → ∀ ζc : TestOn upperHalfPlaneOpens, ∫⁻ ω, Sobolev.negSobolevSq ε (h ω) ζc ∂P < ⊤ := by
  obtain ⟨h', 𝓕, W, VL, VR, B, ht, hcpl, -⟩ := hfl
  have e : h' = h := funext fun ω => by
    have := ht ω
    rw [zero_mul] at this
    exact Sec5.Markov.eq_of_isTranslateAddConst_zero this
  subst e
  exact ⟨fun φ => hcpl.integrable_apply φ, fun hε ζc => hcpl.lintegral_negSobolevSq_lt_top hε ζc⟩

/-- **The outer-curve dimension bound** (Aux. lemma 15, (SR3)): for a flow line from `0` with infinite lifetime
almost surely, `dim_H (range η ∩ K) < 2 − 2ε` for every `K ⊆ ℍ`, almost surely, when `0 < κ < 8` and
`ε < (1 − κ/8)/4`. -/
theorem ae_dimH_range_inter_lt {κ ε θ : ℝ} (hκ : 0 < κ) (hκ8 : κ < 8)
    (hε : ε < Dimension.onePointExponent κ / 4) {b : ℝ → ℝ} {J : Finset ℝ} {h : Ω → DistOn upperHalfPlaneOpens}
    {η : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞} (hfl : IsFlowLine κ b J 0 θ P h η ζ) (hζ : ∀ᵐ ω ∂P, ζ ω = ⊤) :
    ∀ᵐ ω ∂P, ∀ K : Set ℂ, K ⊆ H → dimH (range (η ω) ∩ K) < ENNReal.ofReal (2 - 2 * ε) := by
  obtain ⟨𝓕, W, VL, VR, B, hev, htr⟩ := Lemma71G.IsFlowLine.exists_evolution_angle hfl
  filter_upwards [hev.ae_dimH_image_inter_lt hκ hκ8 hε, htr, hζ] with ω hd ht hz K hK
  have := hd (η ω) ht univ (fun t _ => by rw [mem_ofPred_eq, hz]; exact le_top) K hK
  rwa [image_univ] at this

/-- **Lemma 7.2's ingredient (i) on the three-curve space** (pp. 226–227): the field is almost surely a Borel function
of the exterior record `Q = ((β, α), h|_{ℍ ∖ C̄})` and the pulled-back field `h_ψ`. Thin-support removal on
`∂C ⊆ β ∪ α`: the outer curves have dimension `< 2` on compacts of `ℍ` (Aux. lemma 15) and closed ranges, the field
satisfies (SR1); inside the pocket `h` is recorded by `h_ψ` through the chart (a function of `(β, α)`), off `C̄` by
`Q`. -/
theorem isAEDeterminedBy_field_of_pocket {κ θ₁ θ₂ : ℝ} (hκ : 0 < κ) (hκ8 : κ < 8) {b : ℝ → ℝ} {J : Finset ℝ}
    {h : Ω → DistOn upperHalfPlaneOpens} (hh : Measurable h) {β α γ : Ω → ℝ≥0 → ℂ} {ζβ ζα ζγ : Ω → ℝ≥0∞}
    (hβf : IsFlowLine κ b J 0 θ₂ P h β ζβ) (hαf : IsFlowLine κ b J 0 θ₁ P h α ζα)
    (hγf : IsFlowLine κ b J 0 0 P h γ ζγ) (hβm : ∀ t, Measurable fun ω => β ω t)
    (hαm : ∀ t, Measurable fun ω => α ω t)
    (hsp : ∀ᵐ ω ∂P, ζβ ω = ⊤ ∧ ζα ω = ⊤ ∧ Lemma71I.IsSimpleProper (β ω) ∧ Lemma71I.IsSimpleProper (α ω))
    {c : Ω → Chart} (hcc : ∀ ω, (c ω).IsConformal)
    (hCm : ∀ (z : ℂ) (r : ℝ), MeasurableSet[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      {ω | Metric.closedBall z r ⊆ (c ω).dom})
    (hfwd : ∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).1 z))
    (hliftm : ∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      ({ω | z ∈ (c ω).dom}.indicator fun ω => (c ω).2.2 z))
    (hliftc : ∀ ω, ContinuousOn (c ω).2.2 (c ω).dom)
    (hfr : ∀ᵐ ω ∂P, frontier ((c ω).dom : Set ℂ) ∩ H ⊆ range (β ω) ∪ range (α ω))
    {a k : ℝ} {hψ : Ω → DistOn upperHalfPlaneOpens} (ht : ∀ ω, IsChartTransport (c ω) 1 a k (h ω) (hψ ω)) :
    Sec7.IsAEDeterminedBy P (fun ω => (pocketRecord β α (fun ω => ((c ω).dom : Set ℂ)) h ω, hψ ω)) h := by
  classical
  set C : Ω → Set ℂ := fun ω => ((c ω).dom : Set ℂ) with hCdef
  have hCo : ∀ ω, IsOpen (C ω) := fun ω => (c ω).dom.isOpen
  have hβα : Measurable fun ω => (β ω, α ω) := (measurable_pi_iff.2 hβm).prodMk (measurable_pi_iff.2 hαm)
  have hA0 : MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance ≤ mΩ := hβα.comap_le
  -- the transported field is measurable
  have hψe : hψ = fun ω => chartTransport (hcc ω) 1 a k (h ω) := funext fun ω =>
    (ht ω).eq_chartTransport (hcc ω)
      (locallyIntegrableOn_of_continuousOn ((hcc ω).continuousOn_lift_inv (hliftc ω)))
  have hmem0 : ∀ z, MeasurableSet[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
      {ω | z ∈ (c ω).dom} :=
    @Lemma71E.measurableSet_mem_of_closedBall Ω (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance) C hCo
      hCm
  have hψm : Measurable hψ := by
    rw [hψe]
    exact measurable_chartTransport_random' hcc (fun z => hA0 _ (hmem0 z)) (fun z => (hfwd z).mono hA0 le_rfl)
      (fun z => (hliftm z).mono hA0 le_rfl) hliftc hh 1 a k
  -- the exterior record
  have hS0 : ∀ φ : TestOn upperHalfPlaneOpens, MeasurableSet[MeasurableSpace.comap (fun ω => (β ω, α ω))
      inferInstance] {ω | Disjoint (tsupport φ) (closure (C ω))} := fun φ =>
    @measurableSet_disjoint_closure_of_mem Ω (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance) C hCo
      hmem0 _ φ.hasCompactSupport
  have hQm : Measurable (pocketRecord β α C h) :=
    measurable_pocketRecord hβm hαm hh fun φ => hA0 _ (hS0 φ)
  set R : Ω → (((ℝ≥0 → ℂ) × (ℝ≥0 → ℂ)) × (TestOn upperHalfPlaneOpens → ℝ)) × DistOn upperHalfPlaneOpens :=
    fun ω => (pocketRecord β α C h ω, hψ ω) with hRdef
  have hRm : Measurable R := hQm.prodMk hψm
  have hRle : MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance ≤ MeasurableSpace.comap R inferInstance := by
    have : Measurable[MeasurableSpace.comap R inferInstance] fun ω => (β ω, α ω) :=
      (measurable_fst.comp measurable_fst).comp (comap_measurable R)
    exact this.comap_le
  -- (SR1), integrability, closed ranges and the dimension of the outer curves
  obtain ⟨hint, hSR1⟩ := sr1_of_isFlowLine_zero hγf
  set ε : ℝ := Dimension.onePointExponent κ / 8 with hεdef
  have hop := Dimension.onePointExponent_pos hκ8
  have hop1 := Dimension.onePointExponent_le_one hκ
  have hε0 : 0 < ε := by positivity
  have hε1 : ε < 1 := by rw [hεdef]; linarith
  have hε4 : ε < Dimension.onePointExponent κ / 4 := by rw [hεdef]; linarith
  have hζβ : ∀ᵐ ω ∂P, ζβ ω = ⊤ := hsp.mono fun ω hω => hω.1
  have hζα : ∀ᵐ ω ∂P, ζα ω = ⊤ := hsp.mono fun ω hω => hω.2.1
  set A : Ω → Set ℂ := fun ω => range (β ω) ∪ range (α ω) with hAdef
  have hAcl : ∀ᵐ ω ∂P, closure (A ω) ∩ (upperHalfPlaneOpens : Set ℂ) ⊆ A ω := by
    filter_upwards [hsp] with ω hω
    have h1 : IsClosed (range (β ω)) := Theorem15D5.isClosed_range_of_tendsto_norm hω.2.2.1.1 hω.2.2.1.2.2.2.2
    have h2 : IsClosed (range (α ω)) := Theorem15D5.isClosed_range_of_tendsto_norm hω.2.2.2.1 hω.2.2.2.2.2.2.2
    rw [hAdef, (h1.union h2).closure_eq]
    exact inter_subset_left
  have hdim : ∀ᵐ ω ∂P, ∀ K, IsCompact K → K ⊆ (upperHalfPlaneOpens : Set ℂ) →
      dimH (A ω ∩ K) < ENNReal.ofReal (2 - 2 * ε) := by
    filter_upwards [ae_dimH_range_inter_lt hκ hκ8 hε4 hβf hζβ, ae_dimH_range_inter_lt hκ hκ8 hε4 hαf hζα]
      with ω h1 h2 K _ hK
    rw [hAdef, union_inter_distrib_right, dimH_union]
    exact max_lt (h1 K hK) (h2 K hK)
  refine isAEDeterminedBy_of_recorded_sides hRm hh hint hε0 hε1 (fun ζc => hSR1 hε0 ζc) hAcl hdim hCo hfr
    (fun φ => ?_) (fun φ => ?_)
  · -- inside the pocket: the pulled-back field and the chart
    have hψR : Measurable[MeasurableSpace.comap R inferInstance] hψ := measurable_snd.comp (comap_measurable R)
    exact exists_record_in (𝓡 := MeasurableSpace.comap R inferInstance) hcc (fun z r => hRle _ (hCm z r))
      (fun z => (hfwd z).mono hRle le_rfl) (fun z => (hliftm z).mono hRle le_rfl) hliftc hψR ht φ
  · -- off the closed pocket: the exterior field
    set S : Set Ω := {ω | Disjoint (tsupport φ) (closure (C ω))} with hSdef
    have hSR : MeasurableSet[MeasurableSpace.comap R inferInstance] S := hRle _ (hS0 φ)
    have hgR : Measurable[MeasurableSpace.comap R inferInstance] fun ω => (R ω).1.2 φ :=
      (measurable_pi_apply φ).comp (measurable_snd.comp (measurable_fst.comp (comap_measurable R)))
    refine ⟨S, S.indicator fun ω => (R ω).1.2 φ, hSR, (hgR.indicator hSR).stronglyMeasurable,
      Eventually.of_forall fun ω hω => hω, Eventually.of_forall fun ω hω => ?_⟩
    rw [indicator_of_mem hω]
    exact (outField_of_disjoint h hω).symm

end Field

