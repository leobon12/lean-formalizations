/-!
# The Theorem 1.4 wrappers in the shape of the version-2 anchors (ruling R51)

Packet PROVE-REFREEZE-R51 (no new mathematics). Ruling R51 re-froze the four Theorem 1.4 anchors as version 2: the light
cone, frontiers and component-kernel anchors gain one hypothesis after `hE`,
`hreg : ∀ spec, IsBoundaryContinuedProgram spec.2.2 → StagedPiecesRegular κ b jumps P spec (E spec)`, and the
companion `exists_isStagedHistory` also gives `StagedPiecesRegular` for the families it produces. The earlier wrappers
(`Wire.*_of_open5`, `SB.boundaryWalks_frontiers_of_sb`, `GW4.componentKernels_of_gw4Inputs`,
`GW4.componentKernels_of_gw4Core`, `GW4Traverse.componentKernels_of_relHulls`) state the version-1 types, so they no
longer match. Their version-2 forms are here:

* the three theorem wrappers take the same inputs and the added hypothesis, which they do not use (a version-1
  conclusion with fewer hypotheses implies the version-2 one);
* the companion is `Exist.StagedLaw.exists_isStagedHistory_regular_of_thm12_thm13` (PROVE-STAGEDLAW4), from Theorems
  1.2–1.3 (frozen types) alone.

`StagedPiecesRegular` is the definition of `Spec/Exist/StagedLaw4Def.lean`, which is identical (same ABI hash) to the
frozen `Frozen/Spec/StagedPiecesRegular.lean`. Every theorem here is a conditional helper with a distinct name; none is
a provider.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

namespace Wire

open Theorem14

/-! ### The light cone -/

/-- **Theorem 1.4, light cone, version 2** (`IsCenteredCounterflowDriver.completedRange_eq_closure_lightCone`, R51),
provider shape, from the inputs of `completedRange_eq_closure_lightCone_of_open5` (conditional helper; not the
provider). -/
theorem completedRange_eq_closure_lightCone_of_openR51 (h13 : Exist.Theorem13Statement.{u})
    (h13₀ : Exist.Theorem13Statement.{0}) (hBR6 : BR6.BR6Statement.{u})
    (hC0 : GW2Cone.GW2ScheduleContainmentStatement.{u}) (hCv : GW2Cone.GW2ArcScheduleContainmentStatement.{u})
    (hEx : GW2Cone.GW2TipExhaustionStatement.{u}) (hGW2a : GW2aContainmentStatement.{u})
    {κ : ℝ} (hκ : 0 < κ := by assumption) (hκ4 : κ < 4 := by assumption)
    {b : ℝ → ℝ} {jumps : Finset ℝ} (hb : IsPiecewiseConstantBoundaryData b jumps := by assumption)
    {Ω : Type u} [MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens} (hh : IsGFFWithBoundaryData P h b jumps := by assumption)
    {W' : ℝ≥0 → Ω → ℝ} {ζ' : Ω → ℝ≥0∞}
    (hcf : IsCenteredCounterflowDriver κ P h W' ζ' := by assumption) (hζ' : ∀ᵐ ω ∂P, ζ' ω = ⊤ := by assumption)
    {Θ : Set ℝ} (hΘ : Θ ⊆ Ioo (-(Real.pi / 2)) (Real.pi / 2) := by assumption)
    (hΘc : Θ.Countable := by assumption)
    (hΘd : Ioo (-(Real.pi / 2)) (Real.pi / 2) ⊆ closure Θ := by assumption) :
    ∃ Q : Set ℝ≥0, Q.Countable ∧ Dense Q ∧ (∀ q ∈ Q, 0 < q) ∧
      ∀ E : ExplSpec → ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞,
        (∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 →
          IsStagedHistory κ b jumps P h spec (E spec)) →
        (∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 →
          StagedPiecesRegular κ b jumps P spec (E spec)) →
        (∀ᵐ ω ∂P, closure (boundaryLightConeFamily κ b jumps Θ Q (fun spec k => E spec k ω) ∪ {0}) =
            counterflowCompletedRange (fun t => W' t ω)) ∧
        ∀ 𝒞 : Set (List Instr), 𝒞.Countable → (∀ p ∈ 𝒞, IsBoundaryContinuedProgram p) →
          ∀ᵐ ω ∂P, closure (boundaryLightConeFamily κ b jumps Θ Q (fun spec k => E spec k ω) ∪
              (⋃ p ∈ 𝒞, ExplState.physSet κ b jumps ⟨0, false, p⟩ (fun k => E ⟨0, false, p⟩ k ω)) ∪
              {0}) =
            counterflowCompletedRange (fun t => W' t ω) := by
  obtain ⟨Q, hQc, hQd, hQ0, hQ⟩ := completedRange_eq_closure_lightCone_of_open5 h13 h13₀ hBR6 hC0 hCv hEx hGW2a
    hκ hκ4 hb hh hcf hζ' hΘ hΘc hΘd
  exact ⟨Q, hQc, hQd, hQ0, fun E hE _ => hQ E hE⟩

