import InteractingSLE.Spec.Restart.DomainMarkovTransfer

/-!
# The domain Markov step, part 6: the protected-kernel law under the regular conditional law

Packet PROVE-DOMAINMARKOV2, item (S), continued. Let `ν = condExpKernel P 𝓓_T ω₀`. With the modified restarted data
`zW, zVL, zVR` (`DomainMarkovTransfer.lean`) and their countably generated data filtration
`dF = dataFilt N (ζ − T) 0 (rsData …)` (no Brownian coordinate; `dF ≤ 𝓓_{T+·}`):

* `ae_forall_setIntegral_piClosure_eq`: the identity `∫_A 1_S e^{i(h',ψ)} = ∫_A 1_S cfAt q` of
  `condExp_safeU_indicator_eq` transfers, for `P`-almost every `ω₀`, to `ν` simultaneously for the countably many
  `ψ = ratTest p`, dyadic `q` and events `A` of the generating π-system of `dF q`;
* `condExp_safeU_indicator_eq_kernel`: Dynkin, hence `ν[1_S e^{i(h',ψ)} | dF q] = 1_S cfAt q`;
* `ae_condExp_cexp_eq_cfAt_kernel`: by local Gaussian laws (`condExp_cexp_ae_eq_of_local_countable`) the identity
  holds for **every** test function on the avoidance event;
* **`ae_setIntegral_cexp_eq_cfAt_restart`**: for `P`-almost every `ω₀`, for every test function `ψ`, dyadic `q` and
  event `A` that is `ν`-almost surely equal to an event of `dF q` and `ν`-almost surely inside the avoidance event of
  the modified restarted driver, `∫_A e^{i(h', ψ)} dν = ∫_A cfAt q dν`.
-/

set_option autoImplicit false

noncomputable section

open Set Filter MeasureTheory ProbabilityTheory Topology TopologicalSpace
open QuantumZipper (H zeroGFFTestCov fwdHull chiC IsForwardSol fwdMap)
open LQGMetric (TestOn DistOn)
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Restart

namespace DomainMarkov

open Coupling Coupling.MartMeans2 Ito Sec7 Sec7.Aux122Disint Sec2.Restart Sec5.Markov LocalExt

variable {κ : ℝ} {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} {nL nR : ℕ}
  {xL : Fin nL → ℝ} {xR : Fin nR → ℝ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {𝓕 : Filtration ℝ≥0 mΩ}
  {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {B : ℝ≥0 → Ω → ℝ}
  {ζ : Ω → ℝ≥0∞} {h : Ω → DistOn upperHalfPlaneOpens} {T : Ω → ℝ≥0} {N : Set Ω}

/-- The data filtration of the modified restarted processes (driving coordinates only). -/
abbrev dF (N : Set Ω) (ζ : Ω → ℝ≥0∞) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (T : Ω → ℝ≥0) : Filtration ℝ≥0 mΩ :=
  dataFilt N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T)

section Meas

variable (hX : IsMeasurableKilledDriving W VL VR ζ)
  (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))

include hX hT in
/-- The data filtration at time `t` is generated by the finite intersections of its generating events. -/
theorem dF_eq (hNm : MeasurableSet N) (t : ℝ≥0) :
    dF N ζ W VL VR T t = MeasurableSpace.generateFrom
      (piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) t)) := by
  rw [generateFrom_piClosure]
  exact inf_eq_left.2 (MeasurableSpace.generateFrom_le fun A hA =>
    (dataMeas_rsData hX hT hNm).measurableSet_of_mem hA)

include hX hT in
theorem measurableSet_dF_of_mem_piClosure (hNm : MeasurableSet N) {t : ℝ≥0} {A : Set Ω}
    (hA : A ∈ piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) t)) :
    MeasurableSet[dF N ζ W VL VR T t] A := by
  obtain ⟨T', hT', hT'S, rfl⟩ := hA
  exact @Set.Finite.measurableSet_sInter Ω (dF N ζ W VL VR T t) T' hT'
    fun C hC => (dataMeas_rsData hX hT hNm).measurableSet_dataFilt (hT'S hC)

include hX hT in
theorem adaptedBefore_zData_dF (hNm : MeasurableSet N) (hN : IsGoodOff N ζ W VL VR T)
    (i : Option (Fin nL ⊕ Fin nR)) :
    AdaptedBefore (dF N ζ W VL VR T) (restartLife ζ T) (zData N ζ W VL VR T i) :=
  (dataMeas_rsData hX hT hNm).adaptedBefore_zeroOn (continuousOn_rsData fun ω hω hF => (hN ω hω).2 hF) i

include hX hT in
/-- `1_S cfAt q` is `dF q`-measurable. -/
theorem measurable_Y_dF (hNm : MeasurableSet N) (hN : IsGoodOff N ζ W VL VR T)
    (ψ : TestOn upperHalfPlaneOpens) (q : ℝ≥0) :
    Measurable[dF N ζ W VL VR T q] ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q)) :=
  measurable_safeU_indicator_cfAt_of_weak hN.isWeakPath (adaptedBefore_zData_dF hX hT hNm hN none)
    MeasurableSet.univ _ (fun ω s => isBoundedHarmonicExtension_uZ ω s)
    (fun i => adaptedBefore_zData_dF hX hT hNm hN (some (Sum.inl i)))
    (fun j => adaptedBefore_zData_dF hX hT hNm hN (some (Sum.inr j))) ψ q

include hX hT in
theorem measurableSet_safeU_dF (hNm : MeasurableSet N) (hN : IsGoodOff N ζ W VL VR T)
    (ψ : TestOn upperHalfPlaneOpens) (q : ℝ≥0) :
    MeasurableSet[dF N ζ W VL VR T q] (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q) :=
  measurableSet_safeU hN.isWeakPath (adaptedBefore_zData_dF hX hT hNm hN none) MeasurableSet.univ ψ q

omit mΩ in
/-- `1_S cfAt q` has modulus at most one. -/
theorem norm_Y_le (hN : IsGoodOff N ζ W VL VR T) (ψ : TestOn upperHalfPlaneOpens) (q : ℝ≥0) (ω : Ω) :
    ‖(safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q) ω‖ ≤ 1 := by
  by_cases hω : ω ∈ safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q
  · rw [indicator_of_mem hω]
    exact norm_cfAt_le_one_of_mem_safeU' hN.isWeakPath _ ψ hω
  · rw [indicator_of_notMem hω, norm_zero]
    exact zero_le_one

end Meas

/-! ### Transfer to the conditional law -/

section Transfer

variable [StandardBorelSpace Ω] [IsProbabilityMeasure P]

/-- **The countably many identities hold under almost every conditional law.** -/
theorem ae_forall_setIntegral_piClosure_eq
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h) (hκ : 0 < κ)
    (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    {K : Ω → DrivingHist nL nR} (hKm : Measurable[hT.measurableSpace] K)
    (hK : ∀ᵐ ω ∂P, (T ω : ℝ≥0∞) < ζ ω →
      K ω = stoppedHistory (completedState W VL VR ζ) (fun ω => (T ω : WithTop ℝ≥0)) ω)
    (hNm : MeasurableSet N) (hN0 : P N = 0) (hN : IsGoodOff N ζ W VL VR T) :
    ∀ᵐ ω₀ ∂P, ∀ (p : RatIdx) (n k : ℕ)
      (A : piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) (dyT n k))),
      ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ (ratTest upperHalfPlaneOpens p)
          (dyT n k)).indicator (fun ω => Complex.exp (Complex.I *
            (restartField κ (h ω, K ω) (ratTest upperHalfPlaneOpens p) : ℂ))) ω
          ∂(condExpKernel P hT.measurableSpace ω₀) =
        ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ (ratTest upperHalfPlaneOpens p)
          (dyT n k)).indicator (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T)
            (ratTest upperHalfPlaneOpens p) 1 fun _ => dyT n k) ω ∂(condExpKernel P hT.measurableSpace ω₀) := by
  refine ae_all_iff.2 fun p => ae_all_iff.2 fun n => ae_all_iff.2 fun k => ?_
  set ψ := ratTest upperHalfPlaneOpens p
  set q := dyT n k
  set 𝓖' := restartFiltration (drivingFiltration P hX) T hT
  have hc : Countable (piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) q)) :=
    (countable_piClosure (countable_dataGens _ _ _ _ _)).to_subtype
  have hKm' : Measurable K := hKm.mono hT.measurableSpace_le le_rfl
  have hXm : Measurable fun ω => restartField κ (h ω, K ω) ψ :=
    (LQGMetric.measurable_distOn_apply ψ).comp ((measurable_restartField κ).comp (hC.2.1.prodMk hKm'))
  have hS : MeasurableSet[𝓖' q] (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q) :=
    measurableSet_safeU hN.isWeakPath (adaptedBefore_zData_restart hX hT hNm hN0 none) MeasurableSet.univ ψ q
  have hXi : Integrable ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ))) P :=
    (GFF.integrable_exp_I_mul hXm).indicator (𝓖'.le q _ hS)
  have hYm : Measurable ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q)) :=
    (measurable_Y_dF hX hT hNm hN ψ q).mono ((dF N ζ W VL VR T).le q) le_rfl
  have hYi : Integrable ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q)) P :=
    Integrable.of_bound hYm.aestronglyMeasurable 1 (Eventually.of_forall (norm_Y_le hN ψ q))
  exact ae_forall_setIntegral_condExpKernel_eq (measurableSpace_le_restartFiltration hT q) (𝓖'.le q) hXi hYi
    (condExp_safeU_indicator_eq hC hκ hX hT hKm hK hNm hN0 hN ψ q)
    (fun A => dataFilt_le_restart hX hT hNm hN0 q _ (measurableSet_dF_of_mem_piClosure hX hT hNm A.2))

omit [StandardBorelSpace Ω] [IsProbabilityMeasure P] in
/-- **Dynkin and the conditional expectation under one conditional law.** If the countably many identities hold
under `ν`, then `ν[1_S e^{i(h', ψ)} | dF q] = 1_S cfAt q` `ν`-almost surely. -/
theorem condExp_safeU_indicator_eq_kernel (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    {K : Ω → DrivingHist nL nR} (hKm : Measurable K) (hhm : Measurable h)
    (hNm : MeasurableSet N) (hN : IsGoodOff N ζ W VL VR T) {ν : Measure Ω} [IsProbabilityMeasure ν]
    (ψ : TestOn upperHalfPlaneOpens) (q : ℝ≥0)
    (hall : ∀ A : piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) q),
      ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
          (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ))) ω ∂ν =
        ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
          (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q) ω ∂ν) :
    ν[(safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
        (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ))) | dF N ζ W VL VR T q] =ᵐ[ν]
      (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
        (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q) := by
  have hm : dF N ζ W VL VR T q ≤ mΩ := (dF N ζ W VL VR T).le q
  have hXm : Measurable fun ω => restartField κ (h ω, K ω) ψ :=
    (LQGMetric.measurable_distOn_apply ψ).comp ((measurable_restartField κ).comp (hhm.prodMk hKm))
  have hS : MeasurableSet[dF N ζ W VL VR T q] (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q) :=
    measurableSet_safeU_dF hX hT hNm hN ψ q
  have hXi : Integrable ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ))) ν :=
    (GFF.integrable_exp_I_mul hXm).indicator (hm _ hS)
  have hYm := measurable_Y_dF (κ := κ) (ρL := ρL) (ρR := ρR) hX hT hNm hN ψ q
  have hYi : Integrable ((safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
      (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q)) ν :=
    Integrable.of_bound (hYm.mono hm le_rfl).aestronglyMeasurable 1 (Eventually.of_forall (norm_Y_le hN ψ q))
  have hdyn : ∀ A, MeasurableSet[dF N ζ W VL VR T q] A →
      ∫ ω in A, (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
          (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ))) ω ∂ν =
        ∫ ω in A, (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ ψ q).indicator
          (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 fun _ => q) ω ∂ν := fun A hA =>
    setIntegral_eq_of_isPiSystem hXi hYi hm (dF_eq hX hT hNm q) (isPiSystem_piClosure _)
      (by simpa only [Measure.restrict_univ] using hall ⟨univ, univ_mem_piClosure _⟩)
      (fun A hA => hall ⟨A, hA⟩) hA
  exact (ae_eq_condExp_of_forall_setIntegral_eq hm hXi (fun s _ _ => hYi.integrableOn)
    (fun s hs _ => (hdyn s hs).symm) hYm.aestronglyMeasurable).symm

omit [StandardBorelSpace Ω] [IsProbabilityMeasure P] in
/-- **Every test function, under one conditional law.** If the countably many identities hold under `ν` at a time
`q`, then for every test function `ψ`, `ν`-almost surely on the avoidance event of the modified restarted driver,
`ν[e^{i(h', ψ)} | dF q] = cfAt q`. -/
theorem ae_condExp_cexp_eq_cfAt_kernel (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    {K : Ω → DrivingHist nL nR} (hKm : Measurable K) (hhm : Measurable h)
    (hNm : MeasurableSet N) (hN : IsGoodOff N ζ W VL VR T) {ν : Measure Ω} [IsProbabilityMeasure ν] (q : ℝ≥0)
    (hall : ∀ (p : RatIdx)
      (A : piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) q)),
      ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ (ratTest upperHalfPlaneOpens p)
          q).indicator (fun ω => Complex.exp (Complex.I *
            (restartField κ (h ω, K ω) (ratTest upperHalfPlaneOpens p) : ℂ))) ω ∂ν =
        ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ (ratTest upperHalfPlaneOpens p)
          q).indicator (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T)
            (ratTest upperHalfPlaneOpens p) 1 fun _ => q) ω ∂ν)
    (ψ : TestOn upperHalfPlaneOpens) :
    ∀ᵐ ω ∂ν, ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) ψ q →
      ν[fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ)) | dF N ζ W VL VR T q] ω =
        cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 (fun _ => q) ω := by
  classical
  have hm : dF N ζ W VL VR T q ≤ mΩ := (dF N ζ W VL VR T).le q
  have hweak := hN.isWeakPath
  have hhK : Measurable fun ω => restartField κ (h ω, K ω) := (measurable_restartField κ).comp (hhm.prodMk hKm)
  -- the random open sets
  set U : Ω → Set ℂ := fun ω => if (q : ℝ≥0∞) < restartLife ζ T ω then
    H \ fwdHull (fun s : ℝ => zW N ζ W VL VR T s.toNNReal ω) q else ∅ with hUdef
  have hUo : ∀ ω, IsOpen (U ω) := fun ω => by
    by_cases hq : (q : ℝ≥0∞) < restartLife ζ T ω
    · simp only [hUdef, hq, ↓reduceIte]
      exact isOpen_H_diff_fwdHull_rpath (w := fun t => zW N ζ W VL VR T t ω) (hweak ω).2.1 hq
    · simp only [hUdef, hq, ↓reduceIte]
      exact isOpen_empty
  have hUH : ∀ ω, U ω ⊆ H := fun ω => by
    by_cases hq : (q : ℝ≥0∞) < restartLife ζ T ω
    · simp only [hUdef, hq, ↓reduceIte]
      exact sdiff_subset
    · simp only [hUdef, hq, ↓reduceIte]
      exact empty_subset _
  -- the mean
  set m : Ω → ℂ → ℝ := fun ω z => couplingMean κ (fun s : ℝ => zW N ζ W VL VR T s.toNNReal ω) q
    (uZ κ ρL ρR N ζ W VL VR T ω q) z with hmdef
  have hmc : ∀ ω, ContinuousOn (m ω) (U ω) := fun ω => by
    by_cases hq : (q : ℝ≥0∞) < restartLife ζ T ω
    · have hr := continuousOn_rpath (u := fun t => zW N ζ W VL VR T t ω) (hweak ω).2.1 hq
      have hcm := continuousOn_couplingMean κ hr (isBoundedHarmonicExtension_uZ (κ := κ) (ρL := ρL)
        (ρR := ρR) (N := N) (ζ := ζ) (W := W) (VL := VL) (VR := VR) (T := T) ω q).1
      refine hcm.mono fun z hz => ?_
      simp only [hUdef, hq, ↓reduceIte] at hz
      exact mem_hullDom hr hz.1 hz.2
    · simp only [hUdef, hq, ↓reduceIte]
      exact continuousOn_empty _
  set Ψ : Ω → TestOn upperHalfPlaneOpens → ℂ := fun ω φ =>
    Complex.exp (Complex.I * ((∫ z, m ω z * φ z : ℝ) : ℂ) -
      (((1 / 2 : ℝ) * zeroGFFTestCov (U ω) φ φ : ℝ) : ℂ)) with hΨdef
  have hΨ : ∀ᵐ ω ∂ν, ∀ R : Opens ℂ, (R : Set ℂ) ⊆ U ω → ∃ μ : Measure (DistOn R), IsProbabilityMeasure μ ∧
      ∀ ψ : TestOn R, ∫ v, Complex.exp (Complex.I * (v ψ : ℂ)) ∂μ =
        Ψ ω (GFF.testIncl R upperHalfPlaneOpens ψ) := Eventually.of_forall fun ω R hR => by
    have hRH : R ≤ upperHalfPlaneOpens := fun x hx => hUH ω (hR hx)
    obtain ⟨μ, hμP, hμ⟩ := exists_gaussLocalLaw (U := ⟨U ω, hUo ω⟩) (hUH ω) (R := R) hR
      (((hmc ω).mono hR).locallyIntegrableOn R.isOpen.measurableSet)
    refine ⟨μ, hμP, fun ψ => ?_⟩
    rw [hμ ψ, hΨdef]
    simp only [GFF.coe_testIncl hRH ψ, Opens.coe_mk]
  -- on the avoidance event, `cfAt` is `Ψ`
  have hcfΨ : ∀ (φ : TestOn upperHalfPlaneOpens) (ω : Ω), ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) φ q →
      cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) φ 1 (fun _ => q) ω = Ψ ω φ := by
    intro φ ω hav
    obtain ⟨hq, hdis⟩ := hav
    simp only [hΨdef, hmdef, hUdef, hq, ↓reduceIte, cfAt]
    rw [← WholeField.loewnerGreenEnergy_rpath_eq_zeroGFFTestCov (w := fun t => zW N ζ W VL VR T t ω)
      (hweak ω).2.1 (hweak ω).1 hq φ hdis]
    congr 1
    push_cast
    ring
  -- the countably many identities as conditional expectations
  have hkey : ∀ φ : TestOn upperHalfPlaneOpens,
      (∀ A : piClosure (dataGens N (restartLife ζ T) (fun _ _ => (0 : ℝ)) (rsData ζ W VL VR T) q),
        ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ φ q).indicator
            (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) φ : ℂ))) ω ∂ν =
          ∫ ω in (A : Set Ω), (safeU (zW N ζ W VL VR T) (restartLife ζ T) univ φ q).indicator
            (cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) φ 1 fun _ => q) ω ∂ν) →
      ∀ᵐ ω ∂ν, ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) φ q →
        ν[fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) φ : ℂ)) | dF N ζ W VL VR T q] ω =
          cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) φ 1 (fun _ => q) ω := by
    intro φ hφ
    have h1 := condExp_safeU_indicator_eq_kernel hX hT hKm hhm hNm hN φ q hφ
    have hXi : Integrable (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) φ : ℂ))) ν :=
      GFF.integrable_exp_I_mul ((LQGMetric.measurable_distOn_apply φ).comp hhK)
    have h2 := condExp_indicator hXi (measurableSet_safeU_dF hX hT hNm hN φ q)
    filter_upwards [h1, h2] with ω h1ω h2ω hav
    have hωS := mem_safeU_of_mem_avoidSet hweak φ (mem_univ ω) hav
    rw [h2ω, indicator_of_mem hωS, indicator_of_mem hωS] at h1ω
    exact h1ω
  have hcond : ∀ p : RatIdx, ∀ᵐ ω ∂ν, tsupport (ratTest upperHalfPlaneOpens p) ⊆ U ω →
      ν[fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) (ratTest upperHalfPlaneOpens p) : ℂ)) |
        dF N ζ W VL VR T q] ω = Ψ ω (ratTest upperHalfPlaneOpens p) := by
    intro p
    by_cases hφ0 : ratTest upperHalfPlaneOpens p = 0
    · rw [hφ0]
      have e : (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) 0 : ℂ))) = fun _ => (1 : ℂ) := by
        funext ω; simp only [map_zero, Complex.ofReal_zero, mul_zero, Complex.exp_zero]
      have h1 : ν[fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) 0 : ℂ)) | dF N ζ W VL VR T q] =
          fun _ => (1 : ℂ) := by
        rw [e, condExp_const hm]
      refine Eventually.of_forall fun ω _ => ?_
      rw [h1]
      have e2 : ((0 : TestOn upperHalfPlaneOpens) : ℂ → ℝ) = (0 : ℂ → ℝ) := rfl
      simp only [hΨdef, e2, Pi.zero_apply, mul_zero, integral_zero, Complex.ofReal_zero,
        GFF.zeroGFFTestCov_zero_zero, sub_zero, Complex.exp_zero]
    · filter_upwards [hkey _ (hall p)] with ω hω hsupp
      have hq : (q : ℝ≥0∞) < restartLife ζ T ω := by
        by_contra hq
        simp only [hUdef, hq, ↓reduceIte, subset_empty_iff] at hsupp
        exact hφ0 (TestFunction.ext fun z => image_eq_zero_of_notMem_tsupport (by rw [hsupp]; exact id))
      have hav : ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) (ratTest upperHalfPlaneOpens p) q := by
        refine ⟨hq, Set.disjoint_left.2 fun z hz hzK => ?_⟩
        have := hsupp hz
        simp only [hUdef, hq, ↓reduceIte] at this
        exact this.2 hzK
      rw [hω hav, hcfΨ _ ω hav]
  have hall' := condExp_cexp_ae_eq_of_local_countable hm hhK hUo hUH hΨ hcond ψ
  filter_upwards [hall'] with ω hω hav
  have hsupp : tsupport ψ ⊆ U ω := by
    obtain ⟨hq, hdis⟩ := hav
    simp only [hUdef, hq, ↓reduceIte]
    exact fun z hz => ⟨ψ.tsupport_subset hz, fun hK => Set.disjoint_left.1 hdis hz hK⟩
  rw [hω hsupp, hcfΨ ψ ω hav]

/-- **The protected-kernel law of the restarted field under almost every conditional law** (Aux. lemma 53, item (S)).
For `P`-almost every `ω₀`, under `ν = condExpKernel P 𝓓_T ω₀`: for every test function `ψ`, every dyadic time `q` and
every measurable event `A` that is `ν`-almost surely equal to an event of the restarted data σ-algebra `dF q` and
`ν`-almost surely contained in the avoidance event `{q < ζ − T, supp ψ ∩ K'_q = ∅}` of the modified restarted driver,
`∫_A e^{i(h', ψ)} dν = ∫_A cfAt q dν`. -/
theorem ae_setIntegral_cexp_eq_cfAt_restart
    (hC : IsOptionalHullCoupling κ xL xR ρL ρR P 𝓕 W VL VR B ζ h) (hκ : 0 < κ)
    (hX : IsMeasurableKilledDriving W VL VR ζ)
    (hT : IsStoppingTime (drivingFiltration P hX) fun ω => (T ω : WithTop ℝ≥0))
    {K : Ω → DrivingHist nL nR} (hKm : Measurable[hT.measurableSpace] K)
    (hK : ∀ᵐ ω ∂P, (T ω : ℝ≥0∞) < ζ ω →
      K ω = stoppedHistory (completedState W VL VR ζ) (fun ω => (T ω : WithTop ℝ≥0)) ω)
    (hNm : MeasurableSet N) (hN0 : P N = 0) (hN : IsGoodOff N ζ W VL VR T) :
    ∀ᵐ ω₀ ∂P, ∀ (ψ : TestOn upperHalfPlaneOpens) (n k : ℕ) (A : Set Ω), MeasurableSet A →
      (∃ A', MeasurableSet[dF N ζ W VL VR T (dyT n k)] A' ∧ A =ᵐ[condExpKernel P hT.measurableSpace ω₀] A') →
      (∀ᵐ ω ∂(condExpKernel P hT.measurableSpace ω₀), ω ∈ A →
        ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) ψ (dyT n k)) →
      ∫ ω in A, Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ)) ∂(condExpKernel P hT.measurableSpace ω₀) =
        ∫ ω in A, cfAt κ (zW N ζ W VL VR T) (uZ κ ρL ρR N ζ W VL VR T) ψ 1 (fun _ => dyT n k) ω
          ∂(condExpKernel P hT.measurableSpace ω₀) := by
  have hKm' : Measurable K := hKm.mono hT.measurableSpace_le le_rfl
  filter_upwards [ae_forall_setIntegral_piClosure_eq hC hκ hX hT hKm hK hNm hN0 hN] with ω₀ hω₀ ψ n k A _hA
    hA'ex hAav
  obtain ⟨A', hA', hAA'⟩ := hA'ex
  have hm : dF N ζ W VL VR T (dyT n k) ≤ mΩ := (dF N ζ W VL VR T).le (dyT n k)
  have hc := ae_condExp_cexp_eq_cfAt_kernel (κ := κ) (ρL := ρL) (ρR := ρR) hX hT hKm' hC.2.1 hNm hN
    (ν := condExpKernel P hT.measurableSpace ω₀) (dyT n k) (fun p A => hω₀ p n k A) ψ
  have hXi : Integrable (fun ω => Complex.exp (Complex.I * (restartField κ (h ω, K ω) ψ : ℂ)))
      (condExpKernel P hT.measurableSpace ω₀) :=
    GFF.integrable_exp_I_mul ((LQGMetric.measurable_distOn_apply ψ).comp
      ((measurable_restartField κ).comp (hC.2.1.prodMk hKm')))
  have hA'av : ∀ᵐ ω ∂(condExpKernel P hT.measurableSpace ω₀), ω ∈ A' →
      ω ∈ avoidSet (zW N ζ W VL VR T) (restartLife ζ T) ψ (dyT n k) := by
    filter_upwards [hAav, hAA'] with ω h1 h2 hω
    exact h1 (by rw [h2]; exact hω)
  rw [setIntegral_congr_set hAA', setIntegral_congr_set hAA', ← setIntegral_condExp hm hXi hA']
  refine setIntegral_congr_ae (hm _ hA') ?_
  filter_upwards [hc, hA'av] with ω h1 h2 hω using h1 (h2 hω)

