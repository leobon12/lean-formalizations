/-! ### The zone word in one setting -/

section Word

variable {α β : ℝ≥0 → ℂ} {ζ₁ ζ₂ : ℝ≥0∞} {x₁ x₂ : ℝ} {a b : ℝ≥0} {φ ψ : ℂ → ℂ} {lift : ℂ → ℝ}
  {c₀ : BoundaryWord} {g₁ g₂ g₃ g₄ : ℝ}

/-- **The datum of the zone word at the chart point of an untouched real point** is the original datum there. -/
theorem fn_zword_of_untouched (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift)
    (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1)) {p : ℝ} (hp : IsUntouched α a β b p) :
    ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn ((zoneData φ α a β b).T p) = c₀.fn p := by
  rw [BoundaryWord.trunc_fn]
  rcases (hs.isUntouched_iff p).1 hp with h | h | h
  · exact ZW.fn_zone₀ hs.zoneData_good hc₀ h
  · exact ZW.fn_zone₁ hs.zoneData_good hc₀ h
  · exact ZW.fn_zone₂ hs.zoneData_good hc₀ h

/-- Left of the second tip, a chart point on the second prefix carries `g₁`. -/
theorem fn_zword_of_mem₂_neg (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift)
    (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1)) {w : ℝ} (hw : ψ w ∈ β '' Icc 0 b) (hw0 : w < 0)
    (hwL : w ≠ (zoneData φ α a β b).L₂) :
    ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn w = g₁ := by
  rw [BoundaryWord.trunc_fn]
  exact ZW.fn_side₁ hs.zoneData_good hc₀ (lt_of_le_of_ne (hs.L₂_le_of_mem₂ hw) (Ne.symm hwL)) hw0

/-- Right of the second tip, a chart point on the second prefix carries `g₂`. -/
theorem fn_zword_of_mem₂_pos (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift)
    (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1)) {w : ℝ} (hw : ψ w ∈ β '' Icc 0 b) (hw0 : 0 < w)
    (hwR : w ≠ (zoneData φ α a β b).R₂) :
    ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn w = g₂ := by
  rw [BoundaryWord.trunc_fn]
  exact ZW.fn_side₂ hs.zoneData_good hc₀ hw0 (lt_of_le_of_ne (hs.le_R₂_of_mem₂ hw) hwR)

/-- Left of the first tip, a chart point on the first prefix carries `g₃`. -/
theorem fn_zword_of_mem₁_lt (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift)
    (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1)) {w : ℝ} (hw : ψ w ∈ α '' Icc 0 a)
    (hwM : w < (zoneData φ α a β b).M₁) (hwL : w ≠ (zoneData φ α a β b).L₁) :
    ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn w = g₃ := by
  rw [BoundaryWord.trunc_fn]
  exact ZW.fn_side₃ hs.zoneData_good hc₀ (lt_of_le_of_ne (hs.L₁_le_of_mem₁ hw) (Ne.symm hwL)) hwM

/-- Right of the first tip, a chart point on the first prefix carries `g₄`. -/
theorem fn_zword_of_mem₁_gt (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift)
    (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1)) {w : ℝ} (hw : ψ w ∈ α '' Icc 0 a)
    (hwM : (zoneData φ α a β b).M₁ < w) (hwR : w ≠ (zoneData φ α a β b).R₁) :
    ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn w = g₄ := by
  rw [BoundaryWord.trunc_fn]
  exact ZW.fn_side₄ hs.zoneData_good hc₀ hwM (lt_of_le_of_ne (hs.le_R₁_of_mem₁ hw) hwR)

/-- A chart point on the first prefix lies right of the second tip. -/
theorem pos_of_mem₁ (hs : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ ψ lift) {w : ℝ} (hw : ψ w ∈ α '' Icc 0 a) : 0 < w := by
  have hz := hs.zoneData_good
  have h1 := hs.L₁_le_of_mem₁ hw
  have h2 := hs.R₂_lt_L₁
  have h3 : (zoneData φ α a β b).M₂ ≤ (zoneData φ α a β b).R₂ := hz.M₂_le
  have h4 : (zoneData φ α a β b).M₂ = 0 := rfl
  linarith

end Word

/-! ### The real flow -/

section Flow

open MartChar.RealFlow

variable {w : ℝ → ℝ}

/-- `y ↦ g_t(y)` is strictly increasing from an alive point. -/
theorem gImg_lt_gImg (hw : Continuous w) {x x' t : ℝ} (ht : 0 ≤ t) (hx : Alive w x t) (hxx : x < x') :
    gImg w x t < gImg w x' t := by
  have h := (cflow_lt_and_sub_le hw hx hxx ht ⟨ht, le_rfl⟩).1
  simp only [gImg]
  linarith

/-- **The image of a mark `z ≠ x` is at most `g_t(x)` iff `z < x`** (`x` alive). -/
theorem rightImg_le_gImg_iff (hw : Continuous w) {x z t : ℝ} (ht : 0 ≤ t) (hx : Alive w x t) (hzx : z ≠ x) :
    rightImg w z t ≤ gImg w x t ↔ z < x := by
  refine ⟨fun h => ?_, fun h => rightImg_le_gImg hw ht h hx⟩
  by_contra hle
  have hxz : x < z := lt_of_le_of_ne (not_lt.1 hle) (Ne.symm hzx)
  have hxx' : x < (x + z) / 2 := by linarith
  have hx'z : (x + z) / 2 < z := by linarith
  have hx' : Alive w ((x + z) / 2) t := hx.of_le hw hxx'.le ht
  have h1 : gImg w ((x + z) / 2) t ≤ rightImg w z t :=
    le_csInf (imgSet_nonempty hw z ht) fun _ ⟨y, hzy, _, hg⟩ =>
      hg ▸ (gImg_lt_gImg hw ht hx' (hx'z.trans hzy)).le
  have h2 := gImg_lt_gImg hw ht hx hxx'
  linarith

/-- **Every value above the image of `0⁺` is the image of an alive positive point.** -/
theorem exists_alive_gImg_eq (hw : Continuous w) {t M : ℝ} (ht : 0 ≤ t) (hM : rightImg w 0 t < M) :
    ∃ x, 0 < x ∧ Alive w x t ∧ gImg w x t = M := by
  obtain ⟨y₀, hy₀0, hy₀, hg₀⟩ := exists_lt_of_rightImg_lt hw ht hM
  have hy₀M : y₀ ≤ M := (hy₀.le_gImg hw ht).trans hg₀.le
  have hcont : ContinuousOn (fun y => gImg w y t) (Icc y₀ M) := by
    refine (LipschitzOnWith.of_dist_le_mul (K := 1) fun c hc d hd => ?_).continuousOn
    rw [Real.dist_eq, Real.dist_eq, NNReal.coe_one, one_mul]
    exact abs_gImg_sub_le hw ht (hy₀.of_le hw hd.1 ht) (hy₀.of_le hw hc.1 ht)
  have hMg : M ≤ gImg w M t := (hy₀.of_le hw hy₀M ht).le_gImg hw ht
  obtain ⟨x, hx, hxg⟩ := intermediate_value_Icc hy₀M hcont ⟨hg₀.le, hMg⟩
  exact ⟨x, hy₀0.trans_le hx.1, hy₀.of_le hw hx.1 ht, hxg⟩

/-- **Forward solutions from real points** are the real flows of alive points: from `x > 0` the value at `t` is
`g_t(x) − w_t`, from `x < 0` it is `−g̃_t(−x) − w_t` for the reflected driver. -/
theorem isForwardSol_real_cases (hw : Continuous w) (hw0 : w 0 = 0) {x t : ℝ} (ht : 0 ≤ t) {u : ℝ → ℂ}
    (hu : QuantumZipper.IsForwardSol w (x : ℂ) t u) :
    (0 < x ∧ Alive w x t ∧ u t = ((gImg w x t - w t : ℝ) : ℂ)) ∨
      (x < 0 ∧ Alive (fun s => -w s) (-x) t ∧ u t = ((-gImg (fun s => -w s) (-x) t - w t : ℝ) : ℂ)) := by
  have h0 := hu.2 0 ⟨le_rfl, ht⟩
  have hx0 : x ≠ 0 := by
    intro hx
    apply h0.1
    rw [h0.2, hx, hw0]
    simp
  have him : (u t).im = 0 := im_eq_zero_of_isForwardSol_real hw hu ⟨ht, le_rfl⟩
  have hut : u t = (((u t).re : ℝ) : ℂ) := Complex.ext (by simp) (by simp [him])
  rcases lt_or_gt_of_ne hx0 with hx | hx
  · right
    have hu' := QuantumZipper.RS.isForwardSol_neg hu
    have e : -((x : ℝ) : ℂ) = ((-x : ℝ) : ℂ) := by push_cast; ring
    rw [e] at hu'
    have hwn : Continuous fun s => -w s := hw.neg
    have hP := WangWu.isPosSol_of_isForwardSol hwn (by simp [hw0]) (neg_pos.2 hx) hu'
    have hc := cflow_eq_of_isPosSol hwn hP ⟨ht, le_rfl⟩
    refine ⟨hx, ⟨_, hP⟩, ?_⟩
    rw [hut]
    congr 1
    simp only [gImg, hc, neg_re]
    ring
  · left
    have hP := WangWu.isPosSol_of_isForwardSol hw hw0 hx hu
    have hc := cflow_eq_of_isPosSol hw hP ⟨ht, le_rfl⟩
    refine ⟨hx, ⟨_, hP⟩, ?_⟩
    rw [hut]
    congr 1
    simp only [gImg, hc]
    ring

section Force

variable {κ : ℝ} {nL nR : ℕ} (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) {xL : Fin nL → ℝ} {xR : Fin nR → ℝ}

/-- **Right of the image of `0⁺` the flowed force datum is the initial one**: at `g_t(x) − w_t`, `x > 0` alive and
no right mark at `x`, it is the force datum of the initial marks at `x`. -/
theorem forceBoundaryData_flow_right (hw : Continuous w) {t : ℝ} (ht : 0 ≤ t) {x : ℝ} (hx0 : 0 < x)
    (hx : Alive w x t) (hxR : ∀ j, xR j ≠ x) :
    forceBoundaryData κ ρL ρR (fun i => -rightImg (fun s => -w s) (-xL i) t - w t)
        (fun j => rightImg w (xR j) t - w t) (gImg w x t - w t) = forceBoundaryData κ ρL ρR xL xR x := by
  have hpos : 0 < gImg w x t - w t := by linarith [hx.lt_gImg hw ⟨ht, le_rfl⟩]
  have h1 : ¬ (gImg w x t - w t < 0) := not_lt.2 hpos.le
  have h2 : ¬ (x < 0) := not_lt.2 hx0.le
  unfold forceBoundaryData
  simp only [h1, h2, ↓reduceIte]
  congr 3
  refine Finset.filter_congr fun j _ => ?_
  rw [sub_le_sub_iff_right, rightImg_le_gImg_iff hw ht hx (hxR j)]
  exact ⟨le_of_lt, fun h => lt_of_le_of_ne h (hxR j)⟩

/-- **Left of the image of `0⁻` the flowed force datum is the initial one** (mirror of
`forceBoundaryData_flow_right`; `x > 0` alive for the reflected driver, the point is `−x`). -/
theorem forceBoundaryData_flow_left (hw : Continuous w) {t : ℝ} (ht : 0 ≤ t) {x : ℝ} (hx0 : 0 < x)
    (hx : Alive (fun s => -w s) x t) (hxL : ∀ i, -xL i ≠ x)
    (hy : ∀ i, -gImg (fun s => -w s) x t - w t ≠ -rightImg (fun s => -w s) (-xL i) t - w t) :
    forceBoundaryData κ ρL ρR (fun i => -rightImg (fun s => -w s) (-xL i) t - w t)
        (fun j => rightImg w (xR j) t - w t) (-gImg (fun s => -w s) x t - w t) =
      forceBoundaryData κ ρL ρR xL xR (-x) := by
  have hwn : Continuous fun s => -w s := hw.neg
  have hneg : -gImg (fun s => -w s) x t - w t < 0 := by
    have := hx.lt_gImg hwn ⟨ht, le_rfl⟩
    linarith
  have h2 : -x < 0 := neg_lt_zero.2 hx0
  unfold forceBoundaryData
  simp only [hneg, h2, ↓reduceIte]
  congr 3
  refine Finset.filter_congr fun i _ => ?_
  have key := rightImg_le_gImg_iff hwn ht hx (hxL i)
  constructor
  · intro h
    have h' : rightImg (fun s => -w s) (-xL i) t ≤ gImg (fun s => -w s) x t := by linarith
    have := key.1 h'
    linarith
  · intro h
    have h' := key.2 (by linarith)
    exact lt_of_le_of_ne (by linarith) (hy i)

/-- **On the image of the right side of the trace** (`0 ≤ y < V̂^{0,R}`) the flowed force datum is `λ`. -/
theorem forceBoundaryData_flow_slit_right (hw : Continuous w) {t : ℝ} (ht : 0 ≤ t) (hxR : ∀ j, 0 ≤ xR j) {y : ℝ}
    (hy0 : 0 ≤ y) (hy : y < rightImg w 0 t - w t) :
    forceBoundaryData κ ρL ρR (fun i => -rightImg (fun s => -w s) (-xL i) t - w t)
        (fun j => rightImg w (xR j) t - w t) y = Real.pi / Real.sqrt κ := by
  have h1 : ¬ (y < 0) := not_lt.2 hy0
  unfold forceBoundaryData
  simp only [h1, ↓reduceIte]
  have he : Finset.univ.filter (fun j => rightImg w (xR j) t - w t ≤ y) = ∅ := by
    refine Finset.filter_false_of_mem fun j _ h => ?_
    have := rightImg_mono_index hw ht (hxR j)
    linarith
  rw [he, Finset.sum_empty, add_zero, mul_one]

/-- **On the image of the left side of the trace** (`V̂^{0,L} < y < 0`) the flowed force datum is `−λ`. -/
theorem forceBoundaryData_flow_slit_left (hw : Continuous w) {t : ℝ} (ht : 0 ≤ t) (hxL : ∀ i, xL i ≤ 0) {y : ℝ}
    (hy0 : y < 0) (hy : -rightImg (fun s => -w s) 0 t - w t < y) :
    forceBoundaryData κ ρL ρR (fun i => -rightImg (fun s => -w s) (-xL i) t - w t)
        (fun j => rightImg w (xR j) t - w t) y = -(Real.pi / Real.sqrt κ) := by
  unfold forceBoundaryData
  simp only [hy0, ↓reduceIte]
  have he : Finset.univ.filter (fun i => y < -rightImg (fun s => -w s) (-xL i) t - w t) = ∅ := by
    refine Finset.filter_false_of_mem fun i _ h => ?_
    have := rightImg_mono_index (w := fun s => -w s) hw.neg ht (neg_nonneg.2 (hxL i))
    linarith
  rw [he, Finset.sum_empty, add_zero, mul_one]

end Force

end Flow

/-! ### Two lines of the same pair -/

section Lines

open MartChar.RealFlow

variable {α β : ℝ≥0 → ℂ} {ζ₁ ζ₂ : ℝ≥0∞} {x₁ x₂ : ℝ} {a b b' : ℝ≥0} {φ₀ ψ₀ φ₁ ψ₁ : ℂ → ℂ} {l₀ l₁ : ℂ → ℝ}
  {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0}

theorem prefixSet_mono_right (hbb : b ≤ b') : prefixSet α a β b ⊆ prefixSet α a β b' :=
  union_subset_union_right _ (image_mono (Icc_subset_Icc_right hbb))

/-- The later active domain is inside the earlier one. -/
theorem activeDomain_subset (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀)
    (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b') :
    activeDomain α a β b' ⊆ activeDomain α a β b := by
  rw [hs₀.D_eq, hs₁.D_eq]
  exact sdiff_subset_sdiff_right (fillH_mono (prefixSet_mono_right hbb))

/-- **Untouched real points of the later line are untouched at the stop line.** -/
theorem isUntouched_of_le (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀)
    (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b') {p : ℝ} (hp : IsUntouched α a β b' p) :
    IsUntouched α a β b p :=
  ⟨fun h => hp.1 (prefixSet_mono_right hbb h), closure_mono (activeDomain_subset hs₀ hs₁ hbb) hp.2⟩

/-- A generating trace of a continuous driver stays in `ℍ̄` before its lifetime. -/
theorem mem_Hbar_of_isGeneratingTrace (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0)
    {s : ℝ≥0} (hs : (s : ℝ≥0∞) < ζc) : γ s ∈ Hbar := by
  have htip := hg.tendsto_fwdMapInv_tip hWc.continuousOn hW0 hs
  have hw'c : Continuous fun r : ℝ => W r.toNNReal := hWc.comp continuous_real_toNNReal
  have hw'0 : (fun r : ℝ => W r.toNNReal) 0 = 0 := by simp [hW0]
  have hNe : (𝓝[H] (0 : ℂ)).NeBot := mem_closure_iff_nhdsWithin_neBot.1 (by
    rw [closure_H]; exact mem_Hbar_of_im_eq_zero (z := 0) (by simp))
  rw [← closure_H]
  exact mem_closure_of_tendsto htip (eventually_nhdsWithin_of_forall fun w hw =>
    (QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hw'c hw'0 s.coe_nonneg hw).1)

/-- **Alive real points are off the chart path**: a point with a forward solution up to `Q` is no `γ(s)`, `s ≤ Q`. -/
theorem ne_trace_of_isForwardSol (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0)
    (hQ : (Q : ℝ≥0∞) < ζc) {p : ℂ} {u : ℝ → ℂ} (hu : QuantumZipper.IsForwardSol (fun r : ℝ => W r.toNNReal) p Q u)
    {s : ℝ≥0} (hs : s ≤ Q) : γ s ≠ p := by
  intro he
  have hsζ : (s : ℝ≥0∞) < ζc := lt_of_le_of_lt (ENNReal.coe_le_coe.2 hs) hQ
  have htip := hg.tendsto_fwdMapInv_tip hWc.continuousOn hW0 hsζ
  rw [he] at htip
  have hs' : (s : ℝ) ≤ Q := hs
  exact Supp8.GB6.not_isForwardSol_of_tip (hWc.comp continuous_real_toNNReal) (by simp [hW0]) s.coe_nonneg htip
    ⟨hu.1.mono (Icc_subset_Icc_right hs'), fun r hr => hu.2 r ⟨hr.1, hr.2.trans hs'⟩⟩

variable (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀) (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁)
  (hWc : Continuous W) (hW0 : W 0 = 0)
  (hinv : ∀ w ∈ H, ψ₁ w = ψ₀ (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))
include hs₀ hs₁ hWc hW0 hinv

/-- **Transport of real points**: if the real point `x` of the stop-line chart has a forward solution `u` up to `Q`,
then `ψ₁(u_Q) = ψ₀(x)`. -/
theorem inv₁_eq_inv₀_of_isForwardSol {x : ℝ} {u : ℝ → ℂ}
    (hu : QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u) : ψ₁ (u Q) = ψ₀ x := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQ : (0 : ℝ) ≤ Q := Q.coe_nonneg
  obtain ⟨δ, hδ, hlow⟩ := exists_two_mul_le_norm_of_isForwardSol hQ hu
  have hev : ∀ᶠ z in 𝓝[H] (x : ℂ), z ∈ H \ fwdHull w' Q := by
    have hc : Continuous fun z : ℂ => ‖z - x‖ * Real.exp (2 / δ ^ 2 * Q) := by fun_prop
    have h0 : (fun z : ℂ => ‖z - x‖ * Real.exp (2 / δ ^ 2 * Q)) x < δ := by simp [hδ]
    have hball := hc.continuousAt.eventually_lt continuousAt_const h0
    filter_upwards [nhdsWithin_le_nhds hball, self_mem_nhdsWithin] with z hz hzH
    exact ⟨hzH, not_mem_fwdHull_of_isForwardSol hw'c hu hδ hlow hzH hz⟩
  have hNe : (𝓝[H] (x : ℂ)).NeBot := mem_closure_iff_nhdsWithin_neBot.1 (by rw [closure_H]; exact ofReal_mem_Hbar x)
  have huH : u Q ∈ Hbar := mem_Hbar_of_im_eq_zero (im_eq_zero_of_isForwardSol_real hw'c hu ⟨hQ, le_rfl⟩)
  have h1 : Tendsto (fwdMap w' Q) (𝓝[H] (x : ℂ)) (𝓝[Hbar] (u Q)) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_fwdMap_of_isForwardSol hw'c hQ hu,
      hev.mono fun z hz => H_subset_Hbar (QuantumZipper.FwdHolo.mapsTo_fwdMap hw'c hQ hz)⟩
  have h2 : Tendsto (fun z => ψ₁ (fwdMap w' Q z)) (𝓝[H] (x : ℂ)) (𝓝 (ψ₁ (u Q))) :=
    (hs₁.ψc _ huH).tendsto.comp h1
  have h3 : Tendsto ψ₀ (𝓝[H] (x : ℂ)) (𝓝 (ψ₀ x)) :=
    ((hs₀.ψc _ (ofReal_mem_Hbar x)).mono H_subset_Hbar).tendsto
  have h4 : (fun z => ψ₁ (fwdMap w' Q z)) =ᶠ[𝓝[H] (x : ℂ)] ψ₀ := hev.mono fun z hz => by
    show ψ₁ (fwdMap w' Q z) = ψ₀ z
    rw [hinv _ (QuantumZipper.FwdHolo.mapsTo_fwdMap hw'c hQ hz), QuantumZipper.RS.fwdMapInv_fwdMap hw'c hw'0 hQ hz]
  exact tendsto_nhds_unique (h2.congr' h4) h3

/-- **A boundary point of the later domain off the second path has an alive stop-line chart point**: if `q` is
adherent to the later active domain, off `β([0, b'])`, and `φ₀ → x` at `q` with `ψ₀(x) = q`, then `x` has a forward
solution up to `Q` (it is nonzero, off the chart path and adherent to `ℍ \ K_Q`). -/
theorem exists_isForwardSol_of_tendsto (hbb : b ≤ b') (hg : IsGeneratingTrace W ζc γ) (hQ : (Q : ℝ≥0∞) < ζc)
    (himg : ∀ s ∈ Icc 0 Q, ψ₀ (γ s) ∈ β '' Icc 0 b') {q : ℂ} (hq : q ∈ closure (activeDomain α a β b'))
    (hqβ : q ∉ β '' Icc 0 b') {x : ℝ} (hlim : Tendsto φ₀ (𝓝[activeDomain α a β b] q) (𝓝 (x : ℂ)))
    (hψx : ψ₀ x = q) : ∃ u, QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  have hx0 : x ≠ 0 := by
    rintro rfl
    apply hqβ
    rw [← hψx, ofReal_zero, hs₀.ψ0]
    exact ⟨b, ⟨zero_le, hbb⟩, rfl⟩
  have hxη : (x : ℂ) ∉ (fun s : ℝ => γ s.toNNReal) '' Icc 0 (Q : ℝ) := by
    rintro ⟨s, hs, hγs⟩
    apply hqβ
    rw [← hψx, ← hγs]
    refine himg s.toNNReal ⟨zero_le, ?_⟩
    rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hs.1]
    exact hs.2
  have hcl : (x : ℂ) ∈ closure (H \ fwdHull w' Q) := by
    have hNe : (𝓝[activeDomain α a β b'] q).NeBot := mem_closure_iff_nhdsWithin_neBot.1 hq
    have hlim' : Tendsto φ₀ (𝓝[activeDomain α a β b'] q) (𝓝 (x : ℂ)) :=
      hlim.mono_left (nhdsWithin_mono _ (activeDomain_subset hs₀ hs₁ hbb))
    refine mem_closure_of_tendsto hlim' (eventually_nhdsWithin_of_forall fun z hz => ?_)
    rw [hs₁.D_eq] at hz
    obtain ⟨v, hv, rfl⟩ := hs₁.bij.surjOn hz
    rw [hinv v hv]
    have hv' := QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hw'c hw'0 hQr hv
    rw [hs₀.hC.fwd_inv _ hv'.1]
    exact hv'
  obtain ⟨t₂, hQt₂, ht₂⟩ := exists_real_btwn_of_lt hQ
  have hT : ((t₂.toNNReal : ℝ≥0) : ℝ≥0∞) ≤ ζc := ht₂.le
  have hL := GB7a.isLoewnerTraceLT_of_agree hg hT (U := w') fun s _ _ => rfl
  rw [Real.coe_toNNReal _ (hQr.trans hQt₂.le)] at hL
  exact GB7a.exists_isForwardSol_of_mem_closure hw'c hw'0 hL hQr hQt₂ hx0 hxη hcl

/-- **The chart point of an untouched point moves by `f_Q`**: for `p` untouched at the later line, its stop-line
chart point `T₀(p)` has a forward solution `u` up to `Q`, and `u_Q = T₁(p)`. -/
theorem exists_isForwardSol_chartPt (hbb : b ≤ b') (hg : IsGeneratingTrace W ζc γ) (hQ : (Q : ℝ≥0∞) < ζc)
    (himg : ∀ s ∈ Icc 0 Q, ψ₀ (γ s) ∈ β '' Icc 0 b') {p : ℝ} (hp : IsUntouched α a β b' p) :
    ∃ u, QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) ((zoneData φ₀ α a β b).T p : ℂ) Q u ∧
      u Q = ((zoneData φ₁ α a β b').T p : ℂ) := by
  have hp₀ := isUntouched_of_le hs₀ hs₁ hbb hp
  obtain ⟨hlim, hψ, -⟩ := hs₀.chartPt_untouched hp₀
  obtain ⟨u, hu⟩ := exists_isForwardSol_of_tendsto hs₀ hs₁ hWc hW0 hinv hbb hg hQ himg hp.2
    (fun h => hp.1 (Or.inr h)) hlim hψ
  refine ⟨u, hu, ?_⟩
  have hw'c : Continuous fun s : ℝ => W s.toNNReal := hWc.comp continuous_real_toNNReal
  have huH : u Q ∈ Hbar := mem_Hbar_of_im_eq_zero (im_eq_zero_of_isForwardSol_real hw'c hu ⟨Q.coe_nonneg, le_rfl⟩)
  exact (hs₁.chartPt_untouched hp).2.2 _ huH ((inv₁_eq_inv₀_of_isForwardSol hs₀ hs₁ hWc hW0 hinv hu).trans hψ)

end Lines

/-! ### The zone word at transported points -/

section Assembly

open MartChar.RealFlow

variable {α β : ℝ≥0 → ℂ} {ζ₁ ζ₂ : ℝ≥0∞} {x₁ x₂ : ℝ} {a b b' : ℝ≥0} {φ₀ ψ₀ φ₁ ψ₁ : ℂ → ℂ} {l₀ l₁ : ℂ → ℝ}
  {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0} {c₀ : BoundaryWord} {g₁ g₂ g₃ g₄ : ℝ}

theorem mem_image_Icc_zero_of_image_eq (himg : (fun s => ψ₀ (γ s)) '' Icc 0 Q = β '' Icc b b') :
    ∀ s ∈ Icc 0 Q, ψ₀ (γ s) ∈ β '' Icc 0 b' := fun s hs => by
  have h : ψ₀ (γ s) ∈ β '' Icc b b' := himg ▸ ⟨s, hs, rfl⟩
  obtain ⟨t, ht, he⟩ := h
  exact ⟨t, ⟨zero_le, ht.2⟩, he⟩

/-- **(III-b′) at a transported real point.** If the stop-line chart point `x` has a forward solution `u` up to `Q`,
the zone word of the later line at `u_Q` equals the zone word of the stop line at `x` (off the zone points). -/
theorem fn_zword_eq_of_isForwardSol (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀)
    (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b') (hg : IsGeneratingTrace W ζc γ)
    (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (hinv : ∀ w ∈ H, ψ₁ w = ψ₀ (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))
    (himg : (fun s => ψ₀ (γ s)) '' Icc 0 Q = β '' Icc b b') (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1))
    {x : ℝ} {u : ℝ → ℂ} (hu : QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u)
    (hx : x ≠ (zoneData φ₀ α a β b).L₂ ∧ x ≠ (zoneData φ₀ α a β b).R₂ ∧ x ≠ (zoneData φ₀ α a β b).L₁ ∧
      x ≠ (zoneData φ₀ α a β b).M₁ ∧ x ≠ (zoneData φ₀ α a β b).R₁)
    (hy : (u Q).re ≠ (zoneData φ₁ α a β b').L₂ ∧ (u Q).re ≠ (zoneData φ₁ α a β b').R₂ ∧
      (u Q).re ≠ (zoneData φ₁ α a β b').L₁ ∧ (u Q).re ≠ (zoneData φ₁ α a β b').R₁) :
    ((zoneData φ₁ α a β b').word c₀ g₁ g₂ g₃ g₄).trunc.fn (u Q).re =
      ((zoneData φ₀ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn x := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'n : Continuous fun s => -w' s := hw'c.neg
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  have himg' := mem_image_Icc_zero_of_image_eq himg
  set y := (u Q).re with hydef
  have huy : u Q = (y : ℂ) :=
    Complex.ext (by simp [hydef]) (by simp [im_eq_zero_of_isForwardSol_real hw'c hu ⟨hQr, le_rfl⟩])
  have hψ : ψ₁ y = ψ₀ x := by rw [← huy]; exact inv₁_eq_inv₀_of_isForwardSol hs₀ hs₁ hWc hW0 hinv hu
  have hcases := isForwardSol_real_cases hw'c hw'0 hQr hu
  obtain ⟨hxL₂, hxR₂, hxL₁, hxM₁, hxR₁⟩ := hx
  obtain ⟨hyL₂, hyR₂, hyL₁, hyR₁⟩ := hy
  rcases hs₀.inv_cases x with hα | hβ | hU
  · -- the first prefix: compare with the first tip, which moves by `f_Q`
    have hα' : ψ₁ y ∈ α '' Icc 0 a := hψ ▸ hα
    have htip₀ := hs₀.chartPt_tip₁
    have htip₁ := hs₁.chartPt_tip₁
    obtain ⟨uM, huM⟩ := exists_isForwardSol_of_tendsto hs₀ hs₁ hWc hW0 hinv hbb hg hQ himg'
      hs₁.hpair.2.2.2.2.2 (fun h => Set.disjoint_left.1 hs₁.disj ⟨a, ⟨zero_le, le_rfl⟩, rfl⟩ h) htip₀.1 htip₀.2.1
    have hMH : uM Q ∈ Hbar :=
      mem_Hbar_of_im_eq_zero (im_eq_zero_of_isForwardSol_real hw'c huM ⟨hQr, le_rfl⟩)
    have hM1 : uM Q = ((zoneData φ₁ α a β b').M₁ : ℂ) :=
      htip₁.2.2 _ hMH ((inv₁_eq_inv₀_of_isForwardSol hs₀ hs₁ hWc hW0 hinv huM).trans htip₀.2.1)
    have hz₀ := hs₀.zoneData_good
    have hM0 : 0 < (zoneData φ₀ α a β b).M₁ := by
      have h1 := hs₀.R₂_lt_L₁
      have h2 : (zoneData φ₀ α a β b).M₂ ≤ (zoneData φ₀ α a β b).R₂ := hz₀.M₂_le
      have h3 : (zoneData φ₀ α a β b).M₂ = 0 := rfl
      linarith [hz₀.L₁_le]
    obtain ⟨-, hxa, hux⟩ | ⟨hx0, -, -⟩ := hcases
    swap
    · exact absurd (pos_of_mem₁ hs₀ hα) (not_lt.2 hx0.le)
    obtain ⟨-, hMa, huMv⟩ | ⟨hM0', -, -⟩ := isForwardSol_real_cases hw'c hw'0 hQr huM
    swap
    · exact absurd hM0 (not_lt.2 hM0'.le)
    have hyv : y = gImg w' x Q - w' Q := by
      rw [hux] at huy
      exact_mod_cast huy.symm
    have hMv : (zoneData φ₁ α a β b').M₁ = gImg w' (zoneData φ₀ α a β b).M₁ Q - w' Q := by
      rw [huMv] at hM1
      exact_mod_cast hM1.symm
    rcases lt_or_gt_of_ne hxM₁ with h | h
    · have hy' : y < (zoneData φ₁ α a β b').M₁ := by
        rw [hyv, hMv]; linarith [gImg_lt_gImg hw'c hQr hxa h]
      rw [fn_zword_of_mem₁_lt hs₀ hc₀ hα h hxL₁, fn_zword_of_mem₁_lt hs₁ hc₀ hα' hy' hyL₁]
    · have hy' : (zoneData φ₁ α a β b').M₁ < y := by
        have hMa' : Alive w' (zoneData φ₀ α a β b).M₁ Q := hMa
        rw [hyv, hMv]; linarith [gImg_lt_gImg hw'c hQr hMa' h]
      rw [fn_zword_of_mem₁_gt hs₀ hc₀ hα h hxR₁, fn_zword_of_mem₁_gt hs₁ hc₀ hα' hy' hyR₁]
  · -- the second prefix: the side is the sign, preserved by the flow
    have hβ' : ψ₁ y ∈ β '' Icc 0 b' := by
      rw [hψ]
      obtain ⟨t, ht, he⟩ := hβ
      exact ⟨t, ⟨ht.1, ht.2.trans hbb⟩, he⟩
    rcases hcases with ⟨hx0, hxa, hux⟩ | ⟨hx0, hxa, hux⟩
    · have hy0 : 0 < y := by
        have hyv : y = gImg w' x Q - w' Q := by
          rw [hux] at huy
          exact_mod_cast huy.symm
        have := hxa.lt_gImg hw'c ⟨hQr, le_rfl⟩
        linarith
      rw [fn_zword_of_mem₂_pos hs₀ hc₀ hβ hx0 hxR₂, fn_zword_of_mem₂_pos hs₁ hc₀ hβ' hy0 hyR₂]
    · have hy0 : y < 0 := by
        have hyv : y = -gImg (fun s => -w' s) (-x) Q - w' Q := by
          rw [hux] at huy
          exact_mod_cast huy.symm
        have := hxa.lt_gImg hw'n ⟨hQr, le_rfl⟩
        linarith
      rw [fn_zword_of_mem₂_neg hs₀ hc₀ hβ hx0 hxL₂, fn_zword_of_mem₂_neg hs₁ hc₀ hβ' hy0 hyL₂]
  · -- an untouched point stays untouched
    obtain ⟨he, hp, hT⟩ := hs₀.untouched_cases hU
    set p := (ψ₀ x).re with hpdef
    have hpU' : IsUntouched α a β b' p := by
      refine ⟨?_, ?_⟩
      · rintro (h | ⟨s, hs, hsp⟩)
        · exact hp.1 (Or.inl h)
        · rcases le_total s b with hsb | hbs
          · exact hp.1 (Or.inr ⟨s, ⟨hs.1, hsb⟩, hsp⟩)
          · have hmem : (p : ℂ) ∈ (fun s => ψ₀ (γ s)) '' Icc 0 Q := by
              rw [himg]; exact ⟨s, ⟨hbs, hs.2⟩, hsp⟩
            obtain ⟨s', hs', hs'p⟩ := hmem
            have hγH : γ s' ∈ Hbar :=
              mem_Hbar_of_isGeneratingTrace hg hWc hW0 (lt_of_le_of_lt (ENNReal.coe_le_coe.2 hs'.2) hQ)
            have hγx : γ s' = (((zoneData φ₀ α a β b).T p : ℝ) : ℂ) :=
              (hs₀.chartPt_untouched hp).2.2 _ hγH hs'p
            rw [hT] at hγx
            exact ne_trace_of_isForwardSol hg hWc hW0 hQ hu hs'.2 hγx
      · rw [← he, ← hψ]; exact hs₁.inv_mem_closure y
    have hTy : (zoneData φ₁ α a β b').T p = y := by
      have := (hs₁.chartPt_untouched hpU').2.2 y (ofReal_mem_Hbar y) (by rw [hψ, ← he])
      exact (Complex.ofReal_injective this).symm
    have e₀ : ((zoneData φ₀ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn x = c₀.fn p := by
      rw [← fn_zword_of_untouched hs₀ hc₀ hp, hT]
    have e₁ : ((zoneData φ₁ α a β b').word c₀ g₁ g₂ g₃ g₄).trunc.fn y = c₀.fn p := by
      rw [← fn_zword_of_untouched hs₁ hc₀ hpU', hTy]
    rw [e₀, e₁]

/-- **The right side of the new piece fits in the later second side**: `V̂^{0,R}_Q ≤ R₂'`. -/
theorem rightImg_sub_le_R₂ (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀)
    (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b') (hg : IsGeneratingTrace W ζc γ)
    (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (hinv : ∀ w ∈ H, ψ₁ w = ψ₀ (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))
    (himg : ∀ s ∈ Icc 0 Q, ψ₀ (γ s) ∈ β '' Icc 0 b') :
    rightImg (fun s : ℝ => W s.toNNReal) 0 Q - (fun s : ℝ => W s.toNNReal) Q ≤ (zoneData φ₁ α a β b').R₂ := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'n : Continuous fun s => -w' s := hw'c.neg
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  refine le_csInf (hs₁.zone₁_nonempty.image _) ?_
  rintro _ ⟨p, hp, rfl⟩
  obtain ⟨u, hu, huT⟩ := exists_isForwardSol_chartPt hs₀ hs₁ hWc hW0 hinv hbb hg hQ himg
    (hs₁.untouched_of_zone (Or.inr (Or.inl hp)))
  have hpos := hs₁.zero_lt_T hp
  rcases isForwardSol_real_cases hw'c hw'0 hQr hu with ⟨hx0, hxa, hux⟩ | ⟨hx0, hxa, hux⟩
  · have h1 := rightImg_le_gImg hw'c hQr hx0 hxa
    have h2 : (zoneData φ₁ α a β b').T p = gImg w' ((zoneData φ₀ α a β b).T p) Q - w' Q := by
      rw [hux] at huT
      exact_mod_cast huT.symm
    show _ ≤ (zoneData φ₁ α a β b').T p
    linarith
  · have h2 : (zoneData φ₁ α a β b').T p = -gImg (fun s => -w' s) (-(zoneData φ₀ α a β b).T p) Q - w' Q := by
      rw [hux] at huT
      exact_mod_cast huT.symm
    have h3 := hxa.lt_gImg hw'n ⟨hQr, le_rfl⟩
    exfalso
    have h4 : 0 < (zoneData φ₁ α a β b').T p := hpos
    linarith

/-- **The left side of the new piece fits in the later second side**: `L₂' ≤ V̂^{0,L}_Q`. -/
theorem L₂_le_neg_rightImg_sub (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀)
    (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b') (hg : IsGeneratingTrace W ζc γ)
    (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (hinv : ∀ w ∈ H, ψ₁ w = ψ₀ (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))
    (himg : ∀ s ∈ Icc 0 Q, ψ₀ (γ s) ∈ β '' Icc 0 b') :
    (zoneData φ₁ α a β b').L₂ ≤
      -rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - (fun s : ℝ => W s.toNNReal) Q := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'n : Continuous fun s => -w' s := hw'c.neg
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  refine csSup_le (nonempty_Iio.image _) ?_
  rintro _ ⟨p, hp, rfl⟩
  obtain ⟨u, hu, huT⟩ := exists_isForwardSol_chartPt hs₀ hs₁ hWc hW0 hinv hbb hg hQ himg
    (hs₁.untouched_of_zone (Or.inl hp))
  have hneg := hs₁.T_lt_zero hp
  rcases isForwardSol_real_cases hw'c hw'0 hQr hu with ⟨hx0, hxa, hux⟩ | ⟨hx0, hxa, hux⟩
  · have h2 : (zoneData φ₁ α a β b').T p = gImg w' ((zoneData φ₀ α a β b).T p) Q - w' Q := by
      rw [hux] at huT
      exact_mod_cast huT.symm
    have h3 := hxa.lt_gImg hw'c ⟨hQr, le_rfl⟩
    exfalso
    have h4 : (zoneData φ₁ α a β b').T p < 0 := hneg
    linarith
  · have h1 := rightImg_le_gImg hw'n hQr (neg_pos.2 hx0) hxa
    have h2 : (zoneData φ₁ α a β b').T p = -gImg (fun s => -w' s) (-(zoneData φ₀ α a β b).T p) Q - w' Q := by
      rw [hux] at huT
      exact_mod_cast huT.symm
    show (zoneData φ₁ α a β b').T p ≤ _
    linarith

end Assembly

/-! ### (III-b′) -/

/-- The truncated zone word of the retained chart `φ` at a disjoint pair `(a, b)` (LEMMA76G's datum,
`Lemma76G.wordM_eq_of_setting`). -/
def zword (φ : ℂ → ℂ) (α : ℝ≥0 → ℂ) (a : ℝ≥0) (β : ℝ≥0 → ℂ) (b : ℝ≥0) (c₀ : BoundaryWord) (g₁ g₂ g₃ g₄ : ℝ) :
    BoundaryWord :=
  ((zoneData φ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc

section Main

open MartChar.RealFlow

variable {α β : ℝ≥0 → ℂ} {ζ₁ ζ₂ : ℝ≥0∞} {x₁ x₂ : ℝ} {a b b' : ℝ≥0} {φ₀ ψ₀ φ₁ ψ₁ : ℂ → ℂ} {l₀ l₁ : ℂ → ℝ}
  {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0} {c₀ : BoundaryWord}

/-- The marks of the flow-line word from `0` are the seed `0` and jump positions of the word. -/
theorem flowLineXR_eq_zero_or_mem (c : BoundaryWord) (j : Fin (flowLineNR c.fn c.jumps 0)) :
    flowLineXR c.fn c.jumps 0 j = 0 ∨ (0 < flowLineXR c.fn c.jumps 0 j ∧ flowLineXR c.fn c.jumps 0 j ∈ c.jumps) := by
  rcases Supp8.flowLineXR_cases 0 j with h | ⟨z, hz, hz0, hzj⟩
  · exact Or.inl h
  · rw [hzj, sub_zero]
    exact Or.inr ⟨hz0, (Finset.mem_filter.1 hz).1⟩

theorem flowLineXL_eq_zero_or_mem (c : BoundaryWord) (i : Fin (flowLineNL c.fn c.jumps 0)) :
    flowLineXL c.fn c.jumps 0 i = 0 ∨ (flowLineXL c.fn c.jumps 0 i < 0 ∧ flowLineXL c.fn c.jumps 0 i ∈ c.jumps) := by
  rcases Supp8.flowLineXL_cases 0 i with h | ⟨z, hz, hz0, hzj⟩
  · exact Or.inl h
  · rw [hzj, sub_zero]
    exact Or.inr ⟨hz0, (Finset.mem_filter.1 hz).1⟩

/-- **(III-b′): the boundary-data identity at a later line.** At a disjoint pair `(a, b)` with retained chart
`(φ₀, ψ₀)`, let the continuation of the second path have the flow-line force word of the stop-line zone word
`β₀ = zword φ₀ α a β b c₀ (−λ − θχ) (λ − θχ) g₃ g₄` at the seed `0` and angle `θ`, and a chart path `γ` generated by a
continuous driver `W` with `W 0 = 0`. At a later line `b' ≥ b` reached at capacity `Q` before the lifetime `ζc`, with
retained chart `(φ₁, ψ₁)` satisfying (III-a) (`ψ₁ = ψ₀ ∘ f_Q⁻¹` on `ℍ`) and `ψ₀ ∘ γ([0, Q]) = β([b, b'])`, the force
data at the flowed marks `V^L_Q − W_Q`, `V^R_Q − W_Q` equal the later zone word `βt` plus `θχ` off a finite set. -/
theorem forceBoundaryData_eq_zword_add {κ : ℝ} (hκ : 0 < κ) (θ g₃ g₄ : ℝ)
    (hs₀ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b φ₀ ψ₀ l₀) (hs₁ : IsSetting α ζ₁ x₁ a β ζ₂ x₂ b' φ₁ ψ₁ l₁) (hbb : b ≤ b')
    (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0) (hQ : (Q : ℝ≥0∞) < ζc)
    (hinv : ∀ w ∈ H, ψ₁ w = ψ₀ (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))
    (himg : (fun s => ψ₀ (γ s)) '' Icc 0 Q = β '' Icc b b') (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1))
    {β₀ βt : BoundaryWord}
    (hβ₀ : β₀ = zword φ₀ α a β b c₀ (-sleLambda κ - θ * QuantumZipper.chiC κ)
      (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄)
    (hβt : βt = zword φ₁ α a β b' c₀ (-sleLambda κ - θ * QuantumZipper.chiC κ)
      (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄) :
    ∃ S : Set ℝ, S.Finite ∧ ∀ y ∉ S,
      forceBoundaryData κ (flowLineRhoL κ β₀.fn β₀.jumps 0 θ) (flowLineRhoR κ β₀.fn β₀.jumps 0 θ)
          (fun i => -rightImg (fun s : ℝ => -W s.toNNReal) (-flowLineXL β₀.fn β₀.jumps 0 i) Q - W Q)
          (fun j => rightImg (fun s : ℝ => W s.toNNReal) (flowLineXR β₀.fn β₀.jumps 0 j) Q - W Q) y =
        βt.fn y + θ * QuantumZipper.chiC κ := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  have hw'c : Continuous w' := hWc.comp continuous_real_toNNReal
  have hw'n : Continuous fun s => -w' s := hw'c.neg
  have hw'0 : w' 0 = 0 := by simp [hw', hW0]
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  have hwQ : W Q = w' Q := by simp [hw']
  rw [hwQ]
  have himg' := mem_image_Icc_zero_of_image_eq himg
  set χ := QuantumZipper.chiC κ with hχ
  set g₁ := -sleLambda κ - θ * χ with hg₁
  set g₂ := sleLambda κ - θ * χ with hg₂
  set z₀ := zoneData φ₀ α a β b with hz₀
  set z₁ := zoneData φ₁ α a β b' with hz₁
  have hgood₁ : z₁.Good := hs₁.zoneData_good
  set xL := flowLineXL β₀.fn β₀.jumps 0 with hxL
  set xR := flowLineXR β₀.fn β₀.jumps 0 with hxR
  set ρL := flowLineRhoL κ β₀.fn β₀.jumps 0 θ with hρL
  set ρR := flowLineRhoR κ β₀.fn β₀.jumps 0 θ with hρR
  set vL : Fin (flowLineNL β₀.fn β₀.jumps 0) → ℝ :=
    fun i => -rightImg (fun s : ℝ => -W s.toNNReal) (-xL i) Q - w' Q with hvL
  set ϱ := rightImg w' 0 Q - w' Q with hϱ
  set ℓ := -rightImg (fun s => -w' s) 0 Q - w' Q with hℓ
  set fR : ℝ → ℝ := fun x => gImg w' x Q - w' Q with hfR
  set fL : ℝ → ℝ := fun x => -gImg (fun s => -w' s) (-x) Q - w' Q with hfL
  set S₀ : Set ℝ := {z₀.L₂, z₀.R₂, z₀.L₁, z₀.M₁, z₀.R₁} ∪ (β₀.jumps : Set ℝ) with hS₀
  have hS₀f : S₀.Finite := (Set.toFinite _).union β₀.jumps.finite_toSet
  refine ⟨{0, ϱ, ℓ, z₁.L₂, z₁.R₂, z₁.L₁, z₁.R₁} ∪ Set.range vL ∪ fR '' S₀ ∪ fL '' S₀,
    (((Set.toFinite _).union (Set.finite_range vL)).union (hS₀f.image fR)).union (hS₀f.image fL), ?_⟩
  intro y hy
  have hyA : ∀ c ∈ ({0, ϱ, ℓ, z₁.L₂, z₁.R₂, z₁.L₁, z₁.R₁} : Set ℝ), y ≠ c := fun c hc h =>
    hy (Or.inl (Or.inl (Or.inl (h ▸ hc))))
  have hy0 : y ≠ 0 := hyA 0 (by simp)
  have hyϱ : y ≠ ϱ := hyA ϱ (by simp)
  have hyℓ : y ≠ ℓ := hyA ℓ (by simp)
  have hyz : y ≠ z₁.L₂ ∧ y ≠ z₁.R₂ ∧ y ≠ z₁.L₁ ∧ y ≠ z₁.R₁ :=
    ⟨hyA _ (by simp), hyA _ (by simp), hyA _ (by simp), hyA _ (by simp)⟩
  have hyv : ∀ i, y ≠ vL i := fun i h => hy (Or.inl (Or.inl (Or.inr ⟨i, h.symm⟩)))
  have hxS₀ : ∀ x, x ∉ S₀ → x ≠ z₀.L₂ ∧ x ≠ z₀.R₂ ∧ x ≠ z₀.L₁ ∧ x ≠ z₀.M₁ ∧ x ≠ z₀.R₁ := fun x hx =>
    ⟨fun h => hx (Or.inl (by simp [h])), fun h => hx (Or.inl (by simp [h])), fun h => hx (Or.inl (by simp [h])),
      fun h => hx (Or.inl (by simp [h])), fun h => hx (Or.inl (by simp [h]))⟩
  have hxJ : ∀ x, x ∉ S₀ → x ∉ β₀.jumps := fun x hx h => hx (Or.inr h)
  have hseed : ∀ x, x ≠ 0 → x ∉ β₀.jumps → forceBoundaryData κ ρL ρR xL xR x = β₀.fn x + θ * χ := by
    intro x hx0 hxJ'
    have h := Exist.forceBoundaryData_flowLine_seed hκ (BoundaryWord.isPiecewiseConstantBoundaryData β₀) 0 θ hx0
      (by rwa [add_zero])
    rwa [add_zero] at h
  have hlam : sleLambda κ = Real.pi / Real.sqrt κ := rfl
  have hfnt : ∀ v, βt.fn v = ((zoneData φ₁ α a β b').word c₀ g₁ g₂ g₃ g₄).fn v := fun v => by
    rw [hβt, zword, BoundaryWord.trunc_fn]
  have hfn0 : ∀ v, β₀.fn v = ((zoneData φ₀ α a β b).word c₀ g₁ g₂ g₃ g₄).trunc.fn v := fun v => by
    rw [hβ₀, zword]
  have hfnt' : ∀ v, βt.fn v = ((zoneData φ₁ α a β b').word c₀ g₁ g₂ g₃ g₄).trunc.fn v := fun v => by
    rw [hβt, zword]
  rcases lt_trichotomy y 0 with hyneg | rfl | hypos
  · rcases lt_trichotomy y ℓ with hyl | rfl | hyl
    · -- left of the image of `0⁻`: a flowed alive negative point
      obtain ⟨xt, hxt0, hxta, hxtg⟩ := exists_alive_gImg_eq hw'n hQr (M := -y - w' Q) (by
        have : y < -rightImg (fun s => -w' s) 0 Q - w' Q := hyl
        linarith)
      have hyx : fL (-xt) = y := by
        simp only [hfL, neg_neg]
        rw [hxtg]
        ring
      have hxS : -xt ∉ S₀ := fun hx => hy (Or.inr ⟨-xt, hx, hyx⟩)
      have hu := WangWu.isForwardSol_neg_of_alive hw'c hxta
      have hu' : QuantumZipper.IsForwardSol w' ((-xt : ℝ) : ℂ) Q
          (fun s => -(cflow (fun s => -w' s) xt s : ℂ)) := by
        rw [Complex.ofReal_neg]; exact hu
      have huQ : (-(cflow (fun s => -w' s) xt Q : ℂ)).re = y := by
        have e : gImg (fun s => -w' s) xt Q = -w' Q + cflow (fun s => -w' s) xt Q := rfl
        simp only [neg_re, ofReal_re]
        linarith
      have hZ := fn_zword_eq_of_isForwardSol (g₁ := g₁) (g₂ := g₂) (g₃ := g₃) (g₄ := g₄) hs₀ hs₁ hbb hg hWc hW0
        hQ hinv himg hc₀ hu' (hxS₀ _ hxS) (by rw [huQ]; exact hyz)
      rw [huQ] at hZ
      have hxL' : ∀ i, -xL i ≠ xt := by
        intro i h
        rcases flowLineXL_eq_zero_or_mem β₀ i with h0 | ⟨-, hm⟩
        · rw [← hxL] at h0
          rw [h0, neg_zero] at h
          exact (lt_irrefl _ (h ▸ hxt0))
        · rw [← hxL] at hm
          have : xL i = -xt := by linarith
          exact hxJ _ hxS (this ▸ hm)
      have hgy : -gImg (fun s => -w' s) xt Q - w' Q = y := by linarith
      have hyv' : ∀ i, -gImg (fun s => -w' s) xt Q - w' Q ≠ -rightImg (fun s => -w' s) (-xL i) Q - w' Q := by
        intro i h
        apply hyv i
        rw [← hgy, h]
      have hF := forceBoundaryData_flow_left ρL ρR (κ := κ) (xR := xR) hw'c hQr hxt0 hxta hxL' hyv'
      rw [hgy] at hF
      have hx0 : -xt ≠ 0 := neg_ne_zero.2 hxt0.ne'
      have hfin : β₀.fn (-xt) + θ * χ = βt.fn y + θ * χ := by rw [hfn0, hfnt', hZ]
      exact hF.trans ((hseed _ hx0 (hxJ _ hxS)).trans hfin)
    · exact absurd rfl hyℓ
    · -- the image of the left side of the new piece
      have hF := forceBoundaryData_flow_slit_left ρL ρR (κ := κ) (xR := xR) hw'c hQr
        (fun i => by
          rcases flowLineXL_eq_zero_or_mem β₀ i with h0 | ⟨h0, -⟩
          · exact h0.le
          · exact h0.le) hyneg hyl
      have hL₂ : z₁.L₂ ≤ ℓ := L₂_le_neg_rightImg_sub hs₀ hs₁ hbb hg hWc hW0 hQ hinv himg'
      have hw : βt.fn y = g₁ := by
        rw [hfnt]
        exact ZW.fn_side₁ hgood₁ hc₀ (by linarith) hyneg
      have hfin : -(Real.pi / Real.sqrt κ) = βt.fn y + θ * χ := by rw [hw, hg₁, hlam]; ring
      exact hF.trans hfin
  · exact absurd rfl hy0
  · rcases lt_trichotomy y ϱ with hyr | rfl | hyr
    · -- the image of the right side of the new piece
      have hF := forceBoundaryData_flow_slit_right ρL ρR (κ := κ) (xL := xL) hw'c hQr
        (fun j => by
          rcases flowLineXR_eq_zero_or_mem β₀ j with h0 | ⟨h0, -⟩
          · exact h0.ge
          · exact h0.le) hypos.le hyr
      have hR₂ : ϱ ≤ z₁.R₂ := rightImg_sub_le_R₂ hs₀ hs₁ hbb hg hWc hW0 hQ hinv himg'
      have hw : βt.fn y = g₂ := by
        rw [hfnt]
        exact ZW.fn_side₂ hgood₁ hc₀ hypos (by linarith)
      have hfin : Real.pi / Real.sqrt κ = βt.fn y + θ * χ := by rw [hw, hg₂, hlam]; ring
      exact hF.trans hfin
    · exact absurd rfl hyϱ
    · -- right of the image of `0⁺`: a flowed alive positive point
      obtain ⟨x, hx0, hxa, hxg⟩ := exists_alive_gImg_eq hw'c hQr (M := y + w' Q) (by
        have : rightImg w' 0 Q - w' Q < y := hyr
        linarith)
      have hyx : fR x = y := by
        simp only [hfR]
        rw [hxg]
        ring
      have hxS : x ∉ S₀ := fun hx => hy (Or.inl (Or.inr ⟨x, hx, hyx⟩))
      have hu := WangWu.isForwardSol_of_alive hw'c hxa
      have huQ : ((cflow w' x Q : ℝ) : ℂ).re = y := by
        have e : gImg w' x Q = w' Q + cflow w' x Q := rfl
        simp only [ofReal_re]
        linarith
      have hZ := fn_zword_eq_of_isForwardSol (g₁ := g₁) (g₂ := g₂) (g₃ := g₃) (g₄ := g₄) hs₀ hs₁ hbb hg hWc hW0
        hQ hinv himg hc₀ hu (hxS₀ _ hxS) (by rw [huQ]; exact hyz)
      rw [huQ] at hZ
      have hxR' : ∀ j, xR j ≠ x := by
        intro j h
        rcases flowLineXR_eq_zero_or_mem β₀ j with h0 | ⟨-, hm⟩
        · rw [← hxR] at h0
          rw [h0] at h
          exact (lt_irrefl _ (h ▸ hx0))
        · rw [← hxR] at hm
          exact hxJ _ hxS (h ▸ hm)
      have hF := forceBoundaryData_flow_right ρL ρR (κ := κ) (xL := xL) hw'c hQr hx0 hxa hxR'
      have hgy : gImg w' x Q - w' Q = y := by linarith
      rw [hgy] at hF
      have hfin : β₀.fn x + θ * χ = βt.fn y + θ * χ := by rw [hfn0, hfnt', hZ]
      exact hF.trans ((hseed _ hx0.ne' (hxJ _ hxS)).trans hfin)

end Main

