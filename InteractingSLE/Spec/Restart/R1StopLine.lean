/-!
# Lemma 7.7's marked locality at the first-contact stopping line: the deterministic part

Packet PROVE-RESTART-CPL6, (R1) (b) "marked locality off the union" of `FirstContactKernelClockStatement`
(specification Lemma 7.7, `source/spec/p241-288.md#lem-7.7-proof`, pp. 282–284: "Let `𝒢_{s,t}` be the sigma-algebra
generated by these two stopped, labelled histories, including whether each terminal time has occurred. […] The
common-first-point hypothesis gives the exact identity (GR1) `{θ*₁ ≤ s, θ*₂ ≤ t} = {T₁ ≤ s, T₂ ≤ t} ∪
{α₁([0, s ∧ T₁]) ∩ α₂([0, t ∧ T₂]) ≠ ∅}`").

The first-contact pair `(σ₁, σ₂)` of two paths is not a pair of sequential stopping times (Lemma 6.2's form, landed
as `Sec6.le_aeSigma_explored`): `σ₁` depends on the whole second path. It is a **stopping line**: by (GR1) the event
`{σ₁ ≤ a}` is read off the two histories through any pair of times `(T₁, T₂) ≥ (σ₁, σ₂)`. This file records the
deterministic facts behind that, in the form used for the locality argument (`R1StopLineLocal.lean`):

* **killed histories** (`khistOf`): the path history through `T` of Lemma 6.2 (`Sec6.histOf`) together with the
  killing record `lifeRec ζ T` ("including whether each terminal time has occurred"), and their restriction to an
  earlier time (`khistRestrict`);
* `IsEntranceKilledHistoryLocal`: Lemma 6.2's history-sensitive locality at first entrance times, with the killing
  record retained (it implies the landed `Sec6.IsEntranceHistoryLocal`), and its determinacy consequence
  `measurable_entranceKHist` ("it is determined by `h_{U^c}` alone");
* **the countable meeting relation** `MeetsQ a b y` of two recorded histories (rational times, finite caps), with
  `meetsQ_histOf_iff`: for continuous paths it is "the prefixes `γ₁([0, a ∧ T₁])`, `γ₂([0, b ∧ T₂])` meet";
* **the reconstruction of the first contact** `recFst`, `recSnd` (measurable on histories) and
  `recFst_eq`/`recSnd_eq`: whenever the first contact `(σ₁, σ₂)` (`⊤` if the paths never meet) lies below the
  recording times, it is recovered from the recorded histories; `rec_le_iff`: the recorded histories decide whether
  it does.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set TopologicalSpace Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Restart

open QuantumZipper (H)
open LQGMetric (DistOn CondIndepEv)
open LocalSets Sec6

/-! ### Killed histories -/

/-- The killing record of a lifetime `ζ` through time `T`: `ζ` if the path is killed by time `T`, `⊤` otherwise. -/
def lifeRec (ζ T : ℝ≥0∞) : ℝ≥0∞ := if ζ ≤ T then ζ else ⊤

/-- Killed histories: a path history `(T, (η(q))_{q ≤ T})` together with a killing record. -/
abbrev KHist : Type := Hist × ℝ≥0∞

/-- The killed history of the coordinates `c` with lifetime `ζ` through `T`. -/
def khistOf (c : ℚ≥0 → ℂ) (ζ T : ℝ≥0∞) : KHist := (histOf c T, lifeRec ζ T)

/-- The restriction of a killed history to the time `σ`. -/
def khistRestrict (k : KHist) (σ : ℝ≥0∞) : KHist := (histOf k.1.2 σ, if k.2 ≤ σ then k.2 else ⊤)

theorem measurable_lifeRec : Measurable fun p : ℝ≥0∞ × ℝ≥0∞ => lifeRec p.1 p.2 :=
  Measurable.ite (measurableSet_le measurable_fst measurable_snd) measurable_fst measurable_const

theorem measurable_khistRestrict : Measurable fun p : KHist × ℝ≥0∞ => khistRestrict p.1 p.2 := by
  refine Measurable.prodMk ?_ ?_
  · exact measurable_histOf.comp (measurable_snd.prodMk (measurable_snd.comp (measurable_fst.comp measurable_fst)))
  · exact Measurable.ite (measurableSet_le (measurable_snd.comp measurable_fst) measurable_snd)
      (measurable_snd.comp measurable_fst) measurable_const

/-- **Restricting a killed history** through `T` to an earlier time `σ ≤ T` gives the killed history through `σ`. -/
theorem khistRestrict_khistOf {c : ℚ≥0 → ℂ} {ζ T σ : ℝ≥0∞} (hσ : σ ≤ T) :
    khistRestrict (khistOf c ζ T) σ = khistOf c ζ σ := by
  unfold khistRestrict khistOf
  refine Prod.ext ?_ ?_
  · show histOf (stopCoord c T) σ = histOf c σ
    unfold histOf
    rw [stopCoord_stopCoord hσ]
  · show (if lifeRec ζ T ≤ σ then lifeRec ζ T else ⊤) = lifeRec ζ σ
    unfold lifeRec
    by_cases hζT : ζ ≤ T
    · simp only [hζT, ↓reduceIte]
    · have hζσ : ¬ ζ ≤ σ := fun h => hζT (h.trans hσ)
      simp only [hζT, hζσ, ↓reduceIte, ite_self]

/-! ### History-sensitive locality with the killing record -/

section Local

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

/-- **The history-sensitive locality of Lemma 6.2 at first entrance times, with the killing record retained**
(Lemma 7.7's proof: "the sigma-algebra generated by these two stopped, labelled histories, including whether each
terminal time has occurred"): for every deterministic open `U ⊆ ℍ` (and Borel version `G` of the projection onto
`H(U)`), with `T^U` the first entrance time of `η` into `U` and `E = {η([0, T^U]) ∩ U = ∅}`, given `h_{U^c}` the pair
`(1_E, (η|_{[0,T^U]}, lifeRec ζ T^U) on E)` is conditionally independent of `h_U`. For a flow line this is the
retained-range law of Aux. lemma 56 at the first entrance stop. -/
def IsEntranceKilledHistoryLocal (η : Ω → ℝ≥0 → ℂ) (ζ : Ω → ℝ≥0∞) (h : Ω → DistOn upperHalfPlaneOpens)
    (P : Measure Ω) : Prop :=
  ∀ (U : Opens ℂ) (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens),
    (U : Set ℂ) ⊆ H → Measurable G →
      GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P →
      CondIndepEv (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance)
        (markedHistSigma {ω | AvoidsUpTo (η ω) (firstEntrance U (pathCoord (η ω))) U}
          (fun ω => khistOf (pathCoord (η ω)) (ζ ω) (firstEntrance U (pathCoord (η ω)))))
        (MeasurableSpace.comap (fun ω => G (h ω)) inferInstance) P

/-- Forgetting the killing record gives Lemma 6.2's hypothesis. -/
theorem IsEntranceKilledHistoryLocal.isEntranceHistoryLocal {η : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞}
    {h : Ω → DistOn upperHalfPlaneOpens} (hloc : IsEntranceKilledHistoryLocal η ζ h P) :
    IsEntranceHistoryLocal η h P := by
  intro U G hUH hG hd
  refine (hloc U G hUH hG hd).mono ?_ le_rfl
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨B, hB, rfl⟩
  exact MeasurableSpace.measurableSet_generateFrom ⟨Prod.fst ⁻¹' B, measurable_fst hB, rfl⟩

variable [IsProbabilityMeasure P] {h : Ω → DistOn upperHalfPlaneOpens}

/-- **"It is determined by `h_{U^c}` alone"**, with the killing record: for a continuous field-determined path started
outside the open `U ⊆ ℍ`, with a field-determined lifetime, history-sensitively local at `T^U`, the killed history
through `T^U` is measurable for the σ-algebra of events almost surely equal to events of `σ(h_{U^c})` (the proof of
`Sec6.measurable_entranceHist`, with the killing record added). -/
theorem measurable_entranceKHist (hhm : Measurable h) {η : Ω → ℝ≥0 → ℂ} {ζ : Ω → ℝ≥0∞}
    (hc : ∀ ω, Continuous (η ω)) (hηm : ∀ t, Measurable fun ω => η ω t) (hζm : Measurable ζ)
    (hdet : ∀ t : ℝ≥0, ∃ f : DistOn upperHalfPlaneOpens → ℂ, Measurable f ∧
      (fun ω => η ω t) =ᵐ[P] fun ω => f (h ω))
    (hdetζ : ∃ f : DistOn upperHalfPlaneOpens → ℝ≥0∞, Measurable f ∧ ζ =ᵐ[P] fun ω => f (h ω))
    (hloc : IsEntranceKilledHistoryLocal η ζ h P) (U : Opens ℂ)
    (G : DistOn upperHalfPlaneOpens → DistOn upperHalfPlaneOpens) (hUH : (U : Set ℂ) ⊆ H)
    (hG : Measurable G) (hd : GFF.IsMarkovDecomposition U upperHalfPlaneOpens h (fun ω => G (h ω)) P)
    (h0 : ∀ ω, η ω 0 ∉ U) :
    Measurable[aeSigma (MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance) P]
      (fun ω => khistOf (pathCoord (η ω)) (ζ ω) (firstEntrance U (pathCoord (η ω)))) := by
  set Y : Ω → KHist := fun ω => khistOf (pathCoord (η ω)) (ζ ω) (firstEntrance U (pathCoord (η ω)))
    with hYdef
  have hcm : Measurable fun ω => pathCoord (η ω) := Measurable.of_eval fun q => hηm q
  have hFm := measurable_firstEntrance U.isOpen.measurableSet
  have hkm : Measurable fun p : (ℚ≥0 → ℂ) × ℝ≥0∞ =>
      khistOf p.1 p.2 (firstEntrance U p.1) :=
    (measurable_histOf.comp ((hFm.comp measurable_fst).prodMk measurable_fst)).prodMk
      (measurable_lifeRec.comp (measurable_snd.prodMk (hFm.comp measurable_fst)))
  have hYm : Measurable Y := hkm.comp (hcm.prodMk hζm)
  have hE : {ω | AvoidsUpTo (η ω) (firstEntrance U (pathCoord (η ω))) U} = univ := by
    ext ω
    simp only [mem_ofPred_eq, mem_univ, iff_true]
    exact fun t ht => notMem_of_le_firstEntrance U.isOpen (hc ω) (h0 ω) ht
  have hci := hloc U G hUH hG hd
  rw [hE] at hci
  -- the field determines `Y`
  choose f hf hfh using fun q : ℚ≥0 => hdet (q : ℝ≥0)
  obtain ⟨fζ, hfζ, hfζh⟩ := hdetζ
  have hfm : Measurable fun T : DistOn upperHalfPlaneOpens => fun q => f q T :=
    Measurable.of_eval fun q => hf q
  have hΨm := hkm.comp (hfm.prodMk hfζ)
  dsimp only [Function.comp_def] at hΨm
  set Ψ : DistOn upperHalfPlaneOpens → KHist := fun T =>
    khistOf (fun q => f q T) (fζ T) (firstEntrance U (fun q => f q T)) with hΨdef
  have hYΨ : Y =ᵐ[P] fun ω => Ψ (h ω) := by
    have hall : ∀ᵐ ω ∂P, ∀ q : ℚ≥0, η ω q = f q (h ω) := ae_all_iff.2 hfh
    filter_upwards [hall, hfζh] with ω hω hωζ
    have e : pathCoord (η ω) = fun q => f q (h ω) := funext hω
    show khistOf (pathCoord (η ω)) (ζ ω) (firstEntrance U (pathCoord (η ω))) =
      khistOf (fun q => f q (h ω)) (fζ (h ω)) (firstEntrance U (fun q => f q (h ω)))
    rw [e, hωζ]
  intro B hB
  have hb : MeasurableSet[markedHistSigma univ Y] (Y ⁻¹' B) :=
    MeasurableSpace.measurableSet_generateFrom ⟨B, hB, by rw [univ_inter]⟩
  have hMle : markedHistSigma univ Y ≤ mΩ := by
    refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨B', hB', rfl⟩
    exact MeasurableSet.univ.inter (hYm hB')
  have h𝓗 : MeasurableSpace.comap (fun ω => markovCompl G (h ω)) inferInstance ≤ mΩ :=
    ((measurable_markovCompl hG).comp hhm).comap_le
  have h𝓑 : MeasurableSpace.comap (fun ω => G (h ω)) inferInstance ≤ mΩ := (hG.comp hhm).comap_le
  obtain ⟨b', hb', hbb'⟩ := exists_measurableSet_ae_eq_of_condIndepEv h𝓗 h𝓑 hMle hci.symm hb
    ⟨h ⁻¹' (Ψ ⁻¹' B), comap_le_sup_markov (G := G) _ ⟨Ψ ⁻¹' B, hΨm hB, rfl⟩, by
      filter_upwards [hYΨ] with ω hω
      simp only [mem_preimage, hω]⟩
  exact ⟨b', hb', hbb'⟩

end Local

/-! ### Rational approximation and compactness -/

/-- A continuous path is approximated at a rational time not after `t`. -/
theorem exists_rat_le_dist_lt {γ : ℝ≥0 → ℂ} (hγ : Continuous γ) (t : ℝ≥0) {ε : ℝ} (hε : 0 < ε) :
    ∃ q : ℚ≥0, ((q : ℝ≥0)) ≤ t ∧ dist (γ q) (γ t) < ε :=
  exists_rat_le_mem Metric.isOpen_ball hγ (Metric.mem_ball_self hε)

/-- Between a nonnegative real and a larger extended real there is a rational. -/
theorem exists_rat_ge_lt {s : ℝ≥0} {c : ℝ≥0∞} (hsc : (s : ℝ≥0∞) < c) :
    ∃ q : ℚ≥0, s ≤ (q : ℝ≥0) ∧ (((q : ℝ≥0) : ℝ≥0∞)) < c := by
  obtain ⟨r, hsr, hrc⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 hsc
  rw [ENNReal.coe_lt_coe] at hsr
  obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show (s : ℝ) < r from hsr)
  have hq0 : (0 : ℝ) ≤ q := (NNReal.coe_nonneg s).trans hq1.le
  set q' : ℚ≥0 := q.toNNRat with hq'def
  have hqt : ((q' : ℝ≥0) : ℝ) = q := by
    rw [show ((q' : ℝ≥0) : ℝ) = ((q' : ℚ) : ℝ) by norm_cast, hq'def,
      Rat.coe_toNNRat q (by exact_mod_cast hq0)]
  refine ⟨q', ?_, ?_⟩
  · rw [← NNReal.coe_le_coe, hqt]; exact hq1.le
  · refine lt_of_lt_of_le ?_ hrc.le
    rw [ENNReal.coe_lt_coe, ← NNReal.coe_lt_coe, hqt]; exact hq2

/-- **The infimum of the rationals above `s`** is `s`. -/
theorem iInf_rat_ge (s : ℝ≥0) :
    ⨅ (q : ℚ≥0) (_ : s ≤ (q : ℝ≥0)), (((q : ℝ≥0) : ℝ≥0∞)) = s := by
  refine le_antisymm ?_ (le_iInf₂ fun q hq => ENNReal.coe_le_coe.2 hq)
  refine le_of_forall_gt_imp_ge_of_dense fun c hc => ?_
  obtain ⟨q, hq1, hq2⟩ := exists_rat_ge_lt hc
  exact (iInf₂_le q hq1).trans hq2.le

/-- The nonnegative reals `s ≤ a`, `s ≤ T`, `s ≤ N` form a compact set. -/
theorem isCompact_capSet (a T : ℝ≥0∞) (N : ℝ≥0) :
    IsCompact {s : ℝ≥0 | (s : ℝ≥0∞) ≤ a ∧ (s : ℝ≥0∞) ≤ T ∧ s ≤ N} := by
  have hK : IsCompact (Iic N) := by rw [← Set.Icc_bot]; exact isCompact_Icc
  refine hK.of_isClosed_subset ?_ fun s hs => hs.2.2
  exact (isClosed_le ENNReal.continuous_coe continuous_const).inter
    ((isClosed_le ENNReal.continuous_coe continuous_const).inter (isClosed_Iic (a := N)))

/-! ### The countable meeting relation of two recorded histories -/

/-- **Two recorded prefixes meet**, read at rational times: with `y = ((T₁, c₁), (T₂, c₂))`, for some cap `N`,
points `c₁(q₁)`, `c₂(q₂)` with `q₁ ≤ a ∧ T₁ ∧ N`, `q₂ ≤ b ∧ T₂ ∧ N` come arbitrarily close. For continuous paths
this is "`γ₁([0, a ∧ T₁])` and `γ₂([0, b ∧ T₂])` meet at finite parameters" (`meetsQ_histOf_iff`). -/
def MeetsQ (a b : ℝ≥0∞) (y : Hist × Hist) : Prop :=
  ∃ N : ℕ, ∀ m : ℕ, ∃ q₁ q₂ : ℚ≥0, (((q₁ : ℝ≥0) : ℝ≥0∞)) ≤ a ∧
    ((((q₁ : ℝ≥0) : ℝ≥0∞)) ≤ y.1.1 ∧ ((q₁ : ℝ≥0) ≤ N ∧ ((((q₂ : ℝ≥0) : ℝ≥0∞)) ≤ b ∧
      ((((q₂ : ℝ≥0) : ℝ≥0∞)) ≤ y.2.1 ∧ ((q₂ : ℝ≥0) ≤ N ∧
        dist (y.1.2 q₁) (y.2.2 q₂) < 1 / ((m : ℝ) + 1))))))

theorem measurableSet_meetsQ (a b : ℝ≥0∞) : MeasurableSet {y : Hist × Hist | MeetsQ a b y} := by
  simp only [MeetsQ, ofPred_exists, ofPred_forall, ofPred_and]
  refine MeasurableSet.iUnion fun N => MeasurableSet.iInter fun m => MeasurableSet.iUnion fun q₁ =>
    MeasurableSet.iUnion fun q₂ => ?_
  have hT₁ : Measurable fun y : Hist × Hist => y.1.1 := measurable_fst.comp measurable_fst
  have hT₂ : Measurable fun y : Hist × Hist => y.2.1 := measurable_fst.comp measurable_snd
  have hc₁ : Measurable fun y : Hist × Hist => y.1.2 q₁ :=
    (measurable_pi_apply q₁).comp (measurable_snd.comp measurable_fst)
  have hc₂ : Measurable fun y : Hist × Hist => y.2.2 q₂ :=
    (measurable_pi_apply q₂).comp (measurable_snd.comp measurable_snd)
  exact (MeasurableSet.const _).inter ((measurableSet_le measurable_const hT₁).inter
    ((MeasurableSet.const _).inter ((MeasurableSet.const _).inter ((measurableSet_le measurable_const hT₂).inter
      ((MeasurableSet.const _).inter (measurableSet_lt (hc₁.dist hc₂) measurable_const))))))

/-- **The countable meeting relation is the meeting of the prefixes** for continuous paths. -/
theorem meetsQ_histOf_iff {γ₁ γ₂ : ℝ≥0 → ℂ} (hγ₁ : Continuous γ₁) (hγ₂ : Continuous γ₂)
    (a b T₁ T₂ : ℝ≥0∞) :
    MeetsQ a b (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) ↔
      ∃ s t : ℝ≥0, (s : ℝ≥0∞) ≤ a ∧ (s : ℝ≥0∞) ≤ T₁ ∧ (t : ℝ≥0∞) ≤ b ∧ (t : ℝ≥0∞) ≤ T₂ ∧ γ₁ s = γ₂ t := by
  -- the recorded coordinates below the recording times are the path values
  have hv₁ : ∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞)) ≤ T₁ →
      (histOf (pathCoord γ₁) T₁).2 q = γ₁ q := fun q hq => stopCoord_of_le hq
  have hv₂ : ∀ q : ℚ≥0, (((q : ℝ≥0) : ℝ≥0∞)) ≤ T₂ →
      (histOf (pathCoord γ₂) T₂).2 q = γ₂ q := fun q hq => stopCoord_of_le hq
  constructor
  · rintro ⟨N, hN⟩
    by_contra hno
    push Not at hno
    set S₁ : Set ℝ≥0 := {s | (s : ℝ≥0∞) ≤ a ∧ (s : ℝ≥0∞) ≤ T₁ ∧ s ≤ (N : ℝ≥0)} with hS₁
    set S₂ : Set ℝ≥0 := {t | (t : ℝ≥0∞) ≤ b ∧ (t : ℝ≥0∞) ≤ T₂ ∧ t ≤ (N : ℝ≥0)} with hS₂
    have hK : IsCompact (S₁ ×ˢ S₂) := (isCompact_capSet a T₁ N).prod (isCompact_capSet b T₂ N)
    -- the compact set is nonempty: some admissible pair is recorded
    obtain ⟨q₁, q₂, h1, h2, h3, h4, h5, h6, -⟩ := hN 0
    have hne : (S₁ ×ˢ S₂).Nonempty := ⟨((q₁ : ℝ≥0), (q₂ : ℝ≥0)), ⟨h1, h2, h3⟩, h4, h5, h6⟩
    have hF : ContinuousOn (fun p : ℝ≥0 × ℝ≥0 => dist (γ₁ p.1) (γ₂ p.2)) (S₁ ×ˢ S₂) :=
      ((hγ₁.comp continuous_fst).dist (hγ₂.comp continuous_snd)).continuousOn
    obtain ⟨p₀, hp₀, hmin⟩ := hK.exists_isMinOn hne hF
    have hδ : 0 < dist (γ₁ p₀.1) (γ₂ p₀.2) := by
      refine dist_pos.2 fun he => ?_
      exact hno p₀.1 p₀.2 hp₀.1.1 hp₀.1.2.1 hp₀.2.1 hp₀.2.2.1 he
    obtain ⟨m, hm⟩ := exists_nat_one_div_lt hδ
    obtain ⟨r₁, r₂, g1, g2, g3, g4, g5, g6, g7⟩ := hN m
    have hmem : ((r₁ : ℝ≥0), (r₂ : ℝ≥0)) ∈ S₁ ×ˢ S₂ := ⟨⟨g1, g2, g3⟩, g4, g5, g6⟩
    have hle := isMinOn_iff.1 hmin _ hmem
    simp only at hle
    rw [hv₁ r₁ g2, hv₂ r₂ g5] at g7
    linarith
  · rintro ⟨s, t, hsa, hsT, htb, htT, he⟩
    obtain ⟨N, hN⟩ := exists_nat_ge (max (s : ℝ) t)
    refine ⟨N, fun m => ?_⟩
    have hε : (0 : ℝ) < 1 / ((m : ℝ) + 1) / 2 := by positivity
    obtain ⟨q₁, hq₁s, hd₁⟩ := exists_rat_le_dist_lt hγ₁ s hε
    obtain ⟨q₂, hq₂t, hd₂⟩ := exists_rat_le_dist_lt hγ₂ t hε
    have hq₁s' : (((q₁ : ℝ≥0) : ℝ≥0∞)) ≤ s := ENNReal.coe_le_coe.2 hq₁s
    have hq₂t' : (((q₂ : ℝ≥0) : ℝ≥0∞)) ≤ t := ENNReal.coe_le_coe.2 hq₂t
    have hsN : (q₁ : ℝ≥0) ≤ (N : ℝ≥0) := by
      rw [← NNReal.coe_le_coe]; push_cast
      exact ((NNReal.coe_le_coe.2 hq₁s).trans (le_max_left _ _)).trans hN
    have htN : (q₂ : ℝ≥0) ≤ (N : ℝ≥0) := by
      rw [← NNReal.coe_le_coe]; push_cast
      exact ((NNReal.coe_le_coe.2 hq₂t).trans (le_max_right _ _)).trans hN
    refine ⟨q₁, q₂, hq₁s'.trans hsa, hq₁s'.trans hsT, hsN, hq₂t'.trans htb, hq₂t'.trans htT, htN, ?_⟩
    show dist ((histOf (pathCoord γ₁) T₁).2 q₁) ((histOf (pathCoord γ₂) T₂).2 q₂) < _
    rw [hv₁ q₁ (hq₁s'.trans hsT), hv₂ q₂ (hq₂t'.trans htT)]
    calc dist (γ₁ q₁) (γ₂ q₂) ≤ dist (γ₁ q₁) (γ₁ s) + dist (γ₁ s) (γ₂ q₂) := dist_triangle _ _ _
      _ = dist (γ₁ q₁) (γ₁ s) + dist (γ₂ q₂) (γ₂ t) := by rw [he, dist_comm (γ₂ t)]
      _ < 1 / ((m : ℝ) + 1) / 2 + 1 / ((m : ℝ) + 1) / 2 := add_lt_add hd₁ hd₂
      _ = 1 / ((m : ℝ) + 1) := by ring

/-! ### Reconstruction of the first contact from recorded histories -/

/-- The first-contact time of the first path, read from two recorded histories: the infimum of the rational `q`
such that the first prefix through `q` meets the second recorded prefix. -/
def recFst (y : Hist × Hist) : ℝ≥0∞ :=
  ⨅ (q : ℚ≥0) (_ : MeetsQ (((q : ℝ≥0) : ℝ≥0∞)) ⊤ y), (((q : ℝ≥0) : ℝ≥0∞))

/-- The first-contact time of the second path, read from two recorded histories. -/
def recSnd (y : Hist × Hist) : ℝ≥0∞ :=
  ⨅ (q : ℚ≥0) (_ : MeetsQ ⊤ (((q : ℝ≥0) : ℝ≥0∞)) y), (((q : ℝ≥0) : ℝ≥0∞))

theorem measurable_iInf_rat {p : ℚ≥0 → Hist × Hist → Prop} (hp : ∀ q, MeasurableSet {y | p q y}) :
    Measurable fun y => ⨅ (q : ℚ≥0) (_ : p q y), (((q : ℝ≥0) : ℝ≥0∞)) := by
  classical
  refine Measurable.iInf fun q => ?_
  have : (fun y => ⨅ (_ : p q y), (((q : ℝ≥0) : ℝ≥0∞))) =
      fun y => if p q y then (((q : ℝ≥0) : ℝ≥0∞)) else ⊤ := by
    funext y
    by_cases h : p q y
    · rw [ite_eq_left h, iInf_pos h]
    · rw [ite_eq_right h, iInf_neg h]
  rw [this]
  exact Measurable.ite (hp q) measurable_const measurable_const

theorem measurable_recFst : Measurable recFst :=
  measurable_iInf_rat fun _ => measurableSet_meetsQ _ _

theorem measurable_recSnd : Measurable recSnd :=
  measurable_iInf_rat fun _ => measurableSet_meetsQ _ _

/-- **The first-contact pair of two paths on `[0, ∞)`** (finite parameters; Lemma 7.7's convention "if there is no
finite contact, both contact parameters are infinite"): either a first contact `(s₀, t₀)` exists (`IsFirstContact`
with infinite lifetimes) and `σ = (s₀, t₀)`, or the paths never meet and `σ = (⊤, ⊤)`. -/
def IsFCPair (γ₁ γ₂ : ℝ≥0 → ℂ) (σ₁ σ₂ : ℝ≥0∞) : Prop :=
  (∃ s₀ t₀ : ℝ≥0, IsFirstContact γ₁ ⊤ γ₂ ⊤ s₀ t₀ ∧ σ₁ = s₀ ∧ σ₂ = t₀) ∨
    ((∀ s t : ℝ≥0, γ₁ s ≠ γ₂ t) ∧ σ₁ = ⊤ ∧ σ₂ = ⊤)

theorem iInf_rat_eq_top {p : ℚ≥0 → Prop} (hp : ∀ q, ¬ p q) :
    ⨅ (q : ℚ≥0) (_ : p q), (((q : ℝ≥0) : ℝ≥0∞)) = ⊤ :=
  eq_top_iff.2 (le_iInf₂ fun q hq => absurd hq (hp q))

section Rec

variable {γ₁ γ₂ : ℝ≥0 → ℂ} (hγ₁ : Continuous γ₁) (hγ₂ : Continuous γ₂) {σ₁ σ₂ : ℝ≥0∞}
  (hσ : IsFCPair γ₁ γ₂ σ₁ σ₂) {T₁ T₂ : ℝ≥0∞}
include hγ₁ hγ₂ hσ

/-- **The recorded histories recover the first contact** whenever it lies below the recording times. -/
theorem rec_eq (hT₁ : σ₁ ≤ T₁) (hT₂ : σ₂ ≤ T₂) :
    recFst (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) = σ₁ ∧
      recSnd (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) = σ₂ := by
  rcases hσ with ⟨s₀, t₀, hfc, rfl, rfl⟩ | ⟨hno, rfl, rfl⟩
  · constructor
    · have e : ∀ q : ℚ≥0, MeetsQ (((q : ℝ≥0) : ℝ≥0∞)) ⊤
          (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) ↔ s₀ ≤ (q : ℝ≥0) := by
        intro q
        rw [meetsQ_histOf_iff hγ₁ hγ₂]
        constructor
        · rintro ⟨s, t, hsq, -, -, -, he⟩
          exact ((hfc.2.2.2 s t le_top le_top he).1).trans (ENNReal.coe_le_coe.1 hsq)
        · intro hq
          exact ⟨s₀, t₀, ENNReal.coe_le_coe.2 hq, hT₁, le_top, hT₂, hfc.2.2.1⟩
      unfold recFst
      simp_rw [e]
      exact iInf_rat_ge s₀
    · have e : ∀ q : ℚ≥0, MeetsQ ⊤ (((q : ℝ≥0) : ℝ≥0∞))
          (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) ↔ t₀ ≤ (q : ℝ≥0) := by
        intro q
        rw [meetsQ_histOf_iff hγ₁ hγ₂]
        constructor
        · rintro ⟨s, t, -, -, htq, -, he⟩
          exact ((hfc.2.2.2 s t le_top le_top he).2).trans (ENNReal.coe_le_coe.1 htq)
        · intro hq
          exact ⟨s₀, t₀, le_top, hT₁, ENNReal.coe_le_coe.2 hq, hT₂, hfc.2.2.1⟩
      unfold recSnd
      simp_rw [e]
      exact iInf_rat_ge t₀
  · constructor
    · refine iInf_rat_eq_top fun q hq => ?_
      obtain ⟨s, t, -, -, -, -, he⟩ := (meetsQ_histOf_iff hγ₁ hγ₂ _ _ _ _).1 hq
      exact hno s t he
    · refine iInf_rat_eq_top fun q hq => ?_
      obtain ⟨s, t, -, -, -, -, he⟩ := (meetsQ_histOf_iff hγ₁ hγ₂ _ _ _ _).1 hq
      exact hno s t he

/-- **The recorded histories decide whether the first contact lies below the recording times** ((GR1): "any visible
intersection occurs no earlier than either global first intersection; conversely, if both first intersection times
have occurred, their common point is visible"). -/
theorem rec_le_iff :
    (σ₁ ≤ T₁ ∧ σ₂ ≤ T₂) ↔
      (recFst (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) ≤ T₁ ∧
        recSnd (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) ≤ T₂) := by
  constructor
  · rintro ⟨h₁, h₂⟩
    obtain ⟨e₁, e₂⟩ := rec_eq hγ₁ hγ₂ hσ h₁ h₂
    rw [e₁, e₂]
    exact ⟨h₁, h₂⟩
  · rintro ⟨h₁, h₂⟩
    -- a visible meeting forces the first contact below the recording times
    have hvis : (∃ s t : ℝ≥0, (s : ℝ≥0∞) ≤ T₁ ∧ (t : ℝ≥0∞) ≤ T₂ ∧ γ₁ s = γ₂ t) → σ₁ ≤ T₁ ∧ σ₂ ≤ T₂ := by
      rintro ⟨s, t, hs, ht, he⟩
      rcases hσ with ⟨s₀, t₀, hfc, rfl, rfl⟩ | ⟨hno, -, -⟩
      · obtain ⟨a, b⟩ := hfc.2.2.2 s t le_top le_top he
        exact ⟨(ENNReal.coe_le_coe.2 a).trans hs, (ENNReal.coe_le_coe.2 b).trans ht⟩
      · exact absurd he (hno s t)
    by_cases hf : recFst (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) < ⊤
    · unfold recFst at hf
      obtain ⟨q, hq⟩ := iInf_lt_iff.1 hf
      obtain ⟨hq', -⟩ := iInf_lt_iff.1 hq
      obtain ⟨s, t, -, hs, -, ht, he⟩ := (meetsQ_histOf_iff hγ₁ hγ₂ _ _ _ _).1 hq'
      exact hvis ⟨s, t, hs, ht, he⟩
    by_cases hs : recSnd (histOf (pathCoord γ₁) T₁, histOf (pathCoord γ₂) T₂) < ⊤
    · unfold recSnd at hs
      obtain ⟨q, hq⟩ := iInf_lt_iff.1 hs
      obtain ⟨hq', -⟩ := iInf_lt_iff.1 hq
      obtain ⟨s, t, -, hs', -, ht, he⟩ := (meetsQ_histOf_iff hγ₁ hγ₂ _ _ _ _).1 hq'
      exact hvis ⟨s, t, hs', ht, he⟩
    rw [not_lt, top_le_iff] at hf hs
    rw [hf, top_le_iff] at h₁
    rw [hs, top_le_iff] at h₂
    rw [h₁, h₂]
    exact ⟨le_top, le_top⟩

end Rec

end Restart

end InteractingSLE
