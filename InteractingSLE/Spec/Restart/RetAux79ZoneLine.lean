import InteractingSLE.Spec.Restart.RetAux79Zone
import InteractingSLE.Spec.Restart.RetAux79Chart

/-!
# The later-line facts of the retained continuation for retained data (pathwise)

Packet PROVE-RETAUX79B. `RetAux79.hasSafeLaw_of_retLines` (PROVE-RETAUX79) needs, at every deterministic later line
`t` (the pair `(u, r + t)`, capacity time `Q`), the chart composition (III-a) and the boundary-data identity (III-b′)
for the stop-line retained data `d` and the later retained data `d'` (`d` with the second cutoff `r + t`). This file
combines (III-a) (`retChart_trans_of_image`) with (III-b′) (`forceBoundaryData_eq_zword_add`) and LEMMA76G's
identification of the measurable word with the zone word at a disjoint pair (`Lemma76G.wordM_eq_of_setting`):

* **`retLine_facts`**: at a point `ω` of both chart events where both pairs are disjoint-pair settings of the same two
  paths, and the continuation's chart path `γ` (generated by a continuous driver `W`, simple, `0 < Q` before its
  lifetime) traces `η₂([r, r + t])` through the stop-line chart inverse and ends at the later tip: the later chart is
  the stop-line chart followed by `f_Q` (inverse and lift), and the force data of the flow-line word of the stop-line
  word `wordM d …` at the flowed marks equal the later word `wordM d' …` plus `θχ` off a finite set. These are the
  last three conjuncts of `hline` in `ae_hmean_of_lines` / `hasSafeLaw_of_retLines`.
-/

set_option autoImplicit false

noncomputable section

open Complex Set Filter Topology
open scoped NNReal ENNReal

open QuantumZipper (H Hbar fwdMap fwdMapInv fwdHull logDerivFwd)

namespace InteractingSLE

namespace Restart.RetAux79

open Sec7 Sec7.Lemma76G Supp7 MartChar.RealFlow

/-- **The later-line facts for retained data** ((III-a) and (III-b′) at a later disjoint pair). See the module
docstring. -/
theorem retLine_facts {Ω : Type*} [MeasurableSpace Ω] {d d' : RetData Ω} (hd : d.IsMeasGood)
    (hd' : d'.IsMeasGood) (h₁ : d'.η₁ = d.η₁) (h₂ : d'.η₂ = d.η₂) (hu : d'.u = d.u) {t : ℝ≥0}
    (hr : d'.r = d.r + t) {ω : Ω} (hω : ω ∈ d.E) (hω' : ω ∈ d'.E) {α β : ℝ≥0 → ℂ} {ζ₁ ζ₂ : ℝ≥0∞} {x₁ x₂ : ℝ}
    (hs₀ : IsSetting α ζ₁ x₁ d.u β ζ₂ x₂ d.r (d.fwd ω) (d.inv ω) (d.lift ω))
    (hs₁ : IsSetting α ζ₁ x₁ d.u β ζ₂ x₂ (d.r + t) (d'.fwd ω) (d'.inv ω) (d'.lift ω))
    (hα : ∀ s ≤ d.u, d.η₁ ω s = α s) (hβ : ∀ s ≤ d.r + t, d.η₂ ω s = β s) {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ}
    {ζc : ℝ≥0∞} {Q : ℝ≥0} (hg : IsGeneratingTrace W ζc γ) (hWc : Continuous W) (hW0 : W 0 = 0)
    (hinj : InjOn γ {s | (s : ℝ≥0∞) ≤ ζc}) (hQ : (Q : ℝ≥0∞) < ζc) (hQ0 : 0 < Q)
    (himg : (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₂ ω '' Icc d.r (d.r + t))
    (htip : d.inv ω (γ Q) = d.η₂ ω (d.r + t)) {c₀ : BoundaryWord} (hc₀ : StrictMonoOn c₀.2.1 (Iio c₀.1))
    {κ : ℝ} (hκ : 0 < κ) (θ g₃ g₄ : ℝ) {B₀ Bt : BoundaryWord}
    (hB₀ : B₀ = Lemma76G.wordM d c₀ (-sleLambda κ - θ * QuantumZipper.chiC κ)
      (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄ ω)
    (hBt : Bt = Lemma76G.wordM d' c₀ (-sleLambda κ - θ * QuantumZipper.chiC κ)
      (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄ ω) :
    (∀ w ∈ H, (d'.chart ω).2.1 w = (d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)) ∧
    (∀ w ∈ H, (d'.chart ω).2.2 ((d'.chart ω).2.1 w) =
      (logDerivFwd (fun s : ℝ => W s.toNNReal) Q (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w)).im +
        (d.chart ω).2.2 ((d.chart ω).2.1 (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w))) ∧
    ∃ S : Set ℝ, S.Finite ∧ ∀ y ∉ S,
      forceBoundaryData κ (flowLineRhoL κ B₀.fn B₀.jumps 0 θ) (flowLineRhoR κ B₀.fn B₀.jumps 0 θ)
          (fun i => -rightImg (fun s : ℝ => -W s.toNNReal) (-flowLineXL B₀.fn B₀.jumps 0 i) Q - W Q)
          (fun j => rightImg (fun s : ℝ => W s.toNNReal) (flowLineXR B₀.fn B₀.jumps 0 j) Q - W Q) y =
        Bt.fn y + θ * QuantumZipper.chiC κ := by
  obtain ⟨hinv, hlift⟩ := retChart_trans_of_image hd hd' h₁ h₂ hu hr hω hω' hg hWc hW0 hinj hQ hQ0 himg htip
  refine ⟨hinv, hlift, ?_⟩
  have hinv' : ∀ w ∈ H, d'.inv ω w = d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q w) := by
    rw [RetData.chart_of_mem hω, RetData.chart_of_mem hω'] at hinv
    exact hinv
  have hw₀ := wordM_eq_of_setting hd hω hs₀ hα (fun s hs => hβ s (hs.trans le_self_add)) hc₀
    (-sleLambda κ - θ * QuantumZipper.chiC κ) (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄
  have hs₁' : IsSetting α ζ₁ x₁ d'.u β ζ₂ x₂ d'.r (d'.fwd ω) (d'.inv ω) (d'.lift ω) := by
    rw [hu, hr]; exact hs₁
  have hw₁ := wordM_eq_of_setting hd' hω' hs₁' (fun s hs => by rw [h₁]; exact hα s (hu ▸ hs))
    (fun s hs => by rw [h₂]; exact hβ s (hr ▸ hs)) hc₀
    (-sleLambda κ - θ * QuantumZipper.chiC κ) (sleLambda κ - θ * QuantumZipper.chiC κ) g₃ g₄
  rw [hu, hr] at hw₁
  have himg' : (fun s => d.inv ω (γ s)) '' Icc 0 Q = β '' Icc d.r (d.r + t) := by
    rw [himg]
    exact image_congr fun s hs => hβ s hs.2
  exact forceBoundaryData_eq_zword_add hκ θ g₃ g₄ hs₀ hs₁ le_self_add hg hWc hW0 hQ hinv' himg' hc₀
    (hB₀.trans hw₀) (hBt.trans hw₁)

end Restart.RetAux79

end InteractingSLE
