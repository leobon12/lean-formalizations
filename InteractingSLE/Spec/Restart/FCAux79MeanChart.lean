/-!
# Aux. 79 at the later first-contact lines: the composed chart

Packet PROVE-FCAUX79 (PROVE-FCDET §4.1 item 4; spec pp. 289–290, Aux. lemma 79). At a first contact `(s₀, t₀)` of
two simple paths, with the first-contact chart `(φ, ψ, ℓ) = (d.fwd ω, d.inv ω, d.lift ω)` of `Restart.PairData`, the
continuation of the first path after `s₀` is read in the chart as a simple path `γ` from `0`, generated by a
continuous Loewner driver `W` in its capacity clock. At the later line `(s₀ + t, t₀)` the union is
`P = η₁([0, s₀ + t]) ∪ η₂([0, t₀])` (`lineK`), and `γ([0, Q])` is the chart image of the new piece `η₁([s₀, s₀ + t])`.

This file proves the deterministic geometry of the **composed chart** `ψ_t = ψ ∘ f_Q⁻¹` of the later domain
`D_t = ℍ \ fill(P)`:

* `IsFCLine` collects the pathwise hypotheses (good paths, the chart path and its image);
* `IsFCLine.fwd_mem`, `IsFCLine.inv_mem`, `IsFCLine.bijOn_inv`: `φ` maps `D_t` into `ℍ \ K_Q`, `ψ ∘ f_Q⁻¹` maps `ℍ`
  bijectively onto `D_t`;
* `IsFCLine.eqOn_mapOut`, `IsFCLine.lift_eq`: on `D_t`, `f_Q ∘ φ` is the hydrodynamic map of `fill(P)` up to a real
  constant, and the canonical derivative argument of `fill(P)` is `Im log f_Q′ ∘ φ + ℓ` (the chain rule of the
  canonical logarithms, as in `RetAux79.chartComp_of_trace`).
-/

set_option autoImplicit false

noncomputable section

open Complex Set Metric Filter Topology
open scoped NNReal ENNReal
open QuantumZipper (H Hbar fwdMap fwdMapInv fwdHull logDerivFwd)

namespace InteractingSLE

namespace Restart.FCAux79

open Sec7 Sec7.SideHeightBox Supp7

variable {Ω : Type*} {d : PairData Ω} {ω : Ω} {x₁ x₂ : ℝ} {t : ℝ≥0}
  {W : ℝ≥0 → ℝ} {γ : ℝ≥0 → ℂ} {ζc : ℝ≥0∞} {Q : ℝ≥0}

/-- **The later line union** `η₁([0, s₀ + t]) ∪ η₂([0, t₀])` of the first-contact pair data. -/
def lineK (d : PairData Ω) (t : ℝ≥0) (ω : Ω) : Set ℂ :=
  prefixSet (d.η₁ ω) (d.s₀ ω + t) (d.η₂ ω) (d.t₀ ω)

/-- **The first-contact continuation at the later line `(s₀ + t, t₀)`, pathwise.** On the contact event, both paths
are good (simple, generated from their seeds `x₁`, `x₂`), the first path is available up to `s₀ + t`, and its new piece
`η₁([s₀, s₀ + t])` is read in the first-contact chart as the prefix `γ([0, Q])`, `Q > 0`, of a simple generating trace
`γ` of a continuous driver `W`, ending at the image of `η₁(s₀ + t)`. -/
structure IsFCLine (d : PairData Ω) (ω : Ω) (x₁ x₂ : ℝ) (t : ℝ≥0) (W : ℝ≥0 → ℝ) (γ : ℝ≥0 → ℂ) (ζc : ℝ≥0∞)
    (Q : ℝ≥0) : Prop where
  mem_E : ω ∈ d.E
  path₁ : IsPathGood (d.η₁ ω) (d.ζ₁ ω) x₁
  path₂ : IsPathGood (d.η₂ ω) (d.ζ₂ ω) x₂
  le_life : ((d.s₀ ω + t : ℝ≥0) : ℝ≥0∞) ≤ d.ζ₁ ω
  gen : IsGeneratingTrace W ζc γ
  cont : Continuous W
  zero : W 0 = 0
  inj : InjOn γ {s | (s : ℝ≥0∞) ≤ ζc}
  lt : (Q : ℝ≥0∞) < ζc
  pos : 0 < Q
  image : (fun s => d.inv ω (γ s)) '' Icc 0 Q = d.η₁ ω '' Icc (d.s₀ ω) (d.s₀ ω + t)
  tip : d.inv ω (γ Q) = d.η₁ ω (d.s₀ ω + t)

section FlowDefs

variable {nL nR : ℕ}

/-- **The flowed left force positions** at capacity `Q` (centred): `−rightImg (−w) (−x^L_i) Q − w_Q`. -/
def flowL (W : ℝ≥0 → ℝ) (Q : ℝ≥0) (xL : Fin nL → ℝ) : Fin nL → ℝ :=
  fun i => -MartChar.RealFlow.rightImg (fun s : ℝ => -W s.toNNReal) (-xL i) Q - W Q

/-- **The flowed right force positions** at capacity `Q` (centred): `rightImg w (x^R_j) Q − w_Q`. -/
def flowR (W : ℝ≥0 → ℝ) (Q : ℝ≥0) (xR : Fin nR → ℝ) : Fin nR → ℝ :=
  fun j => MartChar.RealFlow.rightImg (fun s : ℝ => W s.toNNReal) (xR j) Q - W Q

theorem flowL_eq (W : ℝ≥0 → ℝ) (Q : ℝ≥0) (xL : Fin nL → ℝ) :
    flowL W Q xL = fun i => -MartChar.RealFlow.rightImg (fun s : ℝ => -(fun s : ℝ => W s.toNNReal) s) (-xL i) Q -
      (fun s : ℝ => W s.toNNReal) Q := by
  funext i; simp [flowL]

theorem flowR_eq (W : ℝ≥0 → ℝ) (Q : ℝ≥0) (xR : Fin nR → ℝ) :
    flowR W Q xR = fun j => MartChar.RealFlow.rightImg (fun s : ℝ => W s.toNNReal) (xR j) Q -
      (fun s : ℝ => W s.toNNReal) Q := by
  funext j; simp [flowR]

end FlowDefs

theorem neBot_nhdsWithin_H_ofReal (y : ℝ) : (𝓝[H] (y : ℂ)).NeBot :=
  mem_closure_iff_nhdsWithin_neBot.1 (by rw [closure_H]; exact ofReal_mem_Hbar y)

namespace IsFCLine

variable (hl : IsFCLine d ω x₁ x₂ t W γ ζc Q)
include hl

theorem K_eq : d.K ω = prefixSet (d.η₁ ω) (d.s₀ ω) (d.η₂ ω) (d.t₀ ω) := PairData.K_of_mem hl.mem_E

theorem continuousOn₁ : ContinuousOn (d.η₁ ω) (Icc 0 (d.s₀ ω + t)) :=
  IsPathGood.continuousOn_Icc hl.path₁ hl.le_life

theorem injOn₁ : InjOn (d.η₁ ω) (Icc 0 (d.s₀ ω + t)) :=
  IsPathGood.injOn_Icc hl.path₁ hl.le_life

theorem continuous_rdrv : Continuous fun s : ℝ => W s.toNNReal := hl.cont.comp continuous_real_toNNReal

theorem rdrv_zero : (fun s : ℝ => W s.toNNReal) 0 = 0 := by simp [hl.zero]

theorem continuousOn_γ : ContinuousOn γ (Icc 0 Q) :=
  hl.gen.2.1.mono fun _ hs => (ENNReal.coe_le_coe.2 hs.2).trans hl.lt.le

/-- The new piece of the first path is the chart image of the chart path. -/
theorem image_inv_γ : d.inv ω '' (γ '' Icc 0 Q) = d.η₁ ω '' Icc (d.s₀ ω) (d.s₀ ω + t) := by
  rw [image_image]; exact hl.image

theorem inv_γ_mem (s : ℝ≥0) (hs : s ∈ Icc 0 Q) : d.inv ω (γ s) ∈ lineK d t ω := by
  have h : d.inv ω (γ s) ∈ d.η₁ ω '' Icc (d.s₀ ω) (d.s₀ ω + t) := hl.image ▸ ⟨s, hs, rfl⟩
  obtain ⟨u, hu, he⟩ := h
  exact Or.inl ⟨u, ⟨zero_le, hu.2⟩, he⟩

/-- The capacity-`Q` hull of the chart driver is the filling of the chart path. -/
theorem fwdHull_eq : fwdHull (fun s : ℝ => W s.toNNReal) Q = fillH (γ '' Icc 0 Q) :=
  SideHeight.fwdHull_eq_fillH_of_isGeneratingTrace hl.gen hl.lt

theorem fillH_K_subset : fillH (d.K ω) ⊆ fillH (lineK d t ω) := by
  rw [hl.K_eq]
  exact fillH_mono (prefixSet_mono_left le_self_add)

theorem K_subset : d.K ω ⊆ lineK d t ω := by
  rw [hl.K_eq]
  exact prefixSet_mono_left le_self_add

theorem lineK_subset : lineK d t ω ⊆ d.K ω ∪ d.inv ω '' (γ '' Icc 0 Q) := by
  rw [hl.image_inv_γ, hl.K_eq, lineK]
  rintro z (⟨s, hs, rfl⟩ | hz)
  · rcases le_total s (d.s₀ ω) with h | h
    · exact Or.inl (Or.inl ⟨s, ⟨hs.1, h⟩, rfl⟩)
    · exact Or.inr ⟨s, ⟨h, hs.2⟩, rfl⟩
  · exact Or.inl (Or.inr hz)

/-- The chart facts of the chart path at capacity `Q` (`ReverseArc.isChart`). -/
theorem isChart : ReverseArc.IsChart γ Q (fwdMap (fun s : ℝ => W s.toNNReal) Q)
    (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) :=
  ReverseArc.isChart hl.gen hl.cont.continuousOn hl.zero hl.inj hl.lt hl.pos

theorem extendFrom_eq_fwdMapInv {v : ℂ} (hv : v ∈ H) :
    extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) v = fwdMapInv (fun s : ℝ => W s.toNNReal) Q v :=
  extendFrom_eq (subset_closure hv) ((QuantumZipper.RS.continuousAt_fwdMapInv hl.continuous_rdrv hl.rdrv_zero
    Q.coe_nonneg hv).tendsto.mono_left nhdsWithin_le_nhds)

/-- Along `ℍ`, `f_Q⁻¹` tends at a point of `ℍ̄` to its extended value, within `ℍ \ K_Q`. -/
theorem tendsto_fwdMapInv {y : ℂ} (hy : y ∈ Hbar) :
    Tendsto (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) (𝓝[H] y)
      (𝓝[H \ fwdHull (fun s : ℝ => W s.toNNReal) Q] (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y)) := by
  have hch := hl.isChart
  refine tendsto_nhdsWithin_iff.2 ⟨?_, eventually_nhdsWithin_of_forall fun v hv => ?_⟩
  · refine ((hch.inv_cont y hy).mono QuantumZipper.H_subset_Hbar).tendsto.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with v hv using hl.extendFrom_eq_fwdMapInv hv
  · exact QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hv

/-- **A forward solution is read back by the extended inverse** (`Zhan.extendFrom_eq_of_isForwardSol`). -/
theorem extendFrom_eq_of_isForwardSol {x : ℝ} {u : ℝ → ℂ}
    (hu : QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u) :
    extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) (u Q) = x :=
  Zhan.extendFrom_eq_of_isForwardSol hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg
    (fun _ hv => hl.extendFrom_eq_fwdMapInv hv) hl.isChart.inv_cont hu

/-- **The real points of the composed chart.** The extended inverse `Φ` of `f_Q` sends a real `y` either onto the
chart path `γ([0, Q])`, or to a real point `x` off it which has a forward solution `u` up to `Q` with `u(Q) = y`. -/
theorem real_cases (y : ℝ) :
    extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y ∈ γ '' Icc 0 Q ∨
      ∃ x : ℝ, extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = x ∧
        ∃ u, QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u ∧ u Q = y := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  set Φ := extendFrom H (fwdMapInv w' Q) with hΦdef
  have hch := hl.isChart
  have hΦH : Φ y ∈ Hbar := hch.inv_mem_Hbar (ofReal_mem_Hbar y)
  by_cases hγ : Φ y ∈ γ '' Icc 0 Q
  · exact Or.inl hγ
  right
  have hreal : (Φ y).im = 0 := by
    rcases mem_H_or_im_eq_zero hΦH with h | h
    · exact absurd (hch.bdry y h) hγ
    · exact h
  set x : ℝ := (Φ y).re with hxdef
  have hxe : Φ y = x := Complex.ext (by simp [hxdef]) (by simp [hreal])
  refine ⟨x, hxe, ?_⟩
  have hx0 : x ≠ 0 := by
    intro h0
    apply hγ
    rw [hxe, h0, ofReal_zero]
    exact ⟨0, ⟨le_rfl, zero_le⟩, hl.gen.1⟩
  have hxη : (x : ℂ) ∉ (fun s : ℝ => γ s.toNNReal) '' Icc 0 (Q : ℝ) := by
    rintro ⟨s, hs, hγs⟩
    apply hγ
    rw [hxe, ← hγs]
    refine ⟨s.toNNReal, ⟨zero_le, ?_⟩, rfl⟩
    rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hs.1]
    exact hs.2
  have hlim := hl.tendsto_fwdMapInv (ofReal_mem_Hbar y)
  have := neBot_nhdsWithin_H_ofReal y
  have hcl : (x : ℂ) ∈ closure (H \ fwdHull w' Q) := by
    rw [← hxe]
    exact mem_closure_of_tendsto (hlim.mono_right nhdsWithin_le_nhds)
      ((tendsto_nhdsWithin_iff.1 hlim).2)
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  obtain ⟨t₂, hQt₂, ht₂⟩ := exists_real_btwn_of_lt hl.lt
  have hT : ((t₂.toNNReal : ℝ≥0) : ℝ≥0∞) ≤ ζc := ht₂.le
  have hL := GB7a.isLoewnerTraceLT_of_agree hl.gen hT (U := w') fun s _ _ => rfl
  rw [Real.coe_toNNReal _ (hQr.trans hQt₂.le)] at hL
  obtain ⟨u, hu⟩ := GB7a.exists_isForwardSol_of_mem_closure hl.continuous_rdrv hl.rdrv_zero hL hQr hQt₂ hx0 hxη hcl
  refine ⟨u, hu, ?_⟩
  -- `f_Q ∘ f_Q⁻¹ = id` tends to `y`, and `f_Q → u(Q)` at `x`
  have h1 : Tendsto (fwdMap w' Q) (𝓝[H] (x : ℂ)) (𝓝 (u Q)) := tendsto_fwdMap_of_isForwardSol hl.continuous_rdrv hQr hu
  have h2 : Tendsto (fwdMapInv w' Q) (𝓝[H] (y : ℂ)) (𝓝[H] (x : ℂ)) := by
    rw [← hxe]
    exact hlim.mono_right (nhdsWithin_mono _ sdiff_subset)
  have h3 := h1.comp h2
  refine tendsto_nhds_unique h3 ?_
  refine (tendsto_nhdsWithin_iff.1 (tendsto_id (x := 𝓝[H] (y : ℂ)))).1.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with v hv
  exact (QuantumZipper.RS.fwdMap_fwdMapInv hl.continuous_rdrv hl.rdrv_zero hQr hv).symm

/-- **Points with a forward solution up to `Q` are off the chart path** (GB6's tip lemma at every `s ≤ Q`; the copy
of PROVE-RETAUX79B's `ne_trace_of_isForwardSol`). -/
theorem notMem_γ_of_isForwardSol {p : ℂ} {u : ℝ → ℂ}
    (hu : QuantumZipper.IsForwardSol (fun r : ℝ => W r.toNNReal) p Q u) : p ∉ γ '' Icc 0 Q := by
  rintro ⟨s, hs, he⟩
  have hsζ : (s : ℝ≥0∞) < ζc := lt_of_le_of_lt (ENNReal.coe_le_coe.2 hs.2) hl.lt
  have htip := hl.gen.tendsto_fwdMapInv_tip hl.cont.continuousOn hl.zero hsζ
  rw [he] at htip
  have hs' : (s : ℝ) ≤ Q := hs.2
  exact Supp8.GB6.not_isForwardSol_of_tip hl.continuous_rdrv hl.rdrv_zero s.coe_nonneg htip
    ⟨hu.1.mono (Icc_subset_Icc_right hs'), fun r hr => hu.2 r ⟨hr.1, hr.2.trans hs'⟩⟩

open MartChar.RealFlow in
/-- **A chart point sent onto the chart path lies left of the image of `0⁺`**: every `y` above it is the image of an
alive point, which `Φ` sends back off the path. -/
theorem le_rightImg_of_mem_γ {y : ℝ}
    (hy : extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y ∈ γ '' Icc 0 Q) :
    y ≤ rightImg (fun s : ℝ => W s.toNNReal) 0 Q - W Q := by
  by_contra hlt
  push Not at hlt
  obtain ⟨x, -, hxa, hxg⟩ := exists_alive_gImg_eq hl.continuous_rdrv Q.coe_nonneg
    (show rightImg (fun s : ℝ => W s.toNNReal) 0 Q < y + W Q by linarith)
  obtain ⟨u, hu, huQ⟩ := exists_isForwardSol_of_alive hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hxa
  have h1 := hl.extendFrom_eq_of_isForwardSol hu
  have hval : u Q = (y : ℂ) := by
    rw [huQ, hxg]; simp only [Real.toNNReal_coe]; push_cast; ring
  rw [hval] at h1
  rw [h1] at hy
  exact hl.notMem_γ_of_isForwardSol hu hy

open MartChar.RealFlow in
/-- **A chart point sent onto the chart path lies right of the image of `0⁻`** (mirror of `le_rightImg_of_mem_γ`). -/
theorem neg_rightImg_le_of_mem_γ {y : ℝ}
    (hy : extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y ∈ γ '' Icc 0 Q) :
    -rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - W Q ≤ y := by
  by_contra hlt
  push Not at hlt
  have hwn : Continuous fun s : ℝ => -W s.toNNReal := hl.continuous_rdrv.neg
  obtain ⟨x, -, hxa, hxg⟩ := exists_alive_gImg_eq hwn Q.coe_nonneg
    (show rightImg (fun s : ℝ => -W s.toNNReal) 0 Q < -y - W Q by linarith)
  obtain ⟨u, hu, huQ⟩ := exists_isForwardSol_of_alive hwn (by simp [hl.zero]) Q.coe_nonneg hxa
  have hu' := QuantumZipper.RS.isForwardSol_neg hu
  have hdrv : (fun t => -(fun s : ℝ => -W s.toNNReal) t) = fun s : ℝ => W s.toNNReal := by
    funext s; simp
  rw [hdrv, show -((x : ℝ) : ℂ) = ((-x : ℝ) : ℂ) by push_cast; ring] at hu'
  have h1 := hl.extendFrom_eq_of_isForwardSol hu'
  have hval : -u Q = (y : ℂ) := by
    rw [huQ, hxg]; simp only [Real.toNNReal_coe]; push_cast; ring
  simp only [hval] at h1
  rw [h1] at hy
  exact hl.notMem_γ_of_isForwardSol hu' hy

open MartChar.RealFlow in
/-- **The chart boundary values of the later line from the two families of boundary points.** Let the force word
`(ρ, x^L ≤ 0 ≤ x^R)` carry the datum `f + a` off a finite set `S` (the seed data at the line `(s₀, t₀)`). Suppose that
* (old boundary) at every `y` sent by `Φ` to a real point `x ∉ S` with a forward solution up to `Q`, `Ξ → f(x)`;
* (new piece) at every `y` sent onto the open chart path `γ((0, Q))` with `0 < y < R̃` (resp. `L̃ < y < 0`, `R̃`, `L̃`
  the images of `0±`), `Ξ → ±λ − a` according to the sign of `y`;
* the fibres of `Φ` over the seed `γ(0)` and the tip `γ(Q)` are finite.

Then off a finite set `Ξ` tends at every real `y` to the flowed force datum at `y` minus `a`. -/
theorem exists_finite_tendsto {κ : ℝ} {nL nR : ℕ} {ρL : Fin nL → ℝ} {ρR : Fin nR → ℝ} {xL : Fin nL → ℝ}
    {xR : Fin nR → ℝ} (hxL : ∀ i, xL i ≤ 0) (hxR : ∀ j, 0 ≤ xR j) {f : ℝ → ℝ} {a : ℝ} {S : Set ℝ}
    (hS : S.Finite) (hdata : ∀ x ∉ S, forceBoundaryData κ ρL ρR xL xR x = f x + a) {Ξ : ℂ → ℝ}
    (hA : ∀ x : ℝ, x ∉ S → ∀ (y : ℝ) (u : ℝ → ℂ),
      extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = x →
      QuantumZipper.IsForwardSol (fun s : ℝ => W s.toNNReal) (x : ℂ) Q u → u Q = y →
      Tendsto Ξ (𝓝[H] (y : ℂ)) (𝓝 (f x)))
    (hB : ∀ y : ℝ, extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y ∈ γ '' Ioo 0 Q → 0 < y →
      y < MartChar.RealFlow.rightImg (fun s : ℝ => W s.toNNReal) 0 Q - W Q →
      Tendsto Ξ (𝓝[H] (y : ℂ)) (𝓝 (Real.pi / Real.sqrt κ - a)))
    (hB' : ∀ y : ℝ, extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y ∈ γ '' Ioo 0 Q → y < 0 →
      -MartChar.RealFlow.rightImg (fun s : ℝ => -W s.toNNReal) 0 Q - W Q < y →
      Tendsto Ξ (𝓝[H] (y : ℂ)) (𝓝 (-(Real.pi / Real.sqrt κ) - a)))
    (hfib0 : {y : ℝ | extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = γ 0}.Finite)
    (hfibQ : {y : ℝ | extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = γ Q}.Finite) :
    ∃ E : Set ℝ, E.Finite ∧ ∀ y ∉ E, Tendsto Ξ (𝓝[H] (y : ℂ))
      (𝓝 (forceBoundaryData κ ρL ρR (flowL W Q xL) (flowR W Q xR) y - a)) := by
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  set Φ := extendFrom H (fwdMapInv w' Q) with hΦdef
  have hw'c := hl.continuous_rdrv
  have hw'0 := hl.rdrv_zero
  have hQr : (0 : ℝ) ≤ Q := Q.coe_nonneg
  set X : Set ℝ := S ∪ range xL ∪ range xR with hXdef
  have hXf : X.Finite := (hS.union (finite_range xL)).union (finite_range xR)
  set lim : ℝ → ℝ := fun x => (limUnder (𝓝[H] (x : ℂ)) (fwdMap w' Q)).re with hlimdef
  set E : Set ℝ := {0, -rightImg (fun s => -w' s) 0 Q - W Q, rightImg w' 0 Q - W Q} ∪ lim '' X ∪
    {y | Φ y = γ 0} ∪ {y | Φ y = γ Q} ∪ range (flowL W Q xL) ∪ range (flowR W Q xR) with hEdef
  have hEf : E.Finite :=
    (((((Set.toFinite _).union (hXf.image _)).union hfib0).union hfibQ).union (finite_range _)).union
      (finite_range _)
  refine ⟨E, hEf, fun y hyE => ?_⟩
  have hy0 : y ≠ 0 := fun h => hyE (by simp [hEdef, h])
  have hyL : y ≠ -rightImg (fun s => -w' s) 0 Q - W Q := fun h => hyE (by simp [hEdef, h])
  have hyR : y ≠ rightImg w' 0 Q - W Q := fun h => hyE (by simp [hEdef, h])
  have hyA : y ∉ lim '' X := fun h => hyE (Or.inl (Or.inl (Or.inl (Or.inl (Or.inr h)))))
  have hy0f : Φ y ≠ γ 0 := fun h => hyE (Or.inl (Or.inl (Or.inl (Or.inr h))))
  have hyQf : Φ y ≠ γ Q := fun h => hyE (Or.inl (Or.inl (Or.inr h)))
  have hyFL : ∀ i, y ≠ flowL W Q xL i := fun i h => hyE (Or.inl (Or.inr ⟨i, h.symm⟩))
  have hfL := flowL_eq W Q xL
  have hfR := flowR_eq W Q xR
  have hwQ : w' Q = W Q := by simp [hw']
  rcases hl.real_cases y with hγ | ⟨x, hxe, u, hu, huQ⟩
  · -- the new piece
    obtain ⟨s, hs, hse⟩ := hγ
    have hs' : s ∈ Ioo 0 Q := ⟨lt_of_le_of_ne hs.1 fun h => hy0f (hse.symm.trans (congrArg γ h.symm)),
      lt_of_le_of_ne hs.2 fun h => hyQf (hse.symm.trans (congrArg γ h))⟩
    have hγ' : Φ y ∈ γ '' Ioo 0 Q := ⟨s, hs', hse⟩
    have hmem : Φ y ∈ γ '' Icc 0 Q := ⟨s, hs, hse⟩
    rcases lt_or_gt_of_ne hy0 with hneg | hpos
    · have hlow := hl.neg_rightImg_le_of_mem_γ hmem
      have hlt : -rightImg (fun s => -w' s) 0 Q - w' Q < y := by
        rw [hwQ]; exact lt_of_le_of_ne hlow (Ne.symm hyL)
      rw [hfL, hfR, forceBoundaryData_flow_slit_left ρL ρR hw'c hQr hxL hneg hlt]
      exact hB' y hγ' hneg (lt_of_le_of_ne hlow (Ne.symm hyL))
    · have hup := hl.le_rightImg_of_mem_γ hmem
      have hlt : y < rightImg w' 0 Q - w' Q := by
        rw [hwQ]; exact lt_of_le_of_ne hup hyR
      rw [hfL, hfR, forceBoundaryData_flow_slit_right ρL ρR hw'c hQr hxR hpos.le hlt]
      exact hB y hγ' hpos (lt_of_le_of_ne hup hyR)
  · -- an untouched real point
    have hlimx : lim x = y := by
      have h1 := tendsto_fwdMap_of_isForwardSol hw'c hQr hu
      have := neBot_nhdsWithin_H_ofReal x
      show ((𝓝[H] (x : ℂ)).limUnder (fwdMap w' Q)).re = y
      rw [h1.limUnder_eq, huQ, ofReal_re]
    have hxX : x ∉ X := fun h => hyA ⟨x, h, hlimx⟩
    have hxS : x ∉ S := fun h => hxX (Or.inl (Or.inl h))
    have hxL' : ∀ i, xL i ≠ x := fun i h => hxX (Or.inl (Or.inr ⟨i, h⟩))
    have hxR' : ∀ j, xR j ≠ x := fun j h => hxX (Or.inr ⟨j, h⟩)
    have hlim := hA x hxS y u hxe hu huQ
    rcases isForwardSol_real_cases hw'c hw'0 hQr hu with ⟨hx0, hxa, hux⟩ | ⟨hx0, hxa, hux⟩
    · have hyv : y = gImg w' x Q - w' Q := by
        have := huQ.symm.trans hux; exact_mod_cast this
      rw [hfL, hfR, hyv, forceBoundaryData_flow_right ρL ρR hw'c hQr hx0 hxa hxR', hdata x hxS, add_sub_cancel_right]
      exact hyv ▸ hlim
    · have hyv : y = -gImg (fun s => -w' s) (-x) Q - w' Q := by
        have := huQ.symm.trans hux; exact_mod_cast this
      have hxL'' : ∀ i, -xL i ≠ -x := fun i h => hxL' i (neg_injective h)
      have hy' : ∀ i, -gImg (fun s => -w' s) (-x) Q - w' Q ≠ -rightImg (fun s => -w' s) (-xL i) Q - w' Q := by
        intro i h
        apply hyFL i
        rw [hyv, h, flowL, hwQ]
      rw [hfL, hfR, hyv, forceBoundaryData_flow_left ρL ρR hw'c hQr (neg_pos.2 hx0) hxa hxL'' hy', neg_neg,
        hdata x hxS, add_sub_cancel_right]
      exact hyv ▸ hlim

/-- **The fibre hypotheses of the extended inverse** `Φ` of `f_Q` on the domain `D = ℍ \ fill γ([0, Q])` with
obstacle `E = ℝ ∪ γ([0, Q])` (the hypotheses of `eq_of_apply_eq_of_linked` and `false_of_apply_eq_of_lt_rel`). -/
theorem fibre_hyps :
    IsOpen (H \ fillH (γ '' Icc 0 Q)) ∧
    DifferentiableOn ℂ (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) H ∧
    InjOn (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) H ∧
    SurjOn (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) H (H \ fillH (γ '' Icc 0 Q)) ∧
    MapsTo (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) (Hbar \ H)
      (frontier (H \ fillH (γ '' Icc 0 Q))) ∧
    Tendsto (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q)) (Bornology.cobounded ℂ ⊓ 𝓟 Hbar)
      (Bornology.cobounded ℂ) ∧
    Disjoint (H \ fillH (γ '' Icc 0 Q)) ({z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q) ∧
    frontier (H \ fillH (γ '' Icc 0 Q)) ⊆ {z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q := by
  have hch := hl.isChart
  have hγc : IsCompact (γ '' Icc 0 Q) := isCompact_Icc.image_of_continuousOn hl.continuousOn_γ
  set D := H \ fillH (γ '' Icc 0 Q) with hDdef
  have hDo : IsOpen D := isOpen_H_diff_fillH hγc.isBounded
  have hDE : Disjoint D ({z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q) := by
    refine Set.disjoint_left.2 fun z hzD hzE => ?_
    rcases hzE with h | h
    · exact (ne_of_gt (show 0 < z.im from hzD.1)) h
    · exact hzD.2 ⟨hzD.1, Or.inl (subset_closure h)⟩
  have hfr : frontier D ⊆ {z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q := by
    have := frontier_H_diff_fillH_subset hγc.isBounded (A := γ '' Icc 0 Q)
    rwa [hγc.isClosed.closure_eq] at this
  -- bounded displacement on `ℍ̄`
  obtain ⟨C, hC⟩ := InteractingSLE.exists_norm_fwdMapInv_sub_le hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg
  have hCbar : ∀ w ∈ Hbar, ‖extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w - w‖ ≤ C := by
    intro w hw
    have hcl : w ∈ closure H := by rw [closure_H]; exact hw
    have hNe : (𝓝[H] w).NeBot := mem_closure_iff_nhdsWithin_neBot.1 hcl
    have hlim : Tendsto (fun v => extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) v - v) (𝓝[H] w)
        (𝓝 (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w - w)) :=
      ((hch.inv_cont w hw).mono QuantumZipper.H_subset_Hbar).tendsto.sub
        (continuousWithinAt_id.tendsto)
    refine le_of_tendsto hlim.norm (eventually_nhdsWithin_of_forall fun v hv => ?_)
    rw [hl.extendFrom_eq_fwdMapInv hv]
    exact hC v hv
  refine ⟨hDo, ?_, ?_, ?_, ?_, ?_, hDE, hfr⟩
  · exact (QuantumZipper.RS.differentiableOn_fwdMapInv hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg).congr
      fun v hv => hl.extendFrom_eq_fwdMapInv hv
  · intro v hv v' hv' h
    have h1 := congrArg (fwdMap (fun s : ℝ => W s.toNNReal) Q) h
    rwa [hch.f_inv v hv, hch.f_inv v' hv'] at h1
  · intro z hz
    exact ⟨_, hch.maps hz, hch.inv_f z hz⟩
  · intro w hw
    have hwr : w = (w.re : ℂ) := by
      have h0 : w.im = 0 := le_antisymm (not_lt.1 hw.2) hw.1
      exact Complex.ext (by simp) (by simp [h0])
    have hcl : extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w ∈ closure D := by
      have hcw : w ∈ closure H := by rw [closure_H]; exact hw.1
      have hNe : (𝓝[H] w).NeBot := mem_closure_iff_nhdsWithin_neBot.1 hcw
      exact mem_closure_of_tendsto (((hch.inv_cont w hw.1).mono QuantumZipper.H_subset_Hbar).tendsto)
        (eventually_nhdsWithin_of_forall fun v hv => hch.inv_mem hv)
    rw [hDo.frontier_eq]
    refine ⟨hcl, fun hD => ?_⟩
    have hmem := hch.bdry w.re (by rw [← hwr]; exact hD.1)
    rw [← hwr] at hmem
    exact Set.disjoint_left.1 hDE hD (Or.inr hmem)
  · have h1 : Tendsto (fun w : ℂ => ‖w‖) (Bornology.cobounded ℂ ⊓ 𝓟 Hbar) atTop :=
      tendsto_norm_cobounded_atTop.mono_left inf_le_left
    have h3 : Tendsto (fun w => ‖extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w‖)
        (Bornology.cobounded ℂ ⊓ 𝓟 Hbar) atTop := by
      refine tendsto_atTop_mono' _ ?_ (tendsto_atTop_add_const_right _ (-C) h1)
      filter_upwards [mem_inf_of_right (mem_principal_self Hbar)] with w hw
      have := hCbar w hw
      linarith [norm_sub_norm_le w (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w),
        norm_sub_rev w (extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) w)]
    simpa only [comap_norm_atTop] using tendsto_comap_iff.2 h3

/-- **The tip of the chart path has a single real preimage** (Aux. 80: removing the tip leaves `ℝ ∪ γ([0, Q))`
linked to `∞`). -/
theorem finite_fibre_tip :
    {y : ℝ | extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = γ Q}.Finite := by
  obtain ⟨hDo, hFd, hFi, hFs, hFbd, hFinf, hDE, hfr⟩ := hl.fibre_hyps
  have hch := hl.isChart
  have hlink : IsUnboundedLinked (({z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q) \ {γ Q}) := by
    refine isUnboundedLinked_of_forall fun z hz hzq => ?_
    obtain ⟨s, hs, rfl⟩ := hz
    have hsQ : s < Q := lt_of_le_of_ne hs.2 fun h => hzq (by rw [h])
    refine ⟨γ '' Icc 0 s, image_mono (Icc_subset_Icc_right hsQ.le),
      (isPreconnected_Icc.image _ (hl.continuousOn_γ.mono (Icc_subset_Icc_right hsQ.le))),
      ⟨s, ⟨zero_le, le_rfl⟩, rfl⟩, ?_, γ 0, ⟨0, ⟨le_rfl, zero_le⟩, rfl⟩, by rw [hl.gen.1]; simp⟩
    rintro ⟨s', hs', he⟩
    have hle : ((s' : ℝ≥0) : ℝ≥0∞) ≤ ζc := (ENNReal.coe_le_coe.2 (hs'.2.trans hsQ.le)).trans hl.lt.le
    have := hl.inj hle hl.lt.le he
    exact absurd (this ▸ hs'.2) (not_le.2 hsQ)
  refine Set.Subsingleton.finite fun y hy y' hy' => ?_
  exact_mod_cast eq_of_apply_eq_of_linked hDo hFd hch.inv_cont hFi (fun w hw => hch.inv_mem hw) hFs hFbd hFinf hDE
    hfr hlink hy hy'

/-- **The seed of the chart path has at most one real preimage on each side of `0`** (the relative fibre lemma:
the new piece `γ((0, Q])` with the seed removed contains the tip value `Φ(0) = γ(Q)`), so its fibre is finite. -/
theorem finite_fibre_seed :
    {y : ℝ | extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) y = γ 0}.Finite := by
  obtain ⟨hDo, hFd, hFi, hFs, hFbd, hFinf, hDE, hfr⟩ := hl.fibre_hyps
  have hch := hl.isChart
  set Φ := extendFrom H (fwdMapInv (fun s : ℝ => W s.toNNReal) Q) with hΦdef
  have hγ0 : γ 0 = 0 := hl.gen.1
  have hinj0 : ∀ s : ℝ≥0, s ∈ Icc 0 Q → γ s = γ 0 → s = 0 := fun s hs h =>
    hl.inj ((ENNReal.coe_le_coe.2 hs.2).trans hl.lt.le) (by simp) h
  have hΦ0 : Φ 0 ≠ γ 0 := by
    have htip : Φ 0 = γ Q := by simpa using hch.tip
    rw [htip]
    intro h
    exact (ne_of_gt hl.pos) (hinj0 Q ⟨zero_le, le_rfl⟩ h)
  -- the relative linking condition for two preimages on one side of `0`
  have hrel : ∀ x y : ℝ, (0 < x ∨ y < 0) →
      ∀ z ∈ ({z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q) \ {γ 0}, ∃ S ⊆ ({z : ℂ | z.im = 0} ∪ γ '' Icc 0 Q) \ {γ 0},
        IsPreconnected S ∧ z ∈ S ∧ (¬ Bornology.IsBounded S ∨ ∃ t₀ : ℝ, (t₀ < x ∨ y < t₀) ∧ Φ t₀ ∈ S) := by
    intro x y hxy z hz
    rcases hz.1 with hzr | ⟨s, hs, rfl⟩
    · obtain ⟨S, hSs, hSc, hzS, hSb⟩ := exists_ray hzr hz.2
      exact ⟨S, fun w hw => ⟨Or.inl (hSs hw).1, (hSs hw).2⟩, hSc, hzS, Or.inl hSb⟩
    · have hs0 : s ≠ 0 := fun h => hz.2 (by rw [h]; rfl)
      refine ⟨γ '' Ioc 0 Q, ?_, isPreconnected_Ioc.image _ (hl.continuousOn_γ.mono Ioc_subset_Icc_self),
        ⟨s, ⟨lt_of_le_of_ne hs.1 (Ne.symm hs0), hs.2⟩, rfl⟩, Or.inr ⟨0, ?_, ?_⟩⟩
      · rintro _ ⟨s', hs', rfl⟩
        refine ⟨Or.inr ⟨s', Ioc_subset_Icc_self hs', rfl⟩, fun h => ?_⟩
        exact (ne_of_gt hs'.1) (hinj0 s' (Ioc_subset_Icc_self hs') h)
      · rcases hxy with h | h
        · exact Or.inl h
        · exact Or.inr h
      · exact ⟨Q, ⟨hl.pos, le_rfl⟩, by simpa using hch.tip.symm⟩
  have hside : ∀ x y : ℝ, x < y → (0 < x ∨ y < 0) → Φ x = γ 0 → Φ y = γ 0 → False := fun x y hxy hs hx hy =>
    false_of_apply_eq_of_lt_rel hDo hFd hch.inv_cont hFi (fun w hw => hch.inv_mem hw) hFs hFbd hFinf hDE hfr
      (hrel x y hs) hxy hx hy
  have hsub : {y : ℝ | Φ y = γ 0} ⊆ {y : ℝ | 0 < y ∧ Φ y = γ 0} ∪ {y : ℝ | y < 0 ∧ Φ y = γ 0} := by
    intro y hy
    rcases lt_trichotomy y 0 with h | h | h
    · exact Or.inr ⟨h, hy⟩
    · exact absurd (by rw [h] at hy; exact_mod_cast hy) hΦ0
    · exact Or.inl ⟨h, hy⟩
  refine Set.Finite.subset (Set.Finite.union ?_ ?_) hsub
  · refine Set.Subsingleton.finite fun y hy y' hy' => ?_
    rcases lt_trichotomy y y' with h | h | h
    · exact (hside y y' h (Or.inl hy.1) hy.2 hy'.2).elim
    · exact h
    · exact (hside y' y h (Or.inl hy'.1) hy'.2 hy.2).elim
  · refine Set.Subsingleton.finite fun y hy y' hy' => ?_
    rcases lt_trichotomy y y' with h | h | h
    · exact (hside y y' h (Or.inr hy'.1) hy.2 hy'.2).elim
    · exact h
    · exact (hside y' y h (Or.inr hy.1) hy'.2 hy.2).elim

/-- The chart path stays in `ℍ̄` up to `Q`. -/
theorem γ_mem_Hbar {s : ℝ≥0} (hs : s ≤ Q) : γ s ∈ Hbar := by
  have hsζ : (s : ℝ≥0∞) < ζc := lt_of_le_of_lt (ENNReal.coe_le_coe.2 hs) hl.lt
  have htip := hl.gen.tendsto_fwdMapInv_tip hl.cont.continuousOn hl.zero hsζ
  have hNe := neBot_nhdsWithin_H_ofReal 0
  rw [ofReal_zero] at hNe
  rw [← closure_H]
  exact mem_closure_of_tendsto htip (eventually_nhdsWithin_of_forall fun w hw =>
    (QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hl.continuous_rdrv hl.rdrv_zero s.coe_nonneg hw).1)

section Meas

variable [MeasurableSpace Ω]

theorem isFirstContact (hd : d.IsMeasGood) : IsFirstContact (d.η₁ ω) (d.ζ₁ ω) (d.η₂ ω) (d.ζ₂ ω) (d.s₀ ω) (d.t₀ ω) :=
  hd.isFirstContact hl.mem_E

theorem chart (hd : d.IsMeasGood) :
    IsFirstContactChart (d.η₁ ω) (d.s₀ ω) (d.η₂ ω) (d.t₀ ω) (d.fwd ω) (d.inv ω) (d.lift ω) :=
  (hd.isFirstContactChart hl.mem_E).2

theorem isDomChart (hd : d.IsMeasGood) : IsDomChart (d.K ω) (d.fwd ω) (d.inv ω) := by
  rw [hl.K_eq]
  exact (hl.chart hd).isDomChart (hl.K_eq ▸ (hd.isCompact_K ω).isClosed)

theorem continuousOn₂ (hd : d.IsMeasGood) : ContinuousOn (d.η₂ ω) (Icc 0 (d.t₀ ω)) :=
  IsPathGood.continuousOn_Icc hl.path₂ (hl.isFirstContact hd).2.1

theorem injOn₂ (hd : d.IsMeasGood) : InjOn (d.η₂ ω) (Icc 0 (d.t₀ ω)) :=
  IsPathGood.injOn_Icc hl.path₂ (hl.isFirstContact hd).2.1

theorem isCompact_lineK (hd : d.IsMeasGood) : IsCompact (lineK d t ω) :=
  isCompact_prefixSet hl.continuousOn₁ (hl.continuousOn₂ hd)

/-- **The hull identity** `φ(fill P \ fill K) = fill γ([0, Q]) = K_Q`. -/
theorem fwd_image_fillH_diff (hd : d.IsMeasGood) :
    d.fwd ω '' (fillH (lineK d t ω) \ fillH (d.K ω)) = fwdHull (fun s : ℝ => W s.toNNReal) Q := by
  rw [hl.fwdHull_eq]
  exact (hl.isDomChart hd).fwd_image_fillH_diff_eq (hl.isCompact_lineK hd) (hl.fillH_K_subset)
    (hl.lineK_subset) hl.continuousOn_γ (hl.inv_γ_mem)

/-- `φ` maps the later domain `ℍ \ fill P` into `ℍ \ K_Q`. -/
theorem fwd_mem (hd : d.IsMeasGood) {z : ℂ} (hz : z ∈ H \ fillH (lineK d t ω)) :
    d.fwd ω z ∈ H \ fwdHull (fun s : ℝ => W s.toNNReal) Q := by
  have hD := hl.isDomChart hd
  have hzK : z ∈ H \ fillH (d.K ω) := ⟨hz.1, fun h => hz.2 (hl.fillH_K_subset h)⟩
  refine ⟨hD.mapsTo_fwd hzK, fun hmem => ?_⟩
  rw [← hl.fwd_image_fillH_diff hd] at hmem
  obtain ⟨z', hz', he⟩ := hmem
  have hz'K : z' ∈ H \ fillH (d.K ω) := ⟨fillH_subset_H _ hz'.1, hz'.2⟩
  have := hD.bijOn_fwd.injOn hz'K hzK he
  exact hz.2 (this ▸ hz'.1)

/-- `ψ ∘ f_Q⁻¹` maps `ℍ` into the later domain, and `φ` inverts `ψ` there. -/
theorem inv_mem (hd : d.IsMeasGood) {v : ℂ} (hv : v ∈ H) :
    d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q v) ∈ H \ fillH (lineK d t ω) ∧
      d.fwd ω (d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q v)) =
        fwdMapInv (fun s : ℝ => W s.toNNReal) Q v := by
  have hD := hl.isDomChart hd
  have hy := QuantumZipper.RS.fwdMapInv_mem_compl_fwdHull hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hv
  rw [hl.fwdHull_eq] at hy
  exact ⟨hD.inv_image_subset (hl.isCompact_lineK hd) (hl.lineK_subset) hl.continuousOn_γ ⟨_, hy, rfl⟩,
    hD.fwd_inv _ hy.1⟩

/-- On the later domain, `ψ ∘ f_Q⁻¹ ∘ f_Q ∘ φ = id`. -/
theorem inv_fwd (hd : d.IsMeasGood) {z : ℂ} (hz : z ∈ H \ fillH (lineK d t ω)) :
    d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q (fwdMap (fun s : ℝ => W s.toNNReal) Q (d.fwd ω z))) = z := by
  have hD := hl.isDomChart hd
  rw [QuantumZipper.RS.fwdMapInv_fwdMap hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg (hl.fwd_mem hd hz)]
  exact hD.inv_fwd ⟨hz.1, fun h => hz.2 (hl.fillH_K_subset h)⟩

theorem fwdMap_fwd_mem (hd : d.IsMeasGood) {z : ℂ} (hz : z ∈ H \ fillH (lineK d t ω)) :
    fwdMap (fun s : ℝ => W s.toNNReal) Q (d.fwd ω z) ∈ H :=
  QuantumZipper.FwdHolo.mapsTo_fwdMap hl.continuous_rdrv Q.coe_nonneg (hl.fwd_mem hd hz)

/-- **The composed inverse chart** `ψ ∘ f_Q⁻¹` is a bijection of `ℍ` onto the later domain. -/
theorem bijOn_inv (hd : d.IsMeasGood) :
    BijOn (fun v => d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q v)) H (H \ fillH (lineK d t ω)) := by
  refine ⟨fun v hv => (hl.inv_mem hd hv).1, fun v hv v' hv' he => ?_, fun z hz =>
    ⟨_, hl.fwdMap_fwd_mem hd hz, hl.inv_fwd hd hz⟩⟩
  have h1 := congrArg (fun z => fwdMap (fun s : ℝ => W s.toNNReal) Q (d.fwd ω z)) he
  simp only [(hl.inv_mem hd hv).2, (hl.inv_mem hd hv').2,
    QuantumZipper.RS.fwdMap_fwdMapInv hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hv,
    QuantumZipper.RS.fwdMap_fwdMapInv hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hv'] at h1
  exact h1

/-- The composed forward chart `f_Q ∘ φ` inverts the composed inverse chart on `ℍ`. -/
theorem fwd_comp_inv (hd : d.IsMeasGood) {v : ℂ} (hv : v ∈ H) :
    fwdMap (fun s : ℝ => W s.toNNReal) Q (d.fwd ω (d.inv ω (fwdMapInv (fun s : ℝ => W s.toNNReal) Q v))) = v := by
  rw [(hl.inv_mem hd hv).2, QuantumZipper.RS.fwdMap_fwdMapInv hl.continuous_rdrv hl.rdrv_zero Q.coe_nonneg hv]

theorem isHPHull_lineK (hd : d.IsMeasGood) : IsHPHull (fillH (lineK d t ω)) := by
  have h0₁ : (d.η₁ ω 0).im = 0 := by rw [IsPathGood.zero hl.path₁]; simp
  have h0₂ : (d.η₂ ω 0).im = 0 := by rw [IsPathGood.zero hl.path₂]; simp
  exact isHPHull_fillH_prefixSet hl.continuousOn₁ (hl.continuousOn₂ hd) h0₁ h0₂

/-- The first-contact chart is the hydrodynamic map of `fill K` minus a real constant. -/
theorem exists_fwd_eq (hd : d.IsMeasGood) :
    ∃ x₀ : ℝ, ∀ z, d.fwd ω z = ConformalImage.mapOut (fillH (d.K ω)) z - x₀ := by
  obtain ⟨⟨x₀, hx₀⟩, -⟩ := hd.isFirstContactChart hl.mem_E
  exact ⟨x₀, fun z => by rw [PairData.fwd, PairData.g, hx₀]⟩

/-- **The composed forward chart is hydrodynamic, and the chain rule of the canonical logarithms** (the internal
step of `RetAux79.chartComp_of_trace`): on the later domain, `f_Q ∘ φ` is the mapping-out function of `fill P` minus a
real constant, and `Im L_{fill P} = Im log f_Q′ ∘ φ + ℓ`. -/
theorem mapOut_lift (hd : d.IsMeasGood) :
    ∃ c : ℝ, ∀ z ∈ H \ fillH (lineK d t ω),
      ConformalImage.mapOut (fillH (lineK d t ω)) z = fwdMap (fun s : ℝ => W s.toNNReal) Q (d.fwd ω z) + c ∧
      canonDerivLog (fillH (lineK d t ω)) z =
        logDerivFwd (fun s : ℝ => W s.toNNReal) Q (d.fwd ω z) + canonDerivLog (fillH (d.K ω)) z := by
  obtain ⟨x₀, hx₀⟩ := hl.exists_fwd_eq hd
  set w' : ℝ → ℝ := fun s => W s.toNNReal with hw'
  set K := d.K ω with hKdef
  set P := lineK d t ω with hPdef
  have hAh : IsHPHull (fillH K) := hd.isHPHull ω
  have hBh : IsHPHull (fillH P) := hl.isHPHull_lineK hd
  have hKP : fillH K ⊆ fillH P := hl.fillH_K_subset
  set g₀ := ConformalImage.mapOut (fillH K) with hg₀def
  set g₁ := ConformalImage.mapOut (fillH P) with hg₁def
  have hC : d.fwd ω '' (fillH P \ fillH K) = fillH (γ '' Icc 0 Q) := by
    rw [hl.fwd_image_fillH_diff hd, hl.fwdHull_eq]
  set α : ℝ≥0 → ℂ := fun s => γ s + x₀ with hαdef
  have hαx : (fun s => α s - x₀) = γ := funext fun s => by simp [hαdef]
  have hgα : IsGeneratingTrace W ζc (fun s => α s - x₀) := by rw [hαx]; exact hl.gen
  obtain ⟨κ, -, hgC, hLC⟩ := ReverseArc.exists_physChart hgα hl.cont.continuousOn hl.zero hl.lt
  have hCeq : g₀ '' (fillH P \ fillH K) = fillH (α '' Icc 0 Q) := by
    rw [ReverseArc.fillH_image_eq (α := α) x₀ Q, hαx, ← hC, image_image]
    exact image_congr fun z _ => by rw [hx₀]; ring
  have hg₀ : IsMapOut (fillH K) g₀ := ConformalImage.isMapOut_mapOut hAh
  have hg₁ : IsMapOut (fillH P) g₁ := ConformalImage.isMapOut_mapOut hBh
  set gC : ℂ → ℂ := fun z => fwdMap w' Q (z - x₀) + κ with hgCdef
  have hgC' : IsMapOut (g₀ '' (fillH P \ fillH K)) gC := by rw [hCeq]; exact hgC
  have hcomp : IsMapOut (fillH P) (gC ∘ g₀) := hg₀.comp hAh hBh hKP hgC'
  have heq : EqOn g₁ (gC ∘ g₀) (H \ fillH P) := IsMapOut.eqOn hBh hg₁ hcomp
  have hLA := isCanonicalDerivLog_canonDerivLog hAh
  have hLC' : IsCanonicalDerivLog (g₀ '' (fillH P \ fillH K)) gC (fun z => logDerivFwd w' Q (z - x₀)) := by
    rw [hCeq]; exact hLC
  have hcL := IsCanonicalDerivLog.comp hAh hBh hKP hg₀ hgC' hLA hLC'
  have hLB := (isCanonicalDerivLog_canonDerivLog hBh).congr hBh heq
  have hLeq := IsCanonicalDerivLog.eqOn hLB hcL hBh hcomp
  refine ⟨κ, fun z hz => ⟨?_, ?_⟩⟩
  · rw [heq hz]
    simp only [Function.comp_apply, hgCdef, hx₀]
  · rw [hLeq hz]
    simp only [hx₀]

