/-!
# The staged conditional law: measure-theoretic tools

Packet PROVE-STAGEDLAW (Lemma GW1, specification p. 618–620: "The iterated optional Gaussian law is the full
joined-history
kernel; there is no step which conditions only on the newest range and forgets an older piece"). The staged history is
conditioned one stage at a time: the conditional law of the field given the retained past before instruction `k` is
computed from the conditional law, under the kernel `κ_ℓ(ω₀) = condExpKernel P 𝒢_ℓ ω₀` of an earlier stage, given the
newly retained record `R_ℓ`. This file proves the general facts behind that step.

## Main results

* `measurableSet_comap_of_saturated`, `measurable_comap_of_saturated`: on a standard Borel space, a measurable set (map)
  that is constant on the fibres of a measurable map `f` into a standard Borel space is measurable for the pull-back
  σ-algebra of `f` (Lusin separation of the two analytic images);
* `integral_integral_condExpKernel`: `∫ (∫ f d(κ ω₀)) dP(ω₀) = ∫ f dP`;
* **`ae_isGFFWithBoundaryData_condExpKernel`**: if, on an event `M`, the conditional characteristic functional of a
  field
  `Y` given `𝒢` is the Gaussian one of a sorted word `β ω`, then for almost every `ω₀ ∈ M` the field `Y` is a GFF with
  the data of `β ω₀` under the regular conditional law `condExpKernel P 𝒢 ω₀`;
* **`ae_condExp_eq_of_condExpKernel`** (one more stage): let `𝒢 = σ(p)`, and on an event `L ∈ 𝒢` let the enlarged
  σ-algebra `σ(π)` be generated by `(p, R)`. If, under almost every kernel `κ(ω₀)` with `ω₀ ∈ L`, the conditional
  expectation of `X` given `σ(R)` is `G (p ω₀, R)` on `{R ∈ N}`, then `E[X | σ(π)] = G (p, R)` almost surely on
  `L ∩ {R ∈ N}`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Exist

namespace StagedLaw

open LQGMetric Restart

/-! ### Fibre-constant sets and maps are measurable for the pull-back σ-algebra -/

section Saturated

variable {Ω S : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] [MeasurableSpace S] [StandardBorelSpace S]

/-- **A measurable set that is a union of fibres of `f` is `σ(f)`-measurable** (Lusin separation of the analytic sets
`f(A)` and `f(Aᶜ)`). -/
theorem measurableSet_comap_of_saturated {f : Ω → S} (hf : Measurable f) {A : Set Ω} (hA : MeasurableSet A)
    (hsat : ∀ ω ω', f ω = f ω' → ω ∈ A → ω' ∈ A) :
    MeasurableSet[MeasurableSpace.comap f inferInstance] A := by
  let := upgradeStandardBorel S
  have h1 : AnalyticSet (f '' A) := hA.analyticSet_image hf
  have h2 : AnalyticSet (f '' Aᶜ) := hA.compl.analyticSet_image hf
  have hd : Disjoint (f '' A) (f '' Aᶜ) := by
    rw [Set.disjoint_left]
    rintro _ ⟨ω, hω, rfl⟩ ⟨ω', hω', he⟩
    exact hω' (hsat ω ω' he.symm hω)
  obtain ⟨u, hAu, hdu, hu⟩ := h1.measurablySeparable h2 hd
  refine ⟨u, hu, ?_⟩
  ext ω
  constructor
  · intro h
    by_contra hn
    exact Set.disjoint_left.1 hdu ⟨ω, hn, rfl⟩ h
  · intro h
    exact hAu ⟨ω, h, rfl⟩

/-- **A measurable map that is constant on the fibres of `f` is `σ(f)`-measurable.** -/
theorem measurable_comap_of_saturated {Y : Type*} [MeasurableSpace Y] {f : Ω → S} (hf : Measurable f) {g : Ω → Y}
    (hg : Measurable g) (hsat : ∀ ω ω', f ω = f ω' → g ω = g ω') :
    Measurable[MeasurableSpace.comap f inferInstance] g := fun s hs =>
  measurableSet_comap_of_saturated hf (hg hs) fun ω ω' h hω => by
    simp only [mem_preimage] at hω ⊢
    rw [← hsat ω ω' h]
    exact hω

/-- **A fibre-constant measurable map factors measurably through `f`.** -/
theorem exists_measurable_comp_of_saturated {Y : Type*} [MeasurableSpace Y] [StandardBorelSpace Y] [Nonempty Y]
    {f : Ω → S} (hf : Measurable f) {g : Ω → Y} (hg : Measurable g) (hsat : ∀ ω ω', f ω = f ω' → g ω = g ω') :
    ∃ g' : S → Y, Measurable g' ∧ g = g' ∘ f :=
  (measurable_comap_of_saturated hf hg hsat).exists_eq_measurable_comp

end Saturated

/-! ### Regular conditional laws -/

section Kernel

variable {Ω : Type*} {𝒢 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P]

/-- **Disintegration along the regular conditional law.** -/
theorem integral_integral_condExpKernel (h𝒢 : 𝒢 ≤ mΩ) {f : Ω → ℂ} (hf : Integrable f P) :
    ∫ ω₀, (∫ ω, f ω ∂(condExpKernel P 𝒢 ω₀)) ∂P = ∫ ω, f ω ∂P := by
  rw [← integral_condExp h𝒢 (f := f)]
  exact integral_congr_ae (condExp_ae_eq_integral_condExpKernel h𝒢 hf).symm

/-- **The regular conditional law makes a field a GFF when its conditional characteristic functional is Gaussian.**
If, on the event `M`, `E[exp(i (Y, φ)) | 𝒢] = gaussCF (β ω) φ` for every test function `φ`, with `β ω` a sorted word,
then for almost every `ω₀ ∈ M`, under `condExpKernel P 𝒢 ω₀`, `Y` is a GFF with the data of `β ω₀`. -/
theorem ae_isGFFWithBoundaryData_condExpKernel (h𝒢 : 𝒢 ≤ mΩ) {M : Set Ω}
    {β : Ω → BoundaryWord} (hsort : ∀ᵐ ω ∂P, ω ∈ M → (β ω).IsSorted) {Y : Ω → DistOn upperHalfPlaneOpens}
    (hY : Measurable Y)
    (hG : ∀ φ : TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P, ω ∈ M →
      P[fun ω' => Complex.exp (Complex.I * (Y ω' φ : ℂ)) | 𝒢] ω = gaussCF (β ω) φ) :
    ∀ᵐ ω₀ ∂P, ω₀ ∈ M → IsGFFWithBoundaryData (condExpKernel P 𝒢 ω₀) Y (β ω₀).fn (β ω₀).jumps := by
  have hfm : ∀ φ : TestOn upperHalfPlaneOpens, Measurable fun ω => Complex.exp (Complex.I * (Y ω φ : ℂ)) :=
    fun φ => GFF.measurable_exp_I_mul ((measurable_distOn_apply φ).comp hY)
  have hk : ∀ k : RatComb, ∀ᵐ ω₀ ∂P, ω₀ ∈ M →
      ∫ ω, Complex.exp (Complex.I * (Y ω (ratComb upperHalfPlaneOpens k) : ℂ)) ∂(condExpKernel P 𝒢 ω₀) =
        gaussCF (β ω₀) (ratComb upperHalfPlaneOpens k) := by
    intro k
    filter_upwards [hG (ratComb upperHalfPlaneOpens k), condExp_ae_eq_integral_condExpKernel h𝒢
      (GFF.integrable_exp_I_mul (P := P) ((measurable_distOn_apply (ratComb upperHalfPlaneOpens k)).comp hY))]
      with ω₀ h1 h2 hM
    exact h2.symm.trans (h1 hM)
  filter_upwards [ae_all_iff.2 hk, hsort] with ω₀ hk' hs hM
  have hmap : (condExpKernel P 𝒢 ω₀).map Y = (β ω₀).gffLaw := by
    refine ext_of_integral_cexp_ratComb fun k => ?_
    rw [integral_map hY.aemeasurable (GFF.measurable_exp_I_mul (measurable_distOn_apply _)).aestronglyMeasurable,
      hk' k hM, gaussCF_eq_integral]
  refine ⟨hY, fun u₀ hu₀ => ?_⟩
  have h := ((β ω₀).isGFFWithBoundaryData_gffLaw (hs hM)).2 u₀ hu₀
  rw [← hmap] at h
  exact isZBGFFProcess_comp hY h

/-- **One more stage.** Let `𝒢 = σ(p)` and let `σ(π)` be a larger σ-algebra which, on an event `L ∈ 𝒢`, is generated
by `(p, R)`: `π = Φ (p, R)` and `Ψ ∘ π = (p, R)` on `L`, and `p` is read from `π` everywhere. If, for almost every
`ω₀ ∈ L`, under the regular conditional law `κ(ω₀)` given `𝒢` the conditional expectation of `X` given `σ(R)` is
`G (p ω₀, R)` on `{R ∈ N}`, then `E[X | σ(π)] = G (p, R)` almost surely on `L ∩ {R ∈ N}`. -/
theorem ae_condExp_eq_of_condExpKernel {S T U : Type*} [MeasurableSpace S] [StandardBorelSpace S]
    [MeasurableSpace T] [MeasurableSpace U] {p : Ω → S} (hp : Measurable p) {R : Ω → T} (hR : Measurable R)
    {π : Ω → U} (hπ : Measurable π) {Φ : S × T → U} (hΦ : Measurable Φ) {Ψ : U → S × T} (hΨ : Measurable Ψ)
    (hpπ : ∀ ω, (Ψ (π ω)).1 = p ω) {L : Set Ω} (hL : MeasurableSet[MeasurableSpace.comap p inferInstance] L)
    (hπL : ∀ ω ∈ L, π ω = Φ (p ω, R ω) ∧ (Ψ (π ω)).2 = R ω) {N : Set T} (hN : MeasurableSet N)
    {X : Ω → ℂ} (hX : Measurable X) (hXb : ∀ ω, ‖X ω‖ ≤ 1) {G : S × T → ℂ} (hG : Measurable G)
    (hGb : ∀ x, ‖G x‖ ≤ 1)
    (hk : ∀ᵐ ω₀ ∂P, ω₀ ∈ L → ∀ᵐ ω ∂(condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀), R ω ∈ N →
      (condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀)[X | MeasurableSpace.comap R inferInstance] ω =
        G (p ω₀, R ω)) :
    ∀ᵐ ω ∂P, ω ∈ L → R ω ∈ N → P[X | MeasurableSpace.comap π inferInstance] ω = G (p ω, R ω) := by
  let := upgradeStandardBorel S
  have h𝒢 : MeasurableSpace.comap p inferInstance ≤ mΩ := hp.comap_le
  have hπle : MeasurableSpace.comap π inferInstance ≤ mΩ := hπ.comap_le
  have hRle : MeasurableSpace.comap R inferInstance ≤ mΩ := hR.comap_le
  have hle : MeasurableSpace.comap p inferInstance ≤ MeasurableSpace.comap π inferInstance := by
    rintro _ ⟨s, hs, rfl⟩
    refine ⟨(fun u => (Ψ u).1) ⁻¹' s, (measurable_fst.comp hΨ) hs, ?_⟩
    ext ω
    simp only [mem_preimage, hpπ]
  have hLm : MeasurableSet L := h𝒢 _ hL
  -- the event `L ∩ {R ∈ N}` and the candidate `g`
  have hLπ : MeasurableSet[MeasurableSpace.comap π inferInstance] (L ∩ R ⁻¹' N) := by
    have h1 : L ∩ R ⁻¹' N = L ∩ π ⁻¹' ((fun u => (Ψ u).2) ⁻¹' N) := by
      ext ω
      constructor
      · rintro ⟨hω, hN'⟩
        exact ⟨hω, by simp only [mem_preimage, (hπL ω hω).2]; exact hN'⟩
      · rintro ⟨hω, hN'⟩
        refine ⟨hω, ?_⟩
        simp only [mem_preimage, (hπL ω hω).2] at hN'
        exact hN'
    rw [h1]
    exact (hle _ hL).inter ⟨_, (measurable_snd.comp hΨ) hN, rfl⟩
  have hLπm : MeasurableSet (L ∩ R ⁻¹' N) := hπle _ hLπ
  have hFm : Measurable[MeasurableSpace.comap π inferInstance] fun ω => G (Ψ (π ω)) :=
    (hG.comp hΨ).comp (comap_measurable π)
  have hgm : StronglyMeasurable[MeasurableSpace.comap π inferInstance]
      ((L ∩ R ⁻¹' N).indicator fun ω => G (Ψ (π ω))) := hFm.stronglyMeasurable.indicator hLπ
  have hFm' : Measurable fun ω => G (Ψ (π ω)) := hFm.mono hπle le_rfl
  have hXi : Integrable X P := Integrable.of_bound hX.aestronglyMeasurable 1 (Eventually.of_forall hXb)
  have hFi : Integrable (fun ω => G (Ψ (π ω))) P :=
    Integrable.of_bound hFm'.aestronglyMeasurable 1 (Eventually.of_forall fun ω => hGb _)
  -- the key identity of set integrals
  have hkey : ∀ C : Set U, MeasurableSet C →
      ∫ ω, (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator (fun ω => G (Ψ (π ω))) ω ∂P =
        ∫ ω, (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator X ω ∂P := by
    intro C hC
    have hA : MeasurableSet (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)) := (hπ hC).inter hLπm
    rw [← integral_integral_condExpKernel h𝒢 (hFi.indicator hA), ← integral_integral_condExpKernel h𝒢
      (hXi.indicator hA)]
    refine integral_congr_ae ?_
    filter_upwards [hk, Sec7.Aux122Disint.ae_ae_condExpKernel_eq (P := P) h𝒢 (comap_measurable p),
      Sec7.Aux122Disint.ae_ae_condExpKernel_mem (P := P) h𝒢 hL,
      Sec7.Aux122Disint.ae_ae_condExpKernel_mem (P := P) h𝒢 hL.compl] with ω₀ hk₀ hp₀ hL₀ hLc₀
    by_cases h0 : ω₀ ∈ L
    · set κ₀ := condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀
      have hLa : ∀ᵐ ω ∂κ₀, ω ∈ L := hL₀ h0
      set ψ : T → ℂ := (((fun r => Φ (p ω₀, r)) ⁻¹' C) ∩ N).indicator 1 with hψ
      have hmem : ∀ ω ∈ L, p ω = p ω₀ →
          (ω ∈ π ⁻¹' C ∩ (L ∩ R ⁻¹' N) ↔ R ω ∈ ((fun r => Φ (p ω₀, r)) ⁻¹' C) ∩ N) := by
        intro ω hωL hωp
        simp only [mem_inter_iff, mem_preimage, (hπL ω hωL).1, hωp]
        tauto
      have e1 : (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator X =ᵐ[κ₀] fun ω => ψ (R ω) * X ω := by
        filter_upwards [hLa, hp₀] with ω hωL hωp
        by_cases hω : ω ∈ π ⁻¹' C ∩ (L ∩ R ⁻¹' N)
        · rw [indicator_of_mem hω, hψ, indicator_of_mem ((hmem ω hωL hωp).1 hω), Pi.one_apply, one_mul]
        · rw [indicator_of_notMem hω, hψ, indicator_of_notMem (fun h => hω ((hmem ω hωL hωp).2 h)), zero_mul]
      have e2 : (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator (fun ω => G (Ψ (π ω))) =ᵐ[κ₀]
          fun ω => ψ (R ω) * G (p ω₀, R ω) := by
        filter_upwards [hLa, hp₀] with ω hωL hωp
        have hΨω : Ψ (π ω) = (p ω₀, R ω) := Prod.ext ((hpπ ω).trans hωp) (hπL ω hωL).2
        by_cases hω : ω ∈ π ⁻¹' C ∩ (L ∩ R ⁻¹' N)
        · rw [indicator_of_mem hω, hψ, indicator_of_mem ((hmem ω hωL hωp).1 hω), Pi.one_apply, one_mul, hΨω]
        · rw [indicator_of_notMem hω, hψ, indicator_of_notMem (fun h => hω ((hmem ω hωL hωp).2 h)), zero_mul]
      have hψm : Measurable ψ := measurable_one.indicator
        (((hΦ.comp (measurable_const.prodMk measurable_id)) hC).inter hN)
      have hψb : ∀ r, ‖ψ r‖ ≤ 1 := fun r => by
        rw [hψ]
        by_cases hr : r ∈ ((fun r => Φ (p ω₀, r)) ⁻¹' C) ∩ N
        · rw [indicator_of_mem hr]; simp
        · rw [indicator_of_notMem hr]; simp
      have hψR : StronglyMeasurable[MeasurableSpace.comap R inferInstance] fun ω => ψ (R ω) :=
        (hψm.comp (comap_measurable R)).stronglyMeasurable
      have hXi₀ : Integrable X κ₀ := Integrable.of_bound hX.aestronglyMeasurable 1 (Eventually.of_forall hXb)
      have hψXi : Integrable (fun ω => ψ (R ω) * X ω) κ₀ := by
        refine Integrable.of_bound ((hψm.comp hR).mul hX).aestronglyMeasurable 1
          (Eventually.of_forall fun ω => ?_)
        rw [norm_mul]
        calc ‖ψ (R ω)‖ * ‖X ω‖ ≤ 1 * 1 := mul_le_mul (hψb _) (hXb ω) (norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1
      have hpull : κ₀[fun ω => ψ (R ω) * X ω | MeasurableSpace.comap R inferInstance] =ᵐ[κ₀]
          fun ω => ψ (R ω) * κ₀[X | MeasurableSpace.comap R inferInstance] ω :=
        condExp_bilin_of_aestronglyMeasurable_left (ContinuousLinearMap.mul ℝ ℂ) hψR.aestronglyMeasurable hψXi hXi₀
      rw [integral_congr_ae e1, integral_congr_ae e2, ← integral_condExp hRle (f := fun ω => ψ (R ω) * X ω)]
      refine integral_congr_ae ?_
      filter_upwards [hpull, hk₀ h0] with ω h1 h2
      rw [h1]
      by_cases hRN : R ω ∈ N
      · rw [h2 hRN]
      · have hz : ψ (R ω) = 0 := by
          rw [hψ]
          exact indicator_of_notMem (fun h => hRN h.2) _
        rw [hz, zero_mul, zero_mul]
    · have hLa : ∀ᵐ ω ∂(condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀), ω ∈ Lᶜ := hLc₀ h0
      have z1 : (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator X
          =ᵐ[condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀] 0 := by
        filter_upwards [hLa] with ω hω
        exact indicator_of_notMem (fun h => hω h.2.1) _
      have z2 : (π ⁻¹' C ∩ (L ∩ R ⁻¹' N)).indicator (fun ω => G (Ψ (π ω)))
          =ᵐ[condExpKernel P (MeasurableSpace.comap p inferInstance) ω₀] 0 := by
        filter_upwards [hLa] with ω hω
        exact indicator_of_notMem (fun h => hω h.2.1) _
      rw [integral_congr_ae z1, integral_congr_ae z2]
  have hcond : (L ∩ R ⁻¹' N).indicator (fun ω => G (Ψ (π ω))) =ᵐ[P]
      P[(L ∩ R ⁻¹' N).indicator X | MeasurableSpace.comap π inferInstance] := by
    refine ae_eq_condExp_of_forall_setIntegral_eq hπle (hXi.indicator hLπm)
      (fun s _ _ => (hFi.indicator hLπm).integrableOn) ?_ hgm.aestronglyMeasurable
    rintro _ ⟨C, hC, rfl⟩ _
    rw [setIntegral_indicator hLπm, setIntegral_indicator hLπm, ← integral_indicator ((hπ hC).inter hLπm),
      ← integral_indicator ((hπ hC).inter hLπm)]
    exact hkey C hC
  filter_upwards [hcond, condExp_indicator hXi hLπ] with ω h1 h2 hωL hωN
  have hω : ω ∈ L ∩ R ⁻¹' N := ⟨hωL, hωN⟩
  rw [indicator_of_mem hω] at h1 h2
  rw [← h2, ← h1, show Ψ (π ω) = (p ω, R ω) from Prod.ext (hpπ ω) (hπL ω hωL).2]

end Kernel

end StagedLaw

