/-!
# The probability laws on a standard Borel space form a standard Borel space

Packet PROVE-PARAM12B. `Param12Limit` turns a Borel set of descriptions of couplings into a kernel. The natural
description space is a space of probability laws, so it must be standard Borel for its Giry σ-algebra (the σ-algebra
of `MeasureTheory.ProbabilityMeasure`, generated by the evaluations `ν ↦ ν s`). Mathlib (`a4c8ef0a`) has the weak
topology, its metrizability (Lévy–Prokhorov) and Prokhorov's compactness, but not this fact.

* `ProbabilityMeasure.borelSpace_ereal`: on the compact metrizable space `EReal`, the Giry σ-algebra is the Borel
  σ-algebra of the weak topology. The evaluations of bounded continuous functions are Giry measurable, and the weak
  topology is second countable, so every open set is a countable union of Giry measurable basic sets. Conversely
  `ν ↦ ν F` is a limit of weakly continuous maps for `F` closed (`HasOuterApproxClosed`), and Dynkin's π-λ theorem
  extends this to every Borel `F`.
* `ProbabilityMeasure.standardBorelSpace_ereal`: Prokhorov's compactness and the Lévy–Prokhorov metric make the
  weak topology Polish.
* `standardBorelSpace_of_measurableEmbedding`: a measurable embedding into a standard Borel space has a standard Borel
  domain.
* **`ProbabilityMeasure.standardBorelSpace`**: for every nonempty standard Borel space `X`, pushing forward along a
  measurable embedding `X → EReal` is a measurable embedding of `ProbabilityMeasure X` (left inverse
  `μ ↦ μ.comap e + μ (range e)ᶜ • δ_{x₀}`, range `{μ | μ (range e)ᶜ = 0}`), so `ProbabilityMeasure X` is standard
  Borel.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology TopologicalSpace
open scoped NNReal ENNReal BoundedContinuousFunction

namespace InteractingSLE

namespace Exist

namespace Param12

/-! ### A measurable embedding into a standard Borel space -/

/-- A measurable embedding into a standard Borel space has a standard Borel domain. -/
theorem standardBorelSpace_of_measurableEmbedding {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [StandardBorelSpace β] {f : α → β} (hf : MeasurableEmbedding f) : StandardBorelSpace α := by
  obtain ⟨τ, hτb, hτp, hcl, -⟩ := hf.measurableSet_range.isClopenable'
  let τα : TopologicalSpace α := TopologicalSpace.induced f τ
  have hemb : IsClosedEmbedding f := ⟨⟨⟨rfl⟩, hf.injective⟩, hcl⟩
  have hpol : PolishSpace α := hemb.polishSpace
  have hbor : BorelSpace α := ⟨by rw [borel_comap (f := f) (t := τ), ← hτb.measurable_eq, hf.comap_eq]⟩
  exact ⟨⟨τα, hbor, hpol⟩⟩

/-! ### The Giry σ-algebra on the laws on `EReal` is the Borel σ-algebra of the weak topology -/

namespace ProbabilityMeasure

/-- The vector of tests of a law against all bounded continuous functions. -/
def testVec (ν : ProbabilityMeasure EReal) : (EReal →ᵇ ℝ≥0) → ℝ≥0 := fun f => ν.toWeakDualBCNN f

theorem isInducing_testVec : IsInducing testVec := by
  have h1 : IsInducing fun (x : WeakDual ℝ≥0 (EReal →ᵇ ℝ≥0)) (f : EReal →ᵇ ℝ≥0) => x f := ⟨rfl⟩
  exact h1.comp ((FiniteMeasure.isEmbedding_toWeakDualBCNN EReal).isInducing.comp
    (ProbabilityMeasure.toFiniteMeasure_isEmbedding EReal).isInducing)

theorem measurable_testVec_apply (f : EReal →ᵇ ℝ≥0) :
    Measurable fun ν : ProbabilityMeasure EReal => testVec ν f := by
  have hf : Measurable fun ω : EReal => ((f ω : ℝ≥0) : ℝ≥0∞) := f.continuous.measurable.coe_nnreal_ennreal
  have e : (fun ν : ProbabilityMeasure EReal => testVec ν f) =
      fun ν : ProbabilityMeasure EReal => (∫⁻ ω, (f ω : ℝ≥0∞) ∂(ν : Measure EReal)).toNNReal := by
    funext ν
    exact ProbabilityMeasure.toWeakDualBCNN_apply ν f
  rw [e]
  exact ENNReal.measurable_toNNReal.comp ((Measure.measurable_lintegral hf).comp measurable_subtype_coe)

/-- Every Borel set of the weak topology is Giry measurable. -/
theorem borel_le_giry : borel (ProbabilityMeasure EReal) ≤ (inferInstance : MeasurableSpace (ProbabilityMeasure EReal)) := by
  refine MeasurableSpace.generateFrom_le fun O hO => ?_
  have hB := isInducing_testVec.isTopologicalBasis (isTopologicalBasis_pi fun _ => isTopologicalBasis_opens)
  have hbasic : ∀ s ∈ preimage testVec '' {S | ∃ (U : (EReal →ᵇ ℝ≥0) → Set ℝ≥0) (F : Finset (EReal →ᵇ ℝ≥0)),
      (∀ i ∈ F, U i ∈ {U : Set ℝ≥0 | IsOpen U}) ∧ S = (F : Set (EReal →ᵇ ℝ≥0)).pi U}, MeasurableSet s := by
    rintro s ⟨S, ⟨U, F, hU, rfl⟩, rfl⟩
    have e : testVec ⁻¹' (F : Set (EReal →ᵇ ℝ≥0)).pi U = ⋂ i ∈ (F : Set (EReal →ᵇ ℝ≥0)),
        (fun ν => testVec ν i) ⁻¹' U i := by
      ext ν
      simp only [mem_preimage, Set.mem_pi, mem_iInter]
    rw [e]
    exact MeasurableSet.biInter F.countable_toSet fun i hi => measurable_testVec_apply i (show IsOpen (U i) from hU i hi).measurableSet
  rw [hB.open_eq_sUnion' hO]
  obtain ⟨T, hTc, hTS, hTU⟩ := isOpen_sUnion_countable {s | s ∈ _ ∧ s ⊆ O} fun s hs => hB.isOpen hs.1
  rw [← hTU]
  exact MeasurableSet.sUnion hTc fun s hs => hbasic s (hTS hs).1

/-- The evaluation at a Borel set is measurable for the Borel σ-algebra of the weak topology. -/
theorem measurable_borel_coe_apply {s : Set EReal} (hs : MeasurableSet s) :
    Measurable[borel (ProbabilityMeasure EReal)] fun ν : ProbabilityMeasure EReal => (ν : Measure EReal) s := by
  let : MeasurableSpace (ProbabilityMeasure EReal) := borel _
  have : BorelSpace (ProbabilityMeasure EReal) := ⟨rfl⟩
  have h_eq : (inferInstance : MeasurableSpace EReal) = MeasurableSpace.generateFrom {s | IsClosed s} :=
    EReal.borelSpace.measurable_eq.trans borel_eq_generateFrom_isClosed
  refine MeasurableSpace.induction_on_inter (C := fun s _ =>
    Measurable fun ν : ProbabilityMeasure EReal => (ν : Measure EReal) s) h_eq isPiSystem_isClosed ?_ ?_ ?_ ?_ s hs
  · simp only [measure_empty]
    exact measurable_const
  · intro F hF
    have hF' : IsClosed F := hF
    have hmeas : ∀ n : ℕ, Measurable fun ν : ProbabilityMeasure EReal =>
        ∫⁻ x, (hF'.apprSeq n x : ℝ≥0∞) ∂(ν : Measure EReal) := by
      intro n
      have hc : Continuous fun ν : ProbabilityMeasure EReal =>
          ((ν.toFiniteMeasure.testAgainstNN (hF'.apprSeq n) : ℝ≥0) : ℝ≥0∞) :=
        ENNReal.continuous_coe.comp (ProbabilityMeasure.continuous_testAgainstNN_eval _)
      have e : (fun ν : ProbabilityMeasure EReal => ∫⁻ x, (hF'.apprSeq n x : ℝ≥0∞) ∂(ν : Measure EReal)) =
          fun ν => ((ν.toFiniteMeasure.testAgainstNN (hF'.apprSeq n) : ℝ≥0) : ℝ≥0∞) := by
        funext ν
        rw [FiniteMeasure.testAgainstNN_coe_eq]
        rfl
      rw [e]
      exact hc.measurable
    exact measurable_of_tendsto_metrizable hmeas
      (tendsto_pi_nhds.2 fun ν => HasOuterApproxClosed.tendsto_lintegral_apprSeq hF' (ν : Measure EReal))
  · intro t ht h
    have e : (fun ν : ProbabilityMeasure EReal => (ν : Measure EReal) tᶜ) =
        fun ν : ProbabilityMeasure EReal => 1 - (ν : Measure EReal) t := by
      funext ν
      exact prob_compl_eq_one_sub ht
    rw [e]
    exact measurable_const.sub h
  · intro f hdisj hfm h
    have e : (fun ν : ProbabilityMeasure EReal => (ν : Measure EReal) (⋃ i, f i)) =
        fun ν : ProbabilityMeasure EReal => ∑' i, (ν : Measure EReal) (f i) := by
      funext ν
      exact measure_iUnion hdisj hfm
    rw [e]
    exact Measurable.tsum h

/-- Every Giry measurable set is Borel for the weak topology. -/
theorem giry_le_borel : (inferInstance : MeasurableSpace (ProbabilityMeasure EReal)) ≤ borel (ProbabilityMeasure EReal) := by
  have hval : Measurable[borel (ProbabilityMeasure EReal)] fun ν : ProbabilityMeasure EReal => (ν : Measure EReal) :=
    @Measure.measurable_of_measurable_coe _ _ _ (borel _) _ fun s hs => measurable_borel_coe_apply hs
  have hid := @Measurable.subtype_mk _ _ (borel _) _ _ _ hval (fun ν => ν.2)
  intro s hs
  exact hid hs

instance borelSpace_ereal : BorelSpace (ProbabilityMeasure EReal) :=
  ⟨le_antisymm giry_le_borel borel_le_giry⟩

instance polishSpace_ereal : PolishSpace (ProbabilityMeasure EReal) := by
  let := TopologicalSpace.metrizableSpaceMetric (ProbabilityMeasure EReal)
  have : CompleteSpace (ProbabilityMeasure EReal) := complete_of_compact
  infer_instance

instance standardBorelSpace_ereal : StandardBorelSpace (ProbabilityMeasure EReal) := inferInstance

/-! ### Every nonempty standard Borel space -/

section General

variable {X : Type*} [MeasurableSpace X] [StandardBorelSpace X] [Nonempty X]

/-- A measurable embedding of `X` into `EReal`. -/
def toEReal (X : Type*) [MeasurableSpace X] [StandardBorelSpace X] : X → EReal :=
  fun x => (embeddingReal X x : EReal)

omit [Nonempty X] in
theorem measurableEmbedding_toEReal : MeasurableEmbedding (toEReal X) :=
  EReal.measurableEmbedding_coe.comp (measurableEmbedding_embeddingReal X)

/-- The image law on `EReal`. -/
def pushLaw (ν : ProbabilityMeasure X) : ProbabilityMeasure EReal :=
  ⟨(ν : Measure X).map (toEReal X), inferInstance⟩

omit [Nonempty X] in
theorem measurable_pushLaw : Measurable (pushLaw (X := X)) :=
  ((Measure.measurable_map _ measurableEmbedding_toEReal.measurable).comp measurable_subtype_coe).subtype_mk

/-- The measure pulled back to `X`, completed by a point mass where `μ` charges the complement of the range. -/
def pullMeas (μ : Measure EReal) : Measure X :=
  μ.comap (toEReal X) + μ (range (toEReal X))ᶜ • Measure.dirac (Classical.arbitrary X)

theorem pullMeas_apply (μ : Measure EReal) (s : Set X) :
    pullMeas μ s = μ (toEReal X '' s) + μ (range (toEReal X))ᶜ * Measure.dirac (Classical.arbitrary X) s := by
  rw [pullMeas, Measure.add_apply, Measure.smul_apply, smul_eq_mul,
    measurableEmbedding_toEReal.comap_apply]

theorem isProbabilityMeasure_pullMeas (μ : ProbabilityMeasure EReal) :
    IsProbabilityMeasure (pullMeas (X := X) (μ : Measure EReal)) := by
  constructor
  rw [pullMeas_apply _ univ, image_univ, Measure.dirac_apply_of_mem (mem_univ _), mul_one,
    measure_add_measure_compl (measurableEmbedding_toEReal (X := X)).measurableSet_range]
  exact measure_univ

/-- The left inverse of `pushLaw`. -/
def pullLaw (μ : ProbabilityMeasure EReal) : ProbabilityMeasure X :=
  ⟨pullMeas (μ : Measure EReal), isProbabilityMeasure_pullMeas μ⟩

theorem measurable_pullLaw : Measurable (pullLaw (X := X)) := by
  refine Measurable.subtype_mk (Measure.measurable_of_measurable_coe _ fun s hs => ?_)
  have e : (fun μ : ProbabilityMeasure EReal => pullMeas (X := X) (μ : Measure EReal) s) =
      fun μ : ProbabilityMeasure EReal =>
      (μ : Measure EReal) (toEReal X '' s) +
        (μ : Measure EReal) (range (toEReal X))ᶜ * Measure.dirac (Classical.arbitrary X) s := by
    funext μ
    exact pullMeas_apply _ s
  rw [e]
  have h1 := (Measure.measurable_coe (measurableEmbedding_toEReal.measurableSet_image' hs)).comp
    (measurable_subtype_coe (p := fun μ : Measure EReal => IsProbabilityMeasure μ))
  have h2 := (Measure.measurable_coe (measurableEmbedding_toEReal (X := X)).measurableSet_range.compl).comp
    (measurable_subtype_coe (p := fun μ : Measure EReal => IsProbabilityMeasure μ))
  exact h1.add (h2.mul measurable_const)

theorem pullLaw_pushLaw (ν : ProbabilityMeasure X) : pullLaw (pushLaw ν) = ν := by
  apply Subtype.ext
  show pullMeas ((ν : Measure X).map (toEReal X)) = (ν : Measure X)
  rw [pullMeas, measurableEmbedding_toEReal.comap_map,
    measurableEmbedding_toEReal.map_apply, preimage_compl, preimage_range, compl_univ, measure_empty, zero_smul,
    add_zero]

theorem range_pushLaw :
    range (pushLaw (X := X)) = {μ : ProbabilityMeasure EReal | (μ : Measure EReal) (range (toEReal X))ᶜ = 0} := by
  ext μ
  constructor
  · rintro ⟨ν, rfl⟩
    show ((ν : Measure X).map (toEReal X)) (range (toEReal X))ᶜ = 0
    rw [measurableEmbedding_toEReal.map_apply, preimage_compl, preimage_range, compl_univ, measure_empty]
  · intro hμ
    refine ⟨pullLaw μ, Subtype.ext ?_⟩
    show (pullMeas (μ : Measure EReal)).map (toEReal X) = (μ : Measure EReal)
    have hμ' : (μ : Measure EReal) (range (toEReal X))ᶜ = 0 := hμ
    rw [pullMeas, hμ', zero_smul, add_zero, measurableEmbedding_toEReal.map_comap]
    exact Measure.restrict_eq_self_of_ae_mem (measure_eq_zero_iff_ae_notMem.1 hμ' |>.mono fun x hx => by
      simpa using hx)

theorem measurableEmbedding_pushLaw : MeasurableEmbedding (pushLaw (X := X)) := by
  refine MeasurableEmbedding.of_measurable_inverse measurable_pushLaw ?_ measurable_pullLaw pullLaw_pushLaw
  rw [range_pushLaw]
  exact (Measure.measurable_coe (measurableEmbedding_toEReal (X := X)).measurableSet_range.compl).comp
    measurable_subtype_coe (measurableSet_singleton 0)

/-- **The probability laws on a nonempty standard Borel space form a standard Borel space** (Giry σ-algebra). -/
instance standardBorelSpace : StandardBorelSpace (ProbabilityMeasure X) :=
  standardBorelSpace_of_measurableEmbedding measurableEmbedding_pushLaw

end General

end ProbabilityMeasure

end Param12

