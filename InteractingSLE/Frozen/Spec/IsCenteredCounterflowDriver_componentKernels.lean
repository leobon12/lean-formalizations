/-- **Theorem 1.4, component kernels** (Specification p. 5: "The actual component field–path laws are the complete
finite-word kernels of GW4"; Theorem GW4 and Lemma GW3, pp. 636–639). In the setting of Theorem 1.4, let `E` be a
realization of the staged histories of `h` with angles in `[−π/2, π/2]`
(every launched piece almost surely a continuous curve with a continuous generating trace,
`StagedPiecesRegular`; ruling R51), let `R`, `L` be the right and left walks,
and condition on the labelled walks: the σ-algebra generated by the retained data of both walk histories
(`pastSigma` after all their instructions); "conditionally" is the statement under the regular conditional law
`ν = condExpKernel P (…) ω₀`, for `P`-a.e. `ω₀`, with the walks, components and charts of `ω₀`. Then:
* every component `C` of `ℍ \ (R ∪ L)` between the walks has a common-lift chart `(C; x_C, y_C) → (ℍ; 0, ∞)`
  (`IsComponentChart`);
* for every choice `cs` of such charts, with the common lift `ℓ C` of GW3 (a continuous branch of `arg fwd′`; it is
  unique, since the branches differ by `2πℤ` and `χ ≠ 0` shifts the boundary word), the field `h` written in the
  chart of `C` (coefficient `χ`) is a GFF `hC C` whose boundary word is (GW3.1): `−Λ` / `+Λ` on the ordinary extremal
  pieces of the right / left incoming side and the actual original heights on the original-real connectors, with
  every mark retained; the actual counterflow traversal of `C` is, through a continuous increasing clock, the centred
  counterflow `WC C` of that component field (`IsCenteredCounterflowDriver`, whose word is (GW3.2)) with infinite
  relative lifetime; and the component field–path pairs `(hC C, WC C)` are independent, so their joint conditional
  law is the product of the canonical finite-word kernels. -/
theorem IsCenteredCounterflowDriver.componentKernels {κ : ℝ} (hκ : 0 < κ) (hκ4 : κ < 4)
    (b : ℝ → ℝ) (jumps : Finset ℝ) (hb : IsPiecewiseConstantBoundaryData b jumps)
    {Ω : Type u} [MeasurableSpace Ω] [StandardBorelSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens} (hh : IsGFFWithBoundaryData P h b jumps)
    {W' : ℝ≥0 → Ω → ℝ} {ζ' : Ω → ℝ≥0∞}
    (hcf : IsCenteredCounterflowDriver κ P h W' ζ') (hζ' : ∀ᵐ ω ∂P, ζ' ω = ⊤)
    (E : ExplSpec → ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞)
    (hE : ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 →
      IsStagedHistory κ b jumps P h spec (E spec))
    (hreg : ∀ spec : ExplSpec, IsBoundaryContinuedProgram spec.2.2 →
      StagedPiecesRegular κ b jumps P spec (E spec)) :
    let wR := boundaryWalkSpec b jumps (-(Real.pi / 2)) true
    let wL := boundaryWalkSpec b jumps (Real.pi / 2) false
    ∀ᵐ ω₀ ∂P,
      let R := ExplState.physSet κ b jumps wR (fun k => E wR k ω₀)
      let L := ExplState.physSet κ b jumps wL (fun k => E wL k ω₀)
      let ν := condExpKernel P
        (pastSigma κ b jumps wR (E wR) wR.2.2.length ⊔ pastSigma κ b jumps wL (E wL) wL.2.2.length) ω₀
      (∀ C ∈ betweenComponents R L, ∃ c : Chart, IsComponentChart R L C c) ∧
      ∀ cs : Set ℂ → Chart, (∀ C ∈ betweenComponents R L, IsComponentChart R L C (cs C)) →
        ∃ (ℓ : Set ℂ → ℂ → ℝ) (hC : Set ℂ → Ω → LQGMetric.DistOn upperHalfPlaneOpens)
          (WC : Set ℂ → ℝ≥0 → Ω → ℝ) (ζC : Set ℂ → Ω → ℝ≥0∞),
          (∀ C ∈ betweenComponents R L,
            IsComponentChart R L C ((cs C).1, (cs C).2.1, ℓ C) ∧
            (∀ ω, IsChartTransport ((cs C).1, (cs C).2.1, ℓ C) 1 0 (QuantumZipper.chiC κ) (h ω)
              (hC C ω)) ∧
            (∃ (bC : ℝ → ℝ) (jumpsC : Finset ℝ), IsPiecewiseConstantBoundaryData bC jumpsC ∧
              IsComponentBoundaryData κ b (ExplState.ordinarySet κ b jumps wR (fun k => E wR k ω₀))
                (ExplState.ordinarySet κ b jumps wL (fun k => E wL k ω₀)) (cs C).2.1 bC jumpsC ∧
              IsGFFWithBoundaryData ν (hC C) bC jumpsC) ∧
            IsCenteredCounterflowDriver κ ν (hC C) (WC C) (ζC C) ∧
            ∀ᵐ ω ∂ν, ζC C ω = ⊤ ∧
              IsComponentTraversal (cs C).2.1 (fun t => W' t ω) (fun t => WC C t ω)) ∧
          iIndepFun (fun (C : betweenComponents R L) ω => (hC C ω, fun t => WC C t ω)) ν :=
  -- FROZEN_ANCHOR_PROOF_BEGIN
  by exact InteractingSLE.Spec.Provider.IsCenteredCounterflowDriver_componentKernels
  -- FROZEN_ANCHOR_PROOF_END
-- FROZEN_ANCHOR_SUFFIX_BEGIN

end InteractingSLE
