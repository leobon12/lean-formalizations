set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

/-- **The optional hull specification of Theorem 1.1** (Specification p. 9; named in Theorem 1.2,
p. 4, and Corollary LP11, p. 488). A coupling, on `(Ω, P)`, of an ordered integrated `SLE_κ(ρ)`
driving evolution `(𝓕, W, V^{·,L}, V^{·,R}, B, ζ)` of the force word with positions `(xL; xR)` and weights
`(ρL; ρR)` (ARCH-1; `ζ = T_*`) with a random distribution `h` on `ℍ` satisfies it when:
1. `(W, V, B, ζ)` is an integrated `SLE_κ(ρ)` evolution on `(Ω, 𝓕, P)`;
2. `h` is measurable and `h = h⁰ + 𝔥₀` with `h⁰` a zero-boundary GFF on `ℍ`; `𝔥₀ = 𝔥⁰₀` is the
   bounded harmonic extension of the time-zero data (centred positions `x^{i,q}`, `f₀ = id`);
3. for every stopping time `τ` of the usual augmentation `(𝓕ₜ)` of the filtration generated by
   the driving process with `τ < T_*` almost surely:
   * `K_τ` is a local set of `h`, and
   * conditionally on `𝓕_τ`, the restriction of `h` to `ℍ \ K_τ` has the law `𝔥_τ + h̃⁰ ∘ f_τ`,
     `h̃⁰` a fresh independent zero-boundary GFF on `ℍ`: for every test function `φ`, almost
     surely on `{supp φ ∩ K_τ = ∅}`, `E[exp(i (h, φ)) | 𝓕_τ] = exp(i (𝔥_τ, φ) − ½ E_τ(φ))`.
     Here `𝔥_τ` is built from the bounded harmonic extension `𝔥⁰_τ` of the data at the centred
     positions `V̂^{i,q}_τ = V^{i,q}_τ − W_τ`, and `E_τ(φ)` is the variance of `(h̃⁰ ∘ f_τ, φ)`.
The bounded harmonic extensions are quantified universally; they exist and are unique on `ℍ`
(`existsUnique_isBoundedHarmonicExtension_forceBoundaryData`) and only their values on `ℍ`
enter. -/
def IsOptionalHullCoupling (κ : ℝ) {nL nR : ℕ} (xL : Fin nL → ℝ) (xR : Fin nR → ℝ)
    (ρL : Fin nL → ℝ) (ρR : Fin nR → ℝ) {Ω : Type u} {mΩ : MeasurableSpace Ω}
    (P : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → ℝ) (VL : Fin nL → ℝ≥0 → Ω → ℝ)
    (VR : Fin nR → ℝ≥0 → Ω → ℝ) (B : ℝ≥0 → Ω → ℝ) (ζ : Ω → ℝ≥0∞)
    (h : Ω → LQGMetric.DistOn upperHalfPlaneOpens) : Prop :=
  IsIntegratedSLEEvolution κ xL xR ρL ρR P 𝓕 W VL VR B ζ ∧ Measurable h ∧
    (∀ u₀ : ℂ → ℝ, IsBoundedHarmonicExtension (forceBoundaryData κ ρL ρR xL xR)
        (forceJumpSet xL xR) u₀ →
      LQGMetric.IsZBGFFProcess upperHalfPlaneOpens (fun φ ω => h ω φ - ∫ z, u₀ z * φ z) P) ∧
    ∃ hX : IsMeasurableKilledDriving W VL VR ζ,
      ∀ (τ : Ω → WithTop ℝ≥0) (hτ : IsStoppingTime (drivingFiltration P hX) τ),
        (∀ᵐ ω ∂P, (τ ω : ℝ≥0∞) < ζ ω) →
        IsLocalSet (fun ω => QuantumZipper.fwdHull (fun s : ℝ => W s.toNNReal ω)
            ((τ ω).untopD 0 : ℝ≥0)) h P ∧
          ∀ u : Ω → ℂ → ℝ,
            (∀ ω, IsBoundedHarmonicExtension
                (forceBoundaryData κ ρL ρR (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
                  (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω))
                (forceJumpSet (fun i => VL i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω)
                  (fun i => VR i ((τ ω).untopD 0) ω - W ((τ ω).untopD 0) ω))
                (u ω)) →
            ∀ φ : LQGMetric.TestOn upperHalfPlaneOpens, ∀ᵐ ω ∂P,
              Disjoint (tsupport φ) (QuantumZipper.fwdHull (fun s : ℝ => W s.toNNReal ω)
                  ((τ ω).untopD 0 : ℝ≥0)) →
                condExp hτ.measurableSpace P
                    (fun ω' => Complex.exp (Complex.I * (h ω' φ : ℂ))) ω =
                  Complex.exp (Complex.I * ((∫ z, couplingMean κ (fun s : ℝ => W s.toNNReal ω)
                      ((τ ω).untopD 0 : ℝ≥0) (u ω) z * φ z : ℝ) : ℂ) -
                    (((1 / 2 : ℝ) * loewnerGreenEnergy (fun s : ℝ => W s.toNNReal ω)
                      ((τ ω).untopD 0 : ℝ≥0) φ : ℝ) : ℂ))

end InteractingSLE
