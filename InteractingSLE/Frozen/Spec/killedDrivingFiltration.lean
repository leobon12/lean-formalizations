set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

/-- The filtration generated by the driving process killed at `ζ`. -/
def killedDrivingFiltration {Ω : Type u} [mΩ : MeasurableSpace Ω] {nL nR : ℕ}
    {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}
    (hX : IsMeasurableKilledDriving W VL VR ζ) : Filtration ℝ≥0 mΩ where
  seq := killedDrivingSigma W VL VR ζ
  mono' _ _ hst := MeasurableSpace.generateFrom_mono
    fun _ ⟨r, hr, A, hA, hE⟩ => ⟨r, hr.trans hst, A, hA, hE⟩
  le' _ := MeasurableSpace.generateFrom_le fun _ ⟨r, _, A, hA, hE⟩ => hE ▸ hX r A hA

end InteractingSLE
