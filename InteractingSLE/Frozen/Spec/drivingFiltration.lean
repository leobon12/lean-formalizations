import InteractingSLE.Frozen.Spec.usualAugmentation
import InteractingSLE.Frozen.Spec.IsMeasurableKilledDriving
import InteractingSLE.Frozen.Spec.killedDrivingFiltration

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

/-- `(𝓕ₜ)` of Theorem 1.1 (p. 9): the usual augmentation of the filtration generated by the
driving process. -/
def drivingFiltration {Ω : Type u} [mΩ : MeasurableSpace Ω] (P : Measure Ω) {nL nR : ℕ}
    {W : ℝ≥0 → Ω → ℝ} {VL : Fin nL → ℝ≥0 → Ω → ℝ} {VR : Fin nR → ℝ≥0 → Ω → ℝ} {ζ : Ω → ℝ≥0∞}
    (hX : IsMeasurableKilledDriving W VL VR ζ) : Filtration ℝ≥0 mΩ :=
  usualAugmentation (killedDrivingFiltration hX) P

end InteractingSLE
