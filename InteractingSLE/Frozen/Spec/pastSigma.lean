set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology TopologicalSpace
open scoped NNReal ENNReal

universe u

namespace InteractingSLE

/-- The σ-algebra of the retained history before instruction `k`: generated by the retained data (field `s.2.2.1`
of the state) of the pieces launched by instructions `0, …, k−1` — their stopped drivers at rational times (which
determine the continuous stopped drivers), stop times and threshold flags. Connectors are determined by these data
and the original boundary word. The data take values in a standard Borel space, so the conditional kernel given
this σ-algebra fixes the retained history. -/
@[instance_reducible]
def pastSigma (κ : ℝ) (b : ℝ → ℝ) (jumps : Finset ℝ) {Ω : Type u} (spec : ExplSpec)
    (E : ℕ → Ω → (ℝ≥0 → ℝ) × ℝ≥0∞) (k : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap
    (fun ω (i : Fin k) =>
      let r := (ExplState.run κ b jumps spec (fun j => E j ω) k).2.2.1 i
      ((fun q : ℚ => r.1 (q : ℝ).toNNReal), r.2.1, r.2.2)) inferInstance

end InteractingSLE
