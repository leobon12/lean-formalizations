universe u

namespace InteractingSLE

/-- The σ-algebra on subsets of `ℂ` generated by the hitting events `{A : A ∩ U ≠ ∅}`, `U ⊆ ℍ`
open. A relatively closed `A ⊆ ℍ` stands for the element `A ∪ ∂ℍ` of the specification's space
`Γ` of closed sets containing the boundary (p. 49); on `Γ` the Borel σ-algebra of the Hausdorff
distance (in the spherical metric for the unbounded `ℍ`) is generated by these hitting events. -/
@[instance_reducible]
def hittingSigma : MeasurableSpace (Set ℂ) :=
  MeasurableSpace.generateFrom
    {S | ∃ U : Set ℂ, IsOpen U ∧ U ⊆ QuantumZipper.H ∧ S = {A | (A ∩ U).Nonempty}}

end InteractingSLE
