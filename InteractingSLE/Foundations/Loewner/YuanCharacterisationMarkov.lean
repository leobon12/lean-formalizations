import InteractingSLE.Foundations.Loewner.YuanCharacterisationSimple
import QuantumZipper.Proofs.Thm18.LWFarSideCross

/-!
# [Yua22, Theorem 1.1, (ii) ⇒ (i)]

Packet PROVE-YUAN-M23. Property (ii) of [Yua22, Theorem 1.1] ("for every `t`, the path
`g_t(γ(s))`, `s ≥ t`, can be chosen to be continuous", Remark 1.2) is formalized on `[0, S]` as
`HasContinuousOwnFuture`: the future `η|[s, S]` lifts, through the continuous extension `F̄_s` of
`g_s⁻¹` to `ℍ̄`, to a continuous path `β_s` in `ℍ̄`.

`exists_loewner_of_hasContinuousOwnFuture`: such a path, with strictly increasing fillings, is
generated by a Loewner chain with a continuous driver after the capacity time change. The local
growth estimate is the argument of [Law05, Proposition 3.76] for the lifted path `β_s`
(`exists_forall_norm_lift_sub_le`): the increment hull is the filling `B` of `β_s([s, t])`, the
boundary set of its prime ends on `β_s` is an interval `[a, b]` (planar crossing,
QuantumZipper's `lwfSide_crossing`), `diam B ≤ 12 (b − a)` (Koebe), and `b − a ≤ C √(d R)`
(harmonic measure from `∞`, `hm_bound`).

## Topology of filled paths

* `mem_of_mem_closure_of_mem_frontier`: a real boundary point of `ℍ \ fill(P)` adherent to
  `fill(P)` lies on `P` (`P` closed).
* `mem_closure_fillH_of_lt_of_lt`: a real point off a path `P` and between two real points of
  `P` is adherent to `fill(P)` (a path from just above it to `∞` would cross `P`).
-/

set_option autoImplicit false

noncomputable section

open Complex Set Metric Filter Topology Function
open scoped ComplexConjugate

open SupercriticalConformalCovariance (IsConformalBijection)
open QuantumZipper (H Hbar)

namespace InteractingSLE

namespace YuanCharacterisation

/-! ### Topology of filled paths -/

/-- A real boundary point of `ℍ \ fill(P)` adherent to `fill(P)` lies on `P` (`P` closed). -/
theorem mem_of_mem_closure_of_mem_frontier {P : Set ℂ} (hPc : IsClosed P) {q : ℂ}
    (hq : q.im = 0) (hqB : q ∈ closure (fillH P)) (hqf : q ∈ frontier (H \ fillH P)) : q ∈ P := by
  by_contra hqP
  obtain ⟨ρ, hρ, hρP⟩ := Metric.mem_nhds_iff.1 (hPc.isOpen_compl.mem_nhds hqP)
  set D := ball q ρ ∩ H with hD
  have hDc : IsPreconnected D := ((convex_ball q ρ).inter convex_H).isPreconnected
  have hDP : D ⊆ H \ closure P := fun w hw => ⟨hw.2, by
    rw [hPc.closure_eq]; exact hρP hw.1⟩
  set z₀ : ℂ := q + ((ρ / 2 : ℝ) : ℂ) * I with hz₀
  have hz₀D : z₀ ∈ D := by
    refine ⟨?_, ?_⟩
    · rw [mem_ball, dist_eq_norm, hz₀, add_sub_cancel_left, norm_mul, Complex.norm_I, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
      linarith
    · show 0 < z₀.im
      simp [hz₀, hq, hρ]
  have hDsub : D ⊆ connectedComponentIn (H \ closure P) z₀ :=
    hDc.subset_connectedComponentIn hz₀D hDP
  have hcomp : ∀ w ∈ D, connectedComponentIn (H \ closure P) w =
      connectedComponentIn (H \ closure P) z₀ := fun w hw =>
    (connectedComponentIn_eq (hDsub hw)).symm
  by_cases hb : Bornology.IsBounded (connectedComponentIn (H \ closure P) z₀)
  · -- `D ⊆ fill(P)`, against `q ∈ closure (ℍ \ fill(P))`
    have hcl : q ∈ closure (H \ fillH P) := hqf.1
    obtain ⟨w, hw, hwq⟩ := Metric.mem_closure_iff.1 hcl ρ hρ
    have hwD : w ∈ D := ⟨by rw [mem_ball, dist_comm]; exact hwq, hw.1⟩
    exact hw.2 ⟨hw.1, Or.inr (by rw [hcomp w hwD]; exact hb)⟩
  · -- `D ⊆ ℍ \ fill(P)`, against `q ∈ closure (fill(P))`
    obtain ⟨w, hw, hwq⟩ := Metric.mem_closure_iff.1 hqB ρ hρ
    have hwD : w ∈ D := ⟨by rw [mem_ball, dist_comm]; exact hwq, fillH_subset_H _ hw⟩
    rcases hw.2 with h | h
    · exact (hDP hwD).2 h
    · exact hb (by rw [← hcomp w hwD]; exact h)

/-- A real point off a path in `ℍ̄` and strictly between two real points of the path is adherent
to the filling of the path: a path from just above it to `∞` would cross the path
(QuantumZipper's `lwfSide_crossing`). -/
theorem mem_closure_fillH_of_lt_of_lt {ζ : ℝ → ℂ} {T : ℝ} (hc : ContinuousOn ζ (Icc 0 T))
    (hHbar : MapsTo ζ (Icc 0 T) Hbar) {u₁ u₂ : ℝ} (hu₁ : u₁ ∈ Icc 0 T) (hu₂ : u₂ ∈ Icc 0 T)
    (h1 : (ζ u₁).im = 0) (h2 : (ζ u₂).im = 0) {r : ℝ} (hr1 : (ζ u₁).re < r)
    (hr2 : r < (ζ u₂).re) (hrP : (r : ℂ) ∉ ζ '' Icc 0 T) :
    (r : ℂ) ∈ closure (fillH (ζ '' Icc 0 T)) := by
  set P := ζ '' Icc 0 T with hP
  have hPc : IsCompact P := isCompact_Icc.image_of_continuousOn hc
  obtain ⟨R₀, hR₀, hPR₀⟩ := exists_closure_subset_ball hPc.isBounded
  rw [hPc.isClosed.closure_eq] at hPR₀
  set R := R₀ + |r| + 1 with hRdef
  have hR : 0 < R := by positivity
  have hPR : P ⊆ ball 0 R := hPR₀.trans (ball_subset_ball (by linarith [abs_nonneg r]))
  obtain ⟨ρ, hρ, hρP⟩ := Metric.mem_nhds_iff.1 (hPc.isClosed.isOpen_compl.mem_nhds hrP)
  refine Metric.mem_closure_iff.2 fun ε hε => ?_
  set ε' := min (ε / 2) (ρ / 2) with hε'
  have hε'pos : 0 < ε' := lt_min (by positivity) (by positivity)
  set w : ℂ := (r : ℂ) + (ε' : ℂ) * I with hw
  have hwH : w ∈ H := show 0 < w.im by simp [hw, hε'pos]
  have hwr : dist (r : ℂ) w = ε' := by
    rw [dist_eq_norm, hw, sub_add_cancel_left, norm_neg, norm_mul, Complex.norm_I, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hε'pos]
  refine ⟨w, ?_, by rw [hwr]; linarith [min_le_left (ε / 2) (ρ / 2)]⟩
  -- `w` is in a bounded component of `ℍ \ P`
  refine ⟨hwH, Or.inr ?_⟩
  rw [hPc.isClosed.closure_eq]
  by_contra hunb
  have hwP : w ∉ P := fun h => hρP (by
    rw [mem_ball, dist_comm, hwr]; linarith [min_le_right (ε / 2) (ρ / 2)]) h
  -- the component of `w` is the unbounded one, hence contains `(R + 1) i`
  have hcomp := connectedComponentIn_eq_of_not_isBounded hR hPR (z := w) hunb
  have hz₁ : (((R + 1 : ℝ) : ℂ) * I) ∈ connectedComponentIn (H \ P) w := by
    rw [hcomp]; refine mem_connectedComponentIn ⟨?_, fun h => ?_⟩
    · show (0 : ℝ) < (((R + 1 : ℝ) : ℂ) * I).im
      simp only [mul_im, ofReal_re, ofReal_im, I_re, I_im, mul_one, mul_zero, add_zero]
      linarith
    · exact (by
      have := hPR h
      rw [mem_ball_zero_iff, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos (show (0 : ℝ) < R + 1 by linarith)] at this
      linarith)
  have hopen : IsOpen (H \ P) := QuantumZipper.isOpen_H.sdiff hPc.isClosed
  have hpc : IsPathConnected (connectedComponentIn (H \ P) w) :=
    (hopen.connectedComponentIn.isConnected_iff_isPathConnected).1
      (isConnected_connectedComponentIn_iff.2 ⟨hwH, hwP⟩)
  obtain ⟨τ₀, hτ₀⟩ := (hpc.joinedIn w (mem_connectedComponentIn ⟨hwH, hwP⟩) _ hz₁)
  have hτH : ∀ t, τ₀ t ∈ H \ P := fun t =>
    connectedComponentIn_subset _ _ (hτ₀ t)
  -- the arc of `ζ` between `u₁` and `u₂`, shifted by `r`
  set φ : ℝ → ℝ := fun t => u₁ + t * (u₂ - u₁) with hφ
  have hφm : ∀ t ∈ unitInterval, φ t ∈ Icc 0 T := by
    intro t ht
    have h0 := ht.1
    have h1 := ht.2
    constructor <;> nlinarith [hu₁.1, hu₁.2, hu₂.1, hu₂.2]
  have hu₁eq : ζ u₁ - r = (((ζ u₁).re - r : ℝ) : ℂ) := by
    apply Complex.ext <;> simp [h1]
  have hu₂eq : ζ u₂ - r = (((ζ u₂).re - r : ℝ) : ℂ) := by
    apply Complex.ext <;> simp [h2]
  have hσc : Continuous fun t : unitInterval => ζ (φ t) - r :=
    (hc.comp_continuous (f := fun t : unitInterval => φ t) (by fun_prop)
      fun t => hφm t t.2).sub continuous_const
  let σ : Path (((ζ u₁).re - r : ℝ) : ℂ) (((ζ u₂).re - r : ℝ) : ℂ) :=
    { toFun := fun t => ζ (φ t) - r
      continuous_toFun := hσc
      source' := by
        show ζ (u₁ + ((0 : unitInterval) : ℝ) * (u₂ - u₁)) - r = _
        rw [Set.Icc.coe_zero, zero_mul, add_zero]; exact hu₁eq
      target' := by
        show ζ (u₁ + ((1 : unitInterval) : ℝ) * (u₂ - u₁)) - r = _
        rw [Set.Icc.coe_one, one_mul, add_sub_cancel]; exact hu₂eq }
  let τ : Path (w - r) ((((R + 1 : ℝ) : ℂ) * I) - r) :=
    { toFun := fun t => τ₀ t - r
      continuous_toFun := τ₀.continuous.sub continuous_const
      source' := by simp
      target' := by simp }
  have hσim : ∀ t, 0 ≤ (σ t).im := fun t => by
    show 0 ≤ (ζ (φ t) - r).im
    rw [sub_im, ofReal_im, sub_zero]
    exact hHbar (hφm t t.2)
  have hτim : ∀ t, 0 < (τ t).im := fun t => by
    show 0 < (τ₀ t - r).im
    rw [sub_im, ofReal_im, sub_zero]
    exact (hτH t).1
  have hwr' : ‖w - r‖ = ε' := by rw [← dist_eq_norm, dist_comm, hwr]
  have hp : ∀ t, ‖w - r‖ < ‖σ t‖ := fun t => by
    show ‖w - r‖ < ‖ζ (φ t) - r‖
    rw [hwr']
    have hnot : ζ (φ t) ∉ ball (r : ℂ) ρ := fun hb => hρP hb ⟨φ t, hφm t t.2, rfl⟩
    rw [mem_ball, dist_eq_norm, not_lt] at hnot
    linarith [min_le_right (ε / 2) (ρ / 2)]
  have hq : ∀ t, ‖σ t‖ < ‖(((R + 1 : ℝ) : ℂ) * I) - r‖ := fun t => by
    show ‖ζ (φ t) - r‖ < ‖(((R + 1 : ℝ) : ℂ) * I) - r‖
    have h3 : ‖ζ (φ t)‖ < R₀ := mem_ball_zero_iff.1 (hPR₀ ⟨φ t, hφm t t.2, rfl⟩)
    have h4 : ‖ζ (φ t) - r‖ ≤ ‖ζ (φ t)‖ + |r| := by
      have := norm_sub_le (ζ (φ t)) (r : ℂ)
      rwa [Complex.norm_real, Real.norm_eq_abs] at this
    have h5 : R + 1 ≤ ‖(((R + 1 : ℝ) : ℂ) * I) - r‖ := by
      have := abs_im_le_norm ((((R + 1 : ℝ) : ℂ) * I) - r)
      simp only [sub_im, mul_im, ofReal_re, ofReal_im, I_re, I_im, mul_one, mul_zero,
        add_zero, sub_zero] at this
      rwa [abs_of_pos (by linarith)] at this
    linarith
  have hu₁' : (ζ u₁).re - r < 0 := by linarith
  have hu₂' : 0 < (ζ u₂).re - r := by linarith
  obtain ⟨t, t', htt'⟩ := QuantumZipper.Thm18Asm.LWFar.lwfSide_crossing hu₁' hu₂' σ hσim τ hτim
    hp hq
  have : ζ (φ t) = τ₀ t' := by
    have h3 : ζ (φ t) - r = τ₀ t' - r := htt'
    linear_combination h3
  exact (hτH t').2 (this ▸ ⟨φ t, hφm t t.2, rfl⟩)

/-! ### The boundary set of the prime ends on a path -/

/-- The real points sent by `F` onto `P`. -/
def pathSet (P : Set ℂ) (F : ℂ → ℂ) : Set ℝ := {x : ℝ | F x ∈ P}

namespace IsBdryExt

variable {ζ : ℝ → ℂ} {T : ℝ} {g F : ℂ → ℂ}

theorem continuous_ofReal_comp (h : IsBdryExt (fillH (ζ '' Icc 0 T)) g F) :
    Continuous fun x : ℝ => F x :=
  continuous_iff_continuousAt.2 fun x =>
    ((h.continuousOn _ (ofReal_mem_Hbar x)).comp continuous_ofReal.continuousWithinAt
      (fun y _ => ofReal_mem_Hbar y)).continuousAt univ_mem

/-- The prime ends on `closure (fill P)` lie on `P`. -/
theorem bdrySet_subset_pathSet (hc : ContinuousOn ζ (Icc 0 T))
    (h : IsBdryExt (fillH (ζ '' Icc 0 T)) g F) :
    bdrySet (fillH (ζ '' Icc 0 T)) F ⊆ pathSet (ζ '' Icc 0 T) F := by
  intro x hx
  have hPc : IsCompact (ζ '' Icc 0 T) := isCompact_Icc.image_of_continuousOn hc
  have hfr := h.frontier_mem x
  rcases frontier_H_diff_fillH_subset hPc.isBounded hfr with h1 | h1
  · exact mem_of_mem_closure_of_mem_frontier hPc.isClosed h1 hx hfr
  · rwa [hPc.isClosed.closure_eq] at h1

theorem isClosed_pathSet (hc : ContinuousOn ζ (Icc 0 T))
    (h : IsBdryExt (fillH (ζ '' Icc 0 T)) g F) : IsClosed (pathSet (ζ '' Icc 0 T) F) :=
  (isCompact_Icc.image_of_continuousOn hc).isClosed.preimage h.continuous_ofReal_comp

theorem isBounded_pathSet (hc : ContinuousOn ζ (Icc 0 T))
    (h : IsBdryExt (fillH (ζ '' Icc 0 T)) g F) :
    Bornology.IsBounded (pathSet (ζ '' Icc 0 T) F) := by
  obtain ⟨M, hM⟩ := h.bdd
  obtain ⟨r, hr⟩ := (isCompact_Icc.image_of_continuousOn hc).isBounded.exists_norm_le
  refine (Metric.isBounded_iff_subset_closedBall 0).2 ⟨r + M, fun x hx => ?_⟩
  have h1 := hM x (ofReal_mem_Hbar x)
  have h2 := hr _ hx
  rw [mem_closedBall, dist_zero_right, Real.norm_eq_abs]
  have : ‖(x : ℂ)‖ ≤ ‖F x‖ + ‖F x - x‖ := by
    calc ‖(x : ℂ)‖ = ‖F x - (F x - x)‖ := by ring_nf
      _ ≤ ‖F x‖ + ‖F x - x‖ := _root_.norm_sub_le _ _
  rw [Complex.norm_real, Real.norm_eq_abs] at this
  linarith

/-- **The prime ends on a path form an interval.** -/
theorem pathSet_eq_Icc (hc : ContinuousOn ζ (Icc 0 T)) (hHbar : MapsTo ζ (Icc 0 T) Hbar)
    (h : IsBdryExt (fillH (ζ '' Icc 0 T)) g F) (hne : (pathSet (ζ '' Icc 0 T) F).Nonempty) :
    pathSet (ζ '' Icc 0 T) F =
      Icc (sInf (pathSet (ζ '' Icc 0 T) F)) (sSup (pathSet (ζ '' Icc 0 T) F)) := by
  set P := ζ '' Icc 0 T with hP
  set X := pathSet P F with hX
  have hPc : IsCompact P := isCompact_Icc.image_of_continuousOn hc
  have hXc := h.isClosed_pathSet hc
  have hXb := h.isBounded_pathSet hc
  refine Subset.antisymm (fun x hx => ⟨csInf_le hXb.bddBelow hx, le_csSup hXb.bddAbove hx⟩) ?_
  intro x hx
  by_contra hxX
  set X₁ := X ∩ Iic x with hX₁
  set X₂ := X ∩ Ici x with hX₂
  have hX₁ne : X₁.Nonempty := ⟨sInf X, ⟨hXc.csInf_mem hne hXb.bddBelow, hx.1⟩⟩
  have hX₂ne : X₂.Nonempty := ⟨sSup X, ⟨hXc.csSup_mem hne hXb.bddAbove, hx.2⟩⟩
  set x₁ := sSup X₁ with hx₁
  set x₂ := sInf X₂ with hx₂
  have hx₁m : x₁ ∈ X₁ := (hXc.inter isClosed_Iic).csSup_mem hX₁ne ⟨x, fun y hy => hy.2⟩
  have hx₂m : x₂ ∈ X₂ := (hXc.inter isClosed_Ici).csInf_mem hX₂ne ⟨x, fun y hy => hy.2⟩
  have hx₁x : x₁ < x := lt_of_le_of_ne hx₁m.2 fun he => hxX (he ▸ hx₁m.1)
  have hxx₂ : x < x₂ := lt_of_le_of_ne hx₂m.2 fun he => hxX (he.symm ▸ hx₂m.1)
  have hgap : ∀ y ∈ Ioo x₁ x₂, y ∉ X := by
    intro y hy hyX
    rcases le_total y x with hyx | hyx
    · have hmem : y ∈ X₁ := ⟨hyX, hyx⟩
      exact absurd (le_csSup (⟨x, fun z hz => hz.2⟩ : BddAbove X₁) hmem) (not_le.2 hy.1)
    · have hmem : y ∈ X₂ := ⟨hyX, hyx⟩
      exact absurd (csInf_le (⟨x, fun z hz => hz.2⟩ : BddBelow X₂) hmem) (not_le.2 hy.2)
  -- in the gap, `F` is real and off `closure (fill P)`
  have hoff : ∀ y ∈ Ioo x₁ x₂, F y ∉ closure (fillH P) := fun y hy hcl =>
    hgap y hy (h.bdrySet_subset_pathSet hc hcl)
  have hFc : ContinuousOn (fun y : ℝ => F y) (Icc x₁ x₂) := h.continuous_ofReal_comp.continuousOn
  have hreal : ∀ y ∈ Icc x₁ x₂, (F y).im = 0 := by
    intro y hy
    have hcl : Icc x₁ x₂ ⊆ closure (Ioo x₁ x₂) := by
      rw [closure_Ioo (by linarith : x₁ ≠ x₂)]
    have hcont : ContinuousOn (fun y : ℝ => (F y).im) (Icc x₁ x₂) :=
      continuous_im.comp_continuousOn hFc
    have hzero : EqOn (fun y : ℝ => (F y).im) 0 (Ioo x₁ x₂) := fun y hy =>
      h.im_eq_zero (hoff y hy)
    exact (hzero.of_subset_closure hcont continuousOn_const Ioo_subset_Icc_self hcl hy)
  set f : ℝ → ℝ := fun y => (F y).re with hf
  have hfc : ContinuousOn f (Icc x₁ x₂) := continuous_re.comp_continuousOn hFc
  have hFf : ∀ y ∈ Icc x₁ x₂, F y = f y := fun y hy =>
    eq_ofReal_re_of_im_eq_zero (hreal y hy)
  have hinj : ∀ y ∈ Ioo x₁ x₂, ∀ y' ∈ Ioo x₁ x₂, f y = f y' → y = y' := by
    intro y hy y' hy' hyy'
    refine h.eq_of_eq (hoff y hy) ?_
    rw [hFf y (Ioo_subset_Icc_self hy), hFf y' (Ioo_subset_Icc_self hy'), hyy']
  have hx₁I : x₁ ∈ Icc x₁ x₂ := ⟨le_rfl, (hx₁x.trans hxx₂).le⟩
  have hx₂I : x₂ ∈ Icc x₁ x₂ := ⟨(hx₁x.trans hxx₂).le, le_rfl⟩
  have hxI : x ∈ Icc x₁ x₂ := ⟨hx₁x.le, hxx₂.le⟩
  -- a value strictly between two values attained on `[x₁, x₂]` is attained in the gap
  have hIVT : ∀ c, (c - f x₁) * (c - f x) < 0 → ∃ y ∈ Ioo x₁ x, f y = c := by
    intro c hc
    have hcmem : c ∈ uIcc (f x₁) (f x) := by
      rw [mem_uIcc]
      rcases lt_or_gt_of_ne (show f x₁ ≠ f x by intro he; rw [he] at hc; nlinarith) with h' | h'
      · left; constructor <;> nlinarith
      · right; constructor <;> nlinarith
    have := intermediate_value_uIcc (a := x₁) (b := x) (f := f)
      (hfc.mono (by rw [uIcc_of_le hx₁x.le]; exact Icc_subset_Icc_right hxx₂.le))
    rw [uIcc_of_le hx₁x.le] at this
    obtain ⟨y, hy, hfy⟩ := this hcmem
    refine ⟨y, ⟨lt_of_le_of_ne hy.1 fun he => ?_, lt_of_le_of_ne hy.2 fun he => ?_⟩, hfy⟩
    · rw [← he] at hfy; rw [hfy] at hc; nlinarith
    · rw [he] at hfy; rw [hfy] at hc; nlinarith
  have hIVT' : ∀ c, (c - f x₂) * (c - f x) < 0 → ∃ y ∈ Ioo x x₂, f y = c := by
    intro c hc
    have hcmem : c ∈ uIcc (f x₂) (f x) := by
      rw [mem_uIcc]
      rcases lt_or_gt_of_ne (show f x₂ ≠ f x by intro he; rw [he] at hc; nlinarith) with h' | h'
      · left; constructor <;> nlinarith
      · right; constructor <;> nlinarith
    have := intermediate_value_uIcc (a := x₂) (b := x) (f := f)
      (hfc.mono (by rw [uIcc_of_ge hxx₂.le]; exact Icc_subset_Icc_left hx₁x.le))
    rw [uIcc_of_ge hxx₂.le] at this
    obtain ⟨y, hy, hfy⟩ := this hcmem
    refine ⟨y, ⟨lt_of_le_of_ne hy.1 fun he => ?_, lt_of_le_of_ne hy.2 fun he => ?_⟩, hfy⟩
    · rw [← he] at hfy; rw [hfy] at hc; nlinarith
    · rw [he] at hfy; rw [hfy] at hc; nlinarith
  have hFx : F x ∉ P := hxX
  have hFx₁ : F x₁ ∈ P := hx₁m.1
  have hFx₂ : F x₂ ∈ P := hx₂m.1
  have hne₁ : f x ≠ f x₁ := fun he => hFx (by rw [hFf x hxI, he, ← hFf x₁ hx₁I]; exact hFx₁)
  have hne₂ : f x ≠ f x₂ := fun he => hFx (by rw [hFf x hxI, he, ← hFf x₂ hx₂I]; exact hFx₂)
  rcases eq_or_ne (f x₁) (f x₂) with heq | hne
  · -- equal endpoint values: a value between `f x₁` and `f x` is attained twice
    set c := (f x₁ + f x) / 2 with hcd
    have hc1 : (c - f x₁) * (c - f x) < 0 := by
      rw [hcd]; nlinarith [sq_pos_of_ne_zero (sub_ne_zero.2 hne₁)]
    have hc2 : (c - f x₂) * (c - f x) < 0 := by rw [← heq]; exact hc1
    obtain ⟨y₁, hy₁, hfy₁⟩ := hIVT c hc1
    obtain ⟨y₂, hy₂, hfy₂⟩ := hIVT' c hc2
    have := hinj y₁ ⟨hy₁.1, hy₁.2.trans hxx₂⟩ y₂ ⟨hx₁x.trans hy₂.1, hy₂.2⟩ (hfy₁.trans hfy₂.symm)
    linarith [hy₁.2, hy₂.1]
  · -- a real point strictly between two real points of `P`, off `P`, is in `closure (fill P)`
    obtain ⟨u₁, hu₁, hu₁e⟩ := hFx₁
    obtain ⟨u₂, hu₂, hu₂e⟩ := hFx₂
    have hre₁ : (ζ u₁).re = f x₁ := by rw [hu₁e]
    have hre₂ : (ζ u₂).re = f x₂ := by rw [hu₂e]
    have him₁ : (ζ u₁).im = 0 := by rw [hu₁e]; exact hreal x₁ hx₁I
    have him₂ : (ζ u₂).im = 0 := by rw [hu₂e]; exact hreal x₂ hx₂I
    -- the midpoint of `f x₁, f x₂` is a value of `f` in the gap
    set c := (f x₁ + f x₂) / 2 with hcd
    have hcne₁ : c ≠ f x₁ := fun he => hne (by rw [hcd] at he; linarith)
    have hcne₂ : c ≠ f x₂ := fun he => hne (by rw [hcd] at he; linarith)
    obtain ⟨y, hy, hfy⟩ : ∃ y ∈ Ioo x₁ x₂, f y = c := by
      have hcmem : c ∈ uIcc (f x₁) (f x₂) := by
        rw [mem_uIcc]
        rcases lt_or_gt_of_ne hne with h' | h'
        · left; constructor <;> linarith
        · right; constructor <;> linarith
      have := intermediate_value_uIcc (a := x₁) (b := x₂) (f := f)
        (by rw [uIcc_of_le (hx₁x.trans hxx₂).le]; exact hfc)
      rw [uIcc_of_le (hx₁x.trans hxx₂).le] at this
      obtain ⟨y, hy, hfy⟩ := this hcmem
      exact ⟨y, ⟨lt_of_le_of_ne hy.1 fun he => hcne₁ (by rw [← hfy, ← he]),
        lt_of_le_of_ne hy.2 fun he => hcne₂ (by rw [← hfy, he])⟩, hfy⟩
    have hcP : (c : ℂ) ∉ P := fun hm => hgap y hy (by
      show F y ∈ P; rw [hFf y (Ioo_subset_Icc_self hy), hfy]; exact hm)
    have hccl : (c : ℂ) ∈ closure (fillH P) := by
      rcases lt_or_gt_of_ne hne with h' | h'
      · exact mem_closure_fillH_of_lt_of_lt hc hHbar hu₁ hu₂ him₁ him₂
          (by rw [hre₁]; linarith) (by rw [hre₂]; linarith) hcP
      · exact mem_closure_fillH_of_lt_of_lt hc hHbar hu₂ hu₁ him₂ him₁
          (by rw [hre₂]; linarith) (by rw [hre₁]; linarith) hcP
    exact hoff y hy (by rw [hFf y (Ioo_subset_Icc_self hy), hfy]; exact hccl)

end IsBdryExt

/-! ### The continuum through the tip -/

/-- A continuum through `c = η(s)` outside `ℍ \ fill(η[0, s])`: the closed lower half-plane with
`η([0, s₁])`, `s₁` the first time `η` visits `c`. -/
theorem exists_continuum {η : ℝ → ℂ} {s d : ℝ} (hc : ContinuousOn η (Icc 0 s)) (h0 : η 0 = 0)
    (hs : 0 ≤ s) (hd : 0 < d) (hcH : 0 ≤ (η s).im) :
    ∃ L : Set ℂ, IsClosed L ∧ L ⊆ {z : ℂ | z.im ≤ 0} ∪ η '' Icc 0 s ∧
      IsConnected (closure ((fun z => (z - η s)⁻¹) '' (L \ {η s}))) ∧
      ¬ Bornology.IsBounded L ∧ ∃ z ∈ L, z ≠ η s ∧ ‖z - η s‖ ≤ d / 2 := by
  set c := η s with hcdef
  set Z := Icc 0 s ∩ η ⁻¹' {c} with hZ
  have hZc : IsClosed Z := hc.preimage_isClosed_of_isClosed isClosed_Icc isClosed_singleton
  have hZne : Z.Nonempty := ⟨s, ⟨hs, le_rfl⟩, rfl⟩
  have hZb : BddBelow Z := ⟨0, fun u hu => hu.1.1⟩
  set s₁ := sInf Z with hs₁
  have hs₁Z : s₁ ∈ Z := hZc.csInf_mem hZne hZb
  have hs₁c : η s₁ = c := hs₁Z.2
  have hbefore : ∀ u ∈ Icc 0 s, u < s₁ → η u ≠ c := fun u hu hus he =>
    absurd (csInf_le hZb ⟨hu, he⟩) (not_le.2 hus)
  have hs₁s : s₁ ≤ s := csInf_le hZb ⟨⟨hs, le_rfl⟩, rfl⟩
  have hs₁0 : 0 ≤ s₁ := hs₁Z.1.1
  set L := {z : ℂ | z.im ≤ 0} ∪ η '' Icc 0 s₁ with hL
  have hc₁ : ContinuousOn η (Icc 0 s₁) := hc.mono (Icc_subset_Icc_right hs₁s)
  refine ⟨L, (isClosed_le continuous_im continuous_const).union
    (isCompact_Icc.image_of_continuousOn hc₁).isClosed,
    union_subset_union_right _ (image_mono (Icc_subset_Icc_right hs₁s)), ?_, ?_, ?_⟩
  · refine isConnected_closure_inv_image ?_
    have hLeq : L \ {c} = ({z : ℂ | z.im ≤ 0} \ {c}) ∪ η '' Ico 0 s₁ := by
      ext z
      constructor
      · rintro ⟨hz | ⟨u, hu, rfl⟩, hzc⟩
        · exact Or.inl ⟨hz, hzc⟩
        · refine Or.inr ⟨u, ⟨hu.1, lt_of_le_of_ne hu.2 fun he => hzc ?_⟩, rfl⟩
          rw [mem_singleton_iff, he, hs₁c]
      · rintro (⟨hz, hzc⟩ | ⟨u, hu, rfl⟩)
        · exact ⟨Or.inl hz, hzc⟩
        · refine ⟨Or.inr ⟨u, Ico_subset_Icc_self hu, rfl⟩, fun he => ?_⟩
          exact hbefore u ⟨hu.1, hu.2.le.trans hs₁s⟩ hu.2 he
    rw [hLeq]
    have hlow : IsPreconnected ({z : ℂ | z.im ≤ 0} \ {c}) := by
      rcases eq_or_lt_of_le hcH with h' | h'
      · -- `c` real: star-shaped about `c − i`
        have hmem : c - I ∈ {z : ℂ | z.im ≤ 0} \ {c} := ⟨by simp [← h'], fun he => by
          rw [mem_singleton_iff] at he
          have := congrArg Complex.im he
          simp at this⟩
        refine (StarConvex.isPathConnected (a := c - I) ?_ hmem).isConnected.isPreconnected
        intro z hz a b ha hb hab
        have hcim : c.im = 0 := h'.symm
        refine ⟨?_, fun he => ?_⟩
        · show (a • (c - I) + b • z).im ≤ 0
          simp only [add_im, Complex.real_smul, mul_im, ofReal_re, ofReal_im,
            zero_mul, add_zero, sub_im, I_im, hcim]
          have hzim : z.im ≤ 0 := hz.1
          have := mul_nonpos_of_nonneg_of_nonpos hb hzim
          linarith
        · rw [mem_singleton_iff] at he
          have him := congrArg Complex.im he
          simp only [add_im, Complex.real_smul, mul_im, ofReal_re, ofReal_im, zero_mul,
            add_zero, sub_im, I_im, hcim] at him
          have hz1 : z.im ≤ 0 := hz.1
          have ha0 : a = 0 := by nlinarith
          have hb1 : b = 1 := by linarith
          apply hz.2
          rw [mem_singleton_iff, ← he, ha0, hb1, zero_smul, one_smul, zero_add]
      · have : {z : ℂ | z.im ≤ 0} \ {c} = {z : ℂ | z.im ≤ 0} := by
          refine sdiff_eq_left.2 (Set.disjoint_left.2 fun z hz hzc => ?_)
          rw [mem_singleton_iff] at hzc
          have : z.im ≤ 0 := hz
          rw [hzc] at this
          linarith
        rw [this]
        exact isPreconnected_lowerHalf
    have hne : (({z : ℂ | z.im ≤ 0} \ {c}) ∪ η '' Ico 0 s₁).Nonempty :=
      ⟨-I, Or.inl ⟨by simp, fun he => by
        rw [mem_singleton_iff] at he
        have := congrArg Complex.im he
        simp at this
        linarith⟩⟩
    refine ⟨hne, ?_⟩
    rcases eq_or_lt_of_le hs₁0 with h' | h'
    · rw [← h', Ico_self, image_empty, union_empty]
      exact hlow
    · have h0mem : (0 : ℂ) ∈ {z : ℂ | z.im ≤ 0} \ {c} := ⟨by simp, fun he => by
        rw [mem_singleton_iff] at he
        exact hbefore 0 ⟨le_rfl, hs⟩ h' (h0.trans he)⟩
      exact hlow.union 0 h0mem ⟨0, ⟨le_rfl, h'⟩, h0⟩
        (isPreconnected_Ico.image _ (hc₁.mono Ico_subset_Icc_self))
  · intro hb
    obtain ⟨r, hr⟩ := hb.exists_norm_le
    have := hr ((-(|r| + 1) : ℝ) * I) (Or.inl (by simp; linarith [abs_nonneg r]))
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_of_neg (by linarith [abs_nonneg r])] at this
    linarith [le_abs_self r]
  · rcases eq_or_lt_of_le hcH with h' | h'
    · refine ⟨c - ((d / 4 : ℝ) : ℂ) * I, Or.inl ?_, fun he => ?_, ?_⟩
      · show (c - ((d / 4 : ℝ) : ℂ) * I).im ≤ 0
        simp [← h']; linarith
      · have := congrArg Complex.im he
        simp at this
        linarith
      · rw [sub_sub_cancel_left, norm_neg, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos (by positivity)]
        linarith
    · -- `c ∈ ℍ`: approach `c` along `η` before `s₁`
      have hs₁pos : 0 < s₁ := by
        rcases eq_or_lt_of_le hs₁0 with h'' | h''
        · exfalso; rw [← h'', h0] at hs₁c; rw [← hs₁c] at h'; simp at h'
        · exact h''
      obtain ⟨δ, hδ, hδ'⟩ := Metric.continuousWithinAt_iff.1 (hc₁ s₁ ⟨hs₁0, le_rfl⟩) (d / 2)
        (by positivity)
      set u := max 0 (s₁ - δ / 2) with hu
      have hu0 : 0 ≤ u := le_max_left _ _
      have hus : u < s₁ := max_lt hs₁pos (by linarith)
      have hdist : dist u s₁ < δ := by
        rw [Real.dist_eq, abs_of_neg (by linarith)]
        have := le_max_right 0 (s₁ - δ / 2)
        linarith
      refine ⟨η u, Or.inr ⟨u, ⟨hu0, hus.le⟩, rfl⟩,
        hbefore u ⟨hu0, hus.le.trans hs₁s⟩ hus, ?_⟩
      have := hδ' ⟨hu0, hus.le⟩ hdist
      rw [dist_eq_norm, hs₁c] at this
      exact this.le

/-! ### The local growth estimate for a lifted future -/

/-- A nonempty hull `B` with a boundary extension `F` has a real point in its closure (the image of
the left end of its boundary set). -/
theorem IsBdryExt.exists_real_mem_closure {B : Set ℂ} {g F : ℂ → ℂ} (h : IsBdryExt B g F)
    (hB : B.Nonempty) : ∃ q : ℝ, (q : ℂ) ∈ closure B := by
  set X := bdrySet B F with hX
  have hXne := h.bdrySet_nonempty hB
  have hXb := h.isBounded_bdrySet
  set x₀ := sInf X with hx₀
  have hx₀X : x₀ ∈ X := h.isClosed_bdrySet.csInf_mem hXne hXb.bddBelow
  have hFc : Continuous fun x : ℝ => F x :=
    continuous_iff_continuousAt.2 fun x =>
      ((h.continuousOn _ (IsBdryExt.ofReal_mem_Hbar x)).comp continuous_ofReal.continuousWithinAt
        (fun y _ => IsBdryExt.ofReal_mem_Hbar y)).continuousAt univ_mem
  have him : (F x₀).im = 0 := by
    have h1 : Tendsto (fun x : ℝ => (F x).im) (𝓝[<] x₀) (𝓝 (F x₀).im) :=
      ((continuous_im.comp hFc).tendsto x₀).mono_left nhdsWithin_le_nhds
    have h2 : Tendsto (fun x : ℝ => (F x).im) (𝓝[<] x₀) (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with x hx
      exact (h.im_eq_zero fun hxX => absurd (csInf_le hXb.bddBelow hxX) (not_le.2 hx)).symm
    exact tendsto_nhds_unique h1 h2
  refine ⟨(F x₀).re, ?_⟩
  rw [← eq_ofReal_re_of_im_eq_zero him]
  exact hx₀X

/-- **[Law05, Proposition 3.76] for a lifted future.** There is the universal bound
`240 C₁ √(d R)`: let `η` be a path in `ℍ̄` (`η 0 = 0`, `|η| ≤ R`), `A = fill(η[0, s])` with
mapping-out function `g` and boundary extension `F_A` of `g⁻¹`, and let `β` be a continuous path in
`ℍ̄` on `[s, t]` with `F_A ∘ β = η`, where `η([s, t]) ⊆ B̄(η(s), d)`, `0 < d ≤ R`. Then the points
of `β([s, t])` in `ℍ` lie in a disc of radius `240 C₁ √(d R)` centred on `ℝ`. -/
theorem exists_forall_norm_lift_sub_le {C₁ : ℝ} (hC₁ : 0 ≤ C₁) (hcmp : HmComparison C₁)
    {η : ℝ → ℂ} {R s t d : ℝ} (hc : ContinuousOn η (Icc 0 t)) (h0 : η 0 = 0)
    (hHbar : MapsTo η (Icc 0 t) Hbar) (hR : ∀ u ∈ Icc 0 t, ‖η u‖ ≤ R) (hs : 0 ≤ s) (hst : s < t)
    (hd : 0 < d) (hdR : d ≤ R) (hosc : ∀ u ∈ Icc s t, ‖η u - η s‖ ≤ d) {FA : ℂ → ℂ}
    (hFA : IsBdryExt (fillH (η '' Icc 0 s)) (ConformalImage.mapOut (fillH (η '' Icc 0 s))) FA)
    {β : ℝ → ℂ} (hβc : ContinuousOn β (Icc s t)) (hβH : MapsTo β (Icc s t) Hbar)
    (hβ : ∀ u ∈ Icc s t, FA (β u) = η u) :
    ∃ x : ℝ, ∀ u ∈ Icc s t, β u ∈ H → ‖β u - x‖ ≤ 240 * C₁ * √(d * R) := by
  set A := fillH (η '' Icc 0 s) with hAdef
  set g := ConformalImage.mapOut A with hgdef
  have hA := hFA.hull
  have hg := hFA.isMapOut
  have hFAg : ∀ z ∈ H \ A, FA (g z) = z := fun z hz =>
    hg.1.2.injOn (hFA.mem (g z) (hg.1.2.mapsTo hz)).1 hz (hFA.mem (g z) (hg.1.2.mapsTo hz)).2
  have hηsA : η s ∉ H \ A := fun hm => by
    rcases eq_or_lt_of_le hs with h' | h'
    · rw [← h', h0] at hm
      have : (0 : ℝ) < (0 : ℂ).im := hm.1
      simp at this
    · exact hm.2 (mem_fillH_image ⟨hs, le_rfl⟩ hm.1)
  have hβs : (β s).im = 0 := by
    by_contra hne
    have hβsH : β s ∈ H := lt_of_le_of_ne (hβH ⟨le_rfl, hst.le⟩) (Ne.symm hne)
    have := (hFA.mem _ hβsH).1
    rw [hβ s ⟨le_rfl, hst.le⟩] at this
    exact hηsA this
  -- the lifted path re-based at `0`
  set T' := t - s with hT'
  have hT'pos : 0 < T' := by rw [hT']; linarith
  set ζ : ℝ → ℂ := fun v => β (s + v) with hζ
  have hmemv : ∀ v ∈ Icc 0 T', s + v ∈ Icc s t := fun v hv =>
    ⟨by linarith [hv.1], by linarith [hv.2]⟩
  have hζc : ContinuousOn ζ (Icc 0 T') :=
    hβc.comp (continuous_const_add s).continuousOn hmemv
  have hζH : MapsTo ζ (Icc 0 T') Hbar := fun v hv => hβH (hmemv v hv)
  have hζ0 : (ζ 0).im = 0 := by simp only [hζ, add_zero]; exact hβs
  set P := ζ '' Icc 0 T' with hP
  have hPeq : ∀ u ∈ Icc s t, β u ∈ P := fun u hu =>
    ⟨u - s, ⟨by linarith [hu.1], by linarith [hu.2]⟩, by simp [hζ]⟩
  set B := fillH P with hBdef
  have hβB : ∀ u ∈ Icc s t, β u ∈ H → β u ∈ B := fun u hu hβu => by
    obtain ⟨v, hv, hve⟩ := hPeq u hu
    rw [← hve] at hβu ⊢
    exact mem_fillH_image hv hβu
  by_cases hBe : B = ∅
  · refine ⟨0, fun u hu hβu => ?_⟩
    have := hβB u hu hβu
    rw [hBe] at this
    exact absurd this (notMem_empty _)
  have hBne : B.Nonempty := nonempty_iff_ne_empty.2 hBe
  have hB : IsHPHull B := isHPHull_fillH_image_of_im hζc hT'pos.le hζ0
  set gB := ConformalImage.mapOut B with hgBdef
  have hgB : IsMapOut B gB := ConformalImage.isMapOut_mapOut hB
  obtain ⟨FB, hFB1, hFB2, hFBd, hFBc, -, -, -, hFBfr, MB', hMB'⟩ :=
    exists_extension_symm hT'pos.le hζc hζH hζ0
  have hext : IsBdryExt B gB FB := ⟨hB, hgB, hFB1, hFBd, hFBc, fun x =>
    hFBfr ⟨IsBdryExt.ofReal_mem_Hbar x, fun h' => by
      have : (0 : ℝ) < (x : ℂ).im := h'; simp at this⟩, MB', hMB'⟩
  have hsub := hext.bdrySet_subset_pathSet hζc
  have hpne : (pathSet P FB).Nonempty := (hext.bdrySet_nonempty hBne).mono hsub
  set a := sInf (pathSet P FB) with ha
  set b := sSup (pathSet P FB) with hb
  have hX : pathSet P FB = Icc a b := hext.pathSet_eq_Icc hζc hζH hpne
  have hab : a ≤ b := by
    obtain ⟨x, hx⟩ := hpne
    rw [hX] at hx
    exact hx.1.trans hx.2
  have hkoebe : ∀ e ∈ B, ∀ e' ∈ B, ‖e' - e‖ ≤ 12 * (b - a) := fun e he e' he' =>
    hext.norm_sub_le (hsub.trans hX.subset) hab he he'
  obtain ⟨q, hq⟩ := hext.exists_real_mem_closure hBne
  -- the domain `V = F_A(ℍ \ B)` and the composed maps
  set V := (H \ A) ∩ g ⁻¹' (H \ B) with hV
  have hVo : IsOpen V := hg.1.1.continuousOn.isOpen_inter_preimage hA.isOpen hB.isOpen
  have hVH : V ⊆ H := fun z hz => hz.1.1
  set g₂ : ℂ → ℂ := fun z => gB (g z) with hg₂
  set F₂ : ℂ → ℂ := fun ξ => FA (FB ξ) with hF₂
  have hg₂V : ∀ z ∈ V, g₂ z ∈ H := fun z hz => hgB.1.2.mapsTo hz.2
  have hg₂an : ∀ z ∈ V, AnalyticAt ℂ g₂ z := fun z hz =>
    (hgB.1.1.analyticAt (hB.isOpen.mem_nhds hz.2)).comp
      (hg.1.1.analyticAt (hA.isOpen.mem_nhds hz.1))
  have hF₂g : ∀ z ∈ V, F₂ (g₂ z) = z := fun z hz => by
    show FA (FB (gB (g z))) = z
    rw [show FB (gB (g z)) = g z from hFB2 (g z) hz.2]
    exact hFAg z hz.1
  have hFBHbar : MapsTo FB Hbar Hbar := by
    intro w hw
    by_cases hwH : w ∈ H
    · exact H_subset_Hbar (hFB1 w hwH).1.1
    · have hfr := hFBfr ⟨hw, hwH⟩
      have : closure (H \ B) ⊆ Hbar :=
        closure_minimal (fun z hz => H_subset_Hbar hz.1) isClosed_Hbar
      exact this hfr.1
  have hF₂c : ContinuousOn F₂ Hbar := hFA.continuousOn.comp hFBc hFBHbar
  have hF₂H : ∀ ξ ∈ H, F₂ ξ ∈ V := by
    intro ξ hξ
    have h1 := hFB1 ξ hξ
    have h2 := hFA.mem (FB ξ) h1.1.1
    refine ⟨h2.1, ?_⟩
    show g (FA (FB ξ)) ∈ H \ B
    rw [h2.2]
    exact h1.1
  have hF₂ab : ∀ x : ℝ, x ∈ Icc a b → ‖F₂ x - η s‖ ≤ d := by
    intro x hx
    rw [← hX] at hx
    obtain ⟨v, hv, hve⟩ := hx
    show ‖FA (FB x) - η s‖ ≤ d
    rw [← hve, hβ (s + v) (hmemv v hv)]
    exact hosc _ (hmemv v hv)
  obtain ⟨MA, hMA⟩ := hg.exists_norm_sub_le hA
  obtain ⟨MB, hMB⟩ := hgB.exists_norm_sub_le hB
  have hg₂bd : ∀ z ∈ V, ‖g₂ z - z‖ ≤ MA + MB := by
    intro z hz
    have h1 := hMA z hz.1
    have h2 := hMB (g z) hz.2
    calc ‖g₂ z - z‖ = ‖(gB (g z) - g z) + (g z - z)‖ := by simp only [hg₂]; ring_nf
      _ ≤ ‖gB (g z) - g z‖ + ‖g z - z‖ := norm_add_le _ _
      _ ≤ MA + MB := by linarith
  obtain ⟨RB, hRB⟩ := hB.2.1.exists_norm_le
  have hYV : ∀ Y : ℝ, R + 1 + |MA| + |RB| < Y → (Y : ℂ) * I ∈ V := by
    intro Y hY
    have hYA : (Y : ℂ) * I ∈ H \ A :=
      mem_H_diff_fillH_of_lt_im (R := R + 1) (by linarith)
        (hc.mono (Icc_subset_Icc_right hst.le))
        (fun u hu => by linarith [hR u ⟨hu.1, hu.2.trans hst.le⟩])
        (by simp; linarith [abs_nonneg MA, abs_nonneg RB])
    refine ⟨hYA, hg.1.2.mapsTo hYA, fun hgB' => ?_⟩
    have h1 := hRB _ hgB'
    have h2 := hMA _ hYA
    have h3 : Y - MA ≤ ‖g ((Y : ℂ) * I)‖ := by
      have h4 := abs_im_le_norm (g ((Y : ℂ) * I) - (Y : ℂ) * I)
      have h5 := abs_im_le_norm (g ((Y : ℂ) * I))
      rw [sub_im] at h4
      simp only [mul_im, ofReal_re, ofReal_im, I_re, I_im, mul_one, mul_zero, add_zero] at h4
      have h6 := neg_abs_le ((g ((Y : ℂ) * I)).im - Y)
      linarith [le_abs_self (g ((Y : ℂ) * I)).im]
    linarith [le_abs_self MA, le_abs_self RB]
  have hcR : ‖η s‖ ≤ R := hR s ⟨hs, hst.le⟩
  have hcV : η s ∉ V := fun hm => hηsA hm.1
  obtain ⟨L, hLc, hLsub, hLconn, hLub, hLnear⟩ := exists_continuum
    (hc.mono (Icc_subset_Icc_right hst.le)) h0 hs hd (hHbar ⟨hs, hst.le⟩)
  have hLV : Disjoint L V := by
    refine Set.disjoint_left.2 fun z hzL hzV => ?_
    rcases hLsub hzL with hz | ⟨u, hu, rfl⟩
    · exact absurd (show (0 : ℝ) < z.im from hzV.1.1) (not_lt.2 hz)
    · exact hzV.1.2 (mem_fillH_image hu hzV.1.1)
  have hba := hm_bound hC₁ hcmp hVo hVH hcV hab hd hdR hcR hLc hLV hLconn hLub hLnear hg₂V
    hg₂an hF₂g hF₂c hF₂H hF₂ab hg₂bd hYV
  refine ⟨q, fun u hu hβu => ?_⟩
  have heB := hβB u hu hβu
  have hclosed : IsClosed {w : ℂ | ‖w - β u‖ ≤ 12 * (b - a)} :=
    isClosed_le (continuous_id.sub continuous_const).norm continuous_const
  have h1 : ‖(q : ℂ) - β u‖ ≤ 12 * (b - a) :=
    closure_minimal (fun e' he' => hkoebe _ heB e' he') hclosed hq
  rw [norm_sub_rev] at h1
  linarith

/-! ### Property (ii) and the theorem (ii) ⇒ (i) -/

/-- The continuous extension to `ℍ̄` of the inverse of the mapping-out function of `K`. -/
def invExt (K : Set ℂ) : ℂ → ℂ := extendFrom H (invFunOn (ConformalImage.mapOut K) (H \ K))

/-- **Property (ii) of [Yua22, Theorem 1.1]** on `[0, S]` (with Remark 1.2: "`γ_t` can be chosen
to be continuous"): for every `s ∈ [0, S)` the future `η|[s, S]` lifts, through the continuous
extension `F̄_s` of `g_s⁻¹` (`g_s` the mapping-out function of `K_s = fill(η[0, s])`), to a
continuous path `β_s` in `ℍ̄`: `F̄_s(β_s(u)) = η(u)`; where `η(u) ∈ ℍ \ K_s` this says
`β_s(u) = g_s(η(u))`. -/
def HasContinuousOwnFuture (η : ℝ → ℂ) (S : ℝ) : Prop :=
  ∀ s ∈ Ico 0 S, ∃ β : ℝ → ℂ, ContinuousOn β (Icc s S) ∧ MapsTo β (Icc s S) Hbar ∧
    ∀ u ∈ Icc s S, invExt (fillH (η '' Icc 0 s)) (β u) = η u

/-- The boundary extension of `g_s⁻¹` for the filling of a path, as an `IsBdryExt`, agreeing with
`invExt` on `ℍ̄`. -/
theorem exists_isBdryExt_invExt {ζ : ℝ → ℂ} {s : ℝ} (hs : 0 ≤ s) (hc : ContinuousOn ζ (Icc 0 s))
    (hζH : MapsTo ζ (Icc 0 s) Hbar) (h0 : ζ 0 = 0) :
    ∃ F : ℂ → ℂ, IsBdryExt (fillH (ζ '' Icc 0 s)) (ConformalImage.mapOut (fillH (ζ '' Icc 0 s))) F ∧
      MapsTo F (Hbar \ H) (frontier (H \ fillH (ζ '' Icc 0 s))) ∧
      EqOn (invExt (fillH (ζ '' Icc 0 s))) F Hbar := by
  set A := fillH (ζ '' Icc 0 s) with hAdef
  have hA : IsHPHull A := isHPHull_fillH_image hc hs h0
  set g := ConformalImage.mapOut A with hgdef
  have hg : IsMapOut A g := ConformalImage.isMapOut_mapOut hA
  obtain ⟨F, hF1, -, hFd, hFc, -, -, -, hFfr, M, hM⟩ :=
    exists_extension_symm hs hc hζH (by rw [h0, zero_im])
  have hext : IsBdryExt A g F := ⟨hA, hg, hF1, hFd, hFc, fun x =>
    hFfr ⟨IsBdryExt.ofReal_mem_Hbar x, fun h' => by
      have : (0 : ℝ) < (x : ℂ).im := h'; simp at this⟩, M, hM⟩
  refine ⟨F, hext, hFfr, fun x hx => ?_⟩
  have hinv : EqOn (invFunOn g (H \ A)) F H := by
    intro w hw
    have hwim : w ∈ g '' (H \ A) := ⟨F w, (hF1 w hw).1, (hF1 w hw).2⟩
    have h1 := invFunOn_mem hwim
    have h2 := invFunOn_eq hwim
    exact hg.1.2.injOn h1 (hF1 w hw).1 (h2.trans (hF1 w hw).2.symm)
  have hxcl : x ∈ closure H := by rw [QuantumZipper.CA.Car.closure_H_eq_Hbar]; exact hx
  refine extendFrom_eq hxcl ?_
  exact ((hFc x hx).mono H_subset_Hbar).tendsto.congr' (eventually_nhdsWithin_of_forall
    fun w hw => (hinv hw).symm)

/-- **[Yua22, Theorem 1.1, (ii) ⇒ (i)] with Loewner's theorem**: a continuous path `η : [0, S] →
ℍ̄` with `η 0 = 0`, strictly increasing fillings `K_t = fill(η[0, t])`, and continuous own futures
(`HasContinuousOwnFuture`) generates a Loewner chain: there are a continuous driver `W`, `W 0 = 0`,
and a continuous strictly increasing time change `σ`, `σ 0 = 0`, such that the hull of `W` at time
`σ(t)` is `K_t` for every `t ∈ [0, S]`. -/
theorem exists_loewner_of_hasContinuousOwnFuture {η : ℝ → ℂ} {S : ℝ} (hS : 0 < S)
    (hη : ContinuousOn η (Icc 0 S)) (h0 : η 0 = 0) (hHbar : MapsTo η (Icc 0 S) Hbar)
    (hmono : StrictMonoOn (fun t => fillH (η '' Icc 0 t)) (Icc 0 S))
    (hii : HasContinuousOwnFuture η S) :
    ∃ W : ℝ → ℝ, Continuous W ∧ W 0 = 0 ∧ ∃ σ : ℝ → ℝ, σ 0 = 0 ∧ StrictMonoOn σ (Icc 0 S) ∧
      ContinuousOn σ (Icc 0 S) ∧
      ∀ t ∈ Icc 0 S, QuantumZipper.fwdHull W (σ t) = fillH (η '' Icc 0 t) := by
  obtain ⟨C₁, hC₁, hcmp⟩ := le_mul_hmIoo
  have hcmp' : HmComparison C₁ := hcmp
  obtain ⟨M, hM⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := S)).exists_bound_of_continuousOn hη
  set R := |M| + 1 with hRdef
  have hRpos : 0 < R := by positivity
  have hηR : ∀ u ∈ Icc 0 S, ‖η u‖ ≤ R := fun u hu => by
    linarith [hM u hu, le_abs_self M]
  refine exists_loewner_of_localGrowth hS hη h0 hmono fun ε hε => ?_
  set K₀ := 480 * C₁ + 1 with hK₀
  have hK₀pos : 0 < K₀ := by positivity
  set d := min R (ε ^ 2 / (K₀ ^ 2 * R)) with hd
  have hdpos : 0 < d := lt_min hRpos (by positivity)
  have hdR : d ≤ R := min_le_left _ _
  have hρ : 2 * (240 * C₁ * √(d * R)) ≤ ε := by
    have h1 : d * R ≤ (ε / K₀) ^ 2 := by
      have := mul_le_mul_of_nonneg_right (min_le_right R (ε ^ 2 / (K₀ ^ 2 * R))) hRpos.le
      rw [← hd] at this
      calc d * R ≤ ε ^ 2 / (K₀ ^ 2 * R) * R := this
        _ = (ε / K₀) ^ 2 := by field_simp
    have h2 : √(d * R) ≤ ε / K₀ := Real.sqrt_le_iff.2 ⟨by positivity, h1⟩
    have h3 : 480 * C₁ * √(d * R) ≤ 480 * C₁ * (ε / K₀) :=
      mul_le_mul_of_nonneg_left h2 (by positivity)
    have h4 : 480 * C₁ * (ε / K₀) ≤ ε := by
      rw [mul_div_assoc', div_le_iff₀ hK₀pos]
      nlinarith
    linarith
  obtain ⟨δ, hδ, hδu⟩ := Metric.uniformContinuousOn_iff.1
    (isCompact_Icc.uniformContinuousOn_of_continuous hη) d hdpos
  refine ⟨δ / 2, by positivity, fun s t hs hst htS hts => ?_⟩
  rcases eq_or_lt_of_le hst with hst' | hst'
  · refine ⟨0, fun z hz => ?_⟩
    rw [hst'] at hz
    exact absurd hz.1 hz.2
  have hsS : s < S := hst'.trans_le htS
  obtain ⟨β, hβc, hβH, hβ⟩ := hii s ⟨hs, hsS⟩
  obtain ⟨F, hext, hFfr, hFeq⟩ := exists_isBdryExt_invExt hs
    (hη.mono (Icc_subset_Icc_right hsS.le)) (fun u hu => hHbar ⟨hu.1, hu.2.trans hsS.le⟩) h0
  have hβ' : ∀ u ∈ Icc s t, F (β u) = η u := fun u hu => by
    have hu' : u ∈ Icc s S := ⟨hu.1, hu.2.trans htS⟩
    rw [← hFeq (hβH hu'), hβ u hu']
  have hosc : ∀ u ∈ Icc s t, ‖η u - η s‖ ≤ d := by
    intro u hu
    have := hδu u ⟨hs.trans hu.1, hu.2.trans htS⟩ s ⟨hs, hsS.le⟩ (by
      rw [Real.dist_eq, abs_of_nonneg (by linarith [hu.1])]; linarith [hu.2])
    rw [dist_eq_norm] at this
    exact this.le
  obtain ⟨x, hx⟩ := exists_forall_norm_lift_sub_le hC₁ hcmp' (hη.mono (Icc_subset_Icc_right htS))
    h0 (fun u hu => hHbar ⟨hu.1, hu.2.trans htS⟩) (fun u hu => hηR u ⟨hu.1, hu.2.trans htS⟩)
    hs hst' hdpos hdR hosc hext (hβc.mono (Icc_subset_Icc_right htS))
    (fun u hu => hβH ⟨hu.1, hu.2.trans htS⟩) hβ'
  -- trace points: `g_s(η(u)) = β(u)`
  have htr : ∀ u ∈ Ioc s t, η u ∈ H \ fillH (η '' Icc 0 s) →
      ‖ConformalImage.mapOut (fillH (η '' Icc 0 s)) (η u) - x‖ ≤ 240 * C₁ * √(d * R) := by
    intro u hu hηu
    have hu' : u ∈ Icc s t := Ioc_subset_Icc_self hu
    have hβuH : β u ∈ H := by
      by_contra hn
      have hfr := hFfr ⟨hβH ⟨hu'.1, hu'.2.trans htS⟩, hn⟩
      rw [hext.hull.isOpen.frontier_eq, hβ' u hu'] at hfr
      exact hfr.2 hηu
    have hgβ := (hext.mem (β u) hβuH).2
    rw [hβ' u hu'] at hgβ
    rw [hgβ]
    exact hx u hu' hβuH
  refine ⟨x, fun z hz => ?_⟩
  have := norm_mapOut_sub_le_of_trace (R := R + 1) (by linarith) hη h0
    (fun u hu => by linarith [hηR u hu]) hs hst htS htr hz
  linarith

end YuanCharacterisation

