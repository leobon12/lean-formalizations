import InteractingSLE.Spec.Supplement.LPProbExtract

/-!
# The measurable coding of "the trace exists on `[0, ∞)`" from the stopped codings

Packet PROVE-TRACECODE. The named input `Sec7.TopTraceCodingStatement` of PROVE-SEC7-A4 (Corollary LP11's proof,
pp. 488–489; Aux. lemma 126's proof, pp. 399–400) asks for a measurable set `G` of rational-time values whose members,
among the restrictions of continuous drivers `w` with `w 0 = 0`, are exactly those for which the Loewner chain of `w`
is generated by a continuous trace on `[0, ∞)`. PROVE-SEC7-D2's `Sec7.StoppedTraceCodingStatement` is the same with
the horizon replaced by the buffered stop `S_r(w) = r²/64 ∧ inf{t : |w t| ≥ r/4}`.

The `T = ∞` coding is the countable intersection of the stopped ones at `r = 1, 2, 3, …`:

* `exists_lt_bufferedStop`: for a continuous `w`, every time lies before `S_{n+1}(w)` for some `n` (`w` is bounded on
  compact intervals, and `r²/64 → ∞`);
* hence a continuous generating trace on `[0, ∞)` exists iff one through `S_{n+1}(w)` exists for every `n`
  (`exists_isGeneratingTrace_top_iff_forall_bufferedStop`): restriction (`LP.isGeneratingTrace_mono`) one way, and
  gluing of the stopped traces (`LP.exists_isGeneratingTrace_top_of_forall_lt`, uniqueness of the trace before the
  horizon) the other;
* `topTraceCodingStatement_of_stopped : StoppedTraceCodingStatement → TopTraceCodingStatement`.

The unconditional statements are in `TraceCodingTop.lean`, from PROVE-T14-IN's `Sec7.Coding.stoppedTraceCodingStatement`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory Filter Set Topology
open scoped NNReal ENNReal

namespace InteractingSLE

namespace Sec7

/-- **The buffered stops exhaust time.** For a continuous driver `w` and every time `t`, some buffered stop
`S_{n+1}(w) = (n+1)²/64 ∧ inf{s : |w s| ≥ (n+1)/4}` lies strictly after `t`. -/
theorem exists_lt_bufferedStop {w : ℝ≥0 → ℝ} (hw : Continuous w) (t : ℝ≥0) :
    ∃ n : ℕ, (t : ℝ≥0∞) < Dilation.bufferedStop ((n : ℝ) + 1) w := by
  obtain ⟨M, hM⟩ := (isCompact_Icc (a := (0 : ℝ≥0)) (b := t + 1)).exists_bound_of_continuousOn
    hw.continuousOn
  have hM' : ∀ s ∈ Icc (0 : ℝ≥0) (t + 1), |w s| ≤ M := fun s hs => by
    simpa [Real.norm_eq_abs] using hM s hs
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM' 0 ⟨le_rfl, zero_le⟩)
  obtain ⟨n, hn⟩ := exists_nat_gt (4 * M + 8 * ((t : ℝ) + 1))
  have ht0 : (0 : ℝ) ≤ t := t.2
  refine ⟨n, lt_min ?_ ?_⟩
  · rw [← ENNReal.ofReal_coe_nnreal]
    refine (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 ?_
    have h8 : 8 * ((t : ℝ) + 1) < (n : ℝ) + 1 := by linarith
    have h1 : 64 * ((t : ℝ) + 1) ≤ 64 * ((t : ℝ) + 1) ^ 2 := by nlinarith
    have h2 : 64 * ((t : ℝ) + 1) ^ 2 < ((n : ℝ) + 1) ^ 2 := by nlinarith
    rw [lt_div_iff₀ (by norm_num)]
    nlinarith
  · unfold Dilation.exitTime
    refine lt_of_lt_of_le (b := ((t + 1 : ℝ≥0) : ℝ≥0∞)) (by exact_mod_cast lt_add_one t)
      (le_iInf₂ fun s hs => ?_)
    by_contra hlt
    have hst : s ≤ t + 1 := by exact_mod_cast (not_le.1 hlt).le
    have := hM' s ⟨zero_le, hst⟩
    linarith

/-- **A continuous generating trace on `[0, ∞)` exists iff one through every buffered stop `S_{n+1}` exists**, for a
continuous driver `w` with `w 0 = 0`. -/
theorem exists_isGeneratingTrace_top_iff_forall_bufferedStop {w : ℝ≥0 → ℝ} (hw : Continuous w)
    (hw0 : w 0 = 0) :
    (∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w ⊤ η) ↔
      ∀ n : ℕ, ∃ η : ℝ≥0 → ℂ, IsGeneratingTrace w (Dilation.bufferedStop ((n : ℝ) + 1) w) η := by
  constructor
  · rintro ⟨η, hη⟩ n
    exact ⟨η, LP.isGeneratingTrace_mono hη le_top⟩
  · exact LP.exists_isGeneratingTrace_top_of_forall_lt hw hw0 _ (exists_lt_bufferedStop hw)

/-- **The `T = ∞` trace coding from the stopped trace codings**: the intersection of the measurable codings at the
buffer radii `1, 2, 3, …` codes the existence of a continuous generating trace on `[0, ∞)`. -/
theorem topTraceCodingStatement_of_stopped (h : StoppedTraceCodingStatement) : TopTraceCodingStatement := by
  choose G hGm hG using fun n : ℕ => h ((n : ℝ) + 1) (by positivity)
  refine ⟨⋂ n, G n, MeasurableSet.iInter hGm, fun w hw hw0 => ?_⟩
  rw [mem_iInter, exists_isGeneratingTrace_top_iff_forall_bufferedStop hw hw0]
  exact forall_congr' fun n => hG n w hw hw0

/-- The transient-trace coding (`T = ∞`, trace tending to infinity) from the stopped trace codings. -/
theorem transientTraceCodingStatement_of_stopped (h : StoppedTraceCodingStatement) :
    TransientTraceCodingStatement :=
  transientTraceCodingStatement_of_top (topTraceCodingStatement_of_stopped h)

end Sec7

end InteractingSLE
