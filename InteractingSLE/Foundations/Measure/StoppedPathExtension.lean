import Mathlib.MeasureTheory.Constructions.Polish.StronglyMeasurable
import Mathlib.Topology.Instances.ENNReal.Lemmas
import InteractingSLE.Foundations.Measure.KolmogorovExtension

/-!
# Patching consistent stopped path laws into one law up to the limit time

Packet PROVE-EXT, item (3): the path-space extension used to patch the localized laws of
Theorem 2.2 (`planning/handoffs/PROVE-SEC2-GIR2.md`, "What remains", item 1). Infrastructure, not a
frozen source-facing file.

Setting. On a measurable space `Ω` we are given probability measures `Q n`, a process
`X : ℝ≥0 → Ω → E` with values in a complete separable metric space `E`, and times
`τ n : Ω → ℝ≥0∞`, nondecreasing in `n`, such that under `Q n` the path of `X` is continuous on
`[0, τ n)`. The *observation at horizon `n`* is the path killed at `τ n` (value `0` from `τ n` on)
together with the times stopped at `τ n`:

  `observe X τ n ω = (killAt (τ n ω) (X · ω), fun k => min (τ k ω) (τ n ω))`.

If `Q (n + 1)` and `Q n` give the observation at horizon `n` the same law (the localized laws are
consistent), then (`exists_patched_law`) there is one probability measure `μ` on the standard Borel
skeleton space `SkelObs E = (ℕ × ℕ → E) × (ℕ → ℝ≥0∞)` (a path at the dyadic times
`dyTime (j, k) = k / 2 ^ j`, and the times), such that the canonical process
`X' t z = (extend z).1 t` (the continuous extension of the skeleton from the dyadic times, killed at
`⨆ n, z.2 n`) with the canonical times `τ' n z = z.2 n` has, for every `n`, the same observation law
under `μ` as `X, τ` under `Q n`; moreover `μ`-a.s. the times are nondecreasing and the path `X'` is
continuous on `[0, ⨆ n, τ' n)`. The `Q n` need not be restrictions of one measure on `Ω` (the limit
time may be a `Q n`-null event for every `n`); this is a projective limit, built from the inverse
limit theorem `Kolmogorov.exists_map_eval_eq_of_lawConsistent` on the skeleton spaces.

## Main results

* `exists_patched_law`: the patching theorem;
* `map_observe_eq_of_cylEvent`: the observation law at horizon `n` is determined by the killed
  cylinder events `{t < τ n, X t ∈ A t (t ∈ F)} ∩ {d k < τ k ∧ τ n (k ∈ K)}` (each lies in `𝓕_D`
  and inside `{D < τ n}` for `D` the largest time involved), the form in which Girsanov
  consistency (`Sec2.IsSLEEvolutionUpTo.girsanovMeasure_weightDrift_apply_eq`) is available;
* `eq_of_map_observe_eq`: two measures with the same observation laws at every horizon agree on
  the σ-algebra generated by all the observations;
* `continuousOn_extend_of_regBelow`, `extend_skel_observe`, `observe_canon`, `skelProj_glue`: the
  skeleton/extension calculus behind it.
-/

set_option autoImplicit false
noncomputable section
open Set Filter Topology MeasureTheory
open scoped NNReal ENNReal

namespace InteractingSLE.StoppedPath

/-! ### Dyadic times -/

/-- The dyadic time `k / 2 ^ j` indexed by `(j, k)`. -/
def dyTime (p : ℕ × ℕ) : ℝ≥0 := (p.2 : ℝ≥0) / 2 ^ p.1

/-- The dyadic time of level `j` just below `t`: `⌊t 2^j⌋ / 2^j`. -/
def dyBelow (j : ℕ) (t : ℝ≥0) : ℕ × ℕ := (j, ⌊t * 2 ^ j⌋₊)

theorem dyTime_dyBelow_le (j : ℕ) (t : ℝ≥0) : dyTime (dyBelow j t) ≤ t := by
  rw [dyTime, dyBelow, div_le_iff₀ (pow_pos two_pos j)]
  exact Nat.floor_le zero_le

theorem sub_lt_dyTime_dyBelow (j : ℕ) (t : ℝ≥0) :
    (t : ℝ) - 1 / 2 ^ j < (dyTime (dyBelow j t) : ℝ) := by
  have h2 : (0 : ℝ) < 2 ^ j := pow_pos two_pos j
  have hfl : (t : ℝ) * 2 ^ j < (⌊t * 2 ^ j⌋₊ : ℝ) + 1 := by
    have := Nat.lt_floor_add_one (t * 2 ^ j)
    exact_mod_cast this
  rw [dyTime, dyBelow, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_natCast, NNReal.coe_ofNat,
    lt_div_iff₀ h2, sub_mul, one_div, inv_mul_cancel₀ h2.ne']
  linarith

theorem tendsto_dyTime_dyBelow (t : ℝ≥0) :
    Tendsto (fun j => dyTime (dyBelow j t)) atTop (𝓝 t) := by
  rw [← NNReal.tendsto_coe]
  have h1 : Tendsto (fun j : ℕ => (t : ℝ) - 1 / 2 ^ j) atTop (𝓝 (t : ℝ)) := by
    have : Tendsto (fun j : ℕ => (1 : ℝ) / 2 ^ j) atTop (𝓝 0) := by
      simp only [one_div, ← inv_pow]
      exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
    simpa using tendsto_const_nhds.sub this
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le h1 tendsto_const_nhds
    (fun j => (sub_lt_dyTime_dyBelow j t).le) (fun j => by exact_mod_cast dyTime_dyBelow_le j t)

/-- Between a finite time and a larger extended time there is a dyadic time. -/
theorem exists_dyTime_btwn {t : ℝ≥0} {L : ℝ≥0∞} (h : (t : ℝ≥0∞) < L) :
    ∃ r : ℕ × ℕ, t < dyTime r ∧ (dyTime r : ℝ≥0∞) < L := by
  obtain ⟨a, hta, haL⟩ := ENNReal.lt_iff_exists_nnreal_btwn.1 h
  have hta' : t < a := by exact_mod_cast hta
  have hpos : (0 : ℝ) < (a : ℝ) - t := by rw [sub_pos]; exact_mod_cast hta'
  obtain ⟨j, hj⟩ := exists_pow_lt_of_lt_one hpos (by norm_num : (1 / 2 : ℝ) < 1)
  refine ⟨(j, ⌊t * 2 ^ j⌋₊ + 1), ?_, ?_⟩
  · rw [dyTime, lt_div_iff₀ (pow_pos two_pos j)]
    push_cast
    exact Nat.lt_floor_add_one _
  · refine lt_of_le_of_lt ?_ haL
    have h2 : (0 : ℝ) < 2 ^ j := pow_pos two_pos j
    have hle : (dyTime (j, ⌊t * 2 ^ j⌋₊ + 1) : ℝ) ≤ a := by
      rw [dyTime, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat, div_le_iff₀ h2]
      push_cast
      have hfl : ((⌊t * 2 ^ j⌋₊ : ℝ≥0) : ℝ) ≤ (t : ℝ) * 2 ^ j := by
        exact_mod_cast Nat.floor_le zero_le
      have hj' : (1 : ℝ) ≤ ((a : ℝ) - t) * 2 ^ j := by
        rw [div_pow, one_pow, div_lt_iff₀ h2] at hj
        linarith
      push_cast at hfl
      nlinarith
    exact_mod_cast hle

/-! ### Observation spaces -/

section Defs

variable {E : Type*} [Zero E]

/-- Observation space: a path together with a sequence of times. -/
abbrev PathObs (E : Type*) := (ℝ≥0 → E) × (ℕ → ℝ≥0∞)

/-- Skeleton space: a path at the dyadic times, together with a sequence of times. -/
abbrev SkelObs (E : Type*) := (ℕ × ℕ → E) × (ℕ → ℝ≥0∞)

/-- Kill a path at time `T` (value `0` from `T` on). -/
def killAt (T : ℝ≥0∞) (x : ℝ≥0 → E) : ℝ≥0 → E := fun t => if (t : ℝ≥0∞) < T then x t else 0

/-- Kill a skeleton at time `T`. -/
def skelKill (T : ℝ≥0∞) (y : ℕ × ℕ → E) : ℕ × ℕ → E :=
  fun p => if (dyTime p : ℝ≥0∞) < T then y p else 0

/-- The observation at horizon `n`: the path killed at `τ n` and the times stopped at `τ n`. -/
def observe {Ω : Type*} (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) (ω : Ω) : PathObs E :=
  (killAt (τ n ω) (fun t => X t ω), fun k => min (τ k ω) (τ n ω))

/-- The dyadic skeleton of an observation. -/
def skel (z : PathObs E) : SkelObs E := (fun p => z.1 (dyTime p), z.2)

/-- Projection of a skeleton to horizon `n`. -/
def skelProj (n : ℕ) (z : SkelObs E) : SkelObs E :=
  (skelKill (z.2 n) z.1, fun k => min (z.2 k) (z.2 n))

/-- The life time `⨆ k, s k` of a sequence of times. -/
def life (s : ℕ → ℝ≥0∞) : ℝ≥0∞ := ⨆ k, s k

theorem life_min (s : ℕ → ℝ≥0∞) (n : ℕ) : life (fun k => min (s k) (s n)) = s n :=
  le_antisymm (iSup_le fun _ => min_le_right _ _)
    ((le_of_eq (min_self (s n)).symm).trans (le_iSup (fun k => min (s k) (s n)) n))

end Defs

section Extend

variable {E : Type*} [Zero E] [TopologicalSpace E]

/-- The continuous extension of a skeleton: the limit along the dyadic times from below, killed at
the life time of its times. -/
def extend (z : SkelObs E) : PathObs E :=
  (fun t => if (t : ℝ≥0∞) < life z.2 then limUnder atTop (fun j => z.1 (dyBelow j t)) else 0, z.2)

/-- The canonical process on the skeleton space. -/
def canonX (t : ℝ≥0) (z : SkelObs E) : E := (extend z).1 t

/-- The canonical times on the skeleton space. -/
def canonT (n : ℕ) (z : SkelObs E) : ℝ≥0∞ := z.2 n

theorem canonX_of_life_le {z : SkelObs E} {t : ℝ≥0} (h : life z.2 ≤ t) : canonX t z = 0 := by
  simp [canonX, extend, not_lt.2 h]

/-- Observing the canonical process is projecting and extending. -/
theorem observe_canon (n : ℕ) (z : SkelObs E) :
    observe canonX canonT n z = extend (skelProj n z) := by
  refine Prod.ext ?_ (by rfl)
  funext t
  simp only [observe, killAt, canonX, canonT, extend, skelProj, life_min]
  by_cases ht : (t : ℝ≥0∞) < z.2 n
  · have hl : (t : ℝ≥0∞) < life z.2 := lt_of_lt_of_le ht (le_iSup z.2 n)
    rw [ite_eq_left ht, ite_eq_left hl, ite_eq_left ht]
    congr 1
    funext j
    rw [skelKill, ite_eq_left (lt_of_le_of_lt (by exact_mod_cast dyTime_dyBelow_le j t) ht)]
  · rw [ite_eq_right ht, ite_eq_right ht]

/-- The skeleton of an observation whose path is continuous before the horizon extends back to
the observation. -/
theorem extend_skel_observe [T2Space E] {Ω : Type*} (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) (ω : Ω)
    (hc : ContinuousOn (fun t => X t ω) {t | (t : ℝ≥0∞) < τ n ω}) :
    extend (skel (observe X τ n ω)) = observe X τ n ω := by
  refine Prod.ext ?_ rfl
  funext t
  simp only [extend, skel, observe, killAt, life_min]
  by_cases ht : (t : ℝ≥0∞) < τ n ω
  · rw [ite_eq_left ht, ite_eq_left ht]
    have hev : ∀ j, (if (dyTime (dyBelow j t) : ℝ≥0∞) < τ n ω then X (dyTime (dyBelow j t)) ω
        else 0) = X (dyTime (dyBelow j t)) ω := fun j =>
      ite_eq_left (lt_of_le_of_lt (by exact_mod_cast dyTime_dyBelow_le j t) ht)
    simp_rw [hev]
    have hopen : IsOpen {t : ℝ≥0 | (t : ℝ≥0∞) < τ n ω} :=
      isOpen_lt ENNReal.continuous_coe continuous_const
    have hca : ContinuousAt (fun t => X t ω) t := hc.continuousAt (hopen.mem_nhds ht)
    exact (hca.tendsto.comp (tendsto_dyTime_dyBelow t)).limUnder_eq
  · rw [ite_eq_right ht, ite_eq_right ht]

end Extend

/-! ### Gluing a consistent sequence of skeletons -/

section Glue

variable {E : Type*} [Zero E]

/-- Glue a sequence of skeletons: at each dyadic time the limit of the values, and the diagonal of
the times. On a consistent sequence it projects back to each term (`skelProj_glue`). -/
def glue [TopologicalSpace E] (y : ℕ → SkelObs E) : SkelObs E :=
  (fun p => limUnder atTop (fun n => (y n).1 p), fun k => (y k).2 k)

variable {y : ℕ → SkelObs E} (hC : ∀ n, skelProj n (y (n + 1)) = y n)
  (hP1 : ∀ n, Monotone (y n).2)
include hC

theorem snd_succ_eq (m k : ℕ) : (y m).2 k = min ((y (m + 1)).2 k) ((y (m + 1)).2 m) := by
  conv_lhs => rw [← hC m]
  rfl

theorem fst_succ_eq (m : ℕ) (p : ℕ × ℕ) :
    (y m).1 p = skelKill ((y (m + 1)).2 m) (y (m + 1)).1 p := by
  conv_lhs => rw [← hC m]
  rfl

theorem snd_succ_self (m : ℕ) : (y (m + 1)).2 m = (y m).2 m := by
  rw [snd_succ_eq hC m m, min_self]

include hP1

theorem snd_add_eq (k i : ℕ) : (y (k + i)).2 k = (y k).2 k := by
  induction i with
  | zero => rfl
  | succ i ih =>
    show (y (k + i + 1)).2 k = (y k).2 k
    rw [← ih, snd_succ_eq hC (k + i) k,
      min_eq_left (hP1 (k + i + 1) (Nat.le_add_right k i))]

theorem diag_monotone : Monotone fun k => (y k).2 k :=
  monotone_nat_of_le_succ fun k => by
    rw [← snd_succ_self hC k]
    exact hP1 (k + 1) (Nat.le_succ k)

theorem fst_eq_of_lt {n : ℕ} {p : ℕ × ℕ} (hp : (dyTime p : ℝ≥0∞) < (y n).2 n) (i : ℕ) :
    (y (n + i)).1 p = (y n).1 p := by
  induction i with
  | zero => rfl
  | succ i ih =>
    rw [← ih, fst_succ_eq hC (n + i) p, skelKill, snd_succ_self hC]
    rw [ite_eq_left (lt_of_lt_of_le hp (diag_monotone hC hP1 (Nat.le_add_right n i)))]
    rfl

/-- On a consistent sequence of skeletons (each killed at its horizon, with nondecreasing times
that are constant after the horizon), the glued skeleton projects back to every term. -/
theorem skelProj_glue [TopologicalSpace E] [T2Space E] (hP2 : ∀ n k, n ≤ k → (y n).2 k = (y n).2 n)
    (hP3 : ∀ n p, (y n).2 n ≤ dyTime p → (y n).1 p = 0) (n : ℕ) :
    skelProj n (glue y) = y n := by
  refine Prod.ext ?_ ?_
  · funext p
    simp only [skelProj, glue, skelKill]
    by_cases hp : (dyTime p : ℝ≥0∞) < (y n).2 n
    · rw [ite_eq_left hp]
      refine Tendsto.limUnder_eq (tendsto_atTop_of_eventually_const (i₀ := n) fun m hm => ?_)
      obtain ⟨i, rfl⟩ := Nat.exists_eq_add_of_le hm
      exact fst_eq_of_lt hC hP1 hp i
    · rw [ite_eq_right hp, hP3 n p (not_lt.1 hp)]
  · funext k
    simp only [skelProj, glue]
    rcases le_total k n with hkn | hnk
    · obtain ⟨i, rfl⟩ := Nat.exists_eq_add_of_le hkn
      have h1 := snd_add_eq hC hP1 k i
      rw [h1, min_eq_left (h1 ▸ hP1 (k + i) (Nat.le_add_right k i))]
    · rw [hP2 n k hnk, min_eq_right (diag_monotone hC hP1 hnk)]

theorem monotone_glue [TopologicalSpace E] : Monotone (glue y).2 := diag_monotone (y := y) hC hP1

end Glue

/-! ### Measurability -/

section Measurability

variable {E : Type*} [Zero E] [MeasurableSpace E]

theorem measurable_limUnder_atTop [TopologicalSpace E] [PolishSpace E] [BorelSpace E]
    {α : Type*} [MeasurableSpace α] {f : ℕ → α → E}
    (hf : ∀ n, Measurable (f n)) : Measurable fun x => limUnder atTop (fun n => f n x) := by
  have : Nonempty E := ⟨0⟩
  exact (StronglyMeasurable.limUnder fun n => (hf n).stronglyMeasurable).measurable

theorem measurable_observe {Ω : Type*} {mΩ : MeasurableSpace Ω} {X : ℝ≥0 → Ω → E}
    {τ : ℕ → Ω → ℝ≥0∞} (hX : ∀ t, Measurable (X t)) (hτ : ∀ n, Measurable (τ n)) (n : ℕ) :
    Measurable (observe X τ n) := by
  refine Measurable.prodMk (measurable_pi_iff.2 fun t => ?_) (measurable_pi_iff.2 fun k => ?_)
  · exact Measurable.ite (measurableSet_lt measurable_const (hτ n)) (hX t) measurable_const
  · exact (hτ k).min (hτ n)

omit [Zero E] in
theorem measurable_skel : Measurable (skel (E := E)) :=
  Measurable.prodMk (measurable_pi_iff.2 fun _ => (measurable_pi_apply _).comp measurable_fst)
    measurable_snd

theorem measurable_skelProj (n : ℕ) : Measurable (skelProj (E := E) n) := by
  have hT : Measurable fun z : SkelObs E => z.2 n := (measurable_pi_apply n).comp measurable_snd
  refine Measurable.prodMk (measurable_pi_iff.2 fun p => ?_) (measurable_pi_iff.2 fun k => ?_)
  · exact Measurable.ite (measurableSet_lt measurable_const hT)
      ((measurable_pi_apply p).comp measurable_fst) measurable_const
  · exact ((measurable_pi_apply k).comp measurable_snd).min hT

omit [Zero E] in
theorem measurable_life : Measurable fun z : SkelObs E => life z.2 :=
  Measurable.iSup fun k => (measurable_pi_apply k).comp measurable_snd

theorem measurable_extend [TopologicalSpace E] [PolishSpace E] [BorelSpace E] : Measurable (extend (E := E)) := by
  refine Measurable.prodMk (measurable_pi_iff.2 fun t => ?_) measurable_snd
  exact Measurable.ite (measurableSet_lt measurable_const measurable_life)
    (measurable_limUnder_atTop fun j => (measurable_pi_apply _).comp measurable_fst)
    measurable_const

theorem measurable_glue [TopologicalSpace E] [PolishSpace E] [BorelSpace E] : Measurable (glue (E := E)) := by
  refine Measurable.prodMk (measurable_pi_iff.2 fun p => ?_) (measurable_pi_iff.2 fun k => ?_)
  · exact measurable_limUnder_atTop fun n =>
      (measurable_pi_apply p).comp (measurable_fst.comp (measurable_pi_apply n))
  · exact (measurable_pi_apply k).comp (measurable_snd.comp (measurable_pi_apply k))

end Measurability

/-! ### Regular skeletons and continuity of the extension -/

section Regular

variable {E : Type*} [Zero E] [MetricSpace E]

/-- A skeleton is *regular below `L`*: for every dyadic time `r < L` it is uniformly continuous on
the dyadic times in `[0, r]` (countable form, so that it is a measurable property). -/
def RegBelow (L : ℝ≥0∞) (y : ℕ × ℕ → E) : Prop :=
  ∀ r : ℕ × ℕ, (dyTime r : ℝ≥0∞) < L → ∀ k : ℕ, ∃ m : ℕ, ∀ p q : ℕ × ℕ,
    dyTime p ≤ dyTime r → dyTime q ≤ dyTime r →
      dist (dyTime p) (dyTime q) < 1 / ((m : ℝ) + 1) → dist (y p) (y q) ≤ 1 / ((k : ℝ) + 1)

/-- The skeleton of an observation whose path is continuous before the horizon is regular below
the horizon. -/
theorem regBelow_skel_observe {Ω : Type*} (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) (ω : Ω)
    (hc : ContinuousOn (fun t => X t ω) {t | (t : ℝ≥0∞) < τ n ω}) :
    RegBelow (τ n ω) (skel (observe X τ n ω)).1 := by
  intro r hr k
  have hsub : Icc 0 (dyTime r) ⊆ {t : ℝ≥0 | (t : ℝ≥0∞) < τ n ω} := fun t ht =>
    lt_of_le_of_lt (by exact_mod_cast ht.2) hr
  have hu := IsCompact.uniformContinuousOn_of_continuous (isCompact_Icc (a := (0 : ℝ≥0))
    (b := dyTime r)) (hc.mono hsub)
  rw [Metric.uniformContinuousOn_iff_le] at hu
  obtain ⟨δ, hδ, hδu⟩ := hu (1 / ((k : ℝ) + 1)) (by positivity)
  obtain ⟨m, hm⟩ := exists_nat_one_div_lt hδ
  refine ⟨m, fun p q hp hq hpq => ?_⟩
  have hp0 : dyTime p ∈ Icc 0 (dyTime r) := ⟨zero_le, hp⟩
  have hq0 : dyTime q ∈ Icc 0 (dyTime r) := ⟨zero_le, hq⟩
  have hp' : (dyTime p : ℝ≥0∞) < τ n ω := hsub hp0
  have hq' : (dyTime q : ℝ≥0∞) < τ n ω := hsub hq0
  simp only [skel, observe, killAt, ite_eq_left hp', ite_eq_left hq']
  exact hδu _ hp0 _ hq0 (hpq.trans hm).le

variable [CompleteSpace E]

/-- The extension of a skeleton regular below its life time is continuous before its life time. -/
theorem continuousOn_extend_of_regBelow {z : SkelObs E} (hz : RegBelow (life z.2) z.1) :
    ContinuousOn (fun t => (extend z).1 t) {t | (t : ℝ≥0∞) < life z.2} := by
  intro t₀ ht₀
  obtain ⟨r, htr, hrL⟩ := exists_dyTime_btwn ht₀
  set R := dyTime r with hR
  set ℓ : ℝ≥0 → E := fun t => limUnder atTop (fun j => z.1 (dyBelow j t)) with hℓ
  have hle : ∀ t j, t ≤ R → dyTime (dyBelow j t) ≤ R := fun t j ht =>
    (dyTime_dyBelow_le j t).trans ht
  -- the dyadic approximations converge
  have hconv : ∀ t, t ≤ R → Tendsto (fun j => z.1 (dyBelow j t)) atTop (𝓝 (ℓ t)) := by
    intro t ht
    refine tendsto_nhds_limUnder (cauchySeq_tendsto_of_complete ?_)
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt hε
    obtain ⟨m, hm⟩ := hz r hrL k
    have hcs := Metric.cauchySeq_iff.1 (tendsto_dyTime_dyBelow t).cauchySeq (1 / ((m : ℝ) + 1))
      (by positivity)
    obtain ⟨N, hN⟩ := hcs
    exact ⟨N, fun i hi j hj => lt_of_le_of_lt
      (hm _ _ (hle t i ht) (hle t j ht) (hN i hi j hj)) hk⟩
  -- uniform estimate for the limits
  have hunif : ∀ k : ℕ, ∃ m : ℕ, ∀ s t, s ≤ R → t ≤ R →
      dist s t < 1 / ((m : ℝ) + 1) → dist (ℓ s) (ℓ t) ≤ 1 / ((k : ℝ) + 1) := by
    intro k
    obtain ⟨m, hm⟩ := hz r hrL k
    refine ⟨m, fun s t hs ht hst => ?_⟩
    have hd : Tendsto (fun j => dist (dyTime (dyBelow j s)) (dyTime (dyBelow j t))) atTop
        (𝓝 (dist s t)) := (tendsto_dyTime_dyBelow s).dist (tendsto_dyTime_dyBelow t)
    have hev : ∀ᶠ j in atTop, dist (z.1 (dyBelow j s)) (z.1 (dyBelow j t)) ≤ 1 / ((k : ℝ) + 1) :=
      (hd.eventually (gt_mem_nhds hst)).mono fun j hj =>
        hm _ _ (hle s j hs) (hle t j ht) hj
    exact le_of_tendsto ((hconv s hs).dist (hconv t ht)) hev
  -- continuity at `t₀`
  have heq : ∀ t, t < R → (extend z).1 t = ℓ t := fun t ht => by
    have htL : (t : ℝ≥0∞) < life z.2 := lt_trans (by exact_mod_cast ht) hrL
    simp only [extend, ite_eq_left htL, hℓ]
  refine ContinuousAt.continuousWithinAt ?_
  rw [Metric.continuousAt_iff]
  intro ε hε
  obtain ⟨k, hk⟩ := exists_nat_one_div_lt hε
  obtain ⟨m, hm⟩ := hunif k
  have hgap : (0 : ℝ) < (R : ℝ) - t₀ := sub_pos.2 (by exact_mod_cast htr)
  refine ⟨min (1 / ((m : ℝ) + 1)) ((R : ℝ) - t₀), lt_min (by positivity) hgap, fun {t} ht => ?_⟩
  have ht1 : dist t t₀ < 1 / ((m : ℝ) + 1) := lt_of_lt_of_le ht (min_le_left _ _)
  have ht2 : dist t t₀ < (R : ℝ) - t₀ := lt_of_lt_of_le ht (min_le_right _ _)
  have htR : t < R := by
    rw [NNReal.dist_eq] at ht2
    have := (abs_lt.1 ht2).2
    exact_mod_cast (show (t : ℝ) < R by linarith)
  rw [heq t htR, heq t₀ htr]
  exact lt_of_le_of_lt (hm t t₀ htR.le htr.le ht1) hk

end Regular

/-! ### The patching theorem -/

section Patch

variable {E : Type*} [Zero E] [MetricSpace E] [CompleteSpace E] [SecondCountableTopology E]
  [MeasurableSpace E] [BorelSpace E]

omit [Zero E] [CompleteSpace E] in
theorem measurable_regBelow {α : Type*} [MeasurableSpace α] {L : α → ℝ≥0∞} {y : α → ℕ × ℕ → E}
    (hL : Measurable L) (hy : ∀ p, Measurable fun a => y a p) :
    Measurable fun a => RegBelow (L a) (y a) := by
  refine Measurable.forall fun r => Measurable.imp
    (measurableSet_setOfPred.1 (measurableSet_lt measurable_const hL)) ?_
  refine Measurable.forall fun k => Measurable.exists fun m => Measurable.forall fun p =>
    Measurable.forall fun q => Measurable.imp measurable_const <| Measurable.imp measurable_const <|
      Measurable.imp measurable_const ?_
  exact measurableSet_setOfPred.1 (measurableSet_le ((hy p).dist (hy q)) measurable_const)

theorem measurable_canonX (t : ℝ≥0) : Measurable (canonX (E := E) t) :=
  (measurable_pi_apply t).comp (measurable_fst.comp measurable_extend)

omit [Zero E] [MetricSpace E] [CompleteSpace E] [SecondCountableTopology E] [BorelSpace E] in
theorem measurable_canonT (n : ℕ) : Measurable (canonT (E := E) n) :=
  (measurable_pi_apply n).comp measurable_snd

omit [CompleteSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E] in
/-- A glued consistent sequence of regular skeletons is regular below its life time. -/
theorem regBelow_glue {y : ℕ → SkelObs E} (hG : ∀ n, skelProj n (glue y) = y n)
    (hreg : ∀ n, RegBelow ((y n).2 n) (y n).1) : RegBelow (life (glue y).2) (glue y).1 := by
  intro r hr k
  obtain ⟨n, hn⟩ := lt_iSup_iff.1 hr
  have hn' : (dyTime r : ℝ≥0∞) < (y n).2 n := hn
  have heq : ∀ p, dyTime p ≤ dyTime r → (glue y).1 p = (y n).1 p := fun p hp => by
    have h := congrArg (fun w : SkelObs E => w.1 p) (hG n)
    have hp' : (dyTime p : ℝ≥0∞) < (glue y).2 n := lt_of_le_of_lt (by exact_mod_cast hp) hn'
    simpa only [skelProj, skelKill, ite_eq_left hp'] using h
  obtain ⟨m, hm⟩ := hreg n r hn' k
  exact ⟨m, fun p q hp hq hpq => by rw [heq p hp, heq q hq]; exact hm p q hp hq hpq⟩

/-- **Patching consistent stopped path laws.** Let `Q n` be probability measures on `Ω`, `X` a
measurable process with values in a complete separable metric space `E` and `τ n` measurable
times, nondecreasing in `n`, with the path of `X` continuous on `[0, τ n)` `Q n`-a.s. If `Q (n + 1)`
and `Q n` give the observation at horizon `n` the same law, there is a probability measure `μ` on
the skeleton space under which the canonical process `canonX` with the canonical times `canonT` has
the same observation law at every horizon `n` as `X, τ` under `Q n`; moreover `μ`-a.s. the canonical
times are nondecreasing and the canonical path is continuous on `[0, ⨆ n, canonT n)` (it is `0`
afterwards, `canonX_of_life_le`). -/
theorem exists_patched_law {Ω : Type*} {mΩ : MeasurableSpace Ω} (Q : ℕ → Measure Ω)
    [∀ n, IsProbabilityMeasure (Q n)] (X : ℝ≥0 → Ω → E) (hX : ∀ t, Measurable (X t))
    (τ : ℕ → Ω → ℝ≥0∞) (hτ : ∀ n, Measurable (τ n)) (hmono : ∀ ω, Monotone fun n => τ n ω)
    (hcont : ∀ n, ∀ᵐ ω ∂(Q n), ContinuousOn (fun t => X t ω) {t | (t : ℝ≥0∞) < τ n ω})
    (hcons : ∀ n, (Q (n + 1)).map (observe X τ n) = (Q n).map (observe X τ n)) :
    ∃ μ : Measure (SkelObs E), IsProbabilityMeasure μ ∧
      (∀ n, μ.map (observe canonX canonT n) = (Q n).map (observe X τ n)) ∧
      ∀ᵐ z ∂μ, Monotone z.2 ∧
        ContinuousOn (fun t => canonX t z) {t | (t : ℝ≥0∞) < life z.2} := by
  set O : ∀ n, Ω → SkelObs E := fun n => skel ∘ observe X τ n with hOdef
  have hO : ∀ n, Measurable (O n) := fun n => measurable_skel.comp (measurable_observe hX hτ n)
  have hnest : ∀ n ω, skelProj n (O (n + 1) ω) = O n ω := by
    intro n ω
    have h1 : τ n ω ≤ τ (n + 1) ω := hmono ω n.le_succ
    refine Prod.ext ?_ ?_
    · funext p
      simp only [hOdef, Function.comp, skelProj, skel, observe, skelKill, killAt, min_eq_left h1]
      by_cases hp : (dyTime p : ℝ≥0∞) < τ n ω
      · rw [ite_eq_left hp, ite_eq_left (lt_of_lt_of_le hp h1), ite_eq_left hp]
      · rw [ite_eq_right hp, ite_eq_right hp]
    · funext k
      simp only [hOdef, Function.comp, skelProj, skel, observe, min_eq_left h1]
      rw [min_assoc, min_eq_right h1]
  have hcons' : ∀ n, (Q (n + 1)).map (O n) = (Q n).map (O n) := by
    intro n
    rw [hOdef, ← Measure.map_map measurable_skel (measurable_observe hX hτ n), hcons n,
      Measure.map_map measurable_skel (measurable_observe hX hτ n)]
  obtain ⟨ν, hν, hmarg, hchain⟩ := Kolmogorov.exists_map_eval_eq_of_lawConsistent Q O hO
    (fun n => skelProj n) measurable_skelProj (fun n => ae_of_all _ (hnest n)) hcons'
  -- properties of the coordinates transfer from the observations
  have htrans : ∀ n (S : Set (SkelObs E)), MeasurableSet S → (∀ᵐ ω ∂(Q n), O n ω ∈ S) →
      ∀ᵐ y ∂ν, y n ∈ S := by
    intro n S hS h
    have h1 : ∀ᵐ z ∂((Q n).map (O n)), z ∈ S := (ae_map_iff (hO n).aemeasurable hS).2 h
    rw [← hmarg n] at h1
    exact ae_of_ae_map (measurable_pi_apply n).aemeasurable h1
  have hT : ∀ k, Measurable fun z : SkelObs E => z.2 k := fun k =>
    (measurable_pi_apply k).comp measurable_snd
  have hP1 : ∀ᵐ y ∂ν, ∀ n, Monotone (y n).2 := by
    rw [ae_all_iff]
    intro n
    have hS : MeasurableSet {z : SkelObs E | ∀ k, z.2 k ≤ z.2 (k + 1)} :=
      measurableSet_setOfPred.2 (Measurable.forall fun k =>
        measurableSet_setOfPred.1 (measurableSet_le (hT k) (hT (k + 1))))
    filter_upwards [htrans n _ hS (ae_of_all _ fun ω k =>
      min_le_min_right _ (hmono ω k.le_succ))] with y hy
    exact monotone_nat_of_le_succ hy
  have hP2 : ∀ᵐ y ∂ν, ∀ n k, n ≤ k → (y n).2 k = (y n).2 n := by
    rw [ae_all_iff]
    intro n
    have hS : MeasurableSet {z : SkelObs E | ∀ k, n ≤ k → z.2 k = z.2 n} :=
      measurableSet_setOfPred.2 (Measurable.forall fun k => Measurable.imp measurable_const
        (measurableSet_setOfPred.1 (measurableSet_eq_fun (hT k) (hT n))))
    refine htrans n _ hS (ae_of_all _ fun ω k hk => ?_)
    simp only [hOdef, Function.comp, skel, observe, min_self]
    exact min_eq_right (hmono ω hk)
  have hP3 : ∀ᵐ y ∂ν, ∀ n p, (y n).2 n ≤ (dyTime p : ℝ≥0∞) → (y n).1 p = 0 := by
    rw [ae_all_iff]
    intro n
    have hS : MeasurableSet {z : SkelObs E | ∀ p, z.2 n ≤ (dyTime p : ℝ≥0∞) → z.1 p = 0} :=
      measurableSet_setOfPred.2 (Measurable.forall fun p => Measurable.imp
        (measurableSet_setOfPred.1 (measurableSet_le (hT n) measurable_const))
        (measurableSet_setOfPred.1
          (measurableSet_eq_fun ((measurable_pi_apply p).comp measurable_fst) measurable_const)))
    refine htrans n _ hS (ae_of_all _ fun ω p hp => ?_)
    simp only [hOdef, Function.comp, skel, observe, min_self] at hp ⊢
    simp only [killAt, ite_eq_right (not_lt.2 hp)]
  have hP4 : ∀ᵐ y ∂ν, ∀ n, RegBelow ((y n).2 n) (y n).1 := by
    rw [ae_all_iff]
    intro n
    have hS : MeasurableSet {z : SkelObs E | RegBelow (z.2 n) z.1} :=
      measurableSet_setOfPred.2 (measurable_regBelow (hT n) fun p =>
        (measurable_pi_apply p).comp measurable_fst)
    refine htrans n _ hS ((hcont n).mono fun ω hω => ?_)
    have h := regBelow_skel_observe X τ n ω hω
    simpa only [Set.mem_ofPred_eq, hOdef, Function.comp, skel, observe, min_self] using h
  have hG : ∀ᵐ y ∂ν, ∀ n, skelProj n (glue y) = y n := by
    filter_upwards [hchain, hP1, hP2, hP3] with y h0 h1 h2 h3
    exact skelProj_glue h0 h1 h2 h3
  have hcX : ∀ t, Measurable (canonX (E := E) t) := measurable_canonX
  refine ⟨ν.map glue, inferInstance, fun n => ?_, ?_⟩
  · rw [Measure.map_map (measurable_observe hcX measurable_canonT n) measurable_glue]
    have hae : (observe canonX canonT n ∘ glue) =ᵐ[ν] (extend ∘ fun y => y n) := by
      filter_upwards [hG] with y hy
      simp only [Function.comp, observe_canon, hy n]
    rw [Measure.map_congr hae, ← Measure.map_map measurable_extend (measurable_pi_apply n),
      hmarg n, Measure.map_map measurable_extend (hO n)]
    refine Measure.map_congr ((hcont n).mono fun ω hω => ?_)
    exact extend_skel_observe X τ n ω hω
  · have hS : MeasurableSet {z : SkelObs E | Monotone z.2 ∧ RegBelow (life z.2) z.1} := by
      have hmon : MeasurableSet {z : SkelObs E | Monotone z.2} := by
        have : {z : SkelObs E | Monotone z.2} = {z | ∀ k, z.2 k ≤ z.2 (k + 1)} := by
          ext z
          exact ⟨fun h k => h k.le_succ, fun h => monotone_nat_of_le_succ h⟩
        rw [this]
        exact measurableSet_setOfPred.2 (Measurable.forall fun k =>
          measurableSet_setOfPred.1 (measurableSet_le (hT k) (hT (k + 1))))
      exact hmon.inter (measurableSet_setOfPred.2 (measurable_regBelow measurable_life fun p =>
        (measurable_pi_apply p).comp measurable_fst))
    have hR : ∀ᵐ z ∂(ν.map glue), Monotone z.2 ∧ RegBelow (life z.2) z.1 := by
      rw [ae_map_iff measurable_glue.aemeasurable hS]
      filter_upwards [hchain, hP1, hG, hP4] with y h0 h1 hg h4
      exact ⟨monotone_glue h0 h1, regBelow_glue hg h4⟩
    filter_upwards [hR] with z hz
    exact ⟨hz.1, continuousOn_extend_of_regBelow hz.2⟩

end Patch

/-! ### Observation laws are determined by killed cylinder events -/

section Cylinder

variable {E : Type*} [MeasurableSpace E] {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- The killed cylinder event at horizon `n`: `t < τ n` and `X t ∈ A t` for the times `t ∈ F`, and
`d k < min (τ k) (τ n)` for `k ∈ K`. For an adapted `X` and stopping times `τ` it lies in `𝓕_D`
and inside `{D < τ n}`, `D` the largest of the times `t ∈ F` and `d k`, `k ∈ K`. -/
def cylEvent (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) (F : Finset ℝ≥0)
    (A : ℝ≥0 → Set E) (K : Finset ℕ) (d : ℕ → ℝ≥0) : Set Ω :=
  (⋂ t ∈ F, {ω | (t : ℝ≥0∞) < τ n ω} ∩ X t ⁻¹' A t) ∩
    ⋂ k ∈ K, {ω | (d k : ℝ≥0∞) < min (τ k ω) (τ n ω)}

/-- The family of killed cylinder events at horizon `n` (Borel sets `A t`). -/
def cylEvents (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) : Set (Set Ω) :=
  {S | ∃ (F : Finset ℝ≥0) (A : ℝ≥0 → Set E) (K : Finset ℕ) (d : ℕ → ℝ≥0),
    (∀ t, MeasurableSet (A t)) ∧ S = cylEvent X τ n F A K d}

theorem isPiSystem_cylEvents (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞) (n : ℕ) :
    IsPiSystem (cylEvents X τ n) := by
  classical
  rintro _ ⟨F₁, A₁, K₁, d₁, hA₁, rfl⟩ _ ⟨F₂, A₂, K₂, d₂, hA₂, rfl⟩ -
  refine ⟨F₁ ∪ F₂, fun t => (if t ∈ F₁ then A₁ t else univ) ∩ (if t ∈ F₂ then A₂ t else univ),
    K₁ ∪ K₂, fun k => max (if k ∈ K₁ then d₁ k else 0) (if k ∈ K₂ then d₂ k else 0),
    fun t => ?_, ?_⟩
  · show MeasurableSet ((if t ∈ F₁ then A₁ t else univ) ∩ (if t ∈ F₂ then A₂ t else univ))
    split_ifs
    exacts [(hA₁ t).inter (hA₂ t), (hA₁ t).inter MeasurableSet.univ,
      MeasurableSet.univ.inter (hA₂ t), MeasurableSet.univ.inter MeasurableSet.univ]
  · ext ω
    simp only [cylEvent, mem_inter_iff, mem_iInter, mem_ofPred_eq, mem_preimage, Finset.mem_union]
    constructor
    · rintro ⟨⟨h1F, h1K⟩, h2F, h2K⟩
      refine ⟨fun t ht => ?_, fun k hk => ?_⟩
      · rcases ht with ht | ht
        · refine ⟨(h1F t ht).1, ?_, ?_⟩
          · simpa only [ite_eq_left ht] using (h1F t ht).2
          · by_cases ht2 : t ∈ F₂
            · simpa only [ite_eq_left ht2] using (h2F t ht2).2
            · simp only [ite_eq_right ht2, mem_univ]
        · refine ⟨(h2F t ht).1, ?_, ?_⟩
          · by_cases ht1 : t ∈ F₁
            · simpa only [ite_eq_left ht1] using (h1F t ht1).2
            · simp only [ite_eq_right ht1, mem_univ]
          · simpa only [ite_eq_left ht] using (h2F t ht).2
      · have hpos : ∀ k', k' ∈ K₁ ∨ k' ∈ K₂ → ((0 : ℝ≥0) : ℝ≥0∞) < min (τ k' ω) (τ n ω) := by
          rintro k' (hk' | hk')
          · exact lt_of_le_of_lt (by simp) (h1K k' hk')
          · exact lt_of_le_of_lt (by simp) (h2K k' hk')
        rw [ENNReal.coe_max, max_lt_iff]
        constructor
        · by_cases hk1 : k ∈ K₁
          · simpa only [ite_eq_left hk1] using h1K k hk1
          · simpa only [ite_eq_right hk1] using hpos k hk
        · by_cases hk2 : k ∈ K₂
          · simpa only [ite_eq_left hk2] using h2K k hk2
          · simpa only [ite_eq_right hk2] using hpos k hk
    · rintro ⟨hF, hK⟩
      refine ⟨⟨fun t ht => ?_, fun k hk => ?_⟩, fun t ht => ?_, fun k hk => ?_⟩
      · obtain ⟨h1, h2, -⟩ := hF t (Or.inl ht)
        exact ⟨h1, by simpa only [ite_eq_left ht] using h2⟩
      · have h := hK k (Or.inl hk)
        rw [ENNReal.coe_max, max_lt_iff] at h
        simpa only [ite_eq_left hk] using h.1
      · obtain ⟨h1, -, h2⟩ := hF t (Or.inr ht)
        exact ⟨h1, by simpa only [ite_eq_left ht] using h2⟩
      · have h := hK k (Or.inr hk)
        rw [ENNReal.coe_max, max_lt_iff] at h
        simpa only [ite_eq_left hk] using h.2

theorem measurableSet_cylEvent {X : ℝ≥0 → Ω → E} {τ : ℕ → Ω → ℝ≥0∞} (hX : ∀ t, Measurable (X t))
    (hτ : ∀ n, Measurable (τ n)) (n : ℕ) (F : Finset ℝ≥0) {A : ℝ≥0 → Set E}
    (hA : ∀ t, MeasurableSet (A t)) (K : Finset ℕ) (d : ℕ → ℝ≥0) :
    MeasurableSet (cylEvent X τ n F A K d) :=
  (Finset.measurableSet_biInter F fun t _ =>
    (measurableSet_lt measurable_const (hτ n)).inter (hX t (hA t))).inter
    (Finset.measurableSet_biInter K fun k _ =>
      measurableSet_lt measurable_const ((hτ k).min (hτ n)))

/-- **The killed cylinder events determine the observation law.** If two probability measures agree
on every killed cylinder event at horizon `n`, they give the observation at horizon `n` the same
law. -/
theorem map_observe_eq_of_cylEvent [Zero E] {X : ℝ≥0 → Ω → E} {τ : ℕ → Ω → ℝ≥0∞}
    (hX : ∀ t, Measurable (X t)) (hτ : ∀ n, Measurable (τ n)) (n : ℕ) {Q₁ Q₂ : Measure Ω}
    [IsProbabilityMeasure Q₁] [IsProbabilityMeasure Q₂]
    (h : ∀ F A K d, (∀ t, MeasurableSet (A t)) →
      Q₁ (cylEvent X τ n F A K d) = Q₂ (cylEvent X τ n F A K d)) :
    Q₁.map (observe X τ n) = Q₂.map (observe X τ n) := by
  set m : MeasurableSpace Ω := MeasurableSpace.generateFrom (cylEvents X τ n) with hm
  have hmle : m ≤ mΩ := MeasurableSpace.generateFrom_le fun S ⟨F, A, K, d, hA, hS⟩ =>
    hS ▸ measurableSet_cylEvent hX hτ n F hA K d
  have hgen : ∀ {S}, S ∈ cylEvents X τ n → MeasurableSet[m] S := fun hS =>
    MeasurableSpace.measurableSet_generateFrom hS
  -- the two measures agree on `m`
  have : IsFiniteMeasure (Q₁.trim hmle) := isFiniteMeasure_trim hmle
  have htrim : Q₁.trim hmle = Q₂.trim hmle := by
    refine @ext_of_generate_finite Ω m _ _ (cylEvents X τ n) rfl (isPiSystem_cylEvents X τ n) _
      (fun S hS => ?_) ?_
    · rw [trim_measurableSet_eq hmle (hgen hS), trim_measurableSet_eq hmle (hgen hS)]
      obtain ⟨F, A, K, d, hA, rfl⟩ := hS
      exact h F A K d hA
    · rw [trim_measurableSet_eq hmle MeasurableSet.univ, trim_measurableSet_eq hmle MeasurableSet.univ,
        measure_univ, measure_univ]
  -- the observation is `m`-measurable
  have hobs : Measurable[m] (observe X τ n) := by
    refine Measurable.prodMk (measurable_pi_iff.2 fun t => ?_) (measurable_pi_iff.2 fun k => ?_)
    · intro B hB
      have hD : MeasurableSet[m] {ω | (t : ℝ≥0∞) < τ n ω} := by
        refine hgen ⟨{t}, fun _ => univ, ∅, fun _ => 0, fun _ => MeasurableSet.univ, ?_⟩
        ext ω
        simp [cylEvent]
      have hDB : MeasurableSet[m] ({ω | (t : ℝ≥0∞) < τ n ω} ∩ X t ⁻¹' B) := by
        refine hgen ⟨{t}, fun _ => B, ∅, fun _ => 0, fun _ => hB, ?_⟩
        ext ω
        simp [cylEvent]
      have heq : (fun ω => killAt (τ n ω) (fun t => X t ω) t) ⁻¹' B =
          ({ω | (t : ℝ≥0∞) < τ n ω} ∩ X t ⁻¹' B) ∪
            ({ω | (t : ℝ≥0∞) < τ n ω}ᶜ ∩ {_ω | (0 : E) ∈ B}) := by
        ext ω
        by_cases ht : (t : ℝ≥0∞) < τ n ω <;> simp [killAt, ht]
      have hconst : MeasurableSet[m] {_ω : Ω | (0 : E) ∈ B} := by
        by_cases h0 : (0 : E) ∈ B
        · simp only [h0, ofPred_true]; exact MeasurableSet.univ
        · simp only [h0, ofPred_false]; exact MeasurableSet.empty
      show MeasurableSet[m] ((fun ω => killAt (τ n ω) (fun t => X t ω) t) ⁻¹' B)
      rw [heq]
      exact hDB.union (hD.compl.inter hconst)
    · refine measurable_of_Ioi fun x => ?_
      induction x using ENNReal.recTopCoe with
      | top => simp
      | coe d =>
        refine hgen ⟨∅, fun _ => univ, {k}, fun _ => d, fun _ => MeasurableSet.univ, ?_⟩
        ext ω
        simp [cylEvent]
  ext B hB
  have hBm : MeasurableSet[m] (observe X τ n ⁻¹' B) := hobs hB
  rw [Measure.map_apply (measurable_observe hX hτ n) hB,
    Measure.map_apply (measurable_observe hX hτ n) hB, ← trim_measurableSet_eq hmle hBm, htrim,
    trim_measurableSet_eq hmle hBm]

end Cylinder

/-! ### Uniqueness on all horizons -/

section Unique

variable {E : Type*} [Zero E] [MeasurableSpace E] {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- Projection of an observation to horizon `n`. -/
def pathProj (n : ℕ) (z : PathObs E) : PathObs E :=
  (killAt (z.2 n) z.1, fun k => min (z.2 k) (z.2 n))

theorem measurable_pathProj (n : ℕ) : Measurable (pathProj (E := E) n) := by
  have hT : Measurable fun z : PathObs E => z.2 n := (measurable_pi_apply n).comp measurable_snd
  refine Measurable.prodMk (measurable_pi_iff.2 fun t => ?_) (measurable_pi_iff.2 fun k => ?_)
  · exact Measurable.ite (measurableSet_lt measurable_const hT)
      ((measurable_pi_apply t).comp measurable_fst) measurable_const
  · exact ((measurable_pi_apply k).comp measurable_snd).min hT

omit [MeasurableSpace E] in
/-- With nondecreasing times, the observation at horizon `n + 1` projects to the one at `n`. -/
theorem pathProj_observe_succ (X : ℝ≥0 → Ω → E) (τ : ℕ → Ω → ℝ≥0∞)
    (hmono : ∀ ω, Monotone fun n => τ n ω) (n : ℕ) :
    pathProj n ∘ observe X τ (n + 1) = observe X τ n := by
  funext ω
  have h1 : τ n ω ≤ τ (n + 1) ω := hmono ω n.le_succ
  refine Prod.ext ?_ ?_
  · funext t
    simp only [Function.comp, pathProj, observe, killAt, min_eq_left h1]
    by_cases ht : (t : ℝ≥0∞) < τ n ω
    · rw [ite_eq_left ht, ite_eq_left (lt_of_lt_of_le ht h1), ite_eq_left ht]
    · rw [ite_eq_right ht, ite_eq_right ht]
  · funext k
    simp only [Function.comp, pathProj, observe, min_eq_left h1]
    rw [min_assoc, min_eq_right h1]

/-- **Uniqueness on all horizons.** Two finite measures giving the observation at every horizon the
same law agree on the σ-algebra generated by all the observations. -/
theorem eq_of_map_observe_eq {X : ℝ≥0 → Ω → E} {τ : ℕ → Ω → ℝ≥0∞}
    (hX : ∀ t, Measurable (X t)) (hτ : ∀ n, Measurable (τ n))
    (hmono : ∀ ω, Monotone fun n => τ n ω) {P₁ P₂ : Measure Ω} [IsFiniteMeasure P₁]
    (hlaw : ∀ n, P₁.map (observe X τ n) = P₂.map (observe X τ n)) {s : Set Ω}
    (hs : MeasurableSet[⨆ n, MeasurableSpace.comap (observe X τ n) inferInstance] s) :
    P₁ s = P₂ s :=
  Kolmogorov.eq_of_map_eq_of_nested (fun n => observe X τ n) (measurable_observe hX hτ)
    (fun n => pathProj n) measurable_pathProj (pathProj_observe_succ X τ hmono) hlaw hs

end Unique

end InteractingSLE.StoppedPath
