import InteractingSLE.WangWu.Prop420ThreeSpace
import InteractingSLE.Spec.Sec7.Lemma71MData

/-!
# The chamber chart and the mapped middle segment on every three-line space (`κ = 4`, (J3)–(J4))

Packet PROVE-WW-B22. Wang–Wu (`source/external/WW17LP/wang_wu_lean_preprocessed.pdf`, ruling R31), Proposition 4.24
(text dump L1816–1867): "Choose a chamber `C` between the outer two lines by the first rational point in a fixed
enumeration lying in such a chamber. The choice depends only on the two walls, not on the middle curve or the
unexplored field. […] Fix a wall-measurable Riemann map `ψ : C → ℍ` by its opening and closing endpoints and one
further positive scale normalization", and Lemma 4.22 (the middle line traverses `C`; its image has a continuous
driving function).

The specification's Lemma 7.1 builds exactly this object for its three flow lines (PROVE-LEMMA71K/L:
`Sec7.Lemma71K.IsPocketConstruction`, the capacity data `Sec7.Lemma71L.exists_capData`, the prefix filtration of the
mapped segment inside the labelled histories `Sec7.Lemma71L.prefixFiltrationOf_le_aeSigma`). Those proofs use the
three-curve space only through Lemma 6.2's hypotheses on the three curves and its almost sure geometric clause (order,
simplicity, avoidance of `ℝ ∖ {0}`, no common arc), which is the content of `SeedThree.IsThreeLineSpace`. This file
restates them on every three-line space, with the same proofs (each declaration notes its source):

* `pocketChart_of_isThreeLineSpace`, **`isPocketConstruction_of_wallPairChart_three`**,
  **`exists_isPocketConstruction_three`**: the chamber `C` (the pocket through the first rational between point), its
  chart `c` (conformal onto `ℍ`, a function of the two walls), and the mapped middle segment `γ'`;
* `ae_pocketGood_three`, **`exists_capData_three`**: the pathwise good event and the chart, its domain and the closing
  point as measurable functions of the wall histories;
* **`prefixFiltrationOf_le_aeSigma_three`**: the filtration generated by the walls and the mapped middle prefix up to
  capacity `t` lies, up to null sets, in the labelled histories of the walls and the middle line stopped at the
  corresponding time (the filtration of Proposition 4.20's "middle line stopped in the filtration enlarged by the
  walls").
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology Metric Complex Bornology
open SupercriticalConformalCovariance (IsConformalBijection)
open scoped NNReal ENNReal Real

namespace InteractingSLE.WangWu.SeedThree

open QuantumZipper (H Hbar)
open QuantumZipper.CA (cayley cayleyInv)
open Sec7 Sec7.Lemma71I Sec7.Lemma71C Sec7.Lemma71K Sec7.Lemma71L Sec6 LocalSets

section Space

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens} {u₀ : ℂ → ℝ} {β α γ : Ω → ℝ≥0 → ℂ}
  {C : Ω → Set ℂ} {c : Ω → Chart} {γ' : Ω → ℝ → ℂ}
  {G : (Hist × Hist) × ℂ → ℂ} {M : Set ((Hist × Hist) × ℂ)} {Y : Hist × Hist → ℂ}

-- mirrored from `Sec7.Lemma71KChart.pocketChart_of_isThreeCurveSpace`
/-- **The pocket chart of Lemma 7.1 on a given three-curve space, read off the outer curves.** For a canonical pocket
chart on wall pairs (`IsWallPairChart`), the pocket `C ω = Cw (β ω, α ω)` and the chart `c ω = cw (β ω, α ω)` satisfy,
on every three-line space: `σ(β, α)`-measurable closed-ball events, forward map and lift
(`IsPocketChartData`'s clause (S1)); almost surely `C ω` is a component between the outer curves with
`∂C ∩ ℍ ⊆ β ∪ α` (S2), it is a marked pocket `[a', b']` of the right wall `α`, and the chart is `Ψ ∘ cayley` for a
boundary map `Ψ` continuous and injective on `closure (cayley '' C) ∖ {α̃ b'}` with values in `ℍ̄`, `Ψ = 0` at the
opening point `α̃ a'` and `|Ψ| → ∞` at the closing point `α̃ b'`. (The lift is the canonical one of
`Lemma71E.exists_measurable_twoPointChart`; the inherited branch is a shift by `2πn`, see the handoff.) -/
theorem pocketChart_of_isThreeLineSpace {e : ℕ → ℂ} {Cw : WallPair → Set ℂ} {Np : WallPair → ℕ}
    {Nx Ny : ℕ → WallPair → ℕ} {cw : WallPair → Chart} (hW : IsWallPairChart e Cw Np Nx Ny cw)
    (hS : IsThreeLineSpace P h u₀ β α γ) :
    Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance] (fun ω => toWallPair (β ω) (α ω)) ∧
      (∀ (z : ℂ) (r : ℝ), MeasurableSet[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
        {ω | closedBall z r ⊆ Cw (toWallPair (β ω) (α ω))}) ∧
      (∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
        ({ω | z ∈ (cw (toWallPair (β ω) (α ω))).dom}.indicator fun ω => (cw (toWallPair (β ω) (α ω))).1 z)) ∧
      (∀ z, Measurable[MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance]
        ({ω | z ∈ (cw (toWallPair (β ω) (α ω))).dom}.indicator fun ω => (cw (toWallPair (β ω) (α ω))).2.2 z)) ∧
      (∀ᵐ ω ∂P, Cw (toWallPair (β ω) (α ω)) ∈ betweenComponents (range (α ω)) (range (β ω))) ∧
      (∀ᵐ ω ∂P, frontier (Cw (toWallPair (β ω) (α ω))) ∩ H ⊆ range (β ω) ∪ range (α ω)) ∧
      ∀ᵐ ω ∂P, ∃ a' b', IsMarkedPocket (α ω) (Cw (toWallPair (β ω) (α ω))) a' b' ∧
        ∃ Ψ : ℂ → ℂ, ContinuousOn Ψ (closure (cayley '' Cw (toWallPair (β ω) (α ω))) \ {wallPt (α ω) b'}) ∧
          InjOn Ψ (closure (cayley '' Cw (toWallPair (β ω) (α ω))) \ {wallPt (α ω) b'}) ∧
          MapsTo Ψ (closure (cayley '' Cw (toWallPair (β ω) (α ω))) \ {wallPt (α ω) b'}) Hbar ∧
          Ψ (wallPt (α ω) a') = 0 ∧
          Tendsto (fun x => ‖Ψ x‖)
            (𝓝[closure (cayley '' Cw (toWallPair (β ω) (α ω))) \ {wallPt (α ω) b'}] (wallPt (α ω) b')) atTop ∧
          ∀ x ∈ Cw (toWallPair (β ω) (α ω)), (cw (toWallPair (β ω) (α ω))).1 x = Ψ (cayley x) := by
  obtain ⟨he, -, -, -, hC, hCm, hNpC, -, -, hbet, -, -, -, hfm, hlm, -, -, -, huniq, hmark⟩ := hW
  obtain ⟨-, -, -, hβ62, hα62, -, hae⟩ := hS
  have hπ : ∀ ω, Continuous (β ω) ∧ Continuous (α ω) ∧ β ω 0 = 0 ∧ α ω 0 = 0 := fun ω =>
    ⟨hβ62.1 ω, hα62.1 ω, hβ62.2.1 ω, hα62.2.1 ω⟩
  have hπm := measurable_toWallPair hπ
  have hπe : ∀ ω, (toWallPair (β ω) (α ω)).1 = (β ω, α ω) := fun ω => by rw [toWallPair_eq (hπ ω)]
  refine ⟨hπm, fun z r => hπm (hCm z r), fun z => (hfm z).comp hπm, fun z => (hlm z).comp hπm, ?_⟩
  -- almost surely the selected domain is the pocket through a between point
  have hgood : ∀ᵐ ω ∂P, IsSimpleProper (α ω) ∧ IsSimpleProper (β ω) ∧
      WangWu.IsOrderedArcs (realPath (α ω)) (realPath (γ ω)) (realPath (β ω)) ∧
      Cw (toWallPair (β ω) (α ω)) =
        connectedComponentIn (H \ (range (α ω) ∪ range (β ω))) (e (Np (toWallPair (β ω) (α ω)))) ∧
      Lemma71Pin.IsBetweenPt (range (α ω)) (range (β ω)) (e (Np (toWallPair (β ω) (α ω)))) := by
    filter_upwards [hae] with ω hω
    obtain ⟨-, hβs, hαs, hγs, hord, hγα, hγβ⟩ := hω
    obtain ⟨t, -, htB⟩ := Lemma71Pin.exists_isBetweenPt_middle hβs hαs hγs hord hγα hγβ
    have hC₀ : connectedComponentIn (H \ (range (α ω) ∪ range (β ω))) (γ ω t) ∈
        betweenComponents (range (α ω)) (range (β ω)) := by
      obtain ⟨hz, hzR, hzL⟩ := (Lemma71Pin.isBetweenPt_iff hαs hβs).1 htB
      exact ⟨γ ω t, hz, hzR, hzL, rfl⟩
    have hC₀o : IsOpen (connectedComponentIn (H \ (range (α ω) ∪ range (β ω))) (γ ω t)) :=
      (QuantumZipper.isOpen_H.sdiff ((Lemma71Pin.IsSimpleProper.isClosed_range hαs).union
        (Lemma71Pin.IsSimpleProper.isClosed_range hβs))).connectedComponentIn
    obtain ⟨k, hk⟩ := he.exists_mem_open hC₀o
      ⟨γ ω t, mem_connectedComponentIn ((Lemma71Pin.isBetweenPt_iff hαs hβs).1 htB).1⟩
    have hbetω := hbet (toWallPair (β ω) (α ω))
    rw [hπe ω] at hbetω
    obtain ⟨hB, hCω⟩ := hbetω ⟨k, Lemma71Pin.isBetweenPt_of_mem hαs hβs hC₀ hk⟩
    have hcl : closure (range (α ω) ∪ range (β ω)) = range (α ω) ∪ range (β ω) :=
      ((Lemma71Pin.IsSimpleProper.isClosed_range hαs).union (Lemma71Pin.IsSimpleProper.isClosed_range hβs)).closure_eq
    rw [hcl] at hCω
    exact ⟨hαs, hβs, hord, hCω, hB⟩
  have hbetw : ∀ᵐ ω ∂P, Cw (toWallPair (β ω) (α ω)) ∈ betweenComponents (range (α ω)) (range (β ω)) := by
    filter_upwards [hgood] with ω hω
    obtain ⟨hαs, hβs, -, hCω, hB⟩ := hω
    obtain ⟨hz, hzR, hzL⟩ := (Lemma71Pin.isBetweenPt_iff hαs hβs).1 hB
    rw [hCω]
    exact ⟨_, hz, hzR, hzL, rfl⟩
  refine ⟨hbetw, ?_, ?_⟩
  · filter_upwards [hgood] with ω hω
    obtain ⟨hαs, hβs, -, hCω, -⟩ := hω
    rw [hCω, union_comm (range (β ω))]
    exact Lemma71Pin.frontier_connectedComponentIn_inter_H_subset
      ((Lemma71Pin.IsSimpleProper.isClosed_range hαs).union (Lemma71Pin.IsSimpleProper.isClosed_range hβs)) _
  · filter_upwards [hgood, hbetw] with ω hω hCω
    obtain ⟨hαs, hβs, hord, -, -⟩ := hω
    have hord' : Disjoint (range (β ω)) (rightSideOf (range (α ω))) := by
      have := hord.right_left
      rwa [arcRange_realPath, arcRange_realPath] at this
    obtain ⟨a', b', hM⟩ := isMarkedPocket_of_mem_betweenComponents hαs hβs hord' hCω
    have hM' : IsMarkedPocket (toWallPair (β ω) (α ω)).1.2 (Cw (toWallPair (β ω) (α ω))) a' b' := by
      rw [hπe ω]; exact hM
    obtain ⟨hx, hy⟩ := hmark _ a' b' hM'
    rw [hπe ω] at hx hy
    have hCx := hC (toWallPair (β ω) (α ω))
    exact ⟨a', b', hM, exists_ext_of_isMarkedPocket hCx.1 hCx.2.1 hCx.2.2.2 hM hx hy (huniq _)⟩

-- mirrored from `Sec7.Lemma71KSpace.isPocketConstruction_of_wallPairChart`
/-- **The pocket construction of Lemma 7.1 on every three-curve space, with the pocket and the chart read off the
outer curves** through a canonical pocket chart on wall pairs (`IsWallPairChart`): `C ω = Cw (β ω, α ω)`,
`c ω = cw (β ω, α ω)`. Applied to two middle curves between the same outer curves it gives the same pocket and chart.
No named input. -/
theorem isPocketConstruction_of_wallPairChart_three {e : ℕ → ℂ} {Cw : WallPair → Set ℂ} {Np : WallPair → ℕ}
    {Nx Ny : ℕ → WallPair → ℕ} {cw : WallPair → Chart} (hW : IsWallPairChart e Cw Np Nx Ny cw)
    (hS : IsThreeLineSpace P h u₀ β α γ) :
    ∃ γ' : Ω → ℝ → ℂ, IsPocketConstruction P β α γ (fun ω => Cw (toWallPair (β ω) (α ω)))
      (fun ω => cw (toWallPair (β ω) (α ω))) γ' := by
  classical
  have hS' := hS
  obtain ⟨-, -, -, -, -, hγ62, hae⟩ := hS'
  obtain ⟨hπm, hCm, hfm, hlm, hbetw, hfr, hmark⟩ := pocketChart_of_isThreeLineSpace hW hS
  obtain ⟨he, hNpw, -, -, hCw, -, hNpC, -, -, -, hconf, hdom, hbij, -, -, hlc, hL, -, -, -⟩ := hW
  set C : Ω → Set ℂ := fun ω => Cw (toWallPair (β ω) (α ω)) with hCdef
  set c : Ω → Chart := fun ω => cw (toWallPair (β ω) (α ω)) with hcdef
  have hC : ∀ ω, IsOpen (C ω) ∧ IsConnected (C ω) ∧ IsSimplyConnected (C ω) ∧ C ω ⊆ H := fun ω => hCw _
  have hCo : ∀ ω, IsOpen (C ω) := fun ω => (hC ω).1
  have hCH : ∀ ω, C ω ⊆ H := fun ω => (hC ω).2.2.2
  have hle := comap_pair_le β α γ
  have hmem : ∀ z, MeasurableSet[MeasurableSpace.comap β MeasurableSpace.pi ⊔
      MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi] {ω | z ∈ C ω} :=
    fun z => hle _ (@Lemma71E.measurableSet_mem_of_closedBall Ω
      (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance) C hCo hCm z)
  have hγm : ∀ t, Measurable[MeasurableSpace.comap β MeasurableSpace.pi ⊔
      MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi] fun ω => γ ω t :=
    fun t => ((measurable_pi_apply t).comp (comap_measurable γ)).mono le_sup_right le_rfl
  have hset : ∀ z, {ω | z ∈ (c ω).dom} = {ω | z ∈ C ω} := fun z => by
    ext ω
    show z ∈ ((c ω).dom : Set ℂ) ↔ z ∈ C ω
    rw [hdom]
  have hf : ∀ z, Measurable[MeasurableSpace.comap β MeasurableSpace.pi ⊔
      MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi]
      ({ω | z ∈ C ω}.indicator fun ω => (c ω).1 z) := fun z => by
    rw [← hset z]
    exact (hfm z).mono hle le_rfl
  have hw := fun u => @measurable_segPt Ω (MeasurableSpace.comap β MeasurableSpace.pi ⊔
      MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi) C hCo hCH hmem e he
    γ hγ62.1 hγm u
  obtain ⟨g, hgm, hg⟩ := @exists_measurable_boundaryValues Ω (MeasurableSpace.comap β MeasurableSpace.pi ⊔
      MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi) C hCo hCH hmem e he
    (fun ω => Np (toWallPair (β ω) (α ω))) ((hNpw.comp hπm).mono hle le_rfl) (fun ω => hNpC _)
    (fun ω => (c ω).1) hf (fun u ω => segPt (γ ω) (closure (cayley '' C ω)) u) hw
  -- the pathwise good event
  set Good : Ω → Prop := fun ω => Lemma71C.IsSegCurve (g ω) ∧ ∃ (a' b' : ℝ) (Ψ : ℂ → ℂ),
      IsMarkedPocket (α ω) (C ω) a' b' ∧
      ContinuousOn Ψ (closure (cayley '' C ω) \ {wallPt (α ω) b'}) ∧
      InjOn Ψ (closure (cayley '' C ω) \ {wallPt (α ω) b'}) ∧
      MapsTo Ψ (closure (cayley '' C ω) \ {wallPt (α ω) b'}) Hbar ∧ Ψ (wallPt (α ω) a') = 0 ∧
      Tendsto (fun x => ‖Ψ x‖) (𝓝[closure (cayley '' C ω) \ {wallPt (α ω) b'}] (wallPt (α ω) b')) atTop ∧
      (∀ x ∈ C ω, (c ω).1 x = Ψ (cayley x)) ∧
      (∀ u, 0 ≤ u → segPt (γ ω) (closure (cayley '' C ω)) u ∈ closure (cayley '' C ω) \ {wallPt (α ω) b'} ∧
        g ω u = Ψ (segPt (γ ω) (closure (cayley '' C ω)) u)) ∧
      g ω '' Ici 0 = Ψ '' (cayley '' range (γ ω) ∩ (closure (cayley '' C ω) \ {wallPt (α ω) b'})) with hGooddef
  have hgood : ∀ᵐ ω ∂P, Good ω := by
    filter_upwards [hae, hbetw, hmark] with ω hω hCω hmω
    obtain ⟨-, -, -, -, hord, hγα, hγβ⟩ := hω
    obtain ⟨a', b', hM, Ψ, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq⟩ := hmω
    have hΨC : ∀ z ∈ C ω, Ψ (cayley z) ∈ H := fun z hz => by
      rw [← hΨeq z hz]
      exact (hbij _).2.mapsTo hz
    obtain ⟨-, -, -, hseg, hsc, hrange⟩ := isSegCurve_of_isMarkedPocket hord
      (Lemma71I.interior_contact_eq_empty hγα) (Lemma71I.interior_contact_eq_empty hγβ) hCω hM hΨc hΨi hΨH hΨ0
      hΨinf hΨC
    have hpb : wallPt (α ω) b' ∈ frontier (cayley '' C ω) := hM.2.2.2.2.2.2.1
    have hDo : IsOpen (cayley '' C ω) := Lemma71F.isOpen_cayley_image (hCo ω) (hCH ω)
    have hDsub : cayley '' C ω ⊆ closure (cayley '' C ω) \ {wallPt (α ω) b'} := fun x hx =>
      ⟨subset_closure hx, fun hxq => by
        have hxb : x = wallPt (α ω) b' := mem_singleton_iff.1 hxq
        have hpb' := hpb
        rw [hDo.frontier_eq] at hpb'
        exact hpb'.2 (hxb ▸ hx)⟩
    have hgeq : ∀ u, 0 ≤ u → g ω u = Ψ (segPt (γ ω) (closure (cayley '' C ω)) u) := fun u hu =>
      hg ω u Ψ _ hDsub (hseg u hu).1 (hΨc _ (hseg u hu)) hΨeq
    refine ⟨isSegCurve_congr hsc fun u hu => (hgeq u hu).symm, a', b', Ψ, hM, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq,
      fun u hu => ⟨hseg u hu, hgeq u hu⟩, ?_⟩
    rw [← hrange]
    exact Set.image_congr fun u hu => hgeq u hu
  -- the null set off which the construction is the pathwise one
  set N₀ := toMeasurable P {ω | ¬ Good ω} with hN₀def
  have hN₀m : MeasurableSet N₀ := measurableSet_toMeasurable P _
  have hN₀P : P N₀ = 0 := by
    rw [hN₀def, measure_toMeasurable]
    exact ae_iff.1 hgood
  have hgoodN : ∀ ω, ω ∉ N₀ → Good ω := fun ω hω => by
    by_contra hng
    exact hω (subset_toMeasurable P _ hng)
  have hnotN : ∀ᵐ ω ∂P, ω ∉ N₀ := measure_eq_zero_iff_ae_notMem.1 hN₀P
  set γ' : Ω → ℝ → ℂ := fun ω => if ω ∈ N₀ then fun u : ℝ => (u : ℂ) * I else g ω with hγ'def
  have hγ'g : ∀ ω, ω ∉ N₀ → γ' ω = g ω := fun ω hω => by simp only [hγ'def, hω, ↓reduceIte]
  refine ⟨γ', hC, hCm, fun ω => hconf _, fun ω => hdom _, hfm, hlm, fun ω => hlc _, fun ω => hL _, hbetw, hfr,
    fun ω => ?_, fun u => ?_, ?_⟩
  · by_cases hω : ω ∈ N₀
    · simp only [hγ'def, hω, ↓reduceIte]
      exact isSegCurve_ofReal_mul_I
    · rw [hγ'g ω hω]
      exact (hgoodN ω hω).1
  · have hN₀n : MeasurableSet[MeasurableSpace.comap β MeasurableSpace.pi ⊔
        MeasurableSpace.comap α MeasurableSpace.pi ⊔ MeasurableSpace.comap γ MeasurableSpace.pi ⊔
        Ito.nullSets P] N₀ :=
      (le_sup_right : Ito.nullSets P ≤ _) _ (MeasurableSpace.measurableSet_generateFrom ⟨hN₀m, hN₀P⟩)
    have he' : (fun ω => γ' ω u) = N₀.piecewise (fun _ => (u : ℂ) * I) fun ω => g ω u := by
      funext ω
      by_cases hω : ω ∈ N₀
      · simp only [hγ'def, hω, ↓reduceIte, Set.piecewise_eq_of_mem]
      · simp only [hγ'def, hω, ↓reduceIte, Set.piecewise_eq_of_notMem, not_false_eq_true]
    rw [he']
    exact Measurable.piecewise hN₀n measurable_const ((hgm u).mono le_sup_left le_rfl)
  · filter_upwards [hnotN] with ω hω
    obtain ⟨-, a', b', Ψ, hM, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq, hseg, hrange⟩ := hgoodN ω hω
    refine ⟨a', b', Ψ, hM, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq, fun u hu => ⟨(hseg u hu).1, ?_⟩, ?_⟩
    · rw [hγ'g ω hω]
      exact (hseg u hu).2
    · rw [hγ'g ω hω]
      exact hrange

-- mirrored from `Sec7.Lemma71KSpace.exists_isPocketConstruction`
/-- **The pocket construction of Lemma 7.1 exists on every three-curve space** (chart and mapped segment; no named
input). -/
theorem exists_isPocketConstruction_three (hS : IsThreeLineSpace P h u₀ β α γ) :
    ∃ (C : Ω → Set ℂ) (c : Ω → Chart) (γ' : Ω → ℝ → ℂ), IsPocketConstruction P β α γ C c γ' := by
  obtain ⟨e, Cw, Np, Nx, Ny, cw, hW⟩ := exists_isWallPairChart
  obtain ⟨γ', hγ'⟩ := isPocketConstruction_of_wallPairChart_three hW hS
  exact ⟨_, _, γ', hγ'⟩

-- mirrored from `Sec7.Lemma71LStop.ae_pocketGood`
/-- The good event is almost sure. -/
theorem ae_pocketGood_three (hS : IsThreeLineSpace P h u₀ β α γ)
    (hpc : IsPocketConstruction P β α γ C c γ') : ∀ᵐ ω ∂P, PocketGood β α γ C c γ' ω := by
  obtain ⟨-, -, -, -, -, -, hae⟩ := hS
  obtain ⟨-, -, -, -, -, -, -, -, hbetw, hfr, -, -, hmark⟩ := hpc
  filter_upwards [hae, hbetw, hfr, hmark] with ω hω hb hf hm
  obtain ⟨-, -, -, -, hord, hγα, hγβ⟩ := hω
  obtain ⟨a', b', Ψ, hM, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq, hseg, -⟩ := hm
  exact ⟨hord, hγα, hγβ, hb, hf, a', b', Ψ, hM, hΨc, hΨi, hΨH, hΨ0, hΨinf, hΨeq, hseg⟩

-- mirrored from `Sec7.Lemma71LStop.exists_capData`
/-- **The pocket chart, its domain and the closing point as measurable functions of the outer histories**
(PROVE-LEMMA71I's `exists_capacityRule` for the chart of the pocket construction; Doob–Dynkin for the closing point). -/
theorem exists_capData_three (hS : IsThreeLineSpace P h u₀ β α γ)
    (hpc : IsPocketConstruction P β α γ C c γ') :
    ∃ (G : (Hist × Hist) × ℂ → ℂ) (M : Set ((Hist × Hist) × ℂ)) (Y : Hist × Hist → ℂ),
      Measurable G ∧ MeasurableSet M ∧ Measurable Y ∧ (∀ ω z, (outerHist β α ω, z) ∈ M ↔ z ∈ C ω) ∧
      (∀ ω z, z ∈ C ω → G (outerHist β α ω, z) = (c ω).1 z) ∧ (∀ ω, Y (outerHist β α ω) = closePt α C ω) := by
  obtain ⟨-, -, -, hβ62, hα62, -, -⟩ := hS
  obtain ⟨hC, hCm, hconf, hdom, hfm, -, -, -, -, -, -, -, -⟩ := hpc
  have hle := comap_pair_le_comap_outerHist hβ62.1 hα62.1
  set m : MeasurableSpace Ω := MeasurableSpace.comap (outerHist β α) inferInstance with hm
  have hCm' : ∀ (z : ℂ) (r : ℝ), MeasurableSet[m] {ω | closedBall z r ⊆ C ω} := fun z r => hle _ (hCm z r)
  have hFc : ∀ ω, ContinuousOn (c ω).1 (C ω) := fun ω => by
    rw [← hdom ω]
    exact (hconf ω).differentiableOn_fwd.continuousOn
  have hset : ∀ z, {ω | z ∈ (c ω).dom} = {ω | z ∈ C ω} := fun z => by
    ext ω
    show z ∈ ((c ω).dom : Set ℂ) ↔ z ∈ C ω
    rw [hdom]
  have hFm : ∀ z, Measurable[m] ({ω | z ∈ C ω}.indicator fun ω => (c ω).1 z) := fun z => by
    rw [← hset z]
    exact (hfm z).mono hle le_rfl
  obtain ⟨G, M, hG, hM, hMiff, hGeq, -⟩ :=
    Lemma71I.exists_capacityRule (A := outerHist β α) (fun ω => (hC ω).1) hCm' hFc hFm
  -- the closing point is `σ(outer histories)`-measurable
  have hCo : ∀ ω, IsOpen (C ω) := fun ω => (hC ω).1
  have hCH : ∀ ω, C ω ⊆ H := fun ω => (hC ω).2.2.2
  have hmem : ∀ z, MeasurableSet[m] {ω | z ∈ C ω} := fun z =>
    @Lemma71E.measurableSet_mem_of_closedBall Ω m C hCo hCm' z
  obtain ⟨e, he⟩ := TopologicalSpace.exists_dense_seq ℂ
  have hαm : ∀ t, Measurable[m] fun ω => α ω t := fun t =>
    (((measurable_pi_apply t).comp measurable_snd).comp (comap_measurable _)).mono hle le_rfl
  have hY : Measurable[m] (closePt α C) := by
    have hU : ∀ q : ℚ, MeasurableSet[m] {ω | wallPt (α ω) q ∈ closure (cayley '' C ω)} := fun q =>
      @measurableSet_mem_closure_cayley_image Ω m C hCo hCH hmem e he _
        (@measurable_wallPt_const Ω m α hαm q)
    have hct := @measurable_closeTime Ω m α (fun ω => closure (cayley '' C ω)) hU
    exact @measurable_wallPt Ω m α hα62.1 hαm _ hct
  obtain ⟨Y, hYm, hYeq⟩ := hY.exists_eq_measurable_comp
  exact ⟨G, M, Y, hG, hM, hYm, hMiff, hGeq, fun ω => (congrFun hYeq ω).symm⟩

-- mirrored from `Sec7.Lemma71LFilt.prefixFiltrationOf_le_aeSigma`
/-- **R3/G7: the prefix filtration of the mapped segment at capacity time `t` is contained, up to null sets, in the
σ-algebra of the labelled histories `(β, α, γ|[0, τ_t])`**, `τ_t = capTime G M Y β α γ t` (`G`, `M`, `Y` from
`exists_capData`). -/
theorem prefixFiltrationOf_le_aeSigma_three
    (hS : IsThreeLineSpace P h u₀ β α γ)
    (hpc : IsPocketConstruction P β α γ C c γ') (hG : Measurable G) (hM : MeasurableSet M) (hY : Measurable Y)
    (hMiff : ∀ ω z, (outerHist β α ω, z) ∈ M ↔ z ∈ C ω)
    (hGeq : ∀ ω z, z ∈ C ω → G (outerHist β α ω, z) = (c ω).1 z)
    (hYeq : ∀ ω, Y (outerHist β α ω) = closePt α C ω) (t : ℝ≥0) :
    Lemma71E.prefixFiltrationOf (mΩ := mΩ) (MeasurableSpace.comap (fun ω => (β ω, α ω)) inferInstance) γ' t ≤
      aeSigma (stoppedHistSigma (Three.threeCurves β α γ) (Three.threeStops (capTime G M Y β α γ t))) P := by
  have hS' := hS
  obtain ⟨-, -, -, hβ62, hα62, hγ62, -⟩ := hS'
  have hpc' := hpc
  obtain ⟨hC, -, hconf, hdom, -, -, -, -, -, -, hseg, -, -⟩ := hpc'
  refine inf_le_left.trans (sup_le ?_ (MeasurableSpace.generateFrom_le ?_))
  · -- the outer curves are measurable for the labelled histories
    refine le_trans ?_ (le_aeSigma _ P)
    have hβm : ∀ s, Measurable[stoppedHistSigma (Three.threeCurves β α γ)
        (Three.threeStops (capTime G M Y β α γ t))] fun ω => β ω s := fun s =>
      Lemma71G.measurable_outer_stoppedHistSigma (i := 0) (by decide) hβ62.1 s
    have hαm : ∀ s, Measurable[stoppedHistSigma (Three.threeCurves β α γ)
        (Three.threeStops (capTime G M Y β α γ t))] fun ω => α ω s := fun s =>
      Lemma71G.measurable_outer_stoppedHistSigma (i := 1) (by decide) hα62.1 s
    let _ : MeasurableSpace Ω := stoppedHistSigma (Three.threeCurves β α γ)
      (Three.threeStops (capTime G M Y β α γ t))
    exact measurable_iff_comap_le.1 ((measurable_pi_iff.2 hβm).prodMk (measurable_pi_iff.2 hαm))
  · rintro s ⟨r, hrt, n, k, rfl⟩
    obtain rfl | hr0 := eq_or_lt_of_le (zero_le (a := r))
    · -- capacity time `0`: a deterministic event
      have he : Lemma71E.prefixEvent γ' 0 n k = {_ω | (0 : ℂ) ∈ Restart.dyadicSquare n k} := by
        ext ω
        have hΓ := hseg ω
        have hpos : ((0 : ℝ≥0) : ℝ≥0∞) < capLife (γ' ω) :=
          lt_of_le_of_lt bot_le (hΓ.ofReal_capClock_lt zero_le_one)
        have hinv : capInv (γ' ω) ((0 : ℝ≥0) : ℝ) = 0 := hΓ.capInv_of_nonpos le_rfl
        show ((0 : ℝ≥0) : ℝ≥0∞) < capLife (γ' ω) ∧
            (Restart.dyadicSquare n k ∩ γ' ω '' Icc 0 (capInv (γ' ω) ((0 : ℝ≥0) : ℝ))).Nonempty ↔
          (0 : ℂ) ∈ Restart.dyadicSquare n k
        rw [hinv, Icc_self, image_singleton, hΓ.2.2.2.1, inter_singleton_nonempty]
        exact ⟨fun h => h.2, fun h => ⟨hpos, h⟩⟩
      rw [he]
      exact ⟨_, MeasurableSet.const _, EventuallyEq.rfl⟩
    · refine ⟨(fun ω => (outerHist β α ω, histOf (pathCoord (γ ω)) (capTime G M Y β α γ t ω))) ⁻¹'
        prefixSet G M Y r (Restart.dyadicSquare n k), ?_, ?_⟩
      · have hY3 := comap_measurable (m := (inferInstance : MeasurableSpace (Fin 3 → Hist)))
          (fun ω i => histOf (pathCoord (Three.threeCurves β α γ i ω))
            (Three.threeStops (capTime G M Y β α γ t) i ω))
        have hrearr : Measurable fun v : Fin 3 → Hist => ((v 0, v 1), v 2) :=
          ((measurable_pi_apply 0).prodMk (measurable_pi_apply 1)).prodMk (measurable_pi_apply 2)
        exact (hrearr.comp hY3) (measurableSet_prefixSet hG hM hY r _)
      · filter_upwards [ae_pocketGood_three hS hpc] with ω hg
        exact propext (mem_prefixEvent_iff hg (hC ω).1 (hC ω).2.2.2 (hconf ω) (hdom ω)
          (fun s => hγ62.2.2.1 ω s) (hγ62.1 ω) (hseg ω) (hMiff ω) (hGeq ω) (hYeq ω) hr0 hrt n k)


end Space

