import InteractingSLE.WangWu.NonBoundaryPartition
import LQGMetric.Prob.CondIndepDetermined

/-!
# Recovering the field off a thin set (Wang–Wu Lemma 4.14; Proposition R1 on `ℍ`)

Source: `source/external/WW17LP/wang_wu_lean_preprocessed.pdf` (ruling R31), §4.4, Lemma 4.14 and its proof
(text dump lines 1399–1440), and Proposition R1 of the specification supplement (`source/spec/p433-480.md#id-R1`,
pp. 448–449; it also proves the specification's Lemma 3.10):

"For every dyadic square `S ⊂ K` of side `δ`, the variance of `δ^{-2}(h, 1_S)` is at most `C_K log(1/δ)`. A
Gaussian tail bound, the `O(δ^{-2})` squares at each scale, and Borel–Cantelli give an almost-sure uniform bound
`C log(1/δ)` for their absolute averages at every dyadic scale. … If `A_δ` is the union of squares meeting `A`,
then `|(h, p_δ 1_{A_δ})| ≤ ‖p‖_∞ C N_δ δ² log(1/δ) → 0`. Thus `(h, p)` is the limit of field integrals over
squares disjoint from `A`, which are determined by the restrictions off `A`."

The square indicators are replaced by the smooth square cut-offs of `NonBoundaryPartition.lean` (the source's
"fixed smooth approximations"), so that `(h, φ) = ∑_k (h, φ ψ_{n,k})` holds exactly and no approximation step
`(h, p_δ) → (h, p)` is needed.

## Setting

`h` is a zero-boundary GFF on `ℍ` and `F = h + m` with `m` bounded on `ℍ` (a bounded deterministic mean, such as
the harmonic extension of piecewise constant boundary data). `A : Ω → Set ℂ` is any random set (no measurability,
no locality: "Locality of `A` is not needed for this conclusion", Proposition R1).

* `offEval A F ψ ω = F ω ψ` if `tsupport ψ` avoids `A ω`, else `0`: the evaluations of the restriction of `F`
  to `ℍ ∖ A`;
* `offSigma A F`: the σ-algebra they generate, `σ(F|_{ℍ ∖ A})`.

## Main results

* `ae_eventually_abs_le_pouTest`: the Gaussian maximum over the pieces at scale `n` is eventually at most
  `L (n + 1) 4^{-n}`, almost surely (Borel–Cantelli over all dyadic scales);
* `exists_measurable_offSigma_ae_eq`: under the covering hypothesis (R1.1), every pairing `F φ` is a.s. equal to
  an `offSigma A F`-measurable function;
* **`aeDeterminedSigma_offSigma`** (Lemma 4.14 / Proposition R1): `σ(F)` is a.s. determined by `σ(F|_{ℍ ∖ A})`.

The covering hypothesis (R1.1) is the one of Proposition R1: for every compact `K ⊆ ℍ` a deterministic sequence
of scales `n_j → ∞` with `N_{n_j}(A ∩ K) (n_j + 1) 4^{-n_j} → 0` almost surely (`N_n` = number of dyadic squares of
side `2^{-n}` meeting the set; `(n + 1)` is comparable to `log(1/δ_n)`).
-/

set_option autoImplicit false

noncomputable section

open Complex Set Metric MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal Real

namespace InteractingSLE.WangWu

/-! ### The restriction record -/

section Record

variable {Ω : Type*}

open Classical in
/-- The evaluation of the restriction `F|_{ℍ ∖ A}` at `ψ`: `F ω ψ` when `tsupport ψ` avoids `A ω`, else `0`. -/
def offEval (A : Ω → Set ℂ) (F : Ω → LQGMetric.DistOn upperHalfPlaneOpens)
    (ψ : LQGMetric.TestOn upperHalfPlaneOpens) (ω : Ω) : ℝ :=
  if Disjoint (tsupport ψ) (A ω) then F ω ψ else 0

set_option warn.classDefReducibility false in
/-- `σ(F|_{ℍ ∖ A})`: the σ-algebra generated by the evaluations of `F` at test functions whose supports avoid
`A`. -/
def offSigma (A : Ω → Set ℂ) (F : Ω → LQGMetric.DistOn upperHalfPlaneOpens) : MeasurableSpace Ω :=
  ⨆ ψ : LQGMetric.TestOn upperHalfPlaneOpens, MeasurableSpace.comap (offEval A F ψ) inferInstance

lemma measurable_offEval (A : Ω → Set ℂ) (F : Ω → LQGMetric.DistOn upperHalfPlaneOpens)
    (ψ : LQGMetric.TestOn upperHalfPlaneOpens) : Measurable[offSigma A F] (offEval A F ψ) :=
  measurable_iff_comap_le.2 (le_iSup (fun ψ => MeasurableSpace.comap (offEval A F ψ) inferInstance) ψ)

lemma offEval_of_disjoint {A : Ω → Set ℂ} {F : Ω → LQGMetric.DistOn upperHalfPlaneOpens}
    {ψ : LQGMetric.TestOn upperHalfPlaneOpens} {ω : Ω} (h : Disjoint (tsupport ψ) (A ω)) :
    offEval A F ψ ω = F ω ψ := by
  simp only [offEval, h, ↓reduceIte]

lemma offEval_of_not_disjoint {A : Ω → Set ℂ} {F : Ω → LQGMetric.DistOn upperHalfPlaneOpens}
    {ψ : LQGMetric.TestOn upperHalfPlaneOpens} {ω : Ω} (h : ¬ Disjoint (tsupport ψ) (A ω)) :
    offEval A F ψ ω = 0 := by
  simp only [offEval, h, ↓reduceIte]

end Record

/-! ### A Chernoff bound for centred Gaussians -/

section Chernoff

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}

/-- **Gaussian tail.** For a centred Gaussian `X`, `λ ≥ 0` and `t`:
`P(t ≤ |X|) ≤ 2 exp(−λ t + λ² Var X / 2)`. -/
lemma measure_le_abs_le_of_hasGaussianLaw [IsProbabilityMeasure P] {X : Ω → ℝ}
    (hX : HasGaussianLaw X P) (h0 : ∫ ω, X ω ∂P = 0) {lam : ℝ} (hl : 0 ≤ lam) (t : ℝ) :
    P {ω | t ≤ |X ω|} ≤
      ENNReal.ofReal (2 * Real.exp (-lam * t + lam ^ 2 * Var[X; P] / 2)) := by
  have hXm : AEMeasurable X P := hX.aemeasurable
  set c := Real.exp (-lam * t + lam ^ 2 * Var[X; P] / 2) with hc
  have hone : ∀ s : ℝ, s = lam ∨ s = -lam → P {ω | lam * t ≤ s * X ω} ≤ ENNReal.ofReal c := by
    intro s hs
    have hsq : s ^ 2 = lam ^ 2 := by rcases hs with rfl | rfl <;> ring
    have hfm : AEMeasurable (fun ω => ENNReal.ofReal (Real.exp (s * X ω))) P :=
      (ENNReal.measurable_ofReal.comp Real.measurable_exp).comp_aemeasurable (hXm.const_mul s)
    have hmk := mul_meas_ge_le_lintegral₀ hfm (ENNReal.ofReal (Real.exp (lam * t)))
    rw [GFF.lintegral_ofReal_exp_of_hasGaussianLaw hX h0 s, hsq] at hmk
    have hsub : {ω | lam * t ≤ s * X ω} ⊆
        {ω | ENNReal.ofReal (Real.exp (lam * t)) ≤ ENNReal.ofReal (Real.exp (s * X ω))} :=
      fun ω hω => ENNReal.ofReal_le_ofReal (Real.exp_le_exp.2 hω)
    have hpos : ENNReal.ofReal (Real.exp (lam * t)) ≠ 0 := by
      rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact Real.exp_pos _
    calc P {ω | lam * t ≤ s * X ω}
        ≤ P {ω | ENNReal.ofReal (Real.exp (lam * t)) ≤ ENNReal.ofReal (Real.exp (s * X ω))} :=
          measure_mono hsub
      _ ≤ ENNReal.ofReal (Real.exp (lam ^ 2 * Var[X; P] / 2)) /
            ENNReal.ofReal (Real.exp (lam * t)) := by
          rw [ENNReal.le_div_iff_mul_le (Or.inl hpos) (Or.inl ENNReal.ofReal_ne_top), mul_comm]
          exact hmk
      _ = ENNReal.ofReal c := by
          rw [← ENNReal.ofReal_div_of_pos (Real.exp_pos _), ← Real.exp_sub, hc]
          congr 2; ring
  rcases hl.eq_or_lt with hl0 | hlpos
  · -- `λ = 0`: the bound is `2 ≥ 1`
    subst hl0
    refine prob_le_one.trans ?_
    rw [hc]; simp
  have hsub : {ω | t ≤ |X ω|} ⊆ {ω | lam * t ≤ lam * X ω} ∪ {ω | lam * t ≤ -lam * X ω} := by
    intro ω hω
    rcases le_abs'.1 (show t ≤ |X ω| from hω) with h | h
    · right; show lam * t ≤ -lam * X ω; nlinarith
    · left; show lam * t ≤ lam * X ω; exact mul_le_mul_of_nonneg_left h hl
  calc P {ω | t ≤ |X ω|} ≤ P ({ω | lam * t ≤ lam * X ω} ∪ {ω | lam * t ≤ -lam * X ω}) :=
        measure_mono hsub
    _ ≤ P {ω | lam * t ≤ lam * X ω} + P {ω | lam * t ≤ -lam * X ω} := measure_union_le _ _
    _ ≤ ENNReal.ofReal c + ENNReal.ofReal c := add_le_add (hone _ (Or.inl rfl)) (hone _ (Or.inr rfl))
    _ = ENNReal.ofReal (2 * c) := by
        rw [← ENNReal.ofReal_add (Real.exp_pos _).le (Real.exp_pos _).le, two_mul]

end Chernoff

/-! ### The Gaussian maximum over the pieces, at every dyadic scale -/

/-- The index bound `M_n = ⌈R 2ⁿ⌉₊` at scale `n` for a test function supported in `B̄(0, R)`. -/
def scaleIdx (R : ℝ) (n : ℕ) : ℕ := ⌈R * 2 ^ n⌉₊

lemma scaleIdx_le {R : ℝ} (hR : 0 ≤ R) (n : ℕ) : (scaleIdx R n : ℝ) ≤ R * 2 ^ n + 1 :=
  (Nat.ceil_lt_add_one (by positivity)).le

lemma le_scaleIdx (R : ℝ) (n : ℕ) : R * 2 ^ n ≤ scaleIdx R n := Nat.le_ceil _

lemma card_pouIdx_scaleIdx_le {R : ℝ} (hR : 0 ≤ R) (n : ℕ) :
    ((pouIdx (scaleIdx R n)).card : ℝ) ≤ (2 * R + 3) ^ 2 * 4 ^ n := by
  have h2 : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  have hM := scaleIdx_le hR n
  rw [card_pouIdx]
  push_cast
  have h4 : (4 : ℝ) ^ n = (2 ^ n) ^ 2 := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
  rw [h4, ← mul_pow]
  have h0 : (0 : ℝ) ≤ 2 * (scaleIdx R n : ℝ) + 1 := by positivity
  refine pow_le_pow_left₀ h0 ?_ 2
  nlinarith

lemma norm_pouCentre_le {R : ℝ} (hR : 0 ≤ R) {n : ℕ} {k : ℤ × ℤ}
    (hk : k ∈ pouIdx (scaleIdx R n)) : ‖pouCentre n k‖ ≤ 2 * R + 2 := by
  have h2 : (0 : ℝ) < 2 ^ n := pow_pos two_pos n
  have h1 : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  have hM := scaleIdx_le hR n
  rw [pouIdx, Finset.mem_product, Finset.mem_Icc, Finset.mem_Icc] at hk
  have hcoord : ∀ j : ℤ, -(scaleIdx R n : ℤ) ≤ j → j ≤ scaleIdx R n → |(j : ℝ) / 2 ^ n| ≤ R + 1 := by
    intro j hj1 hj2
    have hj1' : -(scaleIdx R n : ℝ) ≤ j := by exact_mod_cast hj1
    have hj2' : (j : ℝ) ≤ scaleIdx R n := by exact_mod_cast hj2
    rw [abs_div, abs_of_pos h2, div_le_iff₀ h2, abs_le]
    constructor <;> nlinarith
  calc ‖pouCentre n k‖ ≤ |(pouCentre n k).re| + |(pouCentre n k).im| :=
        Complex.norm_le_abs_re_add_abs_im _
    _ ≤ (R + 1) + (R + 1) := add_le_add (hcoord _ hk.1.1 hk.1.2) (hcoord _ hk.2.1 hk.2.2)
    _ = 2 * R + 2 := by ring

section GaussMax

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → LQGMetric.DistOn upperHalfPlaneOpens}

omit [IsProbabilityMeasure P] in
lemma variance_pairing (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (ψ : LQGMetric.TestOn upperHalfPlaneOpens) :
    Var[fun ω => h ω ψ; P] = QuantumZipper.zeroGFFTestCov upperHalfPlaneOpens ψ ψ := by
  rw [← covariance_self (hh.process.measurable ψ).aemeasurable, hh.process.covariance_eq]

/-- **The Gaussian maximum (Borel–Cantelli over all dyadic scales).** For a test function `φ` with
`|φ| ≤ B`, there is a deterministic `L` such that almost surely, for all large `n`, every piece `φ ψ_{n,k}`
with `k ∈ [−M_n, M_n]²` has `|⟨h, φ ψ_{n,k}⟩| ≤ L (n + 1) 4^{-n}`. -/
theorem ae_eventually_abs_le_pouTest (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (φ : LQGMetric.TestOn upperHalfPlaneOpens) {R B : ℝ} (hR : 0 ≤ R) (hB : ∀ z, |φ z| ≤ B) :
    ∃ L : ℝ, ∀ᵐ ω ∂P, ∀ᶠ n in atTop, ∀ k ∈ pouIdx (scaleIdx R n),
      |h ω (pouTest φ n k)| ≤ L * (n + 1) / 4 ^ n := by
  set C₀ : ℝ := 16 * π ^ 2 * B ^ 2 with hC₀
  set ℓ : ℝ := Real.log (2 * R + 4) with hℓ
  have hC₀0 : 0 ≤ C₀ := by positivity
  have hℓ0 : 0 ≤ ℓ := Real.log_nonneg (by linarith)
  have hl4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  set L : ℝ := Real.log 4 + C₀ / 2 + 1 + C₀ * (ℓ + 8) / 2 with hL
  refine ⟨L, ?_⟩
  set E : ℕ → Set Ω := fun n => ⋃ k ∈ pouIdx (scaleIdx R n),
    {ω | L * (n + 1) / 4 ^ n ≤ |h ω (pouTest φ n k)|} with hE
  -- the probability of each bad event
  have hPE : ∀ n, P (E n) ≤ ENNReal.ofReal (2 * (2 * R + 3) ^ 2 * Real.exp (-1) ^ n) := by
    intro n
    have h4 : (0 : ℝ) < 4 ^ n := by positivity
    have hpiece : ∀ k ∈ pouIdx (scaleIdx R n),
        P {ω | L * (n + 1) / 4 ^ n ≤ |h ω (pouTest φ n k)|} ≤
          ENNReal.ofReal (2 * Real.exp (-(n : ℝ) * (Real.log 4 + 1))) := by
      intro k hk
      have hX := hh.process.gaussian.hasGaussianLaw_eval (pouTest φ n k)
      refine (measure_le_abs_le_of_hasGaussianLaw hX (hh.process.centered _) h4.le _).trans ?_
      refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 ?_) (by norm_num))
      have hv := zeroGFFTestCov_pouTest_le φ hB n k
      have hc := norm_pouCentre_le hR hk
      have hlog : Real.log (‖pouCentre n k‖ + 2) ≤ ℓ :=
        Real.log_le_log (by positivity) (by linarith)
      have hVar : Var[fun ω => h ω (pouTest φ n k); P] ≤ C₀ / 16 ^ n * (ℓ + n + 8) := by
        rw [variance_pairing hh]
        refine hv.trans ?_
        have h16 : (0 : ℝ) < 16 ^ n := by positivity
        rw [hC₀]
        gcongr
      have h16 : ((4 : ℝ) ^ n) ^ 2 = 16 ^ n := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
      have hsq : ((4 : ℝ) ^ n) ^ 2 * Var[fun ω => h ω (pouTest φ n k); P] / 2 ≤ C₀ * (ℓ + n + 8) / 2 := by
        have := mul_le_mul_of_nonneg_left hVar (sq_nonneg ((4 : ℝ) ^ n))
        rw [show ((4 : ℝ) ^ n) ^ 2 * (C₀ / 16 ^ n * (ℓ + n + 8)) = C₀ * (ℓ + n + 8) by
          rw [h16]; field_simp] at this
        linarith
      have hlin : -(4 : ℝ) ^ n * (L * (n + 1) / 4 ^ n) = -(L * (n + 1)) := by field_simp
      rw [hlin]
      have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      have hprod : 0 ≤ (n : ℝ) * (C₀ * (ℓ + 8)) := mul_nonneg hn0 (mul_nonneg hC₀0 (by linarith))
      have hLn : L * (n + 1) = (Real.log 4 + C₀ / 2 + 1) * n + (n : ℝ) * (C₀ * (ℓ + 8)) / 2 + L := by
        rw [hL]; ring
      nlinarith
    calc P (E n) ≤ ∑ k ∈ pouIdx (scaleIdx R n),
          P {ω | L * (n + 1) / 4 ^ n ≤ |h ω (pouTest φ n k)|} := measure_biUnion_finset_le _ _
      _ ≤ ∑ _k ∈ pouIdx (scaleIdx R n), ENNReal.ofReal (2 * Real.exp (-(n : ℝ) * (Real.log 4 + 1))) :=
          Finset.sum_le_sum hpiece
      _ = ENNReal.ofReal ((pouIdx (scaleIdx R n)).card *
            (2 * Real.exp (-(n : ℝ) * (Real.log 4 + 1)))) := by
          rw [Finset.sum_const, nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg _),
            ENNReal.ofReal_natCast]
      _ ≤ ENNReal.ofReal (2 * (2 * R + 3) ^ 2 * Real.exp (-1) ^ n) := by
          refine ENNReal.ofReal_le_ofReal ?_
          have hc := card_pouIdx_scaleIdx_le hR n
          have hexp : Real.exp (-(n : ℝ) * (Real.log 4 + 1)) * 4 ^ n = Real.exp (-1) ^ n := by
            rw [← Real.exp_nat_mul, show (4 : ℝ) ^ n = Real.exp (n * Real.log 4) by
              rw [← Real.log_pow, Real.exp_log (by positivity)], ← Real.exp_add]
            congr 1; ring
          calc ((pouIdx (scaleIdx R n)).card : ℝ) * (2 * Real.exp (-(n : ℝ) * (Real.log 4 + 1)))
              ≤ (2 * R + 3) ^ 2 * 4 ^ n * (2 * Real.exp (-(n : ℝ) * (Real.log 4 + 1))) :=
                mul_le_mul_of_nonneg_right hc (by positivity)
            _ = 2 * (2 * R + 3) ^ 2 * (Real.exp (-(n : ℝ) * (Real.log 4 + 1)) * 4 ^ n) := by ring
            _ = 2 * (2 * R + 3) ^ 2 * Real.exp (-1) ^ n := by rw [hexp]
  have hsum : (∑' n, P (E n)) ≠ ∞ := by
    have hr : Real.exp (-1) < 1 := Real.exp_lt_one_iff.2 (by norm_num)
    have hsr : Summable fun n : ℕ => 2 * (2 * R + 3) ^ 2 * Real.exp (-1) ^ n :=
      (summable_geometric_of_lt_one (Real.exp_pos _).le hr).mul_left _
    refine ne_top_of_le_ne_top ?_ (ENNReal.tsum_le_tsum hPE)
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun n => by positivity) hsr]
    exact ENNReal.ofReal_ne_top
  filter_upwards [ae_eventually_notMem hsum] with ω hω
  filter_upwards [hω] with n hn k hk
  by_contra hlt
  exact hn (mem_biUnion hk (show L * (n + 1) / 4 ^ n ≤ |h ω (pouTest φ n k)| from (not_le.1 hlt).le))

end GaussMax

/-! ### The bounded mean of a piece -/

/-- **The mean part of a piece is small.** If `|m| ≤ M_m` on `ℍ` and `|φ| ≤ B`, then
`|∫ m φ ψ_{n,k}| ≤ 4π |M_m| B 4^{-n}` (the piece lives in a ball of radius `2 · 2^{-n}`). -/
lemma abs_integral_mul_pouTest_le {m : ℂ → ℝ} {Mm : ℝ} (hm : ∀ z ∈ QuantumZipper.H, |m z| ≤ Mm)
    (φ : LQGMetric.TestOn upperHalfPlaneOpens) {B : ℝ} (hB : ∀ z, |φ z| ≤ B) (n : ℕ)
    (k : ℤ × ℤ) : |∫ z, m z * pouTest φ n k z| ≤ 4 * π * |Mm| * B / 4 ^ n := by
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB 0)
  set r : ℝ := 2 / 2 ^ n with hr
  have hr0 : 0 ≤ r := by positivity
  set g : ℂ → ℝ := (ball (pouCentre n k) r).indicator (fun _ => |Mm| * B) with hg
  have hgi : Integrable g volume :=
    (integrableOn_const (s := ball (pouCentre n k) r) (μ := volume) (C := |Mm| * B)
      measure_ball_lt_top.ne).integrable_indicator measurableSet_ball
  have hpt : ∀ z, ‖m z * pouTest φ n k z‖ ≤ g z := by
    intro z
    rw [Real.norm_eq_abs, abs_mul]
    by_cases hz : z ∈ ball (pouCentre n k) r
    · rw [hg, indicator_of_mem hz]
      by_cases hzH : z ∈ QuantumZipper.H
      · refine mul_le_mul ((hm z hzH).trans (le_abs_self Mm)) ?_ (abs_nonneg _) (abs_nonneg _)
        rw [pouTest_apply, abs_mul]
        calc |φ z| * |pouSq n k z| ≤ B * 1 :=
              mul_le_mul (hB z) (abs_pouSq_le_one n k z) (abs_nonneg _) hB0
          _ = B := mul_one B
      · have h0 : pouTest φ n k z = 0 :=
          image_eq_zero_of_notMem_tsupport fun ht => hzH ((pouTest φ n k).tsupport_subset ht)
        rw [h0, abs_zero, mul_zero]
        positivity
    · rw [hg, indicator_of_notMem hz, pouTest_apply, pouSq_eq_zero_of_notMem_ball hz, mul_zero,
        abs_zero, mul_zero]
  have h := norm_integral_le_of_norm_le hgi (Eventually.of_forall hpt)
  rw [Real.norm_eq_abs] at h
  refine h.trans (le_of_eq ?_)
  rw [hg, integral_indicator_const _ measurableSet_ball, smul_eq_mul, measureReal_def,
    Complex.volume_ball, ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.toReal_ofReal hr0,
    ENNReal.coe_toReal, NNReal.coe_real_pi, hr]
  have h4 : (4 : ℝ) ^ n = (2 ^ n) ^ 2 := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
  rw [h4]
  field_simp
  ring

/-! ### Reconstruction -/

/-- A pointwise limit of real functions, chosen by `limUnder`, is measurable for any σ-algebra making the
functions measurable. -/
lemma measurable_limUnder_real {X : Type*} [m : MeasurableSpace X] {f : ℕ → X → ℝ}
    (hf : ∀ i, Measurable (f i)) : Measurable fun x => limUnder atTop (f · x) :=
  (StronglyMeasurable.limUnder fun i => (hf i).stronglyMeasurable).measurable

set_option warn.classDefReducibility false in
/-- The events a.s. equal to an event of `G` form a σ-algebra (as LQGMetric's `GM.aeSigmaOf`, restated here
so as not to import a paper module). -/
def aeSigma {Ω : Type*} {mΩ : MeasurableSpace Ω} (G : MeasurableSpace Ω) (μ : Measure[mΩ] Ω) :
    MeasurableSpace Ω where
  MeasurableSet' s := ∃ t, MeasurableSet[G] t ∧ s =ᵐ[μ] t
  measurableSet_empty := ⟨∅, MeasurableSet.empty, EventuallyEq.rfl⟩
  measurableSet_compl := fun _ ⟨t, ht, hst⟩ => ⟨tᶜ, ht.compl, EventuallyEqSet.compl hst⟩
  measurableSet_iUnion := fun f hf => by
    choose t ht hft using hf
    exact ⟨⋃ i, t i, MeasurableSet.iUnion ht, EventuallyEqSet.countable_iUnion hft⟩

/-- **The covering hypothesis (R1.1)** of Proposition R1: for every compact `K ⊆ ℍ` there is a deterministic
sequence of dyadic scales `n_j → ∞` along which, almost surely, `N_{n_j}(A ∩ K) (n_j + 1) 4^{-n_j} → 0`
(`N_n` = number of closed dyadic squares of side `2^{-n}` meeting the set). -/
def HasThinCovering {Ω : Type*} [MeasurableSpace Ω] (A : Ω → Set ℂ) (P : Measure Ω) : Prop :=
  ∀ K : Set ℂ, IsCompact K → K ⊆ QuantumZipper.H → ∃ ns : ℕ → ℕ, Tendsto ns atTop atTop ∧
    ∀ᵐ ω ∂P, Tendsto (fun j => (Dimension.dyadicCount (ns j) (A ω ∩ K) : ℝ) * (ns j + 1) / 4 ^ ns j)
      atTop (𝓝 0)

section Reconstruct

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h F : Ω → LQGMetric.DistOn upperHalfPlaneOpens} {m : ℂ → ℝ} {Mm : ℝ} {A : Ω → Set ℂ}

/-- **The reconstruction sums** (`Y_n` of (WF12) / Proposition R1): at scale `n`, the sum of the evaluations of
`F|_{ℍ ∖ A}` at the pieces `φ ψ_{n,k}`, `k ∈ [−M_n, M_n]²` (`M_n = ⌈R 2ⁿ⌉₊`); the pieces whose support meets `A`
contribute `0`. -/
def offSum (A : Ω → Set ℂ) (F : Ω → LQGMetric.DistOn upperHalfPlaneOpens)
    (φ : LQGMetric.TestOn upperHalfPlaneOpens) (R : ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∑ k ∈ pouIdx (scaleIdx R n), offEval A F (pouTest φ n k) ω

omit [MeasurableSpace Ω] [IsProbabilityMeasure P] in
lemma measurable_offSum (A : Ω → Set ℂ) (F : Ω → LQGMetric.DistOn upperHalfPlaneOpens)
    (φ : LQGMetric.TestOn upperHalfPlaneOpens) (R : ℝ) (n : ℕ) :
    Measurable[offSigma A F] (offSum A F φ R n) :=
  Finset.measurable_sum _ fun _ _ => measurable_offEval A F _

open Classical in
/-- **(WF12): the reconstruction sums converge to the field** (proof of Lemma 4.14 / Proposition R1). Let `h` be a
zero-boundary GFF on `ℍ`, `F = h + m` with `m` bounded on `ℍ`, `φ` a test function supported in `B̄(0, R)`, and
`n_j → ∞` deterministic scales along which `N_{n_j}(A ∩ tsupport φ) (n_j + 1) 4^{-n_j} → 0` almost surely. Then
almost surely `offSum A F φ R n_j → F φ`. -/
theorem ae_tendsto_offSum
    (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hm : ∀ z ∈ QuantumZipper.H, |m z| ≤ Mm)
    (hF : ∀ ω ψ, F ω ψ = h ω ψ + ∫ z, m z * ψ z) (φ : LQGMetric.TestOn upperHalfPlaneOpens)
    {R : ℝ} (hR : 0 ≤ R) (hRsub : tsupport φ ⊆ closedBall 0 R) {ns : ℕ → ℕ}
    (hns : Tendsto ns atTop atTop)
    (hcov : ∀ᵐ ω ∂P, Tendsto (fun j => (Dimension.dyadicCount (ns j) (A ω ∩ tsupport φ) : ℝ) *
      (ns j + 1) / 4 ^ ns j) atTop (𝓝 0)) :
    ∀ᵐ ω ∂P, Tendsto (fun j => offSum A F φ R (ns j) ω) atTop (𝓝 (F ω φ)) := by
  obtain ⟨B, hB'⟩ := φ.continuous.bounded_above_of_compact_support φ.hasCompactSupport
  have hB : ∀ z, |φ z| ≤ B := fun z => by simpa [Real.norm_eq_abs] using hB' z
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB 0)
  obtain ⟨L, hL⟩ := ae_eventually_abs_le_pouTest hh φ hR hB
  set L' : ℝ := |L| + 4 * π * |Mm| * B with hL'
  have hL'0 : 0 ≤ L' := by positivity
  set Y : ℕ → Ω → ℝ := offSum A F φ R with hY
  -- the exact decomposition
  have hdec : ∀ n ω, F ω φ = ∑ k ∈ pouIdx (scaleIdx R n), F ω (pouTest φ n k) := fun n ω => by
    conv_lhs => rw [← sum_pouTest hRsub (le_scaleIdx R n)]
    exact map_sum (F ω) _ _
  -- the discarded pieces
  have herr : ∀ n ω, |F ω φ - Y n ω| ≤ ∑ k ∈ (pouIdx (scaleIdx R n)).filter
      (fun k => ¬ Disjoint (tsupport (pouTest φ n k)) (A ω)), |F ω (pouTest φ n k)| := by
    intro n ω
    rw [hdec n ω, hY, offSum, ← Finset.sum_sub_distrib]
    have hterm : ∀ k, F ω (pouTest φ n k) - offEval A F (pouTest φ n k) ω =
        if ¬ Disjoint (tsupport (pouTest φ n k)) (A ω) then F ω (pouTest φ n k) else 0 := by
      intro k
      by_cases hk : Disjoint (tsupport (pouTest φ n k)) (A ω)
      · rw [offEval_of_disjoint hk, sub_self]; simp [hk]
      · rw [offEval_of_not_disjoint hk, sub_zero]; simp [hk]
    simp_rw [hterm]
    rw [← Finset.sum_filter]
    exact Finset.abs_sum_le_sum_abs _ _
  -- almost sure convergence along the scales of (R1.1)
  show ∀ᵐ ω ∂P, Tendsto (fun j => Y (ns j) ω) atTop (𝓝 (F ω φ))
  filter_upwards [hL, hcov] with ω hLω hcovω
  have hev : ∀ᶠ n in atTop, |F ω φ - Y n ω| ≤
      9 * L' * ((Dimension.dyadicCount n (A ω ∩ tsupport φ) : ℝ) * (n + 1) / 4 ^ n) := by
    filter_upwards [hLω] with n hn
    refine (herr n ω).trans ?_
    have h4 : (0 : ℝ) < 4 ^ n := by positivity
    have hpiece : ∀ k ∈ pouIdx (scaleIdx R n), |F ω (pouTest φ n k)| ≤ L' * (n + 1) / 4 ^ n := by
      intro k hk
      rw [hF]
      have h1 := hn k hk
      have h2 := abs_integral_mul_pouTest_le hm φ hB n k
      have hn1 : (1 : ℝ) ≤ n + 1 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
      calc |h ω (pouTest φ n k) + ∫ z, m z * pouTest φ n k z|
          ≤ |h ω (pouTest φ n k)| + |∫ z, m z * pouTest φ n k z| := abs_add_le _ _
        _ ≤ L * (n + 1) / 4 ^ n + 4 * π * |Mm| * B / 4 ^ n := add_le_add h1 h2
        _ ≤ L' * (n + 1) / 4 ^ n := by
            rw [← add_div]
            refine div_le_div_of_nonneg_right ?_ h4.le
            rw [hL']
            have hc : 0 ≤ 4 * π * |Mm| * B := by positivity
            have hLa : L * (n + 1) ≤ |L| * (n + 1) :=
              mul_le_mul_of_nonneg_right (le_abs_self L) (by linarith)
            nlinarith
    calc ∑ k ∈ (pouIdx (scaleIdx R n)).filter
          (fun k => ¬ Disjoint (tsupport (pouTest φ n k)) (A ω)), |F ω (pouTest φ n k)|
        ≤ ∑ _k ∈ (pouIdx (scaleIdx R n)).filter
          (fun k => ¬ Disjoint (tsupport (pouTest φ n k)) (A ω)), L' * (n + 1) / 4 ^ n :=
          Finset.sum_le_sum fun k hk => hpiece k (Finset.mem_filter.1 hk).1
      _ = ((pouIdx (scaleIdx R n)).filter
          (fun k => ¬ Disjoint (tsupport (pouTest φ n k)) (A ω))).card * (L' * (n + 1) / 4 ^ n) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (9 * Dimension.dyadicCount n (A ω ∩ tsupport φ) : ℕ) * (L' * (n + 1) / 4 ^ n) :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast card_bad_le φ (A ω) n _) (by positivity)
      _ = 9 * L' * ((Dimension.dyadicCount n (A ω ∩ tsupport φ) : ℝ) * (n + 1) / 4 ^ n) := by
          push_cast; ring
  have hev' := hns.eventually hev
  have hlim : Tendsto (fun j => 9 * L' * ((Dimension.dyadicCount (ns j) (A ω ∩ tsupport φ) : ℝ) *
      (ns j + 1) / 4 ^ ns j)) atTop (𝓝 0) := by
    simpa using hcovω.const_mul (9 * L')
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero' (Eventually.of_forall fun j => norm_nonneg _) ?_ hlim
  filter_upwards [hev'] with j hj
  rw [Real.norm_eq_abs, abs_sub_comm]
  exact hj

/-- **Each pairing is recovered off `A`** (proof of Lemma 4.14 / Proposition R1). Let `h` be a zero-boundary GFF
on `ℍ`, `F = h + m` with `m` bounded on `ℍ`, and `A` a random set with the covering property (R1.1). Then for
every test function `φ`, `F φ` is a.s. equal to an `offSigma A F`-measurable function: the a.s. limit along the
scales of (R1.1) of the reconstruction sums `offSum`. -/
theorem exists_measurable_offSigma_ae_eq
    (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hm : ∀ z ∈ QuantumZipper.H, |m z| ≤ Mm)
    (hF : ∀ ω ψ, F ω ψ = h ω ψ + ∫ z, m z * ψ z) (hA : HasThinCovering A P)
    (φ : LQGMetric.TestOn upperHalfPlaneOpens) :
    ∃ g : Ω → ℝ, Measurable[offSigma A F] g ∧ (fun ω => F ω φ) =ᵐ[P] g := by
  obtain ⟨R₀, hR₀⟩ := φ.hasCompactSupport.isCompact.isBounded.subset_closedBall 0
  have hRsub : tsupport φ ⊆ closedBall 0 (max R₀ 0) :=
    hR₀.trans (closedBall_subset_closedBall (le_max_left _ _))
  obtain ⟨ns, hns, hcov⟩ := hA (tsupport φ) φ.hasCompactSupport.isCompact φ.tsupport_subset
  have hconv := ae_tendsto_offSum hh hm hF φ (le_max_right R₀ 0) hRsub hns hcov
  refine ⟨fun ω => limUnder atTop (fun j => offSum A F φ (max R₀ 0) (ns j) ω), ?_, ?_⟩
  · exact measurable_limUnder_real (m := offSigma A F) fun j => measurable_offSum A F φ _ _
  · filter_upwards [hconv] with ω hω
    exact hω.limUnder_eq.symm

/-- **Wang–Wu Lemma 4.14 / Proposition R1 (thin-set reconstruction) on `ℍ`.** Let `h` be a zero-boundary GFF
on `ℍ`, `F = h + m` with `m` bounded on `ℍ`, and `A` any random set (no measurability or locality) with the
covering property (R1.1). Then `σ(F)` is almost surely determined by the restriction of `F` to `ℍ ∖ A`:
every event of `σ(F)` is a.s. equal to an event of `offSigma A F`. -/
theorem aeDeterminedSigma_offSigma
    (hh : LQGMetric.IsZeroBoundaryGFF upperHalfPlaneOpens h P)
    (hm : ∀ z ∈ QuantumZipper.H, |m z| ≤ Mm)
    (hF : ∀ ω ψ, F ω ψ = h ω ψ + ∫ z, m z * ψ z) (hA : HasThinCovering A P) :
    LQGMetric.AEDeterminedSigma (MeasurableSpace.comap F inferInstance) (offSigma A F) P := by
  show MeasurableSpace.comap F inferInstance ≤ aeSigma (offSigma A F) P
  have hcomap : MeasurableSpace.comap F (LQGMetric.DistOn.measurableSpace upperHalfPlaneOpens) =
      ⨆ φ : LQGMetric.TestOn upperHalfPlaneOpens,
        MeasurableSpace.comap (fun ω => F ω φ) inferInstance := by
    rw [LQGMetric.DistOn.measurableSpace, MeasurableSpace.comap_comp, MeasurableSpace.pi,
      MeasurableSpace.comap_iSup]
    refine iSup_congr fun φ => ?_
    rw [MeasurableSpace.comap_comp]
    rfl
  rw [hcomap]
  refine iSup_le fun φ => ?_
  obtain ⟨g, hg, hFg⟩ := exists_measurable_offSigma_ae_eq hh hm hF hA φ
  rintro _ ⟨S, hS, rfl⟩
  refine ⟨g ⁻¹' S, hg hS, ?_⟩
  filter_upwards [hFg] with ω hω
  simp only [mem_preimage, hω]

end Reconstruct

end InteractingSLE.WangWu
