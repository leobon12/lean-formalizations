import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
import Mathlib.MeasureTheory.Constructions.BorelSpace.Metrizable
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Topology.UniformSpace.HeineCantor
import Mathlib.Topology.Instances.ENNReal.Lemmas

/-!
# The `C(K₁ × K₁, ℝ)`-valued restriction functional (track CC, packet CC5, target T3, corrected: T3′)

Source: `planning/audits/CC0-conformal-covariance-plan.md`, Details (a) **D7**, last item ("C(K×K)-valued
functional"), consumed by D9 step 5 (`LawEqCont` with `F̂`).

## Correction of the packet's T3 (reported in `planning/handoffs/CC5.md`)

The packet's T3 asks that the set `G` of `x` for which `d x` is finite and continuous on `K₁ × K₁` be
measurable, and that `x ↦ (d x restricted to K₁ × K₁, junk 0 off G)` be measurable, given only that
each `x ↦ d x u v` is measurable. **Both claims are false**, already for `X = ℝ` with its Borel
σ-algebra and `K₁ = [0,1] ⊆ ℂ`; machine-checked in `CC/LusinCounterexample.lean`
(`exists_not_measurableSet_finite_continuousOn`, `exists_not_measurable_restrict_junk`). There
`A ⊆ [0,1/2]` is not Borel and `d x u v = a` if `u = v = x ∈ A`, `b` otherwise (`a ≠ b` finite). Each
`x ↦ d x u v` is constant off a set with at most one point, but `d x` is continuous on `K₁ × K₁` iff
`x ∉ A`, so `G = Aᶜ`; with `(a, b) = (0, 1)` the junk-`0` functional at `(0, 0)` is `1_{Aᶜ}`.
(Joint measurability of `(x, u, v) ↦ d x u v` does not help either: by standard descriptive set
theory, not formalized here, `G` is then co-analytic and need not be Borel.)

D7's own recipe ("test it on a countable dense subset with rational moduli") describes a different set,
which is what this file uses. Fix a countable dense `s ⊆ K`:
* `ucSet f s`: `f x` is finite on `s` and `q ↦ (f x q).toReal` is uniformly continuous on `s`. It is
  **measurable** (`measurableSet_ucSet`) and contains every `x` for which `f x` is finite and continuous
  on `K` (`mem_ucSet_of_continuous`, `K` compact).
* `ucExt f hs x : C(K, ℝ)`: the continuous extension of `q ↦ (f x q).toReal` from `s` when
  `x ∈ ucSet f s`, and `0` otherwise. It is **measurable** (`measurable_ucExt`) and **equals
  `(f x ·).toReal`** whenever `f x` is finite and continuous on `K` (`ucExt_eq_of_continuous`).

The two-point form for a compact `K₁ ⊆ E` is `restrictPair d K₁ : X → C(K₁ × K₁, ℝ)`
(`measurable_restrictPair`, `restrictPair_apply`, `abs_sub_le_dist_restrictPair`). This is exactly what
D9 needs: there `d x` is a.s. finite and continuous on `K₁ × K₁` at `x = Y n ω`, so the functional of
D9 step 5 is the restricted metric a.s., and measurability of the exact good set is never used.

*Measurability of `ucExt`*: by `ContinuousMap.measurable_iff_eval` (the Borel σ-algebra of `C(K, ℝ)` is
generated by evaluations; Mathlib) it suffices to treat `x ↦ ucExt f hs x p`. For `p ∈ s` this is
`1_{ucSet} · (f · p).toReal`; for general `p` it is the pointwise limit along `q_m → p`, `q_m ∈ s`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Filter Topology Set TopologicalSpace
open scoped ENNReal

namespace SmallGammaGeodesics.CC

section General

variable {X : Type*} {K : Type*} [PseudoMetricSpace K]

/-- **The tested set**: `f x` is finite on `s`, and `q ↦ (f x q).toReal` is uniformly continuous on
`s`. For a countable `s` it is measurable (`measurableSet_ucSet`). -/
def ucSet (f : X → K → ℝ≥0∞) (s : Set K) : Set X :=
  {x | (∀ q ∈ s, f x q ≠ ⊤) ∧ UniformContinuousOn (fun q => (f x q).toReal) s}

/-- The tested set with countable tolerances `1/(n+1)`, `1/(m+1)`. -/
theorem ucSet_eq (f : X → K → ℝ≥0∞) (s : Set K) :
    ucSet f s = (⋂ q ∈ s, {x | f x q ≠ ⊤}) ∩
      ⋂ n : ℕ, ⋃ m : ℕ, ⋂ a ∈ s, ⋂ b ∈ s,
        {x | dist a b < 1 / ((m : ℝ) + 1) →
          |(f x a).toReal - (f x b).toReal| < 1 / ((n : ℝ) + 1)} := by
  ext x
  simp only [ucSet, mem_ofPred_eq, mem_inter_iff, mem_iInter, mem_iUnion,
    Metric.uniformContinuousOn_iff, Real.dist_eq]
  refine and_congr Iff.rfl ⟨fun h n => ?_, fun h ε hε => ?_⟩
  · obtain ⟨δ, hδ, hδ'⟩ := h (1 / ((n : ℝ) + 1)) Nat.one_div_pos_of_nat
    obtain ⟨m, hm⟩ := exists_nat_one_div_lt hδ
    exact ⟨m, fun a ha b hb hab => hδ' a ha b hb (hab.trans hm)⟩
  · obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
    obtain ⟨m, hm⟩ := h n
    exact ⟨1 / ((m : ℝ) + 1), Nat.one_div_pos_of_nat,
      fun a ha b hb hab => (hm a ha b hb hab).trans hn⟩

/-- **The tested set is measurable** (countable `s`, each `x ↦ f x p` measurable). -/
theorem measurableSet_ucSet [MeasurableSpace X] {f : X → K → ℝ≥0∞}
    (hf : ∀ p, Measurable fun x => f x p) {s : Set K} (hs : s.Countable) :
    MeasurableSet (ucSet f s) := by
  rw [ucSet_eq]
  refine (MeasurableSet.biInter hs fun q _ => (hf q) (measurableSet_singleton ⊤).compl).inter
    (MeasurableSet.iInter fun n => MeasurableSet.iUnion fun m =>
      MeasurableSet.biInter hs fun a _ => MeasurableSet.biInter hs fun b _ => ?_)
  by_cases hab : dist a b < 1 / ((m : ℝ) + 1)
  · simp only [hab, true_implies]
    exact measurableSet_lt
      (continuous_abs.measurable.comp ((hf a).ennreal_toReal.sub (hf b).ennreal_toReal))
      measurable_const
  · simp only [hab, false_implies, ofPred_true, MeasurableSet.univ]

/-- If `f x` is finite and continuous on the compact `K`, then `x` passes the test on any `s`. -/
theorem mem_ucSet_of_continuous [CompactSpace K] {f : X → K → ℝ≥0∞} {x : X}
    (hfin : ∀ p, f x p ≠ ⊤) (hc : Continuous fun p => f x p) (s : Set K) : x ∈ ucSet f s := by
  refine ⟨fun q _ => hfin q, ?_⟩
  have hcr : Continuous fun p => (f x p).toReal :=
    ENNReal.continuousOn_toReal.comp_continuous hc hfin
  exact (CompactSpace.uniformContinuous_of_continuous hcr).uniformContinuousOn

/-- **The restriction functional** (general form): the continuous extension to `K` of
`q ↦ (f x q).toReal` from the dense set `s` when `x ∈ ucSet f s`, and `0` otherwise. -/
def ucExt (f : X → K → ℝ≥0∞) {s : Set K} (hs : Dense s) (x : X) : C(K, ℝ) := by
  classical
  exact if hx : x ∈ ucSet f s then
    ⟨hs.extend fun q : s => (f x q).toReal,
      (hs.uniformContinuous_extend (uniformContinuousOn_iff_restrict.1 hx.2)).continuous⟩
  else 0

theorem ucExt_of_mem {f : X → K → ℝ≥0∞} {s : Set K} (hs : Dense s) {x : X}
    (hx : x ∈ ucSet f s) (q : s) : ucExt f hs x q = (f x q).toReal := by
  simp only [ucExt, dite_eq_left hx]
  exact hs.extend_eq (uniformContinuousOn_iff_restrict.1 hx.2).continuous q

theorem ucExt_of_notMem {f : X → K → ℝ≥0∞} {s : Set K} (hs : Dense s) {x : X}
    (hx : x ∉ ucSet f s) : ucExt f hs x = 0 := by
  simp only [ucExt, dite_eq_right hx]

/-- **On the good set the functional is the restriction**: if `f x` is finite and continuous on the
compact `K`, then `ucExt f hs x = (f x ·).toReal`. -/
theorem ucExt_eq_of_continuous [CompactSpace K] {f : X → K → ℝ≥0∞} {s : Set K} (hs : Dense s)
    {x : X} (hfin : ∀ p, f x p ≠ ⊤) (hc : Continuous fun p => f x p) :
    ⇑(ucExt f hs x) = fun p => (f x p).toReal := by
  have hx := mem_ucSet_of_continuous hfin hc s
  have hcr : Continuous fun p => (f x p).toReal :=
    ENNReal.continuousOn_toReal.comp_continuous hc hfin
  exact Continuous.ext_on hs (ucExt f hs x).continuous hcr fun q hq => ucExt_of_mem hs hx ⟨q, hq⟩

/-- **The restriction functional is measurable** (countable dense `s`, compact `K`, each `x ↦ f x p`
measurable). -/
theorem measurable_ucExt [MeasurableSpace X] [CompactSpace K] {f : X → K → ℝ≥0∞}
    (hf : ∀ p, Measurable fun x => f x p) {s : Set K} (hsc : s.Countable) (hs : Dense s) :
    Measurable (ucExt f hs) := by
  classical
  have hS := measurableSet_ucSet hf hsc
  -- evaluation at a point of `s`
  have hq : ∀ q : s, Measurable fun x => ucExt f hs x q := by
    intro q
    have : (fun x => ucExt f hs x q) = (ucSet f s).piecewise (fun x => (f x q).toReal) 0 := by
      funext x
      by_cases hx : x ∈ ucSet f s
      · rw [piecewise_eq_of_mem _ _ _ hx, ucExt_of_mem hs hx]
      · rw [piecewise_eq_of_notMem _ _ _ hx, ucExt_of_notMem hs hx]
        rfl
    rw [this]
    exact Measurable.piecewise hS (hf q).ennreal_toReal measurable_const
  -- evaluation at a general point: a limit along `s`
  rw [ContinuousMap.measurable_iff_eval]
  intro p
  obtain ⟨u, hus, hu⟩ := mem_closure_iff_seq_limit.1 (hs p)
  exact measurable_of_tendsto_metrizable (f := fun m x => ucExt f hs x (u m))
    (fun m => hq ⟨u m, hus m⟩)
    (tendsto_pi_nhds.2 fun x => ((ucExt f hs x).continuous.tendsto p).comp hu)

end General

section TwoPoint

variable {X : Type*} {E : Type*}

/-- a fixed countable dense subset of a separable space -/
def denseCtbl (K : Type*) [TopologicalSpace K] [SeparableSpace K] : Set K :=
  (exists_countable_dense K).choose

theorem denseCtbl_countable (K : Type*) [TopologicalSpace K] [SeparableSpace K] :
    (denseCtbl K).Countable :=
  (exists_countable_dense K).choose_spec.1

theorem denseCtbl_dense (K : Type*) [TopologicalSpace K] [SeparableSpace K] :
    Dense (denseCtbl K) :=
  (exists_countable_dense K).choose_spec.2

/-- the two-point function `d x` on `K₁ × K₁` -/
def pairFun (d : X → E → E → ℝ≥0∞) (K₁ : Set E) (x : X) (p : K₁ × K₁) : ℝ≥0∞ :=
  d x p.1 p.2

/-- **The `C(K₁ × K₁, ℝ)`-valued restriction functional** (T3′; CC0 D7 last item, corrected): when
`d x` passes the countable test (`restrictPairGood`), the continuous extension to `K₁ × K₁` of
`(d x ·, ·).toReal` restricted to the countable dense set `denseCtbl (K₁ × K₁)`; `0` otherwise. It
equals `(d x ·, ·).toReal` on `K₁ × K₁` whenever `d x` is finite and continuous there
(`restrictPair_apply`). -/
def restrictPair [PseudoMetricSpace E] (d : X → E → E → ℝ≥0∞) (K₁ : Set E) [CompactSpace K₁] :
    X → C(K₁ × K₁, ℝ) :=
  ucExt (pairFun d K₁) (denseCtbl_dense (K₁ × K₁))

/-- the measurable test set of `restrictPair` (contains the exact good set,
`mem_restrictPairGood`) -/
def restrictPairGood [PseudoMetricSpace E] (d : X → E → E → ℝ≥0∞) (K₁ : Set E)
    [CompactSpace K₁] : Set X :=
  ucSet (pairFun d K₁) (denseCtbl (K₁ × K₁))

variable {d : X → E → E → ℝ≥0∞} {K₁ : Set E}

theorem measurable_pairFun [MeasurableSpace X] (hd : ∀ u v, Measurable fun x => d x u v)
    (p : K₁ × K₁) : Measurable fun x => pairFun d K₁ x p :=
  hd _ _

variable [PseudoMetricSpace E]

theorem continuous_pairFun_of_continuousOn {x : X}
    (hc : ContinuousOn (fun p : E × E => d x p.1 p.2) (K₁ ×ˢ K₁)) :
    Continuous fun p : K₁ × K₁ => pairFun d K₁ x p :=
  hc.comp_continuous (f := fun p : K₁ × K₁ => ((p.1 : E), (p.2 : E))) (by fun_prop)
    fun p => ⟨p.1.2, p.2.2⟩

variable [CompactSpace K₁]

/-- **T3′ (a)**: the test set is measurable. -/
theorem measurableSet_restrictPairGood [MeasurableSpace X]
    (hd : ∀ u v, Measurable fun x => d x u v) : MeasurableSet (restrictPairGood d K₁) :=
  measurableSet_ucSet (measurable_pairFun hd) (denseCtbl_countable _)

/-- **T3′ (b)**: the restriction functional is measurable. -/
theorem measurable_restrictPair [MeasurableSpace X] (hd : ∀ u v, Measurable fun x => d x u v) :
    Measurable (restrictPair d K₁) :=
  measurable_ucExt (measurable_pairFun hd) (denseCtbl_countable _) (denseCtbl_dense _)

/-- the exact good set lies in the test set -/
theorem mem_restrictPairGood {x : X} (hfin : ∀ u ∈ K₁, ∀ v ∈ K₁, d x u v ≠ ⊤)
    (hc : ContinuousOn (fun p : E × E => d x p.1 p.2) (K₁ ×ˢ K₁)) :
    x ∈ restrictPairGood d K₁ :=
  mem_ucSet_of_continuous (f := pairFun d K₁) (fun p : K₁ × K₁ => hfin _ p.1.2 _ p.2.2)
    (continuous_pairFun_of_continuousOn hc) _

/-- **T3′ (c)**: if `d x` is finite and continuous on `K₁ × K₁`, the functional is its restriction. -/
theorem restrictPair_apply {x : X} (hfin : ∀ u ∈ K₁, ∀ v ∈ K₁, d x u v ≠ ⊤)
    (hc : ContinuousOn (fun p : E × E => d x p.1 p.2) (K₁ ×ˢ K₁)) (p : K₁ × K₁) :
    restrictPair d K₁ x p = (d x p.1 p.2).toReal :=
  congrFun (ucExt_eq_of_continuous (f := pairFun d K₁) (denseCtbl_dense (K₁ × K₁))
    (fun p : K₁ × K₁ => hfin _ p.1.2 _ p.2.2) (continuous_pairFun_of_continuousOn hc)) p

/-- the sup distance of the functionals controls the two-point functions on `K₁ × K₁` -/
theorem abs_sub_le_dist_restrictPair {x y : X} (hfx : ∀ u ∈ K₁, ∀ v ∈ K₁, d x u v ≠ ⊤)
    (hcx : ContinuousOn (fun p : E × E => d x p.1 p.2) (K₁ ×ˢ K₁))
    (hfy : ∀ u ∈ K₁, ∀ v ∈ K₁, d y u v ≠ ⊤)
    (hcy : ContinuousOn (fun p : E × E => d y p.1 p.2) (K₁ ×ˢ K₁)) {u v : E} (hu : u ∈ K₁)
    (hv : v ∈ K₁) :
    |(d x u v).toReal - (d y u v).toReal| ≤ dist (restrictPair d K₁ x) (restrictPair d K₁ y) := by
  have h := ContinuousMap.dist_apply_le_dist (f := restrictPair d K₁ x) (g := restrictPair d K₁ y)
    ((⟨u, hu⟩, ⟨v, hv⟩) : K₁ × K₁)
  rwa [restrictPair_apply hfx hcx, restrictPair_apply hfy hcy, Real.dist_eq] at h

end TwoPoint

end SmallGammaGeodesics.CC
