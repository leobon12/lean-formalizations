import GaussianLQG.LQG.Bridge.Defs
import LQGMetric.Papers.GM.S1.FieldAux

/-!
# Basic facts about the canonical γ-LQG metric

* a whole-plane GFF is a whole-plane GFF plus the (bounded) continuous function `0`
  (`isGFFPlusBddCont_of_isWholePlaneGFF`, `isGFFPlusCont_of_isWholePlaneGFF`), so the axioms of
  `LQGMetric.IsStrongLQGMetric` and the LFPP convergence of `GaussianLQG.IsCanonicalLQGMetric`
  apply to it;
* measurability (blueprint (S2), first clause, and blueprint Proposition `prop:metric-facts` (F1)):
  for a measurable field `h`, `ω ↦ D_{h(ω)}(u, v)` is measurable for fixed `u, v`
  (`IsCanonicalLQGMetric.measurable_dist`), and `ω ↦ D_{h(ω)}` is measurable as a
  `C(ℂ × ℂ, ℝ)`-valued map (`IsCanonicalLQGMetric.measurable_coe`), for the Borel σ-algebra of the
  compact-open topology, which is the σ-algebra generated by the evaluations
  (`ContinuousMap.measurable_iff_eval`).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Filter Topology

namespace GaussianLQG

open LQGMetric

lemma sub_ofCont_zero {Ω : Type*} (h : Ω → DistC) :
    (fun ω => h ω - ofCont (0 : C(ℂ, ℝ))) = h := by
  funext ω
  rw [GM.ofCont_zero_eq, sub_zero]

/-- A whole-plane GFF is a whole-plane GFF plus the bounded continuous function `0`. -/
theorem isGFFPlusBddCont_of_isWholePlaneGFF {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {h : Ω → DistC} (hh : IsWholePlaneGFF h P) : IsGFFPlusBddCont h P := by
  refine ⟨hh.measurable, fun _ => 0, measurable_const, fun _ => ⟨0, fun z => ?_⟩, ?_⟩
  · rw [ContinuousMap.zero_apply, abs_zero]
  · rw [sub_ofCont_zero]
    exact hh

/-- A whole-plane GFF is a whole-plane GFF plus the continuous function `0`. -/
theorem isGFFPlusCont_of_isWholePlaneGFF {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {h : Ω → DistC} (hh : IsWholePlaneGFF h P) : IsGFFPlusCont h P := by
  refine ⟨hh.measurable, fun _ => 0, measurable_const, ?_⟩
  rw [sub_ofCont_zero]
  exact hh

namespace IsCanonicalLQGMetric

variable {γ : ℝ} {D : DistC → ContMetric}

/-- `h ↦ D_h` is measurable from `𝒟'(ℂ)` to `C(ℂ × ℂ, ℝ)`. -/
theorem measurable_coe_comp (hD : IsCanonicalLQGMetric γ D) :
    Measurable fun g : DistC => (D g).1 :=
  measurable_subtype_coe.comp hD.1.measurable

/-- `h ↦ D_h(u, v)` is measurable on `𝒟'(ℂ)`. -/
theorem measurable_dist_comp (hD : IsCanonicalLQGMetric γ D) (u v : ℂ) :
    Measurable fun g : DistC => (D g).1 (u, v) :=
  (ContinuousMap.measurable_eval (u, v)).comp hD.measurable_coe_comp

variable {Ω : Type*} [MeasurableSpace Ω] {h : Ω → DistC}

/-- **Measurability of `D(u, v)`**: for a measurable field `h`, `ω ↦ D_{h(ω)}(u, v)` is
measurable. -/
theorem measurable_dist (hD : IsCanonicalLQGMetric γ D) (hh : Measurable h) (u v : ℂ) :
    Measurable fun ω => (D (h ω)).1 (u, v) :=
  (hD.measurable_dist_comp u v).comp hh

/-- **Measurability of `D` as a random continuous function**: for a measurable field `h`,
`ω ↦ D_{h(ω)}` is measurable as a `C(ℂ × ℂ, ℝ)`-valued map. -/
theorem measurable_coe (hD : IsCanonicalLQGMetric γ D) (hh : Measurable h) :
    Measurable fun ω => (D (h ω)).1 :=
  hD.measurable_coe_comp.comp hh

end IsCanonicalLQGMetric

end GaussianLQG
