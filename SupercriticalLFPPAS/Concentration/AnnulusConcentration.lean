import SupercriticalLQGUniqueness.Uniqueness.EndSaving.MainExtra.OffCentre
import SupercriticalLQGUniqueness.Uniqueness.Toolkit.FieldTranslations

/-!
# Annulus concentration for the whole-plane GFF

Adapters from the certified annulus iteration theorem to the closed annuli used by
*Almost sure convergence of supercritical Liouville first passage percolation*.
Events are measured in `fieldSigmaClosed0`, the sigma-algebra generated by zero-mean
test-function pairings on arbitrarily small neighborhoods of a closed annulus.
-/

set_option autoImplicit false
noncomputable section

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

namespace SupercriticalLFPPAS.Concentration

open LQGMetric (DistC IsNormalizedWPGFF addConst circleAvg)

/-- The closed-annulus sigma-algebra modulo additive constants is unchanged when the
field is recentered by any sample-dependent real-valued observable. In particular, it
is unchanged by subtracting a circle average at any positive radius and any centre. -/
theorem modConstSigma_addRandomConstant {Ω : Type} [MeasurableSpace Ω]
    (h : Ω → DistC) (q : Ω → ℝ) (K : Set ℂ) :
    LQGMetric.Blueprint.fieldSigmaClosed0 (fun ω => addConst (h ω) (q ω)) K =
      LQGMetric.Blueprint.fieldSigmaClosed0 h K :=
  LQGMetric.CONF.fieldSigmaClosed0_addConst h q K

/-- Translation to a deterministic centre followed by circle-average normalization
converts the project's frozen normalized-GFF class to the older class required by
the LM iteration library. This is the normalization bridge used in the off-centre
annulus transfer. -/
theorem normalizedTranslatedField {Ω : Type} [MeasurableSpace Ω]
    {P : Measure Ω} {h : Ω → DistC}
    (hh : SupercriticalLQGUniqueness.IsNormalizedWholePlaneGFF h P) (z : ℂ) :
    IsNormalizedWPGFF
      (fun ω => addConst (SupercriticalLQGUniqueness.translateDist z (h ω))
        (-circleAvg (h ω) 1 z)) P :=
  SupercriticalLQGUniqueness.normalized_translate_old hh z

/-- Annulus concentration for events measurable from a closed concentric annulus
modulo additive constants. The centred sigma-algebra is written using the field
`h - h_{r_k}(z)`, as in the paper. The hypotheses on the radii and events are needed
only for indices counted by `countOcc`, namely `1 ≤ k ≤ n`. -/
theorem annulus_concentration_centered
    (s₀ s₁ s₂ a b : ℝ)
    (hs₁ : 0 < s₁) (hs₁₂ : s₁ < s₂) (hs₂ : s₂ < 1)
    (hs₀ : 0 < s₀) (hs₀' : s₀ < min s₁ (1 - s₂))
    (ha : 0 < a) (hb : 0 < b) (hb1 : b < 1) :
    ∃ p C : ℝ, 0 < p ∧ p < 1 ∧ 0 < C ∧
      ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (h : Ω → DistC), SupercriticalLQGUniqueness.IsNormalizedWholePlaneGFF h P →
        ∀ (z : ℂ) (r : ℕ → ℝ) (E : ℕ → Set Ω),
          (∀ k, 1 ≤ k → 0 < r k) →
          (∀ k, 1 ≤ k → r (k + 1) ≤ r k) →
          (∀ k, 1 ≤ k → r (k + 1) / r k ≤ s₁ - s₀) →
          (∀ k, 1 ≤ k → MeasurableSet[
            LQGMetric.Blueprint.fieldSigmaClosed0
              (fun ω => addConst (h ω) (-circleAvg (h ω) (r k) z))
              {x | s₁ * r k ≤ dist x z ∧ dist x z ≤ s₂ * r k}] (E k)) →
          (∀ k, 1 ≤ k → ENNReal.ofReal p ≤ P (E k)) →
          ∀ n : ℕ,
            P {ω | (LQGMetric.Blueprint.countOcc E n ω : ℝ) < b * n} ≤
              ENNReal.ofReal (C * Real.exp (-a * n)) := by
  obtain ⟨p, C, hp, hp1, hC, hmain⟩ :=
    SupercriticalLQGUniqueness.Uniqueness.EndSaving.MainExtra.annulusOffcenterAt_part1
      s₀ s₁ s₂ hs₁ hs₁₂ hs₂ hs₀ hs₀' a ha b hb hb1
  refine ⟨p, C, hp, hp1, hC, ?_⟩
  intro Ω _ P _ h hh z r E hr0 hrA hrs hE hpE n
  have hEraw : ∀ k, 1 ≤ k → MeasurableSet[
      LQGMetric.Blueprint.fieldSigmaClosed0 h
        {x | s₁ * r k ≤ dist x z ∧ dist x z ≤ s₂ * r k}] (E k) := by
    intro k hk
    rw [← modConstSigma_addRandomConstant h
      (fun ω => -circleAvg (h ω) (r k) z)
      {x | s₁ * r k ≤ dist x z ∧ dist x z ≤ s₂ * r k}]
    exact hE k hk
  by_cases hn : 1 ≤ n
  · exact hmain P h hh.1 z r (fun _ => z) E hr0 hrA hrs
      (fun k hk => by
        simp only [dist_self]
        exact mul_nonneg hs₀.le (hr0 k hk).le)
      (fun k hk => ⟨E k, hEraw k hk, Filter.Eventually.of_forall fun _ => rfl⟩)
      hpE n hn
  · have hn0 : n = 0 := by omega
    subst n
    have hEmpty :
        {ω | (LQGMetric.Blueprint.countOcc E 0 ω : ℝ) < 0} = ∅ := by
      ext ω
      simp [LQGMetric.Blueprint.countOcc]
    simp only [Nat.cast_zero, mul_zero]
    rw [hEmpty, measure_empty]
    positivity

/-- The paper's annuli `A_{r/16,32r}(z)` are obtained by taking the outer scale
`64r`: their relative radii are `1/1024` and `1/2`. The scale ratio `1/4096`
leaves the positive slack required by the closed-to-open annulus adapter. -/
theorem paper_annulus_concentration
    (a b : ℝ) (ha : 0 < a) (hb : 0 < b) (hb1 : b < 1) :
    ∃ p C : ℝ, 0 < p ∧ p < 1 ∧ 0 < C ∧
      ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (h : Ω → DistC), SupercriticalLQGUniqueness.IsNormalizedWholePlaneGFF h P →
        ∀ (z : ℂ) (r : ℕ → ℝ) (E : ℕ → Set Ω),
          (∀ k, 1 ≤ k → 0 < r k) →
          (∀ j k, 1 ≤ j → j ≤ k → r k ≤ r j) →
          (∀ k, 1 ≤ k → r (k + 1) / r k ≤ (1 / 4096 : ℝ)) →
          (∀ k, 1 ≤ k → MeasurableSet[
            LQGMetric.Blueprint.fieldSigmaClosed0
              (fun ω => addConst (h ω) (-circleAvg (h ω) (r k) z))
              {x | r k / 16 ≤ dist x z ∧ dist x z ≤ 32 * r k}] (E k)) →
          (∀ k, 1 ≤ k → ENNReal.ofReal p ≤ P (E k)) →
          ∀ n : ℕ,
            P {ω | (LQGMetric.Blueprint.countOcc E n ω : ℝ) < b * n} ≤
              ENNReal.ofReal (C * Real.exp (-a * n)) := by
  obtain ⟨p, C, hp, hp1, hC, hmain⟩ :=
    annulus_concentration_centered
      (1 / 4096) (1 / 1024) (1 / 2) a b
      (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) ha hb hb1
  refine ⟨p, C, hp, hp1, hC, ?_⟩
  intro Ω _ P _ h hh z r E hr0 hrAnti hrRatio hE hpE n
  let R : ℕ → ℝ := fun k => 64 * r k
  have hR0 : ∀ k, 1 ≤ k → 0 < R k := by
    intro k hk
    have hrk := hr0 k hk
    dsimp [R]
    positivity
  have hRAnti : ∀ k, 1 ≤ k → R (k + 1) ≤ R k := by
    intro k hk
    dsimp [R]
    exact mul_le_mul_of_nonneg_left (hrAnti k (k + 1) hk (by omega)) (by norm_num)
  have hRratio : ∀ k, 1 ≤ k → R (k + 1) / R k ≤ (1 / 1024 : ℝ) - 1 / 4096 := by
    intro k hk
    have hscale : R (k + 1) / R k = r (k + 1) / r k := by
      dsimp [R]
      field_simp [ne_of_gt (hr0 k hk)]
    rw [hscale]
    have hsmall := hrRatio k hk
    norm_num at hsmall ⊢
    linarith
  have hE' : ∀ k, 1 ≤ k → MeasurableSet[
      LQGMetric.Blueprint.fieldSigmaClosed0
        (fun ω => addConst (h ω) (-circleAvg (h ω) (R k) z))
        {x | (1 / 1024 : ℝ) * R k ≤ dist x z ∧ dist x z ≤ (1 / 2 : ℝ) * R k}]
      (E k) := by
    intro k hk
    have hlow : (1 / 1024 : ℝ) * R k = r k / 16 := by
      dsimp [R]
      ring
    have hhigh : (1 / 2 : ℝ) * R k = 32 * r k := by
      dsimp [R]
      ring
    have hset :
        {x : ℂ | (1 / 1024 : ℝ) * R k ≤ dist x z ∧ dist x z ≤ (1 / 2 : ℝ) * R k} =
        {x : ℂ | r k / 16 ≤ dist x z ∧ dist x z ≤ 32 * r k} := by
      rw [hlow, hhigh]
    rw [modConstSigma_addRandomConstant h
      (fun ω => -circleAvg (h ω) (R k) z)
      {x | (1 / 1024 : ℝ) * R k ≤ dist x z ∧ dist x z ≤ (1 / 2 : ℝ) * R k}, hset,
      ← modConstSigma_addRandomConstant h
        (fun ω => -circleAvg (h ω) (r k) z)
        {x | r k / 16 ≤ dist x z ∧ dist x z ≤ 32 * r k}]
    exact hE k hk
  exact hmain P h hh z R E hR0 hRAnti hRratio hE' hpE n

/-- In the paper's scale regime, the successful-annulus fraction can be fixed
(for example at `1/2`) while the exponential rate is chosen arbitrarily large.
This is the form used to choose a rate exceeding the lattice union-bound cost in §4.2. -/
theorem paper_annulus_concentration_arbitrary_rate
    (a : ℝ) (ha : 0 < a) :
    ∃ p C : ℝ, 0 < p ∧ p < 1 ∧ 0 < C ∧
      ∀ {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (h : Ω → DistC), SupercriticalLQGUniqueness.IsNormalizedWholePlaneGFF h P →
        ∀ (z : ℂ) (r : ℕ → ℝ) (E : ℕ → Set Ω),
          (∀ k, 1 ≤ k → 0 < r k) →
          (∀ j k, 1 ≤ j → j ≤ k → r k ≤ r j) →
          (∀ k, 1 ≤ k → r (k + 1) / r k ≤ (1 / 4096 : ℝ)) →
          (∀ k, 1 ≤ k → MeasurableSet[
            LQGMetric.Blueprint.fieldSigmaClosed0
              (fun ω => addConst (h ω) (-circleAvg (h ω) (r k) z))
              {x | r k / 16 ≤ dist x z ∧ dist x z ≤ 32 * r k}] (E k)) →
          (∀ k, 1 ≤ k → ENNReal.ofReal p ≤ P (E k)) →
          ∀ n : ℕ,
            P {ω | (LQGMetric.Blueprint.countOcc E n ω : ℝ) < (1 / 2 : ℝ) * n} ≤
              ENNReal.ofReal (C * Real.exp (-a * n)) := by
  obtain ⟨p, C, hp, hp1, hC, hmain⟩ :=
    paper_annulus_concentration a (1 / 2) ha (by norm_num) (by norm_num)
  exact ⟨p, C, hp, hp1, hC, hmain⟩

end SupercriticalLFPPAS.Concentration
