import SupercriticalConformalCovariance.Markov.GeneralVersion
import LQGMetric.Field.MarkovGauss

/-!
# Mean-zero whole-plane pairings projected onto the zero-boundary Cameron--Martin space

This projection is defined for every open domain and every additive-constant convention. It
does not assume that the boundary-touching density `1_V φ` has already been shown admissible.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set TopologicalSpace
open scoped RealInnerProductSpace

namespace SupercriticalConformalCovariance.Markov

open LQGMetric LQGMetric.MarkovZB LQGMetric.MarkovGauss QuantumZipper QuantumZipper.K3

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistC}

/-- The closed Gaussian subspace generated by Dirichlet pairings in `V`. -/
def cmRange (hh : IsWholePlaneGFF h P) (V : Opens ℂ) : Submodule ℝ (Lp ℝ 2 P) :=
  (cmIso hh V).toLinearMap.range

theorem isClosed_cmRange (hh : IsWholePlaneGFF h P) (V : Opens ℂ) :
    IsClosed (cmRange hh V : Set (Lp ℝ 2 P)) := by
  rw [cmRange, LinearMap.coe_range]
  exact (cmIso hh V).isometry.isClosedEmbedding.isClosed_range

instance instCompleteSpaceCmRange (hh : IsWholePlaneGFF h P) (V : Opens ℂ) :
    CompleteSpace (cmRange hh V) := (isClosed_cmRange hh V).completeSpace_coe

private theorem cmIso_mem_cmRange (hh : IsWholePlaneGFF h P) (V : Opens ℂ)
    (v : gradClosure (V : Set ℂ) (QuantumZipper.zeroSpace V)) :
    cmIso hh V v ∈ cmRange hh V := ⟨v, rfl⟩

/-- Orthogonal projection of a mean-zero whole-plane pairing onto `H₀¹(V)`. -/
def projectedPair (hh : IsWholePlaneGFF h P) (V : Opens ℂ) (ψ : TestC0) : Lp ℝ 2 P :=
  (cmRange hh V).starProjection ((memLp_pair hh ψ).toLp _)

lemma projectedPair_mem_cmRange (hh : IsWholePlaneGFF h P) (V : Opens ℂ) (ψ : TestC0) :
    projectedPair hh V ψ ∈ cmRange hh V :=
  (cmRange hh V).starProjection_apply_mem _

/-- The projection represents `f ↦ ∫ f ψ` on every compact smooth `f` in `V`. -/
theorem inner_projectedPair_gradLin (hh : IsWholePlaneGFF h P) (V : Opens ℂ)
    (ψ : TestC0) (f : zsSub V) :
    ⟪projectedPair hh V ψ, cmIso hh V (gradLin V f)⟫ =
      ∫ x, ψ.1 x * f.1 x := by
  have hmem := cmIso_mem_cmRange hh V (gradLin V f)
  have hproj := (cmRange hh V).starProjection_inner_eq_zero
    ((memLp_pair hh ψ).toLp _) (cmIso hh V (gradLin V f)) hmem
  rw [projectedPair]
  have he : ⟪(cmRange hh V).starProjection ((memLp_pair hh ψ).toLp _),
      cmIso hh V (gradLin V f)⟫ =
      ⟪(memLp_pair hh ψ).toLp _, cmIso hh V (gradLin V f)⟫ := by
    have := hproj
    simp only [inner_sub_left] at this
    linarith
  rw [he, real_inner_comm, inner_cmIso_gradLin hh V f ψ]

/-- The part of a mean-zero whole-plane pairing orthogonal to `H₀¹(V)`. -/
def remainderPair (hh : IsWholePlaneGFF h P) (V : Opens ℂ) (ψ : TestC0) : Lp ℝ 2 P :=
  (memLp_pair hh ψ).toLp _ - projectedPair hh V ψ

private theorem projectedPair_mem_gaussSpace (hh : IsWholePlaneGFF h P) (V : Opens ℂ)
    (ψ : TestC0) : projectedPair hh V ψ ∈ gaussSpace (pairProc h) (memLp_pair hh) := by
  obtain ⟨v, hv⟩ := projectedPair_mem_cmRange hh V ψ
  exact hv ▸ cmIso_mem_gaussSpace hh V v

private theorem remainderPair_mem_gaussSpace (hh : IsWholePlaneGFF h P) (V : Opens ℂ)
    (ψ : TestC0) : remainderPair hh V ψ ∈ gaussSpace (pairProc h) (memLp_pair hh) :=
  Submodule.sub_mem _ (toLp_mem_gaussSpace (memLp_pair hh) ψ)
    (projectedPair_mem_gaussSpace hh V ψ)

/-- The Gaussian Hilbert projection and remainder are orthogonal for all mean-zero tests. -/
theorem inner_projected_remainder (hh : IsWholePlaneGFF h P) (V : Opens ℂ)
    (φ ψ : TestC0) : ⟪projectedPair hh V φ, remainderPair hh V ψ⟫ = 0 := by
  have hmem := projectedPair_mem_cmRange hh V φ
  rw [remainderPair, real_inner_comm]
  exact (cmRange hh V).starProjection_inner_eq_zero
    ((memLp_pair hh ψ).toLp _) (projectedPair hh V φ) hmem

/-- Independence of the projected and complementary mean-zero pairing processes. -/
theorem indepFun_projected_remainder (hh : IsWholePlaneGFF h P) (V : Opens ℂ) :
    IndepFun (fun ω (φ : TestC0) => (projectedPair hh V φ : Ω → ℝ) ω)
      (fun ω (ψ : TestC0) => (remainderPair hh V ψ : Ω → ℝ) ω) P := by
  let W : (TestC0 ⊕ TestC0) → Lp ℝ 2 P :=
    Sum.elim (projectedPair hh V) (remainderPair hh V)
  have hW : ∀ s, W s ∈ gaussSpace (pairProc h) (memLp_pair hh) := by
    intro s
    cases s with
    | inl φ => exact projectedPair_mem_gaussSpace hh V φ
    | inr ψ => exact remainderPair_mem_gaussSpace hh V ψ
  have hG := isGaussianProcess_of_mem_gaussSpace (gaussian_pairProc hh)
    (centered_pairProc hh) (memLp_pair hh) W hW
  have hG' : IsGaussianProcess
      (Sum.elim (fun φ => (projectedPair hh V φ : Ω → ℝ))
        (fun ψ => (remainderPair hh V ψ : Ω → ℝ))) P := by
    have he : (fun s => (W s : Ω → ℝ)) =
        Sum.elim (fun φ => (projectedPair hh V φ : Ω → ℝ))
          (fun ψ => (remainderPair hh V ψ : Ω → ℝ)) := by
      funext s
      cases s <;> rfl
    rwa [← he]
  refine hG'.indepFun_of_covariance_eq_zero
    (fun φ => (Lp.aestronglyMeasurable _).aemeasurable)
    (fun ψ => (Lp.aestronglyMeasurable _).aemeasurable) fun φ ψ => ?_
  rw [covariance_eq_inner _ (Lp.memLp _) 
    (isCGauss_of_mem_gaussSpace (gaussian_pairProc hh) (centered_pairProc hh)
      (memLp_pair hh) (projectedPair_mem_gaussSpace hh V φ)).2,
    Lp.toLp_coeFn]
  exact inner_projected_remainder hh V φ ψ

end SupercriticalConformalCovariance.Markov
