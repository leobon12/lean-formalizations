import SupercriticalConformalCovariance.Markov.GeneratedVersion

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set Metric TopologicalSpace Laplacian
open InnerProductSpace

namespace SupercriticalConformalCovariance.Markov

open LQGMetric LQGMetric.MarkovZB LQGMetric.MarkovExt LQGMetric.MarkovHarm
  LQGMetric.Blueprint QuantumZipper QuantumZipper.K3

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistC} {V : Opens ℂ}

/-- The global arbitrary-domain Markov theorem, with the zero part generated by the
whole field, a full zero-extension law, a joint harmonic representative, and
independence of the mean-zero complement. -/
theorem exists_generated_joint_markov_general (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) :
    ∃ (F : DistC → DistC) (H : Ω → ℂ → ℝ),
      Measurable F ∧
      (∀ φ : TestC, (fun ω => F (h ω) φ) =ᵐ[P] zbExt hh V φ) ∧
      (∀ ω : Ω, restrictTo
        (toOpens (closure (V : Set ℂ))ᶜ isClosed_closure.isOpen_compl)
        (F (h ω)) = 0) ∧
      IsZeroBoundaryGFF V (fun ω => restrictTo V (F (h ω))) P ∧
      LQGMetric.CONF.IsZBExtField V (fun ω => F (h ω)) P ∧
      Measurable (fun p : Ω × ℂ => H p.1 p.2) ∧
      (∀ᵐ ω ∂P, HarmonicOnNhd (H ω) (V : Set ℂ) ∧
        ∀ φ : TestOn V,
          restrictTo V (h ω - F (h ω)) φ = ∫ x, H ω x * φ x) ∧
      IndepFun (fun ω (φ : TestC0) => F (h ω) φ.1)
        (fun ω (ψ : TestC0) => h ω ψ.1 - F (h ω) ψ.1) P := by
  obtain ⟨F, hFm, hFae, hFsupp⟩ := exists_measurable_zeroExtension_map hh hV
  have hzm : Measurable (fun ω => F (h ω)) := hFm.comp hh.measurable
  obtain ⟨H, hHm, hH⟩ := exists_joint_harmonic_of_version hh hV hzm hFae
  exact ⟨F, H, hFm, hFae, hFsupp,
    isZeroBoundaryGFF_restrict_of_version hh hV hzm hFae,
    isZBExtField_general hh hV hzm hFae,
    hHm, hH, indepFun_version_complement_meanZero hh hV hFae⟩

/-- Replacing the canonical zero-boundary extension by an independent zero-boundary
extension on the same admissible domain preserves the whole-plane GFF law, with
whatever additive-constant convention the original field carries. -/
theorem replace_version_of_isZBExtField (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) {hz Z : Ω → DistC}
    (hzm : Measurable hz)
    (hzae : ∀ φ : TestC, (fun ω => hz ω φ) =ᵐ[P] zbExt hh V φ)
    (hZ : LQGMetric.CONF.IsZBExtField V Z P)
    (hZind : IndepFun Z h P) :
    IsWholePlaneGFF (fun ω => h ω - hz ω + Z ω) P := by
  have hZlaw : P.map Z = P.map hz :=
    isZBExtField_map_eq hZ (isZBExtField_general hh hV hzm hzae)
  exact replace_zbExt_general hh hV hzm hzae hZ.measurable hZlaw hZind

/-- A replacement version whose own zero part is explicitly a measurable function of `h`. -/
theorem exists_replacement_map (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) {Z : Ω → DistC}
    (hZ : LQGMetric.CONF.IsZBExtField V Z P)
    (hZind : IndepFun Z h P) :
    ∃ F : DistC → DistC, Measurable F ∧
      IsWholePlaneGFF (fun ω => h ω - F (h ω) + Z ω) P := by
  obtain ⟨F, hFm, hFae, -⟩ := exists_measurable_zeroExtension_map hh hV
  exact ⟨F, hFm, replace_version_of_isZBExtField hh hV
    (hFm.comp hh.measurable) hFae hZ hZind⟩

end SupercriticalConformalCovariance.Markov
