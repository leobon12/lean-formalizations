import LQGMetric.Field.StandardBorelRange

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 800000

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set Metric TopologicalSpace
open scoped RealInnerProductSpace

namespace SupercriticalConformalCovariance.Markov

open LQGMetric LQGMetric.MarkovZB LQGMetric.MarkovExt LQGMetric.MarkovGerm
  LQGMetric.MarkovVer2
  LQGMetric.GFFExist LQGMetric.Blueprint QuantumZipper QuantumZipper.K3

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistC} {V : Opens ℂ}

/-- A coordinate measurable with respect to the field has the same law under the trimmed
field σ-algebra and under the original probability measure. -/
private theorem map_trim_hSigma (hh : IsWholePlaneGFF h P)
    {X : Ω → ℝ} (hX : @Measurable Ω ℝ (hSigma h) _ X) :
    (@Measure.map Ω ℝ (hSigma h) _ X
      (P.trim hh.measurable.comap_le : @Measure Ω (hSigma h))) = P.map X := by
  ext s hs
  have hXm : Measurable X := hX.mono hh.measurable.comap_le le_rfl
  rw [Measure.map_apply hX hs, Measure.map_apply hXm hs]
  exact trim_measurableSet_eq hh.measurable.comap_le (hX hs)

/-- Countable-coordinate regularity can be performed in the σ-algebra generated by the
whole field itself. -/
theorem exists_continuous_rectVec_hSigma (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) :
    ∃ Y : ℂ → Ω → ℝ, (∀ ω, Continuous fun x => Y x ω) ∧
      (∀ x, @Measurable Ω ℝ (hSigma h) _ (Y x)) ∧
      ∀ x, (fun ω => Y x ω) =ᵐ[P] rectVec hh V x := by
  by_cases hne : (V : Set ℂ).Nonempty
  · choose X hXm hXae using fun x =>
      exists_hSigma_version hh (extVec_mem_gaussSpace hh V (rectDens V x))
    have hXproc (x : ℂ) : X x =ᵐ[P] rectProc hh V x :=
      (hXae x).symm.trans (rectProc_ae hh V x).symm
    have hLawP (x x' : ℂ) : HasLaw (fun ω => X x ω - X x' ω)
        (gaussianReal 0 (‖rectVec hh V x - rectVec hh V x'‖ ^ 2).toNNReal) P := by
      refine (hasLaw_rectProc_sub hh V x x').congr ?_
      filter_upwards [hXproc x, hXproc x'] with ω hx hx'
      rw [hx, hx']
    let μ : @Measure Ω (hSigma h) := P.trim hh.measurable.comap_le
    have hLawμ (x x' : ℂ) : @HasLaw Ω ℝ (hSigma h) _
        (fun ω => X x ω - X x' ω)
        (gaussianReal 0 (‖rectVec hh V x - rectVec hh V x'‖ ^ 2).toNNReal) μ := by
      refine ⟨((hXm x).sub (hXm x')).aemeasurable, ?_⟩
      exact (map_trim_hSigma hh ((hXm x).sub (hXm x'))).trans (hLawP x x').map_eq
    have hv : ∀ A : ℝ, ∃ C, 0 ≤ C ∧ ∀ x x' : ℂ,
        |x.re| ≤ A → |x.im| ≤ A → |x'.re| ≤ A → |x'.im| ≤ A →
        ((‖rectVec hh V x - rectVec hh V x'‖ ^ 2).toNNReal : ℝ) ≤
          C * ‖x - x'‖ := by
      intro A
      obtain ⟨C, hC, hbound⟩ := sq_norm_rectVec_sub_le_general hh hV hne A
      refine ⟨C, hC, fun x x' h0 h1 h2 h3 => ?_⟩
      rw [Real.coe_toNNReal', max_le_iff]
      exact ⟨hbound x x' h0 h1 h2 h3, by positivity⟩
    have hμae (f g : Ω → ℝ)
        (hf : @Measurable Ω ℝ (hSigma h) _ f)
        (hg : @Measurable Ω ℝ (hSigma h) _ g)
        (he : f =ᵐ[μ] g) : f =ᵐ[P] g := by
      have hs : @MeasurableSet Ω (hSigma h) {ω | f ω = g ω} :=
        measurableSet_eq_fun hf hg
      rw [Filter.EventuallyEq, ae_iff] at he ⊢
      have hs' : @MeasurableSet Ω (hSigma h) {ω | ¬ f ω = g ω} := hs.compl
      have heq : μ {ω | ¬ f ω = g ω} = P {ω | ¬ f ω = g ω} :=
        trim_measurableSet_eq hh.measurable.comap_le hs'
      exact heq ▸ he
    obtain ⟨Y, hYc, hYm, hY⟩ :=
      @GFFExist.exists_continuous_modification_of_gauss Ω (hSigma h) μ X hXm
        (fun x x' => (‖rectVec hh V x - rectVec hh V x'‖ ^ 2).toNNReal)
        hLawμ hv
    refine ⟨Y, hYc, hYm, fun x => ?_⟩
    exact (hμae _ _ (hYm x) (hXm x) (hY x)).trans (hXae x).symm
  · have hVe : (V : Set ℂ) = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
    have hzero : ∀ x, rectVec hh V x = 0 := by
      intro x
      have hρ : rectDens V x = 0 := by funext z; simp [rectDens, hVe]
      simp only [rectVec, hρ, extVec, rieszFun_zero]
      convert (cmIso hh V).map_zero using 1
      exact Subtype.ext rfl
    exact ⟨fun _ _ => 0, fun _ => continuous_const, fun _ => measurable_const,
      fun x => by rw [hzero x]; exact (Lp.coeFn_zero ℝ 2 P).symm⟩

/-- A global distribution version generated measurably by the whole field. -/
theorem exists_hSigma_dist_version_zbExt_general (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) :
    ∃ hz : Ω → DistC, @Measurable Ω DistC (hSigma h) _ hz ∧
      (∀ φ : TestC, (fun ω => hz ω φ) =ᵐ[P] zbExt hh V φ) ∧
      ∀ ω, restrictTo
        (toOpens (closure (V : Set ℂ))ᶜ isClosed_closure.isOpen_compl)
        (hz ω) = 0 := by
  obtain ⟨Y, hYc, hYms, hY⟩ := exists_continuous_rectVec_hSigma hh hV
  let hz : Ω → DistC := LQGMetric.GFFExist.gffOf Y hYc
  have hzs : @Measurable Ω DistC (hSigma h) _ hz := by
    letI : MeasurableSpace Ω := hSigma h
    exact LQGMetric.GFFExist.measurable_gffOf Y hYc hYms
  have hm : Measurable hz := hzs.mono hh.measurable.comap_le le_rfl
  have hYm : ∀ x, Measurable (Y x) := fun x =>
    (hYms x).mono hh.measurable.comap_le le_rfl
  have hv : ∀ φ : TestC, (fun ω => hz ω φ) =ᵐ[P] zbExt hh V φ := by
    intro φ
    filter_upwards [ae_integral_d12_mul_Y_general hh hV hYc hYm hY φ,
      (zbExt_ae hh V φ).symm] with ω h1 h2
    rw [LQGMetric.GFFExist.gffOf_apply, h1]
    exact h2
  let W := LQGMetric.MarkovVer.outV V
  let S : Set Ω := {ω | ∀ c : CoordJ, hz ω (extC W (comb W c)) = 0}
  have hS : @MeasurableSet Ω (hSigma h) S := by
    simp only [S, Set.ofPred_forall]
    exact MeasurableSet.iInter fun c =>
      measurableSet_eq_fun ((measurable_distOn_apply _).comp hzs) measurable_const
  have hvan : ∀ c : CoordJ, ∀ x ∈ (V : Set ℂ),
      (extC W (comb W c)) x = 0 := by
    intro c x hx
    rw [coe_extC]
    refine (comb W c).zero_on_compl fun hxW => ?_
    have : x ∉ closure (V : Set ℂ) := hxW
    exact this (subset_closure hx)
  have hSae : ∀ᵐ ω ∂P, ω ∈ S := by
    have hcoord : ∀ᵐ ω ∂P, ∀ c : CoordJ,
        hz ω (extC W (comb W c)) = 0 := by
      rw [ae_all_iff]
      intro c
      filter_upwards [hv (extC W (comb W c)),
        zbExt_ae_eq_zero hh (hvan c)] with ω h1 h2
      rw [h1, h2]
      rfl
    exact hcoord
  have hrS : ∀ ω ∈ S, restrictTo W (hz ω) = 0 := fun ω hω =>
    injective_pairJ W (funext fun c => by
      show restrictTo W (hz ω) (comb W c) = (0 : DistOn W) (comb W c)
      rw [ContinuousLinearMap.zero_apply]
      exact hω c)
  classical
  let hz' : Ω → DistC := fun ω => if ω ∈ S then hz ω else 0
  have hz's : @Measurable Ω DistC (hSigma h) _ hz' :=
    Measurable.ite hS hzs measurable_const
  refine ⟨hz', hz's, fun φ => ?_, fun ω => ?_⟩
  · filter_upwards [hSae, hv φ] with ω h1 h2
    simp only [hz', if_pos h1]
    exact h2
  · by_cases hω : ω ∈ S
    · simp only [hz', if_pos hω]
      exact hrS ω hω
    · simp only [hz', if_neg hω]
      exact ContinuousLinearMap.zero_comp _

/-- The canonical zero extension is, up to its canonical pairings, a measurable function
of the whole-plane field itself for every admissible domain. -/
theorem exists_measurable_zeroExtension_map (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) :
    ∃ F : DistC → DistC, Measurable F ∧
      (∀ φ : TestC, (fun ω => F (h ω) φ) =ᵐ[P] zbExt hh V φ) ∧
      ∀ ω : Ω, restrictTo
        (toOpens (closure (V : Set ℂ))ᶜ isClosed_closure.isOpen_compl)
        (F (h ω)) = 0 := by
  obtain ⟨hz, hzs, hv, hsupp⟩ := exists_hSigma_dist_version_zbExt_general hh hV
  obtain ⟨F, hFm, hF⟩ := hzs.exists_eq_measurable_comp (f := h)
  refine ⟨F, hFm, fun φ => ?_, ?_⟩
  · simpa only [hF, Function.comp_def] using hv φ
  · intro ω
    have hω := hsupp ω
    simpa only [hF, Function.comp_def] using hω

end SupercriticalConformalCovariance.Markov
