import SupercriticalConformalCovariance.Markov.GeneralFub
import SupercriticalConformalCovariance.Markov.FullIndep
import LQGMetric.Field.MarkovGermVer

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set Metric TopologicalSpace
open scoped RealInnerProductSpace

namespace SupercriticalConformalCovariance.Markov

open LQGMetric LQGMetric.MarkovGauss LQGMetric.MarkovZB LQGMetric.MarkovExt
  QuantumZipper QuantumZipper.K3

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
  {h : Ω → DistC} {V : Opens ℂ}

def hSigma (h : Ω → DistC) : MeasurableSpace Ω :=
  MeasurableSpace.comap h inferInstance

/-- The Gaussian Hilbert space generated by mean-zero pairings is measurable with respect
to the whole field, modulo null sets. -/
theorem gaussSpace_le_lpMeas_hSigma (hh : IsWholePlaneGFF h P) :
    gaussSpace (pairProc h) (memLp_pair hh) ≤
      lpMeas ℝ ℝ (hSigma h) 2 P := by
  have hm : hSigma h ≤ ‹MeasurableSpace Ω› := hh.measurable.comap_le
  refine Submodule.topologicalClosure_minimal _ (Submodule.span_le.2 ?_)
    (isClosed_aestronglyMeasurable hm)
  rintro _ ⟨χ, rfl⟩
  rw [SetLike.mem_coe, mem_lpMeas_iff_aestronglyMeasurable]
  have hhm : @Measurable Ω DistC (hSigma h) _ h :=
    measurable_iff_comap_le.2 le_rfl
  have hχm : @Measurable Ω ℝ (hSigma h) _ (pairProc h χ) :=
    (measurable_distOn_apply χ.1).comp hhm
  exact ⟨pairProc h χ, hχm.stronglyMeasurable, (memLp_pair hh χ).coeFn_toLp⟩

/-- Every Gaussian Hilbert vector has a whole-field-measurable representative. -/
theorem exists_hSigma_version (hh : IsWholePlaneGFF h P)
    {u : Lp ℝ 2 P}
    (hu : u ∈ gaussSpace (pairProc h) (memLp_pair hh)) :
    ∃ G : Ω → ℝ, @Measurable Ω ℝ (hSigma h) _ G ∧
      (u : Ω → ℝ) =ᵐ[P] G := by
  obtain ⟨G, hG, he⟩ :=
    mem_lpMeas_iff_aestronglyMeasurable.1 (gaussSpace_le_lpMeas_hSigma hh hu)
  exact ⟨G, hG.measurable, he⟩

/-- Independence from the whole field passes to every family in its Gaussian Hilbert space. -/
theorem indepFun_field_gaussFamily (hh : IsWholePlaneGFF h P)
    {Z : Ω → DistC} (hZ : Measurable Z) (hind : IndepFun Z h P)
    {T : Type} (u : T → Lp ℝ 2 P)
    (hu : ∀ t, u t ∈ gaussSpace (pairProc h) (memLp_pair hh)) :
    IndepFun Z (fun ω t => (u t : Ω → ℝ) ω) P := by
  choose G hGm hGe using fun t => exists_hSigma_version hh (hu t)
  have hGproc : @Measurable Ω (T → ℝ) (hSigma h) _
      (fun ω t => G t ω) := by
    letI : MeasurableSpace Ω := hSigma h
    exact measurable_pi_iff.2 fun t => hGm t
  have hle : MeasurableSpace.comap (fun ω t => G t ω) inferInstance ≤ hSigma h :=
    hGproc.comap_le
  have hInd : IndepFun Z (fun ω t => G t ω) P := by
    rw [IndepFun_iff_Indep] at hind ⊢
    exact indep_of_indep_of_le_right hind hle
  exact hInd.process_congr_right fun t => (hGe t).symm

theorem remainderPair_mem_gaussSpace_general (hh : IsWholePlaneGFF h P)
    (V : Opens ℂ) (ψ : TestC0) :
    remainderPair hh V ψ ∈ gaussSpace (pairProc h) (memLp_pair hh) := by
  obtain ⟨v, hv⟩ := projectedPair_mem_cmRange hh V ψ
  exact Submodule.sub_mem _ (toLp_mem_gaussSpace (memLp_pair hh) ψ)
    (hv ▸ cmIso_mem_gaussSpace hh V v)

/-- An external field independent of the whole GFF is independent of the canonical
mean-zero complement, even though the projection is defined only as an L² limit. -/
theorem indepFun_external_complement (hh : IsWholePlaneGFF h P)
    (hV : ZBAdmissible V) {hz Z : Ω → DistC}
    (hzae : ∀ φ : TestC, (fun ω => hz ω φ) =ᵐ[P] zbExt hh V φ)
    (hZ : Measurable Z) (hind : IndepFun Z h P) :
    IndepFun Z
      (fun ω (ψ : TestC0) => h ω ψ.1 - hz ω ψ.1) P := by
  have h0 := indepFun_field_gaussFamily hh hZ hind
    (remainderPair hh V) (remainderPair_mem_gaussSpace_general hh V)
  apply h0.process_congr_right
  intro ψ
  have he := extVec_meanZero_eq_projectedPair_general hh hV ψ
  filter_upwards [Lp.coeFn_sub ((memLp_pair hh ψ).toLp _)
    (projectedPair hh V ψ), (memLp_pair hh ψ).coeFn_toLp,
    (zbExt_ae hh V ψ.1).symm, (hzae ψ.1).symm] with ω hs hp hz hza
  rw [remainderPair, hs, Pi.sub_apply, hp, ← he, hz, hza]
  rfl

end SupercriticalConformalCovariance.Markov
