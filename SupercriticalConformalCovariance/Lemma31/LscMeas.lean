import SupercriticalLQGUniqueness.B2.LscTop.Limits

/-!
# Sections of jointly lower semicontinuous kernels are Borel maps into `LSCFun`

If `Φ : X × (ℂ × ℂ) → EReal` is jointly lower semicontinuous, then
`x ↦ Φ(x, ·)` is a Borel map `X → LSCFun` (topology of DG Definition 1.2, any Borel σ-algebra).
Proof: the topology of `LSCFun` is generated by the countable family of rational hit and miss
tests (`B2.LscTop.exists_tests_eq_generateFrom`), so its Borel σ-algebra is generated by them.
* Miss tests `{f | ∀ q ∈ K, r < f q}` (`K` compact) pull back to open sets of `X` (tube lemma,
  `IsCompact.eventually_forall_of_forall_eventually`).
* Hit tests `{f | ∃ q ∈ O, f q < r}` (`O` open) pull back to countable unions of complements of
  such open sets, since `O` is σ-compact.
-/

set_option autoImplicit false

noncomputable section

open Set Filter Topology TopologicalSpace MeasureTheory

namespace SupercriticalConformalCovariance.Lemma31

open SupercriticalLQGUniqueness (LSCFun)
open SupercriticalLQGUniqueness.Uniqueness.Toolkit.CountableBase (Tests Hit Miss)

variable {X : Type*} [TopologicalSpace X]

theorem lowerSemicontinuous_section {Φ : X → ℂ × ℂ → EReal}
    (hΦ : LowerSemicontinuous fun p : X × (ℂ × ℂ) => Φ p.1 p.2) (x : X) :
    LowerSemicontinuous (Φ x) := by
  have hc : Continuous fun q : ℂ × ℂ => (x, q) := continuous_const.prodMk continuous_id
  change LowerSemicontinuous ((fun p : X × (ℂ × ℂ) => Φ p.1 p.2) ∘ fun q : ℂ × ℂ => (x, q))
  exact hΦ.comp hc

/-- The section map of a jointly lower semicontinuous kernel, as an `LSCFun`-valued map. -/
def lscSection (Φ : X → ℂ × ℂ → EReal)
    (hΦ : LowerSemicontinuous fun p : X × (ℂ × ℂ) => Φ p.1 p.2) (x : X) : LSCFun :=
  ⟨Φ x, lowerSemicontinuous_section hΦ x⟩

theorem isOpen_setOf_forall_lt_section {Φ : X → ℂ × ℂ → EReal}
    (hΦ : LowerSemicontinuous fun p : X × (ℂ × ℂ) => Φ p.1 p.2) {K : Set (ℂ × ℂ)}
    (hK : IsCompact K) (r : EReal) : IsOpen {x | ∀ q ∈ K, r < Φ x q} := by
  refine isOpen_iff_mem_nhds.2 fun x₀ hx₀ => ?_
  exact hK.eventually_forall_of_forall_eventually (P := fun x q => r < Φ x q)
    fun q hq => hΦ (x₀, q) r (hx₀ q hq)

theorem exists_compact_cover_of_isOpen {O : Set (ℂ × ℂ)} (hO : IsOpen O) :
    ∃ K : ℕ → Set (ℂ × ℂ), (∀ n, IsCompact (K n)) ∧ ⋃ n, K n = O := by
  have : LocallyCompactSpace O := hO.locallyCompactSpace
  obtain ⟨K, hK, hU⟩ := SigmaCompactSpace.exists_compact_covering (X := O)
  exact ⟨fun n => Subtype.val '' K n, fun n => (hK n).image continuous_subtype_val, by
    rw [← image_iUnion, hU, image_univ, Subtype.range_coe]⟩

/-- **Measurability of sections.** For a jointly lower semicontinuous kernel `Φ` on
`X × (ℂ × ℂ)`, the map `x ↦ Φ(x, ·)` is Borel from `X` to `LSCFun`. -/
theorem measurable_lscSection [MeasurableSpace X] [OpensMeasurableSpace X]
    [MeasurableSpace LSCFun] [BorelSpace LSCFun] (Φ : X → ℂ × ℂ → EReal)
    (hΦ : LowerSemicontinuous fun p : X × (ℂ × ℂ) => Φ p.1 p.2) :
    Measurable (lscSection Φ hΦ) := by
  obtain ⟨B, S, -, -, hBb, hSk, -, heq⟩ := SupercriticalLQGUniqueness.B2.LscTop.exists_tests_eq_generateFrom
  have hborel : ‹MeasurableSpace LSCFun› = MeasurableSpace.generateFrom (Tests B S) := by
    rw [BorelSpace.measurable_eq (α := LSCFun)]
    exact borel_eq_generateFrom_of_subbasis heq
  have hmiss : ∀ (K : Set (ℂ × ℂ)), IsCompact K → ∀ r : EReal,
      MeasurableSet {x | ∀ q ∈ K, r < Φ x q} := fun K hK r =>
    (isOpen_setOf_forall_lt_section hΦ hK r).measurableSet
  refine Measurable.mono (ma := ‹MeasurableSpace X›) ?_ le_rfl hborel.le
  refine measurable_generateFrom fun t ht => ?_
  rcases ht with ⟨⟨⟨O, hO⟩, r⟩, rfl⟩ | ⟨⟨⟨K, hK⟩, r⟩, rfl⟩
  · -- hit test
    obtain ⟨Kn, hKn, hU⟩ := exists_compact_cover_of_isOpen (hBb.isOpen hO)
    have e : lscSection Φ hΦ ⁻¹' Hit O r = ⋃ (n : ℕ) (s : ℚ) (_ : ((s : ℝ) : EReal) < ((r : ℝ) : EReal)),
        {x | ∀ q ∈ Kn n, ((s : ℝ) : EReal) < Φ x q}ᶜ := by
      ext x
      simp only [mem_preimage, Hit, lscSection, mem_ofPred_eq, mem_iUnion, mem_compl_iff, not_forall,
        not_lt, exists_prop]
      constructor
      · rintro ⟨q, hqO, hq⟩
        rw [← hU, mem_iUnion] at hqO
        obtain ⟨n, hn⟩ := hqO
        obtain ⟨s, hs1, hs2⟩ := EReal.exists_rat_btwn_of_lt hq
        exact ⟨n, s, hs2, q, hn, hs1.le⟩
      · rintro ⟨n, s, hs, q, hq, hle⟩
        refine ⟨q, ?_, hle.trans_lt hs⟩
        rw [← hU]
        exact mem_iUnion.2 ⟨n, hq⟩
    rw [e]
    exact MeasurableSet.iUnion fun n => MeasurableSet.iUnion fun s =>
      MeasurableSet.iUnion fun _ => (hmiss _ (hKn n) _).compl
  · -- miss test
    exact hmiss K (hSk K hK) _

end SupercriticalConformalCovariance.Lemma31
