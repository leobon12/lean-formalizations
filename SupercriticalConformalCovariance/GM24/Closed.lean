import SupercriticalConformalCovariance.GM24.IG4Bridge
import SupercriticalConformalCovariance.GM24.SourceCM

/-!
# GM Lemma 2.4, display (2.6), with no inputs

`tendsto_tvDist_gm24_closed`: for `B = B(0,R_B)`, `h` a whole-plane GFF normalized by `(h, 𝐟) = 0`
(`𝐟` radial, `∫ 𝐟 = 1`) and `supp f_{|α|⁻¹} ⊆ B`:

  `TV(law (h ∘ φ_n⁻¹ − (h ∘ φ_n⁻¹)_{𝐟,|α|⁻¹}(0))|_B, law h(α ·)|_B) → 0`.

Route (GM l. 547–562, repaired):
1. `D_n = B(0, R_n/2)` with `B̄(0,R_n/2) ⊆ U_n`, `R_n → ∞`; `V′_n = φ_n(D_n)` (bounded);
2. on `𝒟'(B)` (σ-algebra generated by `distGen B`) the normalized observed field has the coordinates
   `h(e_k)`, where `e_k = confPushTest φ_n⁻¹ (recTest B f_r (distGen B ·))` are mean-zero tests of `D_n`,
   eventually supported in `B(0, |α|R_B + 2)` (the Koebe estimates' inverse convergence);
3. source-side Cameron–Martin (`exists_tv_envelope_general`, the total-variation module's machinery): the law of `(h(e_k))_k`
   is TV-close to that of `(Z_n(e_k))_k`, `Z_n` the Markov zero-boundary part on `D_n`;
4. `(Z_n(e_k))_k` is `Z_n ∘ φ_n⁻¹` (a zero-boundary GFF on `V′_n`) on the total-variation module's carrier, so IG4
   Prop 2.10(i) compares it with the whole-plane field;
5. the limit law `map_nrm_restrict_eq`.
-/

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set Metric TopologicalSpace Filter Topology
open scoped ENNReal
open LQGMetric QuantumZipper SupercriticalConformalCovariance

namespace SupercriticalConformalCovariance.GM24

open SupercriticalConformalCovariance.ZBConformal
open SmallGammaGeodesics.CC (confPullFun confPullFun_of_mem confPullFun_of_notMem confPullOnCLM
  coe_confPullOnCLM testOnOfSupp recTest coe_recTest inclTest coe_inclTest tsupport_confPullFun_subset
  intDist intDist_apply)

variable {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}

/-- The transported carrier test `confPushTest φ⁻¹ ψ` as a mean-zero test of `D`, supported in a ball. -/
def transportedTest {φ : ℂ → ℂ} {D V : Opens ℂ} (hφ : IsConformalBijection φ D V)
    (ψ : TestOn V) (hψ0 : ∫ x, ψ x = 0) {R : ℝ}
    (hsupp : tsupport (confPushTest (isConformalBijection_invFunOn hφ) ψ : ℂ → ℝ) ⊆ ball 0 R) :
    SupercriticalConformalCovariance.TV.ZBLocalTest D (ball (0 : ℂ) R) :=
  ⟨confPushTest (isConformalBijection_invFunOn hφ) ψ, hsupp, by
    have h1 := integral_mul_confPushTest (isConformalBijection_invFunOn hφ) ψ (fun _ => (1 : ℝ))
    simp only [one_mul] at h1
    rw [h1, hψ0]⟩

/-- **The coordinates of the normalized observed field** are the pairings of `h` with the transported
carrier tests. -/
theorem distGen_nrm_invPullDist {U : Set ℂ} {φ : ℂ → ℂ} (hU : IsOpen U)
    (hd : DifferentiableOn ℂ φ U) (hi : InjOn φ U) {D : Opens ℂ} (hDU : (D : Set ℂ) ⊆ U)
    {B : Opens ℂ} (hBV : B ≤ imageOpens (hd.mono hDU) (hi.mono hDU)) (hB : (B : Set ℂ) ⊆ φ '' U)
    {F : TestC} (hFB : tsupport (F : ℂ → ℝ) ⊆ B) (hF1 : ∫ x, F x = 1) (u : DistC) (j : ℕ × ℕ) :
    nrm (testOnOfSupp B F hFB) (invPullDist hU hd hi B hB u) (distGen B j) =
      u (inclTest D (confPushTest (isConformalBijection_invFunOn
        (isConformalBijection_image (hd.mono hDU) (hi.mono hDU)))
        (SupercriticalConformalCovariance.TV.localMeanZeroGenOn B _ hBV F hFB hF1 (Nat.pair j.1 j.2)))) := by
  have hφD := isConformalBijection_image (hd.mono hDU) (hi.mono hDU)
  have hBimg : (B : Set ℂ) ⊆ φ '' D := hBV
  rw [nrm_apply]
  change u (confPullOnCLM hU hd hi B hB (distGen B j)) -
    u (confPullOnCLM hU hd hi B hB (testOnOfSupp B F hFB)) * _ = _
  have e : inclTest D (confPushTest (isConformalBijection_invFunOn hφD)
      (SupercriticalConformalCovariance.TV.localMeanZeroGenOn B _ hBV F hFB hF1 (Nat.pair j.1 j.2))) =
      confPullOnCLM hU hd hi B hB (distGen B j) -
        (∫ x, distGen B j x) • confPullOnCLM hU hd hi B hB (testOnOfSupp B F hFB) := by
    ext x
    rw [coe_inclTest, coe_confPushTest_inv hφD]
    change confPullFun φ D (recTest B F (distGen B (Nat.unpair (Nat.pair j.1 j.2)))) x =
      confPullFun φ U (distGen B j) x - (∫ x, distGen B j x) * confPullFun φ U F x
    rw [Nat.unpair_pair,
      ← confPullFun_eq_of_subset hi hDU (((distGen B j).tsupport_subset).trans hBimg),
      ← confPullFun_eq_of_subset hi hDU (hFB.trans hBimg)]
    by_cases hx : x ∈ (D : Set ℂ)
    · rw [confPullFun_of_mem hx, confPullFun_of_mem hx, confPullFun_of_mem hx, coe_recTest]
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      ring
    · rw [confPullFun_of_notMem hx, confPullFun_of_notMem hx, confPullFun_of_notMem hx]
      ring
  rw [e, map_sub, map_smul, smul_eq_mul]
  ring

open scoped Classical in
/-- **GM Lemma 2.4, display (2.6)** (repaired scale `|α|⁻¹`), on a centred disk `B = B(0,R_B)`, with no
further hypotheses: `TV(law (h ∘ φ_n⁻¹ − (h ∘ φ_n⁻¹)_{𝐟,|α|⁻¹}(0))|_B, law h(α ·)|_B) → 0`. -/
theorem tendsto_tvDist_gm24_closed {U : ℕ → Set ℂ} {φ : ℕ → ℂ → ℂ} {α : ℂ}
    (hopen : ∀ n, IsOpen (U n)) (hzeroU : ∀ n, (0 : ℂ) ∈ U n)
    (hexhaust : ∀ K : Set ℂ, IsCompact K → ∀ᶠ n in atTop, K ⊆ U n)
    (hd : ∀ n, DifferentiableOn ℂ (φ n) (U n)) (hinj : ∀ n, InjOn (φ n) (U n))
    (hzero : ∀ n, φ n 0 = 0) (hα : α ≠ 0)
    (hder : Tendsto (fun n => deriv (φ n) 0) atTop (𝓝 α⁻¹))
    [IsProbabilityMeasure P] {h : Ω → DistC} (hh : IsWholePlaneGFF h P) {f : TestC}
    (hf1 : ∫ x, f x = 1) (hrot : ∀ u : ℂ, ‖u‖ = 1 → ∀ z : ℂ, f (u * z) = f z)
    (hnorm : ∀ᵐ ω ∂P, h ω f = 0) {B : Opens ℂ} {RB : ℝ} (hB : (B : Set ℂ) = ball 0 RB)
    (hRB : 0 < RB) (hFB : tsupport (smoothTest (inv_pos.2 (norm_pos_iff.2 hα)) f : ℂ → ℝ) ⊆ B) :
    Tendsto (fun n => TV.tvDist
      (P.map fun ω => if hn : (B : Set ℂ) ⊆ φ n '' U n then
        nrm (frOn hα f hFB) (invPullDist (hopen n) (hd n) (hinj n) B hn (h ω)) else 0)
      (P.map fun ω => restrictTo B (dilDist hα (h ω)))) atTop (𝓝 0) := by
  rw [← map_nrm_restrict_eq hh hα hf1 hrot hnorm hFB]
  set F : TestC := smoothTest (inv_pos.2 (norm_pos_iff.2 hα)) f with hFdef
  have hF1 : ∫ x, F x = 1 := by rw [hFdef, integral_smoothTest, hf1]
  -- the source disks and their images
  obtain ⟨Rr, hRpos, hRlarge, hRsub⟩ := SupercriticalConformalCovariance.Univalent.exhaustion_radii hopen hzeroU hexhaust
  let D : ℕ → Opens ℂ := fun n => ballOpens (Rr n / 2)
  have hDcl : ∀ n, closedBall (0 : ℂ) (Rr n / 2) ⊆ U n := fun n =>
    (closedBall_subset_ball (half_lt_self (hRpos n))).trans (hRsub n)
  have hDU : ∀ n, (D n : Set ℂ) ⊆ U n := fun n => ball_subset_closedBall.trans (hDcl n)
  let V' : ℕ → Opens ℂ := fun n => imageOpens ((hd n).mono (hDU n)) ((hinj n).mono (hDU n))
  have hVb : ∀ n, Bornology.IsBounded (V' n : Set ℂ) := fun n =>
    ((isCompact_closedBall (0 : ℂ) (Rr n / 2)).image_of_continuousOn
      ((hd n).continuousOn.mono (hDcl n))).isBounded.subset (image_mono ball_subset_closedBall)
  have hφD : ∀ n, IsConformalBijection (φ n) (D n) (V' n) := fun n =>
    isConformalBijection_image ((hd n).mono (hDU n)) ((hinj n).mono (hDU n))
  -- the Markov zero-boundary parts on the source disks, pulled back to the images
  have key : ∀ n, ∃ Z : Ω → DistOn (D n), IsZeroBoundaryGFF (D n) Z P := by
    intro n
    obtain ⟨s, hs, hDs⟩ := SupercriticalConformalCovariance.TV.exists_outside_circle_of_bounded (D n) isBounded_ball
    obtain ⟨_, _, _, _, _, _, _, _, _, hzb, _, _⟩ :=
      SupercriticalConformalCovariance.TV.exists_markov_zb_measurable_version h hh (D n) isBounded_ball hs 0 hDs
    exact ⟨_, hzb⟩
  choose Z hZ using key
  let z' : ∀ n, Ω → DistOn (V' n) := fun n ω =>
    distPullback (isConformalBijection_invFunOn (hφD n)) (Z n ω)
  have hz' : ∀ n, IsZeroBoundaryGFF (V' n) (z' n) P := fun n =>
    isZeroBoundaryGFF_distPullback (isConformalBijection_invFunOn (hφD n)) (hZ n)
  -- the images eventually contain every disk
  have hexK : ∀ K : Set ℂ, IsCompact K → ∀ᶠ n in atTop, K ⊆ D n := by
    intro K hK
    obtain ⟨σ, hσ⟩ := hK.isBounded.subset_closedBall (0 : ℂ)
    filter_upwards [hRlarge.eventually_gt_atTop (2 * σ)] with n hn
    exact hσ.trans (closedBall_subset_ball (by linarith))
  have himg : ∀ ρ : ℝ, ∀ᶠ n in atTop, closedBall (0 : ℂ) ρ ⊆ V' n := fun ρ =>
    eventually_closedBall_subset_image (U := fun n => (D n : Set ℂ)) (fun n => isOpen_ball)
      (fun n => mem_ball_self (half_pos (hRpos n))) hexK (fun n => (hd n).mono (hDU n))
      (fun n => (hinj n).mono (hDU n)) hzero hα hder ρ
  have hexV : ∀ K : Set ℂ, IsCompact K → ∀ᶠ n in atTop, K ⊆ V' n := by
    intro K hK
    obtain ⟨σ, hσ⟩ := hK.isBounded.subset_closedBall (0 : ℂ)
    filter_upwards [himg σ] with n hn
    exact hσ.trans hn
  obtain ⟨Lt, -, hLt, hLtsub⟩ := SupercriticalConformalCovariance.Univalent.exhaustion_radii (U := fun n => (V' n : Set ℂ))
    (fun n => (V' n).isOpen) (fun n => ⟨0, mem_ball_self (half_pos (hRpos n)), hzero n⟩) hexV
  have hIG4 := SupercriticalConformalCovariance.TV.ig4_prop210_zeroBoundary_bounded (fun _ => Ω) B RB hB hRB F hFB hF1 h P hh
    V' hVb Lt hLt hLtsub z' (fun _ => P) hz'
  -- the source-side Cameron–Martin envelope
  set R : ℝ := ‖α‖ * RB + 2 with hRdef
  have hR : 0 < R := by positivity
  obtain ⟨C, hCfin, hC⟩ := exists_tv_envelope_general R hR
  -- eventual geometry
  have hinv := (SupercriticalConformalCovariance.Univalent.exhausting_inverse_core hopen hzeroU hexhaust hd hinj hzero hder
    (inv_ne_zero hα)).1
  have hinvK := (tendstoLocallyUniformlyOn_iff_forall_isCompact isOpen_univ).1 hinv
    (closedBall 0 RB) (subset_univ _) (isCompact_closedBall 0 RB)
  have hinvB : ∀ᶠ n in atTop, ∀ y ∈ closedBall (0 : ℂ) RB,
      ‖Function.invFunOn (φ n) (U n) y‖ < R := by
    filter_upwards [Metric.tendstoUniformlyOn_iff.1 hinvK 1 one_pos] with n hn y hy
    have h1 := hn y hy
    rw [inv_inv, dist_eq_norm] at h1
    have h3 : ‖Function.invFunOn (φ n) (U n) y‖ ≤ ‖α * y‖ +
        ‖α * y - Function.invFunOn (φ n) (U n) y‖ := by
      have := norm_sub_norm_le (Function.invFunOn (φ n) (U n) y) (α * y)
      rw [norm_sub_rev] at this
      linarith
    have h4 : ‖α * y‖ ≤ ‖α‖ * RB := by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.1 hy) (norm_nonneg _)
    linarith
  have hbig : ∀ᶠ n in atTop, 2 * R + 6 < Rr n / 2 := by
    filter_upwards [hRlarge.eventually_gt_atTop (2 * (2 * R + 6))] with n hn
    linarith
  have hBn : ∀ᶠ n in atTop, B ≤ V' n := by
    filter_upwards [himg RB] with n hn
    exact (show (B : Set ℂ) ⊆ closedBall 0 RB by rw [hB]; exact ball_subset_closedBall).trans hn
  -- the ε-argument
  have hLr : Tendsto (fun n => Rr n / 2) atTop atTop := hRlarge.atTop_div_const two_pos
  have henv : Tendsto (fun n => ENNReal.ofReal (SupercriticalConformalCovariance.TV.diskVarianceEnvelope (Rr n / 2) (2 * R + 4)))
      atTop (𝓝 0) := by
    simpa using ENNReal.tendsto_ofReal (SupercriticalConformalCovariance.TV.diskVarianceEnvelope_tendsto_zero hLr (2 * R + 4))
  rw [ENNReal.tendsto_nhds_zero]
  intro ε hε
  have hε2 : 0 < ε / 2 := ENNReal.half_pos hε.ne'
  have hcont : Continuous SupercriticalConformalCovariance.TV.cmMixIntegrand := by
    unfold SupercriticalConformalCovariance.TV.cmMixIntegrand
    exact continuous_const.min (ENNReal.continuous_ofReal.comp
      (Real.continuous_sqrt.comp (Real.continuous_exp.sub continuous_const)))
  have hzero0 : SupercriticalConformalCovariance.TV.cmMixIntegrand 0 = 0 := by simp [SupercriticalConformalCovariance.TV.cmMixIntegrand]
  have hlim : Tendsto SupercriticalConformalCovariance.TV.cmMixIntegrand (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ≥0∞)) := by
    simpa only [hzero0] using (hcont.tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
  have hpos : ∀ᶠ δ : ℝ in 𝓝[>] (0 : ℝ), 0 < δ := self_mem_nhdsWithin
  obtain ⟨δ, hδ, hδsmall⟩ : ∃ δ : ℝ, 0 < δ ∧ SupercriticalConformalCovariance.TV.cmMixIntegrand δ < ε / 2 :=
    (hpos.and (hlim.eventually (Iio_mem_nhds hε2))).exists
  have hmul : Tendsto (fun n => ENNReal.ofReal δ⁻¹ *
      (C * ENNReal.ofReal (SupercriticalConformalCovariance.TV.diskVarianceEnvelope (Rr n / 2) (2 * R + 4)))) atTop (𝓝 0) := by
    have hfirst : Tendsto (fun n => C * ENNReal.ofReal
        (SupercriticalConformalCovariance.TV.diskVarianceEnvelope (Rr n / 2) (2 * R + 4))) atTop (𝓝 0) := by
      simpa only [mul_zero] using ENNReal.Tendsto.const_mul henv (Or.inr hCfin)
    simpa only [mul_zero] using ENNReal.Tendsto.const_mul hfirst (Or.inr ENNReal.ofReal_ne_top)
  have hupper : Tendsto (fun n => SupercriticalConformalCovariance.TV.cmMixIntegrand δ + ENNReal.ofReal δ⁻¹ *
      (C * ENNReal.ofReal (SupercriticalConformalCovariance.TV.diskVarianceEnvelope (Rr n / 2) (2 * R + 4))))
      atTop (𝓝 (SupercriticalConformalCovariance.TV.cmMixIntegrand δ)) := by
    convert tendsto_const_nhds.add hmul using 1 <;> simp
  filter_upwards [hbig, hBn, hinvB, hupper.eventually (Iio_mem_nhds hδsmall),
    hIG4.eventually (Iio_mem_nhds hε2)] with n hn1 hn2 hn3 hn4 hn5
  have hBU : (B : Set ℂ) ⊆ φ n '' U n := (show (B : Set ℂ) ⊆ φ n '' D n from hn2).trans
    (image_mono (hDU n))
  have eN : (fun ω => if hn : (B : Set ℂ) ⊆ φ n '' U n then
      nrm (frOn hα f hFB) (invPullDist (hopen n) (hd n) (hinj n) B hn (h ω)) else 0) =
      fun ω => nrm (testOnOfSupp B F hFB) (invPullDist (hopen n) (hd n) (hinj n) B hBU (h ω)) :=
    funext fun ω => dif_pos hBU
  rw [eN]
  -- the transported carrier tests
  let ψ : ℕ → TestOn (V' n) := fun k => SupercriticalConformalCovariance.TV.localMeanZeroGenOn B (V' n) hn2 F hFB hF1 k
  have hψ0 : ∀ k, ∫ x, ψ k x = 0 := fun k => (SupercriticalConformalCovariance.TV.localMeanZeroGen B F hFB hF1 k).1.2
  have hψB : ∀ k, tsupport (ψ k : ℂ → ℝ) ⊆ B := fun k => (SupercriticalConformalCovariance.TV.localMeanZeroGen B F hFB hF1 k).2
  have hsupp : ∀ k, tsupport (confPushTest (isConformalBijection_invFunOn (hφD n)) (ψ k) : ℂ → ℝ) ⊆
      ball 0 R := by
    intro k
    rw [coe_confPushTest_inv (hφD n)]
    refine (tsupport_confPullFun_subset (D n).isOpen ((hd n).mono (hDU n))
      ((hinj n).mono (hDU n)) (ψ := Function.invFunOn (φ n) (U n))
      (fun z hz => (hinj n).leftInvOn_invFunOn (hDU n hz)) (ψ k).hasCompactSupport
      ((ψ k).tsupport_subset)).trans ?_
    rintro _ ⟨y, hy, rfl⟩
    have hyB : y ∈ closedBall (0 : ℂ) RB := by
      have := hψB k hy
      rw [hB] at this
      exact ball_subset_closedBall this
    exact mem_ball_zero_iff.2 (hn3 y hyB)
  let e : ℕ → SupercriticalConformalCovariance.TV.ZBLocalTest (D n) (ball (0 : ℂ) R) := fun k =>
    transportedTest (hφD n) (ψ k) (hψ0 k) (hsupp k)
  have hGEN := hC h P hh (D n) isBounded_ball (Rr n / 2) hn1 subset_rfl e (Z n) P (hZ n) δ hδ
  have hzl : P.map (fun ω k => Z n ω (e k).1) =
      SupercriticalConformalCovariance.TV.ig4ZBLaw (fun _ => Ω) B F hFB hF1 h P V' z' (fun _ => P) n := by
    simp only [SupercriticalConformalCovariance.TV.ig4ZBLaw, dif_pos (show (B : Set ℂ) ⊆ V' n from hn2),
      SupercriticalConformalCovariance.TV.zbLocalCountableLaw]
    rfl
  -- transfer to the `distGen` coordinates of `𝒟'(B)`
  let ι : DistOn B → ℕ × ℕ → ℝ := fun u j => u (distGen B j)
  have hι : Measurable ι := measurable_pi_iff.2 fun j => measurable_distOn_apply _
  let re : (ℕ → ℝ) → ℕ × ℕ → ℝ := fun x j => x (Nat.pair j.1 j.2)
  have hre : Measurable re := measurable_pi_iff.2 fun j => measurable_pi_apply _
  have hNm : Measurable fun ω =>
      nrm (testOnOfSupp B F hFB) (invPullDist (hopen n) (hd n) (hinj n) B hBU (h ω)) :=
    (measurable_nrm _).comp (measurable_distOn_iff.mpr fun g => by
      change Measurable fun ω => h ω (confPullOnCLM (hopen n) (hd n) (hinj n) B hBU g)
      exact (measurable_distOn_apply _).comp hh.measurable)
  have hLm : Measurable fun ω => nrm (testOnOfSupp B F hFB) (restrictTo B (h ω)) :=
    (measurable_nrm _).comp ((measurable_restrictTo B).comp hh.measurable)
  have hAm : Measurable fun ω (k : ℕ) => h ω (inclTest (D n) (e k).1) :=
    measurable_pi_iff.2 fun k => (measurable_distOn_apply _).comp hh.measurable
  have hcm : Measurable fun ω => SupercriticalConformalCovariance.TV.localCountablePath B F hFB hF1 (h ω) :=
    (SupercriticalConformalCovariance.TV.measurable_localCountablePath B F hFB hF1).comp hh.measurable
  rw [tvDist_eq_map_of_comap (ι := ι) (distOn_measurableSpace_eq_comap B),
    Measure.map_map hι hNm, Measure.map_map hι hLm]
  have e1 : ι ∘ (fun ω => nrm (testOnOfSupp B F hFB)
      (invPullDist (hopen n) (hd n) (hinj n) B hBU (h ω))) =
      re ∘ fun ω (k : ℕ) => h ω (inclTest (D n) (e k).1) := by
    funext ω j
    exact distGen_nrm_invPullDist (hopen n) (hd n) (hinj n) (hDU n) hn2 hBU hFB hF1 (h ω) j
  have e2 : ι ∘ (fun ω => nrm (testOnOfSupp B F hFB) (restrictTo B (h ω))) =
      re ∘ fun ω => SupercriticalConformalCovariance.TV.localCountablePath B F hFB hF1 (h ω) := by
    funext ω j
    exact distGen_nrm_restrictTo hFB hF1 (h ω) j
  rw [e1, e2, ← Measure.map_map hre hAm, ← Measure.map_map hre hcm]
  refine (TV.tvDist_map_le hre).trans ?_
  refine (TV.tvDist_triangle (ν := P.map fun ω k => Z n ω (e k).1)).trans ?_
  have hwp : P.map (fun ω => SupercriticalConformalCovariance.TV.localCountablePath B F hFB hF1 (h ω)) =
      SupercriticalConformalCovariance.TV.wpLocalCountableLaw B F hFB hF1 h P := rfl
  rw [hwp, hzl]
  calc _ ≤ (SupercriticalConformalCovariance.TV.cmMixIntegrand δ + ENNReal.ofReal δ⁻¹ *
          (C * ENNReal.ofReal (SupercriticalConformalCovariance.TV.diskVarianceEnvelope (Rr n / 2) (2 * R + 4)))) +
        TV.tvDist (SupercriticalConformalCovariance.TV.ig4ZBLaw (fun _ => Ω) B F hFB hF1 h P V' z' (fun _ => P) n)
          (SupercriticalConformalCovariance.TV.wpLocalCountableLaw B F hFB hF1 h P) := by
        refine add_le_add ?_ le_rfl
        rw [← hzl]
        exact hGEN
    _ ≤ ε / 2 + ε / 2 := add_le_add hn4.le hn5.le
    _ = ε := ENNReal.add_halves ε

open scoped Classical in
/-- **GM Lemma 2.4, display (2.6)** (repaired scale `|α|⁻¹`), on any bounded open `O` (GM: "for each compact
set `K`"; take `O ⊇ K`), with no further hypotheses and the intrinsic normalized field
`(h ∘ φ_n⁻¹)|_O − (h ∘ φ_n⁻¹)_{𝐟,|α|⁻¹}(0) · 1`. -/
theorem tendsto_tvDist_gm24_open {U : ℕ → Set ℂ} {φ : ℕ → ℂ → ℂ} {α : ℂ}
    (hopen : ∀ n, IsOpen (U n)) (hzeroU : ∀ n, (0 : ℂ) ∈ U n)
    (hexhaust : ∀ K : Set ℂ, IsCompact K → ∀ᶠ n in atTop, K ⊆ U n)
    (hd : ∀ n, DifferentiableOn ℂ (φ n) (U n)) (hinj : ∀ n, InjOn (φ n) (U n))
    (hzero : ∀ n, φ n 0 = 0) (hα : α ≠ 0)
    (hder : Tendsto (fun n => deriv (φ n) 0) atTop (𝓝 α⁻¹))
    [IsProbabilityMeasure P] {h : Ω → DistC} (hh : IsWholePlaneGFF h P) {f : TestC}
    (hf1 : ∫ x, f x = 1) (hrot : ∀ u : ℂ, ‖u‖ = 1 → ∀ z : ℂ, f (u * z) = f z)
    (hnorm : ∀ᵐ ω ∂P, h ω f = 0) {O : Opens ℂ} (hOb : Bornology.IsBounded (O : Set ℂ)) :
    Tendsto (fun n => TV.tvDist
      (P.map fun ω => if hn : (O : Set ℂ) ⊆ φ n '' U n then
        invPullDist (hopen n) (hd n) (hinj n) O hn (h ω) -
          invPullSmoothAvg (U n) (φ n) (h ω) f (inv_pos.2 (norm_pos_iff.2 hα)) • intDist O
        else 0)
      (P.map fun ω => restrictTo O (dilDist hα (h ω)))) atTop (𝓝 0) := by
  set F : TestC := smoothTest (inv_pos.2 (norm_pos_iff.2 hα)) f with hFdef
  obtain ⟨ρ1, hρ1⟩ := hOb.subset_closedBall (0 : ℂ)
  obtain ⟨ρ2, hρ2⟩ := F.hasCompactSupport.isCompact.isBounded.subset_closedBall (0 : ℂ)
  set RB : ℝ := max (max ρ1 ρ2) 0 + 1 with hRBdef
  have hRB : 0 < RB := by positivity
  let B : Opens ℂ := ballOpens RB
  have hcl : ∀ {ρ : ℝ}, ρ ≤ max (max ρ1 ρ2) 0 → closedBall (0 : ℂ) ρ ⊆ B := fun hρ =>
    closedBall_subset_ball (by linarith)
  have hOB : O ≤ B := hρ1.trans (hcl (le_max_of_le_left (le_max_left _ _)))
  have hFB : tsupport (F : ℂ → ℝ) ⊆ B := hρ2.trans (hcl (le_max_of_le_left (le_max_right _ _)))
  have hmain := tendsto_tvDist_gm24_closed hopen hzeroU hexhaust hd hinj hzero hα hder hh hf1 hrot
    hnorm (B := B) (RB := RB) rfl hRB hFB
  obtain ⟨ρ, hρ⟩ := (show Bornology.IsBounded (B : Set ℂ) from isBounded_ball).subset_closedBall
    (0 : ℂ)
  have hsub : ∀ᶠ n in atTop, (B : Set ℂ) ⊆ φ n '' U n := by
    filter_upwards [eventually_closedBall_subset_image hopen hzeroU hexhaust hd hinj hzero hα hder ρ]
      with n hn
    exact hρ.trans hn
  have hR := measurable_restrictDist hOB
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hmain
    (Eventually.of_forall fun _ => bot_le) ?_
  filter_upwards [hsub] with n hn
  have hnO : (O : Set ℂ) ⊆ φ n '' U n := (show (O : Set ℂ) ⊆ B from hOB).trans hn
  have hBm : Measurable fun ω => if hn : (B : Set ℂ) ⊆ φ n '' U n then
      nrm (frOn hα f hFB) (invPullDist (hopen n) (hd n) (hinj n) B hn (h ω)) else 0 := by
    simp only [dif_pos hn]
    exact (measurable_nrm _).comp (measurable_distOn_iff.mpr fun g => by
      change Measurable fun ω => h ω (confPullOnCLM (hopen n) (hd n) (hinj n) B hn g)
      exact (measurable_distOn_apply _).comp hh.measurable)
  have hLm : Measurable fun ω => restrictTo B (dilDist hα (h ω)) :=
    (measurable_restrictTo B).comp (isWholePlaneGFF_dilDist hh hα).measurable
  have e1 : (fun ω => if hn : (O : Set ℂ) ⊆ φ n '' U n then
        invPullDist (hopen n) (hd n) (hinj n) O hn (h ω) -
          invPullSmoothAvg (U n) (φ n) (h ω) f (inv_pos.2 (norm_pos_iff.2 hα)) • intDist O
        else 0) =
      restrictDist hOB ∘ fun ω => if hn : (B : Set ℂ) ⊆ φ n '' U n then
        nrm (frOn hα f hFB) (invPullDist (hopen n) (hd n) (hinj n) B hn (h ω)) else 0 := by
    funext ω
    rw [dif_pos hnO, Function.comp_apply, dif_pos hn]
    ext g
    rw [restrictDist_apply, nrm_invPullDist_apply (hopen n) (hd n) (hinj n) hn hα f hFB,
      ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply, intDist_apply,
      smul_eq_mul, coe_monoCLM_le hOB]
    congr 1
    show h ω (confPullOnCLM _ _ _ O hnO g) = h ω (confPullOnCLM _ _ _ B hn _)
    congr 1
    ext x
    rw [coe_confPullOnCLM, coe_confPullOnCLM, coe_monoCLM_le hOB]
  have e2 : (fun ω => restrictTo O (dilDist hα (h ω))) =
      restrictDist hOB ∘ fun ω => restrictTo B (dilDist hα (h ω)) := by
    funext ω
    ext g
    change dilDist hα (h ω) (TestFunction.monoCLM ℝ (n₁ := ⊤) (n₂ := ⊤) (Ω₁ := O) (Ω₂ := ⊤) g) =
      dilDist hα (h ω) (TestFunction.monoCLM ℝ (n₁ := ⊤) (n₂ := ⊤) (Ω₁ := B) (Ω₂ := ⊤)
        (TestFunction.monoCLM ℝ (n₁ := ⊤) (n₂ := ⊤) (Ω₁ := O) (Ω₂ := B) g))
    congr 1
    ext x
    rw [SmallGammaGeodesics.CC.coe_monoCLM_top, SmallGammaGeodesics.CC.coe_monoCLM_top,
      coe_monoCLM_le hOB]
  rw [e1, e2, ← Measure.map_map hR hBm, ← Measure.map_map hR hLm]
  exact TV.tvDist_map_le hR

end SupercriticalConformalCovariance.GM24
