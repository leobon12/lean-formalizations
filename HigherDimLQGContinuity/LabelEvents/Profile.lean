import HigherDimLQGContinuity.LabelEvents.ArcSpace
import HigherDimLQGMetric.Select.InternalBorel
import HigherDimLQGMetric.Metric.Internal
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
import Mathlib.Topology.ContinuousMap.SecondCountableSpace

/-!
# Internal profiles of length metrics as Borel maps (packet Q5)

Source: blueprint Part B `b:lem-src-meas`(a), proof ("for length metrics, every internal metric used is the
restriction of a Borel function of the metric and is continuous on compact subsets of its open domain");
planning audit NA2, items 12–13, R8 (profiles; closed conditions in (profiles, arc, length)); ruling M34 of [8]
(Borel representatives); the inputs `ContMetric.measurable_chainInf`, `ContMetric.internal_eq_chainInf`
(HDLM `Select/Internal.lean`) and `ContMetric.continuousOn_internal` (LM Lemma 1.1, HDLM `Metric/Internal.lean`).

For an open `W ⊆ ℝ^d`, the `W`-internal metric of a continuous **length** metric `G` is continuous on `W × W`, so it
defines the *profile* `q5Prof hW G : C(W × W, [0, ∞])`. On the space `Q5LenMetric d` of length metrics (subtype
σ-algebra of the Borel σ-algebra of `ContMetric d`), `G ↦ q5Prof hW G` is measurable (`q5_measurable_prof`):
`C(W × W, [0, ∞])` carries the Borel σ-algebra of the compact-open topology, which is generated by the evaluations
(`ContinuousMap.measurable_iff_eval`; `W × W` is locally compact and second countable), and every evaluation is the
Borel chain formula. Hence every condition on finitely or countably many profiles that is **closed** in the profiles
is a measurable set of length metrics, and `q5_exists_measurableSet_of_len` turns a measurable set of pairs of length
metrics into a Borel set of `ContMetric d × ContMetric d` with the same members among length metrics
(`MeasurableSpace.comap_prodMap`).

Helpers: `q5Ev` (evaluation of a profile at two points of `ℝ^d`, `⊤` off `W`, so that `q5Ev (q5Prof hW G) = G(·,·;W)`
everywhere), its continuity `q5_continuousAt_ev`, and the closed sets `q5_isClosed_forall_mem`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Set Metric Filter Topology
open scoped ENNReal
open HigherDimLFPP (Rd)

namespace HigherDimLQGContinuity

open HigherDimLQGMetric

variable {d : ℕ}

/-- The continuous length metrics on `ℝ^d`, with the subtype σ-algebra of the Borel σ-algebra of `ContMetric d`. -/
abbrev Q5LenMetric (d : ℕ) : Type := {G : ContMetric d // G.IsLength}

/-! ## Profiles -/

/-- The `W`-internal profile of a continuous length metric: the `W`-internal metric on `W × W`, continuous by LM
Lemma 1.1 (`ContMetric.continuousOn_internal`). -/
def q5Prof {W : Set (Rd d)} (hW : IsOpen W) (G : Q5LenMetric d) : C(W × W, ℝ≥0∞) where
  toFun p := G.1.internal W p.1 p.2
  continuous_toFun :=
    (G.1.continuousOn_internal G.2 hW).comp_continuous
      ((continuous_subtype_val.comp continuous_fst).prodMk (continuous_subtype_val.comp continuous_snd))
      (fun p => ⟨p.1.2, p.2.2⟩)

theorem q5Prof_apply {W : Set (Rd d)} (hW : IsOpen W) (G : Q5LenMetric d) (p : W × W) :
    q5Prof hW G p = G.1.internal W p.1 p.2 :=
  rfl

/-- **The profile map is measurable** on length metrics. -/
theorem q5_measurable_prof {W : Set (Rd d)} (hW : IsOpen W) :
    Measurable (q5Prof (d := d) hW) := by
  have : LocallyCompactSpace W := hW.locallyCompactSpace
  rw [ContinuousMap.measurable_iff_eval]
  intro p
  have e : (fun G : Q5LenMetric d => q5Prof hW G p) = fun G => G.1.chainInf W p.1 p.2 :=
    funext fun G => G.1.internal_eq_chainInf G.2 hW _ _
  rw [e]
  exact (ContMetric.measurable_chainInf W).comp
    (measurable_subtype_coe.prodMk (measurable_const.prodMk measurable_const))

/-! ## Evaluation at points of `ℝ^d` -/

open Classical in
/-- Evaluation of a `W`-profile at two points of `ℝ^d`, with the value `⊤` of an internal metric off `W`. -/
def q5Ev {W : Set (Rd d)} (f : C(W × W, ℝ≥0∞)) (x y : Rd d) : ℝ≥0∞ :=
  if h : x ∈ W ∧ y ∈ W then f (⟨x, h.1⟩, ⟨y, h.2⟩) else ⊤

theorem q5Ev_of_mem {W : Set (Rd d)} (f : C(W × W, ℝ≥0∞)) {x y : Rd d} (hx : x ∈ W) (hy : y ∈ W) :
    q5Ev f x y = f (⟨x, hx⟩, ⟨y, hy⟩) := by
  simp only [q5Ev, hx, hy, and_self, dite_true]

/-- The evaluation of the profile is the internal metric, at every pair of points. -/
theorem q5Ev_prof {W : Set (Rd d)} (hW : IsOpen W) (G : Q5LenMetric d) (x y : Rd d) :
    q5Ev (q5Prof hW G) x y = G.1.internal W x y := by
  unfold q5Ev
  split_ifs with h
  · rfl
  · rcases not_and_or.1 h with hx | hy
    · exact (G.1.internal_eq_top_of_notMem_left hx).symm
    · exact (G.1.internal_eq_top_of_notMem_right hy).symm

/-- The evaluation is jointly continuous at pairs of points of the open set `W`. -/
theorem q5_continuousAt_ev {W : Set (Rd d)} (hW : IsOpen W) (f : C(W × W, ℝ≥0∞)) {x y : Rd d}
    (hx : x ∈ W) (hy : y ∈ W) :
    ContinuousAt (fun p : C(W × W, ℝ≥0∞) × Rd d × Rd d => q5Ev p.1 p.2.1 p.2.2) (f, x, y) := by
  have : LocallyCompactSpace W := hW.locallyCompactSpace
  set O : Set (C(W × W, ℝ≥0∞) × Rd d × Rd d) := univ ×ˢ (W ×ˢ W) with hOdef
  have hO : IsOpen O := isOpen_univ.prod (hW.prod hW)
  refine ContinuousOn.continuousAt ?_ (hO.mem_nhds ⟨mem_univ _, hx, hy⟩)
  rw [continuousOn_iff_continuous_domRestrict]
  let ψ : O → C(W × W, ℝ≥0∞) × (W × W) := fun p =>
    (p.1.1, (⟨p.1.2.1, p.2.2.1⟩, ⟨p.1.2.2, p.2.2.2⟩))
  have hψ : Continuous ψ := by
    refine (continuous_fst.comp continuous_subtype_val).prodMk (Continuous.prodMk ?_ ?_)
    · exact ((continuous_fst.comp (continuous_snd.comp continuous_subtype_val))).subtype_mk _
    · exact ((continuous_snd.comp (continuous_snd.comp continuous_subtype_val))).subtype_mk _
  have heq : O.domRestrict (fun p : C(W × W, ℝ≥0∞) × Rd d × Rd d => q5Ev p.1 p.2.1 p.2.2) =
      fun p => (ψ p).1 (ψ p).2 := by
    funext p
    simp only [domRestrict_apply]
    exact q5Ev_of_mem _ p.2.2.1 p.2.2.2
  rw [heq]
  exact continuous_eval.comp hψ

/-! ## Closed sets of profiles -/

/-- Pointwise closed conditions define a closed set of profiles. -/
theorem q5_isClosed_forall_mem {W : Set (Rd d)} (C : W × W → Set ℝ≥0∞) (hC : ∀ p, IsClosed (C p)) :
    IsClosed {f : C(W × W, ℝ≥0∞) | ∀ p, f p ∈ C p} := by
  simp only [ofPred_forall]
  exact isClosed_iInter fun p => (hC p).preimage (continuous_eval_const p)

/-- A closed set of profiles has a measurable preimage among length metrics. -/
theorem q5_measurableSet_prof_preimage {W : Set (Rd d)} (hW : IsOpen W) {T : Set C(W × W, ℝ≥0∞)}
    (hT : IsClosed T) : MeasurableSet {G : Q5LenMetric d | q5Prof hW G ∈ T} :=
  hT.measurableSet.preimage (q5_measurable_prof hW)

/-- A closed set of pairs of profiles has a measurable preimage among pairs of length metrics. -/
theorem q5_measurableSet_prof_pair_preimage {W : Set (Rd d)} (hW : IsOpen W)
    {T : Set (C(W × W, ℝ≥0∞) × C(W × W, ℝ≥0∞))} (hT : IsClosed T) :
    MeasurableSet {p : Q5LenMetric d × Q5LenMetric d | (q5Prof hW p.1, q5Prof hW p.2) ∈ T} := by
  have : LocallyCompactSpace W := hW.locallyCompactSpace
  exact hT.measurableSet.preimage
    (((q5_measurable_prof hW).comp measurable_fst).prodMk ((q5_measurable_prof hW).comp measurable_snd))

/-! ## From pairs of length metrics to Borel sets of `ContMetric d × ContMetric d` -/

/-- A measurable set of pairs of length metrics is the trace of a Borel set of pairs of continuous metrics. -/
theorem q5_exists_measurableSet_of_len {P : ContMetric d → ContMetric d → Prop}
    (hP : MeasurableSet {p : Q5LenMetric d × Q5LenMetric d | P p.1.1 p.2.1}) :
    ∃ S : Set (ContMetric d × ContMetric d), MeasurableSet S ∧
      ∀ D E : ContMetric d, D.IsLength → E.IsLength → ((D, E) ∈ S ↔ P D E) := by
  have h : MeasurableSet[MeasurableSpace.comap (Prod.map Subtype.val Subtype.val)
      (inferInstance : MeasurableSpace (ContMetric d × ContMetric d))]
      {p : Q5LenMetric d × Q5LenMetric d | P p.1.1 p.2.1} := by
    rw [Prod.instMeasurableSpace, MeasurableSpace.comap_prodMap]
    exact hP
  obtain ⟨S, hS, hpre⟩ := MeasurableSpace.measurableSet_comap.1 h
  refine ⟨S, hS, fun D E hD hE => ?_⟩
  have hmem := congrArg (fun T : Set (Q5LenMetric d × Q5LenMetric d) =>
    ((⟨D, hD⟩ : Q5LenMetric d), (⟨E, hE⟩ : Q5LenMetric d)) ∈ T) hpre
  simpa using hmem

end HigherDimLQGContinuity
