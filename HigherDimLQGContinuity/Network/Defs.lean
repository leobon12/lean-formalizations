import HigherDimLQGContinuity.Labels.OrderSpec
import HigherDimLQGContinuity.Labels.Realizable

/-! # The finite open-ball network of a site label -/

set_option autoImplicit false
set_option linter.style.haveILetI false

noncomputable section

open Set Metric
open HigherDimLFPP (Rd)

namespace HigherDimLQGContinuity

variable {μ ν r c₁ : ℝ}

/-- Subdivide a Euclidean segment into equal pieces no longer than `ω/100`
when `ω>0`. The endpoints are included. -/
def segmentSampleCount {d : ℕ} (a b : Rd d) (ω : ℝ) : ℕ :=
  max 1 ⌈100 * dist a b / ω⌉₊

/-- The finite set of all subdivision points on a segment. -/
def segmentSamples {d : ℕ} (a b : Rd d) (ω : ℝ) : Finset (Rd d) := by
  classical
  let n := segmentSampleCount a b ω
  exact (Finset.range (n + 1)).image fun (j : ℕ) =>
    a + ((j : ℝ) / n) • (b - a)

/-- Samples of the active segments of a padded lead code. -/
def leadSamples {d Kl N : ℕ} (P : LeadCode d Kl N)
    (ν ω : ℝ) : Finset (Rd d) := by
  classical
  exact (Finset.univ.filter fun j : Fin N => j.val < P.last.val).biUnion
    fun j => segmentSamples (P.point ν j.castSucc) (P.point ν j.succ) ω

/-- The five kinds of balls in a fixed edge of the plateau network. -/
def edgeChamberSites {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge) : Finset (Rd d) := by
  classical
  exact (labelCellIndices (ℓ e).1.chamber).image
    (cellCenter μ (S.edgeCenter e))

def edgeGateSites {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge) (i : Fin 2) :
    Finset (Rd d) := by
  classical
  exact (labelCellIndices (if i = 0 then (ℓ e).1.gate0 else (ℓ e).1.gate1)).image
    (cellCenter μ (S.edgeCenter e))

def edgeRetainedSamples {d Kc Kl N : ℕ} {S : SiteData d}
    (_ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge) (i : Fin 2)
    (ω : ℝ) : Finset (Rd d) :=
  segmentSamples (S.vertexPoint (S.retainedVertex e i)) (S.port e i) ω

def edgeLeadSamples {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge) (i : Fin 2)
    (ω : ℝ) : Finset (Rd d) :=
  leadSamples (if i = 0 then (ℓ e).1.lead0 else (ℓ e).1.lead1) ν ω

/-- All finite centres for edge `e`, with their radii. Duplicate balls are
removed by the finset representation. -/
def edgeBallSpecs {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge)
    (g ω : ℝ) : Finset (Rd d × ℝ) := by
  classical
  exact ((edgeChamberSites ℓ e).image fun x => (x, ω)) ∪
    ((edgeGateSites ℓ e 0).image fun x => (x, g)) ∪
    ((edgeGateSites ℓ e 1).image fun x => (x, g)) ∪
    ((edgeRetainedSamples ℓ e 0 ω).image fun x => (x, ω)) ∪
    ((edgeRetainedSamples ℓ e 1 ω).image fun x => (x, ω)) ∪
    ((edgeLeadSamples ℓ e 0 ω).image fun x => (x, ω)) ∪
    ((edgeLeadSamples ℓ e 1 ω).image fun x => (x, ω))

/-- All balls in the network. -/
def labelBallSpecs {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (g ω : ℝ) :
    Finset (Rd d × ℝ) := by
  classical
  letI : Fintype S.Vertex := (siteMesh_vertices_finite S.mesh.δm_pos).fintype
  letI : Fintype S.Edge := Fintype.ofFinite S.Edge
  exact Finset.univ.biUnion fun e : S.Edge => edgeBallSpecs ℓ e g ω

/-- A node is a vertex tube, an initial gate, a chamber, or a terminal gate. -/
abbrev NetworkNode {d : ℕ} (S : SiteData d) :=
  S.Vertex ⊕ (S.Edge × Fin 3)

/-- The concrete network data consumed by the certificate construction. -/
structure SiteNetwork {d : ℕ} (S : SiteData d) where
  Uo : Set (Rd d)
  U : Set (Rd d)
  Node : NetworkNode S → Set (Rd d)
  N : Set (NetworkNode S)
  adj : SimpleGraph (NetworkNode S)
  gate0 : S.Edge → Set (Rd d)
  gate1 : S.Edge → Set (Rd d)

/-- The open and closed balls generated by a finite family of centre-radius
pairs. -/
def openBallSpecs {d : ℕ} (F : Finset (Rd d × ℝ)) : Set (Rd d) :=
  ⋃ p ∈ F, ball p.1 p.2

def closedBallSpecs {d : ℕ} (F : Finset (Rd d × ℝ)) : Set (Rd d) :=
  ⋃ p ∈ F, closedBall p.1 p.2

/-- The gate union attached to one side of an edge. -/
def edgeGateClosed {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (e : S.Edge) (i : Fin 2)
    (g : ℝ) : Set (Rd d) :=
  ballUnion μ (S.edgeCenter e)
    (labelCellIndices (if i = 0 then (ℓ e).1.gate0 else (ℓ e).1.gate1)) g

/-- The open vertex tube before the gates are excised. -/
def vertexTubeClosed {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (ω : ℝ) (v : S.Vertex) :
    Set (Rd d) := by
  classical
  letI : Fintype S.Vertex := (siteMesh_vertices_finite S.mesh.δm_pos).fintype
  letI : Fintype S.Edge := Fintype.ofFinite S.Edge
  exact ⋃ e : S.Edge, ⋃ i : Fin 2,
    if S.retainedVertex e i = v then
      closedBallSpecs (((edgeRetainedSamples ℓ e i ω) ∪
        (edgeLeadSamples ℓ e i ω)).image fun x => (x, ω)) else ∅

/-- The chamber node before the gates are excised. -/
def edgeChamberClosed {d Kc Kl N : ℕ} {S : SiteData d}
    (ℓ : SiteLabel S Kc Kl N μ ν r c₁) (ω : ℝ) (e : S.Edge) :
    Set (Rd d) :=
  closedBallSpecs ((edgeChamberSites ℓ e).image fun x => (x, ω))

/-- The adjacency relation of the subdivided incidence tree. -/
def networkIncidence {d : ℕ} (S : SiteData d) :
    NetworkNode S → NetworkNode S → Prop
  | Sum.inl v, Sum.inr (e, 0) => v = S.edgeLeft e
  | Sum.inl v, Sum.inr (e, 2) => v = S.edgeRight e
  | Sum.inr (e, 0), Sum.inr (f, 1) => e = f
  | Sum.inr (e, 2), Sum.inr (f, 1) => e = f
  | _, _ => False

/-- Definition of the label network: a finite open-ball core and its finite
closed-ball closure, with closed nodes and the subdivided incidence graph. -/
def labelNet {d : ℕ} (S : SiteData d) (C : SiteConsts)
    {Kc Kl : ℕ}
    (ℓ : SiteLabel S Kc Kl C.N C.μ C.ν C.r (Routing.gpC1 4)) :
    SiteNetwork S := by
  classical
  let F := labelBallSpecs ℓ C.g C.ω
  let gates : Set (Rd d) := ⋃ e : S.Edge, ⋃ i : Fin 2,
    interior (edgeGateClosed ℓ e i C.g)
  exact {
    Uo := openBallSpecs F
    U := closedBallSpecs F
    Node := fun n => match n with
      | Sum.inl v => vertexTubeClosed ℓ C.ω v \ gates
      | Sum.inr (e, 0) => edgeGateClosed ℓ e 0 C.g
      | Sum.inr (e, 1) => edgeChamberClosed ℓ C.ω e \ gates
      | Sum.inr (e, 2) => edgeGateClosed ℓ e 1 C.g
    N := Set.univ
    adj := SimpleGraph.fromRel (networkIncidence S)
    gate0 := fun e => edgeGateClosed ℓ e 0 C.g
    gate1 := fun e => edgeGateClosed ℓ e 1 C.g
  }

end HigherDimLQGContinuity
