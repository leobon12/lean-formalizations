import HigherDimLQGMetric.LGF.Invariance
import QuantumZipper.Proofs.LQG.WedgeRestriction
import Mathlib.MeasureTheory.Constructions.Projective

/-!
# Law transfer for the whole-space LGF (packet F2, target 2)

Source: `source/higher-dimensional-lqg-metric.pdf` l. 50–57 ([1] (1.1), §1.1: an LGF is determined
in law modulo additive constants by its covariance); MA0 §5.2 block A1 ("law transfer"), MA3 D-LT
(`NormalizedLawUnique`), MA0 P8.

* `pairProc h ω = (⟨h ω, φ⟩)_{φ ∈ TestRd0 d}`, the process of mean-zero pairings;
* `IsWholeSpaceLGF.map_pairProc_eq` (**law transfer**): any two whole-space LGFs, on any two
  probability spaces, have the same law of mean-zero pairings on the product σ-algebra; equivalently
  (`map_comp_eq_of_sigma0`) every map that is measurable for the σ-algebra `sigma0` generated by the
  mean-zero pairings has the same image law under any two LGFs;
* `IsWholeSpaceLGF.map_id`: the law `P.map h` of an LGF is the law of an LGF on `𝒟'(ℝ^d)` (canonical
  realization `id`);
* recentering by a mean-one test function, `recenter ρ g = g − ⟨g, ρ⟩` (`sigma0`-measurable);
* `map_eq_of_normalized`, `map_eq_of_normalized_ae`: two LGFs normalized by the same measurable
  functional `N` (equivariant under adding constants, at least almost surely at the fields) have the
  same law on `𝒟'(ℝ^d)`.

Port of LQGMetric's `Field/GFFLaw.lean` (`map_pairProc_eq`, `map_comp_eq_of_sigma0`, `recenter`,
`map_eq_of_normalized(_ae)`) from `ℂ` to `ℝ^d` (ruling M10). Proof of the law transfer: finite-
dimensional laws are centered Gaussian vectors with the same covariance
(`QuantumZipper.WedgeRes.map_eq_of_gaussian_vec`), and a measure on a product is determined by its
finite-dimensional marginals (Mathlib `IsProjectiveLimit.unique`).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set

namespace HigherDimLQGMetric

open HigherDimLFPP (Rd)

variable {d : ℕ} {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
  {P' : Measure Ω'}

/-! ## The process of mean-zero pairings -/

/-- The process of mean-zero pairings `(⟨h ω, φ⟩)_{φ ∈ TestRd0 d}` of a random distribution. -/
def pairProc (h : Ω → DistRd d) (ω : Ω) : TestRd0 d → ℝ := fun φ => h ω φ.1

theorem measurable_pairProc {h : Ω → DistRd d} (hh : Measurable h) : Measurable (pairProc h) :=
  measurable_pi_iff.2 fun φ => (measurable_distOn_apply φ.1).comp hh

/-- **Law transfer** (target 2): two whole-space LGFs (on possibly different probability spaces)
have the same law of mean-zero pairings `(⟨h, φ⟩)_{φ ∈ TestRd0 d}` on the product σ-algebra, i.e.
the same law modulo additive constants. -/
theorem IsWholeSpaceLGF.map_pairProc_eq {h : Ω → DistRd d} {h' : Ω' → DistRd d}
    (hh : IsWholeSpaceLGF h P) (hh' : IsWholeSpaceLGF h' P') :
    P.map (pairProc h) = P'.map (pairProc h') := by
  have := hh.gaussian.isProbabilityMeasure
  have := hh'.gaussian.isProbabilityMeasure
  have hfin : ∀ I : Finset (TestRd0 d), (P.map (pairProc h)).map I.restrict =
      (P'.map (pairProc h')).map I.restrict := by
    intro I
    rw [Measure.map_map (Finset.measurable_restrict I) (measurable_pairProc hh.measurable),
      Measure.map_map (Finset.measurable_restrict I) (measurable_pairProc hh'.measurable)]
    exact QuantumZipper.WedgeRes.map_eq_of_gaussian_vec
      (U := fun (i : I) ω => h ω i.1.1) (V := fun (i : I) ω => h' ω i.1.1)
      (hh.gaussian.hasGaussianLaw I) (hh'.gaussian.hasGaussianLaw I)
      (fun i => (measurable_distOn_apply _).comp hh.measurable)
      (fun i => (measurable_distOn_apply _).comp hh'.measurable)
      (fun i => (hh.gaussian.hasGaussianLaw_eval i.1).memLp_two)
      (fun i => (hh'.gaussian.hasGaussianLaw_eval i.1).memLp_two)
      (fun i => hh.centered i.1) (fun i => hh'.centered i.1)
      (fun i j => by rw [hh.covariance_eq, hh'.covariance_eq])
  exact IsProjectiveLimit.unique (P := fun I => (P'.map (pairProc h')).map I.restrict)
    hfin (fun _ => rfl)

/-! ## The canonical realization -/

/-- The law of a whole-space LGF is the law of a whole-space LGF on `𝒟'(ℝ^d)` (realized by `id`). -/
theorem IsWholeSpaceLGF.map_id {h : Ω → DistRd d} (hh : IsWholeSpaceLGF h P) :
    IsWholeSpaceLGF (id : DistRd d → DistRd d) (P.map h) where
  measurable := measurable_id
  gaussian := by
    refine ⟨fun I => ?_⟩
    have hX : Measurable fun k : DistRd d => I.restrict fun φ : TestRd0 d => id k φ.1 :=
      measurable_pi_iff.2 fun i => measurable_distOn_apply _
    have h1 := hh.gaussian.hasGaussianLaw I
    refine ⟨hX.aemeasurable, ?_⟩
    rw [Measure.map_map hX hh.measurable]
    exact h1.isGaussian_map
  centered := fun φ => by
    show ∫ k, k φ.1 ∂(P.map h) = 0
    rw [integral_map hh.measurable.aemeasurable
      (measurable_distOn_apply φ.1).aestronglyMeasurable]
    exact hh.centered φ
  covariance_eq := fun φ ψ => by
    show cov[fun k : DistRd d => k φ.1, fun k : DistRd d => k ψ.1; P.map h] = _
    rw [covariance_map (measurable_distOn_apply φ.1).aestronglyMeasurable
      (measurable_distOn_apply ψ.1).aestronglyMeasurable hh.measurable.aemeasurable]
    exact hh.covariance_eq φ ψ

/-! ## The σ-algebra of mean-zero pairings on `𝒟'(ℝ^d)` -/

/-- The mean-zero pairings of a distribution. -/
def ev0 (g : DistRd d) : TestRd0 d → ℝ := fun φ => g φ.1

/-- The σ-algebra on `𝒟'(ℝ^d)` generated by the mean-zero pairings (the field modulo constants). -/
@[instance_reducible]
def sigma0 (d : ℕ) : MeasurableSpace (DistRd d) := MeasurableSpace.comap ev0 MeasurableSpace.pi

theorem sigma0_le : sigma0 d ≤ (inferInstance : MeasurableSpace (DistRd d)) := by
  rw [sigma0, ← measurable_iff_comap_le]
  exact measurable_pi_iff.2 fun φ => measurable_distOn_apply φ.1

theorem measurable_ev0_sigma0 : Measurable[sigma0 d] (ev0 (d := d)) := fun _ hs => ⟨_, hs, rfl⟩

/-- **Law transfer for `sigma0`-measurable maps**: any map out of `(𝒟'(ℝ^d), sigma0)` has the same
image law under two whole-space LGFs. -/
theorem map_comp_eq_of_sigma0 {β : Type*} [MeasurableSpace β] {F : DistRd d → β}
    (hF : Measurable[sigma0 d] F) {h : Ω → DistRd d} {h' : Ω' → DistRd d}
    (hh : IsWholeSpaceLGF h P) (hh' : IsWholeSpaceLGF h' P') :
    P.map (F ∘ h) = P'.map (F ∘ h') := by
  have hFm : Measurable F := hF.mono sigma0_le le_rfl
  ext S hS
  rw [Measure.map_apply (hFm.comp hh.measurable) hS,
    Measure.map_apply (hFm.comp hh'.measurable) hS]
  obtain ⟨T, hT, hTS⟩ := hF hS
  have e1 : F ∘ h ⁻¹' S = pairProc h ⁻¹' T := by
    rw [preimage_comp, ← hTS]; rfl
  have e2 : F ∘ h' ⁻¹' S = pairProc h' ⁻¹' T := by
    rw [preimage_comp, ← hTS]; rfl
  rw [e1, e2, ← Measure.map_apply (measurable_pairProc hh.measurable) hT,
    ← Measure.map_apply (measurable_pairProc hh'.measurable) hT, hh.map_pairProc_eq hh']

theorem map_indicator_one_apply {Ω'' : Type*} [MeasurableSpace Ω''] (Q : Measure Ω'')
    {S : Set (DistRd d)} (hS : MeasurableSet S) {k : Ω'' → DistRd d} (hk : Measurable k) :
    (Q.map ((S.indicator fun _ => (1 : ℝ)) ∘ k)) {1} = Q (k ⁻¹' S) := by
  have hm : Measurable (S.indicator fun _ => (1 : ℝ)) := measurable_const.indicator hS
  rw [Measure.map_apply (hm.comp hk) (measurableSet_singleton 1)]
  congr 1
  ext ω
  simp only [mem_preimage, Function.comp_apply, mem_singleton_iff]
  by_cases hω : k ω ∈ S
  · simp [hω]
  · simp [hω]

/-- Events of `sigma0` have the same probability under two whole-space LGFs. -/
theorem measure_preimage_eq_of_sigma0 {S : Set (DistRd d)} (hS : MeasurableSet[sigma0 d] S)
    {h : Ω → DistRd d} {h' : Ω' → DistRd d} (hh : IsWholeSpaceLGF h P)
    (hh' : IsWholeSpaceLGF h' P') : P (h ⁻¹' S) = P' (h' ⁻¹' S) := by
  have hSm : MeasurableSet S := sigma0_le S hS
  have hind : Measurable[sigma0 d] (S.indicator fun _ => (1 : ℝ)) :=
    measurable_const.indicator hS
  rw [← map_indicator_one_apply P hSm hh.measurable,
    ← map_indicator_one_apply P' hSm hh'.measurable, map_comp_eq_of_sigma0 hind hh hh']

/-! ## Recentering by a mean-one test function -/

/-- `g − ⟨g, ρ⟩` -/
def recenter (ρ : TestRd d) (g : DistRd d) : DistRd d := addConst g (-(g ρ))

theorem integral_sub_smul_eq_zero {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) (φ : TestRd d) :
    ∫ x, (φ - (∫ x, φ x) • ρ) x = 0 := by
  have e : ∀ x, (φ - (∫ x, φ x) • ρ) x = φ x - (∫ x, φ x) * ρ x := fun x => by
    simp only [sub_apply, smul_apply, smul_eq_mul]
  simp_rw [e]
  rw [integral_sub (integrable_testOn φ) ((integrable_testOn ρ).const_mul _), integral_const_mul,
    hρ, mul_one, sub_self]

/-- `φ − (∫ φ) ρ` as a mean-zero test function (`∫ ρ = 1`). -/
def subMean {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) (φ : TestRd d) : TestRd0 d :=
  ⟨φ - (∫ x, φ x) • ρ, integral_sub_smul_eq_zero hρ φ⟩

theorem recenter_apply (ρ : TestRd d) (g : DistRd d) (φ : TestRd d) :
    recenter ρ g φ = g (φ - (∫ x, φ x) • ρ) := by
  rw [recenter, addConst_apply, map_sub, map_smul, smul_eq_mul]
  ring

theorem measurable_recenter_sigma0 {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) :
    Measurable[sigma0 d] (recenter ρ) := by
  refine (@measurable_distOn_iff d ⊤ (DistRd d) (sigma0 d) (recenter ρ)).2 fun φ => ?_
  have e : (fun g : DistRd d => recenter ρ g φ) = fun g => ev0 g (subMean hρ φ) := by
    funext g
    rw [recenter_apply]
    rfl
  rw [e]
  exact (measurable_pi_apply (subMean hρ φ)).comp measurable_ev0_sigma0

theorem recenter_addConst {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) (g : DistRd d) (c : ℝ) :
    recenter ρ (addConst g c) = recenter ρ g := by
  ext φ
  rw [recenter_apply, recenter_apply, addConst_apply, integral_sub_smul_eq_zero hρ, mul_zero,
    add_zero]

theorem map_congr_fix {N : DistRd d → ℝ} {F : DistRd d → DistRd d} (hF : ∀ g, N g = 0 → F g = g)
    {h : Ω → DistRd d} (hn : ∀ᵐ ω ∂P, N (h ω) = 0) : P.map h = P.map (F ∘ h) :=
  Measure.map_congr (by filter_upwards [hn] with ω hω using (hF _ hω).symm)

/-- **Uniqueness of the law of a normalized LGF** for a measurable normalization functional `N`
with `N (g + c) = N g + c`: two whole-space LGFs with `N(h) = 0` a.s. have the same law on
`𝒟'(ℝ^d)`. -/
theorem map_eq_of_normalized {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) {N : DistRd d → ℝ}
    (hNm : Measurable N) (hN : ∀ g c, N (addConst g c) = N g + c) {h : Ω → DistRd d}
    {h' : Ω' → DistRd d} (hh : IsWholeSpaceLGF h P) (hh' : IsWholeSpaceLGF h' P')
    (hn : ∀ᵐ ω ∂P, N (h ω) = 0) (hn' : ∀ᵐ ω ∂P', N (h' ω) = 0) : P.map h = P'.map h' := by
  let K : DistRd d → DistRd d := fun g => addConst g (-(N g))
  have hK : Measurable K :=
    Measurable.addConst (d := d) measurable_id hNm.neg
  have key : ∀ g, K (recenter ρ g) = addConst g (-(N g)) := by
    intro g
    simp only [K, recenter, hN, addConst_addConst]
    congr 1
    ring
  have hF : Measurable[sigma0 d] (K ∘ recenter ρ) :=
    hK.comp (measurable_recenter_sigma0 hρ)
  have hfix : ∀ g, N g = 0 → (K ∘ recenter ρ) g = g := fun g hg => by
    simp only [Function.comp_apply, key, hg, neg_zero, addConst_zero]
  rw [map_congr_fix hfix hn, map_congr_fix hfix hn', map_comp_eq_of_sigma0 hF hh hh']

/-- The equivariant modification `N̂ g = ⟨g, ρ⟩ + N(g − ⟨g, ρ⟩)` of a normalization `N`. -/
def equivNorm (ρ : TestRd d) (N : DistRd d → ℝ) (g : DistRd d) : ℝ := g ρ + N (recenter ρ g)

theorem equivNorm_addConst {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) (N : DistRd d → ℝ) (g : DistRd d)
    (c : ℝ) : equivNorm ρ N (addConst g c) = equivNorm ρ N g + c := by
  rw [equivNorm, equivNorm, recenter_addConst hρ, addConst_apply, hρ, mul_one]
  ring

theorem equivNorm_eq {ρ : TestRd d} {N : DistRd d → ℝ} {g : DistRd d}
    (hg : ∀ c, N (addConst g c) = N g + c) : equivNorm ρ N g = N g := by
  rw [equivNorm, recenter, hg]
  ring

theorem measurable_equivNorm {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) {N : DistRd d → ℝ}
    (hNm : Measurable N) : Measurable (equivNorm ρ N) :=
  (measurable_distOn_apply ρ).add
    (hNm.comp ((measurable_recenter_sigma0 hρ).mono sigma0_le le_rfl))

/-- `map_eq_of_normalized` when `N (g + c) = N g + c` is only known at the fields, almost surely
(the situation of the sphere average `N g = g_1(0)`, a limit with a junk value). -/
theorem map_eq_of_normalized_ae {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) {N : DistRd d → ℝ}
    (hNm : Measurable N) {h : Ω → DistRd d} {h' : Ω' → DistRd d} (hh : IsWholeSpaceLGF h P)
    (hh' : IsWholeSpaceLGF h' P')
    (hN : ∀ᵐ ω ∂P, ∀ c, N (addConst (h ω) c) = N (h ω) + c)
    (hN' : ∀ᵐ ω ∂P', ∀ c, N (addConst (h' ω) c) = N (h' ω) + c)
    (hn : ∀ᵐ ω ∂P, N (h ω) = 0) (hn' : ∀ᵐ ω ∂P', N (h' ω) = 0) : P.map h = P'.map h' := by
  refine map_eq_of_normalized hρ (measurable_equivNorm hρ hNm) (equivNorm_addConst hρ N) hh hh'
    ?_ ?_
  · filter_upwards [hN, hn] with ω h1 h2 using (equivNorm_eq h1).trans h2
  · filter_upwards [hN', hn'] with ω h1 h2 using (equivNorm_eq h1).trans h2

/-! ## Affine invariance in law -/

/-- **Scale and translation invariance in law** (targets 2–3): for `r > 0` the mean-zero pairings of
`h(r · + z)` have the same law as those of `h`. -/
theorem IsWholeSpaceLGF.map_pairProc_affineComp {h : Ω → DistRd d} (hh : IsWholeSpaceLGF h P)
    {r : ℝ} (hr : 0 < r) (z : Rd d) :
    P.map (pairProc fun ω => HigherDimLQGMetric.affineComp r z (h ω)) = P.map (pairProc h) :=
  (hh.affineComp hr z).map_pairProc_eq hh

/-- `h(r · + z) − N(h(r · + z))` has the law of `h`, for a whole-space LGF normalized by a
measurable equivariant functional `N` (`N(h) = 0` a.s.). -/
theorem map_affine_normalized {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) {N : DistRd d → ℝ}
    (hNm : Measurable N) (hN : ∀ g c, N (addConst g c) = N g + c) {h : Ω → DistRd d}
    (hh : IsWholeSpaceLGF h P) (hn : ∀ᵐ ω ∂P, N (h ω) = 0) {r : ℝ} (hr : 0 < r) (z : Rd d) :
    P.map (fun ω => addConst (affineComp r z (h ω)) (-(N (affineComp r z (h ω))))) =
      P.map h := by
  have h1 := hh.affineComp hr z
  have h2 := h1.addConst (hNm.comp h1.measurable).neg
  refine map_eq_of_normalized hρ hNm hN h2 hh (ae_of_all _ fun ω => ?_) hn
  simp only [hN, add_neg_cancel]

/-- `map_affine_normalized` when `N` is equivariant only at the fields, almost surely (e.g. the
sphere average `N g = g_1(0)` once its a.s. convergence is known, packet F3). -/
theorem map_affine_normalized_ae {ρ : TestRd d} (hρ : ∫ x, ρ x = 1) {N : DistRd d → ℝ}
    (hNm : Measurable N) {h : Ω → DistRd d} (hh : IsWholeSpaceLGF h P)
    (hN : ∀ᵐ ω ∂P, ∀ c, N (addConst (h ω) c) = N (h ω) + c) (hn : ∀ᵐ ω ∂P, N (h ω) = 0)
    {r : ℝ} (hr : 0 < r) (z : Rd d)
    (hNr : ∀ᵐ ω ∂P, ∀ c, N (addConst (affineComp r z (h ω)) c) =
      N (affineComp r z (h ω)) + c) :
    P.map (fun ω => addConst (affineComp r z (h ω)) (-(N (affineComp r z (h ω))))) =
      P.map h := by
  have h1 := hh.affineComp hr z
  have h2 := h1.addConst (hNm.comp h1.measurable).neg
  refine map_eq_of_normalized_ae hρ hNm h2 hh ?_ hN ?_ hn
  · filter_upwards [hNr] with ω hω c
    simp only [addConst_addConst, hω]
    ring
  · filter_upwards [hNr] with ω hω
    simp only [hω, add_neg_cancel]

end HigherDimLQGMetric
