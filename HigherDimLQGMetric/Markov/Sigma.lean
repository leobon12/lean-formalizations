import HigherDimLQGMetric.Markov.Defs
import HigherDimLQGMetric.Field.SphereBump

/-!
# Sigma algebras used in the open-set Markov decomposition

The cylinder sigma algebra of a restriction is generated by its test-function pairings. A sphere
average whose sphere is inside the open set is measurable for this sigma algebra.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory TopologicalSpace

namespace HigherDimLQGMetric

open HigherDimLFPP (Rd)

variable {d : ℕ} {Ω : Type*}

/-- The restrictions' cylinder sigma algebra is generated by all of its pairings. -/
theorem markov_fieldSigmaRd_eq_iSup (h : Ω → DistRd d) (V : Opens (Rd d)) :
    fieldSigmaRd h V =
      ⨆ φ : TestOn V, MeasurableSpace.comap (fun ω => restrictTo V (h ω) φ) inferInstance := by
  simp only [fieldSigmaRd, DistOn.measurableSpace, MeasurableSpace.pi,
    MeasurableSpace.comap_comp, MeasurableSpace.comap_iSup]
  rfl

/-- The chosen normalizing sphere average is measurable from the restriction to `V`. -/
theorem markov_measurable_sphereAvg_fieldSigmaRd [MeasurableSpace Ω]
    (h : Ω → DistRd d) (V : Opens (Rd d)) (z : Rd d) (r : ℝ)
    (hr : 0 < r) (hV : Metric.sphere z r ⊆ V) :
    Measurable[fieldSigmaRd h V] (fun ω => sphereAvg (h ω) r z) := by
  obtain ⟨F, hFm, hF⟩ := exists_measurable_sphereAvg_eq_restrictTo
    (U := V) (r := r) (z := z) (by simpa only [abs_of_pos hr] using hV)
  have hm : Measurable[fieldSigmaRd h V] (fun ω => restrictTo V (h ω)) :=
    comap_measurable _
  have he : (fun ω => sphereAvg (h ω) r z) = F ∘ (fun ω => restrictTo V (h ω)) := by
    funext ω
    exact hF (h ω)
  rw [he]
  exact hFm.comp hm

end HigherDimLQGMetric
