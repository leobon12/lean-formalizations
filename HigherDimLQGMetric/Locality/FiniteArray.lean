import HigherDimLQGMetric.Locality.JointIndep
import HigherDimLQGMetric.B3.Interfaces
import LQGMetric.Prob.PolishContinuousMap

/-! Sigma algebras generated by finite dependent arrays. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option linter.style.haveILetI false

noncomputable section

namespace HigherDimLQGMetric

open HigherDimLFPP (Rd)

theorem l7a_polish_finite_internal_array {d : ℕ} {ι : Type*}
    (S : Finset ι) (W : ι → TopologicalSpace.Opens (Rd d)) :
    PolishSpace (∀ i : S,
      C((W i.1 : Set (Rd d)) × (W i.1 : Set (Rd d)), ℝ)) := by
  letI (i : S) : LocallyCompactSpace (W i.1 : Set (Rd d)) :=
    (W i.1).isOpen.locallyCompactSpace
  letI (i : S) : PolishSpace
      C((W i.1 : Set (Rd d)) × (W i.1 : Set (Rd d)), ℝ) :=
    LQGMetric.polishSpace_continuousMap _ _
  infer_instance

theorem l7a_finite_array_sigma
    {ι Ω : Type*} {B : ι → Type*} [∀ i, MeasurableSpace (B i)]
    (S : Finset ι) (Y : ∀ i : S, Ω → B i.1) :
    MeasurableSpace.comap (fun ω i => Y i ω) inferInstance =
      ⨆ i ∈ S, MeasurableSpace.comap (Y ⟨i, ‹i ∈ S›⟩) inferInstance := by
  rw [MeasurableSpace.comap_process_pi]
  rw [iSup_subtype']

end HigherDimLQGMetric
