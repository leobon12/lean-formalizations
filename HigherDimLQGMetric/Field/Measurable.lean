import HigherDimLQGMetric.Field.Affine
import HigherDimLQGMetric.Frozen.DistOnMeasurableSpace
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
import Mathlib.MeasureTheory.Integral.Prod
import Mathlib.Topology.ContinuousMap.SecondCountableSpace

/-!
# Measurability of the field operations for the cylinder σ-algebras

Packet F1. Port of LQGMetric's `lqg_metric/LQGMetric/Field/Measurable.lean`
(`measurable_distOn_apply`,
`measurable_distOn_iff`, `measurable_restrictTo`, `measurable_affineComp`,
`measurable_ofCont_apply`, `measurable_addFun`) and `Papers/GM/S1/Dilate.lean`
(`measurable_dilDist`) from `ℂ` to `Rd d` (ruling M10).

The σ-algebra on `𝒟'(U)` is the frozen cylinder σ-algebra `DistOn.measurableSpace U`, generated by
the pairings `h ↦ ⟨h, φ⟩`, `φ ∈ 𝓓(U)` (`distOn_measurableSpace_eq_iSup`). Hence a map into
`𝒟'(U)` is measurable iff all its pairings are (`measurable_distOn_iff`). With this:

* `𝒟'(U)` has measurable addition, negation, subtraction and scalar multiplication (instances
  `MeasurableAdd₂`, `MeasurableNeg`, `MeasurableSub₂`, `MeasurableSMul₂ ℝ`);
* `restrictTo U`, `restrictOn`, `affineComp r z`, `distAffine` are measurable;
* `ofCont : C(ℝ^d, ℝ) → 𝒟'(ℝ^d)` is measurable (Borel σ-algebra of the compact-open topology),
  `addFun` is jointly measurable in `(h, f)`, `addConst` jointly in `(h, c)`;
* `affineCompMeasurableEquiv`: `h ↦ h(r·+z)` is a measurable equivalence for `r ≠ 0`.

Standard facts, own elementary proofs (as in the 2D layer).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Set Function TopologicalSpace
open scoped Distributions

namespace HigherDimLQGMetric

open HigherDimLFPP (Rd)

variable {d : ℕ}

/-! ### Pairings generate the σ-algebra -/

theorem measurable_distOn_apply {U : Opens (Rd d)} (φ : TestOn U) :
    Measurable fun h : DistOn U => h φ :=
  (measurable_pi_apply φ).comp (measurable_iff_comap_le.2 le_rfl)

/-- A map into `𝒟'(U)` is measurable iff all its pairings with test functions are. -/
theorem measurable_distOn_iff {U : Opens (Rd d)} {α : Type*} [MeasurableSpace α]
    {g : α → DistOn U} : Measurable g ↔ ∀ φ : TestOn U, Measurable fun a => g a φ := by
  refine ⟨fun hg φ => (measurable_distOn_apply φ).comp hg, fun hg => ?_⟩
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap g (MeasurableSpace.comap _ MeasurableSpace.pi) ≤ _
  rw [MeasurableSpace.comap_comp]
  exact (measurable_pi_iff.2 hg).comap_le

/-- The cylinder σ-algebra is the σ-algebra generated by the pairings. -/
theorem distOn_measurableSpace_eq_iSup (U : Opens (Rd d)) :
    DistOn.measurableSpace U =
      ⨆ φ : TestOn U, MeasurableSpace.comap (fun h : DistOn U => h φ) inferInstance := by
  rw [DistOn.measurableSpace, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp]
  rfl

theorem measurableSet_preimage_apply {U : Opens (Rd d)} (φ : TestOn U) {s : Set ℝ}
    (hs : MeasurableSet s) : MeasurableSet {h : DistOn U | h φ ∈ s} :=
  measurable_distOn_apply φ hs

/-! ### Algebraic operations on `𝒟'(U)` -/

instance instMeasurableAdd₂DistOn {U : Opens (Rd d)} : MeasurableAdd₂ (DistOn U) :=
  ⟨measurable_distOn_iff.2 fun φ => by
    simp only [add_apply]
    exact ((measurable_distOn_apply φ).comp measurable_fst).add
      ((measurable_distOn_apply φ).comp measurable_snd)⟩

instance instMeasurableNegDistOn {U : Opens (Rd d)} : MeasurableNeg (DistOn U) :=
  ⟨measurable_distOn_iff.2 fun φ => by
    simp only [neg_apply]
    exact (measurable_distOn_apply φ).neg⟩

instance instMeasurableSub₂DistOn {U : Opens (Rd d)} : MeasurableSub₂ (DistOn U) :=
  ⟨measurable_distOn_iff.2 fun φ => by
    simp only [sub_apply]
    exact ((measurable_distOn_apply φ).comp measurable_fst).sub
      ((measurable_distOn_apply φ).comp measurable_snd)⟩

instance instMeasurableSMul₂DistOn {U : Opens (Rd d)} : MeasurableSMul₂ ℝ (DistOn U) :=
  ⟨measurable_distOn_iff.2 fun φ => by
    simp only [uncurry, smul_apply, smul_eq_mul]
    exact measurable_fst.mul ((measurable_distOn_apply φ).comp measurable_snd)⟩

/-! ### Restriction, affine pullback -/

theorem measurable_restrictTo (U : Opens (Rd d)) : Measurable (restrictTo U) :=
  measurable_distOn_iff.2 fun _ => measurable_distOn_apply _

theorem measurable_restrictOn {U V : Opens (Rd d)} (hVU : V ≤ U) :
    Measurable (restrictOn hVU) :=
  measurable_distOn_iff.2 fun _ => measurable_distOn_apply _

theorem measurable_affineComp (r : ℝ) (z : Rd d) : Measurable (affineComp (d := d) r z) :=
  measurable_distOn_iff.2 fun φ =>
    (measurable_distOn_apply (testAffinePull r z φ)).const_mul ((r ^ d)⁻¹)

theorem measurable_distAffine {r : ℝ} (hr : r ≠ 0) (z : Rd d) (V : Opens (Rd d)) :
    Measurable (distAffine (V := V) hr z) :=
  measurable_distOn_iff.2 fun φ =>
    (measurable_distOn_apply (testPullOn hr z V φ)).const_mul ((r ^ d)⁻¹)

/-- `h ↦ h(r·+z)` as a measurable equivalence (`r ≠ 0`). -/
def affineCompMeasurableEquiv {r : ℝ} (hr : r ≠ 0) (z : Rd d) : DistRd d ≃ᵐ DistRd d where
  toFun := affineComp r z
  invFun := affineComp r⁻¹ (-(r⁻¹ • z))
  left_inv := affineComp_inv_affineComp hr z
  right_inv := affineComp_affineComp_inv hr z
  measurable_toFun := measurable_affineComp r z
  measurable_invFun := measurable_affineComp _ _

@[simp]
theorem coe_affineCompMeasurableEquiv {r : ℝ} (hr : r ≠ 0) (z : Rd d) :
    ⇑(affineCompMeasurableEquiv hr z) = affineComp r z := rfl

/-! ### Continuous functions as distributions -/

theorem measurable_ofCont_apply (φ : TestRd d) : Measurable fun f : C(Rd d, ℝ) => ofCont f φ := by
  simp_rw [ofCont_apply]
  have hc : Continuous fun p : C(Rd d, ℝ) × Rd d => φ p.2 * p.1 p.2 :=
    (φ.continuous.comp continuous_snd).mul continuous_eval
  exact (hc.measurable.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

theorem measurable_ofCont : Measurable (ofCont : C(Rd d, ℝ) → DistRd d) :=
  measurable_distOn_iff.2 measurable_ofCont_apply

theorem measurable_addFun : Measurable fun p : DistRd d × C(Rd d, ℝ) => addFun p.1 p.2 :=
  measurable_fst.add (measurable_ofCont.comp measurable_snd)

theorem measurable_addFun_left (f : C(Rd d, ℝ)) : Measurable fun h : DistRd d => addFun h f :=
  measurable_addFun.comp (measurable_id.prodMk measurable_const)

theorem measurable_addFun_right (h : DistRd d) : Measurable (addFun h) :=
  measurable_addFun.comp (measurable_const.prodMk measurable_id)

theorem measurable_const_continuousMap :
    Measurable fun c : ℝ => ContinuousMap.const (Rd d) c :=
  ContinuousMap.continuous_const'.measurable

theorem measurable_addConst : Measurable fun p : DistRd d × ℝ => addConst p.1 p.2 :=
  measurable_addFun.comp
    (measurable_fst.prodMk (measurable_const_continuousMap.comp measurable_snd))

theorem measurable_addConst_left (c : ℝ) : Measurable fun h : DistRd d => addConst h c :=
  measurable_addFun_left _

/-- Precomposition with `x ↦ r x + z` is measurable on `C(ℝ^d, ℝ)`. -/
theorem measurable_comp_affinePt (r : ℝ) (z : Rd d) :
    Measurable fun f : C(Rd d, ℝ) => f.comp (affinePt r z) :=
  (ContinuousMap.continuous_precomp _).measurable

/-! ### Random fields -/

section Random

variable {α : Type*} [MeasurableSpace α]

theorem Measurable.addFun {h : α → DistRd d} {f : α → C(Rd d, ℝ)} (hh : Measurable h)
    (hf : Measurable f) : Measurable fun a => addFun (h a) (f a) :=
  measurable_addFun.comp (hh.prodMk hf)

theorem Measurable.addConst {h : α → DistRd d} {c : α → ℝ} (hh : Measurable h)
    (hc : Measurable c) : Measurable fun a => addConst (h a) (c a) :=
  measurable_addConst.comp (hh.prodMk hc)

theorem Measurable.ofCont {f : α → C(Rd d, ℝ)} (hf : Measurable f) :
    Measurable fun a => ofCont (f a) :=
  measurable_ofCont.comp hf

theorem Measurable.affineComp {h : α → DistRd d} (hh : Measurable h) (r : ℝ) (z : Rd d) :
    Measurable fun a => affineComp r z (h a) :=
  (measurable_affineComp r z).comp hh

theorem Measurable.restrictTo {h : α → DistRd d} (hh : Measurable h) (U : Opens (Rd d)) :
    Measurable fun a => restrictTo U (h a) :=
  (measurable_restrictTo U).comp hh

theorem Measurable.distOn_apply {U : Opens (Rd d)} {h : α → DistOn U} (hh : Measurable h)
    (φ : TestOn U) : Measurable fun a => h a φ :=
  (measurable_distOn_apply φ).comp hh

end Random

end HigherDimLQGMetric
