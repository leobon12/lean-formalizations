import HigherDimLQGMetric.DGZ.NiceBoxIndep

/-!
# DGZ §5.1: translation invariance of the bad-box probabilities (packet L4a1)

Source: [2] (5.8) ("the probability does not depend on `x`", TeX l. 2155); planning audit MA7 D-5.3,
Remark 5.4′ (last sentence); blueprint Lemma `r2:lem:54`(iv), erratum C8 (the certificate involves
no cube, so statuses are translation invariant).

* `map_contFamily_eq`: for two dyadic realizations (any probability spaces, same kernel), the
  families `q ↦ H q (·, ω)` have the same law as random elements of `ℕ → C(ℝ^d, ℝ)` (HigherDimLFPP
  `map_bandVersion_family_eq` and the identification of the Borel σ-algebra of `C(ℝ^d, ℝ)`);
  `measure_niceBox_eq_of_realization`: the status probabilities do not depend on the realization.
* `niceBox_translate`: translating all fields by a vector `τ` of the lattices `𝒴_i` (`i ≤ j`) moves
  the `a_j`-box at `s_j u` to the box at `s_j (u + t_j)`, `τ = s_j t_j` (deterministic).
* `isDyadicRealization_translate`: `(P, W ∘ V_τ, H(· + τ))` is again a dyadic realization.
* `prob_bad_eq` (**target**): `P[the a_j-box at s_j u is bad]` does not depend on `u` (`a`
  monotone).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal

namespace HigherDimLQGMetric

namespace DGZ

open HigherDimLFPP HigherDimLFPP.Perc
open HigherDimLFPP.DGZ (latPt latPt_apply cbox obox obox_subset_cbox)

variable {d : ℕ}

/-! ## The law of the whole family of fields -/

section Law

/-- The family `q ↦ H q (·, ω)` as a random element of `ℕ → C(ℝ^d, ℝ)`. -/
def contFamily {Ω : Type*} (H : ℕ → Rd d → Ω → ℝ) (hc : ∀ q ω, Continuous fun z => H q z ω)
    (ω : Ω) : ℕ → C(Rd d, ℝ) :=
  fun q => ⟨fun z => H q z ω, hc q ω⟩

theorem measurable_contFamily {Ω : Type*} [MeasurableSpace Ω] {H : ℕ → Rd d → Ω → ℝ}
    (hc : ∀ q ω, Continuous fun z => H q z ω) (hm : ∀ q z, Measurable (H q z)) :
    Measurable (contFamily H hc) :=
  measurable_pi_iff.2 fun q => ContinuousMap.measurable_iff_eval.2 fun z => hm q z

/-- The product σ-algebra of `ℕ → C(ℝ^d, ℝ)` is generated by the evaluations `f ↦ f q z`. -/
theorem measurableSpace_pi_continuousMap_le :
    (MeasurableSpace.pi : MeasurableSpace (ℕ → C(Rd d, ℝ))) ≤
      MeasurableSpace.comap (fun (f : ℕ → C(Rd d, ℝ)) (x : ℕ × Rd d) => f x.1 x.2)
        MeasurableSpace.pi := by
  refine iSup_le fun q => ?_
  show MeasurableSpace.comap (fun f : ℕ → C(Rd d, ℝ) => f q) ContinuousMap.measurableSpace ≤ _
  rw [measurableSpace_continuousMap_eq_comap, MeasurableSpace.comap_comp]
  exact comap_comp_le_comap (fun (f : ℕ → C(Rd d, ℝ)) (x : ℕ × Rd d) => f x.1 x.2)
    (Φ := fun (F : ℕ × Rd d → ℝ) (z : Rd d) => F (q, z))
    (measurable_pi_iff.2 fun _z => measurable_pi_apply _)

/-- **The law of a dyadic realization**: for two dyadic realizations of the same kernel (on any
probability spaces), the families of fields have the same law on `ℕ → C(ℝ^d, ℝ)`. -/
theorem map_contFamily_eq {κ : Rd d → ℝ} {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    {P : Measure Ω} {P' : Measure Ω'} {W : WN d → Ω → ℝ} {W' : WN d → Ω' → ℝ}
    {H : ℕ → Rd d → Ω → ℝ} {H' : ℕ → Rd d → Ω' → ℝ} (hH : IsDyadicRealization κ P W H)
    (hH' : IsDyadicRealization κ P' W' H') :
    P.map (contFamily H fun q => (hH.band q).continuous) =
      P'.map (contFamily H' fun q => (hH'.band q).continuous) := by
  have hm := measurable_contFamily (fun q => (hH.band q).continuous)
    fun q => (hH.band q).measurable
  have hm' := measurable_contFamily (fun q => (hH'.band q).continuous)
    fun q => (hH'.band q).measurable
  have hJ : Measurable fun ω (x : ℕ × Rd d) => H x.1 x.2 ω :=
    measurable_pi_iff.2 fun x => (hH.band x.1).measurable x.2
  have hJ' : Measurable fun ω (x : ℕ × Rd d) => H' x.1 x.2 ω :=
    measurable_pi_iff.2 fun x => (hH'.band x.1).measurable x.2
  have hlaw := map_bandVersion_family_eq (J := ℕ) (a := fun q => (2 : ℝ)⁻¹ ^ q)
    (b := fun _ => 1) hH.band hH'.band hH.whiteNoise hH'.whiteNoise
  ext S hS
  rw [Measure.map_apply hm hS, Measure.map_apply hm' hS]
  obtain ⟨T, hT, rfl⟩ := MeasurableSpace.measurableSet_comap.1
    (measurableSpace_pi_continuousMap_le S hS)
  have e1 : (contFamily H fun q => (hH.band q).continuous) ⁻¹'
      ((fun (f : ℕ → C(Rd d, ℝ)) (x : ℕ × Rd d) => f x.1 x.2) ⁻¹' T) =
      (fun ω (x : ℕ × Rd d) => H x.1 x.2 ω) ⁻¹' T := rfl
  have e2 : (contFamily H' fun q => (hH'.band q).continuous) ⁻¹'
      ((fun (f : ℕ → C(Rd d, ℝ)) (x : ℕ × Rd d) => f x.1 x.2) ⁻¹' T) =
      (fun ω (x : ℕ × Rd d) => H' x.1 x.2 ω) ⁻¹' T := rfl
  rw [e1, e2, ← Measure.map_apply hJ hT, ← Measure.map_apply hJ' hT, hlaw]

/-- The canonical family on `ℕ → C(ℝ^d, ℝ)` has continuous paths and measurable values. -/
theorem measurable_canonical_eval (q : ℕ) (z : Rd d) :
    Measurable fun f : ℕ → C(Rd d, ℝ) => f q z :=
  (continuous_eval_const z).measurable.comp (measurable_pi_apply q)

/-- **Status probabilities do not depend on the realization**: for two dyadic realizations of the
same kernel, `P[the a_j-box at s_j u is nice] = P'[the a_j-box at s_j u is nice]`, and likewise for
bad boxes. -/
theorem measure_niceBox_eq_of_realization {κ : Rd d → ℝ} {Ω Ω' : Type*} [MeasurableSpace Ω]
    [MeasurableSpace Ω'] {P : Measure Ω} {P' : Measure Ω'} {W : WN d → Ω → ℝ}
    {W' : WN d → Ω' → ℝ} {H : ℕ → Rd d → Ω → ℝ} {H' : ℕ → Rd d → Ω' → ℝ}
    (hH : IsDyadicRealization κ P W H) (hH' : IsDyadicRealization κ P' W' H') (p : NiceParams)
    (j : ℕ) (u : Zd d) :
    P {ω | NiceBox p (fun q z => H q z ω) j u} = P' {ω | NiceBox p (fun q z => H' q z ω) j u} ∧
      P {ω | ¬ NiceBox p (fun q z => H q z ω) j u} =
        P' {ω | ¬ NiceBox p (fun q z => H' q z ω) j u} := by
  have hS := measurableSet_niceBox (H := fun q z (f : ℕ → C(Rd d, ℝ)) => f q z)
    (fun q f => (f q).continuous) measurable_canonical_eval p j u
  have hm := measurable_contFamily (fun q => (hH.band q).continuous)
    fun q => (hH.band q).measurable
  have hm' := measurable_contFamily (fun q => (hH'.band q).continuous)
    fun q => (hH'.band q).measurable
  have hlaw := map_contFamily_eq hH hH'
  have key : ∀ S : Set (ℕ → C(Rd d, ℝ)), MeasurableSet S →
      P ((contFamily H fun q => (hH.band q).continuous) ⁻¹' S) =
        P' ((contFamily H' fun q => (hH'.band q).continuous) ⁻¹' S) := fun S hS' => by
    rw [← Measure.map_apply hm hS', ← Measure.map_apply hm' hS', hlaw]
  exact ⟨key _ hS, key _ hS.compl⟩

end Law

/-! ## Translations -/

section Translate

variable {τ : Rd d}

theorem latPt_add (s : ℝ) (u t : Zd d) : latPt s (u + t) = latPt s u + latPt s t := by
  ext i
  simp only [latPt_apply, PiLp.add_apply, Pi.add_apply, Int.cast_add, mul_add]

theorem add_mem_obox_add_iff {c z : Rd d} {r : ℝ} : z + τ ∈ obox (c + τ) r ↔ z ∈ obox c r := by
  simp only [mem_obox, PiLp.add_apply, add_sub_add_right_eq_sub]

theorem add_mem_cbox_add_iff {c z : Rd d} {r : ℝ} : z + τ ∈ cbox (c + τ) r ↔ z ∈ cbox c r := by
  simp only [mem_cbox, PiLp.add_apply, add_sub_add_right_eq_sub]

theorem forall_mem_cbox_add_iff {c : Rd d} {r : ℝ} {Q : Rd d → Prop} :
    (∀ z ∈ cbox c r, Q (z + τ)) ↔ ∀ z ∈ cbox (c + τ) r, Q z := by
  constructor
  · intro h z hz
    have := h (z - τ) (by rw [← add_mem_cbox_add_iff (τ := τ), sub_add_cancel]; exact hz)
    rwa [sub_add_cancel] at this
  · intro h z hz
    exact h (z + τ) (add_mem_cbox_add_iff.2 hz)

theorem obox_add_subset_iff {c c' : Rd d} {r r' : ℝ} :
    obox (c + τ) r ⊆ obox (c' + τ) r' ↔ obox c r ⊆ obox c' r' := by
  constructor
  · intro h z hz
    exact add_mem_obox_add_iff.1 (h (add_mem_obox_add_iff.2 hz))
  · intro h y hy
    have hy' : y - τ ∈ obox c r := by
      rw [← add_mem_obox_add_iff (τ := τ), sub_add_cancel]
      exact hy
    have := (add_mem_obox_add_iff (τ := τ)).2 (h hy')
    rwa [sub_add_cancel] at this

/-- The oscillation condition is translation covariant. -/
theorem osc_translate_iff {G : Rd d → ℝ} {y : Rd d} {r L : ℝ} :
    (∀ z ∈ cbox y r, ∀ w ∈ cbox y r, |G (z + τ) - G (w + τ)| ≤ L) ↔
      ∀ z ∈ cbox (y + τ) r, ∀ w ∈ cbox (y + τ) r, |G z - G w| ≤ L := by
  rw [← forall_mem_cbox_add_iff]
  refine forall₂_congr fun z _ => ?_
  rw [← forall_mem_cbox_add_iff]

/-- Substitution `v ↦ v + t` in a quantifier over lattice sites. -/
theorem forall_zd_add_iff (t : Zd d) {A B : Zd d → Prop} (h : ∀ v, A v ↔ B (v + t)) :
    (∀ v, A v) ↔ ∀ v, B v := by
  constructor
  · intro hA v
    have := (h (v - t)).1 (hA (v - t))
    rwa [sub_add_cancel] at this
  · intro hB v
    exact (h v).2 (hB (v + t))

theorem exists_zd_add_iff (t : Zd d) {A B : Zd d → Prop} (h : ∀ v, A v ↔ B (v + t)) :
    (∃ v, A v) ↔ ∃ v, B v := by
  constructor
  · rintro ⟨v, hv⟩
    exact ⟨v + t, (h v).1 hv⟩
  · rintro ⟨v, hv⟩
    refine ⟨v - t, (h (v - t)).2 ?_⟩
    rwa [sub_add_cancel]

/-- The across distance is translation covariant. -/
theorem acrossDist_translate (ξ : ℝ) (φ : Rd d → ℝ) (c : Rd d) (r₁ r₂ : ℝ) :
    acrossDist ξ (fun z => φ (z + τ)) c r₁ r₂ = acrossDist ξ φ (c + τ) r₁ r₂ := by
  have h := acrossDist_smul_add τ ξ φ one_pos c r₁ r₂
  simp only [one_smul, one_mul] at h
  rw [add_comm τ c] at h
  rw [h]
  congr 1
  funext z
  rw [add_comm]

variable (p : NiceParams) (H : ℕ → Rd d → ℝ)

theorem niceOscOne_translate {t₀ t₁ : Zd d} (h₀ : latPt (p.s 0) t₀ = τ)
    (h₁ : latPt (p.s 1) t₁ = τ) (u : Zd d) :
    NiceOscOne p (fun q z => H q (z + τ)) u ↔ NiceOscOne p H (u + t₁) := by
  unfold NiceOscOne
  refine forall_zd_add_iff t₀ fun v => ?_
  rw [latPt_add, latPt_add, h₀, h₁, add_mem_obox_add_iff]
  refine imp_congr_right fun _ => ?_
  exact osc_translate_iff (G := fun z => H p.n z - H (p.n - p.a 1) z)

theorem niceAcrossOne_translate {t₀ t₁ : Zd d} (h₀ : latPt (p.s 0) t₀ = τ)
    (h₁ : latPt (p.s 1) t₁ = τ) (u : Zd d) :
    NiceAcrossOne p (fun q z => H q (z + τ)) u ↔ NiceAcrossOne p H (u + t₁) := by
  unfold NiceAcrossOne
  refine forall_zd_add_iff t₀ fun v => ?_
  rw [latPt_add, latPt_add, h₀, h₁, add_mem_obox_add_iff]
  refine imp_congr_right fun _ => ?_
  rw [acrossDist_translate (φ := fun z => H (p.n + p.k) z - H p.n z)]

theorem niceOscCond_translate {j : ℕ} {t : ℕ → Zd d} (ht : ∀ i ≤ j, latPt (p.s i) (t i) = τ)
    (u : Zd d) :
    NiceOscCond p (fun q z => H q (z + τ)) j u ↔ NiceOscCond p H j (u + t j) := by
  unfold NiceOscCond
  refine forall₂_congr fun i hi => forall_zd_add_iff (t i) fun v => ?_
  rw [latPt_add, latPt_add, ht i hi.le, ht j le_rfl, add_mem_obox_add_iff]
  refine imp_congr_right fun _ => ?_
  exact osc_translate_iff (G := fun z => H (p.n - p.a (j - 1)) z - H (p.n - p.a j) z)

theorem niceCert_translate (i : ℕ) (z : Rd d) :
    NiceCert p (fun q z => H q (z + τ)) i z ↔ NiceCert p H i (z + τ) := by
  have e1 : certCoarse p (fun q z => H q (z + τ)) i z = certCoarse p H i (z + τ) := by
    funext w
    simp only [certCoarse, add_right_comm z τ]
  have e2 : certFine p (fun q z => H q (z + τ)) i z = certFine p H i (z + τ) := by
    funext w
    simp only [certFine, add_right_comm z τ]
  unfold NiceCert
  rw [e1, e2]

theorem niceCEvent_translate {j : ℕ} {t t' : Zd d} (ht : latPt (p.s j) t = τ)
    (ht' : latPt (p.s (j - 1)) t' = τ) (u w : Zd d) :
    NiceCEvent p (fun q z => H q (z + τ)) j u w ↔ NiceCEvent p H j (u + t) (w + t') := by
  unfold NiceCEvent
  rw [latPt_add, latPt_add, ht, ht', niceCert_translate,
    acrossDist_translate (φ := fun z => H p.n z - H (p.n - p.a j) z)]
  refine and_congr Iff.rfl (and_congr Iff.rfl ?_)
  exact (forall_mem_cbox_add_iff (Q := fun z =>
    H (p.n - p.a (j - 1)) z - H (p.n - p.a j) z ≤ p.supLevel j))

/-- **Translation covariance of the statuses** (deterministic): if `τ = s_i t_i` for all `i ≤ j`
(`τ` lies in all the lattices `𝒴_i`, `i ≤ j`), the status of the `a_j`-box at `s_j u` for the
translated fields `H q (· + τ)` is the status of the box at `s_j (u + t_j)` for `H`. -/
theorem niceBox_translate (τ : Rd d) (t : ℕ → Zd d) :
    ∀ j, (∀ i ≤ j, latPt (p.s i) (t i) = τ) → ∀ u : Zd d,
      (NiceBox p (fun q z => H q (z + τ)) j u ↔ NiceBox p H j (u + t j))
  | 0, _, _ => Iff.rfl
  | 1, ht, u => and_congr (niceOscOne_translate p H (ht 0 (Nat.zero_le 1)) (ht 1 le_rfl) u)
      (niceAcrossOne_translate p H (ht 0 (Nat.zero_le 1)) (ht 1 le_rfl) u)
  | j + 2, ht, u => by
      have ih := niceBox_translate τ t (j + 1) fun i hi => ht i (by omega)
      have h₂ : latPt (p.s (j + 2)) (t (j + 2)) = τ := ht (j + 2) le_rfl
      have h₁ : latPt (p.s (j + 1)) (t (j + 1)) = τ := ht (j + 1) (by omega)
      have hsub : ∀ v : Zd d, (obox (latPt (p.s (j + 1)) (v + t (j + 1))) (p.s (j + 1)) ⊆
          obox (latPt (p.s (j + 2)) (u + t (j + 2))) (p.s (j + 2)) ↔
          obox (latPt (p.s (j + 1)) v) (p.s (j + 1)) ⊆
            obox (latPt (p.s (j + 2)) u) (p.s (j + 2))) := fun v => by
        rw [latPt_add, latPt_add, h₁, h₂, obox_add_subset_iff]
      rw [niceBox_add_two_iff, niceBox_add_two_iff]
      refine and_congr (niceOscCond_translate p H ht u) (or_congr ?_ ?_)
      · refine forall_zd_add_iff (t (j + 1)) fun v => ?_
        rw [hsub v, ih v]
      · refine exists_zd_add_iff (t (j + 1)) fun w => ?_
        refine and_congr ?_ (and_congr ?_ (niceCEvent_translate p H h₂ h₁ u w))
        · rw [latPt_add, latPt_add, h₁, h₂, add_mem_obox_add_iff]
        · refine forall_zd_add_iff (t (j + 1)) fun v => ?_
          simp only [latPt_add, h₁, h₂, obox_add_subset_iff, ih v]

end Translate

/-! ## Translation invariance of the bad-box probabilities -/

section Prob

variable {κ : Rd d → ℝ} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {W : WN d → Ω → ℝ}
  {H : ℕ → Rd d → Ω → ℝ}

/-- **Translated realizations**: `(P, W ∘ V_τ, H(· + τ))` is a dyadic realization. -/
theorem isDyadicRealization_translate (hκ : IsLFPPKernel κ) (hH : IsDyadicRealization κ P W H)
    (τ : Rd d) :
    IsDyadicRealization κ P (fun f => W (simL2 (LinearIsometryEquiv.refl ℝ (Rd d)) τ one_pos f))
      (fun q z ω => H q (z + τ) ω) where
  whiteNoise := hH.whiteNoise.comp_simL2 _ τ one_pos
  band q := by
    have h := (hH.band q).comp_isometry hκ (LinearIsometryEquiv.refl ℝ (Rd d)) τ (by positivity)
    have e : (fun z => H q (τ + (LinearIsometryEquiv.refl ℝ (Rd d)) z)) =
        fun z ω => H q (z + τ) ω := by
      funext z ω
      show H q (τ + z) ω = H q (z + τ) ω
      rw [add_comm]
    rw [e] at h
    exact h

/-- The lattice vector `s_j t` lies in `𝒴_i = s_i ℤ^d` for `i ≤ j` (`a` monotone): it is `s_i` times
`2^{(n - a_i) - (n - a_j)} t`. -/
theorem latPt_scale_eq (p : NiceParams) (hmono : Monotone p.a) {i j : ℕ} (hij : i ≤ j)
    (t : Zd d) :
    latPt (p.s i) ((2 : ℤ) ^ ((p.n - p.a i) - (p.n - p.a j)) • t) = latPt (p.s j) t := by
  have hle : p.n - p.a j ≤ p.n - p.a i := Nat.sub_le_sub_left (hmono hij) _
  have hs : p.s i * (2 : ℝ) ^ ((p.n - p.a i) - (p.n - p.a j)) = p.s j := by
    unfold NiceParams.s
    obtain ⟨e, he⟩ := Nat.exists_eq_add_of_le hle
    rw [he, Nat.add_sub_cancel_left, pow_add, mul_assoc, ← mul_pow, inv_mul_cancel₀ two_ne_zero,
      one_pow, mul_one]
  ext k
  rw [latPt_apply, latPt_apply, ← hs]
  simp only [Pi.smul_apply, smul_eq_mul, Int.cast_mul, Int.cast_pow, Int.cast_ofNat]
  ring

/-- **Translation invariance of the bad-box probabilities** (target `prob_bad_eq`; DGZ (5.8);
MA7 D-5.3 Remark 5.4′; blueprint `r2:lem:54`(iv)): for a dyadic realization and a monotone exponent
sequence, `q_j = P[the a_j-box at s_j u is bad]` does not depend on `u`. -/
theorem prob_bad_eq (hκ : IsLFPPKernel κ) (hH : IsDyadicRealization κ P W H) (p : NiceParams)
    (hmono : Monotone p.a) (j : ℕ) (u u' : Zd d) :
    P {ω | ¬ NiceBox p (fun q z => H q z ω) j u} =
      P {ω | ¬ NiceBox p (fun q z => H q z ω) j u'} := by
  set τ := latPt (p.s j) (u' - u) with hτ
  set t : ℕ → Zd d := fun i => (2 : ℤ) ^ ((p.n - p.a i) - (p.n - p.a j)) • (u' - u) with htdef
  have ht : ∀ i ≤ j, latPt (p.s i) (t i) = τ := fun i hi => latPt_scale_eq p hmono hi (u' - u)
  have htj : t j = u' - u := by
    simp only [htdef, Nat.sub_self, pow_zero, one_smul]
  have hH' := isDyadicRealization_translate hκ hH τ
  have heq : {ω | ¬ NiceBox p (fun q z => H q z ω) j u'} =
      {ω | ¬ NiceBox p (fun q z => H q (z + τ) ω) j u} := by
    ext ω
    simp only [mem_ofPred_eq]
    rw [niceBox_translate p (fun q z => H q z ω) τ t j ht u, htj, add_sub_cancel]
  rw [heq]
  exact (measure_niceBox_eq_of_realization hH hH' p j u).2

end Prob

end DGZ

end HigherDimLQGMetric
