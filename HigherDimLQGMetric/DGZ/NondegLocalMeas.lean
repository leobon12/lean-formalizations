import HigherDimLQGMetric.DGZ.NondegLimitCompare

/-!
# Local measurability of internal metrics

The internal LFPP distance on `U` is measurable for the sigma algebra generated by
the field on `U`. This supplies the local functional needed for finite-range
independence in the DGZ zero-one argument.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option linter.style.haveILetI false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set

namespace HigherDimLQGMetric.DGZ

open HigherDimLFPP HigherDimLFPP.Perc

variable {d : ℕ}

/-- Measurability of the length of a path staying in `U` requires the random field
only on `U`. -/
theorem nd_measurable_lfppLength_local {Ω : Type*} [MeasurableSpace Ω]
    {U : Set (Rd d)} {H : Rd d → Ω → ℝ}
    (hc : ∀ ω, Continuous fun z => H z ω)
    (hm : ∀ z ∈ U, Measurable (H z))
    {γ : ℝ → Rd d} (hγ : ContinuousOn γ (Icc 0 1))
    (hγU : MapsTo γ (Icc 0 1) U) (ζ : ℝ) :
    Measurable fun ω => lfppLength ζ (fun z => H z ω) γ := by
  set γ' : ℝ → Rd d := fun t => γ (projIcc (0 : ℝ) 1 zero_le_one t) with hγ'def
  have hγ' : Continuous γ' :=
    hγ.comp_continuous (continuous_subtype_val.comp continuous_projIcc) fun t =>
      (projIcc _ _ _ t).2
  have hγ'U : ∀ t, γ' t ∈ U := fun t => hγU (projIcc _ _ _ t).2
  have heq : ∀ ω, lfppLength ζ (fun z => H z ω) γ =
      ∫ t in Ioc (0 : ℝ) 1, Real.exp (ζ * H (γ' t) ω) * ‖deriv γ t‖ := by
    intro ω
    rw [lfppLength, intervalIntegral.integral_of_le zero_le_one]
    refine setIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
    simp only [hγ'def, projIcc_of_mem zero_le_one (Ioc_subset_Icc_self ht)]
  simp_rw [heq]
  have hHU : Measurable (Function.uncurry (fun z : U => H z.1)) :=
    measurable_uncurry_of_continuous_of_measurable
      (fun ω => (hc ω).comp continuous_subtype_val)
      (fun z => hm z.1 z.2)
  have hγU' : Measurable (fun t : ℝ => (⟨γ' t, hγ'U t⟩ : U)) :=
    (hγ'.subtype_mk hγ'U).measurable
  have hF : StronglyMeasurable
      (fun p : Ω × ℝ => Real.exp (ζ * H (γ' p.2) p.1) * ‖deriv γ p.2‖) := by
    refine Measurable.stronglyMeasurable ?_
    exact (((hHU.comp ((hγU'.comp measurable_snd).prodMk measurable_fst)).const_mul
      ζ).exp).mul ((measurable_deriv γ).comp measurable_snd).norm
  exact (hF.integral_prod_right' (ν := (volume : Measure ℝ).restrict (Ioc (0 : ℝ) 1))).measurable

/-- Internal LFPP distance is measurable from values of the field on its domain. -/
theorem nd_measurable_lfppDistOn_local {Ω : Type*} [MeasurableSpace Ω]
    {U : Set (Rd d)} {H : Rd d → Ω → ℝ}
    (hc : ∀ ω, Continuous fun z => H z ω)
    (hm : ∀ z ∈ U, Measurable (H z))
    (hU : IsOpen U) (ζ : ℝ) (x y : Rd d) :
    Measurable fun ω => lfppDistOn ζ (fun z => H z ω) U x y := by
  have heq : (fun ω => lfppDistOn ζ (fun z => H z ω) U x y) = fun ω =>
      ⨅ q : {q : RatPolyIdx d // MapsTo (ratPoly x y q) (Icc 0 1) U},
        lfppLength ζ (fun z => H z ω) (ratPoly x y q.1) :=
    funext fun ω => lfppDistOn_eq_iInf_ratPoly hU (hc ω) x y
  rw [heq]
  exact Measurable.iInf fun q =>
    nd_measurable_lfppLength_local hc hm
      (isPcwC1Path_ratPoly x y q.1).continuousOn q.2 ζ

/-- A normalized internal metric is measurable for the sigma algebra generated
by the field restricted to its open domain. -/
theorem nd_measurable_internalMetricC_comap {Ω : Type*} [MeasurableSpace Ω]
    {U : Set (Rd d)} {H : Rd d → Ω → ℝ}
    (hc : ∀ ω, Continuous fun z => H z ω)
    (hU : IsOpen U) (hUc : IsPreconnected U) (ξ a : ℝ) :
    Measurable[MeasurableSpace.comap
      (fun ω (z : U) => H z.1 ω) MeasurableSpace.pi]
      (fun ω => internalMetricC ξ (fun z => H z ω) U a) := by
  letI : MeasurableSpace Ω := MeasurableSpace.comap
    (fun ω (z : U) => H z.1 ω) MeasurableSpace.pi
  have hm : ∀ z ∈ U, Measurable (H z) := by
    intro z hz
    exact (measurable_pi_apply (⟨z, hz⟩ : U)).comp
      (comap_measurable (fun ω (w : U) => H w.1 ω))
  haveI : LocallyCompactSpace U := hU.locallyCompactSpace
  refine ContinuousMap.measurable_iff_eval.2 fun p => ?_
  have heq : (fun ω => internalMetricC ξ (fun z => H z ω) U a p) =
      fun ω => a⁻¹ * lfppDistOn ξ (fun z => H z ω) U p.1 p.2 :=
    funext fun ω => internalMetricC_apply (hc ω) hU hUc a p
  rw [heq]
  exact (nd_measurable_lfppDistOn_local hc hm hU ξ _ _).const_mul _

end HigherDimLQGMetric.DGZ
