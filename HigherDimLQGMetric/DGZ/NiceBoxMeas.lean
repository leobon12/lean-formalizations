import HigherDimLQGMetric.DGZ.NiceBoxDefs

/-!
# DGZ §5.1: measurability and locality of nice boxes (packet L4a1)

Source: [2] Remark 5.4(1) (TeX l. 2137–2148); planning audit MA7 D-5.3 (Remark 5.4′(i)), G24;
blueprint Lemma `r2:lem:54`(i).

* `measurable_niceBox` (**target** `measurable_niceBox`): for any random family `H` with continuous
  paths and measurable values, `ω ↦ NiceBox p (H · · ω) j u` is measurable (no hypothesis on the
  parameters); likewise for every condition and for `𝒥₁`, `𝒥₂′`.
* `niceBox_congr`: the status of the `a_j`-box at `x = s_j u` only depends on the increments `h_{q',
  q} = H q - H q'` (`q, q' ≥ n - a_j`) on `B̄_{5 s_j}(x)` (`SameIncr`), provided `a` is monotone, `8
  s_{i-1} ≤ s_i` and `R s_{i-1} ≤ s_i` for `2 ≤ i ≤ j`, and `R ≥ 4`.
* `bandSigma H p₀ B`: the σ-algebra generated by the bands `h_{p₀, p₀+q} = H (p₀+q) - H p₀` (`q ∈
  ℕ`) restricted to `B`; for a dyadic realization these are versions of `H_{2^{-p₀-q},2^{-p₀}}`,
  i.e. functions of the white noise on `(0, 2^{-p₀}) × (B + kernel range)`.
* `niceBox_local` (**target** `niceBox_local`): the status of the `a_j`-box at `s_j u` is measurable
  for `bandSigma H (n - a_j) (B̄_{5 s_j}(s_j u))` — the σ-algebra of `W` on `(0, s_j) × B_{(5 + r₀)
  s_j}(s_j u)` (MA7: `(2^{-n-k}, s_j)`; all finer scales are allowed here, which only enlarges the
  σ-algebra; the independence statements of `NiceBoxIndep.lean` are proved for it).

Geometry: `cbox_subset_of_obox_subset` (an `a_{j-1}`-box inside `B_{s_j}(x)` has its `5 s_{j-1}`
neighbourhood inside `B̄_{5 s_j}(x)`), `abs_sub_le_of_obox_subset`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal

namespace HigherDimLQGMetric

namespace DGZ

open HigherDimLFPP HigherDimLFPP.Perc
open HigherDimLFPP.DGZ (latPt latPt_apply cbox obox obox_subset_cbox)

variable {d : ℕ}

/-! ## Geometry of boxes -/

section Geometry

/-- A box around a point of `B_r(x)` lies in a bigger box around `x`. -/
theorem cbox_subset_cbox_of_mem_obox {x y : Rd d} {r r' : ℝ} (hy : y ∈ obox x r) :
    cbox y r' ⊆ cbox x (r + r') := by
  intro z hz i
  have h1 : |z i - y i| ≤ r' := hz i
  have h2 : |y i - x i| < r := hy i
  calc |z i - x i| = |(z i - y i) + (y i - x i)| := by ring_nf
    _ ≤ |z i - y i| + |y i - x i| := abs_add_le _ _
    _ ≤ r + r' := by linarith

/-- A box around a point of `B̄_r(x)` lies in a bigger box around `x`. -/
theorem cbox_subset_cbox_of_mem_cbox {x y : Rd d} {r r' : ℝ} (hy : y ∈ cbox x r) :
    cbox y r' ⊆ cbox x (r + r') := by
  intro z hz i
  have h1 : |z i - y i| ≤ r' := hz i
  have h2 : |y i - x i| ≤ r := hy i
  calc |z i - x i| = |(z i - y i) + (y i - x i)| := by ring_nf
    _ ≤ |z i - y i| + |y i - x i| := abs_add_le _ _
    _ ≤ r + r' := by linarith

/-- The point `y` moved by `t` in the coordinate `i`. -/
def shiftCoord (y : Rd d) (i : Fin d) (t : ℝ) : Rd d :=
  WithLp.toLp 2 (Function.update (WithLp.ofLp y) i (y i + t))

theorem shiftCoord_apply_self (y : Rd d) (i : Fin d) (t : ℝ) : shiftCoord y i t i = y i + t := by
  simp [shiftCoord]

theorem shiftCoord_apply_of_ne (y : Rd d) {i k : Fin d} (hk : k ≠ i) (t : ℝ) :
    shiftCoord y i t k = y k := by
  simp [shiftCoord, Function.update_of_ne hk]

/-- If `B_{s'}(y) ⊆ B_s(x)` (`s' > 0`), then `|y_i - x_i| ≤ s - s'` in every coordinate. -/
theorem abs_sub_le_of_obox_subset {x y : Rd d} {s s' : ℝ} (hs' : 0 < s')
    (h : obox y s' ⊆ obox x s) (i : Fin d) : |y i - x i| ≤ s - s' := by
  by_contra hlt
  push Not at hlt
  have hmem : ∀ t : ℝ, |t| < s' → |y i + t - x i| < s := by
    intro t ht
    have hp : shiftCoord y i t ∈ obox y s' := by
      intro k
      by_cases hk : k = i
      · subst hk
        rw [shiftCoord_apply_self, add_sub_cancel_left]
        exact ht
      · rw [shiftCoord_apply_of_ne y hk, sub_self, abs_zero]
        exact hs'
    have := h hp i
    rwa [shiftCoord_apply_self] at this
  rcases le_or_gt 0 (y i - x i) with hδ | hδ
  · rw [abs_of_nonneg hδ] at hlt
    set t := max 0 (s - (y i - x i)) with ht
    have ht0 : 0 ≤ t := le_max_left _ _
    have hts : t < s' := max_lt hs' (by linarith)
    have h1 := hmem t (by rw [abs_of_nonneg ht0]; exact hts)
    have h2 : s - (y i - x i) ≤ t := le_max_right _ _
    rw [abs_lt] at h1
    linarith [h1.2]
  · rw [abs_of_neg hδ] at hlt
    set t := max 0 (s + (y i - x i)) with ht
    have ht0 : 0 ≤ t := le_max_left _ _
    have hts : t < s' := max_lt hs' (by linarith)
    have h1 := hmem (-t) (by rw [abs_neg, abs_of_nonneg ht0]; exact hts)
    have h2 : s + (y i - x i) ≤ t := le_max_right _ _
    rw [abs_lt] at h1
    linarith [h1.1]

/-- If `B_{s'}(y) ⊆ B_s(x)` (`s' > 0`), then `B̄_{r'}(y) ⊆ B̄_{s - s' + r'}(x)`. -/
theorem cbox_subset_of_obox_subset {x y : Rd d} {s s' : ℝ} (hs' : 0 < s')
    (h : obox y s' ⊆ obox x s) (r' : ℝ) : cbox y r' ⊆ cbox x (s - s' + r') := by
  intro z hz i
  have h1 : |z i - y i| ≤ r' := hz i
  have h2 := abs_sub_le_of_obox_subset hs' h i
  calc |z i - x i| = |(z i - y i) + (y i - x i)| := by ring_nf
    _ ≤ |z i - y i| + |y i - x i| := abs_add_le _ _
    _ ≤ s - s' + r' := by linarith

end Geometry

/-! ## Scales -/

namespace NiceParams

variable (p : NiceParams)

theorem s_pos (i : ℕ) : 0 < p.s i := by unfold NiceParams.s; positivity

theorem s_le_s (hmono : Monotone p.a) {i j : ℕ} (hij : i ≤ j) : p.s i ≤ p.s j :=
  pow_le_pow_of_le_one (by norm_num) (by norm_num) (Nat.sub_le_sub_left (hmono hij) p.n)

theorem s_le_one (i : ℕ) : p.s i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)

end NiceParams

/-! ## Locality: congruence of the conditions -/

/-- `H` and `H'` have the same increments `H q - H p₀` (`q ≥ p₀`) on `B`; then all increments
`H q - H q'` with `q, q' ≥ p₀` agree on `B` (`SameIncr.sub_eq`). -/
def SameIncr (H H' : ℕ → Rd d → ℝ) (p₀ : ℕ) (B : Set (Rd d)) : Prop :=
  ∀ q, p₀ ≤ q → ∀ z ∈ B, H q z - H p₀ z = H' q z - H' p₀ z

section Congr

variable {H H' : ℕ → Rd d → ℝ} {p₀ p₁ : ℕ} {B B' : Set (Rd d)}

theorem SameIncr.sub_eq (h : SameIncr H H' p₀ B) {q q' : ℕ} (hq : p₀ ≤ q) (hq' : p₀ ≤ q')
    {z : Rd d} (hz : z ∈ B) : H q z - H q' z = H' q z - H' q' z := by
  have h1 := h q hq z hz
  have h2 := h q' hq' z hz
  linarith

theorem SameIncr.mono (h : SameIncr H H' p₀ B) (hp : p₀ ≤ p₁) (hB : B' ⊆ B) :
    SameIncr H H' p₁ B' :=
  fun _q hq _z hz => h.sub_eq (hp.trans hq) hp (hB hz)

variable (p : NiceParams)

theorem niceOscOne_congr (hmono : Monotone p.a) {u : Zd d}
    (h : SameIncr H H' (p.n - p.a 1) (cbox (latPt (p.s 1) u) (5 * p.s 1))) :
    NiceOscOne p H u ↔ NiceOscOne p H' u := by
  have hs01 := p.s_le_s hmono (Nat.zero_le 1)
  have hsub : ∀ v : Zd d, latPt (p.s 0) v ∈ obox (latPt (p.s 1) u) (p.s 1) →
      cbox (latPt (p.s 0) v) (3 * p.s 0) ⊆ cbox (latPt (p.s 1) u) (5 * p.s 1) := by
    intro v hv
    refine (cbox_subset_cbox_of_mem_obox hv).trans fun z hz i => (hz i).trans ?_
    linarith [p.s_pos 0]
  have hq : p.n - p.a 1 ≤ p.n := Nat.sub_le _ _
  unfold NiceOscOne
  refine forall_congr' fun v => imp_congr_right fun hv => ?_
  refine forall₂_congr fun z hz => forall₂_congr fun w hw => ?_
  rw [h p.n hq z (hsub v hv hz), h p.n hq w (hsub v hv hw)]

theorem niceAcrossOne_congr (hmono : Monotone p.a) (hc : ∀ q, Continuous (H q))
    (hc' : ∀ q, Continuous (H' q)) {u : Zd d}
    (h : SameIncr H H' (p.n - p.a 1) (cbox (latPt (p.s 1) u) (5 * p.s 1))) :
    NiceAcrossOne p H u ↔ NiceAcrossOne p H' u := by
  have hs01 := p.s_le_s hmono (Nat.zero_le 1)
  have hs0 := p.s_pos 0
  unfold NiceAcrossOne
  refine forall_congr' fun v => imp_congr_right fun hv => ?_
  have hsub : cbox (latPt (p.s 0) v) (2 * p.s 0) ⊆ cbox (latPt (p.s 1) u) (5 * p.s 1) := by
    refine (cbox_subset_cbox_of_mem_obox hv).trans fun z hz i => (hz i).trans ?_
    linarith
  rw [acrossDist_congr (φ := fun z => H (p.n + p.k) z - H p.n z)
    (ψ := fun z => H' (p.n + p.k) z - H' p.n z) ((hc _).sub (hc _)) ((hc' _).sub (hc' _))
    (by linarith) fun z hz =>
    h.sub_eq (le_trans (Nat.sub_le _ _) (Nat.le_add_right _ _)) (Nat.sub_le _ _) (hsub hz.1)]

theorem niceOscCond_congr (hmono : Monotone p.a) {j : ℕ} (hj : 1 ≤ j)
    (hgap : 8 * p.s (j - 1) ≤ p.s j) {u : Zd d}
    (h : SameIncr H H' (p.n - p.a j) (cbox (latPt (p.s j) u) (5 * p.s j))) :
    NiceOscCond p H j u ↔ NiceOscCond p H' j u := by
  unfold NiceOscCond
  refine forall₂_congr fun i hi => forall_congr' fun v => imp_congr_right fun hv => ?_
  have hsi : p.s i ≤ p.s (j - 1) := p.s_le_s hmono (by omega)
  have hsub : cbox (latPt (p.s i) v) (8 * p.s i) ⊆ cbox (latPt (p.s j) u) (5 * p.s j) := by
    refine (cbox_subset_cbox_of_mem_obox hv).trans fun z hz k => (hz k).trans ?_
    linarith
  have hq : p.n - p.a j ≤ p.n - p.a (j - 1) := Nat.sub_le_sub_left (hmono (Nat.sub_le j 1)) _
  refine forall₂_congr fun z hz => forall₂_congr fun w hw => ?_
  rw [h (p.n - p.a (j - 1)) hq z (hsub hz), h (p.n - p.a (j - 1)) hq w (hsub hw)]

/-- The rescaled shell of the certificate around `z` lies in `B̄_{4R s_i}(z)`. -/
theorem smul_add_mem_cbox_of_mem_shell {z w : Rd d} {s r₁ r₂ : ℝ} (hs : 0 < s)
    (hw : w ∈ cbox (0 : Rd d) r₁ \ obox (0 : Rd d) r₂) : z + s • w ∈ cbox z (s * r₁) := by
  intro i
  have h1 : |w i - (0 : Rd d) i| ≤ r₁ := hw.1 i
  simp only [PiLp.zero_apply, sub_zero] at h1
  rw [smul_add_apply, add_sub_cancel_left, abs_mul, abs_of_pos hs]
  exact mul_le_mul_of_nonneg_left h1 hs.le

theorem niceCert_congr {i : ℕ} {z : Rd d} (hR : 4 ≤ (p.R : ℝ)) {B : Set (Rd d)} {p₀ : ℕ}
    (hp₀ : p₀ ≤ p.n - p.a i) (hB : cbox z (4 * p.R * p.s i) ⊆ B) (h : SameIncr H H' p₀ B) :
    NiceCert p H i z ↔ NiceCert p H' i z := by
  have hs := p.s_pos i
  have hsS : (0 : ℝ) < (2 : ℝ)⁻¹ ^ superScale (p.a i) := by positivity
  have hsϱ : 2 * (2 : ℝ)⁻¹ ^ superScale (p.a i) ≤
      min (2 * (p.R : ℝ)) (4 * p.R - 2 * p.R) / 16 := by
    have h2 : (2 : ℝ)⁻¹ ^ superScale (p.a i) ≤ (2 : ℝ)⁻¹ ^ 2 :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by unfold superScale; omega)
    have e : min (2 * (p.R : ℝ)) (4 * p.R - 2 * p.R) = 2 * p.R := by
      rw [show (4 : ℝ) * p.R - 2 * p.R = 2 * p.R by ring, min_self]
    rw [e]
    norm_num at h2
    linarith
  have hmem : ∀ w ∈ cbox (0 : Rd d) (4 * (p.R : ℝ)) \ obox (0 : Rd d) (2 * p.R),
      z + p.s i • w ∈ B := fun w hw => hB (by
        have := smul_add_mem_cbox_of_mem_shell (z := z) hs hw
        rwa [show p.s i * (4 * (p.R : ℝ)) = 4 * p.R * p.s i by ring] at this)
  have hidx : p₀ ≤ p.certIdx i := hp₀.trans (Nat.le_add_right _ _)
  unfold NiceCert aroundCertAt
  refine aroundCert_congr hsS hsϱ (fun w hw => ?_) fun w hw => ?_
  · exact h.sub_eq hidx hp₀ (hmem w hw)
  · exact h.sub_eq (hp₀.trans (Nat.sub_le _ _)) hidx (hmem w hw)

theorem niceCEvent_congr (hmono : Monotone p.a) (hc : ∀ q, Continuous (H q))
    (hc' : ∀ q, Continuous (H' q)) (hR : 4 ≤ (p.R : ℝ)) {j : ℕ}
    (hgapR : (p.R : ℝ) * p.s (j - 1) ≤ p.s j) {u w : Zd d}
    (hw : latPt (p.s (j - 1)) w ∈ obox (latPt (p.s j) u) (p.s j))
    (h : SameIncr H H' (p.n - p.a j) (cbox (latPt (p.s j) u) (5 * p.s j))) :
    NiceCEvent p H j u w ↔ NiceCEvent p H' j u w := by
  have hsj := p.s_pos j
  have hsj1 := p.s_pos (j - 1)
  have hq : p.n - p.a j ≤ p.n - p.a (j - 1) := Nat.sub_le_sub_left (hmono (Nat.sub_le j 1)) _
  have hzbox : cbox (latPt (p.s (j - 1)) w) (4 * p.R * p.s (j - 1)) ⊆
      cbox (latPt (p.s j) u) (5 * p.s j) := by
    refine (cbox_subset_cbox_of_mem_obox hw).trans fun z hz k => (hz k).trans ?_
    nlinarith
  have hshell : cbox (latPt (p.s j) u) (4 * p.s j) ⊆ cbox (latPt (p.s j) u) (5 * p.s j) :=
    fun z hz k => (hz k).trans (by linarith)
  unfold NiceCEvent
  refine and_congr ?_ (and_congr (niceCert_congr p hR hq hzbox h) ?_)
  · rw [acrossDist_congr (φ := fun z => H p.n z - H (p.n - p.a j) z)
      (ψ := fun z => H' p.n z - H' (p.n - p.a j) z) ((hc _).sub (hc _)) ((hc' _).sub (hc' _))
      (by linarith) fun z hz => h.sub_eq (Nat.sub_le _ _) le_rfl (hshell hz.1)]
  · refine forall₂_congr fun z hz => ?_
    rw [h.sub_eq hq le_rfl (hzbox hz)]

/-- **Locality of the status of a box** (MA7 D-5.3, Remark 5.4′(i), deterministic form): the
status of the `a_j`-box at `s_j u` is the same for two families with the same increments above
`n - a_j` on `B̄_{5 s_j}(s_j u)`. -/
theorem niceBox_congr (hmono : Monotone p.a) (hc : ∀ q, Continuous (H q))
    (hc' : ∀ q, Continuous (H' q)) (hR : 4 ≤ (p.R : ℝ)) :
    ∀ (j : ℕ), (∀ i, 2 ≤ i → i ≤ j → 8 * p.s (i - 1) ≤ p.s i ∧ (p.R : ℝ) * p.s (i - 1) ≤ p.s i) →
      ∀ (u : Zd d), SameIncr H H' (p.n - p.a j) (cbox (latPt (p.s j) u) (5 * p.s j)) →
        (NiceBox p H j u ↔ NiceBox p H' j u)
  | 0, _, _, _ => Iff.rfl
  | 1, _, _, h => and_congr (niceOscOne_congr p hmono h) (niceAcrossOne_congr p hmono hc hc' h)
  | j + 2, hgap, u, h => by
      have hgj : 8 * p.s (j + 1) ≤ p.s (j + 2) ∧ (p.R : ℝ) * p.s (j + 1) ≤ p.s (j + 2) :=
        hgap (j + 2) le_add_self le_rfl
      have ih := niceBox_congr hmono hc hc' hR (j + 1) fun i hi hij => hgap i hi (by omega)
      have hs1 := p.s_pos (j + 1)
      have hq : p.n - p.a (j + 2) ≤ p.n - p.a (j + 1) :=
        Nat.sub_le_sub_left (hmono (Nat.le_succ _)) _
      have hsub : ∀ v : Zd d, obox (latPt (p.s (j + 1)) v) (p.s (j + 1)) ⊆
          obox (latPt (p.s (j + 2)) u) (p.s (j + 2)) →
          SameIncr H H' (p.n - p.a (j + 1)) (cbox (latPt (p.s (j + 1)) v) (5 * p.s (j + 1))) := by
        intro v hv
        refine h.mono hq ((cbox_subset_of_obox_subset hs1 hv _).trans fun z hz k =>
          (hz k).trans ?_)
        linarith [hgj.1]
      have hstat : ∀ v : Zd d, obox (latPt (p.s (j + 1)) v) (p.s (j + 1)) ⊆
          obox (latPt (p.s (j + 2)) u) (p.s (j + 2)) →
          (NiceBox p H (j + 1) v ↔ NiceBox p H' (j + 1) v) := fun v hv => ih v (hsub v hv)
      rw [niceBox_add_two_iff, niceBox_add_two_iff]
      refine and_congr (niceOscCond_congr p hmono (by omega) hgj.1 h) (or_congr ?_ ?_)
      · exact forall_congr' fun v => forall_congr' fun hv => hstat v hv
      · refine exists_congr fun w => and_congr_right fun hw => and_congr ?_ ?_
        · refine forall_congr' fun v => forall_congr' fun hv => ?_
          rw [hstat v hv]
        · exact niceCEvent_congr p hmono hc hc' hR hgj.2 hw h

end Congr

/-! ## Generic measurability -/

section Measurability

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The oscillation event `osc_B X ≤ t` is measurable. -/
theorem measurable_forall_abs_sub_le {X : Rd d → Ω → ℝ} (hc : ∀ ω, Continuous fun z => X z ω)
    {B : Set (Rd d)} (hm : ∀ z ∈ B, Measurable (X z)) (t : ℝ) :
    Measurable fun ω => ∀ z ∈ B, ∀ w ∈ B, |X z ω - X w ω| ≤ t := by
  have h := (measurableSet_exists_lt_abs_sub hc hm t).compl
  have e : {ω | ∃ z ∈ B, ∃ w ∈ B, t < |X z ω - X w ω|}ᶜ =
      {ω | ∀ z ∈ B, ∀ w ∈ B, |X z ω - X w ω| ≤ t} := by
    ext ω
    simp only [mem_compl_iff, mem_ofPred_eq, not_exists, not_and, not_lt]
  rw [e] at h
  exact measurableSet_setOfPred.1 h

/-- The supremum event `X ≤ t` on `B` is measurable. -/
theorem measurable_forall_le {X : Rd d → Ω → ℝ} (hc : ∀ ω, Continuous fun z => X z ω)
    {B : Set (Rd d)} (hm : ∀ z ∈ B, Measurable (X z)) (t : ℝ) :
    Measurable fun ω => ∀ z ∈ B, X z ω ≤ t := by
  have h := (measurableSet_exists_lt hc hm t).compl
  have e : {ω | ∃ z ∈ B, t < X z ω}ᶜ = {ω | ∀ z ∈ B, X z ω ≤ t} := by
    ext ω
    simp only [mem_compl_iff, mem_ofPred_eq, not_exists, not_and, not_lt]
  rw [e] at h
  exact measurableSet_setOfPred.1 h

variable {H : ℕ → Rd d → Ω → ℝ} (hc : ∀ q ω, Continuous fun z => H q z ω)
  (hm : ∀ q z, Measurable (H q z))
include hc hm

theorem measurable_niceOscOne (p : NiceParams) (u : Zd d) :
    Measurable fun ω => NiceOscOne p (fun q z => H q z ω) u := by
  unfold NiceOscOne
  refine Measurable.forall fun v => measurable_const.imp ?_
  exact measurable_forall_abs_sub_le (X := fun z ω => H p.n z ω - H (p.n - p.a 1) z ω)
    (fun ω => (hc _ ω).sub (hc _ ω)) (fun z _ => (hm _ z).sub (hm _ z)) p.L

theorem measurable_niceAcrossOne (p : NiceParams) (u : Zd d) :
    Measurable fun ω => NiceAcrossOne p (fun q z => H q z ω) u := by
  unfold NiceAcrossOne
  refine Measurable.forall fun v => measurable_const.imp ?_
  refine measurableSet_setOfPred.1 (measurableSet_lt measurable_const ?_)
  exact measurable_acrossDist (H := fun z ω => H (p.n + p.k) z ω - H p.n z ω)
    (fun ω => (hc _ ω).sub (hc _ ω)) (fun z => (hm _ z).sub (hm _ z)) _ _ _ _

theorem measurable_niceOscCond (p : NiceParams) (j : ℕ) (u : Zd d) :
    Measurable fun ω => NiceOscCond p (fun q z => H q z ω) j u := by
  unfold NiceOscCond
  refine Measurable.forall fun i => measurable_const.imp ?_
  refine Measurable.forall fun v => measurable_const.imp ?_
  exact measurable_forall_abs_sub_le
    (X := fun z ω => H (p.n - p.a (j - 1)) z ω - H (p.n - p.a j) z ω)
    (fun ω => (hc _ ω).sub (hc _ ω)) (fun z _ => (hm _ z).sub (hm _ z)) _

theorem measurable_niceCert (p : NiceParams) (i : ℕ) (z : Rd d) :
    Measurable fun ω => NiceCert p (fun q z => H q z ω) i z := by
  have hcont : ∀ q ω, Continuous fun w : Rd d => H q (z + p.s i • w) ω := fun q ω =>
    (hc q ω).comp (continuous_const.add (continuous_const_smul _))
  refine measurableSet_setOfPred.1 ?_
  exact measurableSet_aroundCertAt
    (ψ := fun w ω => H (p.certIdx i) (z + p.s i • w) ω - H (p.n - p.a i) (z + p.s i • w) ω)
    (g := fun w ω => H p.n (z + p.s i • w) ω - H (p.certIdx i) (z + p.s i • w) ω)
    (fun ω => (hcont _ ω).sub (hcont _ ω)) (fun w => (hm _ _).sub (hm _ _))
    (fun ω => (hcont _ ω).sub (hcont _ ω)) (fun w => (hm _ _).sub (hm _ _)) _ _ _ _ _ _

theorem measurable_niceCEvent (p : NiceParams) (j : ℕ) (u w : Zd d) :
    Measurable fun ω => NiceCEvent p (fun q z => H q z ω) j u w := by
  unfold NiceCEvent
  refine Measurable.and ?_ (Measurable.and (measurable_niceCert hc hm p _ _) ?_)
  · refine measurableSet_setOfPred.1 (measurableSet_lt measurable_const ?_)
    exact measurable_acrossDist (H := fun z ω => H p.n z ω - H (p.n - p.a j) z ω)
      (fun ω => (hc _ ω).sub (hc _ ω)) (fun z => (hm _ z).sub (hm _ z)) _ _ _ _
  · exact measurable_forall_le (X := fun z ω => H (p.n - p.a (j - 1)) z ω - H (p.n - p.a j) z ω)
      (fun ω => (hc _ ω).sub (hc _ ω)) (fun z _ => (hm _ z).sub (hm _ z)) _

/-- **Measurability of nice boxes** (target `measurable_niceBox`; MA7 D-5.3, Remark 5.4′(i)):
for a random family with continuous paths and measurable values, the status of every box is a
measurable function of `ω`. -/
theorem measurable_niceBox (p : NiceParams) :
    ∀ (j : ℕ) (u : Zd d), Measurable fun ω => NiceBox p (fun q z => H q z ω) j u
  | 0, _ => measurable_const
  | 1, u => (measurable_niceOscOne hc hm p u).and (measurable_niceAcrossOne hc hm p u)
  | j + 2, u => by
      have ih := measurable_niceBox p (j + 1)
      refine (measurable_niceOscCond hc hm p (j + 2) u).and (Measurable.or ?_ ?_)
      · exact Measurable.forall fun v => measurable_const.imp (ih v)
      · refine Measurable.exists fun w => measurable_const.and (Measurable.and ?_ ?_)
        · exact Measurable.forall fun v => measurable_const.imp ((ih v).not.imp measurable_const)
        · exact measurable_niceCEvent hc hm p (j + 2) u w

theorem measurableSet_niceBox (p : NiceParams) (j : ℕ) (u : Zd d) :
    MeasurableSet {ω | NiceBox p (fun q z => H q z ω) j u} :=
  measurableSet_setOfPred.2 (measurable_niceBox hc hm p j u)

/-- `𝒥₁` is measurable. -/
theorem measurable_eventJ1 (p : NiceParams) (m : ℕ) :
    Measurable fun ω => EventJ1 p (fun q z => H q z ω) m :=
  Measurable.forall fun u => measurable_const.imp (measurable_niceBox hc hm p m u)

/-- `𝒥₂′` is measurable. -/
theorem measurable_eventJ2' (p : NiceParams) (m : ℕ) :
    Measurable fun ω => EventJ2' p (fun q z => H q z ω) m := by
  unfold EventJ2'
  refine Measurable.forall fun i => measurable_const.imp ?_
  refine Measurable.forall fun v => measurable_const.imp ?_
  exact measurable_forall_abs_sub_le (X := fun z ω => H (p.n - p.a m) z ω)
    (fun ω => hc _ ω) (fun z _ => hm _ z) _

end Measurability

/-! ## The band σ-algebras and the locality of nice boxes -/

section Local

variable {Ω : Type*}

set_option warn.classDefReducibility false in
/-- **The σ-algebra of the bands below the scale `2^{-p₀}` on `B`**: generated by the restrictions
to `B` of `h_{p₀, p₀+q} = H (p₀+q) - H p₀`, `q ∈ ℕ`. For a dyadic realization these are versions of
`H_{2^{-p₀-q}, 2^{-p₀}}`, so `bandSigma H p₀ B` is generated by (modifications of) the white noise
on `(0, 2^{-p₀}) × (B + B(0, ρ 2^{-p₀}))` (`ρ` a support radius of the kernel). -/
def bandSigma (H : ℕ → Rd d → Ω → ℝ) (p₀ : ℕ) (B : Set (Rd d)) : MeasurableSpace Ω :=
  ⨆ q : ℕ, MeasurableSpace.comap (fun ω (z : B) => H (p₀ + q) z ω - H p₀ z ω) MeasurableSpace.pi

variable {H : ℕ → Rd d → Ω → ℝ}

theorem measurable_bandSigma {p₀ q : ℕ} (hq : p₀ ≤ q) {B : Set (Rd d)} {z : Rd d} (hz : z ∈ B) :
    Measurable[bandSigma H p₀ B] fun ω => H q z ω - H p₀ z ω := by
  obtain ⟨q', rfl⟩ := Nat.exists_eq_add_of_le hq
  have h1 : Measurable[MeasurableSpace.comap (fun ω (z : B) => H (p₀ + q') z ω - H p₀ z ω)
      MeasurableSpace.pi] fun ω => H (p₀ + q') z ω - H p₀ z ω :=
    (measurable_pi_apply (⟨z, hz⟩ : B)).comp
      (comap_measurable (fun ω (z : B) => H (p₀ + q') z ω - H p₀ z ω))
  exact h1.mono (le_iSup (fun q : ℕ => MeasurableSpace.comap
    (fun ω (z : B) => H (p₀ + q) z ω - H p₀ z ω) MeasurableSpace.pi) q') le_rfl

theorem measurable_bandSigma_sub {p₀ q q' : ℕ} (hq : p₀ ≤ q) (hq' : p₀ ≤ q') {B : Set (Rd d)}
    {z : Rd d} (hz : z ∈ B) : Measurable[bandSigma H p₀ B] fun ω => H q z ω - H q' z ω := by
  have e : (fun ω => H q z ω - H q' z ω) =
      fun ω => (H q z ω - H p₀ z ω) - (H q' z ω - H p₀ z ω) := by
    funext ω
    ring
  rw [e]
  exact (measurable_bandSigma (H := H) hq hz).sub (measurable_bandSigma (H := H) hq' hz)

theorem bandSigma_le_of_measurable {p₀ : ℕ} {B : Set (Rd d)} {m : MeasurableSpace Ω}
    (h : ∀ q, p₀ ≤ q → ∀ z ∈ B, Measurable[m] fun ω => H q z ω - H p₀ z ω) :
    bandSigma H p₀ B ≤ m := by
  refine iSup_le fun q => Measurable.comap_le ?_
  exact measurable_pi_iff.2 fun z => h (p₀ + q) (Nat.le_add_right _ _) z z.2

/-- Monotonicity of `bandSigma` in the set. -/
theorem bandSigma_mono_set {p₀ : ℕ} {B B' : Set (Rd d)} (hB : B ⊆ B') :
    bandSigma H p₀ B ≤ bandSigma H p₀ B' :=
  bandSigma_le_of_measurable fun _ hq _ hz => measurable_bandSigma hq (hB hz)

/-- Monotonicity of `bandSigma` in the base level: the bands below `2^{-p₁}` are bands below
`2^{-p₀}` (`p₀ ≤ p₁`). -/
theorem bandSigma_mono_base {p₀ p₁ : ℕ} (hp : p₀ ≤ p₁) {B : Set (Rd d)} :
    bandSigma H p₁ B ≤ bandSigma H p₀ B :=
  bandSigma_le_of_measurable fun _ hq _ hz => measurable_bandSigma_sub (hp.trans hq) hp hz

/-- **Locality of nice boxes** (target `niceBox_local`; MA7 D-5.3, Remark 5.4′(i), blueprint
`r2:lem:54`(i)): the status of the `a_j`-box at `s_j u` is measurable for the σ-algebra of the bands
below `s_j` on `B̄_{5 s_j}(s_j u)`, provided `a` is monotone, `R ≥ 4`, and `8 s_{i-1} ≤ s_i`,
`R s_{i-1} ≤ s_i` for `2 ≤ i ≤ j`. -/
theorem niceBox_local (hc : ∀ q ω, Continuous fun z => H q z ω) (p : NiceParams)
    (hmono : Monotone p.a) (hR : 4 ≤ (p.R : ℝ)) {j : ℕ}
    (hgap : ∀ i, 2 ≤ i → i ≤ j → 8 * p.s (i - 1) ≤ p.s i ∧ (p.R : ℝ) * p.s (i - 1) ≤ p.s i)
    (u : Zd d) :
    MeasurableSet[bandSigma H (p.n - p.a j) (cbox (latPt (p.s j) u) (5 * p.s j))]
      {ω | NiceBox p (fun q z => H q z ω) j u} := by
  set p₀ := p.n - p.a j with hp₀
  set c := latPt (p.s j) u with hcdef
  set r := 5 * p.s j with hr
  have hr0 : 0 ≤ r := by rw [hr]; linarith [p.s_pos j]
  let mΩ : MeasurableSpace Ω := bandSigma H p₀ (cbox c r)
  set Ht : ℕ → Rd d → Ω → ℝ := fun q z ω =>
    H (max q p₀) (HigherDimLFPP.DGZ.clampBox c r z) ω -
      H p₀ (HigherDimLFPP.DGZ.clampBox c r z) ω with hHt
  have hct : ∀ q ω, Continuous fun z => Ht q z ω := fun q ω =>
    ((hc _ ω).comp (HigherDimLFPP.DGZ.continuous_clampBox _ _)).sub
      ((hc _ ω).comp (HigherDimLFPP.DGZ.continuous_clampBox _ _))
  have hmt : ∀ q z, Measurable (Ht q z) := fun q z =>
    measurable_bandSigma (le_max_right q p₀) (HigherDimLFPP.DGZ.clampBox_mem c hr0 z)
  have hmeas := measurableSet_niceBox hct hmt p j u
  have hcont : ∀ ω q, Continuous (fun z => H q z ω) := fun ω q => hc q ω
  have hcont' : ∀ ω q, Continuous (fun z => Ht q z ω) := fun ω q => hct q ω
  have heq : {ω | NiceBox p (fun q z => H q z ω) j u} =
      {ω | NiceBox p (fun q z => Ht q z ω) j u} := by
    ext ω
    refine niceBox_congr p hmono (hcont ω) (hcont' ω) hR j hgap u fun q hq z hz => ?_
    simp only [hHt, hp₀, hcdef, hr, HigherDimLFPP.DGZ.clampBox_of_mem hz, max_eq_left hq,
      max_self, sub_self, sub_zero]
  rw [heq]
  exact hmeas

end Local

end DGZ

end HigherDimLQGMetric
