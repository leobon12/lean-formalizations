import HigherDimLFPP.Frozen.Rd
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real
import Mathlib.MeasureTheory.MeasurableSpace.Pi
import Mathlib.Topology.Bases

/-!
# Measurability and locality of the field-tail events (packet L3b2; supports MA7 D-OSC, D-5.3)

Source: planning audit `planning/audits/MA7-ref2-sections-4-6.md`, Details (a) D-OSC (the
oscillation conditions (1′), (a′), `𝒥₂′`) and D-5.3 (Remark 5.4′: "the status of an `a_i`-box at
`x` is a measurable function of the band versions restricted to `B_{5s_i}(x)`"). The probability
bounds of `FieldTails.lean` and `FieldTailsOsc.lean` are stated with outer measures, so they need no
measurability; the events built from them in Definition 5.3′ do. For a random field `X` with
continuous realizations, the events

* `{ω | ∃ z ∈ B, ∃ w ∈ B, t < |X z ω - X w ω|}` (oscillation on `B` exceeds `t`),
* `{ω | ∃ z ∈ B, t < X z ω}` and `{ω | ∃ z ∈ B, t < |X z ω|}` (supremum on `B` exceeds `t`)

are countable unions over a countable dense subset of `B` (`setOf_exists_lt_abs_sub_eq` and its
companions), hence measurable for every σ-algebra on `Ω` (taken as the instance) for which the
values `X z`, `z ∈ B`, are measurable (`measurableSet_exists_lt_abs_sub`, `measurableSet_exists_lt`,
`measurableSet_exists_lt_abs`). With `measurable_eval_comap_restrict` this gives locality: the
events are measurable for the σ-algebra generated by the field on any `B' ⊇ B`.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory Set Filter Topology

namespace HigherDimLQGMetric.DGZ

open HigherDimLFPP

variable {d : ℕ} {Ω : Type*} {X : Rd d → Ω → ℝ}

/-! ### Countable dense reduction -/

/-- **Oscillation events through a countable dense set**: if every realization of `X` is
continuous, `T ⊆ B` and `B ⊆ closure T`, then the event that the oscillation of `X` on `B` exceeds
`t` is the union over pairs of points of `T`. -/
theorem setOf_exists_lt_abs_sub_eq (hc : ∀ ω, Continuous fun z => X z ω) {B T : Set (Rd d)}
    (hTB : T ⊆ B) (hBT : B ⊆ closure T) (t : ℝ) :
    {ω | ∃ z ∈ B, ∃ w ∈ B, t < |X z ω - X w ω|} =
      ⋃ z ∈ T, ⋃ w ∈ T, {ω | t < |X z ω - X w ω|} := by
  ext ω
  simp only [mem_ofPred_eq, mem_iUnion, exists_prop]
  constructor
  · rintro ⟨z, hz, w, hw, hlt⟩
    set f : Rd d × Rd d → ℝ := fun p => |X p.1 ω - X p.2 ω| with hf
    have hfc : Continuous f :=
      (((hc ω).comp continuous_fst).sub ((hc ω).comp continuous_snd)).abs
    have hopen : IsOpen (f ⁻¹' Ioi t) := isOpen_Ioi.preimage hfc
    have hmem : (z, w) ∈ closure (T ×ˢ T) := by
      rw [closure_prod_eq]
      exact ⟨hBT hz, hBT hw⟩
    obtain ⟨p, hpU, hpT⟩ := mem_closure_iff.1 hmem _ hopen hlt
    exact ⟨p.1, hpT.1, p.2, hpT.2, hpU⟩
  · rintro ⟨z, hz, w, hw, hlt⟩
    exact ⟨z, hTB hz, w, hTB hw, hlt⟩

/-- **Supremum events through a countable dense set** (one-sided). -/
theorem setOf_exists_lt_eq (hc : ∀ ω, Continuous fun z => X z ω) {B T : Set (Rd d)}
    (hTB : T ⊆ B) (hBT : B ⊆ closure T) (t : ℝ) :
    {ω | ∃ z ∈ B, t < X z ω} = ⋃ z ∈ T, {ω | t < X z ω} := by
  ext ω
  simp only [mem_ofPred_eq, mem_iUnion, exists_prop]
  constructor
  · rintro ⟨z, hz, hlt⟩
    obtain ⟨p, hpU, hpT⟩ :=
      mem_closure_iff.1 (hBT hz) _ (isOpen_Ioi.preimage (hc ω)) hlt
    exact ⟨p, hpT, hpU⟩
  · rintro ⟨z, hz, hlt⟩
    exact ⟨z, hTB hz, hlt⟩

/-- **Supremum events through a countable dense set** (two-sided). -/
theorem setOf_exists_lt_abs_eq (hc : ∀ ω, Continuous fun z => X z ω) {B T : Set (Rd d)}
    (hTB : T ⊆ B) (hBT : B ⊆ closure T) (t : ℝ) :
    {ω | ∃ z ∈ B, t < |X z ω|} = ⋃ z ∈ T, {ω | t < |X z ω|} := by
  ext ω
  simp only [mem_ofPred_eq, mem_iUnion, exists_prop]
  constructor
  · rintro ⟨z, hz, hlt⟩
    obtain ⟨p, hpU, hpT⟩ :=
      mem_closure_iff.1 (hBT hz) _ (isOpen_Ioi.preimage (hc ω).abs) hlt
    exact ⟨p, hpT, hpU⟩
  · rintro ⟨z, hz, hlt⟩
    exact ⟨z, hTB hz, hlt⟩

/-- Every subset of `ℝ^d` has a countable dense subset. -/
theorem exists_countable_subset_dense (B : Set (Rd d)) :
    ∃ T ⊆ B, T.Countable ∧ B ⊆ closure T := by
  obtain ⟨T, hTc, hTB, hBT⟩ := TopologicalSpace.exists_countable_dense_subset B
  exact ⟨T, hTB, hTc, hBT⟩

/-! ### Measurability -/

section Meas

variable [MeasurableSpace Ω]

/-- **Measurability of oscillation events** (MA7 D-OSC, D-5.3): if every realization of `X` is
continuous and every `X z`, `z ∈ B`, is measurable, then `{ω | osc_B X(·, ω) > t}` is measurable
(for any σ-algebra on `Ω`, taken as the instance). -/
theorem measurableSet_exists_lt_abs_sub (hc : ∀ ω, Continuous fun z => X z ω) {B : Set (Rd d)}
    (hm : ∀ z ∈ B, Measurable (X z)) (t : ℝ) :
    MeasurableSet {ω | ∃ z ∈ B, ∃ w ∈ B, t < |X z ω - X w ω|} := by
  obtain ⟨T, hTB, hTc, hBT⟩ := exists_countable_subset_dense B
  rw [setOf_exists_lt_abs_sub_eq hc hTB hBT t]
  exact MeasurableSet.biUnion hTc fun z hz => MeasurableSet.biUnion hTc fun w hw =>
    measurableSet_lt measurable_const
      (continuous_abs.measurable.comp ((hm z (hTB hz)).sub (hm w (hTB hw))))

/-- **Measurability of supremum events** (one-sided; the event `𝒢_nᶜ` and the sup conditions of
D-5.3): `{ω | sup_B X(·, ω) > t}` is measurable. -/
theorem measurableSet_exists_lt (hc : ∀ ω, Continuous fun z => X z ω) {B : Set (Rd d)}
    (hm : ∀ z ∈ B, Measurable (X z)) (t : ℝ) :
    MeasurableSet {ω | ∃ z ∈ B, t < X z ω} := by
  obtain ⟨T, hTB, hTc, hBT⟩ := exists_countable_subset_dense B
  rw [setOf_exists_lt_eq hc hTB hBT t]
  exact MeasurableSet.biUnion hTc fun z hz => measurableSet_lt measurable_const (hm z (hTB hz))

/-- **Measurability of supremum events** (two-sided): `{ω | sup_B |X(·, ω)| > t}` is measurable. -/
theorem measurableSet_exists_lt_abs (hc : ∀ ω, Continuous fun z => X z ω) {B : Set (Rd d)}
    (hm : ∀ z ∈ B, Measurable (X z)) (t : ℝ) :
    MeasurableSet {ω | ∃ z ∈ B, t < |X z ω|} := by
  obtain ⟨T, hTB, hTc, hBT⟩ := exists_countable_subset_dense B
  rw [setOf_exists_lt_abs_eq hc hTB hBT t]
  exact MeasurableSet.biUnion hTc fun z hz =>
    measurableSet_lt measurable_const (continuous_abs.measurable.comp (hm z (hTB hz)))

end Meas

/-! ### Locality -/

/-- **Locality**: each value `X z`, `z ∈ B'`, is measurable for the σ-algebra generated by the
restriction of the field to `B'`. Combined with the lemmas above, the oscillation and supremum
events on `B ⊆ B'` are measurable for that σ-algebra (MA7 D-5.3, Remark 5.4′). -/
theorem measurable_eval_comap_restrict (X : Rd d → Ω → ℝ) {B' : Set (Rd d)} {z : Rd d}
    (hz : z ∈ B') :
    Measurable[MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi] (X z) := by
  set Y : Ω → B' → ℝ := fun ω y => X y ω with hY
  exact (measurable_pi_apply (⟨z, hz⟩ : B')).comp (comap_measurable Y)

/-- **Locality of oscillation events**: for `B ⊆ B'`, the event `{osc_B X > t}` is measurable for
the σ-algebra generated by the field on `B'`. -/
theorem measurableSet_exists_lt_abs_sub_comap (hc : ∀ ω, Continuous fun z => X z ω)
    {B B' : Set (Rd d)} (hBB' : B ⊆ B') (t : ℝ) :
    MeasurableSet[MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi]
      {ω | ∃ z ∈ B, ∃ w ∈ B, t < |X z ω - X w ω|} := by
  let mΩ : MeasurableSpace Ω := MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi
  exact measurableSet_exists_lt_abs_sub hc
    (fun _z hz => measurable_eval_comap_restrict X (hBB' hz)) t

/-- **Locality of supremum events**: for `B ⊆ B'`, the events `{sup_B X > t}` and
`{sup_B |X| > t}` are measurable for the σ-algebra generated by the field on `B'`. -/
theorem measurableSet_exists_lt_comap (hc : ∀ ω, Continuous fun z => X z ω)
    {B B' : Set (Rd d)} (hBB' : B ⊆ B') (t : ℝ) :
    MeasurableSet[MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi]
        {ω | ∃ z ∈ B, t < X z ω} ∧
      MeasurableSet[MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi]
        {ω | ∃ z ∈ B, t < |X z ω|} := by
  let mΩ : MeasurableSpace Ω := MeasurableSpace.comap (fun ω (y : B') => X y ω) MeasurableSpace.pi
  exact ⟨measurableSet_exists_lt hc (fun _z hz => measurable_eval_comap_restrict X (hBB' hz)) t,
    measurableSet_exists_lt_abs hc (fun _z hz => measurable_eval_comap_restrict X (hBB' hz)) t⟩

end HigherDimLQGMetric.DGZ
