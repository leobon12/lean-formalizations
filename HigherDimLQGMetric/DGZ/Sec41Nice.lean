import HigherDimLQGMetric.DGZ.Sec41Defs
import HigherDimLQGMetric.DGZ.FunctionalsMeas
import HigherDimLFPP.Field.FiniteRange
import HigherDimLFPP.Perc.Clusters

/-!
# DGZ §4.1: the rough-site percolation (packet L3c1; MA7 D-4.2)

Source: Ding–Gwynne–Zhuang, arXiv:2310.03996v5 ([2]), proof of Lemma 4.2(1), TeX l. 1452–1459
(`P[x is m-nice] ≥ 1 - 2d(1 + 3^d)(1 - q)` and the `M`-dependence of the nice/rough statuses);
planning audit `planning/audits/MA7-ref2-sections-4-6.md`, Details (a) D-4.2 ("niceness depends on
the field on `B̄_{3·2^{1-m}}(y)`, so the product bound holds").

For versions `G₁` of `h_{m-1,n} = H_{a, 2^{1-m}}` and `G₂` of `h_{m,n} = H_{a, 2^{-m}}` over one
white noise (`m ≥ 1`), the event `roughSite ξ G₁ G₂ m a₁ a₂ y` that the coarse site `y` is *rough*
(not nice) is
`y ∈ 𝓛_{m-1} ∧ (y is (m-1)-bad for G₁ ∨ some fine z with |z - 2y|_∞ ≤ 1 is m-bad for G₂)`.

* `setOf_not_mem_roughSite`: `{y | ω ∉ roughSite … y} = mNice ξ G₁(·, ω) G₂(·, ω) m a₁ a₂`;
* `measure_roughSite_le`: if every bad event has probability `≤ ε`, every rough event has
  probability `≤ (1 + 3^d) ε` (union bound over the `3^d` fine sites);
* `productBound_roughSite` (DGZ's `M`-dependence for the nice configuration): the rough events
  satisfy `Perc.ProductBound` with range `M = ⌈2(2 + ρ)⌉` (`ρ` a support radius of `κ`).

Proof of the product bound (step added beyond MA7, which only says "niceness depends on the field
on `B̄_{3·2^{1-m}}(y)`"). The rough event at `y` is measurable for the σ-algebra generated by *both*
fields on the box `A y = B̄_{2·2^{1-m}}(2^{1-m} y)`: the `(m-1)`-bad event at `y` sees `G₁` on
`A y` (HigherDimLFPP `measurableSet_closedSite_comap`), the `m`-bad event at a fine `z` with
`|z - 2y|_∞ ≤ 1` sees `G₂` on `B̄_{2·2^{-m}}(2^{-m} z) ⊆ A y`. Encode the pair of restricted fields
as one family indexed by `A y ⊕ A y`; its values are modifications of the white-noise values of the
band vectors `k_{a,2^{1-m},z}` and `k_{a,2^{-m},z}`. For coarse sites at lattice distance `> M`, the
boxes are at Euclidean distance `≥ 2^{1-m}(M - 3) ≥ 2ρ · 2^{1-m}`, so all cross inner products
vanish
(`inner_bandVec_eq_zero_of_two_mul_min_le`, `min(b, b') ≤ 2^{1-m}`) and the families are mutually
independent (`IsWhiteNoise.iIndepFun_of_ae_eq`); the product formula follows.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal RealInnerProductSpace

namespace HigherDimLQGMetric

namespace DGZ

open HigherDimLFPP HigherDimLFPP.Perc
open HigherDimLFPP.DGZ (latPt cbox obox SiteClosed closedSite)

variable {d : ℕ}

/-- the event that the coarse site `y` (mesh `2^{1-m}`) is `m`-rough, i.e. not `m`-nice, for the
fields `G₁` (`= h_{m-1,n}`, level `a₁`) and `G₂` (`= h_{m,n}`, level `a₂`) -/
def roughSite {Ω : Type*} (ξ : ℝ) (G₁ G₂ : Rd d → Ω → ℝ) (m : ℕ) (a₁ a₂ : ℝ) (y : Zd d) :
    Set Ω :=
  {ω | y ∈ latRegion (m - 1) ∧
    (ω ∈ closedSite ξ G₁ ((2 : ℝ)⁻¹ ^ (m - 1)) a₁ (2 - (2 : ℝ)⁻¹ ^ (m - 1)) y ∨
      ∃ z : Zd d, WithinInf 1 z (2 • y) ∧
        ω ∈ closedSite ξ G₂ ((2 : ℝ)⁻¹ ^ m) a₂ (2 - (2 : ℝ)⁻¹ ^ m) z)}

section Basic

variable {Ω : Type*} {ξ : ℝ} {G₁ G₂ : Rd d → Ω → ℝ} {m : ℕ} {a₁ a₂ : ℝ}

/-- The sites that are not rough form the nice configuration. -/
theorem setOf_not_mem_roughSite (ω : Ω) :
    {y | ω ∉ roughSite ξ G₁ G₂ m a₁ a₂ y} =
      mNice ξ (fun z => G₁ z ω) (fun z => G₂ z ω) m a₁ a₂ := by
  ext y
  simp only [roughSite, closedSite, mNice, mGood, mem_ofPred_eq, not_and, not_or, not_exists]

end Basic

section Prob

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {ξ : ℝ} {G₁ G₂ : Rd d → Ω → ℝ}
  {m : ℕ} {a₁ a₂ : ℝ}

/-- **Probability of a rough site** (DGZ l. 1454–1458): if every `(m-1)`-bad event and every
`m`-bad event has probability `≤ ε`, every rough event has probability `≤ (1 + 3^d) ε`. -/
theorem measure_roughSite_le {ε : ℝ≥0∞}
    (h₁ : ∀ y, P (closedSite ξ G₁ ((2 : ℝ)⁻¹ ^ (m - 1)) a₁ (2 - (2 : ℝ)⁻¹ ^ (m - 1)) y) ≤ ε)
    (h₂ : ∀ z, P (closedSite ξ G₂ ((2 : ℝ)⁻¹ ^ m) a₂ (2 - (2 : ℝ)⁻¹ ^ m) z) ≤ ε) (y : Zd d) :
    P (roughSite ξ G₁ G₂ m a₁ a₂ y) ≤ (1 + 3 ^ d) * ε := by
  classical
  have hsub : roughSite ξ G₁ G₂ m a₁ a₂ y ⊆
      closedSite ξ G₁ ((2 : ℝ)⁻¹ ^ (m - 1)) a₁ (2 - (2 : ℝ)⁻¹ ^ (m - 1)) y ∪
        ⋃ z ∈ boxF (2 • y) 1, closedSite ξ G₂ ((2 : ℝ)⁻¹ ^ m) a₂ (2 - (2 : ℝ)⁻¹ ^ m) z := by
    rintro ω ⟨-, h | ⟨z, hz, hω⟩⟩
    · exact Or.inl h
    · exact Or.inr (mem_iUnion₂.2 ⟨z, mem_boxF.2 (by exact_mod_cast hz), hω⟩)
  calc P (roughSite ξ G₁ G₂ m a₁ a₂ y)
      ≤ P (closedSite ξ G₁ ((2 : ℝ)⁻¹ ^ (m - 1)) a₁ (2 - (2 : ℝ)⁻¹ ^ (m - 1)) y) +
          P (⋃ z ∈ boxF (2 • y) 1,
            closedSite ξ G₂ ((2 : ℝ)⁻¹ ^ m) a₂ (2 - (2 : ℝ)⁻¹ ^ m) z) :=
        (measure_mono hsub).trans (measure_union_le _ _)
    _ ≤ ε + ∑ _z ∈ boxF (2 • y) 1, ε :=
        add_le_add (h₁ y) ((measure_biUnion_finset_le _ _).trans
          (Finset.sum_le_sum fun z _ => h₂ z))
    _ = (1 + 3 ^ d) * ε := by
        rw [Finset.sum_const, nsmul_eq_mul, card_boxF_ennreal]
        norm_num
        ring

end Prob

section ProductBound

variable {κ : Rd d → ℝ} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {W : WN d → Ω → ℝ}

/-- `2^{-(m-1)} = 2 · 2^{-m}` for `m ≥ 1`. -/
lemma inv_two_pow_pred {m : ℕ} (hm : 1 ≤ m) :
    (2 : ℝ)⁻¹ ^ (m - 1) = 2 * (2 : ℝ)⁻¹ ^ m := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  rw [Nat.add_sub_cancel, pow_succ]
  field_simp

/-- For a fine site `z` with `|z - 2y|_∞ ≤ 1`, the box `B̄_{2·2^{-m}}(2^{-m} z)` lies in
`B̄_{2·2^{1-m}}(2^{1-m} y)`. -/
lemma cbox_fine_subset {m : ℕ} (hm : 1 ≤ m) {y z : Zd d} (hz : WithinInf 1 z (2 • y)) :
    cbox (latPt ((2 : ℝ)⁻¹ ^ m) z) (2 * (2 : ℝ)⁻¹ ^ m) ⊆
      cbox (latPt ((2 : ℝ)⁻¹ ^ (m - 1)) y) (2 * (2 : ℝ)⁻¹ ^ (m - 1)) := by
  intro w hw i
  have hs : (0 : ℝ) < (2 : ℝ)⁻¹ ^ m := by positivity
  have h1 : |w i - latPt ((2 : ℝ)⁻¹ ^ m) z i| ≤ 2 * (2 : ℝ)⁻¹ ^ m := hw i
  have h2 : |((z i : ℤ) : ℝ) - 2 * ((y i : ℤ) : ℝ)| ≤ 1 := by
    have := hz i
    rw [two_smul_apply] at this
    have h := Int.cast_le (R := ℝ) |>.2 this
    push_cast at h
    exact h
  rw [HigherDimLFPP.DGZ.latPt_apply] at h1 ⊢
  rw [inv_two_pow_pred hm]
  have h3 : |(2 : ℝ)⁻¹ ^ m * (z i : ℝ) - 2 * (2 : ℝ)⁻¹ ^ m * (y i : ℝ)| ≤ (2 : ℝ)⁻¹ ^ m := by
    have e : (2 : ℝ)⁻¹ ^ m * (z i : ℝ) - 2 * (2 : ℝ)⁻¹ ^ m * (y i : ℝ) =
        (2 : ℝ)⁻¹ ^ m * ((z i : ℝ) - 2 * (y i : ℝ)) := by ring
    rw [e, abs_mul, abs_of_pos hs]
    exact mul_le_of_le_one_right hs.le h2
  calc |w i - 2 * (2 : ℝ)⁻¹ ^ m * (y i : ℝ)|
      = |(w i - (2 : ℝ)⁻¹ ^ m * (z i : ℝ)) +
          ((2 : ℝ)⁻¹ ^ m * (z i : ℝ) - 2 * (2 : ℝ)⁻¹ ^ m * (y i : ℝ))| := by ring_nf
    _ ≤ |w i - (2 : ℝ)⁻¹ ^ m * (z i : ℝ)| +
          |(2 : ℝ)⁻¹ ^ m * (z i : ℝ) - 2 * (2 : ℝ)⁻¹ ^ m * (y i : ℝ)| := abs_add_le _ _
    _ ≤ 2 * (2 * (2 : ℝ)⁻¹ ^ m) := by linarith

/-- **The product bound for the rough sites** (DGZ's `M`-dependence for the nice configuration,
MA7 D-4.2): for versions `G₁` of `H_{a, 2^{1-m}}` and `G₂` of `H_{a, 2^{-m}}` over one white noise
(`a > 0`, `m ≥ 1`) and a support radius `ρ` of `κ`, the rough events satisfy `Perc.ProductBound`
with range `⌈2(2 + ρ)⌉`. -/
theorem productBound_roughSite (hκ : IsLFPPKernel κ) (hW : IsWhiteNoise P W) {ρ : ℝ}
    (hρ : ∀ y, ρ ≤ ‖y‖ → κ y = 0) {a : ℝ} (ha : 0 < a) {m : ℕ} (hm : 1 ≤ m)
    {G₁ G₂ : Rd d → Ω → ℝ} (hG₁ : IsBandVersion P W κ a ((2 : ℝ)⁻¹ ^ (m - 1)) G₁)
    (hG₂ : IsBandVersion P W κ a ((2 : ℝ)⁻¹ ^ m) G₂) (ξ a₁ a₂ : ℝ) :
    ProductBound P (roughSite ξ G₁ G₂ m a₁ a₂) ((⌈2 * (2 + ρ)⌉₊ : ℕ) : ℤ) := by
  intro S hS
  set M : ℕ := ⌈2 * (2 + ρ)⌉₊ with hMdef
  have hρ0 : 0 < ρ := hκ.radius_pos hρ
  have hM : 2 * (2 + ρ) ≤ (M : ℝ) := Nat.le_ceil _
  set s₁ : ℝ := (2 : ℝ)⁻¹ ^ (m - 1) with hs₁def
  set s₂ : ℝ := (2 : ℝ)⁻¹ ^ m with hs₂def
  have hs₁ : 0 < s₁ := by positivity
  have hs₂ : 0 < s₂ := by positivity
  have hs₂₁ : s₂ ≤ s₁ := by rw [hs₁def, inv_two_pow_pred hm]; linarith
  set A : S → Set (Rd d) := fun y => cbox (latPt s₁ y) (2 * s₁) with hA
  -- sites of `S` have far boxes
  have hfar : ∀ y₁ y₂ : S, y₁ ≠ y₂ → ∀ z ∈ A y₁, ∀ w ∈ A y₂, 2 * ρ * s₁ ≤ ‖z - w‖ := by
    intro y₁ y₂ hne z hz w hw
    have hnot := hS y₁ y₁.2 y₂ y₂.2 fun h => hne (Subtype.ext h)
    simp only [WithinInf, not_forall, not_le] at hnot
    obtain ⟨l, hl⟩ := hnot
    have hl1 : (M : ℤ) + 1 ≤ |(y₁ : Zd d) l - (y₂ : Zd d) l| := hl
    have hl' : (M : ℝ) + 1 ≤ |((y₁ : Zd d) l : ℝ) - ((y₂ : Zd d) l : ℝ)| := by
      exact_mod_cast hl1
    have h1 := hz l
    have h2 := hw l
    rw [HigherDimLFPP.DGZ.latPt_apply] at h1 h2
    have h3 : |s₁ * ((y₁ : Zd d) l : ℝ) - s₁ * ((y₂ : Zd d) l : ℝ)| ≤
        |z l - s₁ * ((y₁ : Zd d) l : ℝ)| + |z l - w l| + |w l - s₁ * ((y₂ : Zd d) l : ℝ)| := by
      have e : s₁ * ((y₁ : Zd d) l : ℝ) - s₁ * ((y₂ : Zd d) l : ℝ) =
          -(z l - s₁ * ((y₁ : Zd d) l : ℝ)) + (z l - w l) + (w l - s₁ * ((y₂ : Zd d) l : ℝ)) := by
        ring
      rw [e]
      refine (abs_add_le _ _).trans (add_le_add_left ((abs_add_le _ _).trans ?_) _)
      rw [abs_neg]
    have h4 : |s₁ * ((y₁ : Zd d) l : ℝ) - s₁ * ((y₂ : Zd d) l : ℝ)| =
        s₁ * |((y₁ : Zd d) l : ℝ) - ((y₂ : Zd d) l : ℝ)| := by
      rw [← mul_sub, abs_mul, abs_of_pos hs₁]
    have h5 := HigherDimLFPP.DGZ.abs_apply_le_norm (z - w) l
    rw [PiLp.sub_apply] at h5
    nlinarith
  -- the joint families of white-noise values
  set F : (y : S) → (A y ⊕ A y) → WN d := fun y p =>
    Sum.elim (fun z : A y => bandVec κ a s₁ z) (fun z : A y => bandVec κ a s₂ z) p with hF
  set X : (y : S) → (A y ⊕ A y) → Ω → ℝ := fun y p =>
    Sum.elim (fun z : A y => G₁ z) (fun z : A y => G₂ z) p with hX
  have hmin : ∀ b b' : ℝ, (b = s₁ ∨ b = s₂) → (b' = s₁ ∨ b' = s₂) → min b b' ≤ s₁ := by
    rintro b b' (rfl | rfl) -
    · exact min_le_left _ _
    · exact (min_le_left _ _).trans hs₂₁
  have horth : ∀ y₁ y₂ : S, y₁ ≠ y₂ → ∀ (p₁ : A y₁ ⊕ A y₁) (p₂ : A y₂ ⊕ A y₂),
      ⟪F y₁ p₁, F y₂ p₂⟫ = 0 := by
    intro y₁ y₂ hne p₁ p₂
    have key : ∀ (b b' : ℝ), (b = s₁ ∨ b = s₂) → (b' = s₁ ∨ b' = s₂) →
        ∀ z ∈ A y₁, ∀ w ∈ A y₂, ⟪bandVec κ a b z, bandVec κ a b' w⟫ = 0 := by
      intro b b' hb hb' z hz w hw
      refine inner_bandVec_eq_zero_of_two_mul_min_le hκ hρ ha ha ?_
      calc 2 * ρ * min b b' ≤ 2 * ρ * s₁ :=
            mul_le_mul_of_nonneg_left (hmin b b' hb hb') (by positivity)
        _ ≤ ‖z - w‖ := hfar y₁ y₂ hne z hz w hw
    rcases p₁ with z | z <;> rcases p₂ with w | w
    · exact key s₁ s₁ (Or.inl rfl) (Or.inl rfl) z z.2 w w.2
    · exact key s₁ s₂ (Or.inl rfl) (Or.inr rfl) z z.2 w w.2
    · exact key s₂ s₁ (Or.inr rfl) (Or.inl rfl) z z.2 w w.2
    · exact key s₂ s₂ (Or.inr rfl) (Or.inr rfl) z z.2 w w.2
  have hXae : ∀ (y : S) (p : A y ⊕ A y), X y p =ᵐ[P] W (F y p) := by
    intro y p
    rcases p with z | z
    · exact hG₁.ae_eq z
    · exact hG₂.ae_eq z
  have hind := hW.iIndepFun_of_ae_eq F horth hXae
  -- each rough event is measurable for the joint restricted fields
  have hmeas : ∀ y : S, MeasurableSet[MeasurableSpace.comap
      (fun ω (p : A y ⊕ A y) => X y p ω) MeasurableSpace.pi] (roughSite ξ G₁ G₂ m a₁ a₂ y) := by
    intro y
    have hle₁ : MeasurableSpace.comap (fun ω (z : A y) => G₁ z ω) MeasurableSpace.pi ≤
        MeasurableSpace.comap (fun ω (p : A y ⊕ A y) => X y p ω) MeasurableSpace.pi := by
      have e : (fun ω (z : A y) => G₁ z ω) =
          (fun f : (A y ⊕ A y) → ℝ => fun z => f (Sum.inl z)) ∘
            (fun ω (p : A y ⊕ A y) => X y p ω) := rfl
      rw [e, ← MeasurableSpace.comap_comp]
      exact MeasurableSpace.comap_mono
        (measurable_pi_iff.2 fun z => measurable_pi_apply (Sum.inl z)).comap_le
    have hle₂ : MeasurableSpace.comap (fun ω (z : A y) => G₂ z ω) MeasurableSpace.pi ≤
        MeasurableSpace.comap (fun ω (p : A y ⊕ A y) => X y p ω) MeasurableSpace.pi := by
      have e : (fun ω (z : A y) => G₂ z ω) =
          (fun f : (A y ⊕ A y) → ℝ => fun z => f (Sum.inr z)) ∘
            (fun ω (p : A y ⊕ A y) => X y p ω) := rfl
      rw [e, ← MeasurableSpace.comap_comp]
      exact MeasurableSpace.comap_mono
        (measurable_pi_iff.2 fun z => measurable_pi_apply (Sum.inr z)).comap_le
    have hc₁ : MeasurableSet[MeasurableSpace.comap (fun ω (p : A y ⊕ A y) => X y p ω)
        MeasurableSpace.pi] (closedSite ξ G₁ s₁ a₁ (2 - s₁) y) :=
      hle₁ _ (HigherDimLFPP.DGZ.measurableSet_closedSite_comap hG₁.continuous hs₁ ξ a₁ _ y)
    have hc₂ : ∀ z : Zd d, WithinInf 1 z (2 • (y : Zd d)) →
        MeasurableSet[MeasurableSpace.comap (fun ω (p : A y ⊕ A y) => X y p ω)
          MeasurableSpace.pi] (closedSite ξ G₂ s₂ a₂ (2 - s₂) z) := by
      intro z hz
      exact hle₂ _ (comap_restrict_le G₂ (cbox_fine_subset hm hz) _
        (HigherDimLFPP.DGZ.measurableSet_closedSite_comap hG₂.continuous hs₂ ξ a₂ _ z))
    have e : roughSite ξ G₁ G₂ m a₁ a₂ y = {_ω | (y : Zd d) ∈ latRegion (m - 1)} ∩
        (closedSite ξ G₁ s₁ a₁ (2 - s₁) y ∪
          ⋃ z : {z : Zd d // WithinInf 1 z (2 • (y : Zd d))},
            closedSite ξ G₂ s₂ a₂ (2 - s₂) z) := by
      ext ω
      simp only [roughSite, mem_ofPred_eq, mem_inter_iff, mem_union, mem_iUnion, Subtype.exists,
        exists_prop]
      exact Iff.rfl
    rw [e]
    exact (MeasurableSet.const _).inter (hc₁.union (MeasurableSet.iUnion fun z => hc₂ z z.2))
  have h := hind.meas_iInter (s := fun y : S => roughSite ξ G₁ G₂ m a₁ a₂ y) hmeas
  have e : (⋂ y ∈ S, roughSite ξ G₁ G₂ m a₁ a₂ y) = ⋂ y : S, roughSite ξ G₁ G₂ m a₁ a₂ y := by
    ext ω
    simp only [mem_iInter, Subtype.forall]
  rw [e, h, Finset.prod_coe_sort S fun y => P (roughSite ξ G₁ G₂ m a₁ a₂ y)]

end ProductBound

end DGZ

end HigherDimLQGMetric
