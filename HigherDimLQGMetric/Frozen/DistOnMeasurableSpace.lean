import HigherDimLQGMetric.Frozen.TestOn
import HigherDimLQGMetric.Frozen.DistOn
import Mathlib.MeasureTheory.MeasurableSpace.Pi

/-!
# Frozen definition: `DistOn.measurableSpace`

Anchor of the statement surface of the higher-dimensional LQG metric formalization (manifest
`HigherDimLQGMetric/Frozen/frozen-anchors.json`; rulings `planning/RULINGS.md`, M1, M13).
Source: `source/higher-dimensional-lqg-metric.pdf` ([S], cited by line of the text extraction `.txt`):
[S] l. 61, 67; [1] §1.2 footnote (TeX l. 242: "the σ-algebra generated by `h|_U` is the Borel σ-algebra
generated by the random variables `(h, φ)` with `φ` smooth and compactly supported in `U`"): the cylinder
σ-algebra on `𝒟'(U)`, generated by the pairings `h ↦ ⟨h, φ⟩`, `φ ∈ 𝓓(U)`. Declared as an instance
(`@[instance_reducible, instance] def`, exactly what the `instance` command produces).
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section


namespace HigherDimLQGMetric

open HigherDimLFPP (Rd)

/-- The cylinder σ-algebra on `𝒟'(U)`: generated by the pairings `h ↦ ⟨h, φ⟩`, `φ ∈ 𝓓(U)`. -/
@[instance_reducible, instance]
def DistOn.measurableSpace {d : ℕ} (U : TopologicalSpace.Opens (Rd d)) :
    MeasurableSpace (DistOn U) :=
  MeasurableSpace.comap (fun (h : DistOn U) (φ : TestOn U) => h φ) MeasurableSpace.pi

end HigherDimLQGMetric
