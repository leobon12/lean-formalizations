import HigherDimLQGMetric.Sec8.Geod

/-!
# Almost-sure identification of the Borel favorable event

The Borel encoding agrees with the source's internal path distances and
excursions at the sharp weak metrics generated by a whole-space LGF.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace HigherDimLQGMetric

open MeasureTheory Set Metric
open HigherDimLFPP (Rd)

variable {d : ℕ}

theorem lemma82_favEvent_ae_equiv {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (h : Ω → DistRd d)
    (hd : 3 ≤ d) (hh : IsWholeSpaceLGF h P)
    {ξ Q : ℝ} (hξ : 0 < ξ) (hQ : Real.sqrt (2 * d) < Q)
    {D Dt : DistRd d → ContMetric d}
    (hD : IsSharpWeakExpMetric d ξ Q D)
    (hDt : IsSharpWeakExpMetric d ξ Q Dt)
    (Cstar q R r b : ℝ) (hr : 0 < r)
    {J : ℕ} (N : ℕ → Set (Config d))
    (V : Set (Rd d)) (hV : IsOpen V)
    (hVA : closure V ⊆ ann (0 : Rd d) 1 3)
    (f : ℕ → C(Rd d, ℝ)) (Mf : ℝ)
    (hf : ∀ j < J, (∀ x, 0 ≤ f j x) ∧ (∀ x, f j x ≤ Mf))
    (x y : Rd d) {colour : Fin d → ℤ}
    {Z : Finset (Rd d × ℕ)}
    (hZ : IsSec8LabeledSet d J r R x y colour Z) :
    ∀ᵐ ω ∂P,
      h ω ∈ FavEventBorel D Dt ξ Q Cstar q R r b J N V f x y Z ↔
      h ω ∈ FavEvent D Dt ξ Q Cstar q R r b J N V f x y Z := by
  have hJ : ∀ site ∈ Z, site.2 < J := by
    intro site hsite
    obtain ⟨_, _, _, _, _, _, hj⟩ := hZ.1 site hsite
    exact hj
  filter_upwards [hD.length P h hh.isLGFPlusCont,
    hDt.length P h hh.isLGFPlusCont,
    lemma82_shifted_selector_endpoints P h hd hh hξ hQ hD hf r hJ x y] with
      ω hlen hlenDt hsel
  have hxy : ∀ site ∈ Z, x ∉ closedBall site.1 (4 * r) ∧
      y ∉ closedBall site.1 (4 * r) := by
    intro site hsite
    obtain ⟨_, _, _, _, hx, hy, _⟩ := hZ.1 site hsite
    exact ⟨hx, hy⟩
  exact FavEventBorel_iff_FavEvent D Dt ξ Q Cstar q R r b hr J N V hV hVA
    f x y Z (h ω) hlen hlenDt hxy hsel.1 hsel.2

end HigherDimLQGMetric
