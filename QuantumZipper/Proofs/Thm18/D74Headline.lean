/-!
# D74: Theorem 1.8 in the paper's form (`theorem1_8Off`), headline V5

Sheffield, arXiv:1012.4797, Theorem 1.8 (p. 26), in the user-approved form D74
(`Statements/Thm18Off.lean`): clauses (1)–(2) up to `ConfigEqOff`, clause (3) for the masked law
`configLawOff`.

* `theorem1_8Off_of_theorem1_8`: the regularized full-plane statement `theorem1_8` implies the
  paper's statement, with no further hypothesis: `ConfigEq → ConfigEqOff`
  (`D74.configEqOff_of_configEq`), and `configLawFull` equality gives `configLawOff` equality
  (`D74.configLawOff_eq_of_configLawFull_eq`, via the measurable curve mask `D74.curveMaskMeas`),
  the drivers being a.s. continuous and `0` at `0` (`D74.ae_zipLenC_snd_good`, using the existence
  part of clause (1)) and the wedge configuration's law not being a Dirac mass (its driver at time
  `1` is Gaussian, `wedge_configLawFull_ne_dirac`).
* `theorem1_8_of_openNodesV5`: `theorem1_8Off` from the open leaves of
  `theorem1_8_of_openNodesV4` (same hypotheses). Wiring only.

Own elementary bookkeeping.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal

namespace QuantumZipper
namespace Thm18Asm
namespace D74

/-- The law of the wedge configuration's data is not a Dirac mass: its driver at time `1` is
`γ B₁` with `B₁` standard Gaussian. -/
theorem wedge_configLawFull_ne_dirac {γ : ℝ} {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] {B : ℝ≥0 → Ω → ℝ} {Y : Ω → FieldSample}
    (hS : Thm18Setting γ P B Y) (hIn : Thm18Inputs γ P B Y) (d : E6.FullData) :
    configLawFull (wedgeConfig γ B Y) P ≠ Measure.dirac d := by
  intro heq
  have hS1 : MeasurableSet {e : E6.FullData | e.2 1 = d.2 1} :=
    ((measurable_pi_apply (1 : ℝ≥0)).comp measurable_snd) (measurableSet_singleton _)
  have h1 : configLawFull (wedgeConfig γ B Y) P {e : E6.FullData | e.2 1 = d.2 1} = 1 := by
    rw [heq, Measure.dirac_apply' _ hS1]
    exact Set.indicator_of_mem (show d ∈ {e : E6.FullData | e.2 1 = d.2 1} from rfl) _
  have hLaw := hS.2.2.1.toIsPreBrownianReal.hasLaw_eval 1
  have hsub : (fun ω => cfgData (wedgeConfig γ B Y ω)) ⁻¹' {e : E6.FullData | e.2 1 = d.2 1} =
      (B 1) ⁻¹' {d.2 1 / γ} := by
    ext ω
    simp only [Set.mem_preimage, Set.mem_ofPred_eq, Set.mem_singleton_iff, cfgData, wedgeConfig,
      drive, NNReal.coe_one, Real.toNNReal_one, Real.sqrt_sq hS.1.le]
    rw [eq_div_iff hS.1.ne', mul_comm]
  have h0 : configLawFull (wedgeConfig γ B Y) P {e : E6.FullData | e.2 1 = d.2 1} = 0 := by
    rw [configLawFull_eq_map_cfgData,
      Measure.map_apply_of_aemeasurable (aemeasurable_cfgData_wedgeConfig hS hIn) hS1, hsub,
      ← Measure.map_apply_of_aemeasurable hLaw.aemeasurable (measurableSet_singleton _),
      hLaw.map_eq]
    have := nullSingletonClass_gaussianReal (μ := 0) (v := (1 : ℝ≥0)) one_ne_zero
    exact measure_singleton _
  rw [h0] at h1
  exact zero_ne_one h1

end D74

