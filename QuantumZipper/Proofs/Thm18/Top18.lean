/-- The rerooting node A of G1 from X1, A2, Z2 goodness and A1b (side limit along the selected
map, no `hZ4`). -/
theorem top18_g1RerootStmt (hX1 : BaseFin.BaseFiniteStmt) (hRFac : G1RerootFactorStmt)
    (hZ2 : G1Z2SideGoodStmt) (hA1b : G1ZA1bSideExactArcStmt) : G1RerootStmt :=
  g1RerootStmt_of_arc (e6StmtArc_of_X1 hX1) (f1ArcStmt_of_X1 hX1) (unzipMeasArc_of_X1 hX1)
    (g1RerootPathArcStmt_of_parts G1ZA1a.g1RerootAffineStmt_holds
      (g1RerootRegArcStmt_of hA1b hZ2) (g1RerootLenArcStmt_of_sel hX1 g1Z4SideLimSelStmt_holds))
    G1ZA1a.g1RerootAffineStmt_holds (g1RerootLenArcStmt_of_sel hX1 g1Z4SideLimSelStmt_holds)
    hRFac

/-- The Palm constant of G1 (`g1PalmConstStmt_of_leaves` without `hZ4`, `hWBAM`). -/
theorem top18_g1PalmConstStmt (hX1 : BaseFin.BaseFiniteStmt) (hRFac : G1RerootFactorStmt)
    (hZ2 : G1Z2SideGoodStmt) (hA1b : G1ZA1bSideExactArcStmt) : G1PalmConstStmt :=
  g1PalmConstStmt_of_nodes (top18_g1RerootStmt hX1 hRFac hZ2 hA1b)
    g1SideBdryRegStmt_holds (g1RegExStmt_of_rest g1RegRepRestStmt_holds) hZ2

/-- G1 (`g1Stmt_of_arc_noWBAM` with the D89 shifted regularity and the proved Palm constant). -/
theorem top18_g1Stmt (hX1 : BaseFin.BaseFiniteStmt) (hRFac : G1RerootFactorStmt)
    (hSSRA : G1SideShiftRegAStmt) (hWPZ : G1WedgePalmZoomStmt) (hZ2 : G1Z2SideGoodStmt)
    (hA1b : G1ZA1bSideExactArcStmt) : G1Stmt :=
  g1Stmt_of_zoomNodes_regRep (D3Plus.d3PlusIRich_of_N2 D3Plus.d3PlusIN2RichStmt_holds)
    (top18_g1RerootStmt hX1 hRFac hZ2 hA1b)
    (g1PalmAvgStmt_of g1SideBdryRegStmt_holds
      (g1SideTranslMeasStmt_of_rest_good g1RegRepRestStmt_holds hZ2))
    (g1PalmModelStmt_of (g1SideConstInvStmt_of_regA hRFac hSSRA)
      (top18_g1PalmConstStmt hX1 hRFac hZ2 hA1b)
      (g1PalmToWedgeStmt_of (g1RegExStmt_of_rest g1RegRepRestStmt_holds)
        g1SideTransportIdStmt_holds)
      hWPZ)
    (g1RegRepStmt_of_rc2_rest G1RC.g1RegRepRC2Stmt_holds g1RegRepRestStmt_holds)

/-- G3 step 1 (joint rerooting): copy of `g3JointRerootStmt_of` (R18G3Reroot.lean) with the
rerooting length node from the selected-map side limit instead of `hZ4`. -/
theorem top18_g3JointRerootStmt (hX1 : BaseFin.BaseFiniteStmt) (hRFac : G1RerootFactorStmt)
    (hZ2 : G1Z2SideGoodStmt) (hA1b : G1ZA1bSideExactArcStmt) :
    G3JointRerootStmt := by
  have hE6 := e6StmtArc_of_X1 hX1
  have hF1 := f1ArcStmt_of_X1 hX1
  have hum := unzipMeasArc_of_X1 hX1
  have hA := G1ZA1a.g1RerootAffineStmt_holds
  have hL := g1RerootLenArcStmt_of_sel hX1 g1Z4SideLimSelStmt_holds
  have hP := g1RerootPathArcStmt_of_parts hA (g1RerootRegArcStmt_of hA1b hZ2) hL
  intro γ Ω _ P _ B Y hS hIn ℓ hℓ R Γ₁ Γ₂ hΓ₁ hΓ₂ hΓ₁1 hΓ₂1
  have hEq : LenEqArc γ P B Y := hF1 γ P B Y hS hIn
  set c := wedgeConfig γ B Y with hc
  have hpath : AEMeasurable (fun ω => fun t : ℝ≥0 => (c ω).2 t) P := by
    have hm : Measurable fun a : ℝ≥0 → ℝ => fun t : ℝ≥0 =>
        Real.sqrt (γ ^ 2) * a ((t : ℝ).toNNReal) :=
      measurable_pi_iff.2 fun t => (measurable_pi_apply _).const_mul _
    exact hm.comp_aemeasurable (QuantumZipper.IsBrownianReal.aemeasurable_pathOf hS.2.2.1)
  have hmc : AEMeasurable (fun ω => g1zCfgData (c ω)) P := hIn.2.1.prodMk hpath
  obtain ⟨G₁, _G₁₀, E₁, hG₁, _, hE₁m, hdet₁, hE₁⟩ :=
    hRFac γ P B Y hS hIn true ℓ hℓ R Γ₁ hΓ₁ hΓ₁1
  obtain ⟨G₂, _G₂₀, E₂, hG₂, _, hE₂m, hdet₂, hE₂⟩ :=
    hRFac γ P B Y hS hIn false ℓ hℓ R Γ₂ hΓ₂ hΓ₂1
  set G := fun p => G₁ p * G₂ p with hGdef
  have hG : Measurable G := hG₁.mul hG₂
  set E := E₁ ∩ E₂ with hEdef
  have hEm : MeasurableSet E := hE₁m.inter hE₂m
  have hE : ∀ᵐ ω ∂P, g1zCfgData (c ω) ∈ E := by
    filter_upwards [hE₁, hE₂] with ω h1 h2 using ⟨h1, h2⟩
  have hdet : ∀ c0 : FieldSample × (ℝ → ℝ), g1zCfgData c0 ∈ E → G1zDrvGood c0.2 →
      g1zRerootF γ true ℓ R Γ₁ c0 * g1zRerootF γ false ℓ R Γ₂ c0 = G (g1zCfgData c0) := by
    intro c0 h1 h2
    rw [(hdet₁ c0 h1.1 h2).1, (hdet₂ c0 h1.2 h2).1]
  set c' := fun ω => zipLenDownArc γ ℓ (c ω) with hc'
  have hlaw : P.map (fun ω => g1zCfgData (c' ω)) = P.map (fun ω => g1zCfgData (c ω)) :=
    e6Arc_thm18 hE6 hS ℓ hℓ
  have hmc' : AEMeasurable (fun ω => g1zCfgData (c' ω)) P :=
    aemeasurable_cfgData_zipLenDownArc hum hS hℓ
  have hE' : ∀ᵐ ω ∂P, g1zCfgData (c' ω) ∈ E := by
    have h : ∀ᵐ p ∂(P.map fun ω => g1zCfgData (c ω)), p ∈ E := (ae_map_iff hmc hEm).2 hE
    rw [← hlaw] at h
    exact (ae_map_iff hmc' hEm).1 h
  have hgood' : ∀ᵐ ω ∂P, G1zDrvGood (c' ω).2 := by
    filter_upwards [ae_g1zDrvGood hS hIn, hL γ P B Y hS hIn hEq ℓ hℓ true] with ω hW hl
    exact (hA _ hW _ _ hl.1 hl.2.1 true).1
  calc _ = ∫⁻ ω, G (g1zCfgData (c ω)) ∂P := by
        refine lintegral_congr_ae ?_
        filter_upwards [hE, ae_g1zDrvGood hS hIn] with ω h1 h2
        exact hdet _ h1 h2
    _ = ∫⁻ p, G p ∂(P.map fun ω => g1zCfgData (c ω)) := (lintegral_map' hG.aemeasurable hmc).symm
    _ = ∫⁻ p, G p ∂(P.map fun ω => g1zCfgData (c' ω)) := by rw [hlaw]
    _ = ∫⁻ ω, G (g1zCfgData (c' ω)) ∂P := lintegral_map' hG.aemeasurable hmc'
    _ = ∫⁻ ω, g1zRerootF γ true ℓ R Γ₁ (c' ω) * g1zRerootF γ false ℓ R Γ₂ (c' ω) ∂P := by
        refine lintegral_congr_ae ?_
        filter_upwards [hE', hgood'] with ω h1 h2
        exact (hdet _ h1 h2).symm
    _ = _ := by
        refine lintegral_congr_ae ?_
        filter_upwards [hP γ P B Y hS hIn hEq ℓ hℓ true,
          hP γ P B Y hS hIn hEq ℓ hℓ false] with ω h1 h2
        simp only [g1zRerootF]
        rw [locFieldFull_congr_dataFull h1.symm R, locFieldFull_congr_dataFull h2.symm R]
        rfl

