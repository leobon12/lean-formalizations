import MatedCRTHarmonic.MatedCRT.BrownianLaw
import Mathlib.Probability.Distributions.Gaussian.Multivariate
import Mathlib.Probability.Process.FiniteDimensionalLaws
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap

/-!
# Uniqueness of the correlated two-sided Brownian path law

Finite-dimensional marginals are centred Gaussian measures whose covariance matrices are fixed by
[18] §1.1. The Borel structure of continuous paths is generated by coordinate evaluations.
-/

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Topology Set Metric
open scoped ENNReal NNReal RealInnerProductSpace

noncomputable section

namespace MatedCRTHarmonic.MatedCRT

private def coordinateProcess (p : Fin 2 × ℝ) (ω : Path2) : ℝ :=
  lrCoord p.1 p.2 ω

private def finiteCoordinatePi (I : Finset (Fin 2 × ℝ)) (ω : Path2) : I → ℝ :=
  fun i => coordinateProcess i.1 ω

private def finiteCoordinateEuclidean (I : Finset (Fin 2 × ℝ)) (ω : Path2) :
    EuclideanSpace ℝ I :=
  WithLp.toLp 2 (finiteCoordinatePi I ω)

private theorem finiteCoordinatePi_measurable (I : Finset (Fin 2 × ℝ)) :
    Measurable (finiteCoordinatePi I) := by
  apply measurable_pi_iff.mpr
  intro i
  exact measurable_lrCoord i.1

private theorem finiteCoordinateEuclidean_measurable (I : Finset (Fin 2 × ℝ)) :
    Measurable (finiteCoordinateEuclidean I) := by
  exact (WithLp.measurable_toLp 2 _).comp (finiteCoordinatePi_measurable I)

private theorem finiteCoordinateLaw_eq {γ : ℝ} {μ ν : Measure Path2}
    (hμ : IsCorrelatedBM2 γ μ) (hν : IsCorrelatedBM2 γ ν)
    (I : Finset (Fin 2 × ℝ)) :
    μ.map (finiteCoordinateEuclidean I) = ν.map (finiteCoordinateEuclidean I) := by
  classical
  let e : EuclideanSpace ℝ I ≃L[ℝ] (I → ℝ) :=
    PiLp.continuousLinearEquiv (2 : ℝ≥0∞) ℝ (fun _ : I => ℝ)
  let F := finiteCoordinatePi I
  let Fμ := finiteCoordinateEuclidean I
  have hFmeas : Measurable F := finiteCoordinatePi_measurable I
  have hFμmeas : Measurable Fμ := finiteCoordinateEuclidean_measurable I
  letI : IsProbabilityMeasure μ := hμ.isProbabilityMeasure
  letI : IsProbabilityMeasure ν := hν.isProbabilityMeasure
  letI : IsGaussian (μ.map F) := (hμ.isGaussianProcess.hasGaussianLaw I).isGaussian_map
  letI : IsGaussian (ν.map F) := (hν.isGaussianProcess.hasGaussianLaw I).isGaussian_map
  have hmapμ : μ.map Fμ = (μ.map F).map e.symm := by
    have hfun : Fμ = e.symm ∘ F := by
      funext ω
      rfl
    rw [hfun, Measure.map_map e.symm.continuous.measurable hFmeas]
  have hmapν : ν.map Fμ = (ν.map F).map e.symm := by
    have hfun : Fμ = e.symm ∘ F := by
      funext ω
      rfl
    rw [hfun, Measure.map_map e.symm.continuous.measurable hFmeas]
  have hGaussμ : IsGaussian (μ.map Fμ) := by
    rw [hmapμ]
    infer_instance
  have hGaussν : IsGaussian (ν.map Fμ) := by
    rw [hmapν]
    infer_instance
  let hLawμ : HasGaussianLaw Fμ μ := ⟨hFμmeas.aemeasurable, hGaussμ⟩
  let hLawν : HasGaussianLaw Fμ ν := ⟨hFμmeas.aemeasurable, hGaussν⟩
  have hMemμ : ∀ i : I, MemLp (fun ω => coordinateProcess i.1 ω) 2 μ := by
    intro i
    apply (memLp_map_measure_iff aestronglyMeasurable_id
      (hμ.isGaussianProcess.aemeasurable i.1)).mp
    exact (hμ.isGaussianProcess.hasGaussianLaw_eval i.1).isGaussian_map.memLp_two_id
  have hMemν : ∀ i : I, MemLp (fun ω => coordinateProcess i.1 ω) 2 ν := by
    intro i
    apply (memLp_map_measure_iff aestronglyMeasurable_id
      (hν.isGaussianProcess.aemeasurable i.1)).mp
    exact (hν.isGaussianProcess.hasGaussianLaw_eval i.1).isGaussian_map.memLp_two_id
  have hEntry : ∀ i j : I,
      cov[coordinateProcess i.1, coordinateProcess j.1; μ] =
        cov[coordinateProcess i.1, coordinateProcess j.1; ν] := by
    intro i j
    have h₁ := hμ.covariance_eq i.1.1 j.1.1 i.1.2 j.1.2
    have h₂ := hν.covariance_eq i.1.1 j.1.1 i.1.2 j.1.2
    change cov[lrCoord i.1.1 i.1.2, lrCoord j.1.1 j.1.2; μ] =
      cov[lrCoord i.1.1 i.1.2, lrCoord j.1.1 j.1.2; ν]
    exact h₁.trans h₂.symm
  have hCov : covarianceBilin (μ.map Fμ) = covarianceBilin (ν.map Fμ) := by
    ext x y
    change covarianceBilin (μ.map (fun ω => WithLp.toLp 2
      (fun i : I => coordinateProcess i.1 ω))) x y =
        covarianceBilin (ν.map (fun ω => WithLp.toLp 2
      (fun i : I => coordinateProcess i.1 ω))) x y
    rw [covarianceBilin_apply_pi hMemμ, covarianceBilin_apply_pi hMemν]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [hEntry i j]
  have hMeanVecμ : ∫ ω, Fμ ω ∂μ = 0 := by
    ext i
    change EuclideanSpace.proj i (∫ ω, Fμ ω ∂μ) = 0
    rw [← (EuclideanSpace.proj i).integral_comp_comm hLawμ.integrable]
    change ∫ ω, coordinateProcess i.1 ω ∂μ = 0
    exact hμ.integral_eq_zero i.1.1 i.1.2
  have hMeanVecν : ∫ ω, Fμ ω ∂ν = 0 := by
    ext i
    change EuclideanSpace.proj i (∫ ω, Fμ ω ∂ν) = 0
    rw [← (EuclideanSpace.proj i).integral_comp_comm hLawν.integrable]
    change ∫ ω, coordinateProcess i.1 ω ∂ν = 0
    exact hν.integral_eq_zero i.1.1 i.1.2
  have hMeanμ : ∫ x, id x ∂μ.map Fμ = 0 := by
    rw [integral_map hFμmeas.aemeasurable (by fun_prop)]
    exact hMeanVecμ
  have hMeanν : ∫ x, id x ∂ν.map Fμ = 0 := by
    rw [integral_map hFμmeas.aemeasurable (by fun_prop)]
    exact hMeanVecν
  have hEq : μ.map Fμ = ν.map Fμ :=
    IsGaussian.ext (hMeanμ.trans hMeanν.symm) hCov
  exact hEq

private theorem finiteCoordinatePiLaw_eq {γ : ℝ} {μ ν : Measure Path2}
    (hμ : IsCorrelatedBM2 γ μ) (hν : IsCorrelatedBM2 γ ν)
    (I : Finset (Fin 2 × ℝ)) :
    μ.map (finiteCoordinatePi I) = ν.map (finiteCoordinatePi I) := by
  classical
  let e : EuclideanSpace ℝ I ≃L[ℝ] (I → ℝ) :=
    PiLp.continuousLinearEquiv (2 : ℝ≥0∞) ℝ (fun _ : I => ℝ)
  have hE := finiteCoordinateLaw_eq hμ hν I
  have hrecoverμ : (μ.map (finiteCoordinateEuclidean I)).map e =
      μ.map (finiteCoordinatePi I) := by
    rw [show finiteCoordinateEuclidean I = e.symm ∘ finiteCoordinatePi I by
      funext ω
      rfl]
    have hcomp : Measurable (e.symm ∘ finiteCoordinatePi I) :=
      e.symm.continuous.measurable.comp (finiteCoordinatePi_measurable I)
    rw [Measure.map_map e.continuous.measurable hcomp]
    congr 1
  have hrecoverν : (ν.map (finiteCoordinateEuclidean I)).map e =
      ν.map (finiteCoordinatePi I) := by
    rw [show finiteCoordinateEuclidean I = e.symm ∘ finiteCoordinatePi I by
      funext ω
      rfl]
    have hcomp : Measurable (e.symm ∘ finiteCoordinatePi I) :=
      e.symm.continuous.measurable.comp (finiteCoordinatePi_measurable I)
    rw [Measure.map_map e.continuous.measurable hcomp]
    congr 1
  calc
    μ.map (finiteCoordinatePi I) = (μ.map (finiteCoordinateEuclidean I)).map e := hrecoverμ.symm
    _ = (ν.map (finiteCoordinateEuclidean I)).map e := by rw [hE]
    _ = ν.map (finiteCoordinatePi I) := hrecoverν

private def coordinateProcessMap (ω : Path2) : Fin 2 × ℝ → ℝ :=
  fun p => coordinateProcess p ω

private theorem coordinateProcess_measurable : Measurable coordinateProcessMap := by
  apply measurable_pi_iff.mpr
  intro p
  exact measurable_lrCoord p

private theorem path2_measurableSpace_eq_comap_coordinateProcess :
    (inferInstance : MeasurableSpace Path2) =
      MeasurableSpace.comap coordinateProcessMap
        (inferInstance : MeasurableSpace (Fin 2 × ℝ → ℝ)) := by
  change ContinuousMap.measurableSpace =
    MeasurableSpace.comap coordinateProcessMap MeasurableSpace.pi
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval, MeasurableSpace.pi,
    MeasurableSpace.comap_iSup]
  simp_rw [MeasurableSpace.comap_comp]
  rw [show Prod.instMeasurableSpace = (borel ℝ).prod (borel ℝ) by
    calc
      Prod.instMeasurableSpace = (inferInstance : MeasurableSpace (ℝ × ℝ)) := rfl
      _ = borel (ℝ × ℝ) := BorelSpace.measurable_eq
      _ = (borel ℝ).prod (borel ℝ) := by
        rw [← BorelSpace.measurable_eq (α := ℝ × ℝ)]
        rfl]
  have hEval (t : ℝ) : (fun ω : Path2 => ω t) =
      (fun ω => ((ω t).1, (ω t).2)) := rfl
  simp_rw [hEval, MeasurableSpace.comap_prodMk]
  rw [iSup_sup_eq]
  apply le_antisymm
  · apply sup_le
    · refine iSup_le fun t => ?_
      exact le_iSup_of_le (0, t) (by rfl)
    · refine iSup_le fun t => ?_
      exact le_iSup_of_le (1, t) (by rfl)
  · refine iSup_le fun p => ?_
    rcases p with ⟨i, t⟩
    fin_cases i
    · simpa [coordinateProcess, lrCoord] using
        (le_sup_of_le_left (le_iSup_of_le t (show
          MeasurableSpace.comap (fun ω : Path2 => (ω t).1) (borel ℝ) ≤
            MeasurableSpace.comap (fun ω : Path2 => (ω t).1) (borel ℝ) from le_rfl)))
    · simpa [coordinateProcess, lrCoord] using
        (le_sup_of_le_right (le_iSup_of_le t (show
          MeasurableSpace.comap (fun ω : Path2 => (ω t).2) (borel ℝ) ≤
            MeasurableSpace.comap (fun ω : Path2 => (ω t).2) (borel ℝ) from le_rfl)))

end MatedCRTHarmonic.MatedCRT

namespace MatedCRTHarmonic

/-- The correlated Brownian path law is determined by its covariance specification. -/
theorem isCorrelatedBM2_unique_holds :
    ∀ (γ : ℝ) (μ ν : Measure MatedCRT.Path2),
      MatedCRT.IsCorrelatedBM2 γ μ → MatedCRT.IsCorrelatedBM2 γ ν → μ = ν := by
  intro γ μ ν hμ hν
  letI : IsProbabilityMeasure μ := hμ.isProbabilityMeasure
  letI : IsProbabilityMeasure ν := hν.isProbabilityMeasure
  let X := MatedCRT.coordinateProcessMap
  have hX : Measurable X := MatedCRT.coordinateProcess_measurable
  have hμproj := ProbabilityTheory.isProjectiveLimit_map (P := μ) (X := MatedCRT.coordinateProcess)
    hX.aemeasurable
  have hνproj := ProbabilityTheory.isProjectiveLimit_map (P := ν) (X := MatedCRT.coordinateProcess)
    hX.aemeasurable
  have hmarginal : (fun I : Finset (Fin 2 × ℝ) =>
      μ.map (fun ω => I.restrict (fun p => MatedCRT.coordinateProcess p ω))) =
      (fun I => ν.map (fun ω => I.restrict (fun p => MatedCRT.coordinateProcess p ω))) := by
    funext I
    change μ.map (MatedCRT.finiteCoordinatePi I) = ν.map (MatedCRT.finiteCoordinatePi I)
    exact MatedCRT.finiteCoordinatePiLaw_eq hμ hν I
  rw [← hmarginal] at hνproj
  have hprocess : μ.map X = ν.map X := hμproj.unique hνproj
  have hmspace := MatedCRT.path2_measurableSpace_eq_comap_coordinateProcess
  apply Measure.ext
  intro s hs
  have hs' : MeasurableSet[MeasurableSpace.comap X (inferInstance :
      MeasurableSpace (Fin 2 × ℝ → ℝ))] s := by
    rw [← hmspace]
    exact hs
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs'
  have hEval := congrArg (fun m : Measure (Fin 2 × ℝ → ℝ) => m t) hprocess
  rw [Measure.map_apply hX ht, Measure.map_apply hX ht] at hEval
  exact hEval

end MatedCRTHarmonic
